spec: v0.6
name: ukserve

unikraft:
  version: stable
  kconfig:
    CONFIG_STACK_SIZE_PAGE_ORDER: '6'
    CONFIG_LIBUKBOOT_BANNER_NONE: 'y'
    CONFIG_LIBUKNETDEV: 'y'
    CONFIG_LIBUKNETDEV_EINFO_LIBPARAM: 'y'
    CONFIG_LIBUKALLOC: 'y'
    CONFIG_LIBUKSCHED: 'y'
    CONFIG_LIBUKSCHEDCOOP: 'y'
    CONFIG_LIBPOSIX_SOCKET: 'y'
    CONFIG_LIBVIRTIO_NET: 'y'
    CONFIG_LIBVIRTIO_PCI: 'y'
    CONFIG_LIBDEVFS: 'y'

libraries:
  lwip:
    version: stable
    kconfig:
      CONFIG_LWIP_TCP: 'y'
      CONFIG_LWIP_SOCKET: 'y'
      CONFIG_LWIP_IPV4: 'y'
      CONFIG_LWIP_UKNETDEV: 'y'
      CONFIG_LWIP_AUTOIFACE: 'y'
      CONFIG_LWIP_DHCP: 'y'
      CONFIG_LWIP_WAITIFACE: 'y'
      CONFIG_LWIP_UDP: 'y'

targets:
  - qemu/x86_64
