// A Koru HTTP server inside a Unikraft unikernel — no Zig std networking.
//
// std.net cannot exist on x86_64-freestanding (std.posix has no sockaddr there),
// but posix-socket + lwip put socket/bind/listen/accept in the image as plain C
// symbols. So the pump calls them the same way std/io reaches nolibc's fputs.

~import std/io

const std = @import("std");

extern fn socket(domain: c_int, stype: c_int, protocol: c_int) c_int;
extern fn bind(fd: c_int, addr: *const anyopaque, len: u32) c_int;
extern fn listen(fd: c_int, backlog: c_int) c_int;
extern fn accept(fd: c_int, addr: ?*anyopaque, len: ?*u32) c_int;
extern fn recv(fd: c_int, buf: [*]u8, len: usize, flags: c_int) isize;
extern fn send(fd: c_int, buf: [*]const u8, len: usize, flags: c_int) isize;
extern fn close(fd: c_int) c_int;

// Matches nolibc's musl-imported netinet/in.h EXACTLY: there is NO sin_len
// byte on this platform, so sin_family is a u16 at offset 0. Guessing the BSD
// layout (len:u8, family:u8) puts 0x0210 where the family belongs and bind
// fails with a wrong-address-family errno — measured, not reasoned.
const SockaddrIn = extern struct {
    family: u16 = 2,
    port: u16,
    addr: u32,
    zero: [8]u8 = [_]u8{0} ** 8,
};

// The reply is BUILT PER REQUEST, not a compile-time constant, and that is the
// point of this line rather than an embellishment. Until 2026-08-11 the emitted
// allocator named `std.heap.c_allocator` (and then `page_allocator`), neither of
// which can exist on a machine with no libc and no OS — so any Koru program that
// asked for a byte failed to compile for this target. The one reason this example
// ever built was that it never asked. Pinned by koru 310_122.
const REPLY_HEAD = "HTTP/1.1 200 OK\r\nContent-Length: {d}\r\nConnection: close\r\n\r\n";

~pub tor serve { port: u16 }
| stopped string
| failed string

~proc serve|zig {
    const fd = $mod.socket(2, 1, 0);
    if (fd < 0) return .{ .failed = "socket" };

    var a = $mod.SockaddrIn{
        .port = @byteSwap(port),
        .addr = 0,
    };
    if ($mod.bind(fd, &a, @sizeOf($mod.SockaddrIn)) < 0) return .{ .failed = "bind" };
    if ($mod.listen(fd, 8) < 0) return .{ .failed = "listen" };

    var served: u32 = 0;
    while (served < 3) {
        const c = $mod.accept(fd, null, null);
        if (c < 0) continue;
        var buf: [512]u8 = undefined;
        _ = $mod.recv(c, &buf, buf.len, 0);

        // Heap, inside a unikernel. `koru_allocator()` is the spine every stdlib
        // proc draws from; on this target it now resolves to the image's own
        // `posix_memalign`/`free`, the same way std/io's printing resolves to the
        // image's `fputs`.
        const alloc = koru_allocator();
        const body = std.fmt.allocPrint(alloc, "hello from koru — request {d} of 3, off the heap\n", .{served + 1}) catch return .{ .failed = "out of memory building the body" };
        defer alloc.free(body);
        const head = std.fmt.allocPrint(alloc, $mod.REPLY_HEAD, .{body.len}) catch return .{ .failed = "out of memory building the head" };
        defer alloc.free(head);

        _ = $mod.send(c, head.ptr, head.len, 0);
        _ = $mod.send(c, body.ptr, body.len, 0);
        _ = $mod.close(c);
        served += 1;
    }
    _ = $mod.close(fd);
    return .{ .stopped = "served 3" };
}

~serve(port: 8080)
| stopped s |> std/io:print.ln("koru unikernel: {{ s:s }}")
| failed e |> std/io:print.ln("koru unikernel FAILED at {{ e:s }}")
