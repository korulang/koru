    { name: "615_029 dim composition", directory: "615_029_quantity_dim_composition", categorySlug: "600_STDLIB/615_NUM", description: "(m/s)*s -> m, (m/s)/s -> m/s^2, and N*m ≡ J by canonical equivalence." },
    { name: "615_027 untainted refusal", directory: "615_027_reject_untainted_quantity", categorySlug: "600_STDLIB/615_NUM", description: "Quantity text that skipped lit/ingest cannot reach the ops." },
    { name: "615_070 juxtaposed units", directory: "615_070_quantity_lit_juxtapose", categorySlug: "600_STDLIB/615_NUM", description: "5 m/s, 5m/s and 5*m/s are one quantity; kgm is kg*m; non-unit tails refuse." }
