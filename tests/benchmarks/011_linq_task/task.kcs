// C# facet: `acc` is the RESULT boundary, not the accumulator — the loop
// accumulates into a real `capture` cell (ValueTuple on cs); this proc just
// copies the finished total out for the harness to read. KoruHost.total is
// the same public surface Program.cs always read.
using static KoruHost;

static class KoruHost {
    public static long total = 0;
}

~proc acc|cs { total = v; }
