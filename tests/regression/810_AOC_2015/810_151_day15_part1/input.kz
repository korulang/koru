// FRONTIER LEDGER: ingredient table ← store; signed-property parse ← groups.

const std = @import("std");

var props: [8][5]i64 = undefined;
var n_ing: usize = 0;

~proc add-ingredient|zig {
    var nums: [5]i64 = undefined;
    var idx: usize = 0;
    var cur: i64 = 0;
    var sign: i64 = 1;
    var in_num = false;
    for (line) |c| {
        if (c == '-') {
            sign = -1;
        } else if (c >= '0' and c <= '9') {
            cur = cur * 10 + (c - '0');
            in_num = true;
        } else {
            if (in_num) {
                nums[idx] = sign * cur;
                idx += 1;
                cur = 0;
                in_num = false;
            }
            sign = 1;
        }
    }
    if (in_num) nums[idx] = sign * cur;
    props[n_ing] = nums;
    n_ing += 1;
}

~proc score|zig {
    // two-ingredient example: amounts a and 100-a
    const amts = [2]i64{ a, 100 - a };
    var total: i64 = 1;
    for (0..4) |p| {
        var s: i64 = 0;
        for (0..n_ing) |i| s += amts[i] * props[i][p];
        total *= @max(0, s);
    }
    if (calorie_target > 0) {
        var cal: i64 = 0;
        for (0..n_ing) |i| cal += amts[i] * props[i][4];
        if (cal != calorie_target) total = 0;
    }
    return .{ .points = total };
}
