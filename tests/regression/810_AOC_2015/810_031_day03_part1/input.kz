// FRONTIER LEDGER for day 3 part 1:
// - visit/house-count: the visited SET — the store frontier (collections
//   have no Koru surface; votes with 320_034/036/038)
// - classify: char dispatch wants a Koru surface (match on chars, or a
//   branch-on-value form)

const std = @import("std");

const Pos = struct { x: i64, y: i64 };
var visited: ?std.AutoHashMap(Pos, void) = null;

~proc visit|zig {
    if (visited == null) visited = std.AutoHashMap(Pos, void).init(koru_allocator());
    visited.?.put(.{ .x = x, .y = y }, {}) catch unreachable;
}

~proc house-count|zig {
    const n: i64 = @intCast(visited.?.count());
    visited.?.deinit();
    visited = null;
    return .{ .count = n };
}

~proc classify|zig {
    return switch (c) {
        '^' => .{ .up = .{} },
        'v' => .{ .down = .{} },
        '<' => .{ .left = .{} },
        '>' => .{ .right = .{} },
        else => unreachable,
    };
}
