// FRONTIER LEDGER: distance table ← store; permutations ← host search;
// endpoint extraction ← groups.

const std = @import("std");

var names_buf: [16][]const u8 = undefined;
var n_names: usize = 0;
var dist: [16][16]i64 = undefined;

fn cityIdx(name: []const u8) usize {
    for (names_buf[0..n_names], 0..) |nm, i| {
        if (std.mem.eql(u8, nm, name)) return i;
    }
    names_buf[n_names] = koru_allocator().dupe(u8, name) catch unreachable;
    n_names += 1;
    return n_names - 1;
}

~proc edge|zig {
    const to_at = std.mem.indexOf(u8, line, " to ").?;
    const eq_at = std.mem.indexOf(u8, line, " = ").?;
    const a = cityIdx(line[0..to_at]);
    const b = cityIdx(line[to_at + 4 .. eq_at]);
    const d = std.fmt.parseInt(i64, line[eq_at + 3 ..], 10) catch unreachable;
    dist[a][b] = d;
    dist[b][a] = d;
}

fn permuteBest(used: *[16]bool, cur: usize, depth: usize, acc: i64, want_long: bool, best_v: *i64) void {
    if (depth == n_names) {
        if (want_long) {
            if (acc > best_v.*) best_v.* = acc;
        } else if (best_v.* < 0 or acc < best_v.*) best_v.* = acc;
        return;
    }
    for (0..n_names) |i| {
        if (used[i]) continue;
        used[i] = true;
        const step = if (depth == 0) 0 else dist[cur][i];
        permuteBest(used, i, depth + 1, acc + step, want_long, best_v);
        used[i] = false;
    }
}

~proc best|zig {
    var used = [_]bool{false} ** 16;
    var v: i64 = if (longest == 1) 0 else -1;
    permuteBest(&used, 0, 0, 0, longest == 1, &v);
    for (names_buf[0..n_names]) |nm| koru_allocator().free(nm);
    n_names = 0;
    return .{ .dist = v };
}
