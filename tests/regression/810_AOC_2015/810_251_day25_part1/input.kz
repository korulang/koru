// FRONTIER LEDGER: two-int parse ← groups/typed destructure.

const std = @import("std");

~proc parse-pos|zig {
    var it = std.mem.splitScalar(u8, line, ' ');
    const r = std.fmt.parseInt(i64, it.next().?, 10) catch unreachable;
    const c = std.fmt.parseInt(i64, it.next().?, 10) catch unreachable;
    return .{ .pos = .{ .r = r, .c = c } };
}
