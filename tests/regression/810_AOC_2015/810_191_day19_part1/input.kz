// FRONTIER LEDGER: rule table + result set ← store; split ← groups.

const std = @import("std");

var froms: [64][]const u8 = undefined;
var tos: [64][]const u8 = undefined;
var n_rules: usize = 0;

~proc add-rule|zig {
    const at = std.mem.indexOf(u8, line, " => ").?;
    froms[n_rules] = koru_allocator().dupe(u8, line[0..at]) catch unreachable;
    tos[n_rules] = koru_allocator().dupe(u8, line[at + 4 ..]) catch unreachable;
    n_rules += 1;
}

~proc count-molecules|zig {
    var seen = std.StringHashMap(void).init(koru_allocator());
    for (0..n_rules) |r| {
        var i: usize = 0;
        while (i + froms[r].len <= molecule.len) : (i += 1) {
            if (!std.mem.eql(u8, molecule[i .. i + froms[r].len], froms[r])) continue;
            const out = std.fmt.allocPrint(koru_allocator(), "{s}{s}{s}", .{ molecule[0..i], tos[r], molecule[i + froms[r].len ..] }) catch unreachable;
            const gop = seen.getOrPut(out) catch unreachable;
            if (gop.found_existing) koru_allocator().free(out);
        }
    }
    const n: i64 = @intCast(seen.count());
    var it = seen.keyIterator();
    while (it.next()) |k| koru_allocator().free(k.*);
    seen.deinit();
    for (0..n_rules) |r| {
        koru_allocator().free(froms[r]);
        koru_allocator().free(tos[r]);
    }
    n_rules = 0;
    return .{ .distinct = n };
}
