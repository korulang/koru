// FRONTIER LEDGER: decode ← string-ops; program table ← store.
// The machine loop itself is Koru (top-level label fold in input.k).

const std = @import("std");

var prog: [64][]const u8 = undefined;
var n_prog: usize = 0;

~proc load|zig {
    prog[n_prog] = koru_allocator().dupe(u8, line) catch unreachable;
    n_prog += 1;
}

~proc step|zig {
    if (pc < 0 or pc >= n_prog) {
        for (prog[0..n_prog]) |l| koru_allocator().free(l);
        n_prog = 0;
        return .{ .halted = .{ .a = a, .b = b } };
    }
    const ins = prog[@intCast(pc)];
    var na = a;
    var nb = b;
    var npc = pc + 1;
    const reg_is_a = ins[4] == 'a';
    if (std.mem.startsWith(u8, ins, "hlf")) {
        if (reg_is_a) na = @divTrunc(a, 2) else nb = @divTrunc(b, 2);
    } else if (std.mem.startsWith(u8, ins, "tpl")) {
        if (reg_is_a) na = a * 3 else nb = b * 3;
    } else if (std.mem.startsWith(u8, ins, "inc")) {
        if (reg_is_a) na = a + 1 else nb = b + 1;
    } else if (std.mem.startsWith(u8, ins, "jmp")) {
        npc = pc + parseOffset(ins[4..]);
    } else if (std.mem.startsWith(u8, ins, "jie")) {
        const v = if (reg_is_a) a else b;
        if (@mod(v, 2) == 0) npc = pc + parseOffset(ins[7..]);
    } else if (std.mem.startsWith(u8, ins, "jio")) {
        const v = if (reg_is_a) a else b;
        if (v == 1) npc = pc + parseOffset(ins[7..]);
    }
    return .{ .cont = .{ .pc = npc, .a = na, .b = nb } };
}

fn parseOffset(s: []const u8) i64 {
    const t = std.mem.trim(u8, s, " +");
    return std.fmt.parseInt(i64, t, 10) catch unreachable;
}
