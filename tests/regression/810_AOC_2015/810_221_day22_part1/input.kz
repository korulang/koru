// FRONTIER LEDGER: the effect-timer turn engine ← host.

const std = @import("std");

var out_bufs: [8][64]u8 = undefined;
var out_n: usize = 0;

~proc fight|zig {
    var it = std.mem.splitScalar(u8, line, ' ');
    var bhp = std.fmt.parseInt(i64, it.next().?, 10) catch unreachable;
    const bd = std.fmt.parseInt(i64, it.next().?, 10) catch unreachable;
    var hp: i64 = 10;
    var mana: i64 = 250;
    var shield: i64 = 0;
    var poison: i64 = 0;
    var recharge: i64 = 0;
    var won = false;

    while (it.next()) |spell| {
        // ── player turn: tick effects, then cast ──
        if (poison > 0) bhp -= 3;
        if (recharge > 0) mana += 101;
        shield = @max(0, shield - 1);
        poison = @max(0, poison - 1);
        recharge = @max(0, recharge - 1);
        if (bhp <= 0) {
            won = true;
            break;
        }
        if (std.mem.eql(u8, spell, "missile")) {
            mana -= 53;
            bhp -= 4;
        } else if (std.mem.eql(u8, spell, "drain")) {
            mana -= 73;
            bhp -= 2;
            hp += 2;
        } else if (std.mem.eql(u8, spell, "shield")) {
            mana -= 113;
            shield = 6;
        } else if (std.mem.eql(u8, spell, "poison")) {
            mana -= 173;
            poison = 6;
        } else if (std.mem.eql(u8, spell, "recharge")) {
            mana -= 229;
            recharge = 5;
        }
        if (bhp <= 0) {
            won = true;
            break;
        }
        // ── boss turn: tick effects, then attack ──
        const arm: i64 = if (shield > 0) 7 else 0;
        if (poison > 0) bhp -= 3;
        if (recharge > 0) mana += 101;
        shield = @max(0, shield - 1);
        poison = @max(0, poison - 1);
        recharge = @max(0, recharge - 1);
        if (bhp <= 0) {
            won = true;
            break;
        }
        hp -= @max(1, bd - arm);
        if (hp <= 0) break;
    }
    // post-script: if boss still alive, let pending poison finish (fight 1
    // ends on a poison tick after the last cast — per the statement trace)
    while (!won and poison > 0 and hp > 0) {
        bhp -= 3;
        poison -= 1;
        if (bhp <= 0) won = true;
    }
    const buf = &out_bufs[out_n];
    out_n += 1;
    const o = if (won)
        std.fmt.bufPrint(buf, "win hp={d} mana={d}", .{ hp, mana }) catch unreachable
    else
        std.fmt.bufPrint(buf, "lose hp={d} mana={d}", .{ hp, mana }) catch unreachable;
    return .{ .outcome = o };
}
