// FRONTIER LEDGER: loadout search ← host; boss parse ← groups.

const std = @import("std");

const W = [_][3]i64{ .{ 8, 4, 0 }, .{ 10, 5, 0 }, .{ 25, 6, 0 }, .{ 40, 7, 0 }, .{ 74, 8, 0 } };
const A = [_][3]i64{ .{ 0, 0, 0 }, .{ 13, 0, 1 }, .{ 31, 0, 2 }, .{ 53, 0, 3 }, .{ 75, 0, 4 }, .{ 102, 0, 5 } };
const R = [_][3]i64{ .{ 0, 0, 0 }, .{ 0, 0, 0 }, .{ 25, 1, 0 }, .{ 50, 2, 0 }, .{ 100, 3, 0 }, .{ 20, 0, 1 }, .{ 40, 0, 2 }, .{ 80, 0, 3 } };

~proc shop|zig {
    var nums: [3]i64 = undefined;
    var idx: usize = 0;
    var it = std.mem.splitScalar(u8, line, ' ');
    while (it.next()) |tok| {
        nums[idx] = std.fmt.parseInt(i64, tok, 10) catch unreachable;
        idx += 1;
    }
    const bh = nums[0];
    const bd = nums[1];
    const ba = nums[2];
    var best: i64 = 1 << 60;
    var worst: i64 = 0;
    for (W) |w| {
        for (A) |a| {
            for (R, 0..) |r1, i| {
                for (R[i + 1 ..]) |r2| {
                    const cost = w[0] + a[0] + r1[0] + r2[0];
                    const dmg = @max(1, w[1] + r1[1] + r2[1] - ba);
                    const arm = a[2] + r1[2] + r2[2];
                    const bdmg = @max(1, bd - arm);
                    const my_turns = @divTrunc(bh + dmg - 1, dmg);
                    const boss_turns = @divTrunc(100 + bdmg - 1, bdmg);
                    if (my_turns <= boss_turns) {
                        best = @min(best, cost);
                    } else {
                        worst = @max(worst, cost);
                    }
                }
            }
        }
    }
    return .{ .gold = if (want_loss == 1) worst else best };
}
