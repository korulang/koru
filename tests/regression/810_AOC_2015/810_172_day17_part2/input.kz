// FRONTIER LEDGER: subset search ← host recursion; sizes ← store.

const std = @import("std");

var sizes: [32]i64 = undefined;
var n_sizes: usize = 0;

~proc add-container|zig {
    sizes[n_sizes] = std.fmt.parseInt(i64, line, 10) catch unreachable;
    n_sizes += 1;
}

fn count(i: usize, left: i64, used: usize, counts: *[33]i64) void {
    if (left == 0) {
        counts[used] += 1;
        return;
    }
    if (i >= n_sizes or left < 0) return;
    count(i + 1, left - sizes[i], used + 1, counts);
    count(i + 1, left, used, counts);
}

~proc combos|zig {
    var counts = [_]i64{0} ** 33;
    count(0, target, 0, &counts);
    n_sizes = 0;
    if (min_only == 1) {
        for (counts) |c| {
            if (c > 0) return .{ .ways = c };
        }
        return .{ .ways = 0 };
    }
    var total: i64 = 0;
    for (counts) |c| total += c;
    return .{ .ways = total };
}
