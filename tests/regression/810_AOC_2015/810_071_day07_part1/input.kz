// FRONTIER LEDGER: wire map + memo ← store; operand split ← groups;
// recursive eval ← host recursion. Dispatch is Koru's (match arms).

const std = @import("std");

var lines_buf: [512][]const u8 = undefined;
var n_lines: usize = 0;
var memo: ?std.StringHashMap(u16) = null;

~proc store|zig {
    lines_buf[n_lines] = koru_allocator().dupe(u8, line) catch unreachable;
    n_lines += 1;
}

fn evalOperand(tok: []const u8) u16 {
    if (tok[0] >= '0' and tok[0] <= '9') {
        return std.fmt.parseInt(u16, tok, 10) catch unreachable;
    }
    return evalWire(tok);
}

fn evalWire(w: []const u8) u16 {
    if (memo.?.get(w)) |v| return v;
    for (lines_buf[0..n_lines]) |l| {
        const arrow = std.mem.indexOf(u8, l, " -> ") orelse continue;
        if (!std.mem.eql(u8, l[arrow + 4 ..], w)) continue;
        const lhs = l[0..arrow];
        var v: u16 = undefined;
        if (std.mem.indexOf(u8, lhs, " AND ")) |i| {
            v = evalOperand(lhs[0..i]) & evalOperand(lhs[i + 5 ..]);
        } else if (std.mem.indexOf(u8, lhs, " OR ")) |i| {
            v = evalOperand(lhs[0..i]) | evalOperand(lhs[i + 4 ..]);
        } else if (std.mem.indexOf(u8, lhs, " LSHIFT ")) |i| {
            v = evalOperand(lhs[0..i]) << @intCast(std.fmt.parseInt(u4, lhs[i + 8 ..], 10) catch unreachable);
        } else if (std.mem.indexOf(u8, lhs, " RSHIFT ")) |i| {
            v = evalOperand(lhs[0..i]) >> @intCast(std.fmt.parseInt(u4, lhs[i + 8 ..], 10) catch unreachable);
        } else if (std.mem.startsWith(u8, lhs, "NOT ")) {
            v = ~evalOperand(lhs[4..]);
        } else {
            v = evalOperand(lhs);
        }
        memo.?.put(w, v) catch unreachable;
        return v;
    }
    unreachable;
}

~proc query|zig {
    if (memo == null) memo = std.StringHashMap(u16).init(koru_allocator());
    const v: i64 = evalWire(w);
    // Last query drains the stores (meter-clean): "i" is the final one.
    if (std.mem.eql(u8, w, "i")) {
        memo.?.deinit();
        memo = null;
        for (lines_buf[0..n_lines]) |l| koru_allocator().free(l);
        n_lines = 0;
    }
    return .{ .signal = v };
}
