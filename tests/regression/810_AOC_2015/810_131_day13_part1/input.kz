// FRONTIER LEDGER: happiness table ← store; permutations ← host;
// name/amount extraction ← groups. Sentence-form dispatch is Koru's.

const std = @import("std");

var names_buf: [16][]const u8 = undefined;
var n_names: usize = 0;
var hap: [16][16]i64 = std.mem.zeroes([16][16]i64);

fn personIdx(name: []const u8) usize {
    for (names_buf[0..n_names], 0..) |nm, i| {
        if (std.mem.eql(u8, nm, name)) return i;
    }
    names_buf[n_names] = koru_allocator().dupe(u8, name) catch unreachable;
    n_names += 1;
    return n_names - 1;
}

~proc pref|zig {
    const sp1 = std.mem.indexOf(u8, line, " ").?;
    const a = personIdx(line[0..sp1]);
    var amt: i64 = 0;
    var i: usize = 0;
    while (i < line.len) : (i += 1) {
        if (line[i] >= '0' and line[i] <= '9') {
            amt = amt * 10 + (line[i] - '0');
        } else if (amt > 0) break;
    }
    const to_at = std.mem.lastIndexOf(u8, line, " ").?;
    const b = personIdx(line[to_at + 1 .. line.len - 1]); // strip trailing '.'
    hap[a][b] += sign * amt;
}

fn permuteSeat(used: *[16]bool, order: *[16]usize, depth: usize, best_v: *i64) void {
    if (depth == n_names) {
        var total: i64 = 0;
        for (0..n_names) |i| {
            const a = order[i];
            const b = order[(i + 1) % n_names];
            total += hap[a][b] + hap[b][a];
        }
        if (total > best_v.*) best_v.* = total;
        return;
    }
    for (0..n_names) |i| {
        if (used[i]) continue;
        used[i] = true;
        order[depth] = i;
        permuteSeat(used, order, depth + 1, best_v);
        used[i] = false;
    }
}

~proc best-seating|zig {
    var used = [_]bool{false} ** 16;
    var order = [_]usize{0} ** 16;
    var v: i64 = -1 << 62;
    permuteSeat(&used, &order, 0, &v);
    for (names_buf[0..n_names]) |nm| koru_allocator().free(nm);
    n_names = 0;
    return .{ .happiness = v };
}
