// FRONTIER LEDGER: recursive JSON walk ← store/string-ops; the red-object
// rule needs structure the flat machine (810_121) cannot see.

const std = @import("std");

const V = struct { sum: i64, red: bool };

const P = struct {
    s: []const u8,
    i: usize,

    fn value(self: *P) V {
        switch (self.s[self.i]) {
            '{' => return self.object(),
            '[' => return self.array(),
            '"' => {
                const str = self.string();
                return .{ .sum = 0, .red = std.mem.eql(u8, str, "red") };
            },
            else => return .{ .sum = self.number(), .red = false },
        }
    }

    fn object(self: *P) V {
        self.i += 1; // {
        var sum: i64 = 0;
        var red = false;
        while (self.s[self.i] != '}') {
            if (self.s[self.i] == ',' or self.s[self.i] == ':') {
                self.i += 1;
                continue;
            }
            const v = self.value(); // keys parse as strings (never "red"-relevant? they CAN be: only VALUES count — keys are followed by ':')
            if (self.s[self.i] == ':') {
                // that was a key; skip the colon, parse the value
                self.i += 1;
                const vv = self.value();
                sum += vv.sum;
                if (vv.red) red = true;
            } else {
                sum += v.sum;
                if (v.red) red = true;
            }
        }
        self.i += 1; // }
        return .{ .sum = if (red) 0 else sum, .red = false };
    }

    fn array(self: *P) V {
        self.i += 1; // [
        var sum: i64 = 0;
        while (self.s[self.i] != ']') {
            if (self.s[self.i] == ',') {
                self.i += 1;
                continue;
            }
            const v = self.value();
            sum += v.sum;
        }
        self.i += 1; // ]
        return .{ .sum = sum, .red = false };
    }

    fn string(self: *P) []const u8 {
        self.i += 1; // "
        const start = self.i;
        while (self.s[self.i] != '"') self.i += 1;
        const out = self.s[start..self.i];
        self.i += 1; // closing "
        return out;
    }

    fn number(self: *P) i64 {
        var sign: i64 = 1;
        if (self.s[self.i] == '-') {
            sign = -1;
            self.i += 1;
        }
        var n: i64 = 0;
        while (self.i < self.s.len and self.s[self.i] >= '0' and self.s[self.i] <= '9') {
            n = n * 10 + (self.s[self.i] - '0');
            self.i += 1;
        }
        return sign * n;
    }
};

~proc sum-no-red|zig {
    var p = P{ .s = s, .i = 0 };
    const v = p.value();
    return .{ .total = v.sum };
}
