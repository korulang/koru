// FRONTIER LEDGER (FAT): hunt loop ← 210_123 (label-in-subflow panic);
// divisor sum ← host; to-int ← string-ops/typed-groups.

const std = @import("std");

~proc to-int|zig {
    return .{ .value = std.fmt.parseInt(i64, s, 10) catch unreachable };
}

~proc hunt|zig {
    var house: i64 = 1;
    while (true) : (house += 1) {
        var sum: i64 = 0;
        var d: i64 = 1;
        while (d * d <= house) : (d += 1) {
            if (@mod(house, d) != 0) continue;
            const e = @divTrunc(house, d);
            if (0 == 1) {
                if (e <= 50) sum += d * 11;
                if (d != e and d <= 50) sum += e * 11;
            } else {
                sum += d * 10;
                if (d != e) sum += e * 10;
            }
        }
        if (sum >= target) return .{ .house = house };
    }
}
