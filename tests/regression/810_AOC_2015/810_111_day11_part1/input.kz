// FRONTIER LEDGER: search loop ← 210_123 (label-in-subflow panic);
// string increment/validate ← string-ops (gap 4).

const std = @import("std");

var out_buf: [16][64]u8 = undefined;
var out_n: usize = 0;

fn valid(p: []const u8) bool {
    var straight = false;
    var i: usize = 0;
    while (i + 2 < p.len) : (i += 1) {
        if (p[i + 1] == p[i] + 1 and p[i + 2] == p[i] + 2) straight = true;
    }
    if (!straight) return false;
    for (p) |c| {
        if (c == 'i' or c == 'o' or c == 'l') return false;
    }
    var pairs: usize = 0;
    var last_pair_end: usize = 0;
    i = 0;
    while (i + 1 < p.len) : (i += 1) {
        if (p[i] == p[i + 1] and (last_pair_end == 0 or i > last_pair_end)) {
            pairs += 1;
            last_pair_end = i + 1;
        }
    }
    return pairs >= 2;
}

fn increment(p: []u8) void {
    var i: usize = p.len;
    while (i > 0) {
        i -= 1;
        if (p[i] == 'z') {
            p[i] = 'a';
        } else {
            p[i] += 1;
            return;
        }
    }
}

~proc next-password|zig {
    const buf = &out_buf[out_n];
    out_n += 1;
    @memcpy(buf[0..s.len], s);
    const p = buf[0..s.len];
    while (true) {
        increment(p);
        if (valid(p)) return .{ .pw = p };
    }
}
