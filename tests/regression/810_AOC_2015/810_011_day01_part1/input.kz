// AoC 2015 Day 1 Part 1 — "Not Quite Lisp" (statement example: "(()(()(" → 3).
// PRISTINE: Koru carries the whole structure — the capture cell accumulates,
// for iterates the input's chars, if branches, captured { } computes the next
// cell value. The only host code is leaf expressions (comparison, ±1).
// This rung voted on the capture/store question — and capture won.

~import std/io
~import std/control

const input = "(()(()(";

~capture { floor: @as(i32, 0) }
! as acc |> for(input)
    ! each c |> if(c == '(')
        | then |> captured { floor: acc.floor + 1 }
        | else |> captured { floor: acc.floor - 1 }
| captured result |> std/io:print.ln("{{ result.floor:d }}")
