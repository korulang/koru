// FRONTIER LEDGER: grid ← store (gap 2); coordinate extraction ← regex
// groups (gap 1). The DISPATCH is Koru's (match arms in input.k).

const std = @import("std");

var grid: ?[]bool = null;

fn parseCoords(line: []const u8) [4]usize {
    var out: [4]usize = undefined;
    var idx: usize = 0;
    var cur: usize = 0;
    var in_num = false;
    for (line) |c| {
        if (c >= '0' and c <= '9') {
            cur = cur * 10 + (c - '0');
            in_num = true;
        } else if (in_num) {
            out[idx] = cur;
            idx += 1;
            cur = 0;
            in_num = false;
        }
    }
    if (in_num) {
        out[idx] = cur;
        idx += 1;
    }
    return out;
}

~proc apply|zig {
    if (grid == null) {
        grid = koru_allocator().alloc(bool, 1000 * 1000) catch unreachable;
        @memset(grid.?, false);
    }
    const c = parseCoords(line);
    var y = c[1];
    while (y <= c[3]) : (y += 1) {
        var x = c[0];
        while (x <= c[2]) : (x += 1) {
            const i = y * 1000 + x;
            grid.?[i] = switch (op) {
                1 => true,
                2 => false,
                else => !grid.?[i],
            };
        }
    }
}

~proc lit-count|zig {
    var n: i64 = 0;
    for (grid.?) |b| {
        if (b) n += 1;
    }
    koru_allocator().free(grid.?);
    grid = null;
    return .{ .count = n };
}
