// JavaScript implementation facet. Events are declared in input.kz (merged at
// import); this file holds the |js proc bodies.

~proc stage-a|js {
    if (ctx < 0) return { tag: "failed", failed: "negative" };
    return { tag: "ctx", ctx: ctx + 1 };
}

~proc stage-b|js { return { tag: "ctx", ctx: ctx * 2 }; }
