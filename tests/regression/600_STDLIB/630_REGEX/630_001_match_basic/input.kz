// STATUS: RED pin — match e2e WIP. Engine + branch-reading + matcher-gen
// work; the dispatch mechanism is wrong (transform inline_body hits the
// emitter EXPAND-SWITCH path, needs valid Zig branch tags + the right union
// value — see koru_std/regex.kz). Goes GREEN when the dispatch is fixed.
// Regex match as control flow — first e2e. `match(input)` dispatches to the
// first `…`-pattern branch that fully matches, else `no-match`. Patterns are
// compiled to specialized DFA matchers at compile time (std/regex).
~import std/regex
~import std/io

~match("foo@bar")
| `[a-z]+@[a-z]+` _ |> std/io:print("matched-email\n")
| `[0-9]+` _ |> std/io:print("matched-number\n")
| no-match _ |> std/io:print("no-match\n")
