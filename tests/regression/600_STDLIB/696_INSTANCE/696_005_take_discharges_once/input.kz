// PIN 696_005 — take discharges once (type-system synthesis walk, 2026-08-23).
//
// DOCTRINE UNDER TEST:
//   Exit-under-obligation is inherited intact from the store. `take` already
//   carries "a taken row must be consumed or given back" on its phantom
//   (690_007/015); `instance` speaks row language with no home, so its pieces
//   obey the same grammar. Taking twice is the double free — caught by the
//   checker at the KORU layer instead of by a segfault in generated code.
//   Every obligation has one birthplace and one discharge site; the second
//   take has neither.
//
// Here the instance is taken once, consumed, then taken again.

~import std/store
~import std/io

~std/store:proto(box) {
    n: i32
}

~proc main {
    std/store:instance(box) {
        n: 7
    }
    | made b |>
        std/store:take(b)
        | parts p |> std/io:print.ln("taken once")

    std/store:take(b)
    | parts p |> std/io:print.ln("never printed")
}
