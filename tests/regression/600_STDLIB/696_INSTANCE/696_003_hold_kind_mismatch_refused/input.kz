// PIN 696_003 — hold kind mismatch is refused (type-system synthesis walk, 2026-08-23).
//
// DOCTRINE UNDER TEST:
//   Receipts are typed witnesses, never words. A slot that holds
//   `*Engine<running!>` accepts only values of exactly that signature; a
//   `*Pump<primed!>` is a different witness and must be refused at the KORU
//   layer, naming BOTH types. This is the same refusal the registry makes for
//   distinct stamped identities (030_132) — moved from declared types to
//   holds. The diagnostic must never be a Zig error pointing into generated
//   code.
//
// Here a pump is offered where an engine is held.

~import std/store

~std/store:proto(garage) {
    engine: *Engine<running!>
}

~tor mint-pump {} -> *Pump<primed!>

~proc main {
    std/store:instance(garage) {
        engine: mint-pump()
    }
    | ready g |> std/io:print.ln("unreachable")
}
