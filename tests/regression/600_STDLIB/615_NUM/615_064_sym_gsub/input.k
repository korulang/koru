// B7: generalized-substitution lane.  For a tower element theta with a
// logarithmic-derivative factor, t = theta removes x entirely:
// theta = e^g -> dt = g*theta*dx (g need not be affine — the exp-theta
// lane's arg-nonlinear arm), and theta = log(u) -> dt = (u'/u) dx.
// The lane fires when H/dlog is rational in t; bare x atoms that
// survive norm mean the substitution reintroduces x and the candidate
// refuses.  Exactness is the chain rule over the inner checked-exact.

import std/io
import std/sym

std/sym:lit((2e0*x*exp((x*x))*inv((1e0+exp((x*x))))))
| exact a |> std/sym:decide-integral(a, max-order: 3, max-deg: 6)
    | elementary m |> std/io:print.ln("{{ m:s }}") |> std/io:free(content: m)
    | holonomic-special m |> std/io:print.ln("hs:{{ m:s }}") |> std/io:free(content: m)
    | unresolved m |> std/io:print.ln("un:{{ m:s }}") |> std/io:free(content: m)
    | not-holonomic m |> std/io:print.ln("nh:{{ m:s }}") |> std/io:free(content: m)
    | non-rational |> std/io:print.ln("nr")
    | non-analytic |> std/io:print.ln("na")
    | bad |> std/io:print.ln("bad")
| bad |> std/io:print.ln("bad-lit")

