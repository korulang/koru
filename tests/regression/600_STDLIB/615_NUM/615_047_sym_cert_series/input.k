import std/io
import std/sym

// theorem-derived cert for sqrt(1+x): 2(1+x)g' - g = 0
std/sym:lit { √((1e0+x)) }
| exact a |> std/sym:cert-of(a)
    | exact c |> std/io:print.ln("{{ c:s }}") |> std/io:free(content: c)
    | not-holonomic m |> std/io:print.ln("nh:{{ m:s }}") |> std/io:free(content: m)
    | bad m |> std/io:print.ln("bad:{{ m:s }}") |> std/io:free(content: m)
| bad |> std/io:print.ln("bad-lit")

// certified series: seeds exact, tail generated by the recurrence
std/sym:lit { √((1e0+x)) }
| exact a |> std/sym:cert-series(a, terms: 8)
    | exact c |> std/io:print.ln("{{ c:s }}") |> std/io:free(content: c)
    | under-determined m |> std/io:print.ln("ud:{{ m:s }}") |> std/io:free(content: m)
    | not-holonomic m |> std/io:print.ln("nh:{{ m:s }}") |> std/io:free(content: m)
    | non-rational |> std/io:print.ln("nr")
    | non-analytic |> std/io:print.ln("na")
    | bad |> std/io:print.ln("bad")
| bad |> std/io:print.ln("bad-lit")

// independent witness: plain series must agree
std/sym:lit { √((1e0+x)) }
| exact a |> std/sym:series(a, terms: 8)
    | exact s |> std/io:print.ln("{{ s:s }}") |> std/io:free(content: s)
    | non-rational |> std/io:print.ln("nr")
    | non-analytic |> std/io:print.ln("na")
    | bad |> std/io:print.ln("bad")
| bad |> std/io:print.ln("bad-lit")

// 1/(1-x) through the poly-inv lane, 8 certified terms
std/sym:lit { inv((1e0+(-1e0*x))) }
| exact a |> std/sym:cert-series(a, terms: 8)
    | exact c |> std/io:print.ln("{{ c:s }}") |> std/io:free(content: c)
    | under-determined m |> std/io:print.ln("ud:{{ m:s }}") |> std/io:free(content: m)
    | not-holonomic m |> std/io:print.ln("nh:{{ m:s }}") |> std/io:free(content: m)
    | non-rational |> std/io:print.ln("nr")
    | non-analytic |> std/io:print.ln("na")
    | bad |> std/io:print.ln("bad")
| bad |> std/io:print.ln("bad-lit")

// x alone: the recurrence cannot determine a_1 -> under-determined
std/sym:lit { (x) }
| exact a |> std/sym:cert-series(a, terms: 5)
    | exact c |> std/io:print.ln("{{ c:s }}") |> std/io:free(content: c)
    | under-determined m |> std/io:print.ln("ud:{{ m:s }}") |> std/io:free(content: m)
    | not-holonomic m |> std/io:print.ln("nh:{{ m:s }}") |> std/io:free(content: m)
    | non-rational |> std/io:print.ln("nr")
    | non-analytic |> std/io:print.ln("na")
    | bad |> std/io:print.ln("bad")
| bad |> std/io:print.ln("bad-lit")

// sqrt of a non-polynomial -> named refusal
std/sym:lit { √(inv(x)) }
| exact a |> std/sym:cert-of(a)
    | exact c |> std/io:print.ln("{{ c:s }}") |> std/io:free(content: c)
    | not-holonomic m |> std/io:print.ln("nh:{{ m:s }}") |> std/io:free(content: m)
    | bad m |> std/io:print.ln("bad:{{ m:s }}") |> std/io:free(content: m)
| bad |> std/io:print.ln("bad-lit")
