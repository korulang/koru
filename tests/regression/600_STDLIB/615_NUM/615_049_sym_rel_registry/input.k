import std/io
import std/sym

// rel band 1: declared generators with derivative laws.
// Conservation: D(sin^2+cos^2) = 0 mechanically under sin'=cos, cos'=-sin.
std/sym:rel-new(): r0
|> std/sym:rel-seed(reg: r0, name: "sin")
    | exact r1 |> std/sym:rel-seed(reg: r1, name: "cos")
        | exact r2 |> std/sym:rel-law(reg: r2, name: "sin", law: "g(cos)")
            | exact r3 |> std/sym:rel-law(reg: r3, name: "cos", law: "(-1e0*g(sin))")
                | exact r4 |> std/sym:rel-derive(reg: r4, a: "g(sin)*g(sin)+g(cos)*g(cos)")
                    | exact d |> std/io:print.ln("{{ d:s }}") |> std/io:free(content: d)
                        |> std/sym:rel-norm(reg: r4, a: "g(sin)*g(cos)+g(cos)*g(sin)")
                            | exact n |> std/io:print.ln("{{ n:s }}") |> std/io:free(content: n)
                                |> std/sym:rel-derive(reg: r4, a: "g(ln)")
                                    | exact d2 |> std/io:print.ln("{{ d2:s }}") |> std/io:free(content: d2)
                                        |> std/io:print.ln("{{ r4:s }}") |> std/io:free(content: r4)
                                    | unknown-generator |> std/io:print.ln("ug") |> std/io:print.ln("{{ r4:s }}") |> std/io:free(content: r4)
                                    | lawless |> std/io:print.ln("ll-d") |> std/io:free(content: r4)
                                    | bad |> std/io:print.ln("bad-d2") |> std/io:free(content: r4)
                            | unknown-generator |> std/io:print.ln("ug-n") |> std/io:free(content: r4)
                            | bad |> std/io:print.ln("bad-n") |> std/io:free(content: r4)
                    | unknown-generator |> std/io:print.ln("ug-d") |> std/io:free(content: r4)
                    | lawless |> std/io:print.ln("ll-d1") |> std/io:free(content: r4)
                    | bad |> std/io:print.ln("bad-d") |> std/io:free(content: r4)
                | unknown-generator |> std/io:print.ln("ug-law2")
                | bad |> std/io:print.ln("bad-law2")
            | unknown-generator |> std/io:print.ln("ug-law1")
            | bad |> std/io:print.ln("bad-law1")
        | dup |> std/io:print.ln("dup2")
        | full |> std/io:print.ln("full2")
        | bad |> std/io:print.ln("bad-s2")
    | dup |> std/io:print.ln("dup1")
    | full |> std/io:print.ln("full1")
    | bad |> std/io:print.ln("bad-s1")

// exp self-law + product rule; then lawless + dup refusals.
std/sym:rel-new(): q0
|> std/sym:rel-seed(reg: q0, name: "exp")
    | exact q1 |> std/sym:rel-law(reg: q1, name: "exp", law: "g(exp)")
        | exact q2 |> std/sym:rel-derive(reg: q2, a: "g(exp)*x")
            | exact d |> std/io:print.ln("{{ d:s }}") |> std/io:free(content: d)
                |> std/sym:rel-seed(reg: q2, name: "f")
                    | exact q3 |> std/sym:rel-derive(reg: q3, a: "g(f)")
                        | exact d3 |> std/io:print.ln("{{ d3:s }}") |> std/io:free(content: d3) |> std/io:free(content: q3)
                        | unknown-generator |> std/io:print.ln("ug-f") |> std/io:free(content: q3)
                        | lawless |> std/io:print.ln("ll-f") |> std/io:free(content: q3)
                        | bad |> std/io:print.ln("bad-f") |> std/io:free(content: q3)
                    | dup |> std/io:print.ln("dup-f")
                    | full |> std/io:print.ln("full-f")
                    | bad |> std/io:print.ln("bad-sf")
            | unknown-generator |> std/io:print.ln("ug-e") |> std/io:free(content: q2)
            | lawless |> std/io:print.ln("ll-e") |> std/io:free(content: q2)
            | bad |> std/io:print.ln("bad-e") |> std/io:free(content: q2)
        | unknown-generator |> std/io:print.ln("ug-e1")
        | bad |> std/io:print.ln("bad-e1")
    | dup |> std/io:print.ln("dup-e")
    | full |> std/io:print.ln("full-e")
    | bad |> std/io:print.ln("bad-es")

// dup refusal on re-seed.
std/sym:rel-new(): p0
|> std/sym:rel-seed(reg: p0, name: "a")
    | exact p1 |> std/sym:rel-seed(reg: p1, name: "a")
        | exact p2 |> std/io:print.ln("no-dup") |> std/io:free(content: p2)
        | dup |> std/io:print.ln("dup-ok")
        | full |> std/io:print.ln("full-p")
        | bad |> std/io:print.ln("bad-p")
    | dup |> std/io:print.ln("dup-p0")
    | full |> std/io:print.ln("full-p0")
    | bad |> std/io:print.ln("bad-p0")
