// B7b: the dlog-factor substitution lane widened to two more monomial
// kinds.  theta = sqrt(u) gives dlog = u-prime/(2*theta); theta =
// atan(u) gives u-prime/(1+u^2).  Same contract as exp/log: the
// transformed integrand must be rational in t.  The sqrt kind needs
// one extra recovery: norm pairs equal sqrt factors into the
// radicand, so even powers of theta hide inside the u spelling — a
// canon-equal subexpression IS t^2.
//
// cases 1-4: sqrt substitutions (incl. u-folded theta powers).
// case 5: honest refusal — sqrt(1+x^2) alone needs the real tower.
// cases 6-7: atan substitutions.
// case 8: honest refusal — missing the u-prime factor.

import std/io
import std/sym
std/sym:lit((x*√((1e0+(x*x)))))
| exact a |> std/sym:decide-integral(a, max-order: 3, max-deg: 6)
    | elementary m |> std/io:print.ln("{{ m:s }}") |> std/io:free(content: m)
    | holonomic-special m |> std/io:print.ln("hs:{{ m:s }}") |> std/io:free(content: m)
    | unresolved m |> std/io:print.ln("un:{{ m:s }}") |> std/io:free(content: m)
    | not-holonomic m |> std/io:print.ln("nh:{{ m:s }}") |> std/io:free(content: m)
    | non-rational |> std/io:print.ln("nr")
    | non-analytic |> std/io:print.ln("na")
    | bad |> std/io:print.ln("bad")
| bad |> std/io:print.ln("bad-lit")
std/sym:lit((x*inv(√((1e0+(x*x))))))
| exact a |> std/sym:decide-integral(a, max-order: 3, max-deg: 6)
    | elementary m |> std/io:print.ln("{{ m:s }}") |> std/io:free(content: m)
    | holonomic-special m |> std/io:print.ln("hs:{{ m:s }}") |> std/io:free(content: m)
    | unresolved m |> std/io:print.ln("un:{{ m:s }}") |> std/io:free(content: m)
    | not-holonomic m |> std/io:print.ln("nh:{{ m:s }}") |> std/io:free(content: m)
    | non-rational |> std/io:print.ln("nr")
    | non-analytic |> std/io:print.ln("na")
    | bad |> std/io:print.ln("bad")
| bad |> std/io:print.ln("bad-lit")
std/sym:lit((5e-1*inv(√(x))))
| exact a |> std/sym:decide-integral(a, max-order: 3, max-deg: 6)
    | elementary m |> std/io:print.ln("{{ m:s }}") |> std/io:free(content: m)
    | holonomic-special m |> std/io:print.ln("hs:{{ m:s }}") |> std/io:free(content: m)
    | unresolved m |> std/io:print.ln("un:{{ m:s }}") |> std/io:free(content: m)
    | not-holonomic m |> std/io:print.ln("nh:{{ m:s }}") |> std/io:free(content: m)
    | non-rational |> std/io:print.ln("nr")
    | non-analytic |> std/io:print.ln("na")
    | bad |> std/io:print.ln("bad")
| bad |> std/io:print.ln("bad-lit")
std/sym:lit((2e0*x*√((1e0+(x*x)))*(1e0+(x*x))))
| exact a |> std/sym:decide-integral(a, max-order: 3, max-deg: 6)
    | elementary m |> std/io:print.ln("{{ m:s }}") |> std/io:free(content: m)
    | holonomic-special m |> std/io:print.ln("hs:{{ m:s }}") |> std/io:free(content: m)
    | unresolved m |> std/io:print.ln("un:{{ m:s }}") |> std/io:free(content: m)
    | not-holonomic m |> std/io:print.ln("nh:{{ m:s }}") |> std/io:free(content: m)
    | non-rational |> std/io:print.ln("nr")
    | non-analytic |> std/io:print.ln("na")
    | bad |> std/io:print.ln("bad")
| bad |> std/io:print.ln("bad-lit")
std/sym:lit(√((1e0+(x*x))))
