// File I/O module

const std = @import("std");

~pub event read { path: string }
| success string
| notfound string
| ioerror string

~pub event write { path: string, data: string }
| written i32
| ioerror string

~proc read|zig {
    std.debug.print("read {s}\n", .{path});
    return .{ .@"success" = "hello world" };
}

~proc write|zig {
    std.debug.print("write {s} ({} bytes)\n", .{ path, data.len });
    return .{ .@"written" = @intCast(data.len) };
}
