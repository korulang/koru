// ============================================================================
// Test 510_101: MUST_FAIL — terminal `|` decl branch handled by `!` cont.
//
// The event declares `done` as a TERMINAL branch (`|`), but the consumer
// dispatches with `! done`. The shape checker rejects.
// ============================================================================

~pub event compute { x: i32 }
| done i32

~compute(x: 1)
! done _ |> _
