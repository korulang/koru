// Test 390_101: chained self|mlir ops COMPOSE — the buffer/memref ABI pin.
//
// RED PIN (2026-07-09). Slice 1b of the MLIR arc. 390_100 (slice 1a) proved
// the kernel transform generates MLIR, but under the scalar ABI each generated
// kernel INTERNALIZES the init values — so two chained ops both compute from
// the ORIGINAL init and the second silently overwrites the first (init 1,2,3:
// *=2 then +=1 yields 2,3,4 instead of 3,5,7 — a wrong answer, not an error).
//
// This pin goes green only when the generated MLIR takes the host buffer as a
// memref argument (bare-ptr call convention, proven by hand 2026-07-09:
// convert-func-to-llvm{use-bare-ptr-memref-call-conv=1} → C `void f(double*)`)
// and mutates it IN PLACE, so ops compose like their Zig-loop siblings in
// 390_060.

~import std/kernel
~import std/io

~std/kernel:shape(Body) {
    mass: f64,
}

~std/kernel:init(Body) {
    { mass: 1.0 },
    { mass: 2.0 },
    { mass: 3.0 },
}
| kernel k |> std/kernel:self|mlir { k.mass *= 2.0 } |> std/kernel:self|mlir { k.mass += 1.0 }
| computed c |> std/io:print.blk {
        mass[0]={{ c[0].mass:f }} mass[1]={{ c[1].mass:f }} mass[2]={{ c[2].mass:f }}
    }
