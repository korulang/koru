// Test: Pattern branches for HTTP routing
//
// Demonstrates HTTP-style routing dispatch using Koru events and procs.
// Uses named parameters instead of Zig struct literals.

~import std/io

const std = @import("std");

~pub tor handle { method: string, path: string } -> { status: u16, body: string }

~proc handle|zig {
    if (std.mem.eql(u8, method, "GET")) {
        // Check /users/:id pattern
        if (std.mem.startsWith(u8, path, "/users/")) {
            const id = path[7..];
            if (id.len > 0) {
                return .{ .status = 200, .body = id };
            }
        }
        // Check /health pattern
        if (std.mem.eql(u8, path, "/health")) {
            return .{ .status = 200, .body = "ok" };
        }
    }

    if (std.mem.eql(u8, method, "POST")) {
        if (std.mem.eql(u8, path, "/users")) {
            return .{ .status = 201, .body = "created" };
        }
    }

    // No match
    return .{ .status = 404, .body = "not found" };
}

~handle(method: "GET", path: "/users/42"): r |> std/io:print.ln("GET /users/42 -> {{ r.status:d }}: {{ r.body:s }}")

~handle(method: "GET", path: "/health"): r |> std/io:print.ln("GET /health -> {{ r.status:d }}: {{ r.body:s }}")

~handle(method: "POST", path: "/users"): r |> std/io:print.ln("POST /users -> {{ r.status:d }}: {{ r.body:s }}")

~handle(method: "DELETE", path: "/users/1"): r |> std/io:print.ln("DELETE /users/1 -> {{ r.status:d }}: {{ r.body:s }}")
