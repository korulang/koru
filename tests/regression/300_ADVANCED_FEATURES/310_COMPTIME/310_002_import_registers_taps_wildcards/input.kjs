// JavaScript implementation facet. The Koru declarations live in the
// `input.kz` companion (merged at import); this file holds the `|js`
// proc bodies mirroring its `|zig` ones.

~proc compute|js {
    console.log(`compute(${x})`);
    return x * 2;
}

~proc format|js {
    console.log(`format(${value})`);
    // Allocate temporary string for testing
    const text = "formatted";
    return text;
}

~proc display|js {
    console.log(`Final: ${text}`);
}
