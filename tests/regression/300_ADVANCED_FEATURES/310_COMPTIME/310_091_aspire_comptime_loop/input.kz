const std = @import("std");

~[comptime] tor tick { n: i64 } -> i64

~proc tick|zig {
    return n;
}

~[comptime] tor report { v: i64 }

~proc report|zig {
    std.debug.print("{}\n", .{v});
}

~[comptime] pub tor countdown {}

~[comptime] countdown = #loop tick(n: 5)
| go i when i > 0 |> @loop(n: i - 1)
| go i |> report(v: i)

~[comptime] countdown()
