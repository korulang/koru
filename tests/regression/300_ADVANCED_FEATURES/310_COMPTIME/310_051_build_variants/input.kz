// Test: build:variants populates variant registry based on --build flag
// When --build=release, the release config should be used
// When --build=debug, the debug config should be used

import std/io
import std/build

// Define events that we'll configure variants for
~event compute { x: i32 }
| done i32

~proc compute|zig {
    return .{ .done = x };
}

~proc compute|fast {
    return .{ .done = x * 2 };
}

~proc compute|naive {
    return .{ .done = x };
}

~event blur { intensity: i32 }

~proc blur|zig {
}

~proc blur|gpu {
    return .{ .done = .{} };
}

~proc blur|cpu {
    return .{ .done = .{} };
}

// Define variant configurations for different build modes
// Use full canonical names: module:event
~[release]std/build:variants {
    "input:compute": "fast",
    "input:blur": "gpu"
}
| configured _ |> std/io:print(text: "Release config loaded\n")
| skipped _ |> _
| invalid-event _ |> std/io:print(text: "Invalid event in release config\n")

~[debug]std/build:variants {
    "input:compute": "naive",
    "input:blur": "cpu"
}
| configured _ |> std/io:print(text: "Debug config loaded\n")
| skipped _ |> _
| invalid-event _ |> std/io:print(text: "Invalid event in debug config\n")

// Default config (when no --build flag is passed)
~std/build:variants {
    "input:compute": "default",
    "input:blur": "default"
}
| configured _ |> std/io:print(text: "Default config loaded\n")
| skipped _ |> _
| invalid-event _ |> std/io:print(text: "Invalid event in default config\n")
