// PIN: connection leaked when query returns | err.
// connect() opens a connection with connected! obligation.
// query()'s | err branch exits without calling disconnect() — the
// connection is dropped without being discharged.
//
// The legal form (both paths discharge) is 330_027_db_transaction_pattern/input.kz:4-8:
//   | then |> app/db:commit(tx) |> app/db:disconnect(conn: c)
//   | else |> app/db:rollback(tx) |> app/db:disconnect(conn: c)
//
// This test removes disconnect() from the query error path.
//
// Grounding:
//   Chain structure: 330_027_db_transaction_pattern/input.kz:4-8
//   | err branch drop syntax: 330_061_inline_obligation_cascade/input.kz:81 (| err _ |> _)
//   connected! obligation discharge event: 330_027_db_transaction_pattern/db.kz:60 (disconnect)
~import std/control
~import app/db
const query_succeeded = false;
~app/db:connect(url: "postgres://localhost/test")
| connected c |> app/db:query(conn: c, sql: "SELECT 1")
    | started tx |> std/control:if(query_succeeded)
        | then |> app/db:commit(tx) |> app/db:disconnect(conn: c)
        | else |> app/db:rollback(tx) |> app/db:disconnect(conn: c)
    | err _ |> _
pub fn main() void {}
