pub const File = struct {
    handle: usize,
};
~event open-file { path: string } -> *File<open>
~event close-file { file: *File<closed> }
~event read-file { file: *File<open> }
~event write-file { file: *File<open> }
~proc open-file|zig {
    const f = File{ .handle = 42 };
    return &f;
}
~proc close-file|zig {
    _ = file;
    return .{ .done = .{} };
}
~proc read-file|zig {
    _ = file;
}
~proc write-file|zig {
    _ = file;
    return .{ .done = .{} };
}
~open-file(path: "test1.txt"): o |> close-file(o.file)
~open-file(path: "test2.txt"): o |> close-file(o.file)
~open-file(path: "test3.txt"): o |> close-file(o.file)
