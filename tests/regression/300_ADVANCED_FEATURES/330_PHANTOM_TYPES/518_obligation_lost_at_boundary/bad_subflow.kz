import app/fs

// BAD: Opens file but doesn't document obligation in signature
~pub event bad-subflow {}

~proc bad-subflow|zig {
    ~app.fs:open(path: "data.txt")
    | opened f |> done {}
    // ERROR: f.file has [opened!] obligation
    // but 'done' branch has no [!] in signature
    // Obligation is lost!
}
