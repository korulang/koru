// Design probe: can an obligation be CARRIED across a loop back-edge via the
// consume-in / issue-out ("transfer") shape? Grammar mirrors GREEN 210_123.
// `step` consumes the incoming <owned!> handle (<!owned>) and re-issues a fresh
// <owned!> on each branch; the label-fold feeds the issued handle back into the
// consuming param. If the phantom model tracks transfer across the back-edge,
// linearity holds (every issue met by a consume) and this runs; `done` disposes.
const std = @import("std");
const Handle = struct { n: i32 };

~event make {}
| made *Handle<owned!>
~proc make|zig {
    const h = std.heap.page_allocator.create(Handle) catch unreachable;
    h.* = .{ .n = 0 };
    return .{ .made = h };
}

~event step { h: *Handle<!owned> }
| again *Handle<owned!>
| stop *Handle<owned!>
~proc step|zig {
    h.n += 1;
    if (h.n < 3) {
        return .{ .again = h };
    }
    return .{ .stop = h };
}

~event done { h: *Handle<!owned> }
~proc done|zig {
    std.debug.print("n={}\n", .{h.n});
    std.heap.page_allocator.destroy(h);
}

~event spin { h: *Handle<!owned> }
| finished *Handle<owned!>

~spin = #loop step(h)
| again v |> @loop(h: v)
| stop r => finished r

~make()
| made h0 |> spin(h: h0)
    | finished hf |> done(h: hf)
