// Chain of events that all preserve the same state variable M

~pub tor validate { data: *Data<M'_> } -> *Data<M'_>  // Preserves M

~proc validate|zig {
    return data;
}

~pub tor process { data: *Data<M'_> } -> *Data<M'_>  // Preserves M

~proc process|zig {
    return data;
}

~pub tor finalize { data: *Data<M'_> } -> *Data<M'_>  // Preserves M

~proc finalize|zig {
    return data;
}
