const std = @import("std");
const Data = struct { value: i32 };

~pub event alloc {} -> *Data<owned>

~proc alloc|zig {
    const allocator = std.heap.page_allocator;
    const d = allocator.create(Data) catch unreachable;
    d.* = Data{ .value = 42 };
    return d;
}

~pub event borrow { other: *Data<owned> } -> *Data<borrowed>

~proc borrow|zig {
    return other;
}

// Generic processor that accepts data in ANY state and preserves it
~pub event process { d: *Data<M'_> } -> *Data<M'_>  // Wildcard: accepts any state, preserves it

~proc process|zig {
    // Process the data without changing its state
    return d;
}
