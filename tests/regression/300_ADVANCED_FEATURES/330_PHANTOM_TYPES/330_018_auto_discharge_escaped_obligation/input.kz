const std = @import("std");
const File = struct { handle: i32 };
~event open { path: []const u8 } -> *File<opened!>
~proc open|zig {
    std.debug.print("Opening file\n", .{});
    const f = std.heap.page_allocator.create(File) catch unreachable;
    f.* = File{ .handle = 42 };
    return f;
}
~event close { file: *File<!opened> }
~proc close|zig {
    std.debug.print("Closing file (auto-discharged)\n", .{});
}
~event get-file { path: []const u8 } -> *File<opened!>
~get-file = open(path): f -> f
~get-file(path: "test.txt"): _ |> _
