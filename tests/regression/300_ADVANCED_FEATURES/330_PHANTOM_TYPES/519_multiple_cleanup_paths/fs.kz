const std = @import("std");
const File = struct { handle: i32 };

~pub tor open { path: string } -> *File<opened!>

~proc open|zig {
    std.debug.print("Opening file: {s}\n", .{path});
    const allocator = std.heap.page_allocator;
    const f = allocator.create(File) catch unreachable;
    f.* = File{ .handle = 42 };
    return f;
}

~pub tor close { file: *File<!opened> }  // Disposal option 1

~proc close|zig {
    std.debug.print("Closing file (quick)\n", .{});
}

~pub tor flush-close { file: *File<!opened> }  // Disposal option 2

~proc flush-close|zig {
    std.debug.print("Flushing and closing file\n", .{});
}
