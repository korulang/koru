const std = @import("std");
~import app/test_lib/logger
~tor compute { x: i32 } -> i32
~tor format { value: i32 } -> string
~proc compute|zig {
    std.debug.print("compute({d})\n", .{x});
    return x * 2;
}
~proc format|zig {
    std.debug.print("format({d})\n", .{value});
    return "formatted";
}
~compute(x: 42): r |> format(value: r)
    | formatted |> _
