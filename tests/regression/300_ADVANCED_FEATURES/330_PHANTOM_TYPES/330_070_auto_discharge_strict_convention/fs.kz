// Library module: fs
// Single disposal event - auto-discharge would normally kick in,
// but the importing module is marked [strict], so it must not.

const std = @import("std");

const File = struct { handle: i32 };

// Open a file - returns opened! state (requires cleanup)
~pub tor open { path: string } -> *File<opened!>

~proc open|zig {
    std.debug.print("Opening file\n", .{});
    const f = std.heap.page_allocator.create(File) catch unreachable;
    f.* = File{ .handle = 42 };
    return f;
}

// Close - the ONLY consumer of <!opened>
~pub tor close { file: *File<!opened> }

~proc close|zig {
    std.debug.print("Closing file (auto-discharged)\n", .{});
}
