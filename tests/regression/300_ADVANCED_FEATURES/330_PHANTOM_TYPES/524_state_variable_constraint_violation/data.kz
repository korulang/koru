const std = @import("std");
const Data = struct { value: i32 };

~pub event gc-alloc {} -> *Data<gc>  // GC-managed, NOT owned or borrowed

~proc gc-alloc|zig {
    const allocator = std.heap.page_allocator;
    const d = allocator.create(Data) catch unreachable;
    d.* = Data{ .value = 42 };
    return d;
}

// Generic processor constrained to owned OR borrowed ONLY
~pub event process { d: *Data<M'owned|borrowed> } -> *Data<M'owned|borrowed>

~proc process|zig {
    return d;
}
