// Test: Expression parameter starting with brace
// Verifies parser captures { ... } as Expression argument.
// `Expression` no longer implies comptime (that coupling was removed —
// representation and timing are orthogonal), so an event that splices its
// captured expression at compile time declares `[comptime]` explicitly.

~[comptime]tor test-expr { val: Expression }

~proc test-expr|zig {
    const std = @import("std");
    std.debug.print("val={s}\n", .{val});
}

// This should parse { foo: 1 } as the Expression argument
// Using explicit val: to avoid implicit argument issues
~test-expr(val: { foo: 1 })
