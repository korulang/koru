// Ground truth for korulang.org phantom explorer — rollback & close
//
// EXPECTED: Compiles and runs successfully

import app/db

~app/db:open(connstr: "postgres://localhost/test")
| connected c |> app/db:tx.begin(conn: c)
    | tx t |> app/db:tx.exec(tx: t, sql: "UPDATE inventory SET qty = 0")
        | ok r |> app/db:tx.rollback(tx: r)
            | rolled_back conn |> app/db:close(conn)
| connection_failed |> _
