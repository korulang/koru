// LANGUAGE SHOOTOUT: N-body Gravitational Simulation (EXTREME DECOMPOSITION)
// Tests: Event-driven nested loops, recursive iteration, maximum decomposition
// Threshold: 1.20x (within 20% of hand-optimized Zig)
//
// CRITICAL: This version decomposes NESTED LOOPS into event-driven recursion
// We prove that even LOOP ITERATION can be expressed as events without cost
//
// Compared to 2101b:
// - 2101b: Nested loops in proc
// - 2101c: Nested loops decomposed into recursive events
//
// This tests the ABSOLUTE LIMIT:
// ✅ Can we replace nested for loops with events?
// ✅ Does recursive event iteration compile to loops?
// ✅ Where (if ever) does abstraction start costing performance?

const std = @import("std");

const PI = 3.141592653589793;
const SOLAR_MASS = 4 * PI * PI;
const DAYS_PER_YEAR = 365.24;

const Body = struct {
    x: f64,
    y: f64,
    z: f64,
    vx: f64,
    vy: f64,
    vz: f64,
    mass: f64,
};

// ============================================================================
// PLANETARY INITIALIZATION - Ultra granular (5 planet events + assembler)
// ============================================================================

~event create-sun {}
| created Body

~proc create-sun|zig {
    const sun = Body{
        .x = 0, .y = 0, .z = 0,
        .vx = 0, .vy = 0, .vz = 0,
        .mass = SOLAR_MASS,
    };
    return .{ .created = sun };
}

~event create-jupiter {}
| created Body

~proc create-jupiter|zig {
    const jupiter = Body{
        .x = 4.84143144246472090e+00,
        .y = -1.16032004402742839e+00,
        .z = -1.03622044471123109e-01,
        .vx = 1.66007664274403694e-03 * DAYS_PER_YEAR,
        .vy = 7.69901118419740425e-03 * DAYS_PER_YEAR,
        .vz = -6.90460016972063023e-05 * DAYS_PER_YEAR,
        .mass = 9.54791938424326609e-04 * SOLAR_MASS,
    };
    return .{ .created = jupiter };
}

~event create-saturn {}
| created Body

~proc create-saturn|zig {
    const saturn = Body{
        .x = 8.34336671824457987e+00,
        .y = 4.12479856412430479e+00,
        .z = -4.03523417114321381e-01,
        .vx = -2.76742510726862411e-03 * DAYS_PER_YEAR,
        .vy = 4.99852801234917238e-03 * DAYS_PER_YEAR,
        .vz = 2.30417297573763929e-05 * DAYS_PER_YEAR,
        .mass = 2.85885980666130812e-04 * SOLAR_MASS,
    };
    return .{ .created = saturn };
}

~event create-uranus {}
| created Body

~proc create-uranus|zig {
    const uranus = Body{
        .x = 1.28943695621391310e+01,
        .y = -1.51111514016986312e+01,
        .z = -2.23307578892655734e-01,
        .vx = 2.96460137564761618e-03 * DAYS_PER_YEAR,
        .vy = 2.37847173959480950e-03 * DAYS_PER_YEAR,
        .vz = -2.96589568540237556e-05 * DAYS_PER_YEAR,
        .mass = 4.36624404335156298e-05 * SOLAR_MASS,
    };
    return .{ .created = uranus };
}

~event create-neptune {}
| created Body

~proc create-neptune|zig {
    const neptune = Body{
        .x = 1.53796971148509165e+01,
        .y = -2.59193146099879641e+01,
        .z = 1.79258772950371181e-01,
        .vx = 2.68067772490389322e-03 * DAYS_PER_YEAR,
        .vy = 1.62824170038242295e-03 * DAYS_PER_YEAR,
        .vz = -9.51592254519715870e-05 * DAYS_PER_YEAR,
        .mass = 5.15138902046611451e-05 * SOLAR_MASS,
    };
    return .{ .created = neptune };
}

~event assemble-solar-system {
    sun: Body,
    jupiter: Body,
    saturn: Body,
    uranus: Body,
    neptune: Body
}
| assembled [5]Body

~proc assemble-solar-system|zig {
    const bodies_array = [_]Body{ sun, jupiter, saturn, uranus, neptune };
    return .{ .assembled = bodies_array };
}

// Subflow: Initialize system by creating each planet then assembling
~event initialize-system {}
| initialized [5]Body[mutable]

~initialize-system = create-sun()
| created s |> create-jupiter()
    | created j |> create-saturn()
        | created sat |> create-uranus()
            | created u |> create-neptune()
                | created n |> assemble-solar-system(s.sun, j.jupiter, sat.saturn, u.uranus, n.neptune)
                    | assembled a |> initialized { a.bodies }

// ============================================================================
// MOMENTUM OFFSET - Granular decomposition
// ============================================================================

~event calculate-momentum-x { bodies: []Body }
| computed f64

~proc calculate-momentum-x|zig {
    var px: f64 = 0.0;
    for (bodies) |body| {
        px += body.vx * body.mass;
    }
    return .{ .computed = px };
}

~event calculate-momentum-y { bodies: []Body }
| computed f64

~proc calculate-momentum-y|zig {
    var py: f64 = 0.0;
    for (bodies) |body| {
        py += body.vy * body.mass;
    }
    return .{ .computed = py };
}

~event calculate-momentum-z { bodies: []Body }
| computed f64

~proc calculate-momentum-z|zig {
    var pz: f64 = 0.0;
    for (bodies) |body| {
        pz += body.vz * body.mass;
    }
    return .{ .computed = pz };
}

~event apply-sun-offset { bodies: []Body, px: f64, py: f64, pz: f64 }

~proc apply-sun-offset|zig {
    bodies[0].vx = -px / SOLAR_MASS;
    bodies[0].vy = -py / SOLAR_MASS;
    bodies[0].vz = -pz / SOLAR_MASS;
}

// Subflow: Offset momentum by calculating each component then applying
~event offset-momentum { bodies: []Body }

~offset-momentum = calculate-momentum-x(bodies)
| computed cx |> calculate-momentum-y(bodies)
    | computed cy |> calculate-momentum-z(bodies)
        | computed cz |> apply-sun-offset(bodies, cx.px, cy.py, cz.pz)
            |> adjusted {}

// ============================================================================
// ENERGY CALCULATION - Ultra granular
// ============================================================================

~event sum-kinetic-energies { bodies: []const Body }
| computed f64

~proc sum-kinetic-energies|zig {
    var total: f64 = 0.0;
    for (bodies) |body| {
        total += 0.5 * body.mass * (body.vx * body.vx + body.vy * body.vy + body.vz * body.vz);
    }
    return .{ .computed = total };
}

~event sum-potential-energies { bodies: []const Body }
| computed f64

~proc sum-potential-energies|zig {
    var total: f64 = 0.0;
    for (bodies, 0..) |body, i| {
        var j = i + 1;
        while (j < bodies.len) : (j += 1) {
            const dx = body.x - bodies[j].x;
            const dy = body.y - bodies[j].y;
            const dz = body.z - bodies[j].z;
            const distance = @sqrt(dx * dx + dy * dy + dz * dz);
            total -= (body.mass * bodies[j].mass) / distance;
        }
    }
    return .{ .computed = total };
}

~event combine-energies { ke: f64, pe: f64 }
| computed f64

~proc combine-energies|zig {
    const total = ke + pe;
    return .{ .computed = total };
}

// Subflow: Calculate total energy by summing kinetic and potential
~event calculate-total-energy { bodies: []const Body }
| result f64

~calculate-total-energy = sum-kinetic-energies(bodies)
| computed ke |> sum-potential-energies(bodies)
    | computed pe |> combine-energies(ke: ke.total_ke, pe: pe.total_pe)
        | computed c |> result { energy: c.total }

// ============================================================================
// GRAVITATIONAL INTERACTIONS - Maximum granularity
// ============================================================================

~event calculate-distance-vector { b1: Body, b2: Body }
| computed { dx: f64, dy: f64, dz: f64, b1: Body, b2: Body }

~proc calculate-distance-vector|zig {
    const dx = b1.x - b2.x;
    const dy = b1.y - b2.y;
    const dz = b1.z - b2.z;
    return .{ .computed = .{ .dx = dx, .dy = dy, .dz = dz, .b1 = b1, .b2 = b2 } };
}

~event calculate-distance-scalar { dx: f64, dy: f64, dz: f64 }
| computed { distance: f64, dx: f64, dy: f64, dz: f64 }

~proc calculate-distance-scalar|zig {
    const distance = @sqrt(dx * dx + dy * dy + dz * dz);
    return .{ .computed = .{ .distance = distance, .dx = dx, .dy = dy, .dz = dz } };
}

~event calculate-gravitational-magnitude { distance: f64, dt: f64 }
| computed { mag: f64, dt: f64 }

~proc calculate-gravitational-magnitude|zig {
    const mag = dt / (distance * distance * distance);
    return .{ .computed = .{ .mag = mag, .dt = dt } };
}

~event update-body-pair-velocities {
    b1: Body,
    b2: Body,
    dx: f64,
    dy: f64,
    dz: f64,
    mag: f64
}
| updated { b1: Body, b2: Body }

~proc update-body-pair-velocities|zig {
    var updated_b1 = b1;
    var updated_b2 = b2;

    updated_b1.vx -= dx * b2.mass * mag;
    updated_b1.vy -= dy * b2.mass * mag;
    updated_b1.vz -= dz * b2.mass * mag;

    updated_b2.vx += dx * b1.mass * mag;
    updated_b2.vy += dy * b1.mass * mag;
    updated_b2.vz += dz * b1.mass * mag;

    return .{ .updated = .{ .b1 = updated_b1, .b2 = updated_b2 } };
}

// Subflow: Process one body pair - demonstrates deep event composition
~event process-body-pair { b1: Body, b2: Body, dt: f64 }
| updated { b1: Body, b2: Body }

~process-body-pair = calculate-distance-vector(b1, b2)
| computed dv |> calculate-distance-scalar(dv.dx, dv.dy, dv.dz)
    | computed ds |> calculate-gravitational-magnitude(ds.distance, dt)
        | computed gm |> update-body-pair-velocities(dv.b1, dv.b2, ds.dx, ds.dy, ds.dz, gm.mag)
            | updated u |> updated { u.b1, u.b2 }

// ============================================================================
// NESTED LOOP DECOMPOSITION - The Ultimate Test
// Breaking down nested loops into recursive event iteration
// ============================================================================

// Helper: Update one pair of bodies in the array
~event update-pair-in-array { bodies: []Body, i: usize, j: usize, dt: f64 }

~proc update-pair-in-array|zig {
    const dx = bodies[i].x - bodies[j].x;
    const dy = bodies[i].y - bodies[j].y;
    const dz = bodies[i].z - bodies[j].z;
    const distance = @sqrt(dx * dx + dy * dy + dz * dz);
    const mag = dt / (distance * distance * distance);

    bodies[i].vx -= dx * bodies[j].mass * mag;
    bodies[i].vy -= dy * bodies[j].mass * mag;
    bodies[i].vz -= dz * bodies[j].mass * mag;

    bodies[j].vx += dx * bodies[i].mass * mag;
    bodies[j].vy += dy * bodies[i].mass * mag;
    bodies[j].vz += dz * bodies[i].mass * mag;

}

// Inner loop iteration: process pairs for current i
~event inner-loop-step { bodies: []Body, i: usize, j: usize, dt: f64 }
| continue-inner { i: usize, j: usize, dt: f64 }
| done-inner usize

~proc inner-loop-step|zig {
    if (j < bodies.len) {
        return .{ .continue_inner = .{ .i = i, .j = j, .dt = dt } };
    } else {
        return .{ .done_inner = i };
    }
}

// Outer loop iteration: process all i values
~event outer-loop-step { bodies: []Body, i: usize, dt: f64 }
| continue-outer { i: usize, dt: f64 }
| done-outer f64

~proc outer-loop-step|zig {
    if (i < bodies.len) {
        return .{ .continue_outer = .{ .i = i, .dt = dt } };
    } else {
        return .{ .done_outer = dt };
    }
}

// Main entry point: Event-driven nested loop for all interactions
~event calculate-all-interactions { bodies: []Body, dt: f64 }

~calculate-all-interactions = outer-loop-step(bodies, i: 0, dt)
| continue-outer outer |> #inner_start inner-loop-step(bodies, outer.i, j: outer.i + 1, outer.dt)
    | continue-inner inner |> update-pair-in-array(bodies, inner.i, inner.j, inner.dt)
        |> @inner_start(bodies, inner.i, j: inner.j + 1, inner.dt)
    | done-inner done_i |> outer-loop-step(bodies, i: done_i.i + 1, outer.dt)
        | continue-outer co2 |> @inner_start(bodies, co2.i, j: co2.i + 1, co2.dt)
        | done-outer |> updated {}
| done-outer |> updated {}

// ============================================================================
// POSITION UPDATES
// ============================================================================

~event update-all-positions { bodies: []Body, dt: f64 }

~proc update-all-positions|zig {
    for (bodies) |*body| {
        body.x += dt * body.vx;
        body.y += dt * body.vy;
        body.z += dt * body.vz;
    }
}

// ============================================================================
// UTILITY EVENTS
// ============================================================================

~event print-energy { energy: f64 }

~proc print-energy|zig {
    std.debug.print("{d:.9}\n", .{energy});
}

~event simulation-step { i: u32, n: u32 }
| continue { i: u32, n: u32 }

~proc simulation-step|zig {
    if (i < n) {
        return .{ .continue = .{ .i = i, .n = n } };
    } else {
    }
}

~event parse-args {}
| parsed u32

~proc parse-args|zig {
    const args = std.process.argsAlloc(std.heap.page_allocator) catch unreachable;
    defer std.process.argsFree(std.heap.page_allocator, args);

    if (args.len < 2) {
        std.debug.print("Usage: {s} <iterations>\n", .{args[0]});
        unreachable;
    }

    const n = std.fmt.parseInt(u32, args[1], 10) catch unreachable;
    return .{ .parsed = n };
}

// ============================================================================
// Main flow: Demonstrate extreme event composition with subflows
// ============================================================================

~parse-args()
| parsed p |> initialize-system()
    | initialized init |> offset-momentum(bodies: init.bodies[0..])
        |> calculate-total-energy(bodies: init.bodies[0..])
            | result r1 |> print-energy(r1.energy)
                |> #sim_loop simulation-step(i: 0, p.n)
                    | continue cont |> calculate-all-interactions(bodies: init.bodies[0..], dt: 0.01)
                        |> update-all-positions(bodies: init.bodies[0..], dt: 0.01)
                            |> @sim_loop(i: cont.i + 1, cont.n)
                    |> calculate-total-energy(bodies: init.bodies[0..])
                        | result r2 |> print-energy(r2.energy)
                            |> _
