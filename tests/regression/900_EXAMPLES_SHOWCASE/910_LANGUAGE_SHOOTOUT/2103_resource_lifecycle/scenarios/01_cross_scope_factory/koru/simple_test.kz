// Minimal test of obligation escape via branch constructor

const std = @import("std");

const File = struct { handle: i32 };

~tor open { path: string }
| opened *File<opened!>

~proc open|zig {
    const f = std.heap.page_allocator.create(File) catch unreachable;
    f.* = File{ .handle = 42 };
    return .{ .opened = f };
}

~tor close { file: *File<!opened> }

~proc close|zig {
    std.heap.page_allocator.destroy(file);
}

// Factory that escapes obligation
~tor create { path: string }
| created *File<opened!>

~create = open(path)
| opened f => created { resource: f.file }

// Main flow - explicit cleanup
~create(path: "test.txt")
| created r |> close(file: r.resource)

pub fn main() void {}
