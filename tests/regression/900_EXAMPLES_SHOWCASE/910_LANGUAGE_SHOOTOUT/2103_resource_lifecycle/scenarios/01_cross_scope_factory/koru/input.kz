// KORU: Cross-Scope Resource Factory - what RAII cannot do

const std = @import("std");

const File = struct { handle: i32 };

~event open { path: string } -> *File<opened!>

~proc open|zig {
    std.debug.print("Opening\n", .{});
    const f = std.heap.page_allocator.create(File) catch unreachable;
    f.* = File{ .handle = 42 };
    return f;
}

~event use { file: *File<opened> }

~proc use|zig {
    std.debug.print("Using\n", .{});
}

~event close { file: *File<!opened> }

~proc close|zig {
    std.debug.print("Closing\n", .{});
    std.heap.page_allocator.destroy(file);
}

~event create { path: string }
| created *File<opened!>

~create = open(path): f => created { f.file }

~create(path: "test.txt")
| created r |> use(r.file) |> use(r.file) |> use(r.file) |> close(r.file)

