// Ground truth for korulang.org phantom explorer — chained tx.exec
//
// EXPECTED: Compiles and runs successfully

~import app/db

~app/db:open(connstr: "postgres://localhost/test")
| connected c |> app/db:tx.begin(conn: c)
    | tx t |> app/db:tx.exec(tx: t, sql: "INSERT INTO users VALUES (1, 'alice')")
        | ok r1 |> app/db:tx.exec(tx: r1, sql: "INSERT INTO users VALUES (2, 'bob')")
            | ok r2 |> app/db:tx.exec(tx: r2, sql: "INSERT INTO users VALUES (3, 'charlie')")
                | ok r3 |> app/db:tx.commit(tx: r3)
                    | committed conn |> app/db:close(conn)
| connection-failed |> _
