// TEST: begin then commit WITHOUT exec — committing an empty (started, never
// active) transaction. commit requires Transaction<!active>, but begin yields
// <started!>. The states don't match — an untouched transaction can't commit.
~import app/db

~app/db:connect(host: "localhost")
| ok c |> app/db:begin(conn: c)
    | ok t |> app/db:commit(tx: t)
        | ok conn |> app/db:close(conn)
        | err _ |> _
    | err _ |> _
| err _ |> _
