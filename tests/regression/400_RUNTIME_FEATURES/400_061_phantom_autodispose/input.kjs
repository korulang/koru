// JavaScript implementation facet. Events are declared in input.kz (merged at
// import); this file holds the |js proc bodies.

~proc create-resource|js {
    return { data: `Resource: ${name}` };
}

~proc destroy-resource|js {
    console.log("  Auto-discharge called!");
}

~proc use-resource|js {
    console.log(`  Using: ${res.data}`);
}
