// JavaScript implementation facet. Events are declared in input.kz (merged at
// import); this file holds the |js proc bodies.

const TEST_SOURCE = "open-handle()\n| opened _ |> step()";

~proc open-handle|js {
    console.log("OPEN");
    return { tag: "opened", opened: "h1" };
}

~proc close-handle|js {
    console.log("CLOSE");
}

~proc step|js {
    console.log("STEP");
}
