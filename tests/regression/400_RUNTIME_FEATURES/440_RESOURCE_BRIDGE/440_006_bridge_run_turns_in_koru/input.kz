// TEST: the whole conversation, spelled in Koru — no Zig reach-in.
//
// Turn 1 opens a file and walks away from it. Turn 2, a SEPARATE run, closes the
// file turn 1 opened. Then the session hangs up. This is the resource bridge's
// entire first use case: resources retained across calls.
//
// `440_004` does the same thing and has to drop into Zig for `&br.pool`, because
// until `std/bridge:run` existed the mechanism was real and the Koru surface over
// it was not. Nothing in the flow below reaches through the library boundary.
//
// EVERY arm hangs up, including the failures, and that is not tidiness — it is
// forced. `create` mints `<session!>`; an arm that reports a failed turn and
// walks away leaves the session undischarged and the program does not compile
// (KORU030, "Call: close"). A turn can fail eight ways, so a two-turn
// conversation carries sixteen hang-ups. That cost is the guarantee, seen from
// the inside.

~import std/bridge
~import std/runtime
~import std/io

const std = @import("std");

~pub tor open { path: string } -> string<opened!>

~proc open|zig {
    _ = path;
    return "file_1";
}

~pub tor close-file { handle: string<!opened> }

~proc close-file|zig {
    std.debug.print("close-file() ran for '{s}'\n", .{handle});
}

~std/runtime:register(scope: "files") {
    open(10)
    close-file(1)
}

~std/bridge:create(id: "session-1", scope: "files"): br |> std/bridge:run(br, source: "open(path: \"a.txt\")")
| result r1 |> std/bridge:run(br, source: "close-file(handle: \"file_1\")")
    | result r2 |> std/bridge:close(br): still |> std/io:print.ln("turn 1: {{ r1.handles:d }} held, turn 2: {{ r2.handles:d }} held, hung up still: {{ still:d }}")
    | exhausted _ |> std/bridge:close(br): _ |> report(what: "turn 2 exhausted")
    | parse-error _ |> std/bridge:close(br): _ |> report(what: "turn 2 parse error")
    | validation-error _ |> std/bridge:close(br): _ |> report(what: "turn 2 validation error")
    | shape-error _ |> std/bridge:close(br): _ |> report(what: "turn 2 shape error")
    | event-denied _ |> std/bridge:close(br): _ |> report(what: "turn 2 event denied")
    | dispatch-error e2 |> std/bridge:close(br): _ |> report(what: e2.message)
    | scope-not-found _ |> std/bridge:close(br): _ |> report(what: "turn 2 scope not found")
| exhausted _ |> std/bridge:close(br): _ |> report(what: "turn 1 exhausted")
| parse-error _ |> std/bridge:close(br): _ |> report(what: "turn 1 parse error")
| validation-error _ |> std/bridge:close(br): _ |> report(what: "turn 1 validation error")
| shape-error _ |> std/bridge:close(br): _ |> report(what: "turn 1 shape error")
| event-denied _ |> std/bridge:close(br): _ |> report(what: "turn 1 event denied")
| dispatch-error e1 |> std/bridge:close(br): _ |> report(what: e1.message)
| scope-not-found _ |> std/bridge:close(br): _ |> report(what: "turn 1 scope not found")

~tor report { what: string }

~proc report|zig {
    std.debug.print("FAIL: {s}\n", .{what});
}
