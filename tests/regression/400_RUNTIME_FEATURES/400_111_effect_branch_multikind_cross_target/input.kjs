let tokens = 0;
let warnings = 0;
let token_sum = 0;

~proc tokenize|js {
    for (let i = 0; i < n; i++) {
        token(i);
        if (i % 2 == 0) {
            warning(i);
        }
    }
}

~proc on-token|js { tokens = tokens + 1; token_sum = token_sum + t; }
~proc on-warning|js { warnings = warnings + 1; }
~proc report|js {
    console.log("tokens=" + tokens + " warnings=" + warnings + " sum=" + token_sum);
}
