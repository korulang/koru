// Vaxis-shaped event pump with per-target proc bodies.
// |zig runs on the default path; |js is what the JS emitter splices.
const std = @import("std");

~pub event pump { n: usize }
! tick { i: usize, acc: usize } -> usize
| done usize

~proc pump|zig {
    var acc: usize = 0;
    for (0..n) |i| {
        acc = tick(.{ .i = i, .acc = acc });
    }
    return .{ .done = acc };
}

~proc pump|js {
    let acc = 0;
    for (let i = 0; i < n; i++) {
        acc = tick({ i: i, acc: acc });
    }
    return { tag: "done", done: acc };
}

~pub event report { value: usize }

~proc report|zig {
    std.debug.print("sum = {d}\n", .{value});
}

~proc report|js {
    console.log("sum = " + value);
}

~pump(n: 10)
! tick t |> t.acc + t.i
| done r |> report(value: r)
