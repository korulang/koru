// Constructed: depth-3 nested chain of events-with-effects.
// outer fires ! v per element -> handler calls mid -> ! v -> calls leaf -> ! v
// -> calls plain inc(). counter ends at n^3. Tests deep effect chaining +
// void effects (no resume value) + plain-event calls from deep handlers +
// module-level mutable state, per-target (|zig / |js).
const std = @import("std");

var counter: u64 = 0;

~pub event outer { n: u64 }
! v u64
~proc outer|zig { for (0..n) |i| v(i); }
~proc outer|js  { for (let i = 0; i < n; i++) v(i); }

~pub event mid { n: u64 }
! v u64
~proc mid|zig { for (0..n) |i| v(i); }
~proc mid|js  { for (let i = 0; i < n; i++) v(i); }

~pub event leaf { n: u64 }
! v u64
~proc leaf|zig { for (0..n) |i| v(i); }
~proc leaf|js  { for (let i = 0; i < n; i++) v(i); }

~pub event inc {}
~proc inc|zig { counter +%= 1; }
~proc inc|js  { counter++; }

~pub event print_counter {}
~proc print_counter|zig { std.debug.print("counter = {d}\n", .{counter}); }
~proc print_counter|js  { console.log("counter = " + counter); }

~outer(n: 10)
! v _ |>
    mid(n: 10)
    ! v _ |>
        leaf(n: 10)
        ! v _ |> inc()

~print_counter()
