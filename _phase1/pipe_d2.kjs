// pipe_d2.kjs — depth-2 pass-through pipeline. Generated by gen_pipeline.mjs.
const M = parseInt(process.argv[2] || "1000000");
let counter = 0;

~pub event source { m: u64 }
! item u64
~proc source|js { for (let i = 0; i < m; i++) item(i); }

~pub event stage1 {}
! v u64
~proc stage1|js { v(0); }

~pub event stage2 {}
! v u64
~proc stage2|js { v(0); }

~pub event inc {}
~proc inc|js { counter++; }

~pub event report {}
~proc report|js { console.log("counter = " + counter); }

~source(m: M)
! item _ |>
    stage1()
    ! v _ |>
        stage2()
        ! v _ |> inc()

~report()
