// pipe_d8.kjs — depth-8 pass-through pipeline. Generated by gen_pipeline.mjs.
const M = parseInt(process.argv[2] || "1000000");
let counter = 0;

~pub event source { m: u64 }
! item u64
~proc source|js { for (let i = 0; i < m; i++) item(i); }

~pub event stage1 {}
! v u64
~proc stage1|js { v(0); }

~pub event stage2 {}
! v u64
~proc stage2|js { v(0); }

~pub event stage3 {}
! v u64
~proc stage3|js { v(0); }

~pub event stage4 {}
! v u64
~proc stage4|js { v(0); }

~pub event stage5 {}
! v u64
~proc stage5|js { v(0); }

~pub event stage6 {}
! v u64
~proc stage6|js { v(0); }

~pub event stage7 {}
! v u64
~proc stage7|js { v(0); }

~pub event stage8 {}
! v u64
~proc stage8|js { v(0); }

~pub event inc {}
~proc inc|js { counter++; }

~pub event report {}
~proc report|js { console.log("counter = " + counter); }

~source(m: M)
! item _ |>
    stage1()
    ! v _ |>
        stage2()
        ! v _ |>
            stage3()
            ! v _ |>
                stage4()
                ! v _ |>
                    stage5()
                    ! v _ |>
                        stage6()
                        ! v _ |>
                            stage7()
                            ! v _ |>
                                stage8()
                                ! v _ |> inc()

~report()
