~import std/io
~std/io:print.ln("# Koru in a Page")
~std/io:print.ln("")
~std/io:print.ln("> Generated by `scripts/generate-tutorial.js` from `koru-by-example.json`.")
~std/io:print.ln("")
~std/io:print.ln("> **Note:** This tutorial is prose synthesis on top of the test suite. It may contain errors or drift. The compiler's actual behavior — verified by tests in `tests/regression/` and source in `src/` — is the source of truth. When you find this document saying one thing and the compiler doing another, the conflict itself is the finding: flag it, don't paper over it.")
~std/io:print.ln(">")
~std/io:print.ln("> **Koru is greenfield.** There are no legacy users, no deprecated forms to support, no migration windows that constitute a contract. When the language changes, the change lands and tests/docs get rewritten in the same motion. If the parser temporarily accepts an older form while migration is in progress, that's internal scaffolding — not a feature. Write code in the current canonical form. Don't hedge for legacy.")
~std/io:print.ln("")
~std/io:print.ln("## Examples")
~std/io:print.ln("")
~std/io:print.ln("### 010_000_hello_world_koru")
~std/io:print.ln("")
~std/io:print.ln("```koru")
~std/io:print.ln("// Hello World in pure Koru.")
~std/io:print.ln("// Was the korulang.org frontpage example until 2026-10-11 — the front page")
~std/io:print.ln("// now leads with the continuation example, which has no pin yet.")
~std/io:print.ln("//")
~std/io:print.ln("// Also pins consumed-transform exclusion: after print.blk runs, the")
~std/io:print.ln("// program unit must not ship `__printInterpolate` or `@import(\"ast\")`.")
~std/io:print.ln("// post.sh greps output_emitted.zig.")
~std/io:print.ln("")
~std/io:print.ln("import std/io")
~std/io:print.ln("")
~std/io:print.ln("std/io:print.blk \x7b\x7b")
~std/io:print.ln("    \x7b\x7b% if debug %\x7d\x7d[DEBUG] \x7b\x7b% endif %\x7d\x7dHello, \x7b\x7b\x7b\x7b name:s \x7d\x7d\x7d\x7d!")
~std/io:print.ln("    The answer is \x7b\x7b\x7b\x7b count:d \x7d\x7d\x7d\x7d.")
~std/io:print.ln("\x7d\x7d")
~std/io:print.ln("```")
~std/io:print.ln("")
~std/io:print.ln("**Output:**")
~std/io:print.ln("")
~std/io:print.ln("```")
~std/io:print.ln("[DEBUG] Hello, World!")
~std/io:print.ln("The answer is 42.")
~std/io:print.ln("```")
~std/io:print.ln("")
~std/io:print.ln("### 020_014_pure_subflow_impl")
~std/io:print.ln("")
~std/io:print.ln("```koru")
~std/io:print.ln("// Test: Pure subflow implementation (no proc needed)")
~std/io:print.ln("// From the README example - this is idiomatic Koru")
~std/io:print.ln("// This is the default authoring model for ordinary tor behavior.")
~std/io:print.ln("import std/io")
~std/io:print.ln("")
~std/io:print.ln("tor greet \x7b\x7b name: string \x7d\x7d -> string")
~std/io:print.ln("")
~std/io:print.ln("greet -> \"Hello, \" ++ name ++ \"!\"")
~std/io:print.ln("")
~std/io:print.ln("greet (name: \"World\"): msg |> std/io:print.ln(msg)")
~std/io:print.ln("```")
~std/io:print.ln("")
~std/io:print.ln("**Output:**")
~std/io:print.ln("")
~std/io:print.ln("```")
~std/io:print.ln("Hello, World!")
~std/io:print.ln("```")
~std/io:print.ln("")
~std/io:print.ln("### 240_subflow_defines_semantics")
~std/io:print.ln("")
~std/io:print.ln("```koru")
~std/io:print.ln("// Test 240: subflows define branch semantics")
~std/io:print.ln("//")
~std/io:print.ln("// Branch names in Koru are inert identifiers. Their meaning — what")
~std/io:print.ln("// \"return\", \"break\", \"continue\", \"ok\", \"north\", or any other name")
~std/io:print.ln("// signifies — is defined by the SUBFLOWS that resolve them, not by")
~std/io:print.ln("// the compiler. This is the structural advantage over languages that")
~std/io:print.ln("// bake fixed semantics for certain names into their grammar.")
~std/io:print.ln("//")
~std/io:print.ln("// This test deliberately uses names that ARE keywords in other")
~std/io:print.ln("// languages (return, break, continue), to verify that the parser")
~std/io:print.ln("// carries no value judgment about them. If a \"common mistakes from")
~std/io:print.ln("// other languages\" trap is re-introduced at parser.zig parseStep,")
~std/io:print.ln("// this test fails. That is the point.")
~std/io:print.ln("")
~std/io:print.ln("import std/io")
~std/io:print.ln("")
~std/io:print.ln("// Lower-level tor: arbitrary outcome names")
~std/io:print.ln("pub tor step \x7b\x7b\x7d\x7d")
~std/io:print.ln("| return")
~std/io:print.ln("| break")
~std/io:print.ln("| continue")
~std/io:print.ln("")
~std/io:print.ln("step => continue")
~std/io:print.ln("")
~std/io:print.ln("// Outer tor: its own outcome vocabulary")
~std/io:print.ln("pub tor run \x7b\x7b\x7d\x7d")
~std/io:print.ln("| stopped")
~std/io:print.ln("| iterated")
~std/io:print.ln("")
~std/io:print.ln("// Subflow: `run` is satisfied by `step`, with `step`'s outcomes")
~std/io:print.ln("// mapped to `run`'s. The meaning of `return`, `break`, `continue`")
~std/io:print.ln("// lives HERE — in user code, not in the compiler.")
~std/io:print.ln("run = step()")
~std/io:print.ln("| return => stopped")
~std/io:print.ln("| break => stopped")
~std/io:print.ln("| continue => iterated")
~std/io:print.ln("")
~std/io:print.ln("std/io:print.ln(\"Testing subflow-defined semantics:\")")
~std/io:print.ln("run()")
~std/io:print.ln("| stopped |> std/io:print.ln(\"  stopped\")")
~std/io:print.ln("| iterated |> std/io:print.ln(\"  iterated\")")
~std/io:print.ln("```")
~std/io:print.ln("")
~std/io:print.ln("**Output:**")
~std/io:print.ln("")
~std/io:print.ln("```")
~std/io:print.ln("Testing subflow-defined semantics:")
~std/io:print.ln("  iterated")
~std/io:print.ln("```")
~std/io:print.ln("")
~std/io:print.ln("### 330_038_cleanup_obligation_satisfied")
~std/io:print.ln("")
~std/io:print.ln("```koru")
~std/io:print.ln("import app/fs")
~std/io:print.ln("app/fs:open(path: \"test.txt\"): f |> app/fs:close(file: f)")
~std/io:print.ln("```")
~std/io:print.ln("")
~std/io:print.ln("**Output:**")
~std/io:print.ln("")
~std/io:print.ln("```")
~std/io:print.ln("Opening file: test.txt")
~std/io:print.ln("Closing file")
~std/io:print.ln("```")
~std/io:print.ln("")
~std/io:print.ln("### 140_020_part_basic_join")
~std/io:print.ln("")
~std/io:print.ln("```koru")
~std/io:print.ln("// PIN (part): `part impl` in the entry loads every `input.impl.k*` sibling —")
~std/io:print.ln("// the same join the stem-facet mechanism makes, but NAMED by the declaration")
~std/io:print.ln("// instead of derived from the directory. Tors declared in a part are in")
~std/io:print.ln("// scope for the primary's flows, referenced unqualified — the merge puts")
~std/io:print.ln("// primary and parts in one module (the 140_009 facet contract, through part).")
~std/io:print.ln("")
~std/io:print.ln("part impl")
~std/io:print.ln("")
~std/io:print.ln("compute(x: 42): r |> show(v: r)")
~std/io:print.ln("```")
~std/io:print.ln("")
~std/io:print.ln("**Output:**")
~std/io:print.ln("")
~std/io:print.ln("```")
~std/io:print.ln("142")
~std/io:print.ln("```")
~std/io:print.ln("")
