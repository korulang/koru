{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Koru",
  "scopeName": "source.koru",
  "patterns": [
    { "include": "#comments" },
    { "include": "#imports" },
    { "include": "#annotations" },
    { "include": "#branches" },
    { "include": "#markup" },
    { "include": "#strings" },
    { "include": "#liquid" },
    { "include": "#phantom" },
    { "include": "#module-calls" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#numbers" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.koru",
          "match": "//.*$"
        }
      ]
    },
    "imports": {
      "patterns": [
        {
          "name": "meta.import.koru",
          "match": "\\b(import)\\s+([a-zA-Z_$][a-zA-Z0-9_/-]*)",
          "captures": {
            "1": { "name": "keyword.control.import.koru" },
            "2": { "name": "entity.name.type.module.koru" }
          }
        }
      ]
    },
    "annotations": {
      "patterns": [
        {
          "name": "meta.annotation.koru",
          "begin": "\\[",
          "end": "\\]",
          "patterns": [
            {
              "name": "storage.modifier.annotation.koru",
              "match": "[a-zA-Z_][a-zA-Z0-9_-]*"
            },
            {
              "name": "punctuation.separator.annotation.koru",
              "match": "[|]"
            }
          ]
        }
      ]
    },
    "branches": {
      "patterns": [
        {
          "name": "keyword.control.branch.koru",
          "match": "^\\s*[!|]"
        },
        {
          "name": "keyword.control.flow.koru",
          "match": "\\|\\s*(ok|err|full|row)\\b",
          "captures": {
            "1": { "name": "keyword.control.koru" }
          }
        }
      ]
    },
    "markup": {
      "patterns": [
        {
          "name": "meta.tag.koru",
          "begin": "(</?)([a-zA-Z][a-zA-Z0-9_-]*)",
          "end": "(/?>)",
          "beginCaptures": {
            "1": { "name": "punctuation.definition.tag.koru" },
            "2": { "name": "entity.name.tag.koru" }
          },
          "endCaptures": {
            "1": { "name": "punctuation.definition.tag.koru" }
          },
          "patterns": [
            {
              "name": "entity.other.attribute-name.koru",
              "match": "[a-zA-Z][a-zA-Z0-9_-]*"
            },
            {
              "name": "string.quoted.double.koru",
              "match": "\"[^\"]*\""
            }
          ]
        }
      ]
    },
    "phantom": {
      "patterns": [
        {
          "name": "constant.language.phantom.koru",
          "match": "<[a-zA-Z_][a-zA-Z0-9_-]*!>"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.koru",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.koru",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "liquid": {
      "patterns": [
        {
          "name": "meta.embedded.block.liquid.koru",
          "begin": "\\{%",
          "end": "%\\}",
          "patterns": [
            {
              "name": "keyword.control.liquid.koru",
              "match": "\\b(if|unless|else|endif|endunless|for|endfor|const)\\b"
            }
          ]
        },
        {
          "name": "meta.embedded.inline.liquid.koru",
          "begin": "\\{\\{",
          "end": "\\}\\}",
          "patterns": [
            {
              "name": "variable.other.liquid.koru",
              "match": "[a-zA-Z_][a-zA-Z0-9_.-]*"
            },
            {
              "name": "keyword.operator.type.annotation.liquid.koru",
              "match": ":[dfsany]"
            }
          ]
        }
      ]
    },
    "module-calls": {
      "patterns": [
        {
          "name": "support.function.event.koru",
          "match": "([a-zA-Z_$][a-zA-Z0-9_-]*(?:/[a-zA-Z_$][a-zA-Z0-9_-]*)*):([a-zA-Z_$][a-zA-Z0-9_.-]*)",
          "captures": {
            "1": { "name": "entity.name.type.module.koru" },
            "2": { "name": "support.function.koru" }
          }
        },
        {
          "name": "entity.name.type.module.koru",
          "match": "\\b(std|lib|app|koru)(?:/[a-zA-Z_$][a-zA-Z0-9_-]*)+"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.declaration.koru",
          "match": "\\b(tor|proc|subflow|const|pub|when|abstract|tap|foreach|using|effect|resume|discharge|variant|impl|of|as|from|with|without|where|key|index|entity|global|shape|record|union|enum|type|module|require|provide|match|case|default)\\b"
        },
        {
          "name": "keyword.control.koru",
          "match": "\\b(if|else|loop|break|return|continue|import)\\b"
        },
        {
          "name": "constant.language.boolean.koru",
          "match": "\\b(true|false|null)\\b"
        },
        {
          "name": "keyword.operator.pipeline.koru",
          "match": "(\\|>|->|\\+\\+|~)"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.koru",
          "match": "\\b(string|bool|void|i8|i16|i32|i64|u8|u16|u32|u64|f32|f64|isize|usize|any|Source|Expression|Program|Invocation|Item|ErrorReporter|Allocator|CompilerContext|SiteResult|Shape|Metatype)\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.koru",
          "match": "\\b\\d+(?:_\\d+)*(?:\\.\\d+(?:_\\d+)*)?\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.koru",
          "match": "(==|!=|<=|>=|<|>|&&|\\|\\||=|\\+|\\-|\\*|/|%|:|\\.|,|\\{|\\}|\\(|\\)|\\[|\\])"
        }
      ]
    }
  }
}
