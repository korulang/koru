// regex_match — n classification dispatches, rotating email/number/none inputs.
// The patterns compile to specialized native DFA matchers at COMPILE TIME;
// the hot loop is `~for` + nested `~match` dispatch (Koru control flow).
// Nested `match` is pinned by tests/regression/600_STDLIB/640_REGEX/640_002.
~import std/regex
~import std/io

const std = @import("std");

var input_n: u64 = 0;
var count_email: u64 = 0;
var count_number: u64 = 0;
var count_none: u64 = 0;

const INPUTS = [_][]const u8{ "foo@bar", "12345", "hello world!" };

~pub event read-n {}

~proc read-n|zig {
    var args = std.process.args();
    _ = args.next();
    if (args.next()) |arg| {
        input_n = std.fmt.parseInt(u64, arg, 10) catch 3_000_000;
    } else {
        input_n = 3_000_000;
    }
}

~pub event bump-email {}
~proc bump-email|zig { count_email += 1; }

~pub event bump-number {}
~proc bump-number|zig { count_number += 1; }

~pub event bump-none {}
~proc bump-none|zig { count_none += 1; }

~read-n()

~for(0..input_n)
! each i |> match(INPUTS[i % 3])
            | `[a-z]+@[a-z]+` _ |> bump-email()
            | `[0-9]+` _ |> bump-number()
            | no-match _ |> bump-none()

~std/io:print.ln("email = {{ count_email:d }} number = {{ count_number:d }} none = {{ count_none:d }}")
