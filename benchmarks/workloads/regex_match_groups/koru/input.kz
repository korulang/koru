// regex_match_groups — n named-group EXTRACTION dispatches. Each match pulls
// three ints out of an `LxWxH` dimension string via named groups; the `i64` on
// each destructure field is a CONVERSION at the splice (text→int), not just an
// assertion. Grounded by tests/regression/600_STDLIB/640_REGEX/640_005 (the
// destructure-with-conversion) and the day-9/13/15 AoC tests that feed
// converted groups into a multi-arg event (`{ a, b, d: i64 } |> edge(a,b,d)`).
//
// Accumulates l*w*h so the extraction and the conversion can't be
// dead-code-eliminated — this measures the CAPTURE/EXTRACT path, the A/B
// partner to regex_match (full-match, payload discarded).
~import std/regex
~import std/io

const std = @import("std");

var input_n: u64 = 0;
var count_matched: u64 = 0;
var count_none: u64 = 0;
var total: u64 = 0;

const INPUTS = [_][]const u8{ "2x3x4", "20x3x11", "hello world!" };

~pub event read-n {}

~proc read-n|zig {
    var args = std.process.args();
    _ = args.next();
    if (args.next()) |arg| {
        input_n = std.fmt.parseInt(u64, arg, 10) catch 3_000_000;
    } else {
        input_n = 3_000_000;
    }
}

~pub event bump-dims { l: i64, w: i64, h: i64 }
~proc bump-dims|zig {
    count_matched += 1;
    total += @as(u64, @intCast(l)) * @as(u64, @intCast(w)) * @as(u64, @intCast(h));
}

~pub event bump-none {}
~proc bump-none|zig { count_none += 1; }

~read-n()

~for(0..input_n)
! each i |> std/regex:match(INPUTS[i % 3])
            | `(?<l>[0-9]+)x(?<w>[0-9]+)x(?<h>[0-9]+)` { l: i64, w: i64, h: i64 } |> bump-dims(l, w, h)
            | no-match |> bump-none()

~std/io:print.ln("matched = {{ count_matched:d }} none = {{ count_none:d }} total = {{ total:d }}")
