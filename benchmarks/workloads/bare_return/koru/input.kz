~import std/io

const std = @import("std");

var input_n: u64 = 0;

~pub tor read-n {}

~proc read-n|zig {
    var args = std.process.args();
    _ = args.next();
    if (args.next()) |arg| {
        input_n = std.fmt.parseInt(u64, arg, 10) catch 1_000_000;
    } else {
        input_n = 1_000_000;
    }
}

// The single-payload event under test. NEW bare-return form: `-> u64`.
// One non-foldable LCG step (Knuth MMIX constants) per call.
~pub tor mix { x: u64 } -> u64

~proc mix|zig {
    return x *% 6364136223846793005 +% 1442695040888963407;
}

// Driver: a native loop fires the `step` effect N times; each firing's arm
// calls `mix` (the single-payload event), binds the result, and resumes with
// it. So the bare-return event sits on the hot path, threaded data-dependently.
~pub tor driver { n: u64 }
! step u64 -> u64
| done u64

~proc driver|zig {
    var acc: u64 = 1;
    for (0..n) |_| {
        acc = step(acc);
    }
    return .{ .done = acc };
}

~read-n()
~driver(n: input_n)
! step p -> mix(x: p)
| done r |> std/io:print.ln("result = {{ r:d }}")
