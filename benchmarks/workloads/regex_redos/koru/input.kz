// regex_redos — pathological pattern `(a+)+b` against "a" × n (never matches).
// The pattern is a compile-time DFA: matching is one table walk over the
// input, linear in n by construction. There is no backtracking path to fall
// into — the cliff cannot happen here.
~import std/regex
~import std/io

const std = @import("std");

var input_n: u64 = 0;
var run_buf: []u8 = &[_]u8{};

~pub event build-input {}

~proc build-input|zig {
    var args = std.process.args();
    _ = args.next();
    if (args.next()) |arg| {
        input_n = std.fmt.parseInt(u64, arg, 10) catch 30;
    } else {
        input_n = 30;
    }
    run_buf = std.heap.page_allocator.alloc(u8, input_n) catch unreachable;
    @memset(run_buf, 'a');
}

~build-input()

~match(run_buf)
| `(a+)+b` _ |> std/io:print.ln("matched = true len = {{ input_n:d }}")
| no-match _ |> std/io:print.ln("matched = false len = {{ input_n:d }}")
