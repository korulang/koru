~import std/kernel
~import std/io
const std = @import("std");
var n: u64 = 0;
~pub tor read-n {}
~proc read-n|zig {
  var a = std.process.args(); _ = a.next();
  if (a.next()) |x| { n = std.fmt.parseInt(u64, x, 10) catch 1; } else { n = 1; }
}
~read-n()
// reduce accumulates a named scalar over every element and exits through its own
// | reduce |> continuation. The array is a small static lit; the corpus idiom
// (n-body) sizes the WORK with step(0..n) so the reduction is measured at scale
// and startup stays negligible. NOTE: under step, the chain holds ONE op — a
// self+reduce chain under step drops the self pass (see 390_111 for the
// step-free compose). So this pins reduce alone.
~std/kernel:shape(Pt) { mass: f64, }
~std/kernel:init(Pt) {
  { mass: 1.5 },
  { mass: 1000.5 },
  { mass: 1999.5 },
  { mass: 2998.5 },
  { mass: 3997.5 },
  { mass: 4996.5 },
  { mass: 5995.5 },
  { mass: 6994.5 },
  { mass: 7993.5 },
  { mass: 8992.5 },
  { mass: 9991.5 },
  { mass: 10990.5 },
  { mass: 11989.5 },
  { mass: 12988.5 },
  { mass: 13987.5 },
  { mass: 14986.5 },
  { mass: 15985.5 },
  { mass: 16984.5 },
  { mass: 17983.5 },
  { mass: 18982.5 },
  { mass: 19981.5 },
  { mass: 20980.5 },
  { mass: 21979.5 },
  { mass: 22978.5 },
  { mass: 23977.5 },
  { mass: 24976.5 },
  { mass: 25975.5 },
  { mass: 26974.5 },
  { mass: 27973.5 },
  { mass: 28972.5 },
  { mass: 29971.5 },
  { mass: 30970.5 },
  { mass: 31969.5 },
  { mass: 32968.5 },
  { mass: 33967.5 },
  { mass: 34966.5 },
  { mass: 35965.5 },
  { mass: 36964.5 },
  { mass: 37963.5 },
  { mass: 38962.5 },
  { mass: 39961.5 },
  { mass: 40960.5 },
  { mass: 41959.5 },
  { mass: 42958.5 },
  { mass: 43957.5 },
  { mass: 44956.5 },
  { mass: 45955.5 },
  { mass: 46954.5 },
  { mass: 47953.5 },
  { mass: 48952.5 },
  { mass: 49951.5 },
  { mass: 50950.5 },
  { mass: 51949.5 },
  { mass: 52948.5 },
  { mass: 53947.5 },
  { mass: 54946.5 },
  { mass: 55945.5 },
  { mass: 56944.5 },
  { mass: 57943.5 },
  { mass: 58942.5 },
  { mass: 59941.5 },
  { mass: 60940.5 },
  { mass: 61939.5 },
  { mass: 62938.5 },
}
| kernel k |> std/kernel:step(0..n)
    | step |> std/kernel:reduce { total_mass += k.mass; count += 1 }
| reduce r |> std/io:print.ln("total={{ r.total_mass:f }} count={{ r.count:f }}")
