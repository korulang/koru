~import "std/io"

const std = @import("std");

var input_n: u64 = 0;
var counter: u64 = 0;

~pub event read_n {}

~proc read_n|zig {
    var args = std.process.args();
    _ = args.next();
    if (args.next()) |arg| {
        input_n = std.fmt.parseInt(u64, arg, 10) catch 300;
    } else {
        input_n = 300;
    }
}

~pub event leaf { n: u64 }
! v u64

~proc leaf|zig {
    for (0..n) |i| v(i);
}

~pub event mid { n: u64 }
! v u64

~proc mid|zig {
    for (0..n) |i| v(i);
}

~pub event outer { n: u64 }
! v u64

~proc outer|zig {
    for (0..n) |i| v(i);
}

~pub event inc {}

~proc inc|zig {
    counter +%= 1;
}

~pub event print_counter {}

~proc print_counter|zig {
    std.debug.print("counter = {d}\n", .{counter});
}

~read_n()
~outer(n: input_n)
! v _ |>
    mid(n: input_n)
    ! v _ |>
        leaf(n: input_n)
        ! v _ |> inc()

~print_counter()
