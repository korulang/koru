// Koru Standard Library: Time
// ===========================
// Timing primitives for measuring code execution.
//
// Usage:
//   import std/time
//   import std/io
//
//   std/time:now(): start |> do_work()
//       |> std/time:elapsed(start: start): d
//           |> std/io:print.ln("work: {{ d.ms:f }}ms")

~[comptime|runtime]

const std = @import("std");

// ============================================================================
// THE CLOCK
// ============================================================================
//
// These are DURATION instruments, so the clock must be monotonic and it must
// actually resolve nanoseconds.
//
// `std.time.nanoTimestamp` is neither. It is a wall clock — it can step
// sideways under a duration measurement — and on darwin it ticks in whole
// MICROSECONDS: measured, every pair of distinct readings is exactly 1000 ns
// apart. Anything faster than a microsecond reported ZERO, and every other
// measurement carried a +/-1 us floor it never declared. `std.time.Instant`
// reads the monotonic counter and resolves 40 ns on the same machine.
//
// The value is nanoseconds since the first reading in this process. Callers
// only ever subtract two of them, so the epoch is arbitrary; it is lazy so a
// program that never asks the time pays nothing at startup.
//
// There is no wall-clock fallback. A clock that silently changes kind under a
// measurement is worse than no clock, and the panic names the one platform
// property that failed.
var __mono_epoch: ?std.time.Instant = null;

fn __mono_ns() i128 {
    const inst = std.time.Instant.now() catch
        @panic("std/time: this platform has no monotonic clock — durations cannot be measured honestly here");
    if (__mono_epoch == null) __mono_epoch = inst;
    return @intCast(inst.since(__mono_epoch.?));
}

// ============================================================================
// TIMESTAMP
// ============================================================================

// Monotonic nanoseconds since this process first asked. Only meaningful as
// one half of a difference.
~pub tor now {} -> i128

~proc now|zig {
    return __mono_ns();
}

// ============================================================================
// DURATION CALCULATION
// ============================================================================

// Calculate elapsed time since start
~pub tor elapsed { start: i128 } -> { ns: i128, us: f64, ms: f64, s: f64 }

~proc elapsed|zig {
    const ns = __mono_ns() - start;
    const ns_f: f64 = @floatFromInt(ns);
    return .{
        .ns = ns,
        .us = ns_f / 1_000.0,
        .ms = ns_f / 1_000_000.0,
        .s = ns_f / 1_000_000_000.0,
    };
}

// Print elapsed time to stderr (for use inside comptime event overrides)
~pub tor report { start: i128, label: string }

~proc report|zig {
    const ns = __mono_ns() - start;
    const ms: f64 = @as(f64, @floatFromInt(ns)) / 1_000_000.0;
    std.debug.print("⏱️  {s}: {d:.2}ms\n", .{label, ms});
}

// ============================================================================
// SLEEP (RUNTIME ONLY)
// ============================================================================

// Sleep for specified milliseconds
~[runtime] pub tor sleep-ms { ms: u64 }

~[runtime] proc sleep-ms|zig {
    std.time.sleep(ms * 1_000_000);
}

// Sleep for specified seconds
~[runtime] pub tor sleep-s { s: u64 }

~[runtime] proc sleep-s|zig {
    std.time.sleep(s * 1_000_000_000);
}
