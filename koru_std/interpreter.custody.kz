// Koru Standard Library: the `custody` part of interpreter.kz — the handle
// record's types and witnesses. Joined via `~part custody` in
// interpreter.kz; merged into the interpreter module at load.
//
// The Handle is what a HandlePool mints and discharges; CustodyKind is what
// the custody log calls those acts; custodySubject renders WHAT the
// minting verb took, renderHeldHandles WHO still owes.

pub const Handle = struct {
    /// Unique ID within this pool (persistent, incrementing)
    id: u32,
    /// Stable handle ID (string) passed through flows - from tor output field
    handle_id: []const u8,
    /// Module that defines this obligation (e.g., "sqlite3", "fs", "mem")
    obligation_module: []const u8,
    /// Obligation name within that module (e.g., "opened", "allocated")
    obligation_name: []const u8,
    /// Tor that discharges this obligation (e.g., "sqlite3:close")
    discharge_event: []const u8,
    /// Whether this handle has been discharged
    discharged: bool,
    /// Which tor created this resource (e.g., "sqlite3:open")
    created_by_event: []const u8,
    /// Resource type name for inspection (e.g., "Connection")
    resource_type: []const u8,
    /// Scope that owns this handle (for isolation enforcement)
    scope_name: []const u8,
    /// Bridge this handle was minted on — its home, the entity a holder hands
    /// the token back to. "" when the pool is a bare run's, not a bridge's.
    bridge_id: []const u8,
    /// Pool ids this handle depends on (borrowed providers that must outlive
    /// it). Derived at acquire time from the creating tor's input args that
    /// name currently-held handles this tor does not itself discharge.
    /// Guarded withdrawal: a handle is released only after every undischarged
    /// handle depending on it is gone (Cordis Theorem 63 ordering, mirrored).
    depends_on: [4]u32,
    depends_on_len: u8,

    /// Helper to get fully-qualified obligation string (e.g., "sqlite3:opened")
    pub fn fqObligation(self: *const Handle, buf: []u8) []const u8 {
        return std.fmt.bufPrint(buf, "{s}:{s}", .{ self.obligation_module, self.obligation_name }) catch self.obligation_name;
    }
};

/// What the custody record saw happen to a handle.
pub const CustodyKind = enum { mint, release };

/// `name=value, name=value` into `buf` — the custody subject: WHAT the
/// minting verb took, in the wire's own spellings. Runs at the dispatch
/// site where the evaluated args still exist; the pool stores no copy —
/// the witness is synchronous, the slice dies with the call.
pub fn custodySubject(buf: []u8, args: []const ast.Arg) []const u8 {
    var fbs = std.io.fixedBufferStream(buf);
    const w = fbs.writer();
    for (args, 0..) |a, i| {
        if (i > 0) w.writeAll(", ") catch break;
        w.print("{s}={s}", .{ a.name, a.value }) catch break;
    }
    return fbs.getWritten();
}

/// The NAMED handles an under-handled turn leaves on the bridge, as a JSON
/// list — "not the count `run` returns today" (430_056 ruling): a host or
/// shell line addresses them by name. Page-backed like the other durable
/// strings; the reporter for the hand-back may never die beneath the host.
pub fn renderHeldHandles(pool: *HandlePool) []const u8 {
    var buf = std.ArrayList(u8){};
    defer buf.deinit(std.heap.page_allocator);
    const w = buf.writer(std.heap.page_allocator);
    w.writeByte('[') catch return "[]";
    var first = true;
    for (pool.handles.items) |h| {
        if (h.discharged) continue;
        if (!first) w.writeByte(',') catch return "[]";
        first = false;
        w.writeByte('"') catch return "[]";
        w.writeAll(h.handle_id) catch return "[]";
        w.writeByte('"') catch return "[]";
    }
    w.writeByte(']') catch return "[]";
    return std.heap.page_allocator.dupe(u8, buf.items) catch "[]";
}
