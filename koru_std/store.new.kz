        if (host_is_js) {
            const grow = std.fmt.allocPrint(allocator,
                \\if (__koru_store_{s}.len >= {d}) throw new Error("std/store: store '{s}' is full (capacity {d}) - declared capacity and the `| full` branch are pinned at 690_011");
                \\const __koru_new_row = __koru_store_{s}.len;
