                \\  }},
                \\  __koru_handle_of(dense) {{
                \\    const slot = this.__koru_row_hslot[dense];
                \\    return slot + this.__koru_brand * 16777216 + this.__koru_hslot_gen[slot] * 4294967296;
                \\  }},
            , .{ CAP, CAP, CAP, CAP, store_ordinal, store_name, store_name }) catch unreachable else "";
            jc.appendSlice(allocator, "  len: 0,\n") catch unreachable;
            jc.appendSlice(allocator, hslot_js) catch unreachable;
            jc.appendSlice(allocator, "};\n") catch unreachable;
            jc.appendSlice(allocator, refhome.js) catch unreachable;
            break :blk_pjs jc.toOwnedSlice(allocator) catch unreachable;
        } else pc.toOwnedSlice(allocator) catch unreachable;

        var appended_items = std.ArrayList(ast.Item).initCapacity(allocator, 8 + qsites.items.len * 3) catch unreachable;
        // Same routing as the singleton cell: a synthesized `host_line` points
        // at the user's `.k`, and the JS emitter only takes host lines from a JS
        // host facet (js_emitter.zig:223), so on JS it is dropped in silence.
