        }
        pc.appendSlice(allocator, " };") catch unreachable;
        // `[entity(<name>)]` → a user-nameable alias for the row type, so a
        // discharger can spell `Enemy<std/store:!taken>` without touching the
        // internal `__KoruStoreRow_` name. `pub` so a sibling module can name
        // it via `input:Enemy` (writeModulePath → main_module.Enemy).
        if (entity_type) |et| {
            pc.appendSlice(allocator, "\npub const ") catch unreachable;
            pc.appendSlice(allocator, et) catch unreachable;
            pc.appendSlice(allocator, " = __KoruStoreRow_") catch unreachable;
            pc.appendSlice(allocator, store_name) catch unreachable;
            pc.appendSlice(allocator, ";") catch unreachable;
        }
        // The JS cell is ONE object with the columns as arrays and the three
        // handle functions as methods. Two things do not carry across and are
        // simply absent: `__KoruStoreT_` exists only to give the `var` a named
        // type, and `__KoruStoreRow_` (plus its `[entity(…)]` alias) is a type
        // a `| item` payload is annotated with — JS annotates nothing.
        //
        // THE HANDLE IS RE-ENCODED, and it has to be. Zig packs
        // `slot | (brand << 24)` in the low 32 bits and the generation in the
        // HIGH 32; JS bitwise operators coerce to 32 bits, so `<< 32` is a
        // no-op and `slot | brand << 24` on a value above 2^31 is negative.
        // The same three fields are packed by MULTIPLICATION instead, which is
        // exact while slot < 2^24 and generation < 2^21 — and the encoding is
        // free to differ from Zig's because no `expected.txt` in the corpus
        // contains a raw handle value. Handles are internal; the oracle cannot
        // observe them. Grepped over the store fixtures, not assumed.
        const pcell_decl = if (host_is_js) blk_pjs: {
            var jc = std.ArrayList(u8).initCapacity(allocator, 1024) catch unreachable;
            jc.appendSlice(allocator, "let __koru_store_") catch unreachable;
            jc.appendSlice(allocator, store_name) catch unreachable;
            jc.appendSlice(allocator, " = {\n") catch unreachable;
            for (field_names, field_char_caps, field_owned_info) |fname, fcc, foi| {
                // A char column holds a JS string and an owned column holds a
                // reference; neither has a zero, so they seed empty rather than
                // pretending 0 is a value of their type.
