        // `?!violated` exists it also declares `?ok` — the union needs a
        // value for "no verdict fired" (list's `?ok | ?!violated` contract).
        const insert_void_branches: []ast.Branch = if (has_facet_guards)
            ast_functional.facets.enforceBranches(allocator, &.{})
        else
            &.{};
        // ---- shared: the row-append text + standing-enter calls ----
        //
        // Most of this text is IDENTICAL on both targets — `__koru_store_x.hp
        // [__koru_new_row] = hp;` is the same statement in Zig and JavaScript,
        // which is why the two arms below read as near-duplicates. What actually
