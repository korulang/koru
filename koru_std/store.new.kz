                            break;
                        }
                    }
                    const cond = ast_functional.facets.predicate(allocator, mf, vexpr, host_is_js) orelse break;
                    const payload = std.fmt.allocPrint(allocator, "\"{s}\"", .{pv.col}) catch unreachable;
                    const g = std.fmt.allocPrint(allocator, "if (!({s})) return {s};\n", .{ cond, HS.branchOne(allocator, host_target, ast_functional.facets.violated, payload) }) catch unreachable;
                    facet_prelude.appendSlice(allocator, g) catch unreachable;
