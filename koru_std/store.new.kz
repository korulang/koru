                if (StoreRefHome.colTarget(cell_fields, fci) != null) ap.appendSlice(allocator, std.fmt.allocPrint(allocator, "__koru_home_{s}_{s}({s});\n", .{ store_name, fname, facet_norms[fci] orelse esc_fname }) catch unreachable) catch unreachable;
                const w = if (field_char_caps[fci]) |n|
