        // before the write. The predicate comes from the shared
        // `ast_functional.facets.predicate`, the same surface `std/list`'s
        // push guard reads, so the two enforcers cannot disagree about what
        // a facet says of a value; only the SINK differs (a branch
        // expression here, a struct literal there). `metFields` is refine's
        // own fold, so the guard tests exactly what the explainer reports,
        // and the verdict is the shared `?!violated` panic branch carrying
        // the column spelling the row block used. facet_norms[i] is the
        // write-side expression for column i — `facets.normExprFor`'s
        // claim — so the stored value IS the value the guard judged.
        var facet_prelude = std.ArrayList(u8).initCapacity(allocator, 64) catch unreachable;
        const facet_norms = allocator.alloc(?[]const u8, user_field_count) catch unreachable;
        @memset(facet_norms, null);
        if (@hasDecl(koru_std, "koru_refine")) {
            for (leaf_provs.items) |pv| {
                const met = koru_std.koru_refine.metFields(allocator, program, pv.scope, pv.proto, null);
                for (met) |*mf| {
                    if (!std.mem.eql(u8, mf.name, pv.field)) continue;
