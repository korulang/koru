// Koru Standard Library: Reactive Stores — the `new` event.
// Joined via `~part new` in store.kz; merged into the store module at load.

// ============================================================================
// STORE.CREATE — declare + instantiate a store; the (f) coordinator
// ============================================================================
//
//   std/store:new(game) { entities: 0[i64] }              — capacity-1 VALUE
//   std/store:new(pool, capacity: 64) { hp: i64 }         — CONTAINER (rows)
//
// Name arg + seed block (kernel:shape's surface). CAPACITY selects the
// shape (690_050 ruling): default 1 → reactive value, > 1 → container.
// A field is bare-typed (`hp: i64`) or carries a default via the bracket
// annotation (`hp: 100[i64]` — same parser as const/capture); defaults
// are orthogonal to shape.

~[keyword|comptime|transform]pub tor new {
    expr: Expression,
    source: Source,
    invocation: *const Invocation,
    item: *const std/compiler:Item,
    program: *const std/compiler:Program,
    reporter: *std/compiler:ErrorReporter,
    allocator: std.mem.Allocator
} -> SiteResult

~[transform]proc new|zig {
    const ast = @import("ast");
    const ast_functional = @import("ast_functional");
    const struct_literal = @import("struct_literal");

    // THE TARGET LANGUAGE, READ ONCE — kernel's shape (kernel.kz:616), applied
    // where the answer is the opposite one. Kernel found eight differing sites
    // in 60 and branched inside one body; store's generated artifact is a data
    // structure, so most of what it emits genuinely differs and the two
    // renderings are written side by side at each site rather than seamed.
    //
    // The SINGLETON shape is what lands first, and it is much smaller than the
    // container: a plain object, four synthesized procs, no SoA columns, no
    // handle table, no brand, no free list. The recon recorded "no incremental
    // first green exists here" because it measured the container's 111 emitted
    // lines; the singleton is a separable rung reached by its own tests.
    const host_is_js = std.mem.eql(u8, CompilerEnv.lang, "js");
    const proc_target = if (host_is_js) "js" else "zig";

    // The host-shape helpers live in `codegen_utils` beside `lowerKoruExpr`,
    // for that function's reason and one more: `store:query` emits a sweep loop
    // that calls a handler and must spell the argument record identically, and
    // a `.kz` module-scope helper would be emitted into every program that
    // imports std/store — 90 lines of compiler machinery in a shipped artifact.
    const HS = codegen_utils_store.HostShape;
    const host_target: codegen_utils_store.HostTarget = if (host_is_js) .js else .zig;

    if (item.* != .flow) @panic("store:new transform: containing item is not a flow - walker dispatch contract broken");
    const flow = &item.flow;

    const H = struct {
        fn stripQuotes(n: []const u8) []const u8 {
            if (n.len >= 2 and n[0] == '"') return n[1 .. n.len - 1];
            return n;
        }
        // The module a store was DECLARED in — where its cell and accessors are
        // emitted. Twin of the `stored` transform's helper of the same name;
        // each transform carries its own H, as the rest of this file does.
        //
        // The store's home in the FILE-derived domain (`lib`) — the same domain
        // as `Flow.module`. Use this for any comparison against a flow; use
        // `storeHomeModule` (import-derived, `app.lib`) for anything that mints
        // a resolvable path. Mixing the two makes a same-module read look
        // cross-module, which is what the two names exist to prevent.
        fn storeHomeFile(prog: *const ast.Program, store: []const u8) ?[]const u8 {
            const Find = struct {
                fn newIn(its: []const ast.Item, want: []const u8) ?[]const u8 {
                    for (its) |*pi| {
                        if (pi.* == .flow) {
                            const f = &pi.flow;
                            if (isStoreInv(f, "new", want)) return f.module;
                        } else if (pi.* == .module_decl) {
                            if (newIn(pi.module_decl.items, want)) |m| return m;
                        }
                    }
                    return null;
                }
            };
            return Find.newIn(prog.items, store);
        }
        fn storeHomeModule(alloc: std.mem.Allocator, prog: *const ast.Program, store: []const u8) ?[]const u8 {
            const apply_name = std.fmt.allocPrint(alloc, "__store_apply_{s}", .{store}) catch unreachable;
            // Both searches descend into `module_decl`: a store is declared
            // wherever its `new` was written, and a library declaring its own
            // store puts that `new` inside the module rather than at program
            // top level. A top-level-only search reports "no home" for exactly
            // the case where the home is most obvious.
            const Find = struct {
                // `??` distinguishes "no such declaration anywhere" (null) from
                // "found it, and its qualifier is null" (some null).
                fn applyIn(its: []const ast.Item, want: []const u8) ??[]const u8 {
                    for (its) |*pi| {
                        if (pi.* == .event_decl) {
                            const ed = &pi.event_decl;
                            if (ed.path.segments.len == 1 and std.mem.eql(u8, ed.path.segments[0], want)) {
                                return ed.path.module_qualifier;
                            }
                        } else if (pi.* == .module_decl) {
                            if (applyIn(pi.module_decl.items, want)) |hit| return hit;
                        }
                    }
                    return null;
                }
                // `enclosing` is the containing module's LOGICAL name — the
                // import-derived one (`app.lib`), not the flow's file-derived
                // `module` (`lib`). Those are different namespaces: everything
                // that resolves a cross-module path uses the logical name, so a
                // unit synthesized under the file name is addressed into a
                // namespace that does not exist. Top-level flows keep
                // `f.module`, which is what the entry file is registered under.
                fn newIn(its: []const ast.Item, want: []const u8, enclosing: ?[]const u8) ?[]const u8 {
                    for (its) |*pi| {
                        if (pi.* == .flow) {
                            const f = &pi.flow;
                            if (isStoreInv(f, "new", want)) return enclosing orelse f.module;
                        } else if (pi.* == .module_decl) {
                            if (newIn(pi.module_decl.items, want, pi.module_decl.logical_name)) |m| return m;
                        }
                    }
                    return null;
                }
            };
            if (Find.applyIn(prog.items, apply_name)) |hit| return hit;
            return Find.newIn(prog.items, store, null);
        }
        fn isStoreInv(f: *const ast.Flow, verb: []const u8, want_name: ?[]const u8) bool {
            const inv = f.inv();
            if (inv.path.segments.len != 1) return false;
            if (!std.mem.eql(u8, inv.path.segments[0], verb)) return false;
            const mq = inv.path.module_qualifier orelse return false;
            if (!std.mem.eql(u8, mq, "std.store")) return false;
            if (want_name) |n| {
                for (inv.args) |a| {
                    if (std.mem.eql(u8, a.name, "expr")) {
                        return std.mem.eql(u8, stripQuotes(a.value), n);
                    }
                }
                return false;
            }
            return true;
        }
        fn isIdentChar(ch: u8) bool {
            return (ch >= 'a' and ch <= 'z') or (ch >= 'A' and ch <= 'Z') or (ch >= '0' and ch <= '9') or ch == '_' or ch == '-';
        }
        // Items that can textually NAME the store — non-koru_std modules plus
        // its home; stdlib's same-named locals only false-positive (690_335).
        fn visibleStoreItems(alloc: std.mem.Allocator, items: []const ast.Item, home: []const u8, out: *std.ArrayList(*const ast.Item)) void {
            for (items) |*it| {
                if (it.* != .module_decl) { out.append(alloc, it) catch return; continue; }
                if (std.mem.indexOf(u8, it.module_decl.canonical_path, "koru_std") == null or
                    std.mem.eql(u8, it.module_decl.logical_name, home)) visibleStoreItems(alloc, it.module_decl.items, home, out);
            }
        }
        fn mkPathH(alloc: std.mem.Allocator, module: []const u8, name: []const u8) ast.DottedPath {
            const segs = alloc.alloc([]const u8, 1) catch unreachable;
            segs[0] = alloc.dupe(u8, name) catch unreachable;
            return ast.DottedPath{ .module_qualifier = alloc.dupe(u8, module) catch unreachable, .segments = segs };
        }
        // Boundary-aware `<store>.` → `__koru_store_<store>.` over a
        // continuation tree (transplanted bodies read other stores' cells).
        // Delegates to the file-scope rewriter; a plural-walk reader is in the
        // declaring module's own namespace, so no prefix.
        fn storeRefsH(alloc: std.mem.Allocator, text: []const u8, name: []const u8, is_identity: bool) []const u8 {
            return storeRefsText(alloc, text, name, "", is_identity);
        }
        fn isIn(names: []const []const u8, n: []const u8) bool {
            for (names) |x| if (std.mem.eql(u8, x, n)) return true;
            return false;
        }
        // A whole-program walk over one flow, lowering every text slot an
        // expression may stand in. `scope` carries the program's store names
        // with the prefix each needs (empty here — the plural walk reads from
        // the declaring module's own namespace).
        fn storeRefsContH(alloc: std.mem.Allocator, prog: *const ast.Program, cont: *ast.Continuation, scope: StoreScope, ident: []const []const u8, bound: []const []const u8) void {
            const ast2 = @import("ast");
            // A continuation's OWN bindings shadow store names (690_090): a
            // row binding (`! query items`) or shape-destructure makes
            // `<store>.<field>` mean THE ROW for everything under the arm. The
            // Walk runs before the site transform, so without the skip the
            // binding loses its name to the cell rewrite and the body reads the
            // whole column array where the row's value belongs.
            var own_buf: [16][]const u8 = undefined;
            var own_len: usize = 0;
            if (cont.binding) |b| {
                own_buf[own_len] = b;
                own_len += 1;
            }
            for (cont.destructure) |df| {
                own_buf[own_len] = df.name;
                own_len += 1;
            }
            const own = own_buf[0..own_len];
            const bound_all: []const []const u8 = if (own_len == 0)
                bound
            else blk: {
                const all = alloc.alloc([]const u8, bound.len + own_len) catch unreachable;
                @memcpy(all[0..bound.len], bound);
                @memcpy(all[bound.len..], own);
                break :blk all;
            };
            if (cont.condition) |cond| {
                @constCast(cont).condition = storeLowerText(alloc, prog, cond, scope, ident, bound_all);
            }
            if (cont.node) |*n| {
                // No `|*inv|` on `switch (n.*)` — that captures a TEMPORARY
                // Invocation; assigning `inline_body` there is a no-op on the
                // live AST. Arg slices still alias heap, so they "worked" and
                // hid this. Mutate via `n.invocation` (690_074).
                switch (n.*) {
                    .invocation => {
                        const inv = &n.invocation;
                        const skip = blk: {
                            if (inv.path.module_qualifier) |mq| {
                                if (std.mem.eql(u8, mq, "std.store")) break :blk true;
                            }
                            break :blk false;
                        };
                        if (!skip) {
                            for (inv.args) |*a| {
                                @constCast(a).value = storeLowerText(alloc, prog, a.value, scope, ident, bound_all);
                                if (a.expression_value) |ev| {
                                    const fresh = alloc.create(ast2.CapturedExpression) catch unreachable;
                                    fresh.* = ev.*;
                                    fresh.text = storeLowerText(alloc, prog, ev.text, scope, ident, bound_all);
                                    @constCast(a).expression_value = fresh;
                                }
                            }
                        }
                        // Template expand (`if`/`for`) bakes Expression args into
                        // Invocation.inline_body BEFORE store:create runs — rewriting
                        // args alone is too late; the freeze lives here (690_074).
                        if (inv.inline_body) |ib| {
                            inv.inline_body = storeLowerText(alloc, prog, ib, scope, ident, bound_all);
                        }
                    },
                    .inline_code => {
                        n.* = .{ .inline_code = storeLowerText(alloc, prog, n.inline_code, scope, ident, bound_all) };
                    },
                    // A branch-resolution payload (`| then => got s.n`) is a
                    // THIRD text position, alongside the guard and the args, and
                    // it was the only one the walk did not carry: the guard
                    // lowered to `__koru_store_s.n` while the payload one line
                    // below reached Zig as a bare `s` (690_256). The emitter
                    // reads `plain_value` for the single-value form and
                    // `expression_str orelse type` per field for the record
                    // form, so the rewrite must land in exactly those slots.
                    .branch_constructor => {
                        const bc = &n.branch_constructor;
                        if (bc.plain_value) |pv| bc.plain_value = storeLowerText(alloc, prog, pv, scope, ident, bound_all);
                        for (bc.fields) |*fld| {
                            const has_expr = fld.expression_str != null;
                            const lowered = storeLowerText(alloc, prog, fld.expression_str orelse fld.type, scope, ident, bound_all);
                            if (has_expr) {
                                @constCast(fld).expression_str = lowered;
                            } else {
                                @constCast(fld).type = lowered;
                            }
                        }
                    },
                    else => {},
                }
            }
            for (cont.continuations) |*c| storeRefsContH(alloc, prog, @constCast(c), scope, ident, bound_all);
        }
        fn storeRefsFlowH(alloc: std.mem.Allocator, prog: *const ast.Program, f: *ast.Flow, scope: StoreScope, ident: []const []const u8) void {
            const bound_params = flowParamNamesStore(alloc, prog, f);
            storeRefsContH(alloc, prog, &f.body, scope, ident, bound_params);
            if (f.inline_body) |ib| {
                @constCast(f).inline_body = storeLowerText(alloc, prog, ib, scope, ident, bound_params);
            }
        }
    };

    // Store name + seed block from the invocation args.
    var store_name: []const u8 = "";
    var seed_text: ?[]const u8 = null;
    for (invocation.args) |arg| {
        if (std.mem.eql(u8, arg.name, "expr")) {
            store_name = H.stripQuotes(arg.value);
        } else if (std.mem.eql(u8, arg.name, "source")) {
            seed_text = arg.value;
        }
    }
    if (store_name.len == 0 or seed_text == null) {
        return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, "std/store:new requires a name and a seed block: create(name) {{ field: value[type] }}", .{}) } };
    }
    // `__KoruStoreT_<name>` is pasted verbatim into emitted Zig — the name is
    // a Zig decl, so non-identifiers refuse here, at the author's text.
    if (!isStoreName(store_name)) {
        return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, "std/store:new({s}): '{s}' is not a store name — the name mints `__KoruStoreT_<name>` in the emitted program, so it is one identifier (letter or `_`, then letters/digits/`_`)", .{ store_name, store_name }) } };
    }

    // The namespace synthesized units are ADDRESSED under. `flow.module` is the
    // file-derived name (`lib`); every cross-module path in the program resolves
    // through the module's import-derived logical name (`app.lib`). Minting the
    // paths from the file name puts them in a namespace nothing looks up. The
    // `.module` FIELDS below stay `flow.module` — that is the emitter's
    // namespacing and matches every other item parsed from the same file.
    //
    // The scalar path had this right and the plural path did not: it minted
    // forty-odd paths off `flow.module`, and every reader that resolved one
    // reported `unknown tor 'lib:__store_inserth_todos'` (115_018).
    const home_ns = storeHome(allocator, program, store_name) orelse flow.module;

    // The same home, spelled as the EMITTED Zig namespace (`main_module.` for
    // the entry file, `koru_app.koru_lib.` for a module). Generated proc bodies
    // are raw Zig, so they must name the struct their sibling units emitted
    // into; a hardcoded `main_module.` reaches for a namespace the units are
    // not in.
    const emit_ns = storeEventQualifier(allocator, home_ns, program.main_module_name);

    // Per-store disposal contract: `[entity(<name>)]` opts this store into the
    // taken-obligation discipline. Its rows are named ENTITIES — `take` mints
    // `<std/store:taken!>` on a synthesized type (the arg capitalized, `enemy`
    // → `Enemy`, aliasing the row struct), and the USER authors the discharger
    // (the despawn handler consuming `<std/store:!taken>`). Absent → a bare
    // value table, `take` frictionless, no obligation. The extraction lives in
    // the `emitnames` part.
    const entity_type = newEntityType(allocator, flow);

    // `[tree]` — the store is a FOREST (695_STORE_TREE, TT1/TT5): synthesize
    // the invisible canonical `parent` self-FK column (i64 row handle, -1 =
    // root; the 690_048 substrate) and enable the `preorder` traversal. The
    // user's row shape never declares `parent`; the annotation adds it.
    var is_tree = false;
    for (flow.annotations) |ann| {
        if (std.mem.eql(u8, ann, "tree") or
            (std.mem.startsWith(u8, ann, "tree(") and ann[ann.len - 1] == ')'))
        {
            is_tree = true;
        }
    }

    // Seed fields via the projector (capture's path exactly).
    const expr_braced = std.fmt.allocPrint(allocator, "{{{s}}}", .{seed_text.?}) catch unreachable;
    // ONE column names no field — the store's own name is the name.
    //
    // Koru forbids a single-field record by construction and spells the
    // one-thing case bare everywhere else (`| branch { x: T }` is refused;
    // `| branch T` is the identity form). A store declaring `{ v: i64 }` writes
    // exactly the shape the language refuses, and then every hand-back lowers it
    // away again — `| item`, `| full` and `! discharge` each carry an arity
    // special-case for it. Declared bare there is no field to reach past and
    // nothing to lower.
    //
    // `allow_singleton_expression` is not new machinery: capture's seed
    // (`capture { entity }`) already opts into it at control.kz:253. The store
    // was the outlier for asking every one-column author to invent a field name
    // — `items.v`, `batch.p`, `names.name` — that carried nothing the store's own
    // name had not already said.
    // Whether a NAME WAS WRITTEN decides the shape — not whether the text could
    // serve as one. `{ i64 }` puns to a column called `i64` under the ordinary
    // pun law, which is precisely the reading a one-column store must not take.
    const identity_shaped = struct_literal.isIdentityBlock(expr_braced);
    var cell_fields: []const struct_literal.StructField = if (identity_shaped) blk: {
        const one = allocator.alloc(struct_literal.StructField, 1) catch unreachable;
        one[0] = .{ .name = ast.STORE_IDENTITY_COLUMN, .value = std.mem.trim(u8, seed_text.?, " \t\n\r") };
        break :blk one;
    } else struct_literal.parseFields(allocator, expr_braced) catch |err| return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, "std/store:new({s}): {s}", .{ store_name, struct_literal.describeErrorIn(allocator, err, expr_braced) }) } };
    if (cell_fields.len == 0) {
        return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, "std/store:new({s}): seed block has no fields", .{store_name}) } };
    }

    const store_scope_home = SL.TermRef.scopeOfFlow(program, flow);

    // Lone store packing: compound protos in the seed dissolve into path-named
    // leaves (left: Limb -> left.health: Health). Distinct placements do not fold.
    // Bare { Proto } expands at the store's root: prefix is empty (""), leaves keep
    // bare field names (str, not Player.str).
    var leaf_provs = std.ArrayList(SL.ColProv).initCapacity(allocator, cell_fields.len) catch unreachable;
    cell_fields = blk: {
        var out = std.ArrayList(struct_literal.StructField).initCapacity(allocator, cell_fields.len) catch unreachable;
        var stack = std.ArrayList([]const u8).initCapacity(allocator, 4) catch unreachable;
        for (cell_fields) |cf| {
            const peeled0 = struct_literal.peelBaseType(cf.value);
            const has_default0 = peeled0.type.len != 0;
            const ftype0 = if (has_default0) peeled0.type else std.mem.trim(u8, cf.value, " ");
            const is_root_proto = (std.mem.eql(u8, cf.name, ast.STORE_IDENTITY_COLUMN) or cf.name.len == 0);
            const member = SL.MemberRef.fieldsOf(program, ftype0, store_scope_home);
            if (member == null) {
                out.append(allocator, cf) catch unreachable;
                continue;
            }
            const mname = SL.TermRef.bareName(ftype0);
            if (has_default0) {
                return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, "std/store:new({s}): member '{s}' carries a default — members expand to columns, they hold no value", .{ store_name, mname }) } };
            }
            const flat = SL.ProtoExpander.getFlat(allocator, program, ftype0, store_scope_home);
            if (flat == null or flat.?.names.len == 0) {
                return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, "std/store:new({s}): member '{s}' declares no fields — a proto must name at least one leaf", .{ store_name, mname }) } };
            }
            const fname = if (is_root_proto) "" else cf.name;
            SL.ProtoExpander.expand(allocator, program, store_scope_home, "", fname, ftype0, &stack, null, &out, &leaf_provs);
        }
        break :blk out.toOwnedSlice(allocator) catch unreachable;
    };
    // The JS target has no dotted-column lowering: a packed member expands to
    // `web.port`-spelled columns, and every access path (object key, cell
    // read, row record) would emit invalid JavaScript. Refuse loudly until
    // the packed surface is lowered; flatten to leaf columns or target zig.
    if (host_is_js) {
        for (cell_fields) |cf| {
            if (std.mem.indexOfScalar(u8, cf.name, '.') != null) {
                return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, "std/store:new({s}): column '{s}' packs a proto member — dotted columns have no JS lowering yet (an access spells `store.web.port`, a nested-property misread); flatten the member to leaf columns or target zig", .{ store_name, cf.name }) } };
            }
        }
    }
    if (StoreRefHome.leafGate(allocator, program, reporter, flow, store_name, cell_fields, store_scope_home)) |r| return .{ .transformed = .{ .replacement = r } };
    // Write-demand for the kind tag (lazy by construction): the tag column
    // exists iff some insert names `kind:` for this store — see
    // `storeKindDemanded` (both spellings, heads and continuations). Nothing
    // asks → K1 plain behavior, no tag, no ceremony. The sibling-member seed
    // surface this fed is repudiated (690_274/275 stand broken pending
    // store:set + kind) — `new` has no member vocabulary, so the tag column
    // never synthesizes on this surface; the demand gate returns with the
    // set work.
    const want_kind: bool = false;
    // ------------------------------------------------------------------
    // T2 / queue (d): the interceptor cascade graph is comptime-visible;
    // a cross-store cycle is rejected WITH THE CYCLE NAMED (690_012) -
    // never an infinite cascade at runtime. Runs on every create; the
    // first-in-source member of any cycle still sees all others
    // untransformed, so detection cannot be skewed by transform order.
    // ------------------------------------------------------------------
    {
        const CycleEdge = struct {
            from: []const u8,
            from_field: []const u8,
            to: []const u8,
            to_field: []const u8,
        };
        var edges = std.ArrayList(CycleEdge).initCapacity(allocator, 8) catch unreachable;
        const EdgeScan = struct {
            fn seedFields(alloc: std.mem.Allocator, seed2: []const u8) []const []const u8 {
                const struct_literal2 = @import("struct_literal");
                const braced2 = std.fmt.allocPrint(alloc, "{{{s}}}", .{seed2}) catch unreachable;
                const cf2 = struct_literal2.parseFields(alloc, braced2) catch return &[_][]const u8{};
                const names2 = alloc.alloc([]const u8, cf2.len) catch unreachable;
                for (cf2, 0..) |c2, ci2| names2[ci2] = c2.name;
                return names2;
            }
            // Field-name lookup for a store still visible as an
            // untransformed create (seed order) or already coordinated
            // (apply-event branch order).
            fn fieldNameByIndex(alloc: std.mem.Allocator, prog: *const ast.Program, store: []const u8, idx: usize) []const u8 {
                const struct_literal2 = @import("struct_literal");
                const apply_name2 = std.fmt.allocPrint(alloc, "__store_apply_{s}", .{store}) catch unreachable;
                for (flatItems(alloc, prog.items)) |pi2| {
                    switch (pi2.*) {
                        .event_decl => |*ed2| {
                            if (ed2.path.segments.len == 1 and std.mem.eql(u8, ed2.path.segments[0], apply_name2)) {
                                if (idx < ed2.branches.len) return ed2.branches[idx].name;
                            }
                        },
                        .flow => |*f2| {
                            const inv2 = f2.inv();
                            if (inv2.path.segments.len != 1 or !std.mem.eql(u8, inv2.path.segments[0], "new")) continue;
                            const mq2 = inv2.path.module_qualifier orelse continue;
                            if (!std.mem.eql(u8, mq2, "std.store")) continue;
                            var matches2 = false;
                            var seed3: ?[]const u8 = null;
                            for (inv2.args) |a2| {
                                if (std.mem.eql(u8, a2.name, "expr")) {
                                    var v2 = a2.value;
                                    if (v2.len >= 2 and v2[0] == '"') v2 = v2[1 .. v2.len - 1];
                                    matches2 = std.mem.eql(u8, v2, store);
                                } else if (std.mem.eql(u8, a2.name, "source")) {
                                    seed3 = a2.value;
                                }
                            }
                            if (!matches2 or seed3 == null) continue;
                            const braced3 = std.fmt.allocPrint(alloc, "{{{s}}}", .{seed3.?}) catch unreachable;
                            const cf3 = struct_literal2.parseFields(alloc, braced3) catch continue;
                            if (idx < cf3.len) return cf3[idx].name;
                        },
                        else => {},
                    }
                }
                return "?";
            }
            fn scanCont(alloc: std.mem.Allocator, prog: *const ast.Program, cont: *const ast.Continuation, from: []const u8, from_field: []const u8, list: *std.ArrayList(CycleEdge)) void {
                if (cont.node) |n| {
                    switch (n) {
                        .invocation => |inv| {
                            // Raw spelling: std/store:stored { to.field: ... }
                            if (inv.path.module_qualifier) |mq| {
                                if (std.mem.eql(u8, mq, "std.store") and inv.path.segments.len == 1 and std.mem.eql(u8, inv.path.segments[0], "stored")) {
                                    for (inv.args) |a| {
                                        if (!std.mem.eql(u8, a.name, "source")) continue;
                                        const struct_literal2 = @import("struct_literal");
                                        const braced2 = std.fmt.allocPrint(alloc, "{{{s}}}", .{a.value}) catch unreachable;
                                        const writes2 = struct_literal2.parseFields(alloc, braced2) catch continue;
                                        for (writes2) |w2| {
                                            const dot2 = std.mem.indexOfScalar(u8, w2.name, '.') orelse continue;
                                            list.append(alloc, .{
                                                .from = from,
                                                .from_field = from_field,
                                                .to = alloc.dupe(u8, w2.name[0..dot2]) catch unreachable,
                                                .to_field = alloc.dupe(u8, w2.name[dot2 + 1 ..]) catch unreachable,
                                            }) catch unreachable;
                                        }
                                    }
                                }
                            }
                            // Rewritten spelling: __store_write_<to>(field: <idx>, ...)
                            // (the walker transforms nested stored sites BEFORE
                            // their enclosing create's head - both spellings are
                            // live during coordination).
                            if (inv.path.segments.len == 1 and std.mem.startsWith(u8, inv.path.segments[0], "__store_write_")) {
                                const to_store = inv.path.segments[0]["__store_write_".len..];
                                var fidx2: usize = 0;
                                for (inv.args) |a| {
                                    if (std.mem.eql(u8, a.name, "field")) {
                                        fidx2 = std.fmt.parseInt(usize, std.mem.trim(u8, a.value, " "), 10) catch 0;
                                    }
                                }
                                list.append(alloc, .{
                                    .from = from,
                                    .from_field = from_field,
                                    .to = alloc.dupe(u8, to_store) catch unreachable,
                                    .to_field = alloc.dupe(u8, fieldNameByIndex(alloc, prog, to_store, fidx2)) catch unreachable,
                                }) catch unreachable;
                            }
                            // Per-field spelling (owned-containing stores,
                            // unit 4c): __store_fwrite_<to>_<idx>(row, value)
                            // — the field index rides the NAME's suffix after
                            // the last '_', not a `field` arg.
                            if (inv.path.segments.len == 1 and std.mem.startsWith(u8, inv.path.segments[0], "__store_fwrite_")) {
                                const rest = inv.path.segments[0]["__store_fwrite_".len..];
                                if (std.mem.lastIndexOfScalar(u8, rest, '_')) |up| {
                                    const to_store = rest[0..up];
                                    const fidx2 = std.fmt.parseInt(usize, rest[up + 1 ..], 10) catch 0;
                                    list.append(alloc, .{
                                        .from = from,
                                        .from_field = from_field,
                                        .to = alloc.dupe(u8, to_store) catch unreachable,
                                        .to_field = alloc.dupe(u8, fieldNameByIndex(alloc, prog, to_store, fidx2)) catch unreachable,
                                    }) catch unreachable;
                                }
                            }
                        },
                        else => {},
                    }
                }
                for (cont.continuations) |*c| scanCont(alloc, prog, c, from, from_field, list);
            }
        };
        for (flatItems(allocator, program.items)) |pi| {
            if (pi.* != .flow) continue;
            const cfp = &pi.flow;
            if (!H.isStoreInv(cfp, "new", null)) continue;
            var cname: []const u8 = "";
            var cseed: []const u8 = "";
            for (cfp.inv().args) |a| {
                if (std.mem.eql(u8, a.name, "expr")) cname = H.stripQuotes(a.value);
                if (std.mem.eql(u8, a.name, "source")) cseed = a.value;
            }
            if (cname.len == 0) continue;
            // FIELD-LEVEL graph (the whole point of the T2 detector): the
            // trigger of a field interceptor is that field; `updated`
            // triggers on every field of the store. hp->shield inside one
            // store is NOT a cycle (690_004); alpha.x->beta.y->alpha.x is.
            const seed_fields = EdgeScan.seedFields(allocator, cseed);
            for (cfp.body.continuations) |*icont| {
                const bname2 = std.mem.trim(u8, icont.branch, " ");
                if (std.mem.eql(u8, bname2, "updated")) {
                    for (seed_fields) |sf| {
                        EdgeScan.scanCont(allocator, program, icont, cname, sf, &edges);
                    }
                } else {
                    EdgeScan.scanCont(allocator, program, icont, cname, bname2, &edges);
                }
            }
        }
        // DFS from this store looking for a path back to itself.
        var path = std.ArrayList(CycleEdge).initCapacity(allocator, 8) catch unreachable;
        const Dfs = struct {
            fn nodeEql(a_s: []const u8, a_f: []const u8, b_s: []const u8, b_f: []const u8) bool {
                return std.mem.eql(u8, a_s, b_s) and std.mem.eql(u8, a_f, b_f);
            }
            fn walk(list: []const CycleEdge, at_s: []const u8, at_f: []const u8, t_s: []const u8, t_f: []const u8, depth: usize, pth: *std.ArrayList(CycleEdge), alloc: std.mem.Allocator) bool {
                if (depth > 16) return false;
                for (list) |e| {
                    if (!nodeEql(e.from, e.from_field, at_s, at_f)) continue;
                    pth.append(alloc, e) catch unreachable;
                    if (nodeEql(e.to, e.to_field, t_s, t_f)) return true;
                    if (walk(list, e.to, e.to_field, t_s, t_f, depth + 1, pth, alloc)) return true;
                    _ = pth.pop();
                }
                return false;
            }
        };
        var cycle_found = false;
        for (edges.items) |se| {
            if (!std.mem.eql(u8, se.from, store_name)) continue;
            path.clearRetainingCapacity();
            if (Dfs.walk(edges.items, se.from, se.from_field, se.from, se.from_field, 0, &path, allocator)) {
                cycle_found = true;
                break;
            }
        }
        if (cycle_found) {
            var msg = std.ArrayList(u8).initCapacity(allocator, 128) catch unreachable;
            msg.appendSlice(allocator, "std/store: store cascade cycle: ") catch unreachable;
            for (path.items, 0..) |e, ei| {
                if (ei == 0) {
                    msg.appendSlice(allocator, e.from) catch unreachable;
                    msg.appendSlice(allocator, ".") catch unreachable;
                    msg.appendSlice(allocator, e.from_field) catch unreachable;
                }
                msg.appendSlice(allocator, " -> ") catch unreachable;
                msg.appendSlice(allocator, e.to) catch unreachable;
                msg.appendSlice(allocator, ".") catch unreachable;
                msg.appendSlice(allocator, e.to_field) catch unreachable;
            }
            msg.appendSlice(allocator, " - interceptor contracts must be acyclic; a convergent self-write needs @converges (unbuilt, queue (d))") catch unreachable;
            return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, "{s}", .{msg.items}) } };
        }
    }

    // CAPACITY selects the shape (690_050 ruling). Two store shapes:
    //   capacity 1 (default)  — reactive VALUE: always present, direct
    //                           `store.field` access, stored/watch.
    //   capacity > 1          — reactive CONTAINER: rows, grows from empty,
    //                           insert/query/take, `store[r].field` access.
    // Initialization is ORTHOGONAL: a seeded field (`hp: 100[i64]`) means
    // only "this column has a default value" — legal at any capacity, never
    // the shape selector. A bare field (`hp: i64`) zero-defaults at
    // capacity 1. (O10: capacity is fixed static memory declared at create;
    // exhaustion is the insert's `| full` branch, 690_011.)
    var cap_buf: usize = 1;
    for (invocation.args) |a| {
        if (std.mem.eql(u8, a.name, "capacity")) {
            cap_buf = std.fmt.parseInt(usize, std.mem.trim(u8, a.value, " "), 10) catch {
                return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, "std/store:new({s}): capacity must be an integer literal (got '{s}')", .{ store_name, a.value }) } };
            };
            if (cap_buf == 0) {
                return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, "std/store:new({s}): capacity must be >= 1 (capacity 1 is the reactive value shape; capacity > 1 is the container shape)", .{store_name}) } };
            }
        }
    }
    const CAP: usize = cap_buf;
    const is_plural = CAP > 1;
    if (want_kind and !is_plural) {
        return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, "std/store:new({s}): kinds need a container store - declare a capacity (`capacity: N`, N > 1); a capacity-1 value has no rows to tag", .{store_name}) } };
    }

    // [tree] sits on the container substrate — a capacity-1 value has no
    // rows to arrange into a forest.
    if (is_tree and !is_plural) {
        return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, "std/store:new({s}): [tree] needs a container store - declare a capacity (`capacity: N`, N > 1); a capacity-1 value has no rows to arrange", .{store_name}) } };
    }

    // TT1: the synthesized `parent` column is INVISIBLE — the user's seed
    // block declares only user fields; the tree annotation appends `parent`
    // (i64 self-FK, -1 = root) after them. `user_field_count` bounds the
    // insert surface: inserts never name `parent`.
    const user_field_count = cell_fields.len;
    const synth_count: usize = blk: {
        var n: usize = 0;
        if (is_tree) n += 1;
        if (want_kind) n += 1;
        break :blk n;
    };
    const field_names = allocator.alloc([]const u8, cell_fields.len + synth_count) catch unreachable;
    const field_types = allocator.alloc([]const u8, cell_fields.len + synth_count) catch unreachable;
    // Per-column optional default (the seed): `hp: 100[i64]` carries "100",
    // `hp: i64` carries none. Orthogonal to shape (690_050).
    const field_defaults = allocator.alloc(?[]const u8, cell_fields.len + synth_count) catch unreachable;
    // char[N] (690_052, Tier A strings): a FIXED-LENGTH byte column. Non-null
    // = the declared byte length N. The SoA column is [CAP][N]u8 — static,
    // zero-alloc, NO ownership (the variable-string take/discharge tier is a
    // LATER rung). Event-level (insert input, apply branch payload, qbody
    // projection) the column travels as `string` ([]const u8); only the Zig
    // cell/row emission and the read/write text consult N.
    const field_char_caps = allocator.alloc(?usize, cell_fields.len + synth_count) catch unreachable;
    // Owned-string column (B-narrow, 690_053): the column OWNS a
    // *std/string:String — the caller's <std/string:instance!> obligation
    // moves INTO the store at insert (the synthesized insert param consumes
    // <std.string:!instance>), back OUT at take (the item payload field
    // reissues <std.string:instance!>), and teardown auto-frees still-live
    // elements via the canonical discharger (std/string:free). This rung is
    // gated to exactly that one type; any other obligation-bearing qualified
    // column is a loud later-rung wall.
    const field_owned = allocator.alloc(bool, cell_fields.len + synth_count) catch unreachable;
    // Owned-column metadata (B-narrow GENERALIZED): for an owned column
    // `*mod:Type<state!>`, the store no longer hardcodes std/string — it reads
    // the type + module + state from the column type and DISCOVERS the canonical
    // discharger (the void `<!state>`-consuming event) from the program. `String`
    // is just the first instance; `*Player<allocated!>`, `*File<open!>` are the
    // same citizen. Non-null exactly when field_owned[i] is true; disch_* are
    // filled by the canonical-discharger search below.
    const OwnedCol = struct {
        type_name: []const u8, // "String" / "Resource" (base type, no `*`)
        module_slash: []const u8, // "std/string" (the type's module, slash form)
        module_dot: []const u8, // "std.string" (dot form, for phantom canon)
        host_type: []const u8, // "koru_std.koru_string.String" (Zig storage cell)
        state: []const u8, // "instance" / "owned"
        disch_event: []const u8, // canonical discharger event name ("free")
        disch_param: []const u8, // its consuming param field name ("s")
        disch_host: []const u8, // "koru_std.koru_string" (discharger module host)
    };
    const field_owned_info = allocator.alloc(?OwnedCol, cell_fields.len + synth_count) catch unreachable;
    for (field_owned_info) |*oi| oi.* = null;
    // module logical name (slash or dot) -> Zig host namespace: each '.'/'/'
    // segment gets a `koru_` prefix. Mirrors codegen_utils.buildKoruModulePath /
    // continuation_codegen.buildEventPath — the ONE convention for naming any
    // module's emitted handler; the store reuses it instead of hardcoding.
    const HostPath = struct {
        fn build(alloc: std.mem.Allocator, logical: []const u8) []const u8 {
            var buf = std.ArrayList(u8).initCapacity(alloc, 32) catch unreachable;
            var first = true;
            var it = std.mem.splitAny(u8, logical, "./");
            while (it.next()) |seg| {
                if (seg.len == 0) continue;
                if (!first) buf.append(alloc, '.') catch unreachable;
                buf.appendSlice(alloc, "koru_") catch unreachable;
                buf.appendSlice(alloc, seg) catch unreachable;
                first = false;
            }
            return buf.toOwnedSlice(alloc) catch unreachable;
        }
        fn toDot(alloc: std.mem.Allocator, logical: []const u8) []const u8 {
            const out = alloc.dupe(u8, logical) catch unreachable;
            for (out) |*c| {
                if (c.* == '/') c.* = '.';
            }
            return out;
        }
    };
    for (cell_fields, 0..) |cf, i| {
        if (is_tree and std.mem.eql(u8, cf.name, "parent")) {
            return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, "std/store:new({s}): [tree] synthesizes the `parent` column itself (TT1, invisible) - drop the explicit `parent` declaration", .{store_name}) } };
        }
        const peeled = struct_literal.peelBaseType(cf.value);
        const has_default = peeled.type.len != 0;
        const ftype = if (has_default) peeled.type else std.mem.trim(u8, cf.value, " ");
        // `label: char[16]` — the bracket size is the buffer length.
        var char_cap: ?usize = null;
        if (std.mem.startsWith(u8, ftype, "char[") and ftype.len > "char[".len and ftype[ftype.len - 1] == ']') {
            const digits = std.mem.trim(u8, ftype["char[".len .. ftype.len - 1], " ");
            const n = std.fmt.parseInt(usize, digits, 10) catch {
                return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, "std/store:new({s}): field '{s}': char[N] needs an integer byte length (got '{s}')", .{ store_name, cf.name, ftype }) } };
            };
            if (n == 0) {
                return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, "std/store:new({s}): field '{s}': char[N] needs N >= 1 - a zero-length fixed-char column holds nothing", .{ store_name, cf.name }) } };
            }
            if (!is_plural) {
                return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, "std/store:new({s}): field '{s}' is char[{d}] - fixed-char columns live on the container shape (declare `capacity: N`, N > 1); the capacity-1 value tier is scalar-only this rung", .{ store_name, cf.name, n }) } };
            }
            char_cap = n;
        }
        // Owned column (B-narrow GENERALIZED): `*mod:Type<state!>` — the store
        // owns an obligation-bearing value of ANY type and discharges it through
        // that type's own canonical discharger. Parse the type/module/state here;
        // the single-canonical-discharger check happens below. Any pointer- or
        // phantom-carrying column that isn't a well-formed `*mod:Type<state!>` is
        // a loud wall — never a silent scalar fallback.
        var owned_col = false;
        var owned_info: ?OwnedCol = null;
        if (std.mem.startsWith(u8, ftype, "*") or std.mem.indexOfScalar(u8, ftype, '<') != null) {
            if (!std.mem.startsWith(u8, ftype, "*") or std.mem.indexOfScalar(u8, ftype, '<') == null or ftype[ftype.len - 1] != '>') {
                return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, "std/store:new({s}): field '{s}' is {s} - an owned column must be a well-formed `*mod:Type<state!>` (pointer, module-qualified type, held obligation)", .{ store_name, cf.name, ftype }) } };
            }
            const lt = std.mem.indexOfScalar(u8, ftype, '<').?;
            const type_part = std.mem.trim(u8, ftype[1..lt], " "); // "mod:Type"
            var phantom_part = std.mem.trim(u8, ftype[lt + 1 .. ftype.len - 1], " "); // "mod:state!" | "state!"
            const tcolon = std.mem.lastIndexOfScalar(u8, type_part, ':');
            if (tcolon == null) {
                return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, "std/store:new({s}): field '{s}' is {s} - an owned column type must be module-qualified `*mod:Type<state!>` so the store can locate its discharger", .{ store_name, cf.name, ftype }) } };
            }
            const module_slash = type_part[0..tcolon.?];
            const type_name = type_part[tcolon.? + 1 ..];
            if (phantom_part.len == 0 or phantom_part[phantom_part.len - 1] != '!') {
                return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, "std/store:new({s}): field '{s}' is {s} - an owned column must hold a live obligation `<state!>` (a bare `<state>` borrow is not owned; 330_067/069)", .{ store_name, cf.name, ftype }) } };
            }
            phantom_part = phantom_part[0 .. phantom_part.len - 1]; // strip trailing '!'
            const state = if (std.mem.lastIndexOfScalar(u8, phantom_part, ':')) |pc| phantom_part[pc + 1 ..] else phantom_part;
            if (!is_plural) {
                return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, "std/store:new({s}): field '{s}' is an owned column - owned columns live on the container shape (declare `capacity: N`, N > 1); the capacity-1 value tier is scalar-only this rung", .{ store_name, cf.name }) } };
            }
            owned_col = true;
            owned_info = OwnedCol{
                .type_name = allocator.dupe(u8, type_name) catch unreachable,
                .module_slash = allocator.dupe(u8, module_slash) catch unreachable,
                .module_dot = HostPath.toDot(allocator, module_slash),
                .host_type = std.fmt.allocPrint(allocator, "{s}.{s}", .{ HostPath.build(allocator, module_slash), type_name }) catch unreachable,
                .state = allocator.dupe(u8, state) catch unreachable,
                .disch_event = "",
                .disch_param = "",
                .disch_host = "",
            };
        }
        // Scalar widening (690_020 tier 1): i64/i32/f64/f32 columns — the
        // kernel:shape f64 precedent (390_001) applied to the store cell.
        // Containers (690_049) and values (690_021) share the scalar tier;
        // a container carries per-field typed SoA columns.
        const known_scalar = std.mem.eql(u8, ftype, "i64") or std.mem.eql(u8, ftype, "i32") or
            std.mem.eql(u8, ftype, "f64") or std.mem.eql(u8, ftype, "f32");
        // Slice A: a bare in-scope terminal (Health) is a column — the alias
        // emits verbatim and lowers through its host type. Qualified names
        // refuse below as before (address resolution is a later rung).
        const ref_target = StoreRefs.inner(ftype);
        if (StoreRefs.checkTarget(allocator, program, reporter, flow, store_name, cf.name, ftype, store_scope_home)) |r| return .{ .transformed = .{ .replacement = r } };
        const known_terminal = if (!known_scalar and char_cap == null and !owned_col and ref_target == null)
            SL.TermRef.isDeclared(program, ftype, store_scope_home)
        else
            false;
        if (!known_scalar and char_cap == null and !owned_col and !known_terminal and ref_target == null) {
            return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, "std/store:new({s}): field '{s}' is {s} — columns are scalars (i64/i32/f64/f32), fixed-char (char[N], 690_052), owned strings (*std/string:String<std/string:instance!>, 690_053), or ref() row handles (698_009); vec/mat tiers are pinned at 690_020", .{ store_name, cf.name, ftype }) } };
        }
        field_names[i] = cf.name;
        field_types[i] = if (char_cap != null)
            allocator.dupe(u8, "string") catch unreachable
        else if (owned_info) |oi|
            std.fmt.allocPrint(allocator, "*{s}", .{oi.type_name}) catch unreachable
        else if (ref_target != null) allocator.dupe(u8, "i64") catch unreachable
        else
            ftype;
        field_char_caps[i] = char_cap;
        field_owned[i] = owned_col;
        field_owned_info[i] = owned_info;
        field_defaults[i] = if (has_default) peeled.value else null;
    }
    if (is_tree) {
        field_names[user_field_count] = allocator.dupe(u8, "parent") catch unreachable;
        field_types[user_field_count] = allocator.dupe(u8, "i64") catch unreachable;
        field_char_caps[user_field_count] = null;
        field_owned[user_field_count] = false;
        field_owned_info[user_field_count] = null;
        field_defaults[user_field_count] = null;
    }
    // The demanded kind tag (write-demand): one hidden i64 column after the
    // user fields (and after `parent`), holding the insert's member ordinal
    // (seed order, 1-based). Like `parent`, it is invisible to the insert
    // surface — but unlike `parent` it has no default: the insert names the
    // kind (`kind: player`), and a missing kind on a kinded store refuses at
    // the insert. Singleton tag is refused below (kinds need rows).
    const kind_idx: usize = blk: {
        var k: usize = user_field_count;
        if (is_tree) k += 1;
        break :blk k;
    };
    if (want_kind) {
        field_names[kind_idx] = allocator.dupe(u8, "kind") catch unreachable;
        field_types[kind_idx] = allocator.dupe(u8, "i64") catch unreachable;
        field_char_caps[kind_idx] = null;
        field_owned[kind_idx] = false;
        field_owned_info[kind_idx] = null;
        field_defaults[kind_idx] = null;
    }
    // Ref-home checks (698_012-016): a homeless target refuses here; the guard fns append to the cell emission and every write path calls them.
    const refhome = StoreRefHome.build(allocator, program, reporter, flow, store_name, cell_fields, store_scope_home);
    if (refhome.refusal) |r| return .{ .transformed = .{ .replacement = r } };
    var has_owned = false;
    for (field_owned) |fo| {
        if (fo) has_owned = true;
    }
    // DRAIN rung (690_057/058): an owned column whose type has MORE THAN ONE
    // void `<!state>` discharger (commit|rollback) is AMBIGUOUS — the store
    // cannot pick. The column stays owned (insert still consumes the caller's
    // obligation into the store), but teardown fires a USER-provided
    // `! discharge item |> ...` effect branch bolted onto the store
    // declaration instead of a discovered canonical discharger. The store is
    // static (program-lifetime), so its discharger is declared statically AT
    // the store. drain_required marks the store; the ambig_* capture feeds
    // the teaching error when the `! discharge` branch is missing.
    var drain_required = false;
    var ambig_module: []const u8 = "";
    var ambig_type: []const u8 = "";
    var ambig_state: []const u8 = "";
    var ambig_count: usize = 0;
    if (has_owned) {
        // One obligation surface per store this rung: [entity] mints
        // <std/store:taken!> on the whole row; an owned column reissues
        // <std.string:instance!> on a field. Composing both is a later rung.
        if (entity_type != null) {
            return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, "std/store:new({s}): [entity(...)] with an owned-string column - one obligation surface per store this rung (the row's <taken!> and the field's <instance!> compose at a later rung)", .{store_name}) } };
        }
        if (is_tree) {
            return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, "std/store:new({s}): [tree] with an owned-string column is a later rung", .{store_name}) } };
        }
        for (field_char_caps) |cc| {
            if (cc != null) {
                return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, "std/store:new({s}): fixed-char (char[N]) and owned-string columns in one store are a later rung", .{store_name}) } };
            }
        }
        // The canonical-discharge wall (690_035, at the column boundary),
        // GENERALIZED past std/string: for EACH owned column type the program
        // must expose EXACTLY ONE void terminal discharger consuming <!state>
        // on *Type — e.g. std/string:free for *String<!instance>, or `free`/
        // `close` for a user *Resource<!owned>. Zero -> the module isn't in
        // scope; several -> ambiguous (commit|rollback), which needs a drain/
        // pick surface this rung does not build. The discharger's identity
        // (event + consuming param + host namespace) is captured for codegen.
        for (field_owned_info, 0..) |maybe_oi, oi_idx| {
            var oi = maybe_oi orelse continue;
            const want_type = std.fmt.allocPrint(allocator, "*{s}", .{oi.type_name}) catch unreachable;
            const want_consume = std.fmt.allocPrint(allocator, "!{s}", .{oi.state}) catch unreachable;
            const auto_discharge = @import("auto_discharge_inserter");
            const Cand = struct { decl: *const ast.EventDecl, param: []const u8 };
            var cands = std.ArrayList(Cand).initCapacity(allocator, 4) catch unreachable;
            var saw_module = false;
            for (program.items) |pi| {
                if (pi != .module_decl) continue;
                const md = &pi.module_decl;
                if (!std.mem.eql(u8, md.logical_name, oi.module_dot) and !std.mem.eql(u8, md.logical_name, oi.module_slash)) continue;
                saw_module = true;
                // BY POINTER: a candidate outlives this loop (the policy reads
                // its annotations after the scan), so a by-value `|mi|` copy
                // would hand the picker a dangling event_decl.
                for (md.items) |*mi| {
                    if (mi.* != .event_decl) continue;
                    const ed = &mi.event_decl;
                    // Only a tor that can be called UNATTENDED is a candidate —
                    // the same rule the inserter applies at a scope exit, asked
                    // of it rather than restated here.
                    if (!auto_discharge.isUnattendedDischarge(ed)) continue;
                    for (ed.input.fields) |f| {
                        if (!std.mem.eql(u8, f.type, want_type)) continue;
                        const ph = f.phantom orelse continue;
                        // Union members split on '|'; a consuming member is `!state`.
                        var members = std.mem.splitScalar(u8, ph, '|');
                        while (members.next()) |m| {
                            if (std.mem.eql(u8, std.mem.trim(u8, m, " "), want_consume)) {
                                cands.append(allocator, .{ .decl = ed, .param = allocator.dupe(u8, f.name) catch unreachable }) catch unreachable;
                                break;
                            }
                        }
                    }
                }
            }
            // THE question, asked once, of the module that owns the answer:
            // can this column be discharged unattended? `[!]` settles a field
            // of several; zero candidates and an unbroken tie both come back
            // null, and null means "a human has to say", not "no disposer".
            const picked = auto_discharge.pickUnattendedDischarge(Cand, cands.items, struct {
                fn declOf(c: Cand) *const ast.EventDecl {
                    return c.decl;
                }
            }.declOf);
            const discharger_count = cands.items.len;
            var found_event: []const u8 = "";
            var found_param: []const u8 = "";
            if (picked) |p| {
                // Event name = path segments joined by '_' (the
                // `<name>_event.handler` codegen convention). Segments are
                // kebab-mangled for the splice: a .kz module's tor name can
                // still be kebab here, and `<kebab>_event` is not a Zig
                // identifier — the discharger call must spell the emitted
                // name, not the source name.
                var nb = std.ArrayList(u8).initCapacity(allocator, 16) catch unreachable;
                for (p.decl.path.segments, 0..) |seg, si| {
                    if (si > 0) nb.append(allocator, '_') catch unreachable;
                    codegen_utils_store.appendMangled(&nb, allocator, seg) catch unreachable;
                }
                found_event = nb.toOwnedSlice(allocator) catch unreachable;
                found_param = p.param;
            }
            if (!saw_module) {
                return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, "std/store:new({s}): an owned column of *{s}:{s} needs module {s} in scope - add `import {s}`", .{ store_name, oi.module_slash, oi.type_name, oi.module_slash, oi.module_slash }) } };
            }
            if (picked == null) {
                // The store's question is not how MANY dischargers a column
                // has — it is whether the store can dispose an element
                // UNATTENDED at teardown, where there is no caller to hand a
                // return value to and no arm to answer a branch. `[!]` is how
                // an author settles a field of several, so counting would get
                // the annotated case wrong; the policy above already knows.
                //
                // Zero and several fail that test for different reasons and
                // take the SAME road: the column must be drained BY HAND. That
                // is what `! discharge` is for, and it is an ordinary Koru body
                // rather than a single unattended call — so the author pipes
                // whatever sequence the type needs (`cancel` then close, a
                // commit-or-rollback decision) and that body's OWN obligations
                // settle by the ordinary rules.
                //
                // So a store never refuses a type. It only asks for
                // instructions when it genuinely cannot act alone. Which is why
                // zero dischargers stopped being an error here: a type whose
                // exits all return or branch — curl's `*Pending<open!>`, whose
                // exits are `drain`, `await` and `cancel` — is perfectly
                // storable, it just cannot be swept up without being told how.
                drain_required = true;
                ambig_module = oi.module_slash;
                ambig_type = oi.type_name;
                ambig_state = oi.state;
                ambig_count = discharger_count;
                continue;
            }
            oi.disch_event = found_event;
            oi.disch_param = found_param;
            // WHERE THE DISCHARGER'S EVENT LIVES, in the host's own namespace.
            // Zig keeps the module structure (`koru_std.koru_string.free_event`);
            // JavaScript does not — `js_emitter` flattens every event in the
            // program, imported modules included, into the one `main_module`
            // object (:155), which is the same reason `storeEventQualifier`
            // exists. Emitting the Zig path here reached node as
            // `ReferenceError: koru_std is not defined`, at teardown, on 13
            // tests that had just started compiling.
            oi.disch_host = if (storeHostTarget() == .js) "main_module" else HostPath.build(allocator, oi.module_slash);
            field_owned_info[oi_idx] = oi;
            // RETAIN the discovered discharger (its event_decl AND matching
            // proc_decl) so dead-strip preserves them. The teardown calls the
            // discharger from RAW HOST CODE (`<host>.<name>_event.handler`,
            // line 2441) — invisible to dead-strip's invocation scan. Without
            // this, an insert-then-query-only owned store (no user `take`-back
            // invoking the discharger) strips `free`/`close`, and the teardown
            // call dangles at a nonexistent `<mod>.<name>_event` (690_060). Same
            // @retain mechanism runtime.kz uses for registered events: mutate the
            // carried-forward program nodes in place (by pointer, not the
            // by-value discovery copies above).
            for (program.items) |*pi_c| {
                if (pi_c.* != .module_decl) continue;
                const md_m = &@constCast(pi_c).module_decl;
                if (!std.mem.eql(u8, md_m.logical_name, oi.module_dot) and !std.mem.eql(u8, md_m.logical_name, oi.module_slash)) continue;
                for (md_m.items) |*mi_c| {
                    const mi_m = @constCast(mi_c);
                    var segs: []const []const u8 = undefined;
                    switch (mi_m.*) {
                        .event_decl => |*e| segs = e.path.segments,
                        .proc_decl => |*p| segs = p.path.segments,
                        else => continue,
                    }
                    var jb = std.ArrayList(u8).initCapacity(allocator, 16) catch unreachable;
                    for (segs, 0..) |seg, si| {
                        if (si > 0) jb.append(allocator, '_') catch unreachable;
                        codegen_utils_store.appendMangled(&jb, allocator, seg) catch unreachable;
                    }
                    if (!std.mem.eql(u8, jb.items, oi.disch_event)) continue;
                    switch (mi_m.*) {
                        .event_decl => |*e| {
                            const na = allocator.alloc([]const u8, e.annotations.len + 1) catch unreachable;
                            @memcpy(na[0..e.annotations.len], e.annotations);
                            na[e.annotations.len] = "retain";
                            e.annotations = na;
                        },
                        .proc_decl => |*p| {
                            const na = allocator.alloc([]const u8, p.annotations.len + 1) catch unreachable;
                            @memcpy(na[0..p.annotations.len], p.annotations);
                            na[p.annotations.len] = "retain";
                            p.annotations = na;
                        },
                        else => {},
                    }
                }
            }
        }
        if (drain_required) {
            // One teardown surface per store this rung: the drain payload
            // carries the row's obligations for the user handler, while a
            // canonical column would ALSO auto-fire its discovered discharger
            // in the same loop — a double-discharge composition question.
            // Loud wall, later rung.
            for (field_owned_info) |maybe_oi| {
                const oi = maybe_oi orelse continue;
                if (oi.disch_event.len != 0) {
                    return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, "std/store:new({s}): mixing a canonical owned column (*{s}:{s}) with an ambiguous one (*{s}:{s}) in one store is a later rung - the drain's `! discharge` payload and auto-discharge compose there", .{ store_name, oi.module_slash, oi.type_name, ambig_module, ambig_type }) } };
                }
            }
        }
    }
    // The SINGLETON write plumbing carries ONE value type; a mixed-type
    // capacity-1 value is the per-field-event slice (690_020 tier 1
    // boundary). Containers carry per-field typed slots instead (690_049).
    if (!is_plural) {
        for (field_types[1..]) |ft| {
            if (!std.mem.eql(u8, ft, field_types[0])) {
                return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, "std/store:new({s}): mixed column types in one store are a later slice - all fields must share one scalar type for now", .{store_name}) } };
            }
        }
    }
    // Do the container's columns share one scalar type? The plural
    // `updated { old, new }` delta carries the written field's images in ONE
    // event (690_038), so its bind form needs a uniform column type this
    // rung; everything else is per-field typed and doesn't care.
    const types_uniform: bool = blk: {
        if (field_types.len == 0) break :blk true;
        for (field_types[1..]) |ft| {
            if (!std.mem.eql(u8, ft, field_types[0])) break :blk false;
        }
        break :blk true;
    };
    // value_type feeds the singleton (capacity-1) plumbing only.
    const value_type: []const u8 = if (cell_fields.len > 0 and !is_plural) field_types[0] else "i64";
    // ------------------------------------------------------------------
    // PLURAL STORE (rung two) — a separate coordinator path. Generates:
    //   1. The SoA cell: one column array per field + len.
    //   2. `__store_insert_<s>`  (void) and `__store_inserth_<s>`
    //      (`| row i64` handle branch) event+proc pairs. The proc appends
    //      the row, then fires standing query enters — but ONLY for query
    //      sites ABOVE the insert site in source (`__site_line` is a
    //      comptime-constant arg; the position check compiles away).
    //   3. Per query site (keyed by source line, so transform order can
    //      never skew numbering):
    //        `__store_qrow_<s>_L<n>`   — guard + projection over one row,
    //                                    calls the body event on match.
    //        `__store_qbody_<s>_L<n>`  — the transplanted body as an impl
    //                                    flow; projected names + __koru_qrow
    //                                    arrive as event inputs.
    //        `__store_qsweep_<s>_L<n>` — the imperative sweep over existing
    //                                    rows ((l) lean: the sweep IS the
    //                                    query's program-position firing).
    //   4. The row-addressed apply/write pair — same (f) centralizing
    //      subflow as rung one, plus `row`; watch bodies splice here, and
    //      UPDATE WHERE (`stored { entity.f: ... }` under a query branch)
    //      compiles into calls to it.
    //   5. `__store_take_<s>` — swap-remove through the handle head,
    //      returning `| item { fields }` (obligation wiring: 690_007).
    // ------------------------------------------------------------------
    if (is_plural) {
        // CAP is the declared capacity (parsed above — it IS the shape
        // selector). Fixed static memory with a LOUD overflow panic;
        // inserts that want graceful exhaustion handle `| full`.
        // ---- collect lifecycle interceptors (690_016, 690_038) ----
        // Ruling 5: stores emit inserted/removed/updated. The plural slice
        // wires `inserted` (fires in the insert write path), `removed`
        // (fires in take), and `updated` (fires in the row write path with
        // the written field's { old, new } images — the (c) usage-synthesis
        // lean, singleton grammar of 690_003). Each interceptor body is
        // transplanted as an impl flow — the qbody pattern — so its bindings
        // arrive as event inputs and a nested `stored { other.f: ... }`
        // resolves the sibling store's write. Field-named interceptors on
        // plural rows stay a later slice.
        const LifecycleArm = struct {
            fields: []const []const u8,
            // `[id]<name>` entries: what the SITE synthesizes rather than what
            // the row stores. Kept apart from `fields` because every column
            // path (colTypes/colOwned) resolves against `field_names` and a
            // request has no column to resolve to. Demand-driven, the same
            // rule the sweep and rule arms carry (690_246/690_247).
            id_requests: []const []const u8 = &.{},
            body: ast.Continuation,
        };
        var inserted_arms = std.ArrayList(LifecycleArm).initCapacity(allocator, 2) catch unreachable;
        var removed_arms = std.ArrayList(LifecycleArm).initCapacity(allocator, 2) catch unreachable;
        var updated_arms = std.ArrayList(LifecycleArm).initCapacity(allocator, 2) catch unreachable;
        var cleared_arms = std.ArrayList(LifecycleArm).initCapacity(allocator, 1) catch unreachable;
        // The drain handler (690_057): `! discharge item |> ...` on the store
        // declaration. Collected as a WHOLE continuation and re-attached to
        // the synthesized teardown flow (the 400_105 effect-branch shape) —
        // the handler binds the row record, whose ambiguous owned fields
        // carry `<state!>`, so the phantom checker forces the body to
        // discharge each element. Exactly one per store.
        var discharge_arm: ?ast.Continuation = null;
        // `! step`/`! wait` — the participant contract (the pump slice);
        // collection and emission live in PVerbs (store.pverbs.kz).
        var step_arm: ?ast.Continuation = null;
        var step_terminal_branches = std.ArrayList(ast.Branch).initCapacity(allocator, 2) catch unreachable;
        var wait_arm: ?ast.Continuation = null;
        for (flow.body.continuations) |*ic| {
            const bname = std.mem.trim(u8, ic.branch, " ");
            // Profiler taps splice void-branch continuations here — not store interceptors.
            if (bname.len == 0) continue;
            if (ic.condition != null) {
                return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, "std/store:new({s}): guarded interceptors are a later slice - interceptors are the store's unconditional contract", .{store_name}) } };
            }
            if (std.mem.eql(u8, bname, "discharge")) {
                if (!drain_required) {
                    return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, "std/store:new({s}): `! discharge` applies only to a store with a column the store cannot discharge unattended - every owned column here has one, so they auto-discharge at teardown and the arm would never fire", .{store_name}) } };
                }
                if (discharge_arm != null) {
                    return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, "std/store:new({s}): one `! discharge` handler per store - the teardown fires ONE handler per live element", .{store_name}) } };
                }
                // Arity picks the payload shape, so it picks the teaching too:
                // at ONE owned column the binding IS the value, and telling the
                // author to write `item.<field>` would send them at a record
                // that no longer exists.
                const disch_identity = field_names.len == 1 and field_owned_info[0] != null;
                if (ic.binding == null or ic.destructure.len != 0) {
                    if (disch_identity) {
                        return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, "std/store:new({s}): `! discharge` binds the column itself - spell it `! discharge item |> ...(<param>: item)`", .{store_name}) } };
                    }
                    return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, "std/store:new({s}): `! discharge` binds the whole row record - spell it `! discharge item |> ...(item.<field>)`", .{store_name}) } };
                }
                if (ic.node == null) {
                    if (disch_identity) {
                        return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, "std/store:new({s}): the `! discharge` handler needs a body that discharges the row's obligation (e.g. `! discharge item |> {s}:commit(tx: item)`)", .{ store_name, ambig_module }) } };
                    }
                    return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, "std/store:new({s}): the `! discharge` handler needs a body that discharges the row's obligations (e.g. `! discharge item |> {s}:commit(item.<field>)`)", .{ store_name, ambig_module }) } };
                }
                discharge_arm = ast_functional.cloneContinuation(allocator, ic) catch unreachable;
                continue;
            }
            // `! cleared` is `clear`'s arm the way `! removed` is `take`'s:
            // EACH REMOVAL VERB HAS ITS OWN ARM. That is what makes a bulk
            // removal expressible at all — a store emptied a thousand rows at
            // a time cannot hand an observer a thousand per-row events and
            // still be a bulk operation. It fires ONCE, AFTER the store is
            // empty, and binds how many rows went; there is nothing else it
            // could hand over, because by then no row is addressable.
            //
            // A store may declare both. `take` fires `removed`, `clear` fires
            // `cleared`, and neither fires the other's.
            if (std.mem.eql(u8, bname, "cleared")) {
                var cnames = std.ArrayList([]const u8).initCapacity(allocator, 1) catch unreachable;
                if (ic.destructure.len > 0) {
                    return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, "std/store:new({s}): `! cleared` binds the COUNT of rows removed, not a payload block - write `! cleared <name>` (or `! cleared _` to discard). Row fields ride `inserted`/`removed`; after a clear there is no row to read", .{store_name}) } };
                }
                if (ic.binding) |bn| {
                    if (!std.mem.eql(u8, bn, "_")) {
                        if (!Usage.inCont(ic, bn, program)) {
                            return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, "std/store:new({s}): `! cleared` binds '{s}' but never uses it — discard it (`! cleared _`) or use the count in the body", .{ store_name, bn }) } };
                        }
                        cnames.append(allocator, allocator.dupe(u8, bn) catch unreachable) catch unreachable;
                    }
                }
                cleared_arms.append(allocator, .{
                    .fields = cnames.toOwnedSlice(allocator) catch unreachable,
                    .body = ast_functional.cloneContinuation(allocator, ic) catch unreachable,
                }) catch unreachable;
                continue;
            }
            switch (PVerbs.collectArm(allocator, program, flow, reporter, store_name, field_names, field_owned_info, bname, ic, &step_arm, &step_terminal_branches, &wait_arm)) {
                .ok => continue,
                .refuse => |ritem| return .{ .transformed = .{ .replacement = ritem } },
                .not_mine => {},
            }
            const is_inserted = std.mem.eql(u8, bname, "inserted");
            const is_removed = std.mem.eql(u8, bname, "removed");
            const is_updated = std.mem.eql(u8, bname, "updated");
            if (!is_inserted and !is_removed and !is_updated) {
                return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, "std/store:new({s}): plural interceptor branch '{s}' - the lifecycle slice wires `inserted`, `removed`, `updated` and `cleared`; field interceptors on plural rows are a later slice", .{ store_name, bname }) } };
            }
            if (is_updated) {
                // `updated` carries the write contract — the written field's
                // { old, new } images ((c) usage-synthesis lean, mirroring the
                // singleton grammar of 690_003) — never row fields. The `_`
                // discard form is legal like the other lifecycle arms; a
                // discard arm synthesizes NO pre-image read (write-only path).
                const is_discard = ic.destructure.len == 0;
                if (!is_discard) {
                    var has_old = false;
                    var has_new = false;
                    for (ic.destructure) |df| {
                        if (std.mem.eql(u8, df.name, "old")) has_old = true;
                        if (std.mem.eql(u8, df.name, "new")) has_new = true;
                    }
                    if (!has_old or !has_new or ic.destructure.len != 2) {
                        return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, "std/store:new({s}): `! updated` binds the written field's images — destructure exactly {{ old, new }} (row fields ride `inserted`/`removed`)", .{store_name}) } };
                    }
                    if (!types_uniform) {
                        return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, "std/store:new({s}): `! updated {{ old, new }}` carries ONE written-field image type, but this store mixes column types - per-field updated deltas are a later rung; the discard form (`! updated _`) stays legal", .{store_name}) } };
                    }
                }
                const ubnode = ic.node orelse {
                    return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, "std/store:new({s}): the `! updated` interceptor needs a body (`|> std/store:stored {{ ... }}`)", .{store_name}) } };
                };
                if (ubnode != .invocation) {
                    return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, "std/store:new({s}): the `! updated` interceptor body must start with an invocation this rung", .{store_name}) } };
                }
                var unames = std.ArrayList([]const u8).initCapacity(allocator, 2) catch unreachable;
                if (!is_discard) {
                    unames.append(allocator, allocator.dupe(u8, "old") catch unreachable) catch unreachable;
                    unames.append(allocator, allocator.dupe(u8, "new") catch unreachable) catch unreachable;
                }
                updated_arms.append(allocator, .{
                    .fields = unames.toOwnedSlice(allocator) catch unreachable,
                    .body = ast_functional.cloneContinuation(allocator, ic) catch unreachable,
                }) catch unreachable;
                continue;
            }
            var dnames = std.ArrayList([]const u8).initCapacity(allocator, ic.destructure.len) catch unreachable;
            var dids = std.ArrayList([]const u8).initCapacity(allocator, 1) catch unreachable;
            for (ic.destructure) |df| {
                if (df.type_text != null) {
                    return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, "std/store:new({s}): `! {s}` projects row fields by pun (`{{ {s} }}`); renames are a later slice", .{ store_name, bname, df.name }) } };
                }
                // An ANNOTATED entry is a request on the site, never a column.
                // A lifecycle arm's block mixes the two — unlike a query/rule
                // block, which is requests only because its columns arrive
                // through the row binding. Here there is no row binding, so
                // the payload puns columns and requests ride alongside.
                if (df.annotations.len > 0) {
                    for (df.annotations) |a| {
                        if (std.mem.eql(u8, a, "id")) {
                            dids.append(allocator, allocator.dupe(u8, df.name) catch unreachable) catch unreachable;
                        } else if (std.mem.eql(u8, a, "row")) {
                            return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, "std/store:new({s}): `[row]{s}` on a `! {s}` arm - the arm already IS about one row and puns its columns by name (`! {s} {{ {s} }}`); binding the row to address OTHER columns is not built this rung. `[id]` is, and names this row's handle", .{ store_name, df.name, bname, bname, if (field_names.len > 0) field_names[0] else "field" }) } };
                        } else if (std.mem.eql(u8, a, "ordinal")) {
                            return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, "std/store:new({s}): `[ordinal]{s}` on a `! {s}` arm - a lifecycle arm fires on ONE row's birth or death and has no traversal, so there is no position in a walk to name (this is not unimplemented; it is meaningless here). `[ordinal]` is a sweep request: `! query {{ [row]r, [ordinal]n }}`", .{ store_name, df.name, bname }) } };
                        } else {
                            return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, "std/store:new({s}): unknown request `[{s}]` on '{s}' - a `! {s}` arm understands [id]", .{ store_name, a, df.name, bname }) } };
                        }
                    }
                    continue;
                }
                const known = blk: {
                    for (field_names) |fn3| {
                        if (std.mem.eql(u8, fn3, df.name)) break :blk true;
                    }
                    break :blk false;
                };
                if (!known) {
                    return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, "std/store:new({s}): `! {s}` payload field '{s}' is not a field of store '{s}' - the payload puns COLUMNS; to name what the site synthesizes, annotate it (`[id]{s}` is this row's handle)", .{ store_name, bname, df.name, store_name, df.name }) } };
                }
                dnames.append(allocator, allocator.dupe(u8, df.name) catch unreachable) catch unreachable;
            }
            // A request never takes the name of a COLUMN OF THIS STORE — not
            // just of a column this arm happens to bind. Against a bound one
            // it would mint two event inputs of one name and emit a duplicate
            // struct field rather than a diagnostic (the collision 690_247
            // refuses on a rule arm); against an unbound one it compiles and
            // silently reads as the column to anyone who knows the store. One
            // rule covers both, and the narrower rule would have admitted the
            // case that misleads without erroring.
            for (dids.items) |idn| {
                for (field_names) |cn| {
                    if (std.mem.eql(u8, idn, cn)) {
                        return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, "std/store:new({s}): `[id]{s}` takes the name of column '{s}' - the column and the row's handle are two values and need two names, and a reader cannot tell which '{s}' the body means", .{ store_name, idn, idn, idn }) } };
                    }
                }
            }
            const bnode = ic.node orelse {
                return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, "std/store:new({s}): the `! {s}` interceptor needs a body (`|> std/store:stored {{ ... }}`)", .{ store_name, bname }) } };
            };
            if (bnode != .invocation) {
                // A nested store-read site (query/rule/sweep) splices its loop
                // here as inline_code BEFORE create runs (depth-first runner) —
                // the interceptor body's real head is that loop, not an
                // authored invocation (690_093).
                if (bnode != .inline_code) {
                    return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, "std/store:new({s}): the `! {s}` interceptor body must start with an invocation this rung", .{ store_name, bname }) } };
                }
            }
            for (dnames.items) |fnm| {
                if (!Usage.inCont(ic, fnm, program)) {
                    return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, "std/store:new({s}): `! {s}` binds '{s}' but never uses it — discard the payload (`! {s} _`), or use the field in the body", .{ store_name, bname, fnm, bname }) } };
                }
            }
            // A request is demand-driven, so an unused one is a request that
            // should not have been made — the same standard the columns hold to.
            for (dids.items) |idn| {
                if (!Usage.inCont(ic, idn, program)) {
                    return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, "std/store:new({s}): `! {s}` requests `[id]{s}` but never uses it — a request is synthesized only where it is named, so drop it", .{ store_name, bname, idn }) } };
                }
            }
            const arm = LifecycleArm{
                .fields = dnames.toOwnedSlice(allocator) catch unreachable,
                .id_requests = dids.toOwnedSlice(allocator) catch unreachable,
                .body = ast_functional.cloneContinuation(allocator, ic) catch unreachable,
            };
            if (is_inserted) {
                inserted_arms.append(allocator, arm) catch unreachable;
            } else {
                removed_arms.append(allocator, arm) catch unreachable;
            }
        }
        // Drain ENFORCEMENT (690_058): an ambiguous owned column with no
        // `! discharge` handler would leave still-live elements undischarged
        // at teardown — a silent leak. Refusing the declaration here keeps the
        // store's units unsynthesized, so any insert's obligation leaks and
        // KORU030 fires too. This diagnostic goes through the reporter so it
        // is the one the author reads: it is spoken at the end of the
        // transform phase, and KORU030 belongs to an analysis pass that no
        // longer gets to run. The declaration is what is wrong; a store that
        // cannot say how it drains is not a fact about any call site.
        if (drain_required and discharge_arm == null) {
            // One requirement, two reasons — and the reason is the whole
            // difference between "your library is missing something" and "pick
            // one", so the sentence has to say which.
            // ONE diagnostic, not two (690_104). The abort node and the
            // sentence the author reads are the same refusal, so they are the
            // same call — and the sentence names the type the way the author
            // wrote it, composed with the state a discharger would consume
            // (690_105: `*mod:Type<!state>`), not the two halves apart.
            if (ambig_count == 0) {
                return .{ .transformed = .{ .replacement = ast.refusalWithHint(
                    allocator,
                    reporter,
                    .KORU160,
                    flow.location,
                    flow.module,
                    "std/store:new({s}): no tor accepts *{s}:{s}<!{s}>, so the column cannot be auto-discharged — every exit from <{s}!> in {s} returns a value or carries branches",
                    .{ store_name, ambig_module, ambig_type, ambig_state, ambig_state, ambig_module },
                    "a store disposes elements unattended at teardown, where there is nobody to take a return value or answer a branch — so drain it by hand: bolt `! discharge item |> {s}:<exit>(item.<field>)` onto the declaration. The arm is ordinary Koru, so pipe whatever sequence the type needs and its own obligations settle normally",
                    .{ambig_module},
                ) } };
            }
            return .{ .transformed = .{ .replacement = ast.refusalWithHint(
                allocator,
                reporter,
                .KORU160,
                flow.location,
                flow.module,
                "std/store:new({s}): column *{s}:{s}<!{s}> has {d} ways to discharge and the store cannot pick one for you",
                .{ store_name, ambig_module, ambig_type, ambig_state, ambig_count },
                "say which at the store, where it is static for the program's lifetime: bolt `! discharge item |> {s}:<discharger>(item.<field>)` onto the declaration and teardown fires it per still-live element",
                .{ambig_module},
            ) } };
        }
        // ---- collect this store's watch arms (field-granular, plural) ----
        const WatchArmP = struct {
            field_idx: usize,
            cont: ast.Continuation,
        };
        var pwatch_arms = std.ArrayList(WatchArmP).initCapacity(allocator, 4) catch unreachable;
        for (flatItems(allocator, program.items)) |pi| {
            if (pi.* != .flow) continue;
            const wf = &pi.flow;
            if (!H.isStoreInv(wf, "watch", store_name)) continue;
            for (wf.body.continuations) |*wc| {
                const fidx: usize = blk: {
                    for (field_names, 0..) |fname, i| {
                        if (std.mem.eql(u8, std.mem.trim(u8, wc.branch, " "), fname)) break :blk i;
                    }
                    // A ONE-column store's column has exactly one name: the
                    // store's. `watch`'s arm names the thing being watched, and
                    // it names a COLUMN only because a multi-column store makes
                    // the author choose. With nothing to choose, the name
                    // collapses to the store's — the same rule the declaration,
                    // `stored` and the row bindings already carry.
                    if (ast.watchesIdentityColumn(field_names, wc.branch, store_name)) break :blk 0;
                    if (field_names.len == 1 and std.mem.eql(u8, field_names[0], ast.STORE_IDENTITY_COLUMN)) {
                        return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, wf.location, wf.module, "std/store:watch({s}): '{s}' names no column - a one-column store names none, so its watch arm is the store: `! {s} <binding> |> ...`", .{ store_name, wc.branch, store_name }) } };
                    }
                    return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, wf.location, wf.module, "std/store:watch({s}): '{s}' is not a field of store '{s}'", .{ store_name, wc.branch, store_name }) } };
                };
                for (pwatch_arms.items) |existing| {
                    if (existing.field_idx == fidx) {
                        return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, wf.location, wf.module, "std/store:watch({s}): field '{s}' is watched more than once - multi-watch sequencing is pinned at 690_010", .{ store_name, wc.branch }) } };
                    }
                }
                // A `when` guard fuses into the write path as an arm condition
                // (producer owns the `if`) — the cloned continuation carries it
                // through to the apply/write flow's arm, and storeRefsContH
                // rewrites any cross-store guard reads to the cells (690_030,
                // the plural mirror of the singleton guarded reactive 690_026).
                const cloned = ast_functional.cloneContinuation(allocator, wc) catch unreachable;
                pwatch_arms.append(allocator, .{ .field_idx = fidx, .cont = cloned }) catch unreachable;
            }
        }
        // ---- collect this store's query sites (keyed by source line) ----
        const QuerySite = struct {
            line: usize, file: []const u8, // site file — units mint into the STORE's scope, so store+line alone is not unique across modules (690_306)
            // projection: parallel arrays — bound name / store field index
            proj_names: [][]const u8,
            proj_fields: []usize,
            /// The name the arm bound its row to. Every reference in the body
            /// goes through it — `! query r |> … r.hp …` — the same shape sweep
            /// took when its projection block was retired (690_089).
            row_bind: []const u8,
            guard: ?[]const u8,
            body: ast.Continuation,
            // [name(x)] / [depends_on(a, b)] on the attach flow — the stripe
            // scheduler's vocabulary. Names are module-namespaced (bare binds
            // in the declaring module; cross-module references qualify as
            // mod:name — the phantom-state mirror, 330_087/088).
            rule_name: ?[]const u8,
            deps: [][]const u8,
            rule_module: []const u8,
            // `preorder` sites ride the same qrow/qbody machinery as `query`
            // (695_STORE_TREE TT5); only the sweep differs — a DFS pre-order
            // walk over the synthesized parent column instead of the linear
            // row scan. Preorder is a program-position walk: it takes no
            // standing insert subscription and joins no stripe.
            is_preorder: bool,
            // Does this rule's body REMOVE rows? Only a `take` on this store
            // can, and only then does the pass need the row-removal-tolerant
            // `while` form (690_031: swap-remove drops the last row into the
            // freed slot, so a shrinking len must re-check the SAME index).
            // The tolerant form's conditional increment is a loop-carried
            // dependency on a LOAD of `len`, which costs the pass its
            // vectorisation — measured at 1.45x on a 10k-row rule. Rules that
            // cannot remove get the same `for (0..len)` the query path uses.
            // Detection is deliberately CONSERVATIVE: any mention of take
            // anywhere under the arm keeps the tolerant form.
            may_remove: bool,
            drain: bool = false,
            /// The row cursor's emitted NAME and what it holds. Decided by the
            /// body walk (`may_remove` picks it) and read back by the qrow /
            /// qbody emission, so the three sites cannot disagree about
            /// whether the pass is carrying a dense index or a handle.
            cursor: []const u8 = "__koru_qrow",
            cursor_dense: bool = false,
            /// `[id]` on the arm's request block — the name the body gave the
            /// row's HANDLE. Null when unrequested, and an unrequested member
            /// threads nothing and costs nothing (the synthesized-only-when-
            /// named clause). Admissible here by the gate's clause 1 because it
            /// says SITE, not VISIT: a rule has a row and no traversal, so a
            /// handle is exactly as meaningful here as on a sweep while
            /// `[ordinal]` is meaningless and refused by name.
            req_id: ?[]const u8 = null,
        };
        const program_items = flatItems(allocator, program.items);
        var qsites = std.ArrayList(QuerySite).initCapacity(allocator, 4) catch unreachable;
        for (flatItems(allocator, program.items)) |pi| {
            if (pi.* != .flow) continue;
            const qf = &pi.flow;
            const q_verb: []const u8 = if (H.isStoreInv(qf, "rule", store_name))
                "rule"
            else if (H.isStoreInv(qf, "preorder", store_name))
                "preorder"
            else
                continue;
            const q_is_preorder = std.mem.eql(u8, q_verb, "preorder");
            // The arm names what the body RECEIVES, and a rule's body receives a
            // row: `rule(s) ! row e`. `preorder` still echoes its verb because
            // there the arm names the WALK rather than the payload. So arm and
            // verb are no longer the same string by construction.
            const q_arm: []const u8 = if (q_is_preorder) "preorder" else "row";
            if (q_is_preorder and !is_tree) {
                return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, qf.location, qf.module, "std/store:preorder({s}): preorder needs a [tree] store - '{s}' has no synthesized parent column (declare it as [tree]std/store:new({s}) {{ ... }})", .{ store_name, store_name, store_name }) } };
            }
            const qc = TapPeel.findArm(qf.body.continuations, q_arm) orelse {
                return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, qf.location, qf.module, "std/store:{s}({s}): exactly one `! {s} {{ ... }}` branch per site this rung", .{ q_verb, store_name, q_arm }) } };
            };
            // The row branch is an EFFECT arm the site FIRES (`! query`), not an
            // outcome it returns — the continuation marker must be `!`, never `|`.
            // A `|` here is the marker/kind mismatch (400_172): today it is
            // silently accepted and runs benignly, so reject it at koru's own
            // boundary. (The take/insert OUTCOME direction is caught by KORU025 in
            // the phantom checker; query installs a standing rule and never mints a
            // matchable outcome event, so its marker is validated here.)
            if (qc.kind != .effect) {
                return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, qf.location, qf.module, "std/store:{s}({s}): continuation marker `|` used where an effect branch is required — `{s}` fires the effect arm `! {s}`, not `| {s}`", .{ q_verb, store_name, q_verb, q_arm, q_arm }) } };
            }
            // A destructure block on a rule/preorder arm is a REQUEST, exactly
            // as it is on `! query` (the parse at the query transform is the
            // mirror of this one). RULED 2026-08-03. Before this, ANY
            // destructure here was refused as "the retired projection block" —
            // a wrong error on a legal construct, and the review that caught it
            // named the cost: a reactive chain update is the same workload that
            // earned `[id]` on sweep in the first place.
            //
            //     std/store:rule(s) ! row { [row]e, [id]h } |> …
            //
            // `! row e` stays the shorthand for `! row { [row]e }`.
            //
            // The gate's clause 1 says SITE, not VISIT, and this site is why: a
            // rule has a ROW and no TRAVERSAL. `[id]` is admissible because a
            // handle does not depend on traversal; `[ordinal]` is genuinely
            // meaningless and is refused BY NAME with its own reason, so that
            // "meaningless here" never reads as "unimplemented here".
            var q_req_row: ?[]const u8 = null;
            var q_req_id: ?[]const u8 = null;
            for (qc.destructure) |df| {
                if (df.annotations.len == 0) {
                    return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, qf.location, qf.module, "std/store:{s}({s}): '{s}' is an unannotated entry - the {s} arm binds its row (`! {s} <row> |> ... <row>.<field> ...`); a request block names what the SITE synthesizes (`[row]`, `[id]`), never columns (the retired projection block is 690_089)", .{ q_verb, store_name, df.name, q_arm, q_arm }) } };
                }
                for (df.annotations) |a| {
                    if (std.mem.eql(u8, a, "row")) {
                        q_req_row = df.name;
                    } else if (std.mem.eql(u8, a, "id")) {
                        q_req_id = df.name;
                    } else if (std.mem.eql(u8, a, "ordinal")) {
                        return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, qf.location, qf.module, "std/store:{s}({s}): `[ordinal]` on '{s}' - a {s} arm has a row and no traversal, so there is no position in a walk to name (this is not unimplemented; it is meaningless here). `[ordinal]` is a sweep request: `! query {{ [row]r, [ordinal]n }}`", .{ q_verb, store_name, df.name, q_verb }) } };
                    } else {
                        return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, qf.location, qf.module, "std/store:{s}({s}): unknown request `[{s}]` on '{s}' - a {s} arm understands [row] and [id]", .{ q_verb, store_name, a, df.name, q_verb }) } };
                    }
                }
            }
            if (qc.destructure.len > 0 and q_req_row == null) {
                return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, qf.location, qf.module, "std/store:{s}({s}): a request block must name the row - add `[row]<name>`", .{ q_verb, store_name }) } };
            }
            const q_row_bind = q_req_row orelse qc.binding orelse {
                return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, qf.location, qf.module, "std/store:{s}({s}): the {s} arm needs a row binding: `! {s} <row> |> ...`", .{ q_verb, store_name, q_arm, q_arm }) } };
            };
            // A request name that shadows the row binding would mint two event
            // inputs of the same name and emit a duplicate struct field rather
            // than a diagnostic. Refuse it here where the names are both known.
            if (q_req_id) |idn| {
                if (std.mem.eql(u8, std.mem.trim(u8, idn, " "), std.mem.trim(u8, q_row_bind, " "))) {
                    return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, qf.location, qf.module, "std/store:{s}({s}): `[id]{s}` reuses the row's own name - the row and its handle are two values and need two names", .{ q_verb, store_name, idn }) } };
                }
            }
            // The projection is DERIVED from the body, not listed here. Every
            // reference to a column goes through the binding — `<row>.<field>`
            // — so the rewrite below is the only thing that knows which
            // columns this arm actually names, and it is what fills the
            // projection (the same derivation the read path has had since
            // 690_089). Projecting every user column unconditionally cost
            // 3.91x on a 10k-row nine-column rule: each unused column is a
            // load, a stack slot and an event input per row, paid whether the
            // body names it or not. Under-projecting fails LOUDLY as an
            // unknown identifier in emitted Zig, which is the safe direction.
            const peel_src = TapPeel.peel(qc) orelse qc;
            const body_clone = ast_functional.cloneContinuation(allocator, peel_src) catch unreachable;
            // [name]/[depends_on] off the attach flow (bare idents canonical).
            const ann_parser = @import("annotation_parser");
            var q_rule_name: ?[]const u8 = null;
            if (ann_parser.getCall(allocator, qf.annotations, "name") catch null) |nc| {
                if (nc.args.len != 1) {
                    return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, qf.location, qf.module, "std/store:rule({s}): [name(...)] takes exactly one identifier — [name(movement)]", .{store_name}) } };
                }
                q_rule_name = allocator.dupe(u8, nc.args[0]) catch unreachable;
            }
            var q_deps = std.ArrayList([]const u8).initCapacity(allocator, 2) catch unreachable;
            if (ann_parser.getCall(allocator, qf.annotations, "depends_on") catch null) |dc| {
                for (dc.args) |da| q_deps.append(allocator, allocator.dupe(u8, da) catch unreachable) catch unreachable;
            }
            // Per-arm answer (690_301): a take reachable from THIS arm's body —
            // spelled inline, or inside a subflow impl it invokes. An
            // unreachable take in a sibling flow no longer forces the
            // removal-tolerant `while`. Conservative on failure.
            const q_may_remove = ast_functional.armReachesInvocation(allocator, program_items, &body_clone, store_name, TakeScan.isTakeOn) catch true;
            // A rule whose whole row body is `take(s[e])` with the payload
            // discarded drains the store — the invoked sweep lowers to take's
            // bookkeeping alone (store.drain). Everything else keeps may_remove.
            const q_drain = q_may_remove and !q_is_preorder and qc.condition == null and q_req_id == null
                and !has_owned and removed_arms.items.len == 0
                and DrainScan.isBody(store_name, &body_clone, std.mem.trim(u8, q_row_bind, " "));
            qsites.append(allocator, .{
                .line = qf.location.line, .file = allocator.dupe(u8, qf.location.file) catch unreachable,
                // Filled by the body walk below.
                .proj_names = &[_][]const u8{},
                .proj_fields = &[_]usize{},
                .row_bind = allocator.dupe(u8, std.mem.trim(u8, q_row_bind, " ")) catch unreachable,
                .guard = if (qc.condition) |c| allocator.dupe(u8, c) catch unreachable else null,
                .body = body_clone,
                .rule_name = q_rule_name,
                .deps = q_deps.toOwnedSlice(allocator) catch unreachable,
                .rule_module = allocator.dupe(u8, qf.module) catch unreachable,
                .is_preorder = q_is_preorder,
                .may_remove = q_may_remove,
                .drain = q_drain,
                .req_id = if (q_req_id) |idn| allocator.dupe(u8, std.mem.trim(u8, idn, " ")) catch unreachable else null,
            }) catch unreachable;
        }
        // The proc-local lists reduce to two bools here; the decision itself
        // (semantic overrides + the whole-program walk) is Gate.needsHandles.
        var lifecycle_id = false;
        for (inserted_arms.items) |arm| {
            if (arm.id_requests.len > 0) lifecycle_id = true;
        }
        for (removed_arms.items) |arm| {
            if (arm.id_requests.len > 0) lifecycle_id = true;
        }
        var rule_needs = false;
        for (qsites.items) |qs| {
            if (qs.req_id != null or qs.may_remove) rule_needs = true;
        }
        var gate_items = std.ArrayList(*const ast.Item){};
        H.visibleStoreItems(allocator, program.items, store_scope_home, &gate_items);
        const needs_handles = Gate.needsHandles(allocator, program, gate_items.items, store_name, field_names, is_tree, step_arm != null, lifecycle_id, rule_needs);
        // Bulk append — a counted `for` whose body is a single insert
        // into this store lowers to a hoisted capacity check, indexed
        // column writes at `base + j`, and one `len += n` (the per-row
        // `len += 1` is a loop-carried store nothing can reassociate
        // past the per-row capacity @panic — measured ~3.3x on the
        // add_remove fill). Handles keep the tier — the batch mints
        // the identical slot sequence (freelist pops LIFO, then bump),
        // so refilled handles are indistinguishable. What still
        // declines is what a batch cannot reproduce per row: lifecycle
        // arms, watches, facets, kinds, owned or fixed-char columns,
        // trees, `! step` — and any insert site below a standing
        // qsite's declared line (`match` applies the emitter's own
        // `__site_line > qs.line` comparison). Index columns do not
        // disqualify — the bulk loop maintains the bucket map per row.
        // Zig only (store.bulk.kz).
        var reactive_min: ?usize = null;
        for (qsites.items) |qs| {
            if (qs.is_preorder) continue;
            if (reactive_min == null or qs.line < reactive_min.?) reactive_min = qs.line;
        }
        const bulk_idecls = StoreIndexDecls.declsOf(allocator, program, store_name);
        const bulkable = !host_is_js and !is_tree and step_arm == null and
            inserted_arms.items.len == 0 and removed_arms.items.len == 0 and
            updated_arms.items.len == 0 and cleared_arms.items.len == 0 and
            pwatch_arms.items.len == 0 and discharge_arm == null and
            !want_kind and
            !Bulk.hasFacets(allocator, program, leaf_provs.items) and
            blk_lean_cols: {
                var bad = false;
                for (field_owned) |fo| {
                    if (fo) bad = true;
                }
                for (field_char_caps) |fc| {
                    if (fc != null) bad = true;
                }
                break :blk_lean_cols !bad;
            };
        if (bulkable) _ = Bulk.rewrite(allocator, program, program_items, store_name, CAP, needs_handles, reactive_min,
            if (bulk_idecls.len > 0) bulk_idecls[0].column else null);
        // Topological order over the declared DAG; rules with no edges keep
        // collection order RELATIVE TO EACH OTHER but that order is
        // contractually UNSPECIFIED (the fusion license). Cycle = comptime
        // error naming the members (690_012 mirror). Resolution follows the
        // phantom-state namespacing: bare = same module, mod:name across,
        // bare-outside = teaching error (330_087/088 mirror).
        var stripe_order = std.ArrayList(usize).initCapacity(allocator, qsites.items.len) catch unreachable;
        {
            // Duplicate [name] within one module is ambiguous — reject.
            for (qsites.items, 0..) |qa, ia| {
                const na = qa.rule_name orelse continue;
                for (qsites.items[ia + 1 ..]) |qb| {
                    const nb = qb.rule_name orelse continue;
                    if (std.mem.eql(u8, na, nb) and std.mem.eql(u8, qa.rule_module, qb.rule_module)) {
                        return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, "std/store:rule({s}): two rules named [name({s})] in module '{s}' — rule names are unique per module", .{ store_name, na, qa.rule_module }) } };
                    }
                }
            }
            // Resolve dep edges: edges[i] = indices i depends on.
            var edges = std.ArrayList([]usize).initCapacity(allocator, qsites.items.len) catch unreachable;
            for (qsites.items) |qs2| {
                var row_edges = std.ArrayList(usize).initCapacity(allocator, qs2.deps.len) catch unreachable;
                for (qs2.deps) |dep| {
                    var dep_mod: ?[]const u8 = null;
                    var dep_name: []const u8 = dep;
                    if (std.mem.lastIndexOfScalar(u8, dep, ':')) |ci| {
                        dep_mod = dep[0..ci];
                        dep_name = dep[ci + 1 ..];
                    }
                    var found: ?usize = null;
                    var foreign_hit: ?[]const u8 = null;
                    for (qsites.items, 0..) |cand, ci2| {
                        const cn = cand.rule_name orelse continue;
                        if (!std.mem.eql(u8, cn, dep_name)) continue;
                        if (dep_mod) |dm| {
                            if (std.mem.eql(u8, cand.rule_module, dm)) found = ci2;
                        } else if (std.mem.eql(u8, cand.rule_module, qs2.rule_module)) {
                            found = ci2;
                        } else {
                            foreign_hit = cand.rule_module;
                        }
                    }
                    if (found == null) {
                        if (foreign_hit) |fm| {
                            return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, "std/store:rule({s}): depends_on({s}) — bare rule names resolve in the declaring module only; rule '{s}' lives in module '{s}', write depends_on({s}:{s})", .{ store_name, dep, dep_name, fm, fm, dep_name }) } };
                        }
                        return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, "std/store:rule({s}): depends_on({s}) — no rule named [name({s})] on this store in module '{s}'", .{ store_name, dep, dep_name, qs2.rule_module }) } };
                    }
                    row_edges.append(allocator, found.?) catch unreachable;
                }
                edges.append(allocator, row_edges.toOwnedSlice(allocator) catch unreachable) catch unreachable;
            }
            // Kahn: stable — ready nodes fire in collection order.
            const n = qsites.items.len;
            const indeg = allocator.alloc(usize, n) catch unreachable;
            @memset(indeg, 0);
            for (0..n) |i| indeg[i] = edges.items[i].len;
            const done_mark = allocator.alloc(bool, n) catch unreachable;
            @memset(done_mark, false);
            var emitted: usize = 0;
            while (emitted < n) {
                var progressed = false;
                for (0..n) |i| {
                    if (done_mark[i] or indeg[i] != 0) continue;
                    stripe_order.append(allocator, i) catch unreachable;
                    done_mark[i] = true;
                    emitted += 1;
                    progressed = true;
                    // lower indegree of nodes that depend on i
                    for (0..n) |j| {
                        if (done_mark[j]) continue;
                        for (edges.items[j]) |e| {
                            if (e == i) indeg[j] -= 1;
                        }
                    }
                }
                if (!progressed) {
                    var cyc = std.ArrayList(u8).initCapacity(allocator, 64) catch unreachable;
                    for (0..n) |i| {
                        if (done_mark[i]) continue;
                        if (qsites.items[i].rule_name) |rn| {
                            if (cyc.items.len > 0) cyc.appendSlice(allocator, ", ") catch unreachable;
                            cyc.appendSlice(allocator, rn) catch unreachable;
                        }
                    }
                    return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, "std/store:rule({s}): depends_on cycle among rules: {s}", .{ store_name, cyc.items }) } };
                }
            }
        }
        // ---- rewrite transplanted bodies ----
        // Query bodies execute inside the qbody handler where the projected
        // names and `__koru_qrow` are event inputs. `entity.<f>` references:
        //   - in a nested `std/store:stored` block: the TARGET rewrites to
        //     the indexed lvalue head (`<store>[__koru_qrow].<f>` — O2
        //     query-row head), the VALUE side to a direct fresh column read.
        //   - anywhere else: direct fresh column read.
        const PRewrite = struct {
            // An OWNED column's value is a pointer that carries a phantom
            // (`*String<std.string:instance>`), and the phantom only travels
            // through the qbody's projected input — a raw cell read has none,
            // and the checker refuses it (690_238). The input is MANGLED so a
            // body binding of the field's own name cannot claim it (the same
            // reservation the read path's srf_* names make).
            fn projName(alloc: std.mem.Allocator, field: []const u8) []const u8 {
                const mangled = std.mem.replaceOwned(u8, alloc, field, ".", "_") catch unreachable;
                return std.fmt.allocPrint(alloc, "__koru_qproj_{s}", .{mangled}) catch unreachable;
            }
            // `cur` is the row cursor's NAME and `dense` says what it holds.
            //
            // A rule whose program can never remove a row gets the DENSE loop
            // index, the same cursor the query path has carried since the
            // O10.iv elision, and it is spelled `__koru_sdix_*` so the write
            // family passes it through untouched (store.kz:5698 keys on that
            // prefix). Otherwise the cursor is a generational HANDLE and every
            // access resolves it: `handle -> hslot_gen -> hslot_row -> column`
            // is a four-deep chain of dependent loads behind four panic
            // branches, in the hottest loop the language has, and no part of
            // it can be vectorised or hoisted because each address depends on
            // the previous load.
            //
            // The elision is safe rather than merely fast because the surface
            // no longer admits a raw row index anywhere: `store[cell]` names a
            // row by handle, so a dense cursor is INTERNAL to this lowering
            // and there is nothing user-written for it to leak into. Reserving
            // brand 0 (690_242) is the second half — a dense index in a handle
            // position now traps instead of addressing an unrelated slot.
            fn colRead(alloc: std.mem.Allocator, store: []const u8, field: []const u8, is_char: bool, cur: []const u8, dense: bool) []const u8 {
                // The column is named through a POINTER (`&`) before the index:
                // a by-value base would force Zig to materialise the whole
                // column ahead of a call-valued index
                // (frag-a-call-valued-index-copies-the-whole-array); an 8-byte
                // pointer base costs nothing and stays a plain expression, so
                // it survives the `{{ ... }}` interpolation contexts a hoisted
                // const block cannot.
                const idx = if (dense)
                    std.fmt.allocPrint(alloc, "@as(usize, @intCast({s}))", .{cur}) catch unreachable
                else
                    std.fmt.allocPrint(alloc, "__koru_store_{s}.__koru_resolve({s})", .{ store, cur }) catch unreachable;
                const esc_field = codegen_utils_store.escapeZigIdentifier(alloc, field) catch field;
                // A char column reads as the string slice up to the first NUL
                // (the same shape the qrow projection binds); scalars read
                // their cell slot directly. On the JS target the char cell IS
                // a string (seeded "", written by truncation at insert), so
                // the read is the plain column read — `@import(...)` has no JS
                // lowering and must never reach that emitter.
                if (is_char) {
                    if (std.mem.eql(u8, CompilerEnv.lang, "js")) {
                        return std.fmt.allocPrint(alloc, "(&__koru_store_{s}.{s})[{s}]", .{ store, esc_field, idx }) catch unreachable;
                    }
                    return std.fmt.allocPrint(alloc, "@import(\"std\").mem.sliceTo(&(&__koru_store_{s}.{s})[{s}], 0)", .{ store, esc_field, idx }) catch unreachable;
                }
                return std.fmt.allocPrint(alloc, "(&__koru_store_{s}.{s})[{s}]", .{ store, esc_field, idx }) catch unreachable;
            }
            fn entityRefs(alloc: std.mem.Allocator, text: []const u8, store: []const u8, fields: []const []const u8, char_caps: []const ?usize, owned: []const bool, target_form: bool, use_owned_param: bool, bind: []const u8, used: []bool, cur: []const u8, dense: bool) []const u8 {
                const prefix = std.fmt.allocPrint(alloc, "{s}.", .{bind}) catch unreachable;
                const expr_ctx = ast.expressionMask(alloc, text);
                var out = std.ArrayList(u8).initCapacity(alloc, text.len + 32) catch unreachable;
                var i: usize = 0;
                while (i < text.len) {
                    const at_boundary = ast.identBoundaryBefore(text, i);
                    // `expr_ctx[i]` is what keeps this OUT OF STRING LITERALS.
                    // The mask was computed here from the start and consulted
                    // only by the bare-identity branch below, so a bare `e` was
                    // safe while `e.<column>` — the common case — rewrote
                    // wherever it appeared, text included. A rule arm storing
                    // the literal "e.label is a column" shipped a Zig cell read
                    // in its place: compiled, ran, wrong, silent on the JS lane
                    // and an unreadable Zig error on the other. Same disease as
                    // the visitor emitter's literal corruption (230_016), a
                    // different site, and the reason both are worth a mask
                    // rather than a special case.
                    if (at_boundary and expr_ctx[i] and std.mem.startsWith(u8, text[i..], prefix)) {
                        const fstart = i + prefix.len;
                        const rest = text[fstart..];
                        var best_fi: ?usize = null;
                        var best_len: usize = 0;
                        for (fields, 0..) |f, kfi| {
                            if (std.mem.startsWith(u8, rest, f)) {
                                const after_char_idx = fstart + f.len;
                                const boundary_ok = after_char_idx >= text.len or !H.isIdentChar(text[after_char_idx]);
                                if (boundary_ok and f.len > best_len) {
                                    best_fi = kfi;
                                    best_len = f.len;
                                }
                            }
                        }
                        if (best_fi) |kidx| {
                            const fname = fields[kidx];
                            const fend = fstart + best_len;
                            if (target_form) {
                                const esc_fname = codegen_utils_store.escapeZigIdentifier(alloc, fname) catch fname;
                                const t = std.fmt.allocPrint(alloc, "{s}[{s}].{s}", .{ store, cur, esc_fname }) catch unreachable;
                                out.appendSlice(alloc, t) catch unreachable;
                            } else if (use_owned_param and owned[kidx]) {
                                // The ONLY body reference that needs a
                                // projection: an owned column travels as the
                                // phantom-carrying input, never as a raw cell
                                // read (690_238). A scalar takes the column
                                // read below and costs the row nothing.
                                used[kidx] = true;
                                out.appendSlice(alloc, projName(alloc, fname)) catch unreachable;
                            } else {
                                out.appendSlice(alloc, colRead(alloc, store, fname, char_caps[kidx] != null, cur, dense)) catch unreachable;
                            }
                            i = fend;
                            continue;
                        }
                    }
                    // A BARE binding (not `<row>.field`, not `<row>Xyz`) is the
                    // query's row cursor itself — e.g. `take(store[r])` addresses
                    // the currently-swept row. Rewrite it to the qbody's
                    // row-cursor input so take/stored heads resolve it (690_031).
                    //
                    // EXCEPT on a one-column store, where the row IS its value and
                    // a bare binding reads the column — the same call sweep makes.
                    // The two readings genuinely collide there: `store[r]` wants
                    // the cursor and `{{ r:d }}` wants the value. Value wins, so
                    // row-addressing a one-column store has no spelling yet.
                    if (at_boundary and std.mem.startsWith(u8, text[i..], bind)) {
                        const after = i + bind.len;
                        const next_is_ident = after < text.len and H.isIdentChar(text[after]);
                        const next_is_dot = after < text.len and text[after] == '.';
                        if (!next_is_ident and !next_is_dot) {
                            if (fields.len == 1 and std.mem.eql(u8, fields[0], ast.STORE_IDENTITY_COLUMN) and expr_ctx[i]) {
                                if (target_form) {
                                    const t = std.fmt.allocPrint(alloc, "{s}[{s}].{s}", .{ store, cur, fields[0] }) catch unreachable;
                                    out.appendSlice(alloc, t) catch unreachable;
                                } else if (use_owned_param and owned[0]) {
                                    used[0] = true;
                                    out.appendSlice(alloc, projName(alloc, fields[0])) catch unreachable;
                                } else {
                                    out.appendSlice(alloc, colRead(alloc, store, fields[0], char_caps[0] != null, cur, dense)) catch unreachable;
                                }
                            } else {
                                out.appendSlice(alloc, cur) catch unreachable;
                            }
                            i = after;
                            continue;
                        }
                    }
                    out.append(alloc, text[i]) catch unreachable;
                    i += 1;
                }
                return out.toOwnedSlice(alloc) catch unreachable;
            }
            /// Split an already-rewritten template into a host format string and
            /// its argument list. By the time a stored value reaches here the
            /// `{{ … }}` holes hold HOST code — the row rewrite treats a hole as
            /// expression context, which is why `print.ln("{{ e.v:d }}")` has
            /// always worked — so this only has to separate the literal text
            /// from the holes and carry each hole's format specifier across.
            ///
            /// Returns null when the text holds no hole, which is the ordinary
            /// case: a plain literal is written as-is.
            const Rendered = struct { fmt: []const u8, args: []const u8 };
            fn renderTemplate(alloc: std.mem.Allocator, text: []const u8, host_js: bool) ?Rendered {
                if (std.mem.indexOf(u8, text, "{{") == null) return null;
                // The surrounding quotes are part of the literal's text.
                var body = text;
                if (body.len >= 2 and body[0] == '"' and body[body.len - 1] == '"') body = body[1 .. body.len - 1];
                var fmt = std.ArrayList(u8).initCapacity(alloc, body.len + 16) catch unreachable;
                var args = std.ArrayList(u8).initCapacity(alloc, 64) catch unreachable;
                var n_args: usize = 0;
                var i: usize = 0;
                while (i < body.len) {
                    if (i + 1 < body.len and body[i] == '{' and body[i + 1] == '{') {
                        const close = std.mem.indexOfPos(u8, body, i + 2, "}}") orelse break;
                        const hole = std.mem.trim(u8, body[i + 2 .. close], " \t");
                        // The specifier is the LAST colon outside any bracket —
                        // a hole's expression may itself contain colons (a
                        // module-qualified call, an indexed cell read).
                        var spec: []const u8 = "any";
                        var expr = hole;
                        var depth: i32 = 0;
                        var k: usize = hole.len;
                        while (k > 0) {
                            k -= 1;
                            const c = hole[k];
                            if (c == ')' or c == ']') depth += 1;
                            if (c == '(' or c == '[') depth -= 1;
                            if (c == ':' and depth == 0) {
                                spec = hole[k + 1 ..];
                                expr = hole[0..k];
                                break;
                            }
                        }
                        if (host_js) {
                            fmt.appendSlice(alloc, "\" + (") catch unreachable;
                            fmt.appendSlice(alloc, expr) catch unreachable;
                            fmt.appendSlice(alloc, ") + \"") catch unreachable;
                        } else {
                            fmt.append(alloc, '{') catch unreachable;
                            // `:f` is Koru's spelling for "a float, rendered
                            // plainly"; Zig spells that as no specifier at all.
                            if (!std.mem.eql(u8, spec, "f")) fmt.appendSlice(alloc, spec) catch unreachable;
                            fmt.append(alloc, '}') catch unreachable;
                            if (n_args > 0) args.appendSlice(alloc, ", ") catch unreachable;
                            // A char column reads as a fixed array; `{s}` needs
                            // the NUL-trimmed slice, which is what the read path
                            // hands every other consumer.
                            args.appendSlice(alloc, expr) catch unreachable;
                        }
                        n_args += 1;
                        i = close + 2;
                        continue;
                    }
                    fmt.append(alloc, body[i]) catch unreachable;
                    i += 1;
                }
                return .{ .fmt = fmt.toOwnedSlice(alloc) catch unreachable, .args = args.toOwnedSlice(alloc) catch unreachable };
            }
            // A stored block is `target: value` pairs — target keys keep the
            // indexed-lvalue form, values read columns directly. Values never
            // take the owned projection: the write path reads the cell at write
            // time (690_083), same as the read path's .live form.
            fn storedBlock(alloc: std.mem.Allocator, text: []const u8, store: []const u8, fields: []const []const u8, char_caps: []const ?usize, owned: []const bool, bind: []const u8, used: []bool, cur: []const u8, dense: bool) []const u8 {
                const braced2 = std.fmt.allocPrint(alloc, "{{{s}}}", .{text}) catch unreachable;
                const struct_literal2 = @import("struct_literal");
                const pairs = struct_literal2.parseFields(alloc, braced2) catch return text;
                var out = std.ArrayList(u8).initCapacity(alloc, text.len + 64) catch unreachable;
                for (pairs, 0..) |pr, i| {
                    if (i > 0) out.appendSlice(alloc, ", ") catch unreachable;
                    out.appendSlice(alloc, entityRefs(alloc, pr.name, store, fields, char_caps, owned, true, false, bind, used, cur, dense)) catch unreachable;
                    out.appendSlice(alloc, ": ") catch unreachable;
                    out.appendSlice(alloc, entityRefs(alloc, pr.value, store, fields, char_caps, owned, false, false, bind, used, cur, dense)) catch unreachable;
                }
                return out.toOwnedSlice(alloc) catch unreachable;
            }
            /// `<row>.<field>` -> `<field>`, and a bare `<row>` on a ONE-column
            /// store -> that column's projected name. Expression context only.
            fn bindStrip(alloc: std.mem.Allocator, text: []const u8, bind: []const u8, fields: []const []const u8, used: []bool) []const u8 {
                const prefix = std.fmt.allocPrint(alloc, "{s}.", .{bind}) catch unreachable;
                const expr_ctx = ast.expressionMask(alloc, text);
                var out = std.ArrayList(u8).initCapacity(alloc, text.len + 16) catch unreachable;
                var i: usize = 0;
                while (i < text.len) {
                    const at_boundary = ast.identBoundaryBefore(text, i);
                    if (at_boundary and expr_ctx[i] and std.mem.startsWith(u8, text[i..], prefix)) {
                        // The guard runs in the qrow scope, where a column is
                        // reachable only as a projected const — so stripping a
                        // reference is what PUTS that column in the projection.
                        const fstart = i + prefix.len;
                        const rest = text[fstart..];
                        var best_fi: ?usize = null;
                        var best_len: usize = 0;
                        for (fields, 0..) |f, fi| {
                            if (std.mem.startsWith(u8, rest, f)) {
                                const after_char_idx = fstart + f.len;
                                const boundary_ok = after_char_idx >= text.len or !H.isIdentChar(text[after_char_idx]);
                                if (boundary_ok and f.len > best_len) {
                                    best_fi = fi;
                                    best_len = f.len;
                                }
                            }
                        }
                        if (best_fi) |fi| {
                            used[fi] = true;
                            i += prefix.len;
                            continue;
                        }
                    }
                    if (at_boundary and expr_ctx[i] and fields.len == 1 and
                        std.mem.eql(u8, fields[0], ast.STORE_IDENTITY_COLUMN) and
                        std.mem.startsWith(u8, text[i..], bind))
                    {
                        const after = i + bind.len;
                        if (after >= text.len or !H.isIdentChar(text[after])) {
                            used[0] = true;
                            out.appendSlice(alloc, fields[0]) catch unreachable;
                            i = after;
                            continue;
                        }
                    }
                    out.append(alloc, text[i]) catch unreachable;
                    i += 1;
                }
                return out.toOwnedSlice(alloc) catch unreachable;
            }
            /// Lower every `{{ … }}`-carrying value in a stored block into a
            /// built string, declaring the buffer in the invocation's preamble.
            ///
            /// The buffer is sized to the TARGET COLUMN, which is the whole
            /// reason this is cheap: the destination width is known at compile
            /// time, so the text is formatted straight into a stack array of
            /// exactly that size. `print` uses a blanket 64KB because it has no
            /// destination to measure; a column write does.
            var tmpl_seq: usize = 0;
            fn templateValues(alloc: std.mem.Allocator, text: []const u8, inv: *ast.Invocation, fields: []const []const u8, char_caps: []const ?usize, host_js: bool) []const u8 {
                const first = std.mem.indexOf(u8, text, "{{") orelse return text;
                // The value's extent is found from the TEMPLATE outward, never
                // by scanning quotes. After the row rewrite a hole holds host
                // code that carries its own string literals — `@import("std")`
                // — so the value is no longer a well-formed quoted literal, and
                // a quote scanner starts a span in the middle of one. This is
                // why print's own scanner keys on `{{`/`}}` and never on
                // quotes; same reason here.
                //
                // One templated write per block this rung. A block mixing a
                // templated value with others would need the pair boundaries,
                // and those are exactly what the rewritten text no longer
                // reliably shows.
                if (std.mem.indexOfPos(u8, text, first + 2, "{{") != null and std.mem.count(u8, text, "{{") > std.mem.count(u8, text, "}}")) return text;
                const vstart = std.mem.lastIndexOfScalar(u8, text[0..first], '"') orelse return text;
                const last_close = std.mem.lastIndexOf(u8, text, "}}") orelse return text;
                const vend = std.mem.indexOfScalarPos(u8, text, last_close + 2, '"') orelse return text;
                const span = text[vstart .. vend + 1];
                const r = renderTemplate(alloc, span, host_js) orelse return text;

                // Size the buffer from the column being written: the target is
                // whatever identifier precedes the `:` before the value.
                var cap: usize = 256;
                {
                    var k = vstart;
                    while (k > 0 and (text[k - 1] == ' ' or text[k - 1] == ':')) k -= 1;
                    const nend = k;
                    while (k > 0 and (H.isIdentChar(text[k - 1]) or text[k - 1] == '.')) k -= 1;
                    const tname = text[k..nend];
                    const fname = if (std.mem.lastIndexOfScalar(u8, tname, '.')) |d| tname[d + 1 ..] else tname;
                    for (fields, 0..) |f, fi| {
                        if (std.mem.eql(u8, f, fname)) {
                            if (char_caps[fi]) |cc| cap = cc;
                        }
                    }
                }

                tmpl_seq += 1;
                const nm = std.fmt.allocPrint(alloc, "__koru_tmpl_{d}", .{tmpl_seq}) catch unreachable;
                var pre = std.ArrayList(u8).initCapacity(alloc, 256) catch unreachable;
                if (inv.preamble_code) |existing| pre.appendSlice(alloc, existing) catch unreachable;
                if (host_js) {
                    const line = std.fmt.allocPrint(alloc, "const {s} = \"{s}\";\n", .{ nm, r.fmt }) catch unreachable;
                    pre.appendSlice(alloc, line) catch unreachable;
                } else {
                    // A column-sized buffer TRUNCATES an over-long result —
                    // exactly what the column write already does to an
                    // over-long literal. Consistent, and both want a
                    // `| full`-shaped answer rather than silence.
                    const line = std.fmt.allocPrint(alloc,
                        "var __koru_tb_{d}: [{d}]u8 = undefined;\nconst {s} = @import(\"std\").fmt.bufPrint(&__koru_tb_{d}, \"{s}\", .{{{s}}}) catch __koru_tb_{d}[0..0];\n",
                        .{ tmpl_seq, cap, nm, tmpl_seq, r.fmt, r.args, tmpl_seq }) catch unreachable;
                    pre.appendSlice(alloc, line) catch unreachable;
                }
                inv.preamble_code = pre.toOwnedSlice(alloc) catch unreachable;

                var out = std.ArrayList(u8).initCapacity(alloc, text.len + 32) catch unreachable;
                out.appendSlice(alloc, text[0..vstart]) catch unreachable;
                out.appendSlice(alloc, nm) catch unreachable;
                out.appendSlice(alloc, text[vend + 1 ..]) catch unreachable;
                return out.toOwnedSlice(alloc) catch unreachable;
            }
            fn walkCont(alloc: std.mem.Allocator, cont: *ast.Continuation, store: []const u8, fields: []const []const u8, char_caps: []const ?usize, owned: []const bool, bind: []const u8, used: []bool, cur: []const u8, dense: bool, host_js_w: bool) void {
                if (cont.node) |*n| {
                    switch (@constCast(n).*) {
                        .invocation => |*inv| {
                            const is_stored = blk: {
                                if (inv.path.module_qualifier) |mq| {
                                    if (std.mem.eql(u8, mq, "std.store") and inv.path.segments.len == 1 and std.mem.eql(u8, inv.path.segments[0], "stored")) break :blk true;
                                }
                                break :blk false;
                            };
                            for (inv.args) |*a| {
                                if (is_stored and std.mem.eql(u8, a.name, "source")) {
                                    @constCast(a).value = storedBlock(alloc, a.value, store, fields, char_caps, owned, bind, used, cur, dense);
                                    // A written value carrying `{{ … }}` builds
                                    // text. The buffer it builds into CANNOT be
                                    // an expression-local: the write memcpys out
                                    // of it, so a `blk:` temporary would hand
                                    // the copy a dangling slice. It goes in the
                                    // invocation's preamble, which outlives the
                                    // statement by construction.
                                    // ONE lowering, shared by both carriers. The
                                    // arg's `value` and its `source_value.text`
                                    // are two views of the same written block —
                                    // downstream reads the Source — so lowering
                                    // each independently mints two buffers and
                                    // leaves whichever one is not read dangling
                                    // as an unused local.
                                    // Mutate through the NODE pointer, never the switch capture: switching
                                    // on a dereferenced node makes `inv` a TEMPORARY, so a field set on
                                    // it is discarded (the 690_074 trap this walk already documents for
                                    // inline_body). `a.value` survives only because args is a slice whose
                                    // data is shared — which is exactly why the value substituted while
                                    // its buffer declaration vanished.
                                    @constCast(a).value = templateValues(alloc, a.value, &n.invocation, fields, char_caps, host_js_w);
                                    if (a.source_value) |sv| {
                                        const fresh = alloc.create(ast.Source) catch unreachable;
                                        fresh.* = sv.*;
                                        fresh.text = storedBlock(alloc, sv.text, store, fields, char_caps, owned, bind, used, cur, dense);
                                        @constCast(a).source_value = fresh;
                                    }
                                } else {
                                    @constCast(a).value = entityRefs(alloc, a.value, store, fields, char_caps, owned, false, true, bind, used, cur, dense);
                                    if (a.expression_value) |ev| {
                                        const fresh = alloc.create(ast.CapturedExpression) catch unreachable;
                                        fresh.* = ev.*;
                                        fresh.text = entityRefs(alloc, ev.text, store, fields, char_caps, owned, false, true, bind, used, cur, dense);
                                        @constCast(a).expression_value = fresh;
                                    }
                                    if (a.source_value) |sv| {
                                        const fresh = alloc.create(ast.Source) catch unreachable;
                                        fresh.* = sv.*;
                                        fresh.text = entityRefs(alloc, sv.text, store, fields, char_caps, owned, false, true, bind, used, cur, dense);
                                        @constCast(a).source_value = fresh;
                                    }
                                }
                            }
                            // Template expand (`if`/`for`) froze its rendered
                            // body — condition text included — into inline_body
                            // BEFORE this walk runs (690_074's freeze). The row
                            // binding has to reach into the frozen text too, or
                            // an `if(e.id == 7)` under the arm ships its raw
                            // surface. Mutate via the NODE pointer — the switch
                            // capture is a temporary (the 690_074 trap).
                            if (n.invocation.inline_body) |ib| {
                                n.invocation.inline_body = entityRefs(alloc, ib, store, fields, char_caps, owned, false, true, bind, used, cur, dense);
                            }
                        },
                        else => {},
                    }
                }
                for (cont.continuations) |*c| walkCont(alloc, @constCast(c), store, fields, char_caps, owned, bind, used, cur, dense, host_js_w);
            }
        };
        for (qsites.items) |*qs| {
            // Aligned with field_names: owned[i] is true exactly where
            // field_owned_info[i] names a column.
            const owned_flags = allocator.alloc(bool, field_names.len) catch unreachable;
            for (field_names, 0..) |_, i| owned_flags[i] = (i < field_owned_info.len) and field_owned_info[i] != null;
            // `used[i]` is set by the rewrites themselves: an owned column the
            // body names (it can only travel as the phantom-carrying input)
            // and every column the guard reads. A scalar the body reads needs
            // no projection at all — `entityRefs` hands it a direct column
            // read at the cursor, which is why projecting the whole row was
            // pure tax.
            const used = allocator.alloc(bool, field_names.len) catch unreachable;
            for (used) |*u| u.* = false;
            // THE CURSOR. A rule whose program can never remove a row carries
            // the DENSE loop index under an `__koru_sdix_` name, which is the
            // marker the write family already pass-throughs (store.kz:5698) —
            // the same cursor the query path has carried since the O10.iv
            // elision. A program that mentions take anywhere keeps the
            // generational handle, because a swap-remove can move the row out
            // from under a dense index mid-pass. The predicate is the whole-
            // program one already computed for the loop form; keyed on the
            // ARM's line so two rules over one store never share a name.
            const cursor = if (qs.may_remove)
                allocator.dupe(u8, "__koru_qrow") catch unreachable
            else
                std.fmt.allocPrint(allocator, "__koru_sdix_rule_L{d}", .{qs.line}) catch unreachable;
            const cursor_dense = !qs.may_remove;
            qs.cursor = cursor;
            qs.cursor_dense = cursor_dense;
            PRewrite.walkCont(allocator, &qs.body, store_name, field_names, field_char_caps, owned_flags, qs.row_bind, used, cursor, cursor_dense, host_is_js);
            // The `when` guard is held beside the body, not inside it, so the
            // body walk never reached it. It sees the row through the binding
            // like everything else does.
            // The guard is evaluated in the qbody's own scope, where the
            // projections arrive as PARAMETERS named for their columns — not
            // where the store cell is reachable. So it strips the binding to the
            // projected name (`e.hp` -> `hp`) rather than resolving to a column
            // read the way the body does.
            if (qs.guard) |g| {
                var is_refusal: ?[]const u8 = null;
                const guard_is = rewriteIsGuard(allocator, program, if (qs.is_preorder) "preorder" else "rule", store_name, qs.row_bind, g, &is_refusal);
                if (is_refusal) |m| {
                    return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, "{s}", .{m}) } };
                }
                qs.guard = PRewrite.bindStrip(allocator, guard_is orelse g, qs.row_bind, field_names, used);
                var read_names = std.ArrayList([]const u8).initCapacity(allocator, field_names.len) catch unreachable;
                for (field_names, used) |fnm, u| {
                    if (u) read_names.append(allocator, fnm) catch unreachable;
                }
                const verb = if (qs.is_preorder) "preorder" else if (qs.rule_name != null) "rule" else "query";
                if (privateReadRefusal(allocator, program, verb, store_name, qs.row_bind, g, guard_is, read_names.items)) |m| {
                    return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, "{s}", .{m}) } };
                }
            }
            // The derived projection: every column the arm named, in
            // declaration order. The synthesized `parent` of a [tree] store is
            // not the author's to see, so it stops at the user columns — but
            // the demanded kind tag IS the author's (`e.kind`, `e is m` in a
            // guard): when the arm reads it, it projects like any column.
            var pnames = std.ArrayList([]const u8).initCapacity(allocator, user_field_count) catch unreachable;
            var pfields = std.ArrayList(usize).initCapacity(allocator, user_field_count) catch unreachable;
            for (field_names[0..user_field_count], 0..) |fnm, fi| {
                if (!used[fi]) continue;
                const mangled = std.mem.replaceOwned(u8, allocator, fnm, ".", "_") catch unreachable;
                pnames.append(allocator, mangled) catch unreachable;
                pfields.append(allocator, fi) catch unreachable;
            }
            if (want_kind and used[kind_idx]) {
                pnames.append(allocator, allocator.dupe(u8, "kind") catch unreachable) catch unreachable;
                pfields.append(allocator, kind_idx) catch unreachable;
            }
            qs.proj_names = pnames.toOwnedSlice(allocator) catch unreachable;
            qs.proj_fields = pfields.toOwnedSlice(allocator) catch unreachable;
        }

        // Store-name rewriting for watch bodies (other stores readable —
        // same as rung one).
        var pstore_names = std.ArrayList([]const u8).initCapacity(allocator, 4) catch unreachable;
        // The subset that names ONE column and no field. A reference to one of
        // these is BARE — `counter`, not `counter.field` — so the rewriter needs
        // to know which stores those are before it can resolve them.
        var pstore_identity = std.ArrayList([]const u8).initCapacity(allocator, 4) catch unreachable;
        for (flatItems(allocator, program.items)) |pi| {
            switch (pi.*) {
                .flow => |*f| {
                    if (H.isStoreInv(f, "new", null)) {
                        var nm: ?[]const u8 = null;
                        var seed: ?[]const u8 = null;
                        for (f.inv().args) |a| {
                            if (std.mem.eql(u8, a.name, "expr")) nm = H.stripQuotes(a.value);
                            if (std.mem.eql(u8, a.name, "source")) seed = a.value;
                        }
                        if (nm) |n| {
                            pstore_names.append(allocator, n) catch unreachable;
                            // Read the seed the same way the declaration does, so
                            // "is this identity-shaped" has ONE answer.
                            if (seed) |sd| {
                                const braced = std.fmt.allocPrint(allocator, "{{{s}}}", .{sd}) catch unreachable;
                                if (struct_literal.isIdentityBlock(braced)) pstore_identity.append(allocator, n) catch unreachable;
                            }
                        }
                    }
                },
                .event_decl => |*ed| {
                    if (ed.path.segments.len == 1 and std.mem.startsWith(u8, ed.path.segments[0], "__store_apply_")) {
                        const n = ed.path.segments[0]["__store_apply_".len..];
                        pstore_names.append(allocator, n) catch unreachable;
                        // An already-coordinated store carries its columns as the
                        // apply event's branches.
                        if (ed.branches.len == 1 and std.mem.eql(u8, ed.branches[0].name, ast.STORE_IDENTITY_COLUMN)) {
                            pstore_identity.append(allocator, n) catch unreachable;
                        }
                    }
                },
                else => {},
            }
        }
        // Transplanted arms are spliced into the declaring module's own units,
        // so every store reaches them unprefixed.
        {
            const wscope = StoreScope{
                .names = pstore_names.items,
                .prefixes = blk_wpx: {
                    const px = allocator.alloc([]const u8, pstore_names.items.len) catch unreachable;
                    for (px) |*p| p.* = "";
                    break :blk_wpx px;
                },
            };
            for (pwatch_arms.items) |*wa| H.storeRefsContH(allocator, program, &wa.cont, wscope, pstore_identity.items, &[_][]const u8{});
        }

        // Owned-column stores build insert/take/teardown (690_053), the READ
        // surface (query/preorder, 690_060: an owned column projects as a BARE
        // borrow `*mod:Type<mod:state>` — no `!`, the store keeps the live
        // `<state!>`, `read` consumes nothing), REACT-on-insert (`inserted`
        // interceptor, 690_061), and — this rung — WRITE (stored-update,
        // 690_062: discharge-old + consume-new through the unit-4 apply/write
        // pair) with field-`watch` firing on the write (690_063: the apply
        // branch payload borrow-reads the fresh cell), and REACT-on-remove
        // (`removed` interceptor, 690_065: fires in the take path before the
        // swap-remove, bare-borrow-reading the outgoing row via the same
        // LC.emit projection). Still later rungs, loud walls, never silent
        // miscompiles: the `updated` interceptor (it carries TWO owned images —
        // old and new — of the written field, a distinct rung from removed's
        // single outgoing borrow), and watch over a DRAIN store (ambiguous
        // discharger — unit-4 is not generated there, so a watch arm would
        // silently never fire).
        if (has_owned) {
            if (drain_required and pwatch_arms.items.len > 0) {
                return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, "std/store:watch({s}): watch over a DRAIN store (ambiguous discharger) is a later rung - the write surface needs the canonical discharger to evict the old value (690_062), which *{s}:{s} does not have (declare exactly one, or drop the watch)", .{ store_name, ambig_module, ambig_type }) } };
            }
            if (updated_arms.items.len > 0) {
                return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, "std/store:new({s}): the `updated` interceptor over an owned column is a later rung - it carries TWO owned images (old and new) of the written field; `inserted`/`removed`/`watch` over owned are built (690_061/065/063)", .{store_name}) } };
            }
        }
        // ---- unit 1: the SoA cell ----
        var pc = std.ArrayList(u8).initCapacity(allocator, 512) catch unreachable;
        pc.appendSlice(allocator, "const __KoruStoreT_") catch unreachable;
        pc.appendSlice(allocator, store_name) catch unreachable;
        pc.appendSlice(allocator, " = struct {\n") catch unreachable;
        for (field_names, field_types, field_char_caps, field_owned_info) |fname, ftype, fcc, foi| {
            // A fixed-char column is [CAP][N]u8 (the event-level `string`
            // type never reaches Zig emission); an owned column is [CAP]*Type
            // (the store OWNS the pointers — teardown frees the live ones) with
            // Type the discovered host cell (e.g. koru_std.koru_string.String);
            // scalars emit their own type.
            const esc_fname = codegen_utils_store.escapeZigIdentifier(allocator, fname) catch fname;
            const col = if (fcc) |n|
                std.fmt.allocPrint(allocator, "    {s}: [{d}][{d}]u8 = undefined,\n", .{ esc_fname, CAP, n }) catch unreachable
            else if (foi) |oi|
                std.fmt.allocPrint(allocator, "    {s}: [{d}]*{s} = undefined,\n", .{ esc_fname, CAP, oi.host_type }) catch unreachable
            else
                std.fmt.allocPrint(allocator, "    {s}: [{d}]{s} = undefined,\n", .{ esc_fname, CAP, ftype }) catch unreachable;
            pc.appendSlice(allocator, col) catch unreachable;
        }
        pc.appendSlice(allocator, "    len: usize = 0,\n") catch unreachable;
        // `std/indexes:store(<s>, <col>)` — a declared index is AST-data
        // (store.index.kz): the store OWNS the backing key→handle map, and
        // the verbs maintain it inside their own emit. The map values are
        // handles, so swap-remove moves no entry (the moved row's handle is
        // unchanged); `take` owes only the taken row's own removal.
        var index_col: ?[]const u8 = null;
        var index_idx: usize = 0;
        switch (StoreIndexDecls.fieldSpec(allocator, reporter, program, store_name, field_names, field_types, field_char_caps, field_owned_info)) {
            .refuse => |r| return .{ .transformed = .{ .replacement = r } },
            .indexed => |spec| {
                pc.appendSlice(allocator, spec.field) catch unreachable;
                index_col = spec.col;
                index_idx = spec.idx;
            },
            .none => {},
        }
        // The sparse-set half of THE MEMORY CONTRACT (O10.iii/iv, DESIGN.md):
        // a program-visible row value is a HANDLE — sparse slot in the low 24
        // bits, the minting store's ordinal in bits 24..31, that slot's
        // generation in the high 32 — never a dense position. Dense columns
        // keep swap-remove and 0..len iteration; the handle indirects through
        // `__koru_hslot_row` so it survives other rows' removal, and the
        // generation compare (one compare — the O10.iv floor) traps a handle
        // whose row was taken. The BRAND byte is the other direction of that
        // trap (690_196): two same-shaped stores filled in the same order mint
        // identical slot|gen values, so bounds+generation alone cannot tell a
        // sibling's handle from this store's — the ordinal compare can, and it
        // refuses with the not-this-store's-handle message. The program's
        // FIRST store has ordinal 0, so its handles (and every single-store
        // program's) stay numerically identical to the unbranded encoding:
        // generation-0 handles equal the dense indices the store used to hand
        // out, and a program that never removes prints the same numbers.
        var __brand_names = std.ArrayList([]const u8).initCapacity(allocator, 8) catch unreachable;
        const Brand = struct {
            fn add(alloc: std.mem.Allocator, names: *std.ArrayList([]const u8), n: []const u8) void {
                for (names.items) |e| if (std.mem.eql(u8, e, n)) return;
                names.append(alloc, n) catch unreachable;
            }
            // The ordinal is COORDINATION order, not item position: a
            // coordinated store's apply event lands at the program's tail, so
            // positions shuffle as stores coordinate (measured — the second
            // store's walk saw itself first). What is stable: at this store's
            // transform, exactly the stores coordinated BEFORE it carry a
            // `__store_apply_` event, and coordination runs in program order.
            // So this store's ordinal = the count of sibling apply events.
            // Recurses into module decls (690_079/080 — a module can own a
            // store); dedupe by name keeps a store at one ordinal no matter
            // how many faces of it the walk meets.
            fn collect(alloc: std.mem.Allocator, items: []const ast.Item, names: *std.ArrayList([]const u8)) void {
                for (items) |*pi| {
                    switch (pi.*) {
                        .event_decl => |*ed2| {
                            if (ed2.path.segments.len == 1 and std.mem.startsWith(u8, ed2.path.segments[0], "__store_apply_")) {
                                add(alloc, names, ed2.path.segments[0]["__store_apply_".len..]);
                            }
                        },
                        .module_decl => |*md2| collect(alloc, md2.items, names),
                        else => {},
                    }
                }
            }
        };
        Brand.collect(allocator, program.items, &__brand_names);
        // The brand is the store's ordinal PLUS ONE, and the +1 is the whole
        // guard. A handle packs `slot | (brand << 24)`, and `__koru_resolve`
        // refuses any address whose top byte is not this store's brand — that
        // refusal is what 690_115 and 690_196 pin. At brand 0 the check
        // `(slot32 >> 24) != 0` is FALSE for every small integer, so the wall
        // was off for whichever store happened to be declared first: measured
        // 2026-08-02, a plain `0` in an i64 column addressed row 0 of the
        // first store and wrote to it, while the identical program trapped
        // correctly on the second store. A wall that guards every case but one
        // reads as a wall.
        //
        // Reserving 0 also makes the DENSE row index and the HANDLE disjoint
        // as values, which is what lets a dense cursor be passed where a
        // handle is expected and fail loudly instead of silently.
        var store_ordinal: usize = 1;
        for (__brand_names.items) |bn| {
            if (!std.mem.eql(u8, bn, store_name)) store_ordinal += 1;
        }
        if (CAP > 0xFFFFFF) {
            return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, "std/store:new({s}): capacity above 16777215 is a later rung - the row handle carries the slot in 24 bits (store brand in bits 24..31, 690_196)", .{store_name}) } };
        }
        if (store_ordinal > 0xFF) {
            return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, "std/store:new({s}): more than 255 stores in one program is a later rung - the row handle carries the minting store's brand in 8 bits, and brand 0 is reserved so a non-handle integer cannot pass as an address (690_196)", .{store_name}) } };
        }
        // The handle table. A lean store carries none of this — no hslot
        // arrays, no brand, no resolve/row_of/handle_of methods — and the
        // gate above guarantees no emitted unit is left to name one.
        const hs: []const u8 = if (needs_handles) HStruct.emit(allocator, CAP, store_ordinal, store_name) else "";
        pc.appendSlice(allocator, hs) catch unreachable;
        pc.appendSlice(allocator, "};\n") catch unreachable;
        pc.appendSlice(allocator, "var __koru_store_") catch unreachable;
        pc.appendSlice(allocator, store_name) catch unreachable;
        pc.appendSlice(allocator, ": __KoruStoreT_") catch unreachable;
        pc.appendSlice(allocator, store_name) catch unreachable;
        pc.appendSlice(allocator, " = .{};") catch unreachable;
        pc.appendSlice(allocator, refhome.zig) catch unreachable;
        // The row-value type: what take extracts (obligation rides on it).
        pc.appendSlice(allocator, "\nconst __KoruStoreRow_") catch unreachable;
        pc.appendSlice(allocator, store_name) catch unreachable;
        pc.appendSlice(allocator, " = struct {") catch unreachable;
        for (field_names, field_types, 0..) |fname, ftype, fi| {
            if (fi > 0) pc.appendSlice(allocator, ",") catch unreachable;
            pc.appendSlice(allocator, " ") catch unreachable;
            pc.appendSlice(allocator, codegen_utils_store.escapeZigIdentifier(allocator, fname) catch fname) catch unreachable;
            pc.appendSlice(allocator, ": ") catch unreachable;
