            // column (the binding exists because the insert event carries it —
            // see ins_* above). Same statement on both targets.
            if (want_kind) {
                const w = std.fmt.allocPrint(allocator, "__koru_store_{s}.kind[__koru_new_row] = kind;\n", .{store_name}) catch unreachable;
                ap.appendSlice(allocator, w) catch unreachable;
