// std/json - JSON encoding and decoding
// - `~part parse`/`~part emit`: schema-directed compile-time transforms.
// - `~part dom` (json.dom.kz): runtime document model — parse to a
//   traversable tree, key iteration, typed descent, serializer.
~part parse
~part emit
~part emithelpers
~part emitcap
~part emitjs
~part emitln
~part parsehelpers
~part parsesub
~part dom
~part gets
~part helpers
const std = @import("std");
// ============================================================================
// Types
// ============================================================================

pub const JsonObject = struct {
    buffer: std.ArrayList(u8),
    allocator: std.mem.Allocator,
    field_count: usize,
};

pub const JsonValue = union(enum) {
    string: []const u8,
    int: i64,
    float: f64,
    bool_val: bool,
    null_val: void,
    raw: []const u8,  // For nested objects/arrays as raw JSON
};

// ============================================================================
// Object Builder - Create JSON objects
// ============================================================================

~pub tor object.new { allocator: ?std.mem.Allocator } -> *JsonObject<building!>

~proc object.new|zig {
    const alloc = allocator orelse koru_allocator();

    const obj = alloc.create(JsonObject) catch @panic("std/json object.new: allocation failed");

    obj.* = .{
        .buffer = std.ArrayList(u8).init(alloc),
        .allocator = alloc,
        .field_count = 0,
    };

    obj.buffer.append('{') catch {};

    return obj;
}

~pub tor object.set { obj: *JsonObject<building>, key: string, value: JsonValue } -> *JsonObject<building>

~proc object.set|zig {
    const writer = obj.buffer.writer();
    
    // Add comma if not first field
    if (obj.field_count > 0) {
        writer.writeByte(',') catch {};
    }
    
    // Write key
    writer.writeByte('"') catch {};
    writeJsonEscaped(writer, key);
    writer.writeAll("\":") catch {};
    
    // Write value
    switch (value) {
        .string => |s| {
            writer.writeByte('"') catch {};
            writeJsonEscaped(writer, s);
            writer.writeByte('"') catch {};
        },
        .int => |i| {
            writer.print("{d}", .{i}) catch {};
        },
        .float => |f| {
            writer.print("{d}", .{f}) catch {};
        },
        .bool_val => |b| {
            writer.writeAll(if (b) "true" else "false") catch {};
        },
        .null_val => {
            writer.writeAll("null") catch {};
        },
        .raw => |r| {
            writer.writeAll(r) catch {};
        },
    }
    
    obj.field_count += 1;
    return obj;
}

~pub tor object.finish { obj: *JsonObject<!building> } -> string

~proc object.finish|zig {
    obj.buffer.append('}') catch {};
    const result = obj.buffer.toOwnedSlice() catch "";
    // Note: caller owns the slice, should free with obj.allocator
    return result;
}

// ============================================================================
// Array Builder - Create JSON arrays
// ============================================================================

~pub tor array.new { allocator: ?std.mem.Allocator } -> *JsonObject<building!>  // Reuse JsonObject for simplicity

~proc array.new|zig {
    const alloc = allocator orelse koru_allocator();

    const obj = alloc.create(JsonObject) catch @panic("std/json array.new: allocation failed");

    obj.* = .{
        .buffer = std.ArrayList(u8).init(alloc),
        .allocator = alloc,
        .field_count = 0,
    };

    obj.buffer.append('[') catch {};

    return obj;
}

~pub tor array.push { arr: *JsonObject<building>, value: JsonValue } -> *JsonObject<building>

~proc array.push|zig {
    const writer = arr.buffer.writer();
    
    if (arr.field_count > 0) {
        writer.writeByte(',') catch {};
    }
    
    switch (value) {
        .string => |s| {
            writer.writeByte('"') catch {};
            writeJsonEscaped(writer, s);
            writer.writeByte('"') catch {};
        },
        .int => |i| {
            writer.print("{d}", .{i}) catch {};
        },
        .float => |f| {
            writer.print("{d}", .{f}) catch {};
        },
        .bool_val => |b| {
            writer.writeAll(if (b) "true" else "false") catch {};
        },
        .null_val => {
            writer.writeAll("null") catch {};
        },
        .raw => |r| {
            writer.writeAll(r) catch {};
        },
    }
    
    arr.field_count += 1;
    return arr;
}

~pub tor array.finish { arr: *JsonObject<!building> } -> string

~proc array.finish|zig {
    arr.buffer.append(']') catch {};
    const result = arr.buffer.toOwnedSlice() catch "";
    return result;
}
