// Koru Standard Library: the `wiregate` part of bridge.kz — the gate's
// vocabulary tables. Joined via `~part wiregate` in bridge.kz; merged
// into the bridge module at load.
//
// One scanner, two duties, same lookups: `wireGate` admits — an arg value
// is a quoted string or a bare Koru expression, judged by the language's
// own expression parser, and `dispatchThroughScope` normalizes the same
// way, so what the gate admits is exactly what dispatch executes. Field
// names are still judged against the scope's input_fn (or this file's
// host table for the introspection verbs); untyped scopes see the flat
// grammar unchanged. wireGate/dispatchThroughScope moved to the `wirerun`
// part — the wire's path through the installed scope set.

const GateRejection = struct { message: []const u8, line: u32, column: u32, not_invocation: bool };

// The introspection-granted host verbs' field vocabularies — one table the
// scanner, dispatch, and prompt render all read; note/bind/abandon take
// plain-string fields, vocabulary/grammar/state take none.
const HostVerbSpec = struct { name: []const u8, fields: []const Runtime.InputFieldSpec, doc: []const u8 = "" };
const host_verbs = [_]HostVerbSpec{
    .{ .name = "vocabulary", .fields = &.{} },
    .{ .name = "grammar", .fields = &.{} },
    .{ .name = "state", .fields = &.{}, .doc = " — reads live session state: bound values with contents, arm names by scope (durable/turn/item), held handles, defined flows" },
    .{ .name = "bind", .fields = &.{ .{ .name = "name", .type_name = "string" }, .{ .name = "value", .type_name = "string" } } },
    .{ .name = "note", .fields = &.{ .{ .name = "text", .type_name = "string" } },
        .doc = " — speaks to the observer, not the user: reasoning, plans, and \"why I'm stuck\" go here" },
    .{ .name = "abandon", .fields = &.{ .{ .name = "reason", .type_name = "string" } },
        .doc = " — ends the session with your reason: what you tried, what blocked you" },
};

fn hostInputLookup(verb: []const u8) ?[]const Runtime.InputFieldSpec {
    for (host_verbs) |v| {
        if (std.mem.eql(u8, verb, v.name)) return v.fields;
    }
    return null;
}

// The verbs introspection grants, rendered in `vocabulary`/`grammar` and
// exported for the agent's prompt doc — derived at comptime from the table
// the gate enforces: the prompt, the parser, and the dispatch read the same
// declaration, typed fields spelled the way scope verbs spell theirs.
pub const introspection_verbs: []const u8 = blk: {
    var text: []const u8 = "";
    for (host_verbs) |v| {
        if (text.len > 0) text = text ++ "\n";
        text = text ++ v.name ++ "(";
        for (v.fields, 0..) |f, i| {
            if (i > 0) text = text ++ ", ";
            text = text ++ f.name ++ ": " ++ f.type_name;
        }
        text = text ++ ")" ++ v.doc;
    }
    break :blk text;
};

// wireGate, sessionInputLookup, and dispatchThroughScope moved to the
// `wirerun` part — the wire's path through the installed scope set:
// admit, normalize, run.
