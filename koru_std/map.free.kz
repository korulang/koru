// Koru Standard Library: the `free` part of map.kz.
// Joined via `~part free` in map.kz; merged into the module at load.

// ============================================
// Teardown (consume — discharges <!map>)
// ============================================

~pub tor free { m: *Map_i64_i64<!map> }

~proc free|zig {
    m.deinit();
}
