// ============================================================================
// std/num part: bases — non-decimal spellings of integers, in and out.
// to-base emits digits in base 2..36 (bc's obase); from-base reads an
// explicit base (bc's ibase); render-fixed expands the canonical Ne±M
// form to place-value text (1e-3 -> 0.001) for display. Prefixed
// spellings (0x/0b/0o) are admitted by the lit/parse gate in the parent
// — a declaration of base by prefix, never a second grammar.
//
//   to-base      a, base   -> exact digits | non-int | bad-base
//   from-base    s, base   -> exact <dec> | bad-digit | bad-base
//   render-fixed n         -> allocated place-value text | too-large
// ============================================================================

// Fixed-point (place-value) rendering — display text, not a canonical
// num string. Refuses when the expansion would exceed FIXED_CAP chars:
// a taint-derived exponent is a memory-amplification axis, and display
// text that large is never the answer.
const FIXED_CAP: usize = 65536;

fn decToFixed(alloc: std.mem.Allocator, d: *const Dec) ![]u8 {
    if (d.m.eqlZero()) return alloc.dupe(u8, "0");
    const ds = try biToDigits(alloc, &d.m);
    defer alloc.free(ds);
    const dl: i64 = @intCast(ds.len);
    const need: i128 = @as(i128, dl) + @abs(d.e) + 3;
    if (need > FIXED_CAP) return error.TooLarge;
    var out = std.ArrayList(u8).initCapacity(alloc, @intCast(need)) catch return error.OutOfMemory;
    errdefer out.deinit(alloc);
    if (d.neg) try out.append(alloc, '-');
    if (d.e >= 0) {
        try out.appendSlice(alloc, ds);
        try out.appendNTimes(alloc, '0', @intCast(d.e));
    } else if (-d.e < dl) {
        const cut: usize = @intCast(dl + d.e);
        try out.appendSlice(alloc, ds[0..cut]);
        try out.append(alloc, '.');
        try out.appendSlice(alloc, ds[cut..]);
    } else {
        try out.appendSlice(alloc, "0.");
        try out.appendNTimes(alloc, '0', @intCast(-d.e - dl));
        try out.appendSlice(alloc, ds);
    }
    return out.toOwnedSlice(alloc);
}

~pub tor render-fixed { n: string<!exact> }
| exact string<std/io:allocated!>
| too-large

~proc render-fixed|zig {
    defer numFree(n);
    var d = decParse(koru_allocator(), n) catch @panic("std/num:render-fixed: malformed operand");
    defer decDeinit(&d);
    const s = decToFixed(koru_allocator(), &d) catch |err| switch (err) {
        error.TooLarge => return .{ .too_large = .{} },
        else => @panic("std/num: out of memory"),
    };
    return .{ .exact = s };
}

// Render an integral value in base 2..36 (bc's obase, honest about scope:
// non-integers refuse rather than emitting bc's digit-vector notation).
~pub tor to-base { a: string<!exact>, base: i64 }
| exact string<exact!>
| non-int
| bad-base

// Parse digits in base 2..36 into an integer value (bc's ibase; lit-lane —
// the text is trusted, same contract as lit). Upper and lower case both
// accepted; '_' separators refused, a leading '-' negates.
~pub tor from-base { s: string, base: i64 }
| exact string<exact!>
| bad-digit
| bad-base

~proc to-base|zig {
    defer numFree(a);
    if (base < 2 or base > 36) return .{ .bad_base = .{} };
    var d = decParse(koru_allocator(), a) catch @panic("std/num:to-base: malformed operand");
    defer decDeinit(&d);
    if (d.e < 0) return .{ .non_int = .{} };
    var v = d.m.clone() catch @panic("std/num: out of memory");
    defer v.deinit();
    var p = pow10(koru_allocator(), d.e) catch @panic("std/num: out of memory");
    defer p.deinit();
    mulFast(&v, &v, &p) catch @panic("std/num: out of memory");
    const b8: u8 = @intCast(base);
    const s = v.toString(koru_allocator(), b8, .lower) catch @panic("std/num: out of memory");
    if (d.neg and !v.eqlZero()) {
        var out = koru_allocator().alloc(u8, s.len + 1) catch @panic("std/num: out of memory");
        out[0] = '-';
        @memcpy(out[1..], s);
        koru_allocator().free(s);
        return .{ .exact = out };
    }
    return .{ .exact = s };
}

~proc from-base|zig {
    if (base < 2 or base > 36) return .{ .bad_base = .{} };
    var i: usize = 0;
    var neg = false;
    if (s.len > 0 and s[0] == '-') {
        neg = true;
        i = 1;
    }
    var v = biFromBaseDigits(koru_allocator(), s[i..], base) catch return .{ .bad_digit = .{} };
    defer v.deinit();
    const ds = v.toString(koru_allocator(), 10, .lower) catch @panic("std/num: out of memory");
    defer koru_allocator().free(ds);
    var out = decFromDigits(koru_allocator(), ds, 0, neg and !v.eqlZero()) catch @panic("std/num: out of memory");
    defer decDeinit(&out);
    return .{ .exact = decToString(koru_allocator(), &out) catch @panic("std/num: out of memory") };
}
