// Koru Standard Library: the `scope` part of gate.kz.
// Joined via `~part scope` in gate.kz; merged into the module at load.
//
// The `scope-<path>` row modifier and the shared staged-diff lazy cache:
// a sampled (odds-N) alarm aims at commits that could carry its census's
// clones, so a staged diff that touches none of the census's paths
// dismisses the roll before it happens — docs-only commits never fire
// code-census alarms.


const gate_scope = struct {
    // The row's `scope-<path>` modifier — the staged path prefix (or
    // `*.ext` suffix) the staged diff must touch for the roll to fire.
    fn oddsScope(tags: []const u8) ?[]const u8 {
        const at = std.mem.indexOf(u8, tags, "\"scope-") orelse return null;
        var i = at + 7;
        const start = i;
        while (i < tags.len and (std.ascii.isAlphanumeric(tags[i]) or
            tags[i] == '-' or tags[i] == '_' or tags[i] == '/' or
            tags[i] == '.' or tags[i] == '*')) : (i += 1) {}
        return if (i > start) tags[start..i] else null;
    }

    // Does a `git diff --staged --name-only` list touch `scope`? `*.ext`
    // matches by suffix anywhere; a bare scope matches the path exactly
    // or as a `scope/` directory prefix.
    fn namesTouch(names: []const u8, scope: []const u8) bool {
        var it = std.mem.splitScalar(u8, names, '\n');
        while (it.next()) |raw| {
            const p = std.mem.trim(u8, raw, " \t\r");
            if (p.len == 0) continue;
            if (scope.len > 1 and scope[0] == '*') {
                if (std.mem.endsWith(u8, p, scope[1..])) return true;
            } else if (std.mem.eql(u8, p, scope) or
                (p.len > scope.len and std.mem.startsWith(u8, p, scope) and p[scope.len] == '/')) return true;
        }
        return false;
    }

    // Lazily-fetched staged state — the full diff (for the odds roll) and
    // the name-only list (for scope matching), each fetched once per run.
    pub const Staged = struct {
        diff_done: bool = false,
        diff: ?[]const u8 = null,
        names_done: bool = false,
        names: ?[]const u8 = null,

        fn fetch(alloc: std.mem.Allocator, repo: []const u8, comptime extra: []const []const u8) ?[]const u8 {
            var argv: [5 + extra.len][]const u8 = undefined;
            argv[0] = "git";
            argv[1] = "-C";
            argv[2] = repo;
            argv[3] = "diff";
            argv[4] = "--staged";
            for (extra, 0..) |e, i| argv[5 + i] = e;
            const res = gate_helpers.runOut(alloc, argv[0 .. 5 + extra.len], null, null) orelse return null;
            return if (res.code == 0) res.out else null;
        }

        pub fn diffOf(self: *Staged, alloc: std.mem.Allocator, repo: []const u8) []const u8 {
            if (!self.diff_done) {
                self.diff_done = true;
                self.diff = fetch(alloc, repo, &.{});
            }
            return self.diff orelse "";  // same ""-diff semantics the pre-scope lazy fetch used
        }

        // null on fetch failure — a failed git read must not dismiss an
        // alarm; the caller rolls as usual on null.
        pub fn namesOf(self: *Staged, alloc: std.mem.Allocator, repo: []const u8) ?[]const u8 {
            if (!self.names_done) {
                self.names_done = true;
                const res = gate_helpers.runOut(alloc, &.{ "git", "-C", repo, "diff", "--staged", "--name-only" }, null, null) orelse return null;
                if (res.code == 0) self.names = res.out;
            }
            return self.names;
        }
    };

    // The row's scope verdict: null — no scope declared or the diff
    // touches it, roll as usual; a detail string — the diff carries
    // nothing in the census's domain and the roll is dismissed.
    pub fn oddsScopedOut(alloc: std.mem.Allocator, repo: []const u8, tags: []const u8, st: *Staged) ?[]const u8 {
        const scope = oddsScope(tags) orelse return null;
        const names = st.namesOf(alloc, repo) orelse return null;
        if (namesTouch(names, scope)) return null;
        return std.fmt.allocPrint(alloc, "no {s} staged — scope dismissed the roll", .{scope}) catch unreachable;
    }
};
