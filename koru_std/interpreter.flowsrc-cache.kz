// Koru Standard Library: the `flowsrc-cache` part of interpreter — the per-thread single-entry flow cache.
// Joined via `~part flowsrc-cache` in interpreter.kz; merged into the interpreter module
// at load.
//
// One entry, thread-local: the last parsed source and its Flow. The wire
// gate seeds it with the Flow parse.wire already built, so a gated
// dispatch runs that exact tree instead of parsing the same bytes again.

pub const InterpreterFlowCache = struct {
    threadlocal var inited: bool = false;
    threadlocal var arena: std.heap.ArenaAllocator = undefined;
    threadlocal var source_hash: u64 = 0;
    threadlocal var source_len: usize = 0;
    threadlocal var source_copy: []const u8 = &[_]u8{};
    threadlocal var flow: ast.Flow = undefined;
    threadlocal var has_flow: bool = false;

    pub fn getOrParse(source: []const u8) ?*const ast.Flow {
        if (!inited) {
            arena = std.heap.ArenaAllocator.init(std.heap.page_allocator);
            inited = true;
        }
        const hash = std.hash.Wyhash.hash(0, source);
        if (has_flow and source_len == source.len and source_hash == hash and std.mem.eql(u8, source, source_copy)) {
            return &flow;
        }

        _ = arena.reset(.retain_capacity);
        const allocator = arena.allocator();
        source_copy = allocator.dupe(u8, source) catch {
            has_flow = false;
            return null;
        };
        const parse_result = flow_parser.parseFlow(allocator, source_copy);
        switch (parse_result) {
            .flow => |f| {
                flow = f;
                has_flow = true;
                source_len = source.len;
                source_hash = hash;
                return &flow;
            },
            .err => {
                has_flow = false;
                return null;
            },
        }
    }

    /// Seed the cache with an already-parsed flow — the wire gate's
    /// parse.wire produces the Flow dispatch will run; storing it here lets
    /// the run skip a second parse of the same bytes and, better, execute
    /// the exact tree the gate admitted rather than a re-parse of it.
    pub fn put(source: []const u8, f: *const ast.Flow) void {
        if (!inited) {
            arena = std.heap.ArenaAllocator.init(std.heap.page_allocator);
            inited = true;
        }
        source_copy = source;
        source_len = source.len;
        source_hash = std.hash.Wyhash.hash(0, source);
        flow = f.*;
        has_flow = true;
    }
};
