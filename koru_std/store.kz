                for (arm.id_requests, 0..) |idn, ii| {
                    if (arm.fields.len + ii > 0) ap.appendSlice(allocator, ", ") catch unreachable;
                    const p = std.fmt.allocPrint(allocator, ".{s} = __koru_store_{s}.__koru_handle_of(__koru_new_row)", .{ idn, store_name }) catch unreachable;
                    ap.appendSlice(allocator, p) catch unreachable;
                }
                ap.appendSlice(allocator, " });\n") catch unreachable;
            }
            // Standing enters: a query subscribes inserts that FOLLOW it in
            // source. `__site_line` is comptime-constant per call site, so
            // the position check costs nothing at runtime. Preorder sites are
            // program-position WALKS, not subscriptions — no standing enter.
            for (qsites.items) |qs| {
                if (qs.is_preorder) continue;
                const call = std.fmt.allocPrint(allocator,
                    \\if (__site_line > {d}) {{
                    \\    {s}__store_qrow_{s}_L{d}_event.handler(.{{ .row = @as(i64, @intCast(__koru_new_row)) }});
                    \\}}
                    \\
                , .{ qs.line, emit_ns, store_name, qs.line }) catch unreachable;
                ap.appendSlice(allocator, call) catch unreachable;
            }
        }
        const append_text = ap.toOwnedSlice(allocator) catch unreachable;

        const mkInsertInput = struct {
            // An owned column's insert param CONSUMES the caller's obligation:
            // `<mod:!state>` (dot-canonical, the form the type's own bare states
            // canonicalize to). Ownership moves INTO the store; the phantom
            // checker rejects a value not holding <state!> (690_054). Generalized
            // past std/string — the module/state come from the discovered type.
            fn call(alloc: std.mem.Allocator, fnames: []const []const u8, ftypes: []const []const u8, foinfo: []const ?OwnedCol) []ast.Field {
                const fields = alloc.alloc(ast.Field, fnames.len + 1) catch unreachable;
                for (fnames, ftypes, foinfo, 0..) |fname, ftype, foi, i| {
                    fields[i] = ast.Field{
                        .name = alloc.dupe(u8, fname) catch unreachable,
                        .type = alloc.dupe(u8, ftype) catch unreachable,
                        .module_path = if (foi) |oi| alloc.dupe(u8, oi.module_slash) catch unreachable else null,
                        .phantom = if (foi) |oi| std.fmt.allocPrint(alloc, "{s}:!{s}", .{ oi.module_dot, oi.state }) catch unreachable else null,
                    };
                }
                fields[fnames.len] = ast.Field{ .name = alloc.dupe(u8, "__site_line") catch unreachable, .type = alloc.dupe(u8, "i64") catch unreachable };
                return fields;
            }
        }.call;

        // ---- unit 2: insert (void) + inserth (`| row i64`) ----
        {
            const insert_name = std.fmt.allocPrint(allocator, "__store_insert_{s}", .{store_name}) catch unreachable;
            appended_items.append(allocator, ast.Item{ .event_decl = ast.EventDecl{
                .path = H.mkPathH(allocator, home_ns, insert_name),
                .input = ast.Shape{ .fields = mkInsertInput(allocator, field_names[0..user_field_count], field_types[0..user_field_count], field_owned_info[0..user_field_count]) },
                .branches = &[_]ast.Branch{},
                .is_public = false,
                .is_implicit_flow = false,
                .annotations = &[_][]const u8{},
                .location = flow.location,
                .module = allocator.dupe(u8, flow.module) catch unreachable,
            } }) catch unreachable;
            const body = std.fmt.allocPrint(allocator, "{s}return;", .{append_text}) catch unreachable;
            appended_items.append(allocator, ast.Item{ .proc_decl = ast.ProcDecl{
                .path = H.mkPathH(allocator, home_ns, insert_name),
                .body = ast.Source{ .text = body, .location = flow.location, .scope = .{ .bindings = &[_]ast.ScopeBinding{} }, .phantom_type = null },
                .annotations = &[_][]const u8{},
                .target = allocator.dupe(u8, proc_target) catch unreachable,
                .location = flow.location,
                .module = allocator.dupe(u8, flow.module) catch unreachable,
            } }) catch unreachable;

            const inserth_name = std.fmt.allocPrint(allocator, "__store_inserth_{s}", .{store_name}) catch unreachable;
            const row_branches = allocator.alloc(ast.Branch, 1) catch unreachable;
            const row_pf = allocator.alloc(ast.Field, 1) catch unreachable;
            row_pf[0] = ast.Field{ .name = allocator.dupe(u8, "__type_ref") catch unreachable, .type = allocator.dupe(u8, "i64") catch unreachable };
            row_branches[0] = ast.Branch{
                .name = allocator.dupe(u8, "row") catch unreachable,
                .payload = ast.Shape{ .fields = row_pf },
                .kind = .terminal,
                // OPTIONAL. The handle is real information — 690_018 and
                // 690_059 take it and address the row with it — but the
                // overwhelming majority of inserts do not want it, and a
                // required branch made every one of them carry
                // `| row _ |> _`. A sparse consumer names only what it means.
                // `| full` stays REQUIRED: it hands a value back, and for an
                // owned column that value carries an obligation.
                .is_optional = true,
                .annotations = &[_][]const u8{},
            };
            appended_items.append(allocator, ast.Item{ .event_decl = ast.EventDecl{
                .path = H.mkPathH(allocator, home_ns, inserth_name),
                .input = ast.Shape{ .fields = mkInsertInput(allocator, field_names[0..user_field_count], field_types[0..user_field_count], field_owned_info[0..user_field_count]) },
                .branches = row_branches,
                .is_public = false,
                .is_implicit_flow = false,
                .annotations = &[_][]const u8{},
                .location = flow.location,
                .module = allocator.dupe(u8, flow.module) catch unreachable,
            } }) catch unreachable;
            const handle_expr = std.fmt.allocPrint(allocator, "__koru_store_{s}.__koru_handle_of(__koru_new_row)", .{store_name}) catch unreachable;
            const hbody = std.fmt.allocPrint(allocator, "{s}return {s};", .{ append_text, HS.branchOne(allocator, host_target, "row", handle_expr) }) catch unreachable;
            appended_items.append(allocator, ast.Item{ .proc_decl = ast.ProcDecl{
                .path = H.mkPathH(allocator, home_ns, inserth_name),
                .body = ast.Source{ .text = hbody, .location = flow.location, .scope = .{ .bindings = &[_]ast.ScopeBinding{} }, .phantom_type = null },
                .annotations = &[_][]const u8{},
                .target = allocator.dupe(u8, proc_target) catch unreachable,
                .location = flow.location,
                .module = allocator.dupe(u8, flow.module) catch unreachable,
            } }) catch unreachable;
        }


        // insertf: row + full — exhaustion is a BRANCH (O10, 690_011).
        // Owned stores (690_077): `| full` REISSUES every column (owned fields
        // with `<mod:state!>`, scalars bare) so the caller can free/keep the
        // value the insert consumed but the store never kept. Without that
        // give-back, an early return would silently leak the obligation.
        {
            const insertf_name = std.fmt.allocPrint(allocator, "__store_insertf_{s}", .{store_name}) catch unreachable;
            const f_branches = allocator.alloc(ast.Branch, 2) catch unreachable;
            const f_row_pf = allocator.alloc(ast.Field, 1) catch unreachable;
            f_row_pf[0] = ast.Field{ .name = allocator.dupe(u8, "__type_ref") catch unreachable, .type = allocator.dupe(u8, "i64") catch unreachable };
            f_branches[0] = ast.Branch{
                .name = allocator.dupe(u8, "row") catch unreachable,
                .payload = ast.Shape{ .fields = f_row_pf },
                .kind = .terminal,
                .is_optional = true,
                .annotations = &[_][]const u8{},
            };
            // Give-back payload: mirror take's owned `| item` — reissue
            // obligation on owned columns; scalars ride bare. Empty for a
            // scalar-only store (690_011).
            // Same rule as `| item` above: one owned column means the give-back is
            // the value itself, never a record wrapping it.
            const full_identity_owned = (user_field_count == 1 and std.mem.eql(u8, field_names[0], ast.STORE_IDENTITY_COLUMN)) or (has_owned and user_field_count == 1 and field_owned_info[0] != null);
            const f_full_pf: []ast.Field = if (full_identity_owned) blk: {
                const pf = allocator.alloc(ast.Field, 1) catch unreachable;
                // A scalar identity column carries no obligation to reissue, so
                // it rides bare — arity picks the SHAPE, ownership only decides
                // whether a phantom travels with it.
                pf[0] = if (field_owned_info[0]) |oi| ast.Field{
                    .name = allocator.dupe(u8, "__type_ref") catch unreachable,
                    .type = allocator.dupe(u8, field_types[0]) catch unreachable,
                    .module_path = allocator.dupe(u8, oi.module_slash) catch unreachable,
                    .phantom = std.fmt.allocPrint(allocator, "{s}:{s}!", .{ oi.module_dot, oi.state }) catch unreachable,
                } else ast.Field{
                    .name = allocator.dupe(u8, "__type_ref") catch unreachable,
                    .type = allocator.dupe(u8, field_types[0]) catch unreachable,
                };
                break :blk pf;
            } else if (has_owned) blk: {
                const pf = allocator.alloc(ast.Field, user_field_count) catch unreachable;
                for (field_names[0..user_field_count], field_types[0..user_field_count], field_owned_info[0..user_field_count], 0..) |pfname, pftype, pfoi, pfi| {
                    pf[pfi] = ast.Field{
                        .name = allocator.dupe(u8, pfname) catch unreachable,
                        .type = allocator.dupe(u8, pftype) catch unreachable,
                        .module_path = if (pfoi) |oi| allocator.dupe(u8, oi.module_slash) catch unreachable else null,
                        .phantom = if (pfoi) |oi| std.fmt.allocPrint(allocator, "{s}:{s}!", .{ oi.module_dot, oi.state }) catch unreachable else null,
                    };
                }
                break :blk pf;
            } else &[_]ast.Field{};
            f_branches[1] = ast.Branch{
                .name = allocator.dupe(u8, "full") catch unreachable,
                .payload = ast.Shape{ .fields = f_full_pf },
                .kind = .terminal,
                .annotations = &[_][]const u8{},
            };
            appended_items.append(allocator, ast.Item{ .event_decl = ast.EventDecl{
                .path = H.mkPathH(allocator, home_ns, insertf_name),
                .input = ast.Shape{ .fields = mkInsertInput(allocator, field_names[0..user_field_count], field_types[0..user_field_count], field_owned_info[0..user_field_count]) },
                .branches = f_branches,
                .is_public = false,
                .is_implicit_flow = false,
                .annotations = &[_][]const u8{},
                .location = flow.location,
                .module = allocator.dupe(u8, flow.module) catch unreachable,
            } }) catch unreachable;
            const fcheck = if (has_owned) blk: {
                var fb = std.ArrayList(u8).initCapacity(allocator, 128) catch unreachable;
                if (full_identity_owned) {
                    fb.appendSlice(allocator, std.fmt.allocPrint(allocator, "if (__koru_store_{s}.len >= {d}) return {s};\n", .{ store_name, CAP, HS.branchOne(allocator, host_target, "full", field_names[0]) }) catch unreachable) catch unreachable;
                } else {
                    var rb = std.ArrayList(u8).initCapacity(allocator, 128) catch unreachable;
                    for (field_names[0..user_field_count], 0..) |fname, fi| {
                        if (fi > 0) rb.appendSlice(allocator, ", ") catch unreachable;
                        rb.appendSlice(allocator, HS.recField(allocator, host_target, fname, fname)) catch unreachable;
                    }
                    const payload = HS.branchRec(allocator, host_target, "full", rb.toOwnedSlice(allocator) catch unreachable);
                    fb.appendSlice(allocator, std.fmt.allocPrint(allocator, "if (__koru_store_{s}.len >= {d}) return {s};\n", .{ store_name, CAP, payload }) catch unreachable) catch unreachable;
                }
                break :blk fb.toOwnedSlice(allocator) catch unreachable;
            } else
                std.fmt.allocPrint(allocator, "if (__koru_store_{s}.len >= {d}) return {s};\n", .{ store_name, CAP, HS.branchEmpty(allocator, host_target, "full") }) catch unreachable;
            const fhandle = std.fmt.allocPrint(allocator, "__koru_store_{s}.__koru_handle_of(__koru_new_row)", .{store_name}) catch unreachable;
            const fbody = std.fmt.allocPrint(allocator, "{s}{s}return {s};", .{ fcheck, append_text, HS.branchOne(allocator, host_target, "row", fhandle) }) catch unreachable;
            appended_items.append(allocator, ast.Item{ .proc_decl = ast.ProcDecl{
                .path = H.mkPathH(allocator, home_ns, insertf_name),
                .body = ast.Source{ .text = fbody, .location = flow.location, .scope = .{ .bindings = &[_]ast.ScopeBinding{} }, .phantom_type = null },
                .annotations = &[_][]const u8{},
                .target = allocator.dupe(u8, proc_target) catch unreachable,
                .location = flow.location,
                .module = allocator.dupe(u8, flow.module) catch unreachable,
            } }) catch unreachable;
        }

        // ---- unit 4: the row-addressed apply/write pair ((f), plural) ----
        // Generated for owned-column stores too (the WRITE rung, 690_062/063):
        // an owned column's write is discharge-old + consume-new — the apply
        // arm evicts the old pointer through the discovered canonical
        // discharger, then moves the caller's consumed value in. NOT generated
        // for a DRAIN store (ambiguous discharger, 690_057/058): the eviction
        // has no canonical discharger to fire, so `stored`/watch sites fail
        // loudly at their own transforms instead of silently leaking the old
        // value.
        if (!drain_required) {
            const papply_name = std.fmt.allocPrint(allocator, "__store_apply_{s}", .{store_name}) catch unreachable;
            const pwrite_name = std.fmt.allocPrint(allocator, "__store_write_{s}", .{store_name}) catch unreachable;

            // Per-field typed value slots (690_049): the write surface carries
            // one slot per column (`value_<i>: <column type>`), so a mixed
            // container reads/writes each column in its own type. `field`
            // (a comptime constant at every generated call site) selects the
            // live slot; the other slots ride as typed zeros no arm reads.
            // An owned column's value slot mirrors mkInsertInput: it CONSUMES
            // the caller's obligation (`<mod:!state>`, dot-canonical) — the
            // move-in half of the WRITE rung (690_062). The consume phantom
            // rides the USER-FACING `__store_write_*` event (with_consume);
            // the internal `__store_apply_*` hop receives the already-owned
            // plain pointer (module_path still resolves the host cell type).
            const mkWriteInput = struct {
                fn call(alloc: std.mem.Allocator, ftypes: []const []const u8, foinfo: []const ?OwnedCol, with_consume: bool) []ast.Field {
                    const fields = alloc.alloc(ast.Field, ftypes.len + 2) catch unreachable;
                    fields[0] = ast.Field{ .name = alloc.dupe(u8, "row") catch unreachable, .type = alloc.dupe(u8, "i64") catch unreachable };
                    fields[1] = ast.Field{ .name = alloc.dupe(u8, "field") catch unreachable, .type = alloc.dupe(u8, "i64") catch unreachable };
                    for (ftypes, foinfo, 0..) |ft, foi, i| {
                        fields[2 + i] = ast.Field{
                            .name = std.fmt.allocPrint(alloc, "value_{d}", .{i}) catch unreachable,
                            .type = alloc.dupe(u8, ft) catch unreachable,
                            .module_path = if (foi) |oi| alloc.dupe(u8, oi.module_slash) catch unreachable else null,
                            .phantom = if (foi) |oi|
                                (if (with_consume) std.fmt.allocPrint(alloc, "{s}:!{s}", .{ oi.module_dot, oi.state }) catch unreachable else null)
                            else
                                null,
                        };
                    }
                    return fields;
                }
            }.call;
            const in_fields = mkWriteInput(allocator, field_types, field_owned_info, false);

            const papply_branches = allocator.alloc(ast.Branch, field_names.len) catch unreachable;
            for (field_names, 0..) |fname, i| {
                const pf = allocator.alloc(ast.Field, 1) catch unreachable;
                // An owned field's arm payload is the query projection's BARE
                // borrow `*mod:Type<mod:state>` (no `!`, 690_060/063): the
                // watch arm reads the just-written value and consumes nothing;
                // the store keeps the live `<state!>` it frees at teardown.
                pf[0] = ast.Field{
                    .name = allocator.dupe(u8, "__type_ref") catch unreachable,
                    .type = allocator.dupe(u8, field_types[i]) catch unreachable,
                    .module_path = if (field_owned_info[i]) |oi| allocator.dupe(u8, oi.module_slash) catch unreachable else null,
                    .phantom = if (field_owned_info[i]) |oi| std.fmt.allocPrint(allocator, "{s}:{s}", .{ oi.module_dot, oi.state }) catch unreachable else null,
                };
                papply_branches[i] = ast.Branch{
                    .name = allocator.dupe(u8, fname) catch unreachable,
                    .payload = ast.Shape{ .fields = pf },
                    .kind = .terminal,
                    .annotations = &[_][]const u8{},
                };
            }
            appended_items.append(allocator, ast.Item{ .event_decl = ast.EventDecl{
                .path = H.mkPathH(allocator, home_ns, papply_name),
                .input = ast.Shape{ .fields = in_fields },
                .branches = papply_branches,
                .is_public = false,
                .is_implicit_flow = false,
                .annotations = &[_][]const u8{},
                .location = flow.location,
                .module = allocator.dupe(u8, flow.module) catch unreachable,
            } }) catch unreachable;

            var pbody = std.ArrayList(u8).initCapacity(allocator, 256) catch unreachable;
            // THE ROW ARG IS DENSE (O10.iv elision class): a handle caller
            // resolves at ITS call site (the stored transform emits the
            // resolve, so the 690_115 stale trap fires there, unchanged),
            // which is what lets a sweep arm pass its loop index straight
            // through — no handle round-trip in the hottest write loop.
            const papply_head = HS.rowHead(host_target);
            pbody.appendSlice(allocator, papply_head) catch unreachable;
            pbody.appendSlice(allocator, HS.switchHead(host_target)) catch unreachable;
            // `updated` lifecycle interceptors fire inside the write's atomic
            // step — after the cell write, before the field arm dispatches to
            // subscriptions — so no watch ever observes a row whose contract
            // (e.g. a maintained aggregate) hasn't settled. The pre-image read
            // is usage-synthesized ((c) lean): only an arm that binds
            // { old, new } materializes it; discard arms stay write-only.
            const updated_needs_old = blk: {
                for (updated_arms.items) |ua| {
                    if (ua.fields.len != 0) break :blk true;
                }
                break :blk false;
            };
            for (field_names, 0..) |fname, i| {
                var atext = std.ArrayList(u8).initCapacity(allocator, 128) catch unreachable;
                const head = HS.switchArmOpen(allocator, host_target, i);
                atext.appendSlice(allocator, head) catch unreachable;
                // TT2 (695_002): the [tree]-synthesized parent write carries a
                // DEFAULT-ON acyclicity guard — walk the new parent's ancestor
                // chain; hitting `row` means the reparent would make the row its
                // own ancestor. Unhandled, the guard is a loud panic (the mirror
                // of insert's `| full` default above). A site that handles
                // `| cycle` routes through __store_writec_*, which refuses the
                // write BEFORE this arm — a cycle can never reach here from it.
                if (is_tree and i == user_field_count) {
                    // `row` is dense; the ancestor chain carries HANDLES, so
                    // the self-compare reconstructs this row's handle once.
                    const guard = if (host_is_js)
                        std.fmt.allocPrint(allocator, "const __koru_self = __koru_store_{s}.__koru_handle_of(__koru_r); let __koru_cyc = value_{d}; while (__koru_cyc !== -1) {{ if (__koru_cyc === __koru_self) throw new Error(\"std/store:stored: reparent in [tree] store '{s}' would make the row its own ancestor (cycle) - the write is rejected; handle it with a `| cycle` branch (default-on guard and branch are pinned at 695_002)\"); const __koru_cycr = __koru_store_{s}.__koru_resolve(__koru_cyc); __koru_cyc = __koru_store_{s}.parent[__koru_cycr]; }} ", .{ store_name, i, store_name, store_name, store_name }) catch unreachable
                    else
                        std.fmt.allocPrint(allocator, "const __koru_self = __koru_store_{s}.__koru_handle_of(__koru_r); var __koru_cyc = value_{d}; while (__koru_cyc != -1) {{ if (__koru_cyc == __koru_self) @panic(\"std/store:stored: reparent in [tree] store '{s}' would make the row its own ancestor (cycle) - the write is rejected; handle it with a `| cycle` branch (default-on guard and branch are pinned at 695_002)\"); const __koru_cycr = __koru_store_{s}.__koru_resolve(__koru_cyc); __koru_cyc = __koru_store_{s}.parent[__koru_cycr]; }} ", .{ store_name, i, store_name, store_name, store_name }) catch unreachable;
                    atext.appendSlice(allocator, guard) catch unreachable;
                }
                if (updated_needs_old) {
                    // A char column's pre-image is COPIED before the write (a
                    // slice into the cell would observe the overwrite), then
                    // sliced to the first NUL — the `updated` payload's
                    // `string` shape.
                    const oldr = if (field_char_caps[i] != null and !host_is_js)
                        std.fmt.allocPrint(allocator, "const __koru_oldbuf = __koru_store_{s}.{s}[__koru_r]; const __koru_old = @import(\"std\").mem.sliceTo(&__koru_oldbuf, 0); ", .{ store_name, fname }) catch unreachable
                    else
                        std.fmt.allocPrint(allocator, "const __koru_old = __koru_store_{s}.{s}[__koru_r]; ", .{ store_name, fname }) catch unreachable;
                    atext.appendSlice(allocator, oldr) catch unreachable;
                }
                // An OWNED arm is discharge-old + consume-new (690_062): read
                // the OLD pointer UNCONDITIONALLY (eviction always needs it —
                // not gated on updated_needs_old, which serves the `updated`
                // interceptor's pre-image), fire the DISCOVERED canonical
                // discharger on it (the teardown call convention,
                // `<host>.<event>_event.handler`), then move the new pointer
                // in. The caller's <!state> was consumed at the write event.
                const wr = if (field_owned_info[i]) |oi| (if (host_is_js)
                    std.fmt.allocPrint(allocator, "const __koru_old_ptr = __koru_store_{s}.{s}[__koru_r]; {s}.{s}_event.handler({{ {s}: __koru_old_ptr }}); __koru_store_{s}.{s}[__koru_r] = value_{d}; ", .{ store_name, fname, oi.disch_host, oi.disch_event, oi.disch_param, store_name, fname, i }) catch unreachable
                else
                    std.fmt.allocPrint(allocator, "const __koru_old_ptr = __koru_store_{s}.{s}[__koru_r]; _ = {s}.{s}_event.handler(.{{ .{s} = __koru_old_ptr }}); __koru_store_{s}.{s}[__koru_r] = value_{d}; ", .{ store_name, fname, oi.disch_host, oi.disch_event, oi.disch_param, store_name, fname, i }) catch unreachable)
                else if (field_char_caps[i]) |n| (if (host_is_js)
                    // A JS char column is a string: the fixed-width buffer is a
                    // truncation and the zero-fill has no observable analogue.
                    std.fmt.allocPrint(allocator, "__koru_store_{s}.{s}[__koru_r] = value_{d}.slice(0, {d}); ", .{ store_name, fname, i, n }) catch unreachable
                else
                    std.fmt.allocPrint(allocator, "__koru_store_{s}.{s}[__koru_r] = @import(\"std\").mem.zeroes([{d}]u8); const __koru_wl = @min(value_{d}.len, {d}); @memcpy(__koru_store_{s}.{s}[__koru_r][0..__koru_wl], value_{d}[0..__koru_wl]); ", .{ store_name, fname, n, i, n, store_name, fname, i }) catch unreachable)
                else
                    std.fmt.allocPrint(allocator, "__koru_store_{s}.{s}[__koru_r] = value_{d}; ", .{ store_name, fname, i }) catch unreachable;
                atext.appendSlice(allocator, wr) catch unreachable;
                for (updated_arms.items, 0..) |ua, ai| {
                    const upd_payload = if (ua.fields.len != 0) blk_up: {
                        const nv = std.fmt.allocPrint(allocator, "value_{d}", .{i}) catch unreachable;
                        const pair = std.fmt.allocPrint(allocator, "{s}, {s}", .{
                            HS.recField(allocator, host_target, "old", "__koru_old"),
                            HS.recField(allocator, host_target, "new", nv),
                        }) catch unreachable;
                        break :blk_up HS.argRec(allocator, host_target, pair);
                    } else HS.argRec(allocator, host_target, "");
                    const call = std.fmt.allocPrint(allocator, "{s}__store_updated_{s}_{d}_event.handler({s}); ", .{ emit_ns, store_name, ai, upd_payload }) catch unreachable;
                    atext.appendSlice(allocator, call) catch unreachable;
                }
                // An owned arm dispatches the FRESH cell read, not the consumed
                // param (the 690_061 fresh-from-cell rule, 690_063): the watch
                // arm borrow-reads the value the store now owns.
                const arm_value = if (field_owned_info[i] != null)
                    HS.branchOne(allocator, host_target, fname, std.fmt.allocPrint(allocator, "__koru_store_{s}.{s}[__koru_r]", .{ store_name, fname }) catch unreachable)
                else
                    HS.branchOne(allocator, host_target, fname, std.fmt.allocPrint(allocator, "value_{d}", .{i}) catch unreachable);
                const tail = HS.switchArmClose(allocator, host_target, arm_value);
                atext.appendSlice(allocator, tail) catch unreachable;
                pbody.appendSlice(allocator, atext.items) catch unreachable;
            }
            pbody.appendSlice(allocator, HS.switchTail(allocator, host_target, papply_name, store_name)) catch unreachable;
            appended_items.append(allocator, ast.Item{ .proc_decl = ast.ProcDecl{
                .path = H.mkPathH(allocator, home_ns, papply_name),
                .body = ast.Source{ .text = pbody.toOwnedSlice(allocator) catch unreachable, .location = flow.location, .scope = .{ .bindings = &[_]ast.ScopeBinding{} }, .phantom_type = null },
                .annotations = &[_][]const u8{},
                .target = allocator.dupe(u8, proc_target) catch unreachable,
                .location = flow.location,
                .module = allocator.dupe(u8, flow.module) catch unreachable,
            } }) catch unreachable;

            const win_fields = mkWriteInput(allocator, field_types, field_owned_info, true);
            appended_items.append(allocator, ast.Item{ .event_decl = ast.EventDecl{
                .path = H.mkPathH(allocator, home_ns, pwrite_name),
                .input = ast.Shape{ .fields = win_fields },
                .branches = &[_]ast.Branch{},
                .is_public = false,
                .is_implicit_flow = false,
                .annotations = &[_][]const u8{},
                .location = flow.location,
                .module = allocator.dupe(u8, flow.module) catch unreachable,
            } }) catch unreachable;

            const wapply_args = allocator.alloc(ast.Arg, field_names.len + 2) catch unreachable;
            wapply_args[0] = ast.Arg{ .name = allocator.dupe(u8, "row") catch unreachable, .value = allocator.dupe(u8, "row") catch unreachable };
            wapply_args[1] = ast.Arg{ .name = allocator.dupe(u8, "field") catch unreachable, .value = allocator.dupe(u8, "field") catch unreachable };
            for (0..field_names.len) |i| {
                const vn = std.fmt.allocPrint(allocator, "value_{d}", .{i}) catch unreachable;
                wapply_args[2 + i] = ast.Arg{ .name = vn, .value = allocator.dupe(u8, vn) catch unreachable };
            }
            const wapply_inv = ast.Invocation{
                .path = H.mkPathH(allocator, home_ns, papply_name),
                .args = wapply_args,
            };

            var warms = std.ArrayList(ast.Continuation).initCapacity(allocator, field_names.len) catch unreachable;
            for (field_names, 0..) |fname, i| {
                var arm_body: ?ast.Continuation = null;
                for (pwatch_arms.items) |*wa| {
                    if (wa.field_idx == i) {
                        var a = ast_functional.cloneContinuation(allocator, &wa.cont) catch unreachable;
                        a.branch = allocator.dupe(u8, fname) catch unreachable;
                        a.kind = .terminal;
                        a.binding = if (wa.cont.binding) |b| allocator.dupe(u8, b) catch unreachable else allocator.dupe(u8, "_") catch unreachable;
                        arm_body = a;
                    }
                }
                // The unguarded fallthrough for this field: the write always
                // lands, and an absent — or guard-FALSE — watch is a no-op. A
                // guarded watch arm covers only the guard-TRUE case, so it needs
                // this sibling to complete the apply switch (mirrors the
                // singleton guarded-watch path).
                const noop_arm = ast.Continuation{
                    .branch = allocator.dupe(u8, fname) catch unreachable,
                    .binding = allocator.dupe(u8, "_") catch unreachable,
                    .kind = .terminal,
                    .condition = null,
                    .node = .terminal,
                    .indent = 1,
                    .continuations = &[_]ast.Continuation{},
                    .location = flow.location,
                };
                if (arm_body) |a| {
                    warms.append(allocator, a) catch unreachable;
                    if (a.condition != null) warms.append(allocator, noop_arm) catch unreachable;
                } else {
                    warms.append(allocator, noop_arm) catch unreachable;
                }
            }
            appended_items.append(allocator, ast.Item{ .flow = ast.Flow{
                .body = ast.rootSite(wapply_inv, warms.toOwnedSlice(allocator) catch unreachable, flow.location),
                .pre_label = null,
                .impl_of = H.mkPathH(allocator, home_ns, pwrite_name),
                .super_shape = null,
                .inline_body = null,
                .preamble_code = null,
                .is_pure = false,
                .is_transitively_pure = false,
                .location = flow.location,
                .module = allocator.dupe(u8, flow.module) catch unreachable,
            } }) catch unreachable;

            // ---- unit 4c (owned-containing stores): per-field TARGETED writes ----
            // The bundled surface above carries one value slot per column, a
            // dead slot riding as a typed zero — but an OWNED slot has no
            // typed zero (its value is a consumed obligation; nothing can
            // synthesize one), so a `done`-only write in a `{label: owned,
            // done: i64}` store could never fill `label`'s slot (690_064).
            // The fix is the `captured` model: DE-BUNDLE into one targeted
            // event per field, `__store_fwrite_<s>_<i>(row, value)`, threading
            // ONLY that field's value. A scalar write never references an
            // owned sibling's slot or its obligation; the owned field's own
            // write keeps consume-new on its single slot (discharge-old lives
            // in its apply arm, 690_062) and its watch arm fires off the
            // fresh cell read (690_063). The `stored` transform routes EVERY
            // row-addressed write of an owned-containing store here; the
            // bundled surface above remains as the discovery surface (field
            // order, column types, the watch-splice marker). The distinct
            // `fwrite`/`fapply` prefixes are load-bearing: store-name
            // discovery strips `__store_apply_`/`__store_write_` prefixes,
            // and a per-field name sharing them would parse as a bogus store.
            if (has_owned) {
                for (field_names, 0..) |fname, i| {
                    const fwrite_name = std.fmt.allocPrint(allocator, "__store_fwrite_{s}_{d}", .{ store_name, i }) catch unreachable;
                    const fapply_name = std.fmt.allocPrint(allocator, "__store_fapply_{s}_{d}", .{ store_name, i }) catch unreachable;

                    // fapply: the internal hop — an owned column's value is the
                    // already-owned plain pointer (module_path resolves the
                    // host cell type; no phantom), mirroring the bundled
                    // in_fields (with_consume=false).
                    const fa_in = allocator.alloc(ast.Field, 2) catch unreachable;
                    fa_in[0] = ast.Field{ .name = allocator.dupe(u8, "row") catch unreachable, .type = allocator.dupe(u8, "i64") catch unreachable };
                    fa_in[1] = ast.Field{
                        .name = allocator.dupe(u8, "value") catch unreachable,
                        .type = allocator.dupe(u8, field_types[i]) catch unreachable,
                        .module_path = if (field_owned_info[i]) |oi| allocator.dupe(u8, oi.module_slash) catch unreachable else null,
                    };
                    // The single arm carries the same bare-borrow payload as
                    // the bundled apply's arm for this field (690_060/063):
                    // the watch arm reads the just-written value, consuming
                    // nothing; the store keeps the live `<state!>`.
                    const fa_pf = allocator.alloc(ast.Field, 1) catch unreachable;
                    fa_pf[0] = ast.Field{
                        .name = allocator.dupe(u8, "__type_ref") catch unreachable,
                        .type = allocator.dupe(u8, field_types[i]) catch unreachable,
                        .module_path = if (field_owned_info[i]) |oi| allocator.dupe(u8, oi.module_slash) catch unreachable else null,
                        .phantom = if (field_owned_info[i]) |oi| std.fmt.allocPrint(allocator, "{s}:{s}", .{ oi.module_dot, oi.state }) catch unreachable else null,
                    };
                    const fa_branches = allocator.alloc(ast.Branch, 1) catch unreachable;
                    fa_branches[0] = ast.Branch{
                        .name = allocator.dupe(u8, fname) catch unreachable,
                        .payload = ast.Shape{ .fields = fa_pf },
                        .kind = .terminal,
                        .annotations = &[_][]const u8{},
                    };
                    appended_items.append(allocator, ast.Item{ .event_decl = ast.EventDecl{
                        .path = H.mkPathH(allocator, home_ns, fapply_name),
                        .input = ast.Shape{ .fields = fa_in },
                        .branches = fa_branches,
                        .is_public = false,
                        .is_implicit_flow = false,
                        .annotations = &[_][]const u8{},
                        .location = flow.location,
                        .module = allocator.dupe(u8, flow.module) catch unreachable,
                    } }) catch unreachable;

                    // The proc body is the bundled switch's arm for field i,
                    // straight-lined: `value` in place of `value_<i>`.
                    var fatext = std.ArrayList(u8).initCapacity(allocator, 256) catch unreachable;
                    // Dense row, same convention as the bundled apply above.
                    const fapply_head = allocator.dupe(u8, HS.rowHead(host_target)) catch unreachable;
                    fatext.appendSlice(allocator, fapply_head) catch unreachable;
                    if (is_tree and i == user_field_count) {
                        const fguard = std.fmt.allocPrint(allocator, "const __koru_self = __koru_store_{s}.__koru_handle_of(__koru_r); var __koru_cyc = value; while (__koru_cyc != -1) {{ if (__koru_cyc == __koru_self) @panic(\"std/store:stored: reparent in [tree] store '{s}' would make the row its own ancestor (cycle) - the write is rejected; handle it with a `| cycle` branch (default-on guard and branch are pinned at 695_002)\"); const __koru_cycr = __koru_store_{s}.__koru_resolve(__koru_cyc); __koru_cyc = __koru_store_{s}.parent[__koru_cycr]; }} ", .{ store_name, store_name, store_name, store_name }) catch unreachable;
                        fatext.appendSlice(allocator, fguard) catch unreachable;
                    }
                    if (updated_needs_old) {
                        const foldr = if (field_char_caps[i] != null)
                            std.fmt.allocPrint(allocator, "const __koru_oldbuf = __koru_store_{s}.{s}[__koru_r]; const __koru_old = @import(\"std\").mem.sliceTo(&__koru_oldbuf, 0); ", .{ store_name, fname }) catch unreachable
                        else
                            std.fmt.allocPrint(allocator, "const __koru_old = __koru_store_{s}.{s}[__koru_r]; ", .{ store_name, fname }) catch unreachable;
                        fatext.appendSlice(allocator, foldr) catch unreachable;
                    }
                    // An OWNED arm is discharge-old + consume-new (690_062);
                    // the caller's <!state> was consumed at the fwrite event.
                    const fwr = if (field_owned_info[i]) |oi|
                        std.fmt.allocPrint(allocator, "const __koru_old_ptr = __koru_store_{s}.{s}[__koru_r]; {s}{s}.{s}_event.handler({s}); __koru_store_{s}.{s}[__koru_r] = value; ", .{ store_name, fname, if (host_is_js) "" else "_ = ", oi.disch_host, oi.disch_event, HS.argRec(allocator, host_target, HS.recField(allocator, host_target, oi.disch_param, "__koru_old_ptr")), store_name, fname }) catch unreachable
                    else if (field_char_caps[i]) |n|
                        std.fmt.allocPrint(allocator, "__koru_store_{s}.{s}[__koru_r] = @import(\"std\").mem.zeroes([{d}]u8); const __koru_wl = @min(value.len, {d}); @memcpy(__koru_store_{s}.{s}[__koru_r][0..__koru_wl], value[0..__koru_wl]); ", .{ store_name, fname, n, n, store_name, fname }) catch unreachable
                    else
                        std.fmt.allocPrint(allocator, "__koru_store_{s}.{s}[__koru_r] = value; ", .{ store_name, fname }) catch unreachable;
                    fatext.appendSlice(allocator, fwr) catch unreachable;
                    for (updated_arms.items, 0..) |ua, ai| {
                        const fcall = if (ua.fields.len != 0)
                            std.fmt.allocPrint(allocator, "{s}__store_updated_{s}_{d}_event.handler({s}); ", .{ emit_ns, store_name, ai, HS.argRec(allocator, host_target, std.fmt.allocPrint(allocator, "{s}, {s}", .{ HS.recField(allocator, host_target, "old", "__koru_old"), HS.recField(allocator, host_target, "new", "value") }) catch unreachable) }) catch unreachable
                        else
                            std.fmt.allocPrint(allocator, "{s}__store_updated_{s}_{d}_event.handler({s}); ", .{ emit_ns, store_name, ai, HS.argRec(allocator, host_target, "") }) catch unreachable;
                        fatext.appendSlice(allocator, fcall) catch unreachable;
                    }
                    // An owned arm dispatches the FRESH cell read (690_061/063).
                    const ftail = if (field_owned_info[i] != null)
                        std.fmt.allocPrint(allocator, "return {s};", .{HS.branchOne(allocator, host_target, fname, std.fmt.allocPrint(allocator, "__koru_store_{s}.{s}[__koru_r]", .{ store_name, fname }) catch unreachable)}) catch unreachable
                    else
                        std.fmt.allocPrint(allocator, "return {s};", .{HS.branchOne(allocator, host_target, fname, "value")}) catch unreachable;
                    fatext.appendSlice(allocator, ftail) catch unreachable;
                    appended_items.append(allocator, ast.Item{ .proc_decl = ast.ProcDecl{
                        .path = H.mkPathH(allocator, home_ns, fapply_name),
                        .body = ast.Source{ .text = fatext.toOwnedSlice(allocator) catch unreachable, .location = flow.location, .scope = .{ .bindings = &[_]ast.ScopeBinding{} }, .phantom_type = null },
                        .annotations = &[_][]const u8{},
                        .target = allocator.dupe(u8, proc_target) catch unreachable,
                        .location = flow.location,
                        .module = allocator.dupe(u8, flow.module) catch unreachable,
                    } }) catch unreachable;

                    // fwrite: the user-facing event — the consume phantom
                    // (`<mod:!state>`) rides ONLY an owned field's own value.
                    const fw_in = allocator.alloc(ast.Field, 2) catch unreachable;
                    fw_in[0] = ast.Field{ .name = allocator.dupe(u8, "row") catch unreachable, .type = allocator.dupe(u8, "i64") catch unreachable };
                    fw_in[1] = ast.Field{
                        .name = allocator.dupe(u8, "value") catch unreachable,
                        .type = allocator.dupe(u8, field_types[i]) catch unreachable,
                        .module_path = if (field_owned_info[i]) |oi| allocator.dupe(u8, oi.module_slash) catch unreachable else null,
                        .phantom = if (field_owned_info[i]) |oi| std.fmt.allocPrint(allocator, "{s}:!{s}", .{ oi.module_dot, oi.state }) catch unreachable else null,
                    };
                    appended_items.append(allocator, ast.Item{ .event_decl = ast.EventDecl{
                        .path = H.mkPathH(allocator, home_ns, fwrite_name),
                        .input = ast.Shape{ .fields = fw_in },
                        .branches = &[_]ast.Branch{},
                        .is_public = false,
                        .is_implicit_flow = false,
                        .annotations = &[_][]const u8{},
                        .location = flow.location,
                        .module = allocator.dupe(u8, flow.module) catch unreachable,
                    } }) catch unreachable;

                    // The fwrite → fapply flow carries THIS field's watch arm
                    // (or the unguarded no-op fallthrough), mirroring the
                    // bundled warms loop one field at a time.
                    const fap_args = allocator.alloc(ast.Arg, 2) catch unreachable;
                    fap_args[0] = ast.Arg{ .name = allocator.dupe(u8, "row") catch unreachable, .value = allocator.dupe(u8, "row") catch unreachable };
                    fap_args[1] = ast.Arg{ .name = allocator.dupe(u8, "value") catch unreachable, .value = allocator.dupe(u8, "value") catch unreachable };
                    const fap_inv = ast.Invocation{
                        .path = H.mkPathH(allocator, home_ns, fapply_name),
                        .args = fap_args,
                    };
                    var fwarms = std.ArrayList(ast.Continuation).initCapacity(allocator, 2) catch unreachable;
                    var farm_body: ?ast.Continuation = null;
                    for (pwatch_arms.items) |*wa| {
                        if (wa.field_idx == i) {
                            var a = ast_functional.cloneContinuation(allocator, &wa.cont) catch unreachable;
                            a.branch = allocator.dupe(u8, fname) catch unreachable;
                            a.kind = .terminal;
                            a.binding = if (wa.cont.binding) |b| allocator.dupe(u8, b) catch unreachable else allocator.dupe(u8, "_") catch unreachable;
                            farm_body = a;
                        }
                    }
                    const fnoop_arm = ast.Continuation{
                        .branch = allocator.dupe(u8, fname) catch unreachable,
                        .binding = allocator.dupe(u8, "_") catch unreachable,
                        .kind = .terminal,
                        .condition = null,
                        .node = .terminal,
                        .indent = 1,
                        .continuations = &[_]ast.Continuation{},
                        .location = flow.location,
                    };
                    if (farm_body) |a| {
                        fwarms.append(allocator, a) catch unreachable;
                        if (a.condition != null) fwarms.append(allocator, fnoop_arm) catch unreachable;
                    } else {
                        fwarms.append(allocator, fnoop_arm) catch unreachable;
                    }
                    appended_items.append(allocator, ast.Item{ .flow = ast.Flow{
                        .body = ast.rootSite(fap_inv, fwarms.toOwnedSlice(allocator) catch unreachable, flow.location),
                        .pre_label = null,
                        .impl_of = H.mkPathH(allocator, home_ns, fwrite_name),
                        .super_shape = null,
                        .inline_body = null,
                        .preamble_code = null,
                        .is_pure = false,
                        .is_transitively_pure = false,
                        .location = flow.location,
                        .module = allocator.dupe(u8, flow.module) catch unreachable,
                    } }) catch unreachable;
                }
            }

            // ---- unit 4d: the row-addressed chain-envelope halves ----
            // A multi-field `stored` block is ONE atomic unit (the (i) lean,
            // 690_009): every write lands (write-only envwrite), THEN watch
            // dispatch runs in write order (announce, reading settled state).
            // These are the plural mirrors of the singleton envelope units —
            // row-addressed, one typed slot per column like the bundled
            // write. `updated` interceptors are the store's per-write
            // contract, not a subscription, so they fire inside envwrite's
            // atomic step (the (i) lean: cascades per-write, dispatch
            // deferred). An OWNED column has no typed zero for a dead slot
            // (690_064), so an owned-containing store gets no bundled
            // envelope; its multi-field block is refused toward chained
            // single-field writes.
            if (!has_owned) {
                const penvw_name = std.fmt.allocPrint(allocator, "__store_envwrite_{s}", .{store_name}) catch unreachable;
                const ppeek_name = std.fmt.allocPrint(allocator, "__store_peek_{s}", .{store_name}) catch unreachable;
                const pann_name = std.fmt.allocPrint(allocator, "__store_announce_{s}", .{store_name}) catch unreachable;

                // envwrite: row + field selector + per-column typed slots.
                appended_items.append(allocator, ast.Item{ .event_decl = ast.EventDecl{
                    .path = H.mkPathH(allocator, home_ns, penvw_name),
                    .input = ast.Shape{ .fields = mkWriteInput(allocator, field_types, field_owned_info, false) },
                    .branches = &[_]ast.Branch{},
                    .is_public = false,
                    .is_implicit_flow = false,
                    .annotations = &[_][]const u8{},
                    .location = flow.location,
                    .module = allocator.dupe(u8, flow.module) catch unreachable,
                } }) catch unreachable;
                var ewb = std.ArrayList(u8).initCapacity(allocator, 256) catch unreachable;
                // Dense row, same convention as the bundled apply above.
                // `field` CARRIES A BITMASK, not an index. The envelope is one
                // write (`frag-std-store-design`: "Writes interleave, never
                // overlap"), so the whole block lands in ONE call: every rhs is
                // an argument, all arguments are evaluated before the call, and
                // therefore every rhs reads PRE-STATE. Emitting a call per field
                // is what made a later entry read an earlier entry's result —
                // 690_126 pins that as red.
                //
                // It also deletes N-1 calls per block, each of which carried a
                // full-width payload of typed zeros.
                const ew_head = if (host_is_js)
                    allocator.dupe(u8, "const __koru_r = row;\nconst __koru_mask = field;\n") catch unreachable
                else
                    allocator.dupe(u8, "const __koru_r = @as(usize, @intCast(row));\nconst __koru_mask = @as(u64, @bitCast(field));\n") catch unreachable;
                ewb.appendSlice(allocator, ew_head) catch unreachable;
                // ONE COLUMN'S WRITE, built once and composed twice: guarded by
                // a mask bit in the general unit below, and unconditionally in
                // each specialisation after it. Two generators for one write
                // would be the drift this file has been bitten by before
                // (frag-a-fix-lands-in-one-lowering-path), so there is one.
                const col_arm = allocator.alloc([]const u8, field_names.len) catch unreachable;
                for (field_names, 0..) |fname, i| {
                    var ab = std.ArrayList(u8).initCapacity(allocator, 128) catch unreachable;
                    // The write half of the bundled apply arm, verbatim: tree
                    // guard, pre-image read, cell write, updated interceptors.
                    // No branch dispatch — that is announce's half.
                    if (is_tree and i == user_field_count) {
                        const eguard = std.fmt.allocPrint(allocator, "const __koru_self = __koru_store_{s}.__koru_handle_of(__koru_r); var __koru_cyc = value_{d}; while (__koru_cyc != -1) {{ if (__koru_cyc == __koru_self) @panic(\"std/store:stored: reparent in [tree] store '{s}' would make the row its own ancestor (cycle) - the write is rejected; handle it with a `| cycle` branch (default-on guard and branch are pinned at 695_002)\"); const __koru_cycr = __koru_store_{s}.__koru_resolve(__koru_cyc); __koru_cyc = __koru_store_{s}.parent[__koru_cycr]; }} ", .{ store_name, i, store_name, store_name, store_name }) catch unreachable;
                        ab.appendSlice(allocator, eguard) catch unreachable;
                    }
                    if (updated_needs_old) {
                        const eoldr = if (field_char_caps[i] != null)
                            std.fmt.allocPrint(allocator, "const __koru_oldbuf = __koru_store_{s}.{s}[__koru_r]; const __koru_old = @import(\"std\").mem.sliceTo(&__koru_oldbuf, 0); ", .{ store_name, fname }) catch unreachable
                        else
                            std.fmt.allocPrint(allocator, "const __koru_old = __koru_store_{s}.{s}[__koru_r]; ", .{ store_name, fname }) catch unreachable;
                        ab.appendSlice(allocator, eoldr) catch unreachable;
                    }
                    const ewr = if (field_char_caps[i]) |n|
                        std.fmt.allocPrint(allocator, "__koru_store_{s}.{s}[__koru_r] = @import(\"std\").mem.zeroes([{d}]u8); const __koru_wl = @min(value_{d}.len, {d}); @memcpy(__koru_store_{s}.{s}[__koru_r][0..__koru_wl], value_{d}[0..__koru_wl]); ", .{ store_name, fname, n, i, n, store_name, fname, i }) catch unreachable
                    else
                        std.fmt.allocPrint(allocator, "__koru_store_{s}.{s}[__koru_r] = value_{d}; ", .{ store_name, fname, i }) catch unreachable;
                    ab.appendSlice(allocator, ewr) catch unreachable;
                    for (updated_arms.items, 0..) |ua, ai| {
                        const ecall = if (ua.fields.len != 0)
                            std.fmt.allocPrint(allocator, "{s}__store_updated_{s}_{d}_event.handler({s}); ", .{ emit_ns, store_name, ai, HS.argRec(allocator, host_target, std.fmt.allocPrint(allocator, "{s}, {s}", .{ HS.recField(allocator, host_target, "old", "__koru_old"), HS.recField(allocator, host_target, "new", std.fmt.allocPrint(allocator, "value_{d}", .{i}) catch unreachable) }) catch unreachable) }) catch unreachable
                        else
                            std.fmt.allocPrint(allocator, "{s}__store_updated_{s}_{d}_event.handler({s}); ", .{ emit_ns, store_name, ai, HS.argRec(allocator, host_target, "") }) catch unreachable;
                        ab.appendSlice(allocator, ecall) catch unreachable;
                    }
                    col_arm[i] = ab.toOwnedSlice(allocator) catch unreachable;
                }
                for (field_names, 0..) |_, i| {
                    // BIT i OF THE MASK. JavaScript's bitwise operators coerce
                    // their operands to 32 bits, so `mask & (1 << i)` silently
                    // answers for the low 32 columns only — the same trap the
                    // `@popCount` lowering documents. Division by a power of two
                    // stays exact across the 53-bit safe range.
                    const arm_open = if (host_is_js)
                        std.fmt.allocPrint(allocator, "if (Math.floor(__koru_mask / {d}) % 2 === 1) {{ ", .{@as(u64, 1) << @intCast(i)}) catch unreachable
                    else
                        std.fmt.allocPrint(allocator, "if (__koru_mask & (@as(u64, 1) << {d}) != 0) {{ ", .{i}) catch unreachable;
                    ewb.appendSlice(allocator, arm_open) catch unreachable;
                    ewb.appendSlice(allocator, col_arm[i]) catch unreachable;
                    ewb.appendSlice(allocator, "}\n") catch unreachable;
                }
                ewb.appendSlice(allocator, "return;") catch unreachable;
                appended_items.append(allocator, ast.Item{ .proc_decl = ast.ProcDecl{
                    .path = H.mkPathH(allocator, home_ns, penvw_name),
                    .body = ast.Source{ .text = ewb.toOwnedSlice(allocator) catch unreachable, .location = flow.location, .scope = .{ .bindings = &[_]ast.ScopeBinding{} }, .phantom_type = null },
                    .annotations = &[_][]const u8{},
                    .target = allocator.dupe(u8, proc_target) catch unreachable,
                    .location = flow.location,
                    .module = allocator.dupe(u8, flow.module) catch unreachable,
                } }) catch unreachable;

                // ONE SPECIALISATION PER COLUMN SET the program actually writes.
                // Same arms, no mask, no dead slots — see `storeEnvwriteSpecName`
                // for the measurement that motivates it. A set the scan cannot
                // see simply is not emitted, and its site keeps calling the
                // general unit above: slower, never wrong.
                const spec_head = if (host_is_js)
                    "const __koru_r = row;\n"
                else
                    "const __koru_r = @as(usize, @intCast(row));\n";
                for (storeWriteColumnSets(allocator, program, store_name, field_names)) |set| {
                    const spec_name = storeEnvwriteSpecName(allocator, store_name, set);
                    const sp_in = allocator.alloc(ast.Field, set.len + 1) catch unreachable;
                    sp_in[0] = ast.Field{ .name = allocator.dupe(u8, "row") catch unreachable, .type = allocator.dupe(u8, "i64") catch unreachable };
                    for (set, 0..) |ci, k| {
                        // Named by COLUMN INDEX, not by position, so `col_arm`'s
                        // `value_<i>` references land unchanged.
                        sp_in[1 + k] = ast.Field{
                            .name = std.fmt.allocPrint(allocator, "value_{d}", .{ci}) catch unreachable,
                            .type = allocator.dupe(u8, field_types[ci]) catch unreachable,
                            .module_path = if (field_owned_info[ci]) |oi| allocator.dupe(u8, oi.module_slash) catch unreachable else null,
                        };
                    }
                    appended_items.append(allocator, ast.Item{ .event_decl = ast.EventDecl{
                        .path = H.mkPathH(allocator, home_ns, spec_name),
                        .input = ast.Shape{ .fields = sp_in },
                        .branches = &[_]ast.Branch{},
                        .is_public = false,
                        .is_implicit_flow = false,
                        .annotations = &[_][]const u8{},
                        .location = flow.location,
                        .module = allocator.dupe(u8, flow.module) catch unreachable,
                    } }) catch unreachable;
                    var sb = std.ArrayList(u8).initCapacity(allocator, 128) catch unreachable;
                    sb.appendSlice(allocator, spec_head) catch unreachable;
                    for (set) |ci| sb.appendSlice(allocator, col_arm[ci]) catch unreachable;
                    sb.appendSlice(allocator, "\nreturn;") catch unreachable;
                    appended_items.append(allocator, ast.Item{ .proc_decl = ast.ProcDecl{
                        .path = H.mkPathH(allocator, home_ns, spec_name),
                        .body = ast.Source{ .text = sb.toOwnedSlice(allocator) catch unreachable, .location = flow.location, .scope = .{ .bindings = &[_]ast.ScopeBinding{} }, .phantom_type = null },
                        .annotations = &[_][]const u8{},
                        .target = allocator.dupe(u8, proc_target) catch unreachable,
                        .location = flow.location,
                        .module = allocator.dupe(u8, flow.module) catch unreachable,
                    } }) catch unreachable;
                }

                // peek: read the CURRENT value at the row, answer the field
                // branch — announce's read half (the singleton peek, rowed).
                const ppk_in = allocator.alloc(ast.Field, 2) catch unreachable;
                ppk_in[0] = ast.Field{ .name = allocator.dupe(u8, "row") catch unreachable, .type = allocator.dupe(u8, "i64") catch unreachable };
                ppk_in[1] = ast.Field{ .name = allocator.dupe(u8, "field") catch unreachable, .type = allocator.dupe(u8, "i64") catch unreachable };
                const ppk_branches = allocator.alloc(ast.Branch, field_names.len) catch unreachable;
                for (field_names, 0..) |fname, i| {
                    const pkf = allocator.alloc(ast.Field, 1) catch unreachable;
                    pkf[0] = ast.Field{ .name = allocator.dupe(u8, "__type_ref") catch unreachable, .type = allocator.dupe(u8, field_types[i]) catch unreachable };
                    ppk_branches[i] = ast.Branch{
                        .name = allocator.dupe(u8, fname) catch unreachable,
                        .payload = ast.Shape{ .fields = pkf },
                        .kind = .terminal,
                        .annotations = &[_][]const u8{},
                    };
                }
                appended_items.append(allocator, ast.Item{ .event_decl = ast.EventDecl{
                    .path = H.mkPathH(allocator, home_ns, ppeek_name),
                    .input = ast.Shape{ .fields = ppk_in },
                    .branches = ppk_branches,
                    .is_public = false,
                    .is_implicit_flow = false,
                    .annotations = &[_][]const u8{},
                    .location = flow.location,
                    .module = allocator.dupe(u8, flow.module) catch unreachable,
                } }) catch unreachable;
                var pkb = std.ArrayList(u8).initCapacity(allocator, 256) catch unreachable;
                // Dense row, same convention as the bundled apply above.
                const pk_head = std.fmt.allocPrint(allocator, "{s}{s}", .{ HS.rowHead(host_target), HS.switchHead(host_target) }) catch unreachable;
                pkb.appendSlice(allocator, pk_head) catch unreachable;
                for (field_names, 0..) |fname, i| {
                    // A Zig char column is a `[N]u8` buffer and reads out as a
                    // slice to the first NUL; a JS char column is already the
                    // string, so there is nothing to slice.
                    const read_expr = if (field_char_caps[i] != null and !host_is_js)
                        std.fmt.allocPrint(allocator, "@import(\"std\").mem.sliceTo(&__koru_store_{s}.{s}[__koru_r], 0)", .{ store_name, fname }) catch unreachable
                    else
                        std.fmt.allocPrint(allocator, "__koru_store_{s}.{s}[__koru_r]", .{ store_name, fname }) catch unreachable;
                    const rd = std.fmt.allocPrint(allocator, "{s}{s}", .{
                        HS.switchArmOpen(allocator, host_target, i),
                        HS.switchArmClose(allocator, host_target, HS.branchOne(allocator, host_target, fname, read_expr)),
                    }) catch unreachable;
                    pkb.appendSlice(allocator, rd) catch unreachable;
                }
                pkb.appendSlice(allocator, HS.switchTail(allocator, host_target, ppeek_name, store_name)) catch unreachable;
                appended_items.append(allocator, ast.Item{ .proc_decl = ast.ProcDecl{
                    .path = H.mkPathH(allocator, home_ns, ppeek_name),
                    .body = ast.Source{ .text = pkb.toOwnedSlice(allocator) catch unreachable, .location = flow.location, .scope = .{ .bindings = &[_]ast.ScopeBinding{} }, .phantom_type = null },
                    .annotations = &[_][]const u8{},
                    .target = allocator.dupe(u8, proc_target) catch unreachable,
                    .location = flow.location,
                    .module = allocator.dupe(u8, flow.module) catch unreachable,
                } }) catch unreachable;

                // announce: the dispatch-only re-fire of the SAME watch arms
                // (fresh clones — the shared-pointer footgun is real), off the
                // peek read. Mirrors the bundled write's warms loop.
                const pann_in = allocator.alloc(ast.Field, 2) catch unreachable;
                pann_in[0] = ast.Field{ .name = allocator.dupe(u8, "row") catch unreachable, .type = allocator.dupe(u8, "i64") catch unreachable };
                pann_in[1] = ast.Field{ .name = allocator.dupe(u8, "field") catch unreachable, .type = allocator.dupe(u8, "i64") catch unreachable };
                appended_items.append(allocator, ast.Item{ .event_decl = ast.EventDecl{
                    .path = H.mkPathH(allocator, home_ns, pann_name),
                    .input = ast.Shape{ .fields = pann_in },
                    .branches = &[_]ast.Branch{},
                    .is_public = false,
                    .is_implicit_flow = false,
                    .annotations = &[_][]const u8{},
                    .location = flow.location,
                    .module = allocator.dupe(u8, flow.module) catch unreachable,
                } }) catch unreachable;
                const pann_args = allocator.alloc(ast.Arg, 2) catch unreachable;
                pann_args[0] = ast.Arg{ .name = allocator.dupe(u8, "row") catch unreachable, .value = allocator.dupe(u8, "row") catch unreachable };
                pann_args[1] = ast.Arg{ .name = allocator.dupe(u8, "field") catch unreachable, .value = allocator.dupe(u8, "field") catch unreachable };
                const pann_inv = ast.Invocation{
                    .path = H.mkPathH(allocator, home_ns, ppeek_name),
                    .args = pann_args,
                };
                var aarms = std.ArrayList(ast.Continuation).initCapacity(allocator, field_names.len) catch unreachable;
                // Does ANY arm actually observe this store? A column nobody
                // watches contributes `anoop_arm` — a terminal that binds `_`
                // and does nothing — so a store with no watch arms produces an
                // announce whose every arm is a no-op.
                var any_observer = false;
                for (field_names, 0..) |fname, i| {
                    var aarm_body: ?ast.Continuation = null;
                    for (pwatch_arms.items) |*wa| {
                        if (wa.field_idx == i) {
                            var a = ast_functional.cloneContinuation(allocator, &wa.cont) catch unreachable;
                            a.branch = allocator.dupe(u8, fname) catch unreachable;
                            a.kind = .terminal;
                            a.binding = if (wa.cont.binding) |b| allocator.dupe(u8, b) catch unreachable else allocator.dupe(u8, "_") catch unreachable;
                            aarm_body = a;
                        }
                    }
                    const anoop_arm = ast.Continuation{
                        .branch = allocator.dupe(u8, fname) catch unreachable,
                        .binding = allocator.dupe(u8, "_") catch unreachable,
                        .kind = .terminal,
                        .condition = null,
                        .node = .terminal,
                        .indent = 1,
                        .continuations = &[_]ast.Continuation{},
                        .location = flow.location,
                    };
                    if (aarm_body) |a| {
                        any_observer = true;
                        aarms.append(allocator, a) catch unreachable;
                        if (a.condition != null) aarms.append(allocator, anoop_arm) catch unreachable;
                    } else {
                        aarms.append(allocator, anoop_arm) catch unreachable;
                    }
                }
                if (!any_observer) {
                    // NOBODY IS LISTENING, so the dispatch is dead — but only
                    // one backend was deleting it. Emitted, announce reads the
                    // column back through `peek`, which allocates a BRANCH
                    // OBJECT (`{ tag: "px", px: … }`), and then tests its tag
                    // against every column and discards the payload. LLVM sees
                    // through the whole chain; V8 cannot, because the branch
                    // object is a real allocation with a real shape.
                    //
                    // Measured on 4096 rows x 50000 frames, two columns written
                    // per row: 2.78s -> 0.61s, a 4.5x whole-program speedup, and
                    // the Zig arm does not move because it never paid.
                    //
                    // The EVENT still exists and still carries `retain` — a raw
                    // host caller can dispatch it — and every write still calls
                    // it. Emptying the body is what pays: with the callee
                    // trivial, dropping the call sites measured 0.62s, i.e.
                    // nothing, because V8 inlines an empty method away. The
                    // cheap fix and the invasive one are worth the same, so this
                    // is the cheap one.
                    appended_items.append(allocator, ast.Item{ .proc_decl = ast.ProcDecl{
                        .path = H.mkPathH(allocator, home_ns, pann_name),
                        .body = ast.Source{ .text = allocator.dupe(u8, "return;") catch unreachable, .location = flow.location, .scope = .{ .bindings = &[_]ast.ScopeBinding{} }, .phantom_type = null },
                        .annotations = &[_][]const u8{},
                        .target = allocator.dupe(u8, proc_target) catch unreachable,
                        .location = flow.location,
                        .module = allocator.dupe(u8, flow.module) catch unreachable,
                    } }) catch unreachable;
                } else {
                    appended_items.append(allocator, ast.Item{ .flow = ast.Flow{
                        .body = ast.rootSite(pann_inv, aarms.toOwnedSlice(allocator) catch unreachable, flow.location),
                        .pre_label = null,
                        .impl_of = H.mkPathH(allocator, home_ns, pann_name),
                        .super_shape = null,
                        .inline_body = null,
                        .preamble_code = null,
                        .is_pure = false,
                        .is_transitively_pure = false,
                        .location = flow.location,
                        .module = allocator.dupe(u8, flow.module) catch unreachable,
                    } }) catch unreachable;
                }
            }
        }

        // ---- unit 4b ([tree] only): the cycle-guarded parent write ----
        // Mirror of insertf (exhaustion is a branch, 690_011): acyclicity is a
        // BRANCH. `__store_writec_*` answers `| ok` (the write landed, through
        // the ordinary write/apply/watch path) and `| cycle` (the write is
        // REFUSED, the tree left intact, the arm's continuation runs). The
        // stored transform targets this variant only when the site handles
        // `| cycle` on the synthesized parent write (TT2, pinned at 695_002).
        if (is_tree) {
            const pwritec_name = std.fmt.allocPrint(allocator, "__store_writec_{s}", .{store_name}) catch unreachable;
            const cin_fields = allocator.alloc(ast.Field, 3) catch unreachable;
            cin_fields[0] = ast.Field{ .name = allocator.dupe(u8, "row") catch unreachable, .type = allocator.dupe(u8, "i64") catch unreachable };
            cin_fields[1] = ast.Field{ .name = allocator.dupe(u8, "field") catch unreachable, .type = allocator.dupe(u8, "i64") catch unreachable };
            cin_fields[2] = ast.Field{ .name = allocator.dupe(u8, "value") catch unreachable, .type = allocator.dupe(u8, "i64") catch unreachable };
            const c_branches = allocator.alloc(ast.Branch, 2) catch unreachable;
            c_branches[0] = ast.Branch{
                .name = allocator.dupe(u8, "ok") catch unreachable,
                .payload = ast.Shape{ .fields = &[_]ast.Field{} },
                .kind = .terminal,
                .annotations = &[_][]const u8{},
            };
            c_branches[1] = ast.Branch{
                .name = allocator.dupe(u8, "cycle") catch unreachable,
                .payload = ast.Shape{ .fields = &[_]ast.Field{} },
                .kind = .terminal,
                .annotations = &[_][]const u8{},
            };
            appended_items.append(allocator, ast.Item{ .event_decl = ast.EventDecl{
                .path = H.mkPathH(allocator, home_ns, pwritec_name),
                .input = ast.Shape{ .fields = cin_fields },
                .branches = c_branches,
                .is_public = false,
                .is_implicit_flow = false,
                .annotations = &[_][]const u8{},
                .location = flow.location,
                .module = allocator.dupe(u8, flow.module) catch unreachable,
            } }) catch unreachable;
            // The forward fills every per-field slot: `value` lands in the
            // parent slot (writec guards ONLY the synthesized parent write —
            // the stored transform enforces target_field == "parent"); the
            // other slots are zeros the parent arm never reads.
            var cw_slots = std.ArrayList(u8).initCapacity(allocator, 64) catch unreachable;
            for (0..field_names.len) |ci| {
                cw_slots.appendSlice(allocator, ", ") catch unreachable;
                const slot = std.fmt.allocPrint(allocator, "value_{d}", .{ci}) catch unreachable;
                const val = if (ci == user_field_count)
                    "value"
                    // A char slot's typed zero is the empty string (the slot
                    // type is `string`); scalars ride comptime-int 0.
                else if (field_char_caps[ci] != null) "\"\"" else "0";
                cw_slots.appendSlice(allocator, HS.recField(allocator, host_target, slot, val)) catch unreachable;
            }
            // `row` arrives DENSE (the write-family convention; the stored
            // transform resolved the caller's handle at its call site). The
            // ancestor chain carries HANDLES, so the self-compare
            // reconstructs this row's handle once.
            const cbody = std.fmt.allocPrint(allocator,
                \\const __koru_self = __koru_store_{s}.__koru_handle_of({s});
                \\var __koru_cyc = value;
                \\while (__koru_cyc != -1) {{
                \\    if (__koru_cyc == __koru_self) return {s};
                \\    const __koru_cycr = __koru_store_{s}.__koru_resolve(__koru_cyc);
                \\    __koru_cyc = __koru_store_{s}.parent[__koru_cycr];
                \\}}
                \\{s}__store_write_{s}_event.handler({s});
                \\return {s};
            , .{
                store_name,
                HS.asIndex(allocator, host_target, "row"),
                HS.branchEmpty(allocator, host_target, "cycle"),
                store_name,
                store_name,
                emit_ns,
                store_name,
                HS.argRec(allocator, host_target, std.fmt.allocPrint(allocator, "{s}, {s}{s}", .{
                    HS.recField(allocator, host_target, "row", "row"),
                    HS.recField(allocator, host_target, "field", "field"),
                    cw_slots.items,
                }) catch unreachable),
                HS.branchEmpty(allocator, host_target, "ok"),
            }) catch unreachable;
            appended_items.append(allocator, ast.Item{ .proc_decl = ast.ProcDecl{
                .path = H.mkPathH(allocator, home_ns, pwritec_name),
                .body = ast.Source{ .text = cbody, .location = flow.location, .scope = .{ .bindings = &[_]ast.ScopeBinding{} }, .phantom_type = null },
                .annotations = &[_][]const u8{},
                .target = allocator.dupe(u8, proc_target) catch unreachable,
                .location = flow.location,
                .module = allocator.dupe(u8, flow.module) catch unreachable,
            } }) catch unreachable;
        }

        // ---- unit 3: per-query units (qrow / qbody / qsweep) ----
        for (qsites.items) |*qs| {
            const qrow_name = std.fmt.allocPrint(allocator, "__store_qrow_{s}_L{d}", .{ store_name, qs.line }) catch unreachable;
            const qbody_name = std.fmt.allocPrint(allocator, "__store_qbody_{s}_L{d}", .{ store_name, qs.line }) catch unreachable;
            const qsweep_name = std.fmt.allocPrint(allocator, "__store_qsweep_{s}_L{d}", .{ store_name, qs.line }) catch unreachable;

            // qrow: guard + projection over one row; fires the body event.
            const qrow_in = allocator.alloc(ast.Field, 1) catch unreachable;
            qrow_in[0] = ast.Field{ .name = allocator.dupe(u8, "row") catch unreachable, .type = allocator.dupe(u8, "i64") catch unreachable };
            const retain_ann = blk: {
                const anns = allocator.alloc([]const u8, 1) catch unreachable;
                anns[0] = allocator.dupe(u8, "retain") catch unreachable;
                break :blk anns;
            };
            appended_items.append(allocator, ast.Item{ .event_decl = ast.EventDecl{
                .path = H.mkPathH(allocator, home_ns, qrow_name),
                .input = ast.Shape{ .fields = qrow_in },
                .branches = &[_]ast.Branch{},
                .is_public = false,
                .is_implicit_flow = false,
                .annotations = retain_ann,
                .location = flow.location,
                .module = allocator.dupe(u8, flow.module) catch unreachable,
            } }) catch unreachable;

            var qr = std.ArrayList(u8).initCapacity(allocator, 256) catch unreachable;
            qr.appendSlice(allocator, HS.rowHead(host_target)) catch unreachable;
            for (qs.proj_names, qs.proj_fields) |pname, pfidx| {
                // A char column projects as a string slice into the cell —
                // the bytes up to the first NUL (zero-padded buffers trim;
                // an N-full buffer yields all N bytes). On JS the column IS a
                // string, and `_ = &x;` is Zig's discard, not JavaScript.
                const ld = if (host_is_js)
                    std.fmt.allocPrint(allocator, "const {s} = __koru_store_{s}.{s}[__koru_r];\n", .{ pname, store_name, field_names[pfidx] }) catch unreachable
                else if (field_char_caps[pfidx] != null)
                    std.fmt.allocPrint(allocator, "const {s} = @import(\"std\").mem.sliceTo(&__koru_store_{s}.{s}[__koru_r], 0);\n_ = &{s};\n", .{ pname, store_name, field_names[pfidx], pname }) catch unreachable
                else
                    std.fmt.allocPrint(allocator, "const {s} = __koru_store_{s}.{s}[__koru_r];\n_ = &{s};\n", .{ pname, store_name, field_names[pfidx], pname }) catch unreachable;
                qr.appendSlice(allocator, ld) catch unreachable;
            }
            // `[id]` — the visited row's HANDLE, bound before the guard so a
            // guard may name it too. `__koru_handle_of` is the same call the
            // taking-cursor path and the [tree] cycle guards already make at
            // this site, so this adds no machinery, only a name.
            if (qs.req_id) |idn| {
                const idz = if (host_is_js)
                    std.fmt.allocPrint(allocator, "const {s} = __koru_store_{s}.__koru_handle_of(__koru_r);\n", .{ idn, store_name }) catch unreachable
                else
                    std.fmt.allocPrint(allocator, "const {s} = __koru_store_{s}.__koru_handle_of(__koru_r);\n_ = &{s};\n", .{ idn, store_name, idn }) catch unreachable;
                qr.appendSlice(allocator, idz) catch unreachable;
            }
            if (qs.guard) |g| {
                // Cross-store reads lower to the cells HERE, at bake time: the
                // guard becomes host text in this proc, so the whole-program
                // walk (which lowers if-exprs and branch payloads later, on the
                // live AST) can never reach it again. Same scope the walk uses;
                // this store's own columns are bound (bindStrip left them bare),
                // so a store sharing a column's name is not misread.
                var gbound = std.ArrayList([]const u8).initCapacity(allocator, field_names.len + 2) catch unreachable;
                for (field_names) |fnm2| gbound.append(allocator, fnm2) catch unreachable;
                gbound.append(allocator, qs.cursor) catch unreachable;
                if (qs.req_id) |idn| gbound.append(allocator, idn) catch unreachable;
                const gscope = StoreScope{
                    .names = pstore_names.items,
                    .prefixes = blk_gpx: {
                        const px = allocator.alloc([]const u8, pstore_names.items.len) catch unreachable;
                        for (px) |*p| p.* = "";
                        break :blk_gpx px;
                    },
                };
                const g_cells = storeLowerText(allocator, program, g, gscope, pstore_identity.items, gbound.items);
                var unknown_op: []const u8 = "";
                const lowered_g = storeLowerExpr(allocator, g_cells, &unknown_op) orelse
                    return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, "std/store:query({s}): the guard names `@{s}`, and that operation has no lowering for this target - a store guard is a Koru expression, and the operations Koru names with `@` are the shared table in codegen_utils.lowerBuiltin", .{ store_name, unknown_op }) } };
                const gz = std.fmt.allocPrint(allocator, "if (!({s})) return;\n", .{lowered_g}) catch unreachable;
                qr.appendSlice(allocator, gz) catch unreachable;
            }
            qr.appendSlice(allocator, emit_ns) catch unreachable;
            qr.appendSlice(allocator, qbody_name) catch unreachable;
            qr.appendSlice(allocator, if (host_is_js) "_event.handler({ " else "_event.handler(.{ ") catch unreachable;
            for (qs.proj_names, qs.proj_fields, 0..) |pname, pfidx, i| {
                if (i > 0) qr.appendSlice(allocator, ", ") catch unreachable;
                // The qbody input an OWNED column projects to is mangled
                // (__koru_qproj_*) — the call key must match the event's input
                // name while the value is the qrow-local cell read the guard
                // sees by its bare name.
                const key = if (pfidx < field_owned_info.len and field_owned_info[pfidx] != null)
                    std.fmt.allocPrint(allocator, "__koru_qproj_{s}", .{pname}) catch unreachable
                else
                    pname;
                const p = HS.recField(allocator, host_target, key, pname);
                qr.appendSlice(allocator, p) catch unreachable;
            }
            if (qs.proj_names.len > 0) qr.appendSlice(allocator, ", ") catch unreachable;
            // The cursor the body receives. A taking pass gets a HANDLE (the
            // same value `| row` mints), so a take/stored head addressing
            // `store[cursor]` resolves it like any other handle and stays
            // correct across the swap-removes the body performs (690_031).
            // A pass that cannot remove gets the DENSE index straight — no
            // `handle_of` on the way in and no `__koru_resolve` on the way out,
            // which is the whole four-deep dependent-load chain gone.
            const qrow_cursor = if (qs.cursor_dense)
                std.fmt.allocPrint(allocator, "{s} ", .{HS.recField(allocator, host_target, qs.cursor, HS.asI64(allocator, host_target, "__koru_r"))}) catch unreachable
            else
                std.fmt.allocPrint(allocator, "{s} ", .{HS.recField(allocator, host_target, qs.cursor, std.fmt.allocPrint(allocator, "__koru_store_{s}.__koru_handle_of(__koru_r)", .{store_name}) catch unreachable)}) catch unreachable;
            qr.appendSlice(allocator, qrow_cursor) catch unreachable;
            if (qs.req_id) |idn| {
                const idc = std.fmt.allocPrint(allocator, ", {s} ", .{HS.recField(allocator, host_target, idn, idn)}) catch unreachable;
                qr.appendSlice(allocator, idc) catch unreachable;
            }
            qr.appendSlice(allocator, "});\nreturn;") catch unreachable;
            appended_items.append(allocator, ast.Item{ .proc_decl = ast.ProcDecl{
                .path = H.mkPathH(allocator, home_ns, qrow_name),
                .body = ast.Source{ .text = qr.toOwnedSlice(allocator) catch unreachable, .location = flow.location, .scope = .{ .bindings = &[_]ast.ScopeBinding{} }, .phantom_type = null },
                .annotations = &[_][]const u8{},
                .target = allocator.dupe(u8, proc_target) catch unreachable,
                .location = flow.location,
                .module = allocator.dupe(u8, flow.module) catch unreachable,
            } }) catch unreachable;

            // qbody: the transplanted body as an impl flow; inputs = the
            // projected names + the row cursor.
            const qbody_in = allocator.alloc(ast.Field, qs.proj_names.len + 1 + @as(usize, if (qs.req_id != null) 1 else 0)) catch unreachable;
            for (qs.proj_names, qs.proj_fields, 0..) |pname, pfidx, i| {
                // An owned column projects as a BARE borrow `*mod:Type<mod:state>`
                // (no `!`): `read` accepts the bare state and consumes nothing, so
                // the qbody carries no obligation to discharge and the store keeps
                // the live `<state!>` it frees at teardown. Scalars/char project
                // their value type directly.
                qbody_in[i] = if (field_owned_info[pfidx]) |oi| ast.Field{
                    // The input is MANGLED (__koru_qproj_) so the body can
                    // reference the phantom-carrying borrow without a body
                    // binding of the field's own name claiming it (the read
                    // path's srf_* reservation).
                    .name = std.fmt.allocPrint(allocator, "__koru_qproj_{s}", .{pname}) catch unreachable,
                    .type = allocator.dupe(u8, field_types[pfidx]) catch unreachable,
                    .module_path = allocator.dupe(u8, oi.module_slash) catch unreachable,
                    .phantom = std.fmt.allocPrint(allocator, "{s}:{s}", .{ oi.module_dot, oi.state }) catch unreachable,
                } else ast.Field{ .name = allocator.dupe(u8, pname) catch unreachable, .type = allocator.dupe(u8, field_types[pfidx]) catch unreachable };
            }
            qbody_in[qs.proj_names.len] = ast.Field{ .name = allocator.dupe(u8, qs.cursor) catch unreachable, .type = allocator.dupe(u8, "i64") catch unreachable };
            if (qs.req_id) |idn| {
                qbody_in[qs.proj_names.len + 1] = ast.Field{ .name = allocator.dupe(u8, idn) catch unreachable, .type = allocator.dupe(u8, "i64") catch unreachable };
            }
            appended_items.append(allocator, ast.Item{ .event_decl = ast.EventDecl{
                .path = H.mkPathH(allocator, home_ns, qbody_name),
                .input = ast.Shape{ .fields = qbody_in },
                .branches = &[_]ast.Branch{},
                .is_public = false,
                .is_implicit_flow = false,
                .annotations = retain_ann,
                .location = flow.location,
                .module = allocator.dupe(u8, flow.module) catch unreachable,
            } }) catch unreachable;

            const body_node = qs.body.node orelse {
                return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, "std/store:rule({s}): the query branch needs a body (`|> ...`)", .{store_name}) } };
            };
            if (body_node != .invocation) {
                return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, "std/store:rule({s}): the query body must start with an invocation this rung", .{store_name}) } };
            }
            appended_items.append(allocator, ast.Item{ .flow = ast.Flow{
                .body = ast.rootSite(body_node.invocation, qs.body.continuations, flow.location),
                .pre_label = null,
                .impl_of = H.mkPathH(allocator, home_ns, qbody_name),
                .super_shape = null,
                // A template root (`! row e |> if(...)`) carries its rendered
                // body on the INVOCATION (frozen by the per-call pass while it
                // was still nested under the arm). The transplant makes it the
                // flow's root, and the impl emitter reads the FLOW's
                // inline_body — promote it, or the emitter falls back to
                // calling a `koru_control.if_event` that is never emitted.
                .inline_body = body_node.invocation.inline_body,
                .preamble_code = null,
                .is_pure = false,
                .is_transitively_pure = false,
                .location = flow.location,
                .module = allocator.dupe(u8, flow.module) catch unreachable,
            } }) catch unreachable;

            // qsweep: the imperative sweep over the rows that exist when
            // the query's program position executes.
            appended_items.append(allocator, ast.Item{ .event_decl = ast.EventDecl{
                .path = H.mkPathH(allocator, home_ns, qsweep_name),
                .input = ast.Shape{ .fields = &[_]ast.Field{} },
                .branches = &[_]ast.Branch{},
                .is_public = false,
                .is_implicit_flow = false,
                .annotations = &[_][]const u8{},
                .location = flow.location,
                .module = allocator.dupe(u8, flow.module) catch unreachable,
            } }) catch unreachable;
            // The sweep tolerates a query body that REMOVES its own row (a
            // `take` under the query branch). swap-remove drops the last row
            // into the freed slot, so when the len shrinks we must re-check the
            // SAME index — the swapped-in row has not been seen — rather than
            // advance past it. A body that leaves len unchanged advances
            // normally, so non-mutating queries are byte-identical (690_031).
            //
            // A PREORDER site sweeps the forest in DFS pre-order instead
            // (695_STORE_TREE TT5): roots (parent == -1) in ascending
            // insertion order, each node emitted before its children,
            // children in ascending insertion order. Explicit stack, pushed
            // in reverse so the lowest index pops first; every row is pushed
            // at most once (as a root, or by its unique parent), so CAP
            // bounds the stack. The naive O(n^2) child scan is the
            // correctness rung.
            const sweep_body = if (host_is_js) (if (qs.is_preorder) std.fmt.allocPrint(allocator,
                \\const __koru_stack = new Array({d}).fill(0);
                \\let __koru_sp = 0;
                \\for (let __koru_ri = 0; __koru_ri < __koru_store_{s}.len; __koru_ri++) {{
                \\  const __koru_i = __koru_store_{s}.len - 1 - __koru_ri;
                \\  if (__koru_store_{s}.parent[__koru_i] === -1) {{
                \\    __koru_stack[__koru_sp] = __koru_i;
                \\    __koru_sp += 1;
                \\  }}
                \\}}
                \\while (__koru_sp > 0) {{
                \\  __koru_sp -= 1;
                \\  const __koru_cur = __koru_stack[__koru_sp];
                \\  {s}{s}_event.handler({{ row: __koru_cur }});
                \\  for (let __koru_rj = 0; __koru_rj < __koru_store_{s}.len; __koru_rj++) {{
                \\    const __koru_j = __koru_store_{s}.len - 1 - __koru_rj;
                \\    if (__koru_store_{s}.parent[__koru_j] === __koru_store_{s}.__koru_handle_of(__koru_cur)) {{
                \\      __koru_stack[__koru_sp] = __koru_j;
                \\      __koru_sp += 1;
                \\    }}
                \\  }}
                \\}}
                \\return;
            , .{ CAP, store_name, store_name, store_name, emit_ns, qrow_name, store_name, store_name, store_name, store_name }) catch unreachable else if (qs.may_remove) std.fmt.allocPrint(allocator,
                \\let __koru_i = 0;
                \\while (__koru_i < __koru_store_{s}.len) {{
                \\  const __koru_len_before = __koru_store_{s}.len;
                \\  {s}{s}_event.handler({{ row: __koru_i }});
                \\  if (__koru_store_{s}.len >= __koru_len_before) __koru_i += 1;
                \\}}
                \\return;
            , .{ store_name, store_name, emit_ns, qrow_name, store_name }) catch unreachable else std.fmt.allocPrint(allocator,
                \\for (let __koru_i = 0; __koru_i < __koru_store_{s}.len; __koru_i++) {{
                \\  {s}{s}_event.handler({{ row: __koru_i }});
                \\}}
                \\return;
            , .{ store_name, emit_ns, qrow_name }) catch unreachable) else if (qs.is_preorder) std.fmt.allocPrint(allocator,
                \\var __koru_stack: [{d}]usize = undefined;
                \\var __koru_sp: usize = 0;
                \\for (0..__koru_store_{s}.len) |__koru_ri| {{
                \\    const __koru_i = __koru_store_{s}.len - 1 - __koru_ri;
                \\    if (__koru_store_{s}.parent[__koru_i] == -1) {{
                \\        __koru_stack[__koru_sp] = __koru_i;
                \\        __koru_sp += 1;
                \\    }}
                \\}}
                \\while (__koru_sp > 0) {{
                \\    __koru_sp -= 1;
                \\    const __koru_cur = __koru_stack[__koru_sp];
                \\    {s}{s}_event.handler(.{{ .row = @as(i64, @intCast(__koru_cur)) }});
                \\    for (0..__koru_store_{s}.len) |__koru_rj| {{
                \\        const __koru_j = __koru_store_{s}.len - 1 - __koru_rj;
                \\        if (__koru_store_{s}.parent[__koru_j] == __koru_store_{s}.__koru_handle_of(__koru_cur)) {{
                \\            __koru_stack[__koru_sp] = __koru_j;
                \\            __koru_sp += 1;
                \\        }}
                \\    }}
                \\}}
                \\return;
            , .{ CAP, store_name, store_name, store_name, emit_ns, qrow_name, store_name, store_name, store_name, store_name }) catch unreachable else if (qs.may_remove) std.fmt.allocPrint(allocator,
                \\var __koru_i: usize = 0;
                \\while (__koru_i < __koru_store_{s}.len) {{
                \\    const __koru_len_before = __koru_store_{s}.len;
                \\    {s}{s}_event.handler(.{{ .row = @as(i64, @intCast(__koru_i)) }});
                \\    if (__koru_store_{s}.len >= __koru_len_before) __koru_i += 1;
                \\}}
                \\return;
            , .{ store_name, store_name, emit_ns, qrow_name, store_name }) catch unreachable else std.fmt.allocPrint(allocator,
                // A rule that cannot remove a row needs no removal tolerance,
                // so it gets the query path's loop: the trip count is read
                // once and the induction variable carries no dependency on a
                // load, which is what lets the pass vectorise at all.
                \\for (0..__koru_store_{s}.len) |__koru_i| {{
                \\    {s}{s}_event.handler(.{{ .row = @as(i64, @intCast(__koru_i)) }});
                \\}}
                \\return;
            , .{ store_name, emit_ns, qrow_name }) catch unreachable;
            appended_items.append(allocator, ast.Item{ .proc_decl = ast.ProcDecl{
                .path = H.mkPathH(allocator, home_ns, qsweep_name),
                .body = ast.Source{ .text = sweep_body, .location = flow.location, .scope = .{ .bindings = &[_]ast.ScopeBinding{} }, .phantom_type = null },
                .annotations = &[_][]const u8{},
                .target = allocator.dupe(u8, proc_target) catch unreachable,
                .location = flow.location,
                .module = allocator.dupe(u8, flow.module) catch unreachable,
            } }) catch unreachable;
        }

        // ---- unit 5: take — swap-remove through the handle head ----
        {
            const take_name = std.fmt.allocPrint(allocator, "__store_take_{s}", .{store_name}) catch unreachable;
            const take_in = allocator.alloc(ast.Field, 1) catch unreachable;
            take_in[0] = ast.Field{ .name = allocator.dupe(u8, "row") catch unreachable, .type = allocator.dupe(u8, "i64") catch unreachable };
            // Identity payload: the row VALUE. A BARE store mints NO obligation
            // (frictionless remove-with-value). An `[entity(<name>)]` store mints
            // the stable `<std/store:taken!>` obligation on the NAMED entity type
            // — the per-store disposal contract. The user then authors the
            // discharger consuming `<std/store:!taken>`; the store presumes nothing.
            // State is module-qualified (cross-module nameable); base type stays
            // on the user module via field.module_path so writeFieldType does not
            // confuse type-home with state-home (frag-std-store-design.md rung 2).
            // An owned-string store's take payload is a STRUCT of the row's
            // fields (not the identity `__type_ref` row) so the owned column
            // can REISSUE its obligation per field: `i.name` leaves take
            // holding <std.string:instance!> (dot-canonical — the form
            // std/string's own states canonicalize to today), and scope-exit
            // auto-discharge resolves the canonical discharger
            // (std/string:free) across the module boundary — the record-field
            // seeding both checkers already run on branch payloads.
            // A ONE-COLUMN owned store's row IS its column, so the give-back is an
            // IDENTITY payload — `| item *T<state!>` — not a record of one field.
            // Koru forbids a single-field record by construction (the only route
            // to one is narrowing, which invalidates the record reference), so
            // synthesizing `{ p: *Pending<open!> }` put a shape on the surface
            // that no author could have written. The record form exists to
            // REISSUE one obligation PER COLUMN; at one column there is one
            // obligation, which is exactly what an identity payload carries.
            // Auto-discharge is unaffected — an identity branch payload carrying
            // `<state!>` auto-frees at scope exit like any other (measured
            // 2026-07-28, and 690_053/055/056/059/065 are the witnesses).
            const item_identity_owned = (field_names.len == 1 and std.mem.eql(u8, field_names[0], ast.STORE_IDENTITY_COLUMN)) or (has_owned and field_names.len == 1 and field_owned_info[0] != null);
            const item_pf = if (item_identity_owned) blk: {
                const pf = allocator.alloc(ast.Field, 1) catch unreachable;
                // A scalar identity column carries no obligation to reissue, so
                // it rides bare — arity picks the SHAPE, ownership only decides
                // whether a phantom travels with it.
                pf[0] = if (field_owned_info[0]) |oi| ast.Field{
                    .name = allocator.dupe(u8, "__type_ref") catch unreachable,
                    .type = allocator.dupe(u8, field_types[0]) catch unreachable,
                    .module_path = allocator.dupe(u8, oi.module_slash) catch unreachable,
                    .phantom = std.fmt.allocPrint(allocator, "{s}:{s}!", .{ oi.module_dot, oi.state }) catch unreachable,
                } else ast.Field{
                    .name = allocator.dupe(u8, "__type_ref") catch unreachable,
                    .type = allocator.dupe(u8, field_types[0]) catch unreachable,
                };
                break :blk pf;
            } else if (has_owned) blk: {
                const pf = allocator.alloc(ast.Field, field_names.len) catch unreachable;
                for (field_names, field_types, field_owned_info, 0..) |pfname, pftype, pfoi, pfi| {
                    pf[pfi] = ast.Field{
                        .name = allocator.dupe(u8, pfname) catch unreachable,
                        .type = allocator.dupe(u8, pftype) catch unreachable,
                        .module_path = if (pfoi) |oi| allocator.dupe(u8, oi.module_slash) catch unreachable else null,
                        .phantom = if (pfoi) |oi| std.fmt.allocPrint(allocator, "{s}:{s}!", .{ oi.module_dot, oi.state }) catch unreachable else null,
                    };
                }
                break :blk pf;
            } else blk: {
                const pf = allocator.alloc(ast.Field, 1) catch unreachable;
                pf[0] = ast.Field{
                    .name = allocator.dupe(u8, "__type_ref") catch unreachable,
                    .type = if (entity_type) |et| allocator.dupe(u8, et) catch unreachable else std.fmt.allocPrint(allocator, "__KoruStoreRow_{s}", .{store_name}) catch unreachable,
                    .module_path = if (entity_type != null) allocator.dupe(u8, flow.module) catch unreachable else null,
                    .phantom = if (entity_type != null) allocator.dupe(u8, "std/store:taken!") catch unreachable else null,
                };
                break :blk pf;
            };
            const take_branches = allocator.alloc(ast.Branch, 2) catch unreachable;
            take_branches[0] = ast.Branch{
                .name = allocator.dupe(u8, "item") catch unreachable,
                .payload = ast.Shape{ .fields = item_pf },
                .kind = .terminal,
                .annotations = &[_][]const u8{},
            };
            // `| empty`: the addressed row is out of range (an empty store, or a
            // handle past len). is_panic (`?!`): a site that DOESN'T handle it
            // gets a synthesized panic — the exact old out-of-range behavior, so
            // every existing take site is unchanged — while a site that DOES
            // handle it (an interactive delete off an empty list) stays graceful.
            // No payload, so no obligation on this arm.
            take_branches[1] = ast.Branch{
                .name = allocator.dupe(u8, "empty") catch unreachable,
                .payload = ast.Shape{ .fields = &[_]ast.Field{} },
                .is_panic = true,
                .kind = .terminal,
                .annotations = &[_][]const u8{},
            };
            appended_items.append(allocator, ast.Item{ .event_decl = ast.EventDecl{
                .path = H.mkPathH(allocator, home_ns, take_name),
                .input = ast.Shape{ .fields = take_in },
                .branches = take_branches,
                .is_public = false,
                .is_implicit_flow = false,
                .annotations = &[_][]const u8{},
                .location = flow.location,
                .module = allocator.dupe(u8, flow.module) catch unreachable,
            } }) catch unreachable;

            var tb = std.ArrayList(u8).initCapacity(allocator, 256) catch unreachable;
            // `| empty` covers the whole is-not-a-live-row family — never
            // inserted, already taken, the -1 sentinel — because take ALREADY
            // has a branch surface for "the row is not there" (is_panic
            // default, graceful when handled — 690_070 pins a re-take of the
            // same address answering `| empty`). Reads and writes have no such
            // branch, which is why their stale path traps instead.
            // Zig's `orelse return` and JS's explicit null test are the same
            // guard. `null` is the only absence the JS `__koru_row_of` returns
            // (:2800) and row 0 is a real row, so the JS arm compares against
            // null rather than testing truthiness.
            const t_empty = HS.branchEmpty(allocator, host_target, "empty");
            const thead = if (host_is_js)
                std.fmt.allocPrint(allocator,
                    \\const __koru_r = __koru_store_{s}.__koru_row_of(row);
                    \\if (__koru_r === null) return {s};
                    \\const __koru_gone_slot = __koru_store_{s}.__koru_row_hslot[__koru_r];
                    \\
                , .{ store_name, t_empty, store_name }) catch unreachable
            else
                std.fmt.allocPrint(allocator,
                    \\const __koru_r = __koru_store_{s}.__koru_row_of(row) orelse return {s};
                    \\const __koru_gone_slot = __koru_store_{s}.__koru_row_hslot[__koru_r];
                    \\
                , .{ store_name, t_empty, store_name }) catch unreachable;
            tb.appendSlice(allocator, thead) catch unreachable;
            for (field_names) |fname| {
                const ld = std.fmt.allocPrint(allocator, "const __koru_out_{s} = __koru_store_{s}.{s}[__koru_r];\n", .{ fname, store_name, fname }) catch unreachable;
                tb.appendSlice(allocator, ld) catch unreachable;
            }
            // `removed` lifecycle interceptors fire before the swap-remove, with
            // the row's outgoing values (the qbody pattern, take side).
            for (removed_arms.items, 0..) |arm, ai| {
                const head = std.fmt.allocPrint(allocator, "{s}__store_removed_{s}_{d}_event.handler({s} ", .{ emit_ns, store_name, ai, if (host_is_js) "{" else ".{" }) catch unreachable;
                tb.appendSlice(allocator, head) catch unreachable;
                for (arm.fields, 0..) |fnm, fi| {
                    if (fi > 0) tb.appendSlice(allocator, ", ") catch unreachable;
                    // A char field's payload is the NUL-trimmed slice of the
                    // outgoing COPY (`__koru_out_*` outlives the handler call;
                    // the cell slot is about to be swap-clobbered).
                    const fnm_is_char = blk: {
                        for (field_names, field_char_caps) |cn, cc| {
                            if (std.mem.eql(u8, cn, fnm)) break :blk cc != null;
                        }
                        break :blk false;
                    };
                    const p = if (fnm_is_char)
                        HS.recField(allocator, host_target, fnm, std.fmt.allocPrint(allocator, "@import(\"std\").mem.sliceTo(&__koru_out_{s}, 0)", .{fnm}) catch unreachable)
                    else
                        HS.recField(allocator, host_target, fnm, std.fmt.allocPrint(allocator, "__koru_out_{s}", .{fnm}) catch unreachable);
                    tb.appendSlice(allocator, p) catch unreachable;
                }
                // The arm fires BEFORE the swap-remove and the generation bump,
                // so the dying row still resolves and its handle is the one the
                // observer was handed at insert. It goes stale immediately
                // after — which is the point: this is the last moment anything
                // keyed on that row can find its own entry to let go of.
                for (arm.id_requests, 0..) |idn, ii| {
                    if (arm.fields.len + ii > 0) tb.appendSlice(allocator, ", ") catch unreachable;
                    const p = HS.recField(allocator, host_target, idn, std.fmt.allocPrint(allocator, "__koru_store_{s}.__koru_handle_of(__koru_r)", .{store_name}) catch unreachable);
                    tb.appendSlice(allocator, p) catch unreachable;
                }
                tb.appendSlice(allocator, " });\n") catch unreachable;
            }
            const swap = std.fmt.allocPrint(allocator, "const __koru_last = __koru_store_{s}.len - 1;\nif (__koru_r != __koru_last) {{\n", .{store_name}) catch unreachable;
            tb.appendSlice(allocator, swap) catch unreachable;
            for (field_names) |fname| {
                const mv = std.fmt.allocPrint(allocator, "    __koru_store_{s}.{s}[__koru_r] = __koru_store_{s}.{s}[__koru_last];\n", .{ store_name, fname, store_name, fname }) catch unreachable;
                tb.appendSlice(allocator, mv) catch unreachable;
            }
            // The moved row's handle follows it: its sparse slot re-points at
            // the dense position it just landed in (O10.iii — handles stable
            // across other rows' removal), then the taken row's slot dies (one
            // generation bump) and returns to the freelist.
            const mvfix = std.fmt.allocPrint(allocator, "    const __koru_mv_slot = __koru_store_{s}.__koru_row_hslot[__koru_last];\n    __koru_store_{s}.__koru_hslot_row[__koru_mv_slot] = __koru_r;\n    __koru_store_{s}.__koru_row_hslot[__koru_r] = __koru_mv_slot;\n", .{ store_name, store_name, store_name }) catch unreachable;
            tb.appendSlice(allocator, mvfix) catch unreachable;
            // The generation bump WRAPS, and the two lanes wrap at DIFFERENT
            // PLACES for a reason that is not stylistic.
            //
            // Zig spells it `+%=` on a u32, so it wraps at 2^32 and the packed
            // handle stays exact at every value.
            //
            // JS has one number type, and a handle is assembled by ARITHMETIC
            // rather than by bit operations (see the note at the JS store's
            // decoder — `<< 32` is a no-op there). `gen * 4294967296` is exact
            // only while the product stays inside the double's exact-integer
            // range, and 2^21 * 2^32 IS 2^53. One generation past that, the
            // slot and brand in the low bits are ROUNDED AWAY: two different
            // LIVE rows encode to the same handle and resolve to whichever the
            // rounding picked. No brand mismatch, no generation mismatch, no
            // trap — the exact silent-wrong-row corruption the generation
            // counter exists to make impossible.
            //
            // So the JS counter wraps at 2^21. The aliasing that wrap admits
            // after 2^21 reuses of one slot is the same aliasing Zig already
            // admits at 2^32; what it removes is the window where the encoding
            // itself stopped being a bijection. Pinned at 690_270.
            const genbump: []const u8 = if (host_is_js)
                std.fmt.allocPrint(allocator, "= (__koru_store_{s}.__koru_hslot_gen[__koru_gone_slot] + 1) % 2097152", .{store_name}) catch unreachable
            else
                "+%= 1";
            const tail = std.fmt.allocPrint(allocator, "}}\n__koru_store_{s}.len = __koru_last;\n__koru_store_{s}.__koru_hslot_gen[__koru_gone_slot] {s};\n__koru_store_{s}.__koru_hslot_free[__koru_store_{s}.__koru_hslot_free_len] = __koru_gone_slot;\n__koru_store_{s}.__koru_hslot_free_len += 1;\n", .{ store_name, store_name, genbump, store_name, store_name, store_name }) catch unreachable;
            tb.appendSlice(allocator, tail) catch unreachable;
            if (item_identity_owned) {
                const o = std.fmt.allocPrint(allocator, "return {s};", .{HS.branchOne(allocator, host_target, "item", std.fmt.allocPrint(allocator, "__koru_out_{s}", .{field_names[0]}) catch unreachable)}) catch unreachable;
                tb.appendSlice(allocator, o) catch unreachable;
            } else {
                var ib = std.ArrayList(u8).initCapacity(allocator, 64) catch unreachable;
                for (field_names) |fname| {
                    if (ib.items.len > 0) ib.appendSlice(allocator, ", ") catch unreachable;
                    ib.appendSlice(allocator, HS.recField(allocator, host_target, fname, std.fmt.allocPrint(allocator, "__koru_out_{s}", .{fname}) catch unreachable)) catch unreachable;
                }
                const o = std.fmt.allocPrint(allocator, "return {s};", .{HS.branchRec(allocator, host_target, "item", ib.items)}) catch unreachable;
                tb.appendSlice(allocator, o) catch unreachable;
            }
            appended_items.append(allocator, ast.Item{ .proc_decl = ast.ProcDecl{
                .path = H.mkPathH(allocator, home_ns, take_name),
                .body = ast.Source{ .text = tb.toOwnedSlice(allocator) catch unreachable, .location = flow.location, .scope = .{ .bindings = &[_]ast.ScopeBinding{} }, .phantom_type = null },
                .annotations = &[_][]const u8{},
                .target = allocator.dupe(u8, proc_target) catch unreachable,
                .location = flow.location,
                .module = allocator.dupe(u8, flow.module) catch unreachable,
            } }) catch unreachable;
        }

        // ---- lifecycle interceptor units (inserted/removed, 690_016) ----
        // Each arm becomes an event whose inputs are its destructured row
        // fields plus an impl flow carrying the transplanted body (the qbody
        // pattern). `retain` keeps them alive — their only caller is the
        // generated host code in the insert/take procs. The store-name rewrite
        // is a no-op over `std/store:stored` invocations (they resolve their
        // own target) but keeps non-store body references (e.g. an interpolated
        // sibling-store read) coherent, matching watch-body treatment.
        {
            const LC = struct {
                fn emit(
                    alloc: std.mem.Allocator,
                    items: *std.ArrayList(ast.Item),
                    module: []const u8,
                    loc: anytype,
                    ev_name: []const u8,
                    arm_fields: []const []const u8,
                    arm_types: []const []const u8,
                    arm_owned: []const ?OwnedCol,
                    arm_body: *const ast.Continuation,
                    prog: *const ast.Program,
                    pnames: []const []const u8,
                    pident: []const []const u8,
                ) void {
                    const ev_in = alloc.alloc(ast.Field, arm_fields.len) catch unreachable;
                    for (arm_fields, arm_types, arm_owned, 0..) |fnm, ftp, aoi, fi| {
                        // An owned column binds into the reactive arm as a BARE
                        // borrow `*mod:Type<mod:state>` (no `!`): the interceptor
                        // reads it (read accepts the bare state, consumes nothing)
                        // while the store keeps the live <state!> it frees at
                        // teardown — 690_060's query projection, now in the
                        // `inserted` arm (690_061). Scalars/char bind their value.
                        ev_in[fi] = if (aoi) |oi| ast.Field{
                            .name = alloc.dupe(u8, fnm) catch unreachable,
                            .type = alloc.dupe(u8, ftp) catch unreachable,
                            .module_path = alloc.dupe(u8, oi.module_slash) catch unreachable,
                            .phantom = std.fmt.allocPrint(alloc, "{s}:{s}", .{ oi.module_dot, oi.state }) catch unreachable,
                        } else ast.Field{ .name = alloc.dupe(u8, fnm) catch unreachable, .type = alloc.dupe(u8, ftp) catch unreachable };
                    }
                    const retain = blk: {
                        const anns = alloc.alloc([]const u8, 1) catch unreachable;
                        anns[0] = alloc.dupe(u8, "retain") catch unreachable;
                        break :blk anns;
                    };
                    items.append(alloc, ast.Item{ .event_decl = ast.EventDecl{
                        .path = H.mkPathH(alloc, module, ev_name),
                        .input = ast.Shape{ .fields = ev_in },
                        .branches = &[_]ast.Branch{},
                        .is_public = false,
                        .is_implicit_flow = false,
                        .annotations = retain,
                        .location = loc,
                        .module = alloc.dupe(u8, module) catch unreachable,
                    } }) catch unreachable;
                    var body_clone = ast_functional.cloneContinuation(alloc, arm_body) catch unreachable;
                    const pscope = StoreScope{ .names = pnames, .prefixes = blk_lcpx: {
                        const px = alloc.alloc([]const u8, pnames.len) catch unreachable;
                        for (px) |*p| p.* = "";
                        break :blk_lcpx px;
                    } };
                    H.storeRefsContH(alloc, prog, &body_clone, pscope, pident, &[_][]const u8{});
                    const lbody_node = body_clone.node.?;
                    if (lbody_node == .inline_code) {
                        // A nested store-read site (query/rule/sweep) spliced
                        // its loop here BEFORE create ran (depth-first runner) —
                        // 690_093. The emitter's flow path assumes an
                        // invocation head, so this impl is a PROC: a proc impl
                        // binds every event input as a const, which is exactly
                        // how the loop's captures (the interceptor payload
                        // fields) resolve.
                        items.append(alloc, ast.Item{ .proc_decl = ast.ProcDecl{
                            .path = H.mkPathH(alloc, module, ev_name),
                            .body = ast.Source{ .text = lbody_node.inline_code, .location = loc, .scope = .{ .bindings = &[_]ast.ScopeBinding{} }, .phantom_type = null },
                            .annotations = &[_][]const u8{},
                            // Reads the target directly: this is a nested
                            // helper struct, which cannot capture `new|zig`'s
                            // local. The body is a nested store read's spliced
                            // loop, which `query` now renders for whichever
                            // host is being built, so the tag must follow it.
                            .target = alloc.dupe(u8, if (storeHostTarget() == .js) "js" else "zig") catch unreachable,
                            .location = loc,
                            .module = alloc.dupe(u8, module) catch unreachable,
                        } }) catch unreachable;
                        return;
                    }
                    // The arm body is walked DEPTH-FIRST, so a transform at its
                    // root has already fired by the time the store declaration
                    // transforms — and it left its expansion on the INVOCATION
                    // (`Invocation.inline_body`, the canonical slot). A flow
                    // root is emitted from `Flow.inline_body` instead
                    // (emitter_helpers.zig:4946); only a NESTED continuation is
                    // emitted from the invocation's slot (:9189). Rebuilding the
                    // arm as a flow root without carrying the expansion up drops
                    // it between the two, and the emitter falls through to a
                    // plain handler call — for `std/io:print` that is the
                    // shape-check reroute, a real handler that prints nothing.
                    // Silent, and indistinguishable from an arm that ran.
                    //
                    // This is the mirror of the migration the runner already
                    // does in the other direction when it grafts a flow into a
                    // nested site (transform_pass_runner.zig itemToNode).
                    const body_cont: ast.Continuation = ast.rootSite(lbody_node.invocation, body_clone.continuations, loc);
                    items.append(alloc, ast.Item{ .flow = ast.Flow{
                        .body = body_cont,
                        .pre_label = null,
                        .impl_of = H.mkPathH(alloc, module, ev_name),
                        .super_shape = null,
                        .inline_body = lbody_node.invocation.inline_body,
                        .preamble_code = lbody_node.invocation.preamble_code,
                        .is_pure = false,
                        .is_transitively_pure = false,
                        .location = loc,
                        .module = alloc.dupe(u8, module) catch unreachable,
                    } }) catch unreachable;
                }
            };
            // Interceptor payload types: inserted/removed bind ROW FIELDS by
            // name — each gets its column's type. updated binds {old, new} —
            // the written field's images; its bind form is walled to
            // uniform-typed containers above, so the shared column type is
            // exact (the discard form has no payload to type).
            const colTypes = struct {
                fn call(alloc: std.mem.Allocator, names: []const []const u8, types: []const []const u8, wanted: []const []const u8) []const []const u8 {
                    const out = alloc.alloc([]const u8, wanted.len) catch unreachable;
                    for (wanted, 0..) |w, i| {
                        out[i] = blk: {
                            for (names, types) |n, t| {
                                if (std.mem.eql(u8, n, w)) break :blk t;
                            }
                            unreachable; // arm fields were validated against field_names at collection
                        };
                    }
                    return out;
                }
            }.call;
            // Parallel of colTypes: the OwnedCol info per arm field (null for
            // scalar/char), so the reactive arm binds an owned column as a bare
            // borrow (690_061). Non-owned stores get all-null — a no-op.
            const colOwned = struct {
                fn call(alloc: std.mem.Allocator, names: []const []const u8, owned: []const ?OwnedCol, wanted: []const []const u8) []const ?OwnedCol {
                    const out = alloc.alloc(?OwnedCol, wanted.len) catch unreachable;
                    for (wanted, 0..) |w, i| {
                        out[i] = blk: {
                            for (names, owned) |n, o| {
                                if (std.mem.eql(u8, n, w)) break :blk o;
                            }
                            break :blk null;
                        };
                    }
                    return out;
                }
            }.call;
            // A `[id]` request rides the arm's input as one more field. It has
            // no column to resolve against, so its type is stated here (a
            // handle is i64, the type `| row` mints) and its ownedness is
            // null — a handle is a value, never a resource the arm borrows.
            const withIds = struct {
                fn names(alloc: std.mem.Allocator, cols: []const []const u8, ids: []const []const u8) []const []const u8 {
                    const out = alloc.alloc([]const u8, cols.len + ids.len) catch unreachable;
                    for (cols, 0..) |c, i| out[i] = c;
                    for (ids, 0..) |d, i| out[cols.len + i] = d;
                    return out;
                }
                fn types(alloc: std.mem.Allocator, cols: []const []const u8, n_ids: usize) []const []const u8 {
                    const out = alloc.alloc([]const u8, cols.len + n_ids) catch unreachable;
                    for (cols, 0..) |c, i| out[i] = c;
                    for (0..n_ids) |i| out[cols.len + i] = "i64";
                    return out;
                }
                fn owned(alloc: std.mem.Allocator, cols: []const ?OwnedCol, n_ids: usize) []const ?OwnedCol {
                    const out = alloc.alloc(?OwnedCol, cols.len + n_ids) catch unreachable;
                    for (cols, 0..) |c, i| out[i] = c;
                    for (0..n_ids) |i| out[cols.len + i] = null;
                    return out;
                }
            };
            for (inserted_arms.items, 0..) |*arm, ai| {
                const ev_name = std.fmt.allocPrint(allocator, "__store_inserted_{s}_{d}", .{ store_name, ai }) catch unreachable;
                LC.emit(allocator, &appended_items, flow.module, flow.location, ev_name, withIds.names(allocator, arm.fields, arm.id_requests), withIds.types(allocator, colTypes(allocator, field_names, field_types, arm.fields), arm.id_requests.len), withIds.owned(allocator, colOwned(allocator, field_names, field_owned_info, arm.fields), arm.id_requests.len), &arm.body, program, pstore_names.items, pstore_identity.items);
            }
            for (removed_arms.items, 0..) |*arm, ai| {
                const ev_name = std.fmt.allocPrint(allocator, "__store_removed_{s}_{d}", .{ store_name, ai }) catch unreachable;
                LC.emit(allocator, &appended_items, flow.module, flow.location, ev_name, withIds.names(allocator, arm.fields, arm.id_requests), withIds.types(allocator, colTypes(allocator, field_names, field_types, arm.fields), arm.id_requests.len), withIds.owned(allocator, colOwned(allocator, field_names, field_owned_info, arm.fields), arm.id_requests.len), &arm.body, program, pstore_names.items, pstore_identity.items);
            }
            // `cleared` binds only a count, so its type is stated rather
            // than looked up — there is no column behind it.
            for (cleared_arms.items, 0..) |*arm, ai| {
                const ev_name = std.fmt.allocPrint(allocator, "__store_cleared_{s}_{d}", .{ store_name, ai }) catch unreachable;
                const ctypes = allocator.alloc([]const u8, arm.fields.len) catch unreachable;
                for (ctypes) |*ct| ct.* = "i64";
                const cowned = allocator.alloc(?OwnedCol, arm.fields.len) catch unreachable;
                for (cowned) |*co| co.* = null;
                LC.emit(allocator, &appended_items, flow.module, flow.location, ev_name, arm.fields, ctypes, cowned, &arm.body, program, pstore_names.items, pstore_identity.items);
            }
            for (updated_arms.items, 0..) |*arm, ai| {
                const ev_name = std.fmt.allocPrint(allocator, "__store_updated_{s}_{d}", .{ store_name, ai }) catch unreachable;
                const utypes = allocator.alloc([]const u8, arm.fields.len) catch unreachable;
                for (utypes) |*ut| ut.* = if (field_types.len > 0) field_types[0] else "i64";
                LC.emit(allocator, &appended_items, flow.module, flow.location, ev_name, arm.fields, utypes, colOwned(allocator, field_names, field_owned_info, arm.fields), &arm.body, program, pstore_names.items, pstore_identity.items);
            }
        }

        // Rung 0 (per-store disposal contract): the store provides NO disposal
        // verb. A BARE store's `take` carries no obligation (frictionless). When
        // a store opts in via `[entity(<name>)]`, `take` mints `<std/store:taken!>`
        // on the named row type and the USER authors the discharger (the despawn
        // handler consuming `<!std/store:taken>`) — the store never presumes how
        // to dispose. (give-back / destroy as store-provided verbs are retired.)

        // ---- clear unit: __store_clear_<s> empties the store in one step ----
        //
        // The bulk twin of `take`. `take` is O(1) per row and fires `removed`
        // per row; emptying a store that way costs the OBSERVER a thousand
        // events, which is the whole expense — measured at 92% of a
        // thousand-row clear in the DOM gauntlet, where each event went
        // looking for its own DOM node.
        //
        // Emitted ONLY where it is unambiguous, and the two gaps refuse loudly
        // rather than doing something defensible-looking:
        //   - a store with OWNED columns: every row carries an obligation that
        //     must be discharged one at a time. A bulk reset would drop them
        //     on the floor and the leak would be silent. Such a store keeps
        //     `take` plus `! discharge`.
        //   - a store with a `! removed` arm and NO `! cleared` arm: clear does
        //     not fire `removed` (that is what makes it bulk), so an observer
        //     would silently stop being told. Declaring `! cleared` is the
        //     author saying what the aggregate means.
        // Where neither applies the unit is absent, and the verb says why.
        //
        // Handles outstanding across a clear must go stale. The brand is a
        // COMPILE-TIME CONSTANT naming which store issued a handle — bumping it
        // would break cross-store discrimination, not invalidate anything — so
        // the generation of every live slot is bumped instead. That is one
        // pass over a small array with no observer dispatch and no host work,
        // which is exactly the cost being removed.
        {
            const clear_legal = !has_owned and (removed_arms.items.len == 0 or cleared_arms.items.len > 0);
            if (clear_legal) {
                const clr_name = std.fmt.allocPrint(allocator, "__store_clear_{s}", .{store_name}) catch unreachable;
                appended_items.append(allocator, ast.Item{ .event_decl = ast.EventDecl{
                    .path = H.mkPathH(allocator, home_ns, clr_name),
                    .input = ast.Shape{ .fields = &[_]ast.Field{} },
                    .branches = &[_]ast.Branch{},
                    .is_public = false,
                    .is_implicit_flow = false,
                    .annotations = &[_][]const u8{},
                    .location = flow.location,
                    .module = allocator.dupe(u8, flow.module) catch unreachable,
                } }) catch unreachable;

                var cb = std.ArrayList(u8).initCapacity(allocator, 512) catch unreachable;
                // The count is read BEFORE the reset; it is the only thing an
                // aggregate arm can be handed, since no row survives to read.
                // Only bound when an arm names it — Zig refuses an unused
                // local, and `! cleared _` is the ordinary discard form.
                var wants_count = false;
                for (cleared_arms.items) |ca| {
                    if (ca.fields.len > 0) wants_count = true;
                }
                if (wants_count) {
                const cnt_decl = if (host_is_js)
                    std.fmt.allocPrint(allocator, "const __koru_n = __koru_store_{s}.len;\n", .{store_name}) catch unreachable
                else
                    std.fmt.allocPrint(allocator, "const __koru_n: i64 = @as(i64, @intCast(__koru_store_{s}.len));\n", .{store_name}) catch unreachable;
                cb.appendSlice(allocator, cnt_decl) catch unreachable;
                }
                // Trip count is known before the loop starts, so this is a
                // `for` (see CLAUDE.md — it is measurable, not style).
                const genloop = if (host_is_js)
                    std.fmt.allocPrint(allocator,
                        \\for (let __koru_i = 0; __koru_i < __koru_store_{s}.__koru_hslot_next; __koru_i++) {{
                        \\  __koru_store_{s}.__koru_hslot_gen[__koru_i] = (__koru_store_{s}.__koru_hslot_gen[__koru_i] + 1) % 2097152;
                        \\}}
                        \\
                    , .{ store_name, store_name, store_name }) catch unreachable
                else
                    std.fmt.allocPrint(allocator,
                        \\for (0..__koru_store_{s}.__koru_hslot_next) |__koru_i| {{
                        \\    __koru_store_{s}.__koru_hslot_gen[__koru_i] +%= 1;
                        \\}}
                        \\
                    , .{ store_name, store_name }) catch unreachable;
                cb.appendSlice(allocator, genloop) catch unreachable;
                const reset = std.fmt.allocPrint(allocator,
                    \\__koru_store_{s}.len = 0;
                    \\__koru_store_{s}.__koru_hslot_free_len = 0;
                    \\__koru_store_{s}.__koru_hslot_next = 0;
                    \\
                , .{ store_name, store_name, store_name }) catch unreachable;
                cb.appendSlice(allocator, reset) catch unreachable;
                // The arm fires AFTER the store is empty: `cleared` is a
                // past-tense fact about the whole store, and a body that could
                // still see rows would be describing a half-done operation.
                for (cleared_arms.items, 0..) |arm, ai| {
                    const call = if (arm.fields.len == 0)
                        std.fmt.allocPrint(allocator, "{s}__store_cleared_{s}_{d}_event.handler({s});\n", .{ emit_ns, store_name, ai, if (host_is_js) "{}" else ".{}" }) catch unreachable
                    else
                        std.fmt.allocPrint(allocator, "{s}__store_cleared_{s}_{d}_event.handler({s} {s} __koru_n }});\n", .{ emit_ns, store_name, ai, if (host_is_js) "{" else ".{", if (host_is_js) std.fmt.allocPrint(allocator, "{s}:", .{arm.fields[0]}) catch unreachable else std.fmt.allocPrint(allocator, ".{s} =", .{arm.fields[0]}) catch unreachable }) catch unreachable;
                    cb.appendSlice(allocator, call) catch unreachable;
                }
                appended_items.append(allocator, ast.Item{ .proc_decl = ast.ProcDecl{
                    .path = H.mkPathH(allocator, home_ns, clr_name),
                    .body = ast.Source{ .text = cb.toOwnedSlice(allocator) catch unreachable, .location = flow.location, .scope = .{ .bindings = &[_]ast.ScopeBinding{} }, .phantom_type = null },
                    .annotations = &[_][]const u8{},
                    .target = allocator.dupe(u8, proc_target) catch unreachable,
                    .location = flow.location,
                    .module = allocator.dupe(u8, flow.module) catch unreachable,
                } }) catch unreachable;
            }
        }

        // ---- stripe unit: __store_stripe_<s> fires the standing rules'
        // qsweeps in depends_on topo order (rung: naive per-rule passes;
        // fusion is a later, semantics-preserving scheduling change). With
        // zero rules the unit is a void no-op, so stripe of a rule-less
        // store is legal and does nothing. The existing stripe VERB rewrite
        // targets this unit wherever the call sits — including inlined
        // effect-branch bodies (the per-frame firing point).
        {
            const pstripe_name = std.fmt.allocPrint(allocator, "__store_stripe_{s}", .{store_name}) catch unreachable;
            appended_items.append(allocator, ast.Item{ .event_decl = ast.EventDecl{
                .path = H.mkPathH(allocator, home_ns, pstripe_name),
                .input = ast.Shape{ .fields = &[_]ast.Field{} },
                .branches = &[_]ast.Branch{},
                .is_public = false,
                .is_implicit_flow = false,
                .annotations = &[_][]const u8{},
                .location = flow.location,
                .module = allocator.dupe(u8, flow.module) catch unreachable,
            } }) catch unreachable;
            // Preorder walks are program-position traversals, never standing
            // rules — they do not join the stripe.
            {
                var filtered = std.ArrayList(usize).initCapacity(allocator, stripe_order.items.len) catch unreachable;
                for (stripe_order.items) |qi| {
                    if (!qsites.items[qi].is_preorder) filtered.append(allocator, qi) catch unreachable;
                }
                stripe_order = filtered;
            }
            if (stripe_order.items.len == 0) {
                appended_items.append(allocator, ast.Item{ .proc_decl = ast.ProcDecl{
                    .path = H.mkPathH(allocator, home_ns, pstripe_name),
                    .body = ast.Source{ .text = allocator.dupe(u8, "return;") catch unreachable, .location = flow.location, .scope = .{ .bindings = &[_]ast.ScopeBinding{} }, .phantom_type = null },
                    .annotations = &[_][]const u8{},
                    .target = allocator.dupe(u8, proc_target) catch unreachable,
                    .location = flow.location,
                    .module = allocator.dupe(u8, flow.module) catch unreachable,
                } }) catch unreachable;
            } else {
                // Impl flow: qsweep calls chained as sequential void steps,
                // nested back-to-front so execution follows stripe_order.
                var chain: ?ast.Continuation = null;
                var k = stripe_order.items.len;
                while (k > 1) : (k -= 1) {
                    const qidx = stripe_order.items[k - 1];
                    const qn = std.fmt.allocPrint(allocator, "__store_qsweep_{s}_L{d}", .{ store_name, qsites.items[qidx].line }) catch unreachable;
                    var step = ast.Continuation{
                        .branch = allocator.dupe(u8, "") catch unreachable,
                        .binding = null,
                        .kind = .terminal,
                        .condition = null,
                        .node = .{ .invocation = ast.Invocation{
                            .path = H.mkPathH(allocator, home_ns, qn),
                            .args = &[_]ast.Arg{},
                        } },
                        .indent = 1,
                        .continuations = &[_]ast.Continuation{},
                        .is_transformed_subtree = true,
                        .location = flow.location,
                    };
                    if (chain) |c| {
                        const kids = allocator.alloc(ast.Continuation, 1) catch unreachable;
                        kids[0] = c;
                        step.continuations = kids;
                    }
                    chain = step;
                }
                const head_name = std.fmt.allocPrint(allocator, "__store_qsweep_{s}_L{d}", .{ store_name, qsites.items[stripe_order.items[0]].line }) catch unreachable;
                const head_inv = ast.Invocation{
                    .path = H.mkPathH(allocator, home_ns, head_name),
                    .args = &[_]ast.Arg{},
                };
                var head_conts: []ast.Continuation = &[_]ast.Continuation{};
                if (chain) |c| {
                    const kids = allocator.alloc(ast.Continuation, 1) catch unreachable;
                    kids[0] = c;
                    head_conts = kids;
                }
                appended_items.append(allocator, ast.Item{ .flow = ast.Flow{
                    .body = ast.rootSite(head_inv, head_conts, flow.location),
                    .pre_label = null,
                    .impl_of = H.mkPathH(allocator, home_ns, pstripe_name),
                    .super_shape = null,
                    .inline_body = null,
                    .preamble_code = null,
                    .is_pure = false,
                    .is_transitively_pure = false,
                    .location = flow.location,
                    .module = allocator.dupe(u8, flow.module) catch unreachable,
                } }) catch unreachable;
            }
        }

        // ---- teardown unit (owned-string stores only, 690_053) ----
        // The store OWNS its live elements; at program end each still-live
        // owned pointer is discharged through the canonical discharger's
        // handler (std/string:free — the same call auto-discharge inserts,
        // 690_036's cross-module resolution done at generation time). The
        // teardown FLOW is appended LAST, and appended items land at the END
        // of program.items (transform_pass_runner), so it runs after every
        // user flow — before the emitter's leak check.
        if (has_owned) {
            const td_name = std.fmt.allocPrint(allocator, "__store_teardown_{s}", .{store_name}) catch unreachable;
            // Arity picks the payload shape. Same predicate as `| item`
            // (store.kz:2653): the store's ONLY column, and it owned.
            const discharge_identity_owned = field_names.len == 1 and (field_owned_info[0] != null or std.mem.eql(u8, field_names[0], ast.STORE_IDENTITY_COLUMN));
            // Drain (690_057): the teardown event declares the `! discharge`
            // EFFECT branch (the 400_105 producer shape). Its payload is the
            // ROW RECORD — every column as a field, the ambiguous owned
            // fields carrying `<state!>` (dot-canonical, the take-item form)
            // so the phantom checker FORCES the user's handler to discharge
            // each fired element. That per-element forcing IS the drain
            // enforcement; the store adds no manual check.
            var td_branches: []ast.Branch = &[_]ast.Branch{};
            if (drain_required) {
                // ONE column means the drain payload is the VALUE, not a record
                // around it — the same arity rule `| item` and `| full` carry
                // (store.kz:2653, :1892). The loop below reissues one obligation
                // PER COLUMN; at one column it ran once and produced a
                // single-field record, which is a shape no author could have
                // written. The per-field reissue reason from 2026-07-21 is real
                // and survives at two columns — see 690_097, the control.
                const dpf: []ast.Field = if (discharge_identity_owned) blk: {
                    const pf = allocator.alloc(ast.Field, 1) catch unreachable;
                    pf[0] = if (field_owned_info[0]) |oi| ast.Field{
                        .name = allocator.dupe(u8, "__type_ref") catch unreachable,
                        .type = allocator.dupe(u8, field_types[0]) catch unreachable,
                        .module_path = allocator.dupe(u8, oi.module_slash) catch unreachable,
                        .phantom = std.fmt.allocPrint(allocator, "{s}:{s}!", .{ oi.module_dot, oi.state }) catch unreachable,
                    } else ast.Field{
                        .name = allocator.dupe(u8, "__type_ref") catch unreachable,
                        .type = allocator.dupe(u8, field_types[0]) catch unreachable,
                    };
                    break :blk pf;
                } else blk: {
                    const pf = allocator.alloc(ast.Field, field_names.len) catch unreachable;
                    for (field_names, field_types, field_owned_info, 0..) |pfname, pftype, pfoi, pfi| {
                        pf[pfi] = ast.Field{
                            .name = allocator.dupe(u8, pfname) catch unreachable,
                            .type = allocator.dupe(u8, pftype) catch unreachable,
                            .module_path = if (pfoi) |oi| allocator.dupe(u8, oi.module_slash) catch unreachable else null,
                            .phantom = if (pfoi) |oi| std.fmt.allocPrint(allocator, "{s}:{s}!", .{ oi.module_dot, oi.state }) catch unreachable else null,
                        };
                    }
                    break :blk pf;
                };
                const tdb = allocator.alloc(ast.Branch, 1) catch unreachable;
                tdb[0] = ast.Branch{
                    .name = allocator.dupe(u8, "discharge") catch unreachable,
                    .payload = ast.Shape{ .fields = dpf },
                    .kind = .effect,
                };
                td_branches = tdb;
            }
            appended_items.append(allocator, ast.Item{ .event_decl = ast.EventDecl{
                .path = H.mkPathH(allocator, home_ns, td_name),
                .input = ast.Shape{ .fields = &[_]ast.Field{} },
                .branches = td_branches,
                .is_public = false,
                .is_implicit_flow = false,
                .annotations = &[_][]const u8{},
                .location = flow.location,
                .module = allocator.dupe(u8, flow.module) catch unreachable,
            } }) catch unreachable;
            var td = std.ArrayList(u8).initCapacity(allocator, 256) catch unreachable;
            const td_head = HS.loopHead(allocator, host_target, "__koru_i", std.fmt.allocPrint(allocator, "__koru_store_{s}.len", .{store_name}) catch unreachable);
            td.appendSlice(allocator, td_head) catch unreachable;
            if (drain_required) {
                // Fire the user's `! discharge` handler with the row record —
                // the 400_105 producer move (`make(r)`), record payload per
                // 400_079: `discharge(.{ .f = col[i], ... })`. Ownership of
                // each ambiguous element moves OUT through the payload; the
                // handler is forced to discharge it within the firing.
                if (discharge_identity_owned) {
                    // The value itself — the payload shape above is the column,
                    // not a record wrapping it, so the call must match.
                    const p = std.fmt.allocPrint(allocator, "    discharge(__koru_store_{s}.{s}[__koru_i]);\n", .{ store_name, field_names[0] }) catch unreachable;
                    td.appendSlice(allocator, p) catch unreachable;
                } else {
                    var db = std.ArrayList(u8).initCapacity(allocator, 64) catch unreachable;
                    for (field_names) |fname| {
                        if (db.items.len > 0) db.appendSlice(allocator, ", ") catch unreachable;
                        db.appendSlice(allocator, HS.recField(allocator, host_target, fname, std.fmt.allocPrint(allocator, "__koru_store_{s}.{s}[__koru_i]", .{ store_name, fname }) catch unreachable)) catch unreachable;
                    }
                    const p = std.fmt.allocPrint(allocator, "    discharge({s});\n", .{HS.argRec(allocator, host_target, db.items)}) catch unreachable;
                    td.appendSlice(allocator, p) catch unreachable;
                }
            } else {
                for (field_names, field_owned_info) |fname, foi| {
                    const oi = foi orelse continue;
                    // Discharge each live element through the DISCOVERED canonical
                    // discharger: <host>.<event>_event.handler(.{ .<param> = elem }),
                    // the same `<name>_event.handler` convention every emitted call
                    // uses (buildKoruModulePath). std/string's `free` is just one
                    // instance; a user *Resource routes to its own `free`/`close`.
                    const fr = std.fmt.allocPrint(allocator, "    {s}{s}.{s}_event.handler({s});\n", .{ if (host_is_js) "" else "_ = ", oi.disch_host, oi.disch_event, HS.argRec(allocator, host_target, HS.recField(allocator, host_target, oi.disch_param, std.fmt.allocPrint(allocator, "__koru_store_{s}.{s}[__koru_i]", .{ store_name, fname }) catch unreachable)) }) catch unreachable;
                    td.appendSlice(allocator, fr) catch unreachable;
                }
            }
            const td_tail = std.fmt.allocPrint(allocator, "}}\n__koru_store_{s}.len = 0;\nreturn;", .{store_name}) catch unreachable;
            td.appendSlice(allocator, td_tail) catch unreachable;
            appended_items.append(allocator, ast.Item{ .proc_decl = ast.ProcDecl{
                .path = H.mkPathH(allocator, home_ns, td_name),
                .body = ast.Source{ .text = td.toOwnedSlice(allocator) catch unreachable, .location = flow.location, .scope = .{ .bindings = &[_]ast.ScopeBinding{} }, .phantom_type = null },
                .annotations = &[_][]const u8{},
                .target = allocator.dupe(u8, proc_target) catch unreachable,
                .location = flow.location,
                .module = allocator.dupe(u8, flow.module) catch unreachable,
            } }) catch unreachable;
            const td_inv = ast.Invocation{
                .path = H.mkPathH(allocator, home_ns, td_name),
                .args = &[_]ast.Arg{},
            };
            // The user's `! discharge item |> ...` continuation rides the
            // teardown flow as its handler — the consumer half of 400_105
            // (`! make r |> destroy(r)`), verbatim from the store declaration.
            var td_conts: []ast.Continuation = &[_]ast.Continuation{};
            if (discharge_arm) |da| {
                const tdc = allocator.alloc(ast.Continuation, 1) catch unreachable;
                tdc[0] = da;
                td_conts = tdc;
            }
            appended_items.append(allocator, ast.Item{ .flow = ast.Flow{
                .body = ast.rootSite(td_inv, td_conts, flow.location),
                .pre_label = null,
                .impl_of = null,
                .super_shape = null,
                .inline_body = null,
                .preamble_code = null,
                .is_pure = false,
                .is_transitively_pure = false,
                .location = flow.location,
                .module = allocator.dupe(u8, flow.module) catch unreachable,
            } }) catch unreachable;
        }

        // Whole-program lowering: every text slot an expression may stand in,
        // in every non-store continuation (if exprs, key when-guards, sweep
        // bodies, branch payloads, …), gets BOTH the cell-path rewrite
        // (`ui.sel` → `__koru_store_ui.sel`) and the indexed read
        // (`pool[h].hp` → the SoA column). Watch/interceptor transplants
        // already rewrite; the rest of the program was leaking raw text into
        // Zig. Idempotent under re-entry (already-prefixed paths sit past an
        // ident char).
        {
            const pscope = StoreScope{
                .names = pstore_names.items,
                .prefixes = blk_px: {
                    const px = allocator.alloc([]const u8, pstore_names.items.len) catch unreachable;
                    for (px) |*p| p.* = "";
                    break :blk_px px;
                },
            };
            const Walk = struct {
                fn items(alloc: std.mem.Allocator, prog: *const ast.Program, its: []ast.Item, scope: StoreScope, ident: []const []const u8) void {
                    for (its) |*pi| {
                        switch (pi.*) {
                            // Must use `&pi.flow` — `|*f|` on a switched copy
                            // mutates a temporary and the live AST stays raw.
                            .flow => H.storeRefsFlowH(alloc, prog, &pi.flow, scope, ident),
                            .module_decl => items(alloc, prog, @constCast(pi.module_decl.items), scope, ident),
                            else => {},
                        }
                    }
                }
            };
            Walk.items(allocator, program, @constCast(program.items), pscope, pstore_identity.items);
        }

        const pconsumed = std.fmt.allocPrint(allocator, "// std/store: plural store '{s}' created (SoA cell + insert/query/write/take/stripe units)", .{store_name}) catch unreachable;
        return .{ .transformed = .{
            .replacement = ast.Item{ .host_line = ast.HostLine{
                .content = pconsumed,
                .location = flow.location,
                .module = allocator.dupe(u8, flow.module) catch unreachable,
            } },
            .appended = appended_items.toOwnedSlice(allocator) catch unreachable,
        } };
    }

    // ------------------------------------------------------------------
    // Interceptors: effect branches on create — the store's CONTRACT
    // (ruling 4). Two shapes this slice:
    //   `! <field> _`             — field interceptor, payload discarded
    //   `! updated { old, new }`  — lifecycle interceptor; flips the store's
    //                               write payload to {old,new} (the (c)
    //                               usage-synthesis lean: the old-image read
    //                               exists BECAUSE a body binds it)
    // Everything else is a loud wall.
    // ------------------------------------------------------------------
    const FieldIceptor = struct {
        field_idx: usize,
        cont: ast.Continuation,
    };
    var field_iceptors = std.ArrayList(FieldIceptor).initCapacity(allocator, 2) catch unreachable;
    var updated_iceptors = std.ArrayList(ast.Continuation).initCapacity(allocator, 2) catch unreachable;
    for (flow.body.continuations) |*ic| {
        const bname = std.mem.trim(u8, ic.branch, " ");
        if (ic.condition != null) {
            return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, "std/store:new({s}): guarded interceptors are a later slice - interceptors are the store's unconditional contract", .{store_name}) } };
        }
        if (std.mem.eql(u8, bname, "updated")) {
            var has_old = false;
            var has_new = false;
            for (ic.destructure) |df| {
                if (std.mem.eql(u8, df.name, "old")) has_old = true;
                if (std.mem.eql(u8, df.name, "new")) has_new = true;
            }
            if (!has_old or !has_new or ic.destructure.len != 2) {
                return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, "std/store:new({s}): `! updated` must destructure exactly {{ old, new }} this slice", .{store_name}) } };
            }
            updated_iceptors.append(allocator, ast_functional.cloneContinuation(allocator, ic) catch unreachable) catch unreachable;
            continue;
        }
        const fidx: usize = blk: {
            for (field_names, 0..) |fname, i| {
                if (std.mem.eql(u8, bname, fname)) break :blk i;
            }
            return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, "std/store:new({s}): interceptor branch '{s}' is neither a field nor `updated` (inserted/removed are rung two)", .{ store_name, bname }) } };
        };
        const b = ic.binding orelse "";
        if (!std.mem.eql(u8, b, "_")) {
            return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, "std/store:new({s}): field interceptor `! {s}` must discard its payload (`! {s} _`) this slice - bind values via `updated {{ old, new }}`", .{ store_name, bname, bname }) } };
        }
        field_iceptors.append(allocator, .{ .field_idx = fidx, .cont = ast_functional.cloneContinuation(allocator, ic) catch unreachable }) catch unreachable;
    }

    // ------------------------------------------------------------------
    // Collect watches: every `std/store:watch(<this store>)` flow's
    // branches. One watch per field for now (sequencing splice = later).
    // ------------------------------------------------------------------
    const WatchArm = struct {
        field_idx: usize,
        cont: ast.Continuation,
    };
    var watch_arms = std.ArrayList(WatchArm).initCapacity(allocator, 4) catch unreachable;
    for (flatItems(allocator, program.items)) |pi| {
        if (pi.* != .flow) continue;
        const wf = &pi.flow;
        if (!H.isStoreInv(wf, "watch", store_name)) continue;
        for (wf.body.continuations) |*wc| {
            const fidx: usize = blk: {
                for (field_names, 0..) |fname, i| {
                    if (std.mem.eql(u8, std.mem.trim(u8, wc.branch, " "), fname)) break :blk i;
                }
                // See the twin above: one column, one name, and it is the store's.
                if (ast.watchesIdentityColumn(field_names, wc.branch, store_name)) break :blk 0;
                if (field_names.len == 1 and std.mem.eql(u8, field_names[0], ast.STORE_IDENTITY_COLUMN)) {
                    return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, wf.location, wf.module, "std/store:watch({s}): '{s}' names no column - a one-column store names none, so its watch arm is the store: `! {s} <binding> |> ...`", .{ store_name, wc.branch, store_name }) } };
                }
                return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, wf.location, wf.module, "std/store:watch({s}): '{s}' is not a field of store '{s}'", .{ store_name, wc.branch, store_name }) } };
            };
            // Ruling 4: subscriptions are consumer-level and MANY - every
            // watch on a field fires, in source order (690_010).
            const cloned = ast_functional.cloneContinuation(allocator, wc) catch unreachable;
            watch_arms.append(allocator, .{ .field_idx = fidx, .cont = cloned }) catch unreachable;
        }
    }

    // ------------------------------------------------------------------
    // Cross-store guard closure (690_013): a watch on store T guarded by
    // `when S.field == ...` must re-evaluate when S.field is WRITTEN -
    // S's write path announces T's watched field (level-trigger on write;
    // edge-trigger/dedup is undesigned). Collected here, spliced into
    // this store's arms below.
    // ------------------------------------------------------------------
    const ForeignGuard = struct {
        local_field_idx: usize, // which of OUR fields the guard reads
        target_store: []const u8,
        target_field_idx: usize, // watched field's index in the target store
    };
    var foreign_guards = std.ArrayList(ForeignGuard).initCapacity(allocator, 2) catch unreachable;
    {
        const FG = struct {
            fn fieldOrderOf(alloc: std.mem.Allocator, prog: *const ast.Program, store: []const u8) ?[]const []const u8 {
                const struct_literal2 = @import("struct_literal");
                // Already-coordinated stores: read the apply event's branches.
                const apply_name2 = std.fmt.allocPrint(alloc, "__store_apply_{s}", .{store}) catch unreachable;
                for (flatItems(alloc, prog.items)) |pi2| {
                    if (pi2.* != .event_decl) continue;
                    const ed2 = &pi2.event_decl;
                    if (ed2.path.segments.len == 1 and std.mem.eql(u8, ed2.path.segments[0], apply_name2)) {
                        const names2b = alloc.alloc([]const u8, ed2.branches.len) catch unreachable;
                        for (ed2.branches, 0..) |b2, bi2| names2b[bi2] = b2.name;
                        return names2b;
                    }
                }
                for (flatItems(alloc, prog.items)) |pi2| {
                    if (pi2.* != .flow) continue;
                    const f2 = &pi2.flow;
                    const inv2 = f2.inv();
                    if (inv2.path.segments.len != 1 or !std.mem.eql(u8, inv2.path.segments[0], "new")) continue;
                    const mq2 = inv2.path.module_qualifier orelse continue;
                    if (!std.mem.eql(u8, mq2, "std.store")) continue;
                    var matches2 = false;
                    var seed3: ?[]const u8 = null;
                    for (inv2.args) |a2| {
                        if (std.mem.eql(u8, a2.name, "expr")) {
                            var v2 = a2.value;
                            if (v2.len >= 2 and v2[0] == '"') v2 = v2[1 .. v2.len - 1];
                            matches2 = std.mem.eql(u8, v2, store);
                        } else if (std.mem.eql(u8, a2.name, "source")) {
                            seed3 = a2.value;
                        }
                    }
                    if (!matches2 or seed3 == null) continue;
                    const braced3 = std.fmt.allocPrint(alloc, "{{{s}}}", .{seed3.?}) catch unreachable;
                    const cf3 = struct_literal2.parseFields(alloc, braced3) catch continue;
                    const names3 = alloc.alloc([]const u8, cf3.len) catch unreachable;
                    for (cf3, 0..) |c3, ci3| names3[ci3] = c3.name;
                    return names3;
                }
                return null;
            }
        };
        for (flatItems(allocator, program.items)) |pi| {
            if (pi.* != .flow) continue;
            const wfg = &pi.flow;
            if (!H.isStoreInv(wfg, "watch", null)) continue;
            var target_store: []const u8 = "";
            for (wfg.inv().args) |a| {
                if (std.mem.eql(u8, a.name, "expr")) target_store = H.stripQuotes(a.value);
            }
            if (target_store.len == 0 or std.mem.eql(u8, target_store, store_name)) continue;
            const t_order = FG.fieldOrderOf(allocator, program, target_store) orelse continue;
            for (wfg.body.continuations) |*wcg| {
                const cond = wcg.condition orelse continue;
                // Which of OUR fields does the guard read (`<store>.<field>`)?
                for (cell_fields, 0..) |cfw, lf_idx| {
                    const needle = std.fmt.allocPrint(allocator, "{s}.{s}", .{ store_name, cfw.name }) catch unreachable;
                    if (std.mem.indexOf(u8, cond, needle) == null) continue;
                    // The watched field's index in the target store.
                    const wbranch = std.mem.trim(u8, wcg.branch, " ");
                    const t_idx: usize = blk: {
                        for (t_order, 0..) |tn, ti| {
                            if (std.mem.eql(u8, tn, wbranch)) break :blk ti;
                        }
                        break :blk 0;
                    };
                    foreign_guards.append(allocator, .{
                        .local_field_idx = lf_idx,
                        .target_store = allocator.dupe(u8, target_store) catch unreachable,
                        .target_field_idx = t_idx,
                    }) catch unreachable;
                }
            }
        }
    }

    // Payload mode: an `updated` interceptor flips the store's write payload
    // to {old,new} ((c) lean — the old-image read is synthesized because a
    // body binds it). Mixing lifecycle and field-level consumers on one
    // store is a later slice.
    const old_new_mode = updated_iceptors.items.len != 0;
    if (old_new_mode and (watch_arms.items.len != 0 or field_iceptors.items.len != 0)) {
        return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, "std/store:new({s}): mixing `updated {{ old, new }}` with field watches/interceptors on one store is a later slice", .{store_name}) } };
    }

    // All store names visible in the program — untransformed creates plus
    // already-generated apply events — so transplanted bodies get their
    // store reads rewritten to the cells (`game.shield` in a watch body →
    // `__koru_store_game.shield`, including inside `{{ }}` interpolations).
    // Descends into modules: a store declared in an imported module has both its
    // `new` and its synthesized `__store_apply_*` INSIDE that module, so a
    // top-level-only sweep collects nothing and every `<store>.<field>`
    // reference in the program is left un-lowered. Safe to descend because both
    // markers are specific — a `std.store:new` invocation and a generated
    // `__store_apply_` symbol.
    var store_names = std.ArrayList([]const u8).initCapacity(allocator, 4) catch unreachable;
    // The subset that names ONE column and no field — referenced BARE.
    var store_idents = std.ArrayList([]const u8).initCapacity(allocator, 4) catch unreachable;
    {
        const Collect = struct {
            fn go(alloc: std.mem.Allocator, its: []const ast.Item, out: *std.ArrayList([]const u8), ident_out: *std.ArrayList([]const u8)) void {
                for (its) |pi| {
                    switch (pi) {
                        .flow => |*f| {
                            if (H.isStoreInv(f, "new", null)) {
                                var nm: ?[]const u8 = null;
                                var seed: ?[]const u8 = null;
                                for (f.inv().args) |a| {
                                    if (std.mem.eql(u8, a.name, "expr")) nm = H.stripQuotes(a.value);
                                    if (std.mem.eql(u8, a.name, "source")) seed = a.value;
                                }
                                if (nm) |n| {
                                    out.append(alloc, n) catch unreachable;
                                    // Read the seed exactly as the declaration
                                    // does, so "is this identity-shaped" has ONE
                                    // answer wherever it is asked.
                                    if (seed) |sd| {
                                        const braced = std.fmt.allocPrint(alloc, "{{{s}}}", .{sd}) catch unreachable;
                                        if (struct_literal.isIdentityBlock(braced)) ident_out.append(alloc, n) catch unreachable;
                                    }
                                }
                            }
                        },
                        .event_decl => |*ed| {
                            if (ed.path.segments.len == 1 and std.mem.startsWith(u8, ed.path.segments[0], "__store_apply_")) {
                                const n = ed.path.segments[0]["__store_apply_".len..];
                                out.append(alloc, n) catch unreachable;
                                if (ed.branches.len == 1 and std.mem.eql(u8, ed.branches[0].name, ast.STORE_IDENTITY_COLUMN)) {
                                    ident_out.append(alloc, n) catch unreachable;
                                }
                            }
                        },
                        .module_decl => |*md| go(alloc, md.items, out, ident_out),
                        else => {},
                    }
                }
            }
        };
        Collect.go(allocator, program.items, &store_names, &store_idents);
    }

    const Rewrite = struct {
        fn isIdent(ch: u8) bool {
            return (ch >= 'a' and ch <= 'z') or (ch >= 'A' and ch <= 'Z') or (ch >= '0' and ch <= '9') or ch == '_' or ch == '-';
        }
        // `prefix` names the Zig namespace the cell lives in, and is empty
        // whenever the reader is in the declaring module (the common case).
        // A reader in a DIFFERENT module has to reach across: the cell is a
        // module-scope var in the declaring module's emitted struct, so a bare
        // `__koru_store_s` there is an undeclared identifier (110_022).
        fn storeRefs(alloc: std.mem.Allocator, text: []const u8, name: []const u8, prefix: []const u8, is_identity: bool) []const u8 {
            const expr_ctx = ast.expressionMask(alloc, text);
            var out = std.ArrayList(u8).initCapacity(alloc, text.len + 32) catch unreachable;
            var i: usize = 0;
            while (i < text.len) {
                const at_boundary = ast.identBoundaryBefore(text, i);
                const starts = at_boundary and std.mem.startsWith(u8, text[i..], name);
                const after = i + name.len;
                if (starts and after < text.len and text[after] == '.') {
                    out.appendSlice(alloc, prefix) catch unreachable;
                    out.appendSlice(alloc, "__koru_store_") catch unreachable;
                    out.appendSlice(alloc, name) catch unreachable;
                    i += name.len;
                } else if (is_identity and expr_ctx[i] and starts and (after >= text.len or !isIdent(text[after]))) {
                    // A ONE-column store has no field to name, so the store name
                    // IS the reference. It still has to reach a column in the
                    // cell, so it resolves to the synthesized one.
                    out.appendSlice(alloc, prefix) catch unreachable;
                    out.appendSlice(alloc, "__koru_store_") catch unreachable;
                    out.appendSlice(alloc, name) catch unreachable;
                    out.append(alloc, '.') catch unreachable;
                    out.appendSlice(alloc, ast.STORE_IDENTITY_COLUMN) catch unreachable;
                    i += name.len;
                } else {
                    out.append(alloc, text[i]) catch unreachable;
                    i += 1;
                }
            }
            return out.toOwnedSlice(alloc) catch unreachable;
        }
        fn isIn(xs: []const []const u8, n: []const u8) bool {
            for (xs) |x| if (std.mem.eql(u8, x, n)) return true;
            return false;
        }
        // Whole-identifier rewrite (`new` → `__koru_upd.new`), boundary-aware
        // and skipping `.field` accesses. Applied to every arg value in a
        // transplanted body, INCLUDING nested store-block sources (an
        // interceptor's `stored { ... }` value expr references these
        // bindings; the nested transform preserves them verbatim).
        fn identRefs(alloc: std.mem.Allocator, text: []const u8, name: []const u8, replacement: []const u8) []const u8 {
            var out = std.ArrayList(u8).initCapacity(alloc, text.len + 32) catch unreachable;
            var i: usize = 0;
            while (i < text.len) {
                const prev_ok = ast.identBoundaryBefore(text, i) and (i == 0 or text[i - 1] != '.');
                const next_i = i + name.len;
                const next_ok = next_i >= text.len or !isIdent(text[next_i]);
                if (prev_ok and next_ok and next_i <= text.len and std.mem.startsWith(u8, text[i..], name)) {
                    out.appendSlice(alloc, replacement) catch unreachable;
                    i += name.len;
                } else {
                    out.append(alloc, text[i]) catch unreachable;
                    i += 1;
                }
            }
            return out.toOwnedSlice(alloc) catch unreachable;
        }
        fn rewriteIdentInCont(alloc: std.mem.Allocator, cont: *ast.Continuation, name: []const u8, replacement: []const u8) void {
            if (cont.node) |*n| {
                switch (@constCast(n).*) {
                    .invocation => |*inv| {
                        for (inv.args) |*a| {
                            @constCast(a).value = identRefs(alloc, a.value, name, replacement);
                            if (a.expression_value) |ev| {
                                const fresh = alloc.create(ast.CapturedExpression) catch unreachable;
                                fresh.* = ev.*;
                                fresh.text = identRefs(alloc, ev.text, name, replacement);
                                @constCast(a).expression_value = fresh;
                            }
                            if (a.source_value) |sv| {
                                const fresh = alloc.create(ast.Source) catch unreachable;
                                fresh.* = sv.*;
                                fresh.text = identRefs(alloc, sv.text, name, replacement);
                                @constCast(a).source_value = fresh;
                            }
                        }
                    },
                    else => {},
                }
            }
            for (cont.continuations) |*c| rewriteIdentInCont(alloc, @constCast(c), name, replacement);
        }
        // Store-invocation args (stored/watch/create blocks) keep their raw
        // source — those transforms own their own rewriting. But
        // Invocation.inline_body is the FREEZE of an earlier template expand
        // (`if`/`for`) and MUST be rewritten even on std.store sites skipped
        // for args (690_074).
        //
        // Every arm below lowers ONE text slot through the same
        // `storeLowerText`. The list of arms is the whole reach of the store's
        // read surface, and every gap this walk has ever had was an arm that
        // was not here (`.expression` at 110_022, `inline_body` at 690_074,
        // `.branch_constructor` at 690_256) or a lowering this walk could not
        // call (the indexed read, 690_250/690_254).
        fn rewriteNode(alloc: std.mem.Allocator, prog: *const ast.Program, n: *ast.Node, scope: StoreScope, idents: []const []const u8, bound: []const []const u8) void {
            // Same temporary-capture rule as storeRefsContH: never `|*inv|`
            // on `switch (n.*)`; mutate `n.invocation` in place (690_074).
            switch (n.*) {
                .invocation => {
                    const inv = &n.invocation;
                    const skip_args = blk: {
                        if (inv.path.module_qualifier) |mq| {
                            if (std.mem.eql(u8, mq, "std.store")) break :blk true;
                        }
                        break :blk false;
                    };
                    if (!skip_args) {
                        for (inv.args) |*a| {
                            @constCast(a).value = storeLowerText(alloc, prog, a.value, scope, idents, bound);
                            // Expression args carry their text separately — the
                            // emitter reads THAT, not .value. cloneContinuation
                            // shares these pointers with the ORIGINAL tree (the
                            // documented clone footgun), so swap in a fresh copy
                            // rather than mutating shared state.
                            if (a.expression_value) |ev| {
                                const fresh = alloc.create(ast.CapturedExpression) catch unreachable;
                                fresh.* = ev.*;
                                fresh.text = storeLowerText(alloc, prog, ev.text, scope, idents, bound);
                                @constCast(a).expression_value = fresh;
                            }
                        }
                    }
                    if (inv.inline_body) |ib| {
                        inv.inline_body = storeLowerText(alloc, prog, ib, scope, idents, bound);
                    }
                },
                .inline_code => {
                    n.* = .{ .inline_code = storeLowerText(alloc, prog, n.inline_code, scope, idents, bound) };
                },
                // A PRODUCE arm (`peek -> s.v`, `| c _ -> s.v`) is an expression
                // node, and it reads cells exactly like an arg does. Left out,
                // the reference reached the host verbatim as `s.v` — an
                // undeclared identifier in Zig, from valid Koru (110_022).
                .expression => {
                    n.* = .{ .expression = storeLowerText(alloc, prog, n.expression, scope, idents, bound) };
                },
                // A branch-RESOLUTION payload (`| then => got s.n`) is the same
                // read one position over from the guard (690_256). The emitter
                // reads `plain_value`, else `expression_str orelse type` per
                // field, so the rewrite lands in exactly those slots.
                .branch_constructor => {
                    const bc = &n.branch_constructor;
                    if (bc.plain_value) |pv| bc.plain_value = storeLowerText(alloc, prog, pv, scope, idents, bound);
                    for (bc.fields) |*fld| {
                        const has_expr = fld.expression_str != null;
                        const lowered = storeLowerText(alloc, prog, fld.expression_str orelse fld.type, scope, idents, bound);
                        if (has_expr) @constCast(fld).expression_str = lowered else @constCast(fld).type = lowered;
                    }
                },
                else => {},
            }
        }
        fn rewriteCont(alloc: std.mem.Allocator, prog: *const ast.Program, cont: *ast.Continuation, scope: StoreScope, idents: []const []const u8, bound: []const []const u8) void {
            // A continuation's OWN bindings shadow store names (690_090) — the
            // singleton twin of the plural walk's skip. A row binding or
            // shape-destructure makes `<store>.<field>` mean the row, so the
            // cell rewrite must not reach it.
            var own_buf: [16][]const u8 = undefined;
            var own_len: usize = 0;
            if (cont.binding) |b| {
                own_buf[own_len] = b;
                own_len += 1;
            }
            for (cont.destructure) |df| {
                own_buf[own_len] = df.name;
                own_len += 1;
            }
            const own = own_buf[0..own_len];
            const bound_all: []const []const u8 = if (own_len == 0)
                bound
            else blk: {
                const all = alloc.alloc([]const u8, bound.len + own_len) catch unreachable;
                @memcpy(all[0..bound.len], bound);
                @memcpy(all[bound.len..], own);
                break :blk all;
            };
            // Guards ride as arm conditions at the write site - their
            // cross-store reads rewrite to the cells too (690_013).
            if (cont.condition) |cond| {
                @constCast(cont).condition = storeLowerText(alloc, prog, cond, scope, idents, bound_all);
            }
            if (cont.node) |*n| rewriteNode(alloc, prog, @constCast(n), scope, idents, bound_all);
            for (cont.continuations) |*c| rewriteCont(alloc, prog, @constCast(c), scope, idents, bound_all);
        }
        fn rewriteFlow(alloc: std.mem.Allocator, prog: *const ast.Program, f: *ast.Flow, scope: StoreScope, idents: []const []const u8) void {
            rewriteCont(alloc, prog, &f.body, scope, idents, &[_][]const u8{});
            if (f.inline_body) |ib| {
                @constCast(f).inline_body = storeLowerText(alloc, prog, ib, scope, idents, &[_][]const u8{});
            }
        }
        // A bare-return subflow (`peek -> s.v`) is not a Flow at all — it lands
        // as an `immediate_impl` whose BranchConstructor carries the produced
        // expression. Reading a cell there is as ordinary as reading one in an
        // arg, but the walk used to visit only `.flow`, so the reference went
        // to the host verbatim and Zig reported an undeclared `s` (110_022).
        fn rewriteImmediateImpl(alloc: std.mem.Allocator, prog: *const ast.Program, ii: *ast.ImmediateImpl, scope: StoreScope, idents: []const []const u8) void {
            if (ii.value.plain_value) |pv| {
                ii.value.plain_value = storeLowerText(alloc, prog, pv, scope, idents, &[_][]const u8{});
            }
            // `=> branch { f: <expr> }` keeps each field's value in
            // `expression_str`; a cell read there is the same read.
            for (ii.value.fields) |*fld| {
                if (fld.expression_str) |es| {
                    @constCast(fld).expression_str = storeLowerText(alloc, prog, es, scope, idents, &[_][]const u8{});
                }
            }
        }
    };
    // Transplanted arms are spliced INTO the declaring module's generated
    // units, so they read the cell from the same namespace: no prefix.
    const local_prefixes = blk_lp: {
        const px = allocator.alloc([]const u8, store_names.items.len) catch unreachable;
        for (px) |*e| e.* = "";
        break :blk_lp px;
    };
    const local_scope = StoreScope{ .names = store_names.items, .prefixes = local_prefixes };
    for (watch_arms.items) |*wa| Rewrite.rewriteCont(allocator, program, &wa.cont, local_scope, store_idents.items, &[_][]const u8{});
    for (field_iceptors.items) |*fi| Rewrite.rewriteCont(allocator, program, &fi.cont, local_scope, store_idents.items, &[_][]const u8{});
    for (updated_iceptors.items) |*ui| Rewrite.rewriteCont(allocator, program, ui, local_scope, store_idents.items, &[_][]const u8{});

    // ------------------------------------------------------------------
    // Unit 1: the module-scope typed cell (slice one, unchanged).
    // ------------------------------------------------------------------
    var seed = std.ArrayList(u8).initCapacity(allocator, 64) catch unreachable;
    seed.appendSlice(allocator, ".{ ") catch unreachable;
    for (cell_fields, 0..) |cf, i| {
        if (i > 0) seed.appendSlice(allocator, ", ") catch unreachable;
        seed.append(allocator, '.') catch unreachable;
        seed.appendSlice(allocator, cf.name) catch unreachable;
        seed.appendSlice(allocator, " = ") catch unreachable;
        // Declared default when seeded; a bare field zero-defaults
        // (initialization is orthogonal to shape — 690_050).
        seed.appendSlice(allocator, "@as(") catch unreachable;
        seed.appendSlice(allocator, field_types[i]) catch unreachable;
        seed.appendSlice(allocator, ", ") catch unreachable;
        seed.appendSlice(allocator, field_defaults[i] orelse "0") catch unreachable;
        seed.appendSlice(allocator, ")") catch unreachable;
    }
    seed.appendSlice(allocator, " }") catch unreachable;
    const init_zig = seed.toOwnedSlice(allocator) catch unreachable;

    // The JS cell is the same object literal with the casts removed: a default
    // is written by the author as a Koru literal, and JavaScript has no type to
    // pin it to. There is no `@Type` twin because the Zig side only builds one
    // to get a NAMED struct type for the `var` annotation, which JS neither has
    // nor needs.
    const cell_decl = if (host_is_js) blk_js: {
        var jp = std.ArrayList(u8).initCapacity(allocator, 128) catch unreachable;
        jp.appendSlice(allocator, "let __koru_store_") catch unreachable;
        jp.appendSlice(allocator, store_name) catch unreachable;
        jp.appendSlice(allocator, " = { ") catch unreachable;
        for (cell_fields, 0..) |cf, i| {
            if (i > 0) jp.appendSlice(allocator, ", ") catch unreachable;
            jp.appendSlice(allocator, cf.name) catch unreachable;
            jp.appendSlice(allocator, ": ") catch unreachable;
            jp.appendSlice(allocator, field_defaults[i] orelse "0") catch unreachable;
        }
        jp.appendSlice(allocator, " };") catch unreachable;
        break :blk_js jp.toOwnedSlice(allocator) catch unreachable;
    } else blk_zig: {
        var p = std.ArrayList(u8).initCapacity(allocator, 512) catch unreachable;
        p.appendSlice(allocator, "const __KoruStoreT_") catch unreachable;
        p.appendSlice(allocator, store_name) catch unreachable;
        // Container-level const initializers are already comptime scope — no
        // `comptime` keyword (capture's twin builder needs it because its
        // preamble lands inside a function body).
        p.appendSlice(allocator, " = blk: {\n") catch unreachable;
        p.appendSlice(allocator, "    const __info = @typeInfo(@TypeOf(") catch unreachable;
        p.appendSlice(allocator, init_zig) catch unreachable;
        p.appendSlice(allocator, "));\n") catch unreachable;
        p.appendSlice(allocator, "    var __fields: [__info.@\"struct\".fields.len]@import(\"std\").builtin.Type.StructField = undefined;\n") catch unreachable;
        p.appendSlice(allocator, "    for (__info.@\"struct\".fields, 0..) |__f, __i| {\n") catch unreachable;
        p.appendSlice(allocator, "        __fields[__i] = .{ .name = __f.name, .type = __f.type, .default_value_ptr = null, .is_comptime = false, .alignment = __f.alignment };\n") catch unreachable;
        p.appendSlice(allocator, "    }\n") catch unreachable;
        p.appendSlice(allocator, "    break :blk @Type(.{ .@\"struct\" = .{ .layout = .auto, .fields = &__fields, .decls = &.{}, .is_tuple = false } });\n") catch unreachable;
        p.appendSlice(allocator, "};\n") catch unreachable;
        p.appendSlice(allocator, "var __koru_store_") catch unreachable;
        p.appendSlice(allocator, store_name) catch unreachable;
        p.appendSlice(allocator, ": __KoruStoreT_") catch unreachable;
        p.appendSlice(allocator, store_name) catch unreachable;
        p.appendSlice(allocator, " = ") catch unreachable;
        p.appendSlice(allocator, init_zig) catch unreachable;
        p.appendSlice(allocator, ";") catch unreachable;
        break :blk_zig p.toOwnedSlice(allocator) catch unreachable;
    };

    // ------------------------------------------------------------------
    // Unit 2+3: the apply event (one terminal branch per field) + its
    // |zig proc (write the cell, announce the field).
    // ------------------------------------------------------------------
    const apply_name = std.fmt.allocPrint(allocator, "__store_apply_{s}", .{store_name}) catch unreachable;
    const write_name = std.fmt.allocPrint(allocator, "__store_write_{s}", .{store_name}) catch unreachable;

    const mkInput = struct {
        fn call(alloc: std.mem.Allocator, vtype: []const u8) []ast.Field {
            const fields = alloc.alloc(ast.Field, 2) catch unreachable;
            fields[0] = ast.Field{ .name = alloc.dupe(u8, "field") catch unreachable, .type = alloc.dupe(u8, "i64") catch unreachable };
            fields[1] = ast.Field{ .name = alloc.dupe(u8, "value") catch unreachable, .type = alloc.dupe(u8, vtype) catch unreachable };
            return fields;
        }
    }.call;

    const apply_branches = allocator.alloc(ast.Branch, cell_fields.len) catch unreachable;
    for (field_names, 0..) |fname, i| {
        const payload: ast.Shape = if (old_new_mode) blk: {
            const pf = allocator.alloc(ast.Field, 2) catch unreachable;
            pf[0] = ast.Field{ .name = allocator.dupe(u8, "old") catch unreachable, .type = allocator.dupe(u8, field_types[i]) catch unreachable };
            pf[1] = ast.Field{ .name = allocator.dupe(u8, "new") catch unreachable, .type = allocator.dupe(u8, field_types[i]) catch unreachable };
            break :blk ast.Shape{ .fields = pf };
        } else blk: {
            const pf = allocator.alloc(ast.Field, 1) catch unreachable;
            pf[0] = ast.Field{
                .name = allocator.dupe(u8, "__type_ref") catch unreachable,
                .type = allocator.dupe(u8, field_types[i]) catch unreachable,
            };
            break :blk ast.Shape{ .fields = pf };
        };
        apply_branches[i] = ast.Branch{
            .name = allocator.dupe(u8, fname) catch unreachable,
            .payload = payload,
            .kind = .terminal,
            .annotations = &[_][]const u8{},
        };
    }

    const mkPath = struct {
        fn call(alloc: std.mem.Allocator, module: []const u8, name: []const u8) ast.DottedPath {
            const segs = alloc.alloc([]const u8, 1) catch unreachable;
            segs[0] = alloc.dupe(u8, name) catch unreachable;
            return ast.DottedPath{ .module_qualifier = alloc.dupe(u8, module) catch unreachable, .segments = segs };
        }
    }.call;

    const apply_event_item = ast.Item{ .event_decl = ast.EventDecl{
        .path = mkPath(allocator, home_ns, apply_name),
        .input = ast.Shape{ .fields = mkInput(allocator, value_type) },
        .branches = apply_branches,
        .is_public = false,
        .is_implicit_flow = false,
        .annotations = &[_][]const u8{},
        .location = flow.location,
        .module = allocator.dupe(u8, flow.module) catch unreachable,
    } };

    // A branch value is a tagged union on Zig and `{ tag, <branch> }` on JS
    // (js_emitter.zig:594) — the payload key repeats the branch name, so the
    // two spellings differ in shape and not only in syntax. `else => unreachable`
    // has no JS twin either: an unmodelled field index must SAY so at runtime
    // rather than fall off the end of a switch returning `undefined`, which the
    // caller would read as a branch object and dereference.
    var pb = std.ArrayList(u8).initCapacity(allocator, 256) catch unreachable;
    if (host_is_js) {
        pb.appendSlice(allocator, "switch (field) {\n") catch unreachable;
        for (field_names, 0..) |fname, i| {
            const arm = if (old_new_mode)
                std.fmt.allocPrint(allocator, "  case {d}: {{ const __old = __koru_store_{s}.{s}; __koru_store_{s}.{s} = value; return {{ tag: \"{s}\", {s}: {{ old: __old, new: value }} }}; }}\n", .{ i, store_name, fname, store_name, fname, fname, fname }) catch unreachable
            else
                std.fmt.allocPrint(allocator, "  case {d}: {{ __koru_store_{s}.{s} = value; return {{ tag: \"{s}\", {s}: value }}; }}\n", .{ i, store_name, fname, fname, fname }) catch unreachable;
            pb.appendSlice(allocator, arm) catch unreachable;
        }
        pb.appendSlice(allocator, "}\n") catch unreachable;
        pb.appendSlice(allocator, std.fmt.allocPrint(allocator, "throw new Error(\"{s}: field index \" + field + \" is not a column of store '{s}'\");", .{ apply_name, store_name }) catch unreachable) catch unreachable;
    } else {
        pb.appendSlice(allocator, "return switch (field) {\n") catch unreachable;
        for (field_names, 0..) |fname, i| {
            const arm = if (old_new_mode)
                std.fmt.allocPrint(allocator, "    {d} => blk: {{ const __old = __koru_store_{s}.{s}; __koru_store_{s}.{s} = value; break :blk .{{ .{s} = .{{ .old = __old, .new = value }} }}; }},\n", .{ i, store_name, fname, store_name, fname, fname }) catch unreachable
            else
                std.fmt.allocPrint(allocator, "    {d} => blk: {{ __koru_store_{s}.{s} = value; break :blk .{{ .{s} = value }}; }},\n", .{ i, store_name, fname, fname }) catch unreachable;
            pb.appendSlice(allocator, arm) catch unreachable;
        }
        pb.appendSlice(allocator, "    else => unreachable,\n};") catch unreachable;
    }
    const apply_proc_body = pb.toOwnedSlice(allocator) catch unreachable;

    const apply_proc_item = ast.Item{ .proc_decl = ast.ProcDecl{
        .path = mkPath(allocator, home_ns, apply_name),
        .body = ast.Source{ .text = apply_proc_body, .location = flow.location, .scope = .{ .bindings = &[_]ast.ScopeBinding{} }, .phantom_type = null },
        .annotations = &[_][]const u8{},
        .target = allocator.dupe(u8, proc_target) catch unreachable,
        .location = flow.location,
        .module = allocator.dupe(u8, flow.module) catch unreachable,
    } };

    // ------------------------------------------------------------------
    // Unit 4+5: the write event (void — the store's sole write surface)
    // and its implementing flow: head invokes apply, arms are the
    // transplanted watch branches. THE (f) CENTRALIZING WRITE-SUBFLOW.
    // ------------------------------------------------------------------
    const write_event_item = ast.Item{ .event_decl = ast.EventDecl{
        .path = mkPath(allocator, home_ns, write_name),
        .input = ast.Shape{ .fields = mkInput(allocator, value_type) },
        .branches = &[_]ast.Branch{},
        .is_public = false,
        .is_implicit_flow = false,
        .annotations = &[_][]const u8{},
        .location = flow.location,
        .module = allocator.dupe(u8, flow.module) catch unreachable,
    } };

    const apply_args = allocator.alloc(ast.Arg, 2) catch unreachable;
    apply_args[0] = ast.Arg{ .name = allocator.dupe(u8, "field") catch unreachable, .value = allocator.dupe(u8, "field") catch unreachable };
    apply_args[1] = ast.Arg{ .name = allocator.dupe(u8, "value") catch unreachable, .value = allocator.dupe(u8, "value") catch unreachable };
    const apply_inv = ast.Invocation{
        .path = mkPath(allocator, home_ns, apply_name),
        .args = apply_args,
    };

    // One arm per field. Per arm, the spliced sequence is: field
    // interceptors first (the contract runs inside the cascade), then the
    // watch body (watches observe settled state — the (h) lean). Sequenced
    // bodies ride as `branch:""` void-chain steps (capture's dissolution
    // shape). In {old,new} mode every field's arm carries every `updated`
    // interceptor body (the lifecycle fires on all writes). A guarded
    // stand-alone watch gets an unguarded do-nothing sibling so the
    // dispatch stays exhaustive (210_085's coverage rule, 400_089's rescue
    // shape).
    const Graft = struct {
        fn atEnds(alloc: std.mem.Allocator, cont: *ast.Continuation, next: *const ast.Continuation) void {
            if (cont.continuations.len == 0) {
                const kids = alloc.alloc(ast.Continuation, 1) catch unreachable;
                kids[0] = ast_functional.cloneContinuation(alloc, next) catch unreachable;
                cont.continuations = kids;
                return;
            }
            for (cont.continuations) |*c| atEnds(alloc, @constCast(c), next);
        }
        // A body continuation re-shaped as a sequential void step.
        fn asVoidStep(alloc: std.mem.Allocator, body: *const ast.Continuation) ast.Continuation {
            const cloned = ast_functional.cloneContinuation(alloc, body) catch unreachable;
            return ast.Continuation{
                .branch = alloc.dupe(u8, "") catch unreachable,
                .binding = null,
                .kind = .terminal,
                .condition = null,
                .node = cloned.node,
                .indent = cloned.indent,
                .continuations = cloned.continuations,
                .is_transformed_subtree = true,
                .location = cloned.location,
            };
        }
    };

    var arms = std.ArrayList(ast.Continuation).initCapacity(allocator, cell_fields.len + 2) catch unreachable;
    for (field_names, 0..) |fname, i| {
        // Gather this field's spliced bodies in firing order.
        var segments = std.ArrayList(*const ast.Continuation).initCapacity(allocator, 4) catch unreachable;
        var watch_seg: ?*const ast.Continuation = null;
        var watch_count: usize = 0;
        if (old_new_mode) {
            for (updated_iceptors.items) |*ui| segments.append(allocator, ui) catch unreachable;
        } else {
            for (field_iceptors.items) |*fi| {
                if (fi.field_idx == i) segments.append(allocator, &fi.cont) catch unreachable;
            }
            for (watch_arms.items) |*wa| {
                if (wa.field_idx == i) {
                    if (watch_seg == null) watch_seg = &wa.cont;
                    watch_count += 1;
                    segments.append(allocator, &wa.cont) catch unreachable;
                }
            }
        }

        // Foreign-guard announce steps for THIS field (690_013).
        var fg_steps = std.ArrayList(ast.Continuation).initCapacity(allocator, 2) catch unreachable;
        for (foreign_guards.items) |fg| {
            if (fg.local_field_idx != i) continue;
            const t_announce = std.fmt.allocPrint(allocator, "__store_announce_{s}", .{fg.target_store}) catch unreachable;
            const fg_args = allocator.alloc(ast.Arg, 1) catch unreachable;
            fg_args[0] = ast.Arg{
                .name = allocator.dupe(u8, "field") catch unreachable,
                .value = std.fmt.allocPrint(allocator, "{d}", .{fg.target_field_idx}) catch unreachable,
            };
            fg_steps.append(allocator, ast.Continuation{
                .branch = allocator.dupe(u8, "") catch unreachable,
                .binding = null,
                .kind = .terminal,
                .condition = null,
                .node = .{ .invocation = ast.Invocation{
                    .path = mkPath(allocator, home_ns, t_announce),
                    .args = fg_args,
                } },
                .indent = 1,
                .continuations = &[_]ast.Continuation{},
                .is_transformed_subtree = true,
                .location = flow.location,
            }) catch unreachable;
        }

        if (segments.items.len == 0 and fg_steps.items.len == 0) {
            arms.append(allocator, ast.Continuation{
                .branch = allocator.dupe(u8, fname) catch unreachable,
                .binding = allocator.dupe(u8, "_") catch unreachable,
                .kind = .terminal,
                .condition = null,
                .node = .terminal,
                .indent = 1,
                .continuations = &[_]ast.Continuation{},
                .location = flow.location,
            }) catch unreachable;
            continue;
        }
        if (segments.items.len == 0) {
            // Arm exists ONLY to re-announce foreign guarded watches.
            var fg_arm = fg_steps.items[0];
            fg_arm.branch = allocator.dupe(u8, fname) catch unreachable;
            fg_arm.binding = allocator.dupe(u8, "_") catch unreachable;
            for (fg_steps.items[1..]) |*extra| {
                Graft.atEnds(allocator, &fg_arm, extra);
            }
            arms.append(allocator, fg_arm) catch unreachable;
            continue;
        }

        var any_watch_guarded = false;
        for (segments.items) |seg| {
            if (seg.condition != null) any_watch_guarded = true;
        }
        const watch_guarded = any_watch_guarded;
        if (watch_guarded and segments.items.len > 1) {
            return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, "std/store:new({s}): a guarded watch on a field that also has interceptors or sibling watches is a later slice", .{store_name}) } };
        }

        var arm = ast_functional.cloneContinuation(allocator, segments.items[0]) catch unreachable;
        arm.branch = allocator.dupe(u8, fname) catch unreachable;
        arm.kind = .terminal;
        if (old_new_mode) {
            // The subflow emitter's switch-arm head supports plain bindings
            // only (no destructure) — bind the {old,new} payload to a
            // synthesized name and rewrite the body's `old`/`new` idents to
            // field accesses (taps' string-level binding-rewrite precedent).
            for (arm.destructure) |df| {
                const repl = std.fmt.allocPrint(allocator, "__koru_upd.{s}", .{df.name}) catch unreachable;
                Rewrite.rewriteIdentInCont(allocator, &arm, df.name, repl);
            }
            arm.destructure = &.{};
            arm.binding = allocator.dupe(u8, "__koru_upd") catch unreachable;
        } else {
            // The arm binds the watch's name where a watch exists (interceptor
            // segments discard their payload by contract).
            if (watch_seg) |ws| {
                arm.binding = if (ws.binding) |b| allocator.dupe(u8, b) catch unreachable else allocator.dupe(u8, "_") catch unreachable;
            } else {
                arm.binding = allocator.dupe(u8, "_") catch unreachable;
            }
        }
        for (segments.items[1..]) |seg| {
            var step = Graft.asVoidStep(allocator, seg);
            // A sibling watch body references ITS OWN binding; the arm binds
            // the FIRST watch's name. Rewrite (taps' binding-rewrite shape).
            if (!old_new_mode) {
                if (seg.binding) |sb| {
                    if (arm.binding) |ab| {
                        if (!std.mem.eql(u8, sb, ab) and !std.mem.eql(u8, sb, "_")) {
                            Rewrite.rewriteIdentInCont(allocator, &step, sb, ab);
                        }
                    }
                }
            }
            Graft.atEnds(allocator, &arm, &step);
        }
        for (fg_steps.items) |*fgs| Graft.atEnds(allocator, &arm, fgs);
        arms.append(allocator, arm) catch unreachable;

        if (watch_guarded) {
            arms.append(allocator, ast.Continuation{
                .branch = allocator.dupe(u8, fname) catch unreachable,
                .binding = allocator.dupe(u8, "_") catch unreachable,
                .kind = .terminal,
                .condition = null,
                .node = .terminal,
                .indent = arm.indent,
                .continuations = &[_]ast.Continuation{},
                .location = flow.location,
            }) catch unreachable;
        }
    }

    const impl_flow_item = ast.Item{ .flow = ast.Flow{
        .body = ast.rootSite(apply_inv, arms.toOwnedSlice(allocator) catch unreachable, flow.location),
        .pre_label = null,
        .impl_of = mkPath(allocator, home_ns, write_name),
        .super_shape = null,
        .inline_body = null,
        .preamble_code = null,
        .is_pure = false,
        .is_transitively_pure = false,
        .location = flow.location,
        .module = allocator.dupe(u8, flow.module) catch unreachable,
    } };

    // ------------------------------------------------------------------
    // Unit 6+7: ANNOUNCE (dispatch-only re-fire of standing watches with
    // CURRENT values - no write, no interceptors) and STRIPE (the
    // imperative sweep verb, (l)/O13: announce every field). 690_014.
    // ------------------------------------------------------------------
    var stripe_items = std.ArrayList(ast.Item).initCapacity(allocator, 4) catch unreachable;
    if (!old_new_mode) {
        const announce_name = std.fmt.allocPrint(allocator, "__store_announce_{s}", .{store_name}) catch unreachable;
        const peek_name = std.fmt.allocPrint(allocator, "__store_peek_{s}", .{store_name}) catch unreachable;
        const stripe_name = std.fmt.allocPrint(allocator, "__store_stripe_{s}", .{store_name}) catch unreachable;

        const ann_in = allocator.alloc(ast.Field, 1) catch unreachable;
        ann_in[0] = ast.Field{ .name = allocator.dupe(u8, "field") catch unreachable, .type = allocator.dupe(u8, "i64") catch unreachable };
        const peek_in = allocator.alloc(ast.Field, 1) catch unreachable;
        peek_in[0] = ast.Field{ .name = allocator.dupe(u8, "field") catch unreachable, .type = allocator.dupe(u8, "i64") catch unreachable };
        const ann_branches = allocator.alloc(ast.Branch, cell_fields.len) catch unreachable;
        for (field_names, 0..) |fname, i| {
            const pf = allocator.alloc(ast.Field, 1) catch unreachable;
            pf[0] = ast.Field{ .name = allocator.dupe(u8, "__type_ref") catch unreachable, .type = allocator.dupe(u8, field_types[i]) catch unreachable };
            ann_branches[i] = ast.Branch{
                .name = allocator.dupe(u8, fname) catch unreachable,
                .payload = ast.Shape{ .fields = pf },
                .kind = .terminal,
                .annotations = &[_][]const u8{},
            };
        }
        const retain_ann2 = blk: {
            const anns = allocator.alloc([]const u8, 1) catch unreachable;
            anns[0] = allocator.dupe(u8, "retain") catch unreachable;
            break :blk anns;
        };
        stripe_items.append(allocator, ast.Item{ .event_decl = ast.EventDecl{
            .path = mkPath(allocator, home_ns, peek_name),
            .input = ast.Shape{ .fields = peek_in },
            .branches = ann_branches,
            .is_public = false,
            .is_implicit_flow = false,
            .annotations = &[_][]const u8{},
            .location = flow.location,
            .module = allocator.dupe(u8, flow.module) catch unreachable,
        } }) catch unreachable;
        // announce: the VOID dispatcher (retained — raw-Zig callers only).
        stripe_items.append(allocator, ast.Item{ .event_decl = ast.EventDecl{
            .path = mkPath(allocator, home_ns, announce_name),
            .input = ast.Shape{ .fields = ann_in },
            .branches = &[_]ast.Branch{},
            .is_public = false,
            .is_implicit_flow = false,
            .annotations = retain_ann2,
            .location = flow.location,
            .module = allocator.dupe(u8, flow.module) catch unreachable,
        } }) catch unreachable;

        // Peek proc: read the CURRENT value, announce the field branch.
        var pk = std.ArrayList(u8).initCapacity(allocator, 256) catch unreachable;
        if (host_is_js) {
            pk.appendSlice(allocator, "switch (field) {\n") catch unreachable;
            for (field_names, 0..) |fname, i| {
                const arm = std.fmt.allocPrint(allocator, "  case {d}: return {{ tag: \"{s}\", {s}: __koru_store_{s}.{s} }};\n", .{ i, fname, fname, store_name, fname }) catch unreachable;
                pk.appendSlice(allocator, arm) catch unreachable;
            }
            pk.appendSlice(allocator, "}\n") catch unreachable;
            pk.appendSlice(allocator, std.fmt.allocPrint(allocator, "throw new Error(\"{s}: field index \" + field + \" is not a column of store '{s}'\");", .{ peek_name, store_name }) catch unreachable) catch unreachable;
        } else {
            pk.appendSlice(allocator, "return switch (field) {\n") catch unreachable;
            for (field_names, 0..) |fname, i| {
                const arm = std.fmt.allocPrint(allocator, "    {d} => .{{ .{s} = __koru_store_{s}.{s} }},\n", .{ i, fname, store_name, fname }) catch unreachable;
                pk.appendSlice(allocator, arm) catch unreachable;
            }
            pk.appendSlice(allocator, "    else => unreachable,\n};") catch unreachable;
        }
        stripe_items.append(allocator, ast.Item{ .proc_decl = ast.ProcDecl{
            .path = mkPath(allocator, home_ns, peek_name),
            .body = ast.Source{ .text = pk.toOwnedSlice(allocator) catch unreachable, .location = flow.location, .scope = .{ .bindings = &[_]ast.ScopeBinding{} }, .phantom_type = null },
            .annotations = &[_][]const u8{},
            .target = allocator.dupe(u8, proc_target) catch unreachable,
            .location = flow.location,
            .module = allocator.dupe(u8, flow.module) catch unreachable,
        } }) catch unreachable;

        // The announce impl flow re-dispatches the SAME watch arms (fresh
        // clones - the shared-pointer footgun is real).
        var ann_arms = std.ArrayList(ast.Continuation).initCapacity(allocator, cell_fields.len) catch unreachable;
        // Twin of the plural announce's `any_observer` (:3805). The two
        // lowerings of one construct drift when only the one being looked at is
        // improved (frag-a-fix-lands-in-one-lowering-path), and this is the same
        // dead dispatch on the singleton's side.
        var any_observer_s = false;
        for (field_names, 0..) |fname, i| {
            var seg_list = std.ArrayList(*const ast.Continuation).initCapacity(allocator, 4) catch unreachable;
            for (watch_arms.items) |*wa| {
                if (wa.field_idx == i) seg_list.append(allocator, &wa.cont) catch unreachable;
            }
            if (seg_list.items.len == 0) {
                ann_arms.append(allocator, ast.Continuation{
                    .branch = allocator.dupe(u8, fname) catch unreachable,
                    .binding = allocator.dupe(u8, "_") catch unreachable,
                    .kind = .terminal,
                    .condition = null,
                    .node = .terminal,
                    .indent = 1,
                    .continuations = &[_]ast.Continuation{},
                    .location = flow.location,
                }) catch unreachable;
                continue;
            }
            var arm2 = ast_functional.cloneContinuation(allocator, seg_list.items[0]) catch unreachable;
            arm2.branch = allocator.dupe(u8, fname) catch unreachable;
            arm2.kind = .terminal;
            arm2.binding = if (seg_list.items[0].binding) |b| allocator.dupe(u8, b) catch unreachable else allocator.dupe(u8, "_") catch unreachable;
            for (seg_list.items[1..]) |seg| {
                var step2 = Graft.asVoidStep(allocator, seg);
                if (seg.binding) |sb| {
                    if (arm2.binding) |ab| {
                        if (!std.mem.eql(u8, sb, ab) and !std.mem.eql(u8, sb, "_")) {
                            Rewrite.rewriteIdentInCont(allocator, &step2, sb, ab);
                        }
                    }
                }
                Graft.atEnds(allocator, &arm2, &step2);
            }
            const guarded2 = arm2.condition != null;
            ann_arms.append(allocator, arm2) catch unreachable;
            any_observer_s = true;
            if (guarded2) {
                ann_arms.append(allocator, ast.Continuation{
                    .branch = allocator.dupe(u8, fname) catch unreachable,
                    .binding = allocator.dupe(u8, "_") catch unreachable,
                    .kind = .terminal,
                    .condition = null,
                    .node = .terminal,
                    .indent = arm2.indent,
                    .continuations = &[_]ast.Continuation{},
                    .location = flow.location,
                }) catch unreachable;
            }
        }
        const ann_call_args = allocator.alloc(ast.Arg, 1) catch unreachable;
        ann_call_args[0] = ast.Arg{ .name = allocator.dupe(u8, "field") catch unreachable, .value = allocator.dupe(u8, "field") catch unreachable };
        if (!any_observer_s) {
            stripe_items.append(allocator, ast.Item{ .proc_decl = ast.ProcDecl{
                .path = mkPath(allocator, home_ns, announce_name),
                .body = ast.Source{ .text = allocator.dupe(u8, "return;") catch unreachable, .location = flow.location, .scope = .{ .bindings = &[_]ast.ScopeBinding{} }, .phantom_type = null },
                .annotations = &[_][]const u8{},
                .target = allocator.dupe(u8, proc_target) catch unreachable,
                .location = flow.location,
                .module = allocator.dupe(u8, flow.module) catch unreachable,
            } }) catch unreachable;
        } else {
            stripe_items.append(allocator, ast.Item{ .flow = ast.Flow{
                .body = ast.rootSite(ast.Invocation{
                    .path = mkPath(allocator, home_ns, peek_name),
                    .args = ann_call_args,
                }, ann_arms.toOwnedSlice(allocator) catch unreachable, flow.location),
                .pre_label = null,
                .impl_of = mkPath(allocator, home_ns, announce_name),
                .super_shape = null,
                .inline_body = null,
                .preamble_code = null,
                .is_pure = false,
                .is_transitively_pure = false,
                .location = flow.location,
                .module = allocator.dupe(u8, flow.module) catch unreachable,
            } }) catch unreachable;
        }

        // envwrite: write-only (no dispatch) - the chain-envelope's first
        // half (690_009): all writes land, THEN announce dispatches.
        {
            const envw_name = std.fmt.allocPrint(allocator, "__store_envwrite_{s}", .{store_name}) catch unreachable;
            const ew_in = allocator.alloc(ast.Field, 2) catch unreachable;
            ew_in[0] = ast.Field{ .name = allocator.dupe(u8, "field") catch unreachable, .type = allocator.dupe(u8, "i64") catch unreachable };
            ew_in[1] = ast.Field{ .name = allocator.dupe(u8, "value") catch unreachable, .type = allocator.dupe(u8, value_type) catch unreachable };
            stripe_items.append(allocator, ast.Item{ .event_decl = ast.EventDecl{
                .path = mkPath(allocator, home_ns, envw_name),
                .input = ast.Shape{ .fields = ew_in },
                .branches = &[_]ast.Branch{},
                .is_public = false,
                .is_implicit_flow = false,
                .annotations = &[_][]const u8{},
                .location = flow.location,
                .module = allocator.dupe(u8, flow.module) catch unreachable,
            } }) catch unreachable;
            // `field` carries a BITMASK — see the plural envwrite. A singleton
            // envelope has one value slot rather than one per column, so every
            // masked field takes the same `value`; the envelope only ever sets
            // one bit here, and the mask keeps the two units' contracts the
            // same shape.
            var ew = std.ArrayList(u8).initCapacity(allocator, 128) catch unreachable;
            if (host_is_js) {
                // JS bitwise operators coerce to 32 bits, so `1 << 40` is not
                // the fortieth bit — it is the eighth. The mask is tested by
                // division instead, which is exact to 2^53 and therefore covers
                // more columns than a store can declare. This is the
                // word-size-is-part-of-the-rendering-contract trap, and the
                // literal transliteration of the Zig line above is silently
                // wrong rather than a syntax error.
                for (field_names, 0..) |fname, i| {
                    const arm3 = std.fmt.allocPrint(allocator, "if (Math.floor(field / {d}) % 2 === 1) __koru_store_{s}.{s} = value;\n", .{ @as(u64, 1) << @intCast(i), store_name, fname }) catch unreachable;
                    ew.appendSlice(allocator, arm3) catch unreachable;
                }
                ew.appendSlice(allocator, "return;") catch unreachable;
            } else {
                ew.appendSlice(allocator, "const __koru_mask = @as(u64, @bitCast(field));\n") catch unreachable;
                for (field_names, 0..) |fname, i| {
                    const arm3 = std.fmt.allocPrint(allocator, "if (__koru_mask & (@as(u64, 1) << {d}) != 0) __koru_store_{s}.{s} = value;\n", .{ i, store_name, fname }) catch unreachable;
                    ew.appendSlice(allocator, arm3) catch unreachable;
                }
                ew.appendSlice(allocator, "return;") catch unreachable;
            }
            stripe_items.append(allocator, ast.Item{ .proc_decl = ast.ProcDecl{
                .path = mkPath(allocator, home_ns, envw_name),
                .body = ast.Source{ .text = ew.toOwnedSlice(allocator) catch unreachable, .location = flow.location, .scope = .{ .bindings = &[_]ast.ScopeBinding{} }, .phantom_type = null },
                .annotations = &[_][]const u8{},
                .target = allocator.dupe(u8, proc_target) catch unreachable,
                .location = flow.location,
                .module = allocator.dupe(u8, flow.module) catch unreachable,
            } }) catch unreachable;
        }

        // stripe: loop the fields, announcing each.
        stripe_items.append(allocator, ast.Item{ .event_decl = ast.EventDecl{
            .path = mkPath(allocator, home_ns, stripe_name),
            .input = ast.Shape{ .fields = &[_]ast.Field{} },
            .branches = &[_]ast.Branch{},
            .is_public = false,
            .is_implicit_flow = false,
            .annotations = &[_][]const u8{},
            .location = flow.location,
            .module = allocator.dupe(u8, flow.module) catch unreachable,
        } }) catch unreachable;
        // The announce call is the SAME text on both targets: `main_module` is a
        // struct on Zig and a const object on JS, and the arg list is the only
        // difference (`.{ .field = 0 }` vs `{ field: 0 }`).
        var sb2 = std.ArrayList(u8).initCapacity(allocator, 128) catch unreachable;
        for (field_names, 0..) |_, i| {
            const call2 = if (host_is_js)
                std.fmt.allocPrint(allocator, "{s}{s}_event.handler({{ field: {d} }});\n", .{ storeEventQualifier(allocator, home_ns, program.main_module_name), announce_name, i }) catch unreachable
            else
                std.fmt.allocPrint(allocator, "{s}{s}_event.handler(.{{ .field = {d} }});\n", .{ storeEventQualifier(allocator, home_ns, program.main_module_name), announce_name, i }) catch unreachable;
            sb2.appendSlice(allocator, call2) catch unreachable;
        }
        sb2.appendSlice(allocator, "return;") catch unreachable;
        stripe_items.append(allocator, ast.Item{ .proc_decl = ast.ProcDecl{
            .path = mkPath(allocator, home_ns, stripe_name),
            .body = ast.Source{ .text = sb2.toOwnedSlice(allocator) catch unreachable, .location = flow.location, .scope = .{ .bindings = &[_]ast.ScopeBinding{} }, .phantom_type = null },
            .annotations = &[_][]const u8{},
            .target = allocator.dupe(u8, proc_target) catch unreachable,
            .location = flow.location,
            .module = allocator.dupe(u8, flow.module) catch unreachable,
        } }) catch unreachable;
    }

    // Whole-program cell-path rewrite (same as the plural create path —
    // `ui.sel` in if/when/sweep outside transplanted watch arms).
    {
        // The cell is a module-scope var in the DECLARING module's emitted
        // struct. A reader in that same module names it bare; a reader
        // anywhere else has to reach across namespaces (110_022).
        const Walk = struct {
            fn prefixesFor(alloc: std.mem.Allocator, prog: *const ast.Program, names: []const []const u8, reader: []const u8) []const []const u8 {
                const px = alloc.alloc([]const u8, names.len) catch unreachable;
                for (names, 0..) |nm, i| {
                    // FILE-derived: `reader` is a `Flow.module`, same domain.
                    const home = H.storeHomeFile(prog, nm) orelse "";
                    if (home.len == 0) {
                        px[i] = "";
                        continue;
                    }
                    // A store in the ENTRY module keeps the bare form: that is
                    // the status quo and `main_module` is the enclosing struct.
                    //
                    // A store in an imported module is ALWAYS fully qualified,
                    // even for a reader in its own module. A same-module read
                    // looks safe unqualified right up until the emitter INLINES
                    // that body into a caller elsewhere (`peek -> cache.v` read
                    // from the entry file), at which point the bare name is in a
                    // namespace that never declared it. The qualified form is
                    // valid from both sides, so it is the only one that survives
                    // inlining.
                    const home_logical_pre = H.storeHomeModule(alloc, prog, nm) orelse "";
                    if (std.mem.eql(u8, home_logical_pre, prog.main_module_name) and std.mem.eql(u8, home, reader)) {
                        px[i] = "";
                        continue;
                    }
                    // Only the ENTRY module's emitted namespace has a name this
                    // layer can spell (`main_module`). A store declared in an
                    // imported module and read from another needs the emitter's
                    // module-path mangling. `storeEmitQualifier` applies the same
                    // rule as `emitter_helpers.writeModulePath`, so a cross-module
                    // cell read now lowers for ANY declaring module — it used to
                    // refuse, because this rewrite could only spell `main_module`.
                    px[i] = storeCellQualifier(alloc, home_logical_pre, prog.main_module_name);
                }
                return px;
            }
            // Each item carries the module it was declared in, so the reader is
            // read off the item rather than threaded down the walk.
            fn items(alloc: std.mem.Allocator, prog: *const ast.Program, its: []ast.Item, names: []const []const u8, idents: []const []const u8) void {
                for (its) |*pi| {
                    switch (pi.*) {
                        // Must use `&pi.flow` — `|*f|` on a switched copy
                        // mutates a temporary and the live AST stays raw.
                        .flow => Rewrite.rewriteFlow(alloc, prog, &pi.flow, .{ .names = names, .prefixes = prefixesFor(alloc, prog, names, pi.flow.module) }, idents),
                        .immediate_impl => Rewrite.rewriteImmediateImpl(alloc, prog, &pi.immediate_impl, .{ .names = names, .prefixes = prefixesFor(alloc, prog, names, pi.immediate_impl.module) }, idents),
                        .module_decl => items(alloc, prog, @constCast(pi.module_decl.items), names, idents),
                        else => {},
                    }
                }
            }
        };
        Walk.items(allocator, program, @constCast(program.items), store_names.items, store_idents.items);
    }

    // ------------------------------------------------------------------
    // Assemble: the create site dissolves into a comment; the five
    // generated units append as top-level items.
    // ------------------------------------------------------------------
    const consumed = std.fmt.allocPrint(allocator, "// std/store: '{s}' created (cell + write-subflow at module scope)", .{store_name}) catch unreachable;
    const replacement = ast.Item{ .host_line = ast.HostLine{
        .content = consumed,
        .location = flow.location,
        .module = allocator.dupe(u8, flow.module) catch unreachable,
    } };

    const appended = allocator.alloc(ast.Item, 5 + stripe_items.items.len) catch unreachable;
    // The cell rides the SAME namespace as the accessors that read it. A cell
    // left in the file-derived module is emitted outside the namespace its own
    // apply/write units live in, and every `<store>.<field>` reference resolves
    // to nothing.
    // A `host_line` reaches the JS file only when the FILE it points at is a JS
    // host facet (js_emitter.zig:223), and a synthesized line points at the
    // user's `.k` — so on JS the cell was dropped in silence while every
    // accessor that reads it was emitted. `.inline_code` is the top-level path
    // that carries a transform's appended declarations on both targets; on Zig
    // the `host_line` stays, because that is what places the cell INSIDE the
    // declaring module's emitted struct, and `.inline_code` is written above
    // `main_module` where a JS `let` is exactly as reachable.
    appended[0] = if (host_is_js) ast.Item{ .inline_code = ast.InlineCode{
        .code = cell_decl,
        .location = flow.location,
        .module = allocator.dupe(u8, home_ns) catch unreachable,
    } } else ast.Item{ .host_line = ast.HostLine{
        .content = cell_decl,
        .location = flow.location,
        .module = allocator.dupe(u8, home_ns) catch unreachable,
    } };
    appended[1] = apply_event_item;
    appended[2] = apply_proc_item;
    appended[3] = write_event_item;
    appended[4] = impl_flow_item;
    for (stripe_items.items, 0..) |si, sii| appended[5 + sii] = si;

    return .{ .transformed = .{ .replacement = replacement, .appended = appended } };
}

// ============================================================================
// STORE.STORED — the sole write path: an ordinary call into the subflow
// ============================================================================
//
//   std/store:stored { game.entities: game.entities + 1 }
//
// Rewritten into `__store_write_game(field: <idx>, value: <expr'>)` where
// <expr'> has dotted store reads rewritten to the cell. The replacement is
// a real flow, so it is emitted inside a function like any other call.

~[keyword|comptime|transform]pub tor stored {
    source: Source,
    invocation: *const Invocation,
    item: *const Item,
    program: *const Program,
    reporter: *std/compiler:ErrorReporter,
    allocator: std.mem.Allocator
} -> SiteResult

~[transform]proc stored|zig {
    const ast = @import("ast");
    // A written value that BUILT text left its buffer declaration on the
    // original invocation. Carrying that preamble onto a replacement flow is
    // not enough on its own: the pass runner treats a preamble-bearing
    // replacement as the `capture`/`const` contract — the preamble REPLACES
    // the call — and DROPS the invocation, so the write silently disappears
    // (transform_pass_runner.zig:104, and the comment there says exactly this).
    //
    // `@preamble_then_call` is the annotation for the other contract, and it is
    // the one this needs: the preamble declares caller-frame stack storage and
    // the routed call still happens. Same shape as the escape-driven stack
    // alloc it was built for.
    const preambleAnn = struct {
        fn call(alloc: std.mem.Allocator, inv: *const ast.Invocation, base: []const []const u8) []const []const u8 {
            if (inv.preamble_code == null) return base;
            const out = alloc.alloc([]const u8, base.len + 1) catch unreachable;
            for (base, 0..) |b, i| out[i] = b;
            out[base.len] = alloc.dupe(u8, "@preamble_then_call") catch unreachable;
            return out;
        }
    }.call;

    const ast_functional = @import("ast_functional");
    const struct_literal = @import("struct_literal");

    if (item.* != .flow) @panic("store:stored transform: containing item is not a flow - walker dispatch contract broken");
    const flow = &item.flow;

    const H = struct {
        fn stripQuotes(n: []const u8) []const u8 {
            if (n.len >= 2 and n[0] == '"') return n[1 .. n.len - 1];
            return n;
        }
        fn mkPathH2(alloc: std.mem.Allocator, module: []const u8, name: []const u8) ast.DottedPath {
            const segs2 = alloc.alloc([]const u8, 1) catch unreachable;
            segs2[0] = alloc.dupe(u8, name) catch unreachable;
            return ast.DottedPath{ .module_qualifier = alloc.dupe(u8, module) catch unreachable, .segments = segs2 };
        }
        fn isIdent(ch: u8) bool {
            return (ch >= 'a' and ch <= 'z') or (ch >= 'A' and ch <= 'Z') or (ch >= '0' and ch <= '9') or ch == '_' or ch == '-';
        }
        // Boundary-aware store-name rewrite: `game.entities` → the cell path,
        // only where `game` is a whole identifier followed by a dot.
        fn storeRefs(alloc: std.mem.Allocator, text: []const u8, name: []const u8, is_identity: bool) []const u8 {
            const expr_ctx = ast.expressionMask(alloc, text);
            var out = std.ArrayList(u8).initCapacity(alloc, text.len + 32) catch unreachable;
            var i: usize = 0;
            while (i < text.len) {
                const at_boundary = ast.identBoundaryBefore(text, i);
                const starts = at_boundary and std.mem.startsWith(u8, text[i..], name);
                const after = i + name.len;
                if (starts and after < text.len and text[after] == '.') {
                    out.appendSlice(alloc, "__koru_store_") catch unreachable;
                    out.appendSlice(alloc, name) catch unreachable;
                    i += name.len;
                } else if (is_identity and expr_ctx[i] and starts and
                    (after >= text.len or (!isIdent(text[after]) and text[after] != '[')))
                {
                    // A ONE-column store read on the RHS of its own write:
                    // `stored { counter: counter + 2 }`. `[` is excluded so a row
                    // index (`todos[…]`) still takes the indexed path below.
                    out.appendSlice(alloc, "__koru_store_") catch unreachable;
                    out.appendSlice(alloc, name) catch unreachable;
                    out.append(alloc, '.') catch unreachable;
                    out.appendSlice(alloc, ast.STORE_IDENTITY_COLUMN) catch unreachable;
                    i += name.len;
                } else {
                    out.append(alloc, text[i]) catch unreachable;
                    i += 1;
                }
            }
            return out.toOwnedSlice(alloc) catch unreachable;
        }
        // Every store name visible in the program — untransformed creates plus
        // generated apply events — so a row index / RHS can rewrite a FOREIGN
        // singleton cell (`todos[ui.sel]` → `__koru_store_ui.sel`, 690_075).
        fn allStoreNames(alloc: std.mem.Allocator, prog: *const ast.Program) []const []const u8 {
            return storeAllNames(alloc, prog);
        }
        fn storeRefsAll(alloc: std.mem.Allocator, prog: *const ast.Program, text: []const u8) []const u8 {
            var t = text;
            for (allStoreNames(alloc, prog)) |nm| t = storeRefs(alloc, t, nm, isIdentityStore(alloc, prog, nm));
            return t;
        }
        // `store[index].field` → SoA column read (690_076). Runs AFTER
        // storeRefsAll so a cross-store index is already `__koru_store_ui.sel`.
        //
        // The rewriter itself is file scope (`storeIndexedRefs`), because a
        // private helper struct inside a transform is a lowering boundary and
        // `new`'s whole-program walk needs the same lowering (690_250/690_254).
        // A `stored` site is emitted into the declaring module's own namespace,
        // so every store reaches it unprefixed.
        fn indexedFieldRefsAll(alloc: std.mem.Allocator, prog: *const ast.Program, text: []const u8) []const u8 {
            return storeIndexedRefsIn(alloc, prog, text, storeScopeBare(alloc, prog));
        }
        fn lowerStoreExprs(alloc: std.mem.Allocator, prog: *const ast.Program, text: []const u8) []const u8 {
            return indexedFieldRefsAll(alloc, prog, storeRefsAll(alloc, prog, text));
        }
        // The module a store was DECLARED in — where its generated accessors
        // live. A write site in another module must call them there, not in
        // its own namespace: store names are program-global but the accessors
        // are emitted into the declaring module only (110_022). Same two-source
        // shape as `fieldOrder`, so it answers under any transform order.
        fn storeHomeModule(alloc: std.mem.Allocator, prog: *const ast.Program, store: []const u8) ?[]const u8 {
            const apply_name = std.fmt.allocPrint(alloc, "__store_apply_{s}", .{store}) catch unreachable;
            // Descends into `module_decl` for the same reason as `new`'s twin at
            // the top of this file: a library declaring its own store writes the
            // `new` inside the module, and a top-level-only search reports no
            // home for precisely that case.
            const Find = struct {
                fn applyIn(its: []const ast.Item, want: []const u8) ??[]const u8 {
                    for (its) |pi| {
                        if (pi == .event_decl) {
                            const ed = &pi.event_decl;
                            if (ed.path.segments.len == 1 and std.mem.eql(u8, ed.path.segments[0], want)) {
                                return ed.path.module_qualifier;
                            }
                        } else if (pi == .module_decl) {
                            if (applyIn(pi.module_decl.items, want)) |hit| return hit;
                        }
                    }
                    return null;
                }
                // `enclosing` is the containing module's LOGICAL name — see the
                // twin of this helper at the top of the file.
                fn newIn(its: []const ast.Item, want: []const u8, enclosing: ?[]const u8) ?[]const u8 {
                    for (its) |pi| {
                        if (pi == .flow) {
                            const f = &pi.flow;
                            const inv = f.inv();
                            if (inv.path.segments.len == 1 and std.mem.eql(u8, inv.path.segments[0], "new")) {
                                const mq = inv.path.module_qualifier orelse continue;
                                if (std.mem.eql(u8, mq, "std.store")) {
                                    for (inv.args) |a| {
                                        if (std.mem.eql(u8, a.name, "expr") and std.mem.eql(u8, stripQuotes(a.value), want)) {
                                            return enclosing orelse f.module;
                                        }
                                    }
                                }
                            }
                        } else if (pi == .module_decl) {
                            if (newIn(pi.module_decl.items, want, pi.module_decl.logical_name)) |m| return m;
                        }
                    }
                    return null;
                }
            };
            if (Find.applyIn(prog.items, apply_name)) |hit| return hit;
            if (Find.newIn(prog.items, store, null)) |m| return m;
            return null;
        }
        // Field order for a store, deterministic under any transform order.
        // File-scope `storeFieldOrder` is THE answer; this copy had only two of
        // its three sources and so declined to lower for a plural store whose
        // `new` had run but whose apply event it could not see.
        fn fieldOrder(alloc: std.mem.Allocator, prog: *const ast.Program, store: []const u8) ?[]const []const u8 {
            return storeFieldOrder(alloc, prog, store);
        }
        /// Does this store name ONE column and no field? Then the store itself
        /// is the lvalue and the synthesized column takes the value.
        fn isIdentityStore(alloc: std.mem.Allocator, prog: *const ast.Program, store: []const u8) bool {
            const order = fieldOrder(alloc, prog, store) orelse return false;
            return order.len == 1 and std.mem.eql(u8, order[0], ast.STORE_IDENTITY_COLUMN);
        }
    };

    var block_text: ?[]const u8 = null;
    for (invocation.args) |arg| {
        if (std.mem.eql(u8, arg.name, "source")) block_text = arg.value;
    }
    if (block_text == null) {
        return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, "std/store:stored requires a write block: stored {{ store.field: expr }}", .{}) } };
    }

    const braced = std.fmt.allocPrint(allocator, "{{{s}}}", .{block_text.?}) catch unreachable;
    const writes = struct_literal.parseFields(allocator, braced) catch |err| {
        return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, "std/store:stored: {s}", .{struct_literal.describeError(err)}) } };
    };
    if (writes.len == 0) {
        return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, "std/store:stored: write block is empty", .{}) } };
    }

    // THE CHAIN IS THE ENVELOPE ((i) lean, 690_009): a multi-field block
    // is ONE atomic unit - every write lands (write-only envwrite), THEN
    // dispatch runs in write order (announce, which reads settled state).
    if (writes.len > 1) {
        // All targets must be the same store — and, row-addressed, the same
        // row — this rung. Each target parses through the same head grammar
        // as the single-write path below: the dotted singleton head
        // (`store.field`) or the bracket row head (`store[handle].field`,
        // which is also what a sweep arm's row binding lowers to, 690_118).
        var env_store: []const u8 = "";
        var env_row: ?[]const u8 = null;
        const env_fields = allocator.alloc([]const u8, writes.len) catch unreachable;
        const env_raw_values = allocator.alloc([]const u8, writes.len) catch unreachable;
        for (writes, 0..) |wm, wi| {
            var st: []const u8 = undefined;
            var fld: []const u8 = undefined;
            var wrow: ?[]const u8 = null;
            if (std.mem.indexOfScalar(u8, wm.name, '[')) |lb| {
                const rb = std.mem.lastIndexOfScalar(u8, wm.name, ']') orelse {
                    return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, "std/store:stored: malformed addressing head '{s}'", .{wm.name}) } };
                };
                if (rb + 1 >= wm.name.len or wm.name[rb + 1] != '.') {
                    return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, "std/store:stored: addressing head '{s}' needs a field: store[handle].field", .{wm.name}) } };
                }
                st = std.mem.trim(u8, wm.name[0..lb], " ");
                wrow = std.mem.trim(u8, wm.name[lb + 1 .. rb], " ");
                fld = wm.name[rb + 2 ..];
            } else {
                const dotm = std.mem.indexOfScalar(u8, wm.name, '.') orelse {
                    return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, "std/store:stored: envelope target '{s}' must be store.field", .{wm.name}) } };
                };
                st = wm.name[0..dotm];
                fld = wm.name[dotm + 1 ..];
            }
            if (wi == 0) {
                env_store = st;
                env_row = wrow;
            } else {
                if (!std.mem.eql(u8, env_store, st)) {
                    return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, "std/store:stored: a multi-field envelope writes ONE store this rung ('{s}' vs '{s}')", .{ env_store, st }) } };
                }
                const rows_agree = if (env_row) |er|
                    (if (wrow) |wr| std.mem.eql(u8, er, wr) else false)
                else
                    wrow == null;
                if (!rows_agree) {
                    return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, "std/store:stored: a multi-field envelope addresses ONE row this rung - every target must spell the same row ('{s}')", .{wm.name}) } };
                }
            }
            env_fields[wi] = fld;
            env_raw_values[wi] = wm.value;
        }
        // The head form must match the store's shape — the same two walls as
        // the single-write path.
        const env_is_plural = blk: {
            const inserth_probe = std.fmt.allocPrint(allocator, "__store_inserth_{s}", .{env_store}) catch unreachable;
            for (flatItems(allocator, program.items)) |pi| {
                if (pi.* != .event_decl) continue;
                const ed = &pi.event_decl;
                if (ed.path.segments.len == 1 and std.mem.eql(u8, ed.path.segments[0], inserth_probe)) break :blk true;
            }
            break :blk false;
        };
        if (env_row == null and env_is_plural) {
            return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, "std/store:stored: '{s}' is a container store (capacity > 1) - address the row ({s}[handle].{s}, or write through a query branch)", .{ env_store, env_store, env_fields[0] }) } };
        }
        if (env_row != null and !env_is_plural) {
            return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, "std/store:stored: '{s}' is a capacity-1 value store - write it as {s}.{s}", .{ env_store, env_store, env_fields[0] }) } };
        }
        // A DRAIN store's write surface is gated off entirely (690_057/058) —
        // name the real rung before fieldOrder can leak "unknown store".
        if (env_row != null) {
            const td_probe = std.fmt.allocPrint(allocator, "__store_teardown_{s}", .{env_store}) catch unreachable;
            const apply_probe = std.fmt.allocPrint(allocator, "__store_apply_{s}", .{env_store}) catch unreachable;
            var has_teardown = false;
            var has_apply = false;
            for (flatItems(allocator, program.items)) |pi| {
                if (pi.* != .event_decl) continue;
                const ed = &pi.event_decl;
                if (ed.path.segments.len != 1) continue;
                if (std.mem.eql(u8, ed.path.segments[0], td_probe)) has_teardown = true;
                if (std.mem.eql(u8, ed.path.segments[0], apply_probe)) has_apply = true;
            }
            if (has_teardown and !has_apply) {
                return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, "std/store:stored: store '{s}' is a DRAIN store (ambiguous discharger) - a stored write must evict the old value through the canonical discharger, which its owned column does not have; declare exactly one void discharger for the column type (690_062 pins the write; 690_057/058 pin the drain)", .{env_store}) } };
            }
        }
        const order_env = H.fieldOrder(allocator, program, env_store) orelse {
            // The store's OWN declaration was already refused; that diagnostic is the
            // true one and this lookup can only ever fail. Staying silent here is what
            // keeps one mistake to one error.
            if (ast.declarationRefused(allocator, program, flow.module, "std/store:new({s}):", .{env_store})) return .{ .transformed = .{} };
            return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, "std/store:stored: unknown store '{s}'", .{env_store}) } };
        };
        const env_idx = allocator.alloc(usize, writes.len) catch unreachable;
        for (env_fields, 0..) |ef, wi| {
            env_idx[wi] = blk: {
                for (order_env, 0..) |fname, i| {
                    if (std.mem.eql(u8, fname, ef)) break :blk i;
                }
                return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, "std/store:stored: '{s}' is not a field of store '{s}'", .{ ef, env_store }) } };
            };
        }
        // The plural envelope rides typed per-column slots (the bundled-write
        // shape, 690_049) — read the column types off the generated apply
        // event. An owned-containing store has no bundled envelope (a dead
        // owned slot has no typed zero, 690_064): chain single-field writes.
        var env_col_types: []const []const u8 = &[_][]const u8{};
        if (env_row != null) {
            const apply_name2 = std.fmt.allocPrint(allocator, "__store_apply_{s}", .{env_store}) catch unreachable;
            for (flatItems(allocator, program.items)) |pi| {
                if (pi.* != .event_decl) continue;
                const ed = &pi.event_decl;
                if (ed.path.segments.len == 1 and std.mem.eql(u8, ed.path.segments[0], apply_name2)) {
                    const types = allocator.alloc([]const u8, ed.branches.len) catch unreachable;
                    for (ed.branches, 0..) |b, bi| {
                        if (b.payload.fields.len > 0 and b.payload.fields[0].phantom != null) {
                            return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, "std/store:stored: store '{s}' holds an owned column - a multi-field envelope has no typed zero for its slot (690_064); chain single-field writes instead ({s}[handle].{s}: ... |> stored {{ ... }})", .{ env_store, env_store, env_fields[0] }) } };
                        }
                        types[bi] = if (b.payload.fields.len > 0) b.payload.fields[0].type else "i64";
                    }
                    env_col_types = types;
                }
            }
        }
        // SELF-FK traversal / cross-store cell heads in the shared row
        // expression — the same rewrite the single-write path applies.
        if (env_row) |re| {
            if (std.mem.indexOfScalar(u8, re, '.')) |dp| {
                const base = std.mem.trim(u8, re[0..dp], " ");
                const ref_field = std.mem.trim(u8, re[dp + 1 ..], " ");
                var ref_ok = false;
                for (order_env) |fname| {
                    if (std.mem.eql(u8, fname, ref_field)) {
                        ref_ok = true;
                        break;
                    }
                }
                if (ref_ok) {
                    // Pointer-named base (`&`) — see colRead: a by-value base
                    // copies the whole column before the resolve.
                    env_row = std.fmt.allocPrint(allocator, "(&__koru_store_{s}.{s})[__koru_store_{s}.__koru_resolve({s})]", .{ env_store, ref_field, env_store, base }) catch unreachable;
                } else {
                    env_row = H.storeRefsAll(allocator, program, re);
                }
            } else {
                env_row = H.storeRefsAll(allocator, program, re);
            }
        }
        // ONE lowering for a value, whether the envelope is row-addressed or
        // not. The non-row-addressed arm used to rewrite only the envelope's
        // OWN store, so a value reading any OTHER store — or reading one
        // through a handle at all — reached the host verbatim. The single-write
        // path (below, `rewritten_expr`) has always used the full lowering;
        // this is the same construct's second lowering catching up (690_245).
        const env_values = allocator.alloc([]const u8, writes.len) catch unreachable;
        for (env_raw_values, 0..) |rv, wi| {
            env_values[wi] = H.lowerStoreExprs(allocator, program, rv);
        }
        // Build the chain: envwrite each, then announce each (write order).
        //
        // These units were DECLARED by `new` under the store's home module, so
        // reference them by that same logical name. `flow.module` is the file
        // the WRITE was written in and names a namespace nothing declared.
        const env_home = H.storeHomeModule(allocator, program, env_store) orelse flow.module;
        const envw_name = std.fmt.allocPrint(allocator, "__store_envwrite_{s}", .{env_store}) catch unreachable;
        const ann_name = std.fmt.allocPrint(allocator, "__store_announce_{s}", .{env_store}) catch unreachable;
        // ONE envwrite for the whole block, then one announce per field.
        //
        // The envelope used to emit a write PER FIELD, which is what made it a
        // sequence: entry 2's arguments were evaluated after entry 1's write had
        // landed, so a rhs could read a sibling's result. A block is one write
        // (`frag-std-store-design`), so it is one call — every rhs is an
        // argument, arguments are evaluated before the call, and pre-state falls
        // out with no analysis. 690_126 and 690_251 pin it.
        //
        // Announce still runs per field, after, in written order: dispatch reads
        // settled state, which is the half of the (i) lean that was always right.
        const row_addressed = env_row != null;
        const n_writes: usize = if (row_addressed) 1 else writes.len;
        var invs = allocator.alloc(ast.Invocation, n_writes + writes.len) catch unreachable;
        if (row_addressed) {
            // A u64 mask names the written columns; a store wide enough to
            // overflow it cannot spell a multi-field block, and says so rather
            // than quietly dropping the high columns.
            for (env_idx) |ix| {
                if (ix >= 64) {
                    return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, "std/store:stored: a multi-field block addresses columns by a 64-bit mask, and '{s}' has more than 64 columns - write this as chained single-field writes", .{env_store}) } };
                }
            }
            var mask: u64 = 0;
            for (env_idx) |ix| mask |= (@as(u64, 1) << @intCast(ix));
            const re = env_row.?;
            const env_row_arg = if (std.mem.startsWith(u8, re, "__koru_sdix_"))
                re
            else
                std.fmt.allocPrint(allocator, "@as(i64, @intCast(__koru_store_{s}.__koru_resolve({s})))", .{ env_store, re }) catch unreachable;
            // THE SPECIALISED UNIT IF `new` EMITTED ONE, else the general
            // masked one. Both sides derive the name from the same ascending
            // column list, so agreement is by construction; the existence check
            // is the same shape `writec_name` already uses (:6890), and a miss
            // costs speed rather than correctness.
            const sorted = allocator.alloc(usize, env_idx.len) catch unreachable;
            @memcpy(sorted, env_idx);
            std.mem.sort(usize, sorted, {}, comptime std.sort.asc(usize));
            const spec_name = storeEnvwriteSpecName(allocator, env_store, sorted);
            const has_spec = blk_spec: {
                for (flatItems(allocator, program.items)) |pi| {
                    if (pi.* != .event_decl) continue;
                    const ed = &pi.event_decl;
                    if (ed.path.segments.len == 1 and std.mem.eql(u8, ed.path.segments[0], spec_name)) break :blk_spec true;
                }
                break :blk_spec false;
            };
            if (has_spec) {
                const a1 = allocator.alloc(ast.Arg, sorted.len + 1) catch unreachable;
                a1[0] = ast.Arg{ .name = allocator.dupe(u8, "row") catch unreachable, .value = allocator.dupe(u8, env_row_arg) catch unreachable };
                for (sorted, 0..) |ci, k| {
                    var slot: []const u8 = "";
                    for (env_idx, 0..) |ix, wi| {
                        if (ix == ci) slot = env_values[wi];
                    }
                    a1[1 + k] = ast.Arg{
                        .name = std.fmt.allocPrint(allocator, "value_{d}", .{ci}) catch unreachable,
                        .value = slot,
                    };
                }
                invs[0] = ast.Invocation{ .path = H.mkPathH2(allocator, env_home, spec_name), .args = a1, .annotations = preambleAnn(allocator, invocation, &[_][]const u8{}) };
            } else {
                const a1 = allocator.alloc(ast.Arg, env_col_types.len + 2) catch unreachable;
                a1[0] = ast.Arg{ .name = allocator.dupe(u8, "row") catch unreachable, .value = allocator.dupe(u8, env_row_arg) catch unreachable };
                a1[1] = ast.Arg{ .name = allocator.dupe(u8, "field") catch unreachable, .value = std.fmt.allocPrint(allocator, "@as(i64, @bitCast(@as(u64, {d})))", .{mask}) catch unreachable };
                for (env_col_types, 0..) |ct, ci| {
                    const is_float = std.mem.eql(u8, ct, "f64") or std.mem.eql(u8, ct, "f32");
                    const is_string = std.mem.eql(u8, ct, "string") or std.mem.eql(u8, ct, "[]const u8");
                    var slot: []const u8 = allocator.dupe(u8, if (is_string) "\"\"" else if (is_float) "0.0" else "0") catch unreachable;
                    for (env_idx, 0..) |ix, wi| {
                        if (ix == ci) slot = env_values[wi];
                    }
                    a1[2 + ci] = ast.Arg{
                        .name = std.fmt.allocPrint(allocator, "value_{d}", .{ci}) catch unreachable,
                        .value = slot,
                    };
                }
                invs[0] = ast.Invocation{ .path = H.mkPathH2(allocator, env_home, envw_name), .args = a1, .annotations = preambleAnn(allocator, invocation, &[_][]const u8{}) };
            }
            for (writes, 0..) |_, wi| {
                const a2 = allocator.alloc(ast.Arg, 2) catch unreachable;
                a2[0] = ast.Arg{ .name = allocator.dupe(u8, "row") catch unreachable, .value = allocator.dupe(u8, env_row_arg) catch unreachable };
                a2[1] = ast.Arg{ .name = allocator.dupe(u8, "field") catch unreachable, .value = std.fmt.allocPrint(allocator, "{d}", .{env_idx[wi]}) catch unreachable };
                invs[1 + wi] = ast.Invocation{ .path = H.mkPathH2(allocator, env_home, ann_name), .args = a2 };
            }
        }
        // The singleton envelope still emits one call per field: its
        // envwrite carries a single `value` slot rather than one per
        // column, so it cannot take the whole block at once. A singleton
        // store's columns all share one scalar type, so widening it is
        // possible and is the next rung — until then a multi-field
        // singleton block keeps the old ordering and 690_126 covers only
        // the plural path.
        if (!row_addressed) {
            for (writes, 0..) |_, wi| {
                const a1 = allocator.alloc(ast.Arg, 2) catch unreachable;
                // A BIT, not an index — the singleton envwrite reads `field` as
                // a mask, same contract as the plural one.
                a1[0] = ast.Arg{ .name = allocator.dupe(u8, "field") catch unreachable, .value = std.fmt.allocPrint(allocator, "@as(i64, @bitCast(@as(u64, 1) << {d}))", .{env_idx[wi]}) catch unreachable };
                a1[1] = ast.Arg{ .name = allocator.dupe(u8, "value") catch unreachable, .value = env_values[wi] };
                invs[wi] = ast.Invocation{
                    .path = H.mkPathH2(allocator, env_home, envw_name),
                    .args = a1,
                };
                const a2 = allocator.alloc(ast.Arg, 1) catch unreachable;
                a2[0] = ast.Arg{ .name = allocator.dupe(u8, "field") catch unreachable, .value = std.fmt.allocPrint(allocator, "{d}", .{env_idx[wi]}) catch unreachable };
                invs[writes.len + wi] = ast.Invocation{
                    .path = H.mkPathH2(allocator, env_home, ann_name),
                    .args = a2,
                };
            }
        }
        // Nested void chain, last step innermost. The chain BOTTOMS OUT in the
        // containing flow's original continuations (the `stored{…} |> next`
        // tail) — un-marked, so the runner's fixed-point pass re-lowers a tail
        // `stored`. The synthesized envwrite/announce nodes stay
        // `is_transformed_subtree` (they must not re-fire); only the user tail
        // beneath them is walked again. Empty here dropped the tail (690_028).
        var chain: []const ast.Continuation = flow.body.continuations;
        var k: usize = n_writes + writes.len;
        while (k > 1) {
            k -= 1;
            const one = allocator.alloc(ast.Continuation, 1) catch unreachable;
            one[0] = ast.Continuation{
                .branch = allocator.dupe(u8, "") catch unreachable,
                .binding = null,
                .kind = .terminal,
                .condition = null,
                .node = .{ .invocation = invs[k] },
                .indent = 1,
                .continuations = chain,
                .is_transformed_subtree = true,
                .location = flow.location,
            };
            chain = one;
        }
        return .{ .transformed = .{ .replacement = ast.Item{ .flow = ast.Flow{
            .body = ast.rootSite(invs[0], chain, flow.location),
            .pre_label = null,
            .impl_of = flow.impl_of,
            .super_shape = null,
            .inline_body = null,
            .preamble_code = invocation.preamble_code,
            .is_pure = false,
            .is_transitively_pure = false,
            .location = flow.location,
            .module = allocator.dupe(u8, flow.module) catch unreachable,
        } } } };
    }

    const w = writes[0];
    // Two lvalue heads this rung (O2: one path grammar, four heads):
    //   `store.field`            — elided-singleton head (singleton stores)
    //   `store[handle].field`    — handle / query-row head (plural stores)
    var target_store: []const u8 = undefined;
    var target_field: []const u8 = undefined;
    var row_expr: ?[]const u8 = null;
    if (std.mem.indexOfScalar(u8, w.name, '[')) |lb| {
        const rb = std.mem.lastIndexOfScalar(u8, w.name, ']') orelse {
            return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, "std/store:stored: malformed addressing head '{s}'", .{w.name}) } };
        };
        if (rb + 1 >= w.name.len or w.name[rb + 1] != '.') {
            return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, "std/store:stored: addressing head '{s}' needs a field: store[handle].field", .{w.name}) } };
        }
        target_store = std.mem.trim(u8, w.name[0..lb], " ");
        row_expr = std.mem.trim(u8, w.name[lb + 1 .. rb], " ");
        target_field = w.name[rb + 2 ..];
    } else {
        if (std.mem.indexOfScalar(u8, w.name, '.')) |dot| {
            target_store = w.name[0..dot];
            target_field = w.name[dot + 1 ..];
        } else if (H.isIdentityStore(allocator, program, w.name)) {
            // A ONE-column store names no field, so the store IS the lvalue:
            // `stored { counter: 5 }`. There is no `.field` to write because
            // there is no field — the synthesized column takes the value.
            target_store = w.name;
            target_field = ast.STORE_IDENTITY_COLUMN;
        } else {
            return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, "std/store:stored target '{s}' must be a dotted store path (store.field)", .{w.name}) } };
        }
    }

    // A plural store's write surface is row-addressed; the elided-singleton
    // head on it has no row to mean.
    const is_plural_store = blk: {
        const inserth_name = std.fmt.allocPrint(allocator, "__store_inserth_{s}", .{target_store}) catch unreachable;
        for (flatItems(allocator, program.items)) |pi| {
            if (pi.* != .event_decl) continue;
            const ed = &pi.event_decl;
            if (ed.path.segments.len == 1 and std.mem.eql(u8, ed.path.segments[0], inserth_name)) break :blk true;
        }
        break :blk false;
    };
    if (row_expr == null and is_plural_store) {
        return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, "std/store:stored: '{s}' is a container store (capacity > 1) - address the row ({s}[handle].{s}, or write through a query branch)", .{ target_store, target_store, target_field }) } };
    }
    if (row_expr != null and !is_plural_store) {
        return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, "std/store:stored: '{s}' is a capacity-1 value store - write it as {s}.{s}", .{ target_store, target_store, target_field }) } };
    }

    // Owned-column stores now generate the write surface (the WRITE rung,
    // 690_062: discharge-old + consume-new) — EXCEPT a DRAIN store (ambiguous
    // discharger, 690_057/058), where unit-4 stays ungated-off: the write's
    // eviction has no canonical discharger to fire. Detect that store FIRST
    // (teardown unit exists, apply unit does not) and name the real rung —
    // otherwise H.fieldOrder below would leak a raw "unknown store".
    {
        const td_probe = std.fmt.allocPrint(allocator, "__store_teardown_{s}", .{target_store}) catch unreachable;
        const apply_probe = std.fmt.allocPrint(allocator, "__store_apply_{s}", .{target_store}) catch unreachable;
        var has_teardown = false;
        var has_apply = false;
        for (flatItems(allocator, program.items)) |pi| {
            if (pi.* != .event_decl) continue;
            const ed = &pi.event_decl;
            if (ed.path.segments.len != 1) continue;
            if (std.mem.eql(u8, ed.path.segments[0], td_probe)) has_teardown = true;
            if (std.mem.eql(u8, ed.path.segments[0], apply_probe)) has_apply = true;
        }
        if (has_teardown and !has_apply) {
            return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, "std/store:stored: store '{s}' is a DRAIN store (ambiguous discharger) - a stored write must evict the old value through the canonical discharger, which its owned column does not have; declare exactly one void discharger for the column type (690_062 pins the write; 690_057/058 pin the drain)", .{target_store}) } };
        }
    }

    const order = H.fieldOrder(allocator, program, target_store) orelse {
        // The store's OWN declaration was already refused; that diagnostic is the
        // true one and this lookup can only ever fail. Staying silent here is what
        // keeps one mistake to one error.
        if (ast.declarationRefused(allocator, program, flow.module, "std/store:new({s}):", .{target_store})) return .{ .transformed = .{} };
        return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, "std/store:stored: unknown store '{s}' - no std/store:new({s}) found", .{ target_store, target_store }) } };
    };
    const field_idx: usize = blk: {
        for (order, 0..) |fname, i| {
            if (std.mem.eql(u8, fname, target_field)) break :blk i;
        }
        return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, "std/store:stored: '{s}' is not a field of store '{s}'", .{ target_field, target_store }) } };
    };

    // SELF-FK traversal head: `store[handle.reffield]` addresses the row whose
    // index IS the value of `reffield` in row `handle` — i.e. it FOLLOWS a
    // stored self-foreign-key. `reffield` must be a field of THIS store (a
    // handle-carrying column); the head is rewritten to a column read so the
    // ref dereferences to a row index (one hop). A plain handle head (`[a]`,
    // `[__koru_qrow]`) has no dot and is left untouched — except a CROSS-STORE
    // cell index (`[ui.sel]`) whose dotted form is NOT a field of this store:
    // rewrite every known `store.cell` path into `__koru_store_*` (690_075).
    if (row_expr) |re| {
        if (std.mem.indexOfScalar(u8, re, '.')) |dp| {
            const base = std.mem.trim(u8, re[0..dp], " ");
            const ref_field = std.mem.trim(u8, re[dp + 1 ..], " ");
            var ref_ok = false;
            for (order) |fname| {
                if (std.mem.eql(u8, fname, ref_field)) {
                    ref_ok = true;
                    break;
                }
            }
            if (ref_ok) {
                // Pointer-named base (`&`) — see colRead: a by-value base
                // copies the whole column before the resolve.
                row_expr = std.fmt.allocPrint(allocator, "(&__koru_store_{s}.{s})[__koru_store_{s}.__koru_resolve({s})]", .{ target_store, ref_field, target_store, base }) catch unreachable;
            } else {
                row_expr = H.storeRefsAll(allocator, program, re);
            }
        } else {
            row_expr = H.storeRefsAll(allocator, program, re);
        }
    }
    // THE ROW ARG IS DENSE (the write-family convention): a handle expression
    // resolves HERE, at the write site — so the stale trap (690_115) fires
    // exactly where it used to — while a sweep cursor (`__koru_sdix_*`) is
    // already the dense loop index and passes through untouched. That pass-
    // through is the O10.iv elision: a sweep stands on a row it can see, so
    // its write needs no generational round-trip (handle_of → resolve was a
    // dependent load chain in the hottest loop the language has).
    const row_arg: ?[]const u8 = if (row_expr) |re|
        (if (std.mem.startsWith(u8, re, "__koru_sdix_"))
            re
        else
            std.fmt.allocPrint(allocator, "@as(i64, @intCast(__koru_store_{s}.__koru_resolve({s})))", .{ target_store, re }) catch unreachable)
    else
        null;

    const rewritten_expr = H.lowerStoreExprs(allocator, program, w.value);

    // TT2 (695_002): a site that handles `| cycle` routes to the guarded
    // variant `__store_writec_*` — the insertf pattern (the target event's
    // branch set matches what the site handles). The un-branched `|>` tail
    // becomes the `| ok` arm (it runs only when the write landed); a missing
    // ok arm is synthesized as a no-op so the dispatch is exhaustive.
    var has_cycle_cont = false;
    for (flow.body.continuations) |*c| {
        if (std.mem.eql(u8, std.mem.trim(u8, c.branch, " "), "cycle")) has_cycle_cont = true;
    }
    if (has_cycle_cont) {
        const writec_name = std.fmt.allocPrint(allocator, "__store_writec_{s}", .{target_store}) catch unreachable;
        const store_is_tree = blk: {
            for (flatItems(allocator, program.items)) |pi| {
                if (pi.* != .event_decl) continue;
                const ed = &pi.event_decl;
                if (ed.path.segments.len == 1 and std.mem.eql(u8, ed.path.segments[0], writec_name)) break :blk true;
            }
            break :blk false;
        };
        if (!store_is_tree) {
            return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, "std/store:stored: `| cycle` guards the synthesized parent write of a [tree] store - '{s}' is not a [tree] store", .{target_store}) } };
        }
        if (!std.mem.eql(u8, target_field, "parent")) {
            return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, "std/store:stored: `| cycle` attaches to the [tree]-synthesized parent write - '{s}.{s}' is not the parent column", .{ target_store, target_field }) } };
        }
        const re = row_expr orelse {
            return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, "std/store:stored: `| cycle` needs a row-addressed parent write ({s}[handle].parent)", .{target_store}) } };
        };
        var cyc_conts = std.ArrayList(ast.Continuation).initCapacity(allocator, flow.body.continuations.len + 1) catch unreachable;
        var has_ok_cont = false;
        for (flow.body.continuations) |*c| {
            const bname = std.mem.trim(u8, c.branch, " ");
            var cl = ast_functional.cloneContinuation(allocator, c) catch unreachable;
            if (bname.len == 0) {
                // The success tail rides the ok arm — mirror of `| row <b> |> tail`.
                cl.branch = allocator.dupe(u8, "ok") catch unreachable;
                has_ok_cont = true;
            } else if (!std.mem.eql(u8, bname, "cycle")) {
                return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, "std/store:stored: branch '{s}' - a guarded parent write answers `|>` (ok) and `| cycle` only", .{c.branch}) } };
            }
            cyc_conts.append(allocator, cl) catch unreachable;
        }
        if (!has_ok_cont) {
            cyc_conts.append(allocator, ast.Continuation{
                .branch = allocator.dupe(u8, "ok") catch unreachable,
                .binding = null,
                .kind = .terminal,
                .condition = null,
                .node = .terminal,
                .indent = 1,
                .continuations = &[_]ast.Continuation{},
                .location = flow.location,
            }) catch unreachable;
        }
        const csegs = allocator.alloc([]const u8, 1) catch unreachable;
        csegs[0] = writec_name;
        _ = re;
        const cargs = allocator.alloc(ast.Arg, 3) catch unreachable;
        cargs[0] = ast.Arg{ .name = allocator.dupe(u8, "row") catch unreachable, .value = allocator.dupe(u8, row_arg.?) catch unreachable };
        cargs[1] = ast.Arg{ .name = allocator.dupe(u8, "field") catch unreachable, .value = std.fmt.allocPrint(allocator, "{d}", .{field_idx}) catch unreachable };
        cargs[2] = ast.Arg{ .name = allocator.dupe(u8, "value") catch unreachable, .value = rewritten_expr };
        const writec_inv = ast.Invocation{
            .path = ast.DottedPath{
                .module_qualifier = allocator.dupe(u8, flow.module) catch unreachable,
                .segments = csegs,
            },
            .args = cargs,
        };
        return .{ .transformed = .{ .replacement = ast.Item{ .flow = ast.Flow{
            .body = ast.rootSite(writec_inv, cyc_conts.toOwnedSlice(allocator) catch unreachable, flow.location),
            .pre_label = null,
            .impl_of = flow.impl_of,
            .super_shape = null,
            .inline_body = null,
            .preamble_code = invocation.preamble_code,
            .is_pure = false,
            .is_transitively_pure = false,
            .location = flow.location,
            .module = allocator.dupe(u8, flow.module) catch unreachable,
        } } } };
    }

    // The target event: the bundled `__store_write_<s>` surface, EXCEPT for a
    // row-addressed write in an owned-containing store, which routes to the
    // per-field targeted event `__store_fwrite_<s>_<i>` (unit 4c) — resolved
    // inside the plural block below once column owned-ness is known.
    var write_name = std.fmt.allocPrint(allocator, "__store_write_{s}", .{target_store}) catch unreachable;
    // A PLURAL write surface carries per-field typed value slots (690_049):
    // `value_<i>: <column type>`, the written column's slot gets the
    // expression, the others typed zeros its arm never reads. Column types
    // come off the generated apply event's branch payloads — the plural
    // path guarantees create ran (is_plural_store keys off the generated
    // inserth event). A SINGLETON keeps the uniform {field, value} shape.
    const call_args = if (row_expr != null) blk: {
        // Column owned-ness rides the apply event's branch payloads (an owned
        // field's payload carries the bare-borrow phantom, 690_063) — the
        // stored transform reads it back rather than re-deriving the column
        // types from the declaration.
        var col_owned: []const bool = &[_]bool{};
        const col_types: []const []const u8 = types_blk: {
            const apply_name = std.fmt.allocPrint(allocator, "__store_apply_{s}", .{target_store}) catch unreachable;
            for (flatItems(allocator, program.items)) |pi| {
                if (pi.* != .event_decl) continue;
                const ed = &pi.event_decl;
                if (ed.path.segments.len == 1 and std.mem.eql(u8, ed.path.segments[0], apply_name)) {
                    const types = allocator.alloc([]const u8, ed.branches.len) catch unreachable;
                    const owneds = allocator.alloc(bool, ed.branches.len) catch unreachable;
                    for (ed.branches, 0..) |b, bi| {
                        types[bi] = if (b.payload.fields.len > 0) b.payload.fields[0].type else "i64";
                        owneds[bi] = b.payload.fields.len > 0 and b.payload.fields[0].phantom != null;
                    }
                    col_owned = owneds;
                    break :types_blk types;
                }
            }
            return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, "std/store:stored: internal - plural store '{s}' has no generated apply event (create must have run: inserth exists without apply)", .{target_store}) } };
        };
        // A write rides ONE typed value slot per column; a slot no arm reads
        // is a typed zero (690_049). An OWNED column has no typed zero — a
        // dead owned slot would need a consumed obligation it does not hold.
        // So an owned-containing store's write is DE-BUNDLED (the `captured`
        // model, 690_064): it targets the per-field event
        // `__store_fwrite_<s>_<i>(row, value)`, threading ONLY the written
        // field's value — a scalar write never references an owned sibling's
        // slot or its obligation, and the owned field's own write consumes
        // its <!state> on its single slot (690_062).
        var store_has_owned = false;
        for (col_owned) |co| {
            if (co) store_has_owned = true;
        }
        if (store_has_owned) {
            write_name = std.fmt.allocPrint(allocator, "__store_fwrite_{s}_{d}", .{ target_store, field_idx }) catch unreachable;
            const fargs = allocator.alloc(ast.Arg, 2) catch unreachable;
            fargs[0] = ast.Arg{
                .name = allocator.dupe(u8, "row") catch unreachable,
                .value = allocator.dupe(u8, row_arg.?) catch unreachable,
            };
            fargs[1] = ast.Arg{
                .name = allocator.dupe(u8, "value") catch unreachable,
                .value = rewritten_expr,
            };
            break :blk fargs;
        }
        const args = allocator.alloc(ast.Arg, col_types.len + 2) catch unreachable;
        args[0] = ast.Arg{
            .name = allocator.dupe(u8, "row") catch unreachable,
            .value = allocator.dupe(u8, row_arg.?) catch unreachable,
        };
        args[1] = ast.Arg{
            .name = allocator.dupe(u8, "field") catch unreachable,
            .value = std.fmt.allocPrint(allocator, "{d}", .{field_idx}) catch unreachable,
        };
        for (col_types, 0..) |ct, ci| {
            const is_float = std.mem.eql(u8, ct, "f64") or std.mem.eql(u8, ct, "f32");
            // A fixed-char column's slot is `string` — its typed zero is the
            // empty string literal (690_052).
            const is_string = std.mem.eql(u8, ct, "string") or std.mem.eql(u8, ct, "[]const u8");
            args[2 + ci] = ast.Arg{
                .name = std.fmt.allocPrint(allocator, "value_{d}", .{ci}) catch unreachable,
                .value = if (ci == field_idx)
                    rewritten_expr
                else
                    allocator.dupe(u8, if (is_string) "\"\"" else if (is_float) "0.0" else "0") catch unreachable,
            };
        }
        break :blk args;
    } else blk: {
        const args = allocator.alloc(ast.Arg, 2) catch unreachable;
        args[0] = ast.Arg{
            .name = allocator.dupe(u8, "field") catch unreachable,
            .value = std.fmt.allocPrint(allocator, "{d}", .{field_idx}) catch unreachable,
        };
        args[1] = ast.Arg{
            .name = allocator.dupe(u8, "value") catch unreachable,
            .value = rewritten_expr,
        };
        break :blk args;
    };
    const segs = allocator.alloc([]const u8, 1) catch unreachable;
    segs[0] = write_name;
    // The write tor lives where the store was DECLARED, which need not be where
    // it is written from (110_022). `fieldOrder` above already proved the store
    // exists, so the home module resolves through the same two sources; a miss
    // here would mean the two disagree, and that is a compiler bug, not a
    // user-facing case to paper over.
    const write_home = H.storeHomeModule(allocator, program, target_store) orelse
        std.debug.panic("std/store: store '{s}' resolved a field order but no declaring module", .{target_store});
    const write_inv = ast.Invocation{
        .path = ast.DottedPath{
            .module_qualifier = allocator.dupe(u8, write_home) catch unreachable,
            .segments = segs,
        },
        .args = call_args,
        .annotations = preambleAnn(allocator, invocation, &[_][]const u8{}),
    };

    return .{ .transformed = .{ .replacement = ast.Item{ .flow = ast.Flow{
        // `stored` is an ordinary void step: whatever was chained after it
        // (`stored{…} |> next`) is the containing flow's continuations, and it
        // must survive the rewrite. Threading `flow.body.continuations` through
        // — UN-marked — lets the transform runner's fixed-point pass re-lower a
        // tail that is itself a `stored` (690_028). Empty here dropped the tail.
        .body = ast.rootSite(write_inv, flow.body.continuations, flow.location),
        .pre_label = null,
        .impl_of = flow.impl_of, // preserved: the site may BE an impl flow's head (e.g. a query body)
        .super_shape = null,
        .inline_body = null,
        .preamble_code = invocation.preamble_code,
        .is_pure = false,
        .is_transitively_pure = false,
        .location = flow.location,
        .module = allocator.dupe(u8, flow.module) catch unreachable,
    } } } };
}

// ============================================================================
// STORE.DEFAULT — the bare reference form as a program-wide reactive attach
// ============================================================================
//
//   std/store(enemies)
//   ! hp h |> …                     // a standing rule, from anywhere
//
// `std/store(name)` is the store's reference; `std/store(name) ! arms` attaches
// those arms as standing reactive rules — a program-wide `watch`. This is a
// `[pre]`-phase rewrite: it renames the bare `default` invocation to `watch`
// BEFORE `create` scans for watch arms, so the entire (already-green) watch
// machinery — create-time splice into the write-subflow, transplant-purity,
// self-erase — handles it with no duplication. Reactive rules are top-level
// only; they are standing rules, not mid-flow steps.

~[keyword|comptime|transform|pre]pub tor default {
    expr: Expression,
    invocation: *const Invocation,
    item: *const Item,
    program: *const Program,
    reporter: *std/compiler:ErrorReporter,
    allocator: std.mem.Allocator
} -> SiteResult

~[transform]proc default|zig {
    const ast = @import("ast");
    const ast_functional = @import("ast_functional");
    if (item.* != .flow) @panic("store:default transform: containing item is not a flow - walker dispatch contract broken");
    const flow = &item.flow;

    // The bare `std/store(name)` form names its positional arg by the store
    // name itself (`{name:"game", value:"game"}`), not under `expr` like the
    // `:verb(arg)` forms — so pull the store name and hand watch a proper
    // `expr` arg.
    if (invocation.args.len == 0) {
        return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, "std/store(name): the reference form needs a store name", .{}) } };
    }
    const store_name = invocation.args[0].value;

    // Dispatch on branch kind. `!` reactive arms (`.effect`) → watch, below.
    // Any other branch — a `| store s` operation binding (`.terminal`) — is the
    // OPERATION form of the reference, which isn't built yet. Say so at the koru
    // level rather than mis-rewriting to watch (which reads the branch name as a
    // field: the misleading "'store' is not a field" leak).
    if (flow.body.continuations.len > 0 and flow.body.continuations[0].kind != .effect) {
        return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, "std/store({s}): only the reactive-attach form of the reference is built — `std/store({s}) ! <field> <bind> |> ...`. The operation form (`| store s |> ...`) is a later rung; for now operate by name (std/store:insert({s}), std/store:stored).", .{ store_name, store_name, store_name }) } };
    }

    // Rename the invocation default → watch, carrying the store name as `expr`
    // and the same `!` arm continuations. From here the watch path runs.
    const segs = allocator.alloc([]const u8, 1) catch unreachable;
    segs[0] = allocator.dupe(u8, "watch") catch unreachable;
    const watch_args = allocator.alloc(ast.Arg, 1) catch unreachable;
    watch_args[0] = ast.Arg{ .name = allocator.dupe(u8, "expr") catch unreachable, .value = allocator.dupe(u8, store_name) catch unreachable };
    const watch_inv = ast.Invocation{
        .path = ast.DottedPath{ .module_qualifier = allocator.dupe(u8, "std.store") catch unreachable, .segments = segs },
        .args = watch_args,
    };
    const conts = allocator.alloc(ast.Continuation, flow.body.continuations.len) catch unreachable;
    for (flow.body.continuations, 0..) |*c, i| {
        conts[i] = ast_functional.cloneContinuation(allocator, c) catch unreachable;
    }
    return .{ .transformed = .{ .replacement = ast.Item{ .flow = ast.Flow{
        .body = ast.rootSite(watch_inv, conts, flow.location),
        .pre_label = null,
        .impl_of = flow.impl_of,
        .super_shape = null,
        .inline_body = null,
        .preamble_code = invocation.preamble_code,
        .is_pure = false,
        .is_transitively_pure = false,
        .location = flow.location,
        .module = allocator.dupe(u8, flow.module) catch unreachable,
    } } } };
}

// ============================================================================
// STORE.WATCH — subscriptions; bodies are transplanted by the coordinator
// ============================================================================
//
// By the time this transform fires for a well-formed program, create has
// already spliced this watch's branches into the write-subflow — the site
// self-erases. Firing with the store's create still untransformed means the
// watch precedes its create in source (a rung-one ordering wall); no create
// anywhere is a plain unknown-store diagnostic.

~[keyword|comptime|transform]pub tor watch {
    expr: Expression,
    invocation: *const Invocation,
    item: *const Item,
    program: *const Program,
    reporter: *std/compiler:ErrorReporter,
    allocator: std.mem.Allocator
} -> SiteResult

~[transform]proc watch|zig {
    const ast = @import("ast");
    if (item.* != .flow) @panic("store:watch transform: containing item is not a flow - walker dispatch contract broken");
    const flow = &item.flow;

    const H = struct {
        fn stripQuotes(n: []const u8) []const u8 {
            if (n.len >= 2 and n[0] == '"') return n[1 .. n.len - 1];
            return n;
        }
    };

    var store_name: []const u8 = "";
    for (invocation.args) |arg| {
        if (std.mem.eql(u8, arg.name, "expr")) store_name = H.stripQuotes(arg.value);
    }
    if (store_name.len == 0) {
        return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, "std/store:watch requires a store name: watch(name)", .{}) } };
    }

    // ------------------------------------------------------------------
    // TRANSPLANT PURITY (ruling (a), thesis T1; 690_006 is the acceptance
    // rejection). A watch body executes at the store's WRITE SITES, not at
    // its lexical position — its free names must be its own branch
    // bindings or comptime-known names (store names; qualified calls live
    // in node paths, not arg text). The check runs HERE, rewrite-time,
    // pre-checker: a koru-level diagnostic, never a raw Zig
    // undeclared-identifier leak.
    // ------------------------------------------------------------------
    const Purity = struct {
        const Ctx = struct {
            // Names in scope at the CURRENT point in the arm: the branch
            // payload of each enclosing continuation plus the mid-pipe
            // `: name` binds (Invocation.return_binding) produced by earlier
            // steps of the SAME arm. Grown/shrunk push-pop as scanCont
            // descends, so a pipe bind is visible to downstream steps but not
            // to itself or to sibling arms. A name from the ENCLOSING flow is
            // never pushed here — that is precisely the 690_006 rejection.
            scope: *std.ArrayList([]const u8),
            allocator: std.mem.Allocator,
            stores: []const []const u8,
            violation: ?[]const u8 = null,
        };
        fn isIdentStart(ch: u8) bool {
            return (ch >= 'a' and ch <= 'z') or (ch >= 'A' and ch <= 'Z') or ch == '_';
        }
        fn isIdent(ch: u8) bool {
            return isIdentStart(ch) or (ch >= '0' and ch <= '9') or ch == '-';
        }
        fn rootAllowed(ctx: *const Ctx, root: []const u8) bool {
            if (std.mem.startsWith(u8, root, "__koru_")) return true;
            const keywords = [_][]const u8{ "and", "or", "not", "true", "false", "_" };
            for (keywords) |k| if (std.mem.eql(u8, root, k)) return true;
            for (ctx.scope.items) |a| if (std.mem.eql(u8, root, a)) return true;
            for (ctx.stores) |s| if (std.mem.eql(u8, root, s)) return true;
            return false;
        }
        // Scan expression text for free ident roots. Inside string literals
        // only `{{ }}` interpolation holes count (and a hole's `:fmt` tail
        // is a format spec, not a name).
        fn scanText(ctx: *Ctx, text: []const u8) void {
            var i: usize = 0;
            var in_str = false;
            var in_hole = false;
            var hole_past_colon = false;
            while (i < text.len) {
                const c = text[i];
                if (!in_str) {
                    if (c == '"') {
                        in_str = true;
                        i += 1;
                        continue;
                    }
                    if (isIdentStart(c)) {
                        i = checkIdent(ctx, text, i);
                        if (ctx.violation != null) return;
                        continue;
                    }
                    i += 1;
                    continue;
                }
                if (in_hole) {
                    if (i + 1 < text.len and text[i] == '}' and text[i + 1] == '}') {
                        in_hole = false;
                        hole_past_colon = false;
                        i += 2;
                        continue;
                    }
                    if (c == ':') {
                        hole_past_colon = true;
                        i += 1;
                        continue;
                    }
                    if (!hole_past_colon and isIdentStart(c)) {
                        i = checkIdent(ctx, text, i);
                        if (ctx.violation != null) return;
                        continue;
                    }
                    i += 1;
                    continue;
                }
                if (i + 1 < text.len and text[i] == '{' and text[i + 1] == '{') {
                    in_hole = true;
                    i += 2;
                    continue;
                }
                if (c == '"') in_str = false;
                i += 1;
            }
        }
        // Read one dotted ident chain starting at `start`; only the ROOT is
        // name-resolved (the rest are field accesses on it).
        fn checkIdent(ctx: *Ctx, text: []const u8, start: usize) usize {
            var j = start;
            while (j < text.len and isIdent(text[j])) j += 1;
            const root = text[start..j];
            while (j + 1 < text.len and text[j] == '.' and isIdentStart(text[j + 1])) {
                j += 1;
                while (j < text.len and isIdent(text[j])) j += 1;
            }
            if (!rootAllowed(ctx, root)) ctx.violation = root;
            return j;
        }
        fn scanCont(ctx: *Ctx, cont: *const ast.Continuation) void {
            if (ctx.violation != null) return;
            const base = ctx.scope.items.len;
            // This continuation's branch payload is in scope for its own node
            // args (`! clicks c |> f(c)`) and for everything below it.
            if (cont.binding) |b| ctx.scope.append(ctx.allocator, b) catch unreachable;
            for (cont.destructure) |df| ctx.scope.append(ctx.allocator, df.name) catch unreachable;

            if (cont.condition) |cond| scanText(ctx, cond);
            if (cont.node) |n| {
                switch (n) {
                    .invocation => |inv| {
                        for (inv.args) |a| {
                            scanText(ctx, a.value);
                            if (a.expression_value) |ev| scanText(ctx, ev.text);
                            if (a.source_value) |sv| scanText(ctx, sv.text);
                            if (ctx.violation != null) break;
                        }
                    },
                    else => {},
                }
            }

            if (ctx.violation == null) {
                // The pipe result of THIS step (`... : l |>`) is in scope for
                // the downstream steps (its continuations), NOT for its own
                // args above. return_binding / return_destructure are the
                // mid-chain binds the flat allowed-set used to miss.
                if (cont.node) |n| switch (n) {
                    .invocation => |inv| {
                        if (inv.return_binding) |rb| ctx.scope.append(ctx.allocator, rb) catch unreachable;
                        for (inv.return_destructure) |df| ctx.scope.append(ctx.allocator, df.name) catch unreachable;
                    },
                    else => {},
                };
                for (cont.continuations) |*c| scanCont(ctx, c);
            }

            // Pop everything this level pushed: siblings must not see these binds.
            ctx.scope.shrinkRetainingCapacity(base);
        }
    };

    // All store names in the program (untransformed creates + generated
    // apply events) — comptime-known, always legal in a watch body.
    var known_stores = std.ArrayList([]const u8).initCapacity(allocator, 4) catch unreachable;
    for (flatItems(allocator, program.items)) |pi| {
        switch (pi.*) {
            .flow => |*f| {
                const finv = f.inv();
                if (finv.path.segments.len == 1 and std.mem.eql(u8, finv.path.segments[0], "new")) {
                    if (finv.path.module_qualifier) |mq| {
                        if (std.mem.eql(u8, mq, "std.store")) {
                            for (finv.args) |a| {
                                if (std.mem.eql(u8, a.name, "expr")) known_stores.append(allocator, H.stripQuotes(a.value)) catch unreachable;
                            }
                        }
                    }
                }
            },
            .event_decl => |*ed| {
                if (ed.path.segments.len == 1 and std.mem.startsWith(u8, ed.path.segments[0], "__store_apply_")) {
                    known_stores.append(allocator, ed.path.segments[0]["__store_apply_".len..]) catch unreachable;
                }
            },
            else => {},
        }
    }

    // Find this watch site's branch continuations within the containing
    // flow (the invocation pointer points into the tree).
    const FindSite = struct {
        fn call(cont: *const ast.Continuation, target: *const ast.Invocation) ?*const ast.Continuation {
            if (cont.node) |*n| {
                if (n.* == .invocation and &n.invocation == target) return cont;
            }
            for (cont.continuations) |*c| {
                if (call(c, target)) |found| return found;
            }
            return null;
        }
    }.call;
    const site: ?*const ast.Continuation = FindSite(&flow.body, invocation);

    if (site) |sc| {
        for (sc.continuations) |*wc| {
            // scanCont owns all scope: it pushes wc's own payload binding and
            // every mid-pipe `: name` bind as it descends, so the initial
            // scope is empty (comptime-known store names live in `stores`).
            var scope = std.ArrayList([]const u8).initCapacity(allocator, 8) catch unreachable;
            var pctx = Purity.Ctx{ .scope = &scope, .allocator = allocator, .stores = known_stores.items };
            Purity.scanCont(&pctx, wc);
            if (pctx.violation) |name| {
                return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, "std/store: watch body references '{s}', runtime state of the enclosing flow - a watch body executes at '{s}'s write sites, not here; bind it through a store or react at a write site", .{ name, store_name }) } };
            }
        }
    }

    // A pure watch nested mid-flow is legal placement by design
    // (organizational principle) but its splice is a later slice — wall it
    // rather than silently dropping the subscription.
    const is_top_level = invocation == flow.inv();
    if (!is_top_level) {
        return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, "std/store:watch({s}): nested watch splicing is a later slice - place the watch at top level for now", .{store_name}) } };
    }

    // Did the coordinator already run? Its generated write event is the marker.
    const write_name = std.fmt.allocPrint(allocator, "__store_write_{s}", .{store_name}) catch unreachable;
    var spliced = false;
    for (flatItems(allocator, program.items)) |pi| {
        if (pi.* != .event_decl) continue;
        const ed = &pi.event_decl;
        if (ed.path.segments.len == 1 and std.mem.eql(u8, ed.path.segments[0], write_name)) {
            spliced = true;
            break;
        }
    }
    if (spliced) {
        const consumed = std.fmt.allocPrint(allocator, "// std/store: watch({s}) spliced into the write-subflow", .{store_name}) catch unreachable;
        return .{ .transformed = .{ .replacement = ast.Item{ .host_line = ast.HostLine{
            .content = consumed,
            .location = flow.location,
            .module = allocator.dupe(u8, flow.module) catch unreachable,
        } } } };
    }

    // Not spliced: is there an untransformed create later in the program?
    var create_exists = false;
    for (flatItems(allocator, program.items)) |pi| {
        if (pi.* != .flow) continue;
        const f = &pi.flow;
        const inv = f.inv();
        if (inv.path.segments.len != 1 or !std.mem.eql(u8, inv.path.segments[0], "new")) continue;
        const mq = inv.path.module_qualifier orelse continue;
        if (!std.mem.eql(u8, mq, "std.store")) continue;
        for (inv.args) |a| {
            if (std.mem.eql(u8, a.name, "expr") and std.mem.eql(u8, H.stripQuotes(a.value), store_name)) {
                create_exists = true;
            }
        }
    }
    if (create_exists) {
        return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, "std/store:watch({s}): the watch precedes its store's create in source - declare the store first (rung-one ordering)", .{store_name}) } };
    }
    // The store's OWN declaration was already refused; that diagnostic is the
    // true one and this lookup can only ever fail. Staying silent here is what
    // keeps one mistake to one error.
    if (ast.declarationRefused(allocator, program, flow.module, "std/store:new({s}):", .{store_name})) return .{ .transformed = .{} };
    return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, "std/store:watch({s}): unknown store - no std/store:new({s}) found", .{ store_name, store_name }) } };
}

// ============================================================================
// STORE.INSERT — append a row to a plural store (rung two)
// ============================================================================
//
//   std/store:insert(game) { hp: 30, kind: 1 }              — bare append
//   std/store:insert(game) { hp: 50, kind: 1 } | row r |> … — handle form
//
// Rewritten into `__store_insert_<s>(…)` (void) or `__store_inserth_<s>(…)`
// (`| row i64`) — the site's own continuations ride along. `__site_line`
// carries the site's source position so standing query enters stay honest
// about program order (a query only hears inserts BELOW it in source).

~[keyword|comptime|transform]pub tor insert {
    expr: Expression,
    source: Source,
    invocation: *const Invocation,
    item: *const Item,
    program: *const Program,
    reporter: *std/compiler:ErrorReporter,
    allocator: std.mem.Allocator
} -> SiteResult

~[transform]proc insert|zig {
    const ast = @import("ast");
    const ast_functional = @import("ast_functional");
    const struct_literal = @import("struct_literal");

    if (item.* != .flow) @panic("store:insert transform: containing item is not a flow - walker dispatch contract broken");
    const flow = &item.flow;

    const H = struct {
        fn stripQuotes(n: []const u8) []const u8 {
            if (n.len >= 2 and n[0] == '"') return n[1 .. n.len - 1];
            return n;
        }
        fn mkPathH(alloc: std.mem.Allocator, module: []const u8, name: []const u8) ast.DottedPath {
            const segs = alloc.alloc([]const u8, 1) catch unreachable;
            segs[0] = alloc.dupe(u8, name) catch unreachable;
            return ast.DottedPath{ .module_qualifier = alloc.dupe(u8, module) catch unreachable, .segments = segs };
        }
        // The INSERT surface's column order — `storeInsertOrder`, NOT
        // `storeFieldOrder`. The two differ by the `[tree]`-synthesized
        // `parent` column, which is not insertable.
        fn fieldOrder(alloc: std.mem.Allocator, prog: *const ast.Program, store: []const u8) ?[]const []const u8 {
            return storeInsertOrder(alloc, prog, store);
        }
        // Is `col` a fixed-char column, and how many bytes does it hold?
        // (690_052 — the comptime-literal overflow check needs N at the
        // insert site.) Sources, mirroring fieldOrder's transform-order
        // tolerance: the generated SoA cell host_line when create already
        // ran (`<col>: [CAP][N]u8` — store.kz owns both the writer and this
        // reader), else the untransformed create's seed block (`char[N]`).
        fn charCap(alloc: std.mem.Allocator, prog: *const ast.Program, store: []const u8, col: []const u8) ?usize {
            const marker = std.fmt.allocPrint(alloc, "const __KoruStoreT_{s} = struct {{", .{store}) catch unreachable;
            for (flatItems(alloc, prog.items)) |pi| {
                if (pi.* != .host_line) continue;
                const t = pi.host_line.content;
                if (std.mem.indexOf(u8, t, marker) == null) continue;
                const fkey = std.fmt.allocPrint(alloc, "\n    {s}: [", .{col}) catch unreachable;
                const fpos = std.mem.indexOf(u8, t, fkey) orelse return null;
                const rest = t[fpos + fkey.len ..];
                // scalar: `8]i64 = undefined`; fixed-char: `8][16]u8 = undefined`
                const close = std.mem.indexOfScalar(u8, rest, ']') orelse return null;
                const after = rest[close + 1 ..];
                if (after.len == 0 or after[0] != '[') return null;
                const close2 = std.mem.indexOfScalar(u8, after, ']') orelse return null;
                if (!std.mem.startsWith(u8, after[close2 + 1 ..], "u8")) return null;
                return std.fmt.parseInt(usize, after[1..close2], 10) catch null;
            }
            // create not yet transformed: read the raw seed block.
            for (flatItems(alloc, prog.items)) |pi| {
                if (pi.* != .flow) continue;
                const f = &pi.flow;
                const inv = f.inv();
                if (inv.path.segments.len != 1 or !std.mem.eql(u8, inv.path.segments[0], "new")) continue;
                const mq = inv.path.module_qualifier orelse continue;
                if (!std.mem.eql(u8, mq, "std.store")) continue;
                var name_matches = false;
                var seed: ?[]const u8 = null;
                for (inv.args) |a| {
                    if (std.mem.eql(u8, a.name, "expr")) {
                        name_matches = std.mem.eql(u8, stripQuotes(a.value), store);
                    } else if (std.mem.eql(u8, a.name, "source")) {
                        seed = a.value;
                    }
                }
                if (!name_matches or seed == null) continue;
                const braced = std.fmt.allocPrint(alloc, "{{{s}}}", .{seed.?}) catch unreachable;
                const cf = struct_literal.parseFields(alloc, braced) catch return null;
                for (cf) |c| {
                    if (!std.mem.eql(u8, c.name, col)) continue;
                    const v = std.mem.trim(u8, c.value, " ");
                    if (std.mem.startsWith(u8, v, "char[") and v.len > "char[".len and v[v.len - 1] == ']') {
                        return std.fmt.parseInt(usize, std.mem.trim(u8, v["char[".len .. v.len - 1], " "), 10) catch null;
                    }
                    return null;
                }
                return null;
            }
            return null;
        }
        // Is `col` an OWNED column (the store holds `[CAP]*Type` and teardown
        // frees the live pointers — 690_053's single-ownership contract)?
        // Sources, mirroring charCap's transform-order tolerance: the
        // generated SoA cell host_line when create already ran (`<col>:
        // [CAP]*Type`), else the untransformed create's seed block (`*mod:
        // Type<state!>` — the leading `*` is the ownership marker).
        fn ownedCol(alloc: std.mem.Allocator, prog: *const ast.Program, store: []const u8, col: []const u8) bool {
            const marker = std.fmt.allocPrint(alloc, "const __KoruStoreT_{s} = struct {{", .{store}) catch unreachable;
            for (flatItems(alloc, prog.items)) |pi| {
                if (pi.* != .host_line) continue;
                const t = pi.host_line.content;
                if (std.mem.indexOf(u8, t, marker) == null) continue;
                const fkey = std.fmt.allocPrint(alloc, "\n    {s}: [", .{col}) catch unreachable;
                const fpos = std.mem.indexOf(u8, t, fkey) orelse return false;
                const rest = t[fpos + fkey.len ..];
                // scalar: `8]i64`; fixed-char: `8][16]u8`; owned: `8]*koru_std...`
                const close = std.mem.indexOfScalar(u8, rest, ']') orelse return false;
                const after = rest[close + 1 ..];
                return after.len > 0 and after[0] == '*';
            }
            // create not yet transformed: read the raw seed block.
            for (flatItems(alloc, prog.items)) |pi| {
                if (pi.* != .flow) continue;
                const f = &pi.flow;
                const inv = f.inv();
                if (inv.path.segments.len != 1 or !std.mem.eql(u8, inv.path.segments[0], "new")) continue;
                const mq = inv.path.module_qualifier orelse continue;
                if (!std.mem.eql(u8, mq, "std.store")) continue;
                var name_matches = false;
                var seed: ?[]const u8 = null;
                for (inv.args) |a| {
                    if (std.mem.eql(u8, a.name, "expr")) {
                        name_matches = std.mem.eql(u8, stripQuotes(a.value), store);
                    } else if (std.mem.eql(u8, a.name, "source")) {
                        seed = a.value;
                    }
                }
                if (!name_matches or seed == null) continue;
                const braced = std.fmt.allocPrint(alloc, "{{{s}}}", .{seed.?}) catch unreachable;
                const cf = struct_literal.parseFields(alloc, braced) catch return false;
                for (cf) |c| {
                    if (!std.mem.eql(u8, c.name, col)) continue;
                    return std.mem.startsWith(u8, std.mem.trim(u8, c.value, " "), "*");
                }
                return false;
            }
            return false;
        }
        // Unescaped byte length of a string literal's inner text: `\n` is one
        // byte, `\x41` is one byte. (`\u{...}` overcounts — acceptable
        // conservatism for a fixed-buffer limit check this rung.)
        fn literalByteLen(lit: []const u8) usize {
            var blen: usize = 0;
            var k: usize = 0;
            while (k < lit.len) {
                if (lit[k] == '\\' and k + 1 < lit.len) {
                    if (lit[k + 1] == 'x' and k + 3 < lit.len) {
                        k += 4;
                    } else {
                        k += 2;
                    }
                } else {
                    k += 1;
                }
                blen += 1;
            }
            return blen;
        }
        // Cell-path rewrite for seed values (690_192): `cfg.base` in an insert
        // literal must lower to the SoA cell like it does in if/when exprs
        // (690_074) and stored rhs. The insert site is a std.store invocation,
        // so create's whole-program walk SKIPS its args — the seed is the one
        // write-envelope position the walk never reaches. Mirrors the stored
        // transform's rewrite (transforms own the rewriting at their own sites).
        fn isIdent(ch: u8) bool {
            return (ch >= 'a' and ch <= 'z') or (ch >= 'A' and ch <= 'Z') or (ch >= '0' and ch <= '9') or ch == '_' or ch == '-';
        }
        fn storeRefs(alloc: std.mem.Allocator, text: []const u8, name: []const u8, is_identity: bool) []const u8 {
            const expr_ctx = ast.expressionMask(alloc, text);
            var out = std.ArrayList(u8).initCapacity(alloc, text.len + 32) catch unreachable;
            var i: usize = 0;
            while (i < text.len) {
                const at_boundary = ast.identBoundaryBefore(text, i);
                const starts = at_boundary and std.mem.startsWith(u8, text[i..], name);
                const after = i + name.len;
                if (starts and after < text.len and text[after] == '.') {
                    out.appendSlice(alloc, "__koru_store_") catch unreachable;
                    out.appendSlice(alloc, name) catch unreachable;
                    i += name.len;
                } else if (is_identity and expr_ctx[i] and starts and
                    (after >= text.len or (!isIdent(text[after]) and text[after] != '[')))
                {
                    // A ONE-column store read in a seed (`insert(counter) { counter }`)
                    // still has to reach a column in the SoA cell, so it resolves to
                    // the synthesized one. `[` is excluded so a row index
                    // (`todos[…]`) still takes the indexed path elsewhere.
                    out.appendSlice(alloc, "__koru_store_") catch unreachable;
                    out.appendSlice(alloc, name) catch unreachable;
                    out.append(alloc, '.') catch unreachable;
                    out.appendSlice(alloc, ast.STORE_IDENTITY_COLUMN) catch unreachable;
                    i += name.len;
                } else {
                    out.append(alloc, text[i]) catch unreachable;
                    i += 1;
                }
            }
            return out.toOwnedSlice(alloc) catch unreachable;
        }
        // Every store name visible in the program — untransformed creates plus
        // generated apply events — so a seed value can reference a cell from
        // any store, under any transform order.
        fn allStoreNames(alloc: std.mem.Allocator, prog: *const ast.Program) []const []const u8 {
            return storeAllNames(alloc, prog);
        }
        fn isIdentityStore(alloc: std.mem.Allocator, prog: *const ast.Program, store: []const u8) bool {
            const order = fieldOrder(alloc, prog, store) orelse return false;
            return order.len == 1 and std.mem.eql(u8, order[0], ast.STORE_IDENTITY_COLUMN);
        }
        fn storeRefsAll(alloc: std.mem.Allocator, prog: *const ast.Program, text: []const u8) []const u8 {
            var t = text;
            for (allStoreNames(alloc, prog)) |nm| t = storeRefs(alloc, t, nm, isIdentityStore(alloc, prog, nm));
            return t;
        }
    };

    var store_name: []const u8 = "";
    var block_text: ?[]const u8 = null;
    for (invocation.args) |arg| {
        if (std.mem.eql(u8, arg.name, "expr")) store_name = H.stripQuotes(arg.value);
        if (std.mem.eql(u8, arg.name, "source")) block_text = arg.value;
    }
    if (store_name.len == 0 or block_text == null) {
        return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, "std/store:insert requires a store name and a row block: insert(name) {{ field: value }}", .{}) } };
    }

    // The generated units live in the STORE's home namespace, which is the
    // import-derived `app.lib` — not this flow's file-derived `lib`. They
    // coincide in the entry file and diverge inside a library (115_018).
    const home_ns = storeHome(allocator, program, store_name) orelse flow.module;

    const order = H.fieldOrder(allocator, program, store_name) orelse {
        // The store's OWN declaration was already refused; that diagnostic is the
        // true one and this lookup can only ever fail. Staying silent here is what
        // keeps one mistake to one error.
        if (ast.declarationRefused(allocator, program, flow.module, "std/store:new({s}):", .{store_name})) return .{ .transformed = .{} };
        return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, "std/store:insert: unknown store '{s}' - no std/store:new({s}) found", .{ store_name, store_name }) } };
    };

    const braced = std.fmt.allocPrint(allocator, "{{{s}}}", .{block_text.?}) catch unreachable;
    // A ONE-column store names no column, so its row block IS the value
    // expression — `insert(nums) { 7 }`.
    //
    // It is NEVER a field list here, and that settles the punning question
    // rather than leaving it ambiguous: `insert(batch) { p }` today puns to
    // `{ p: p }` because the column happens to be called `p`. With no column
    // name there is nothing to pun against, so the block can only mean "insert
    // this value". One reading, decided by the store's arity, not by whether the
    // author's binding happens to match a column name.
    const insert_identity = order.len == 1 and std.mem.eql(u8, order[0], ast.STORE_IDENTITY_COLUMN);
    const row_fields: []const struct_literal.StructField = if (insert_identity) blk: {
        const one = allocator.alloc(struct_literal.StructField, 1) catch unreachable;
        one[0] = .{ .name = ast.STORE_IDENTITY_COLUMN, .value = std.mem.trim(u8, block_text.?, " \t\n\r") };
        break :blk one;
    } else struct_literal.parseFields(allocator, braced) catch |err| {
        return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, "std/store:insert({s}): {s}", .{ store_name, struct_literal.describeError(err) }) } };
    };
    if (row_fields.len != order.len) {
        return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, "std/store:insert({s}): a row block names every column exactly once ({d} given, {d} declared)", .{ store_name, row_fields.len, order.len }) } };
    }

    // Args in declared column order; every column required.
    const call_args = allocator.alloc(ast.Arg, order.len + 1) catch unreachable;
    for (order, 0..) |col, i| {
        const val: []const u8 = blk: {
            for (row_fields) |rf| {
                if (std.mem.eql(u8, rf.name, col)) break :blk rf.value;
            }
            return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, "std/store:insert({s}): row block is missing column '{s}'", .{ store_name, col }) } };
        };
        // Cell reads in the seed lower to the SoA cell (690_192) — the same
        // rewrite the stored RHS gets. The insert site is a std.store
        // invocation, so create's whole-program walk skips its args; this is
        // the only position the seed's cell paths ever lower.
        const seed_val: []const u8 = H.storeRefsAll(allocator, program, val);
        // Fixed-char overflow (690_052): a COMPTIME-KNOWN string literal that
        // exceeds the column's byte length is a compile error naming column +
        // limit. Runtime values truncate in the insert proc (the `| toolong`
        // branch is a deferred refinement).
        if (H.charCap(allocator, program, store_name, col)) |ncap| {
            const v = std.mem.trim(u8, val, " ");
            if (v.len >= 2 and v[0] == '"' and v[v.len - 1] == '"') {
                const blen = H.literalByteLen(v[1 .. v.len - 1]);
                if (blen > ncap) {
                    return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, "std/store:insert({s}): string literal ({d} bytes) overflows char[{d}] column '{s}' - a fixed-char column holds at most its declared byte length", .{ store_name, blen, ncap, col }) } };
                }
            }
        }
        // An OWNED column consumes the caller's <instance!> — ownership moves
        // INTO the store (690_053), and teardown frees every owned pointer. A
        // row PROJECTION is a BORROW: the source store keeps its live
        // <state!> (690_060). Feeding a projection into an owned insert would
        // put one pointer under two stores' teardowns — both free it — so the
        // write site refuses (pinned at 690_195). Three faces of the same
        // borrow, by transform order: `r.name` (the authored projection, not
        // yet rewritten), `__koru_srf_*` (a sweep arm's projected parameter),
        // `__koru_store_*` (a query/cell read already lowered to the column).
        if (H.ownedCol(allocator, program, store_name, col)) {
            const ov = std.mem.trim(u8, seed_val, " \t\n\r");
            const is_sweep_proj = std.mem.indexOf(u8, ov, "__koru_srf_") != null;
            const is_cell_read = std.mem.indexOf(u8, ov, "__koru_store_") != null;
            const is_dotted_proj = blk: {
                if (ov.len == 0) break :blk false;
                const c0 = ov[0];
                if (!((c0 >= 'a' and c0 <= 'z') or (c0 >= 'A' and c0 <= 'Z') or c0 == '_')) break :blk false;
                var saw_dot = false;
                for (ov) |ch| {
                    const ok = (ch >= 'a' and ch <= 'z') or (ch >= 'A' and ch <= 'Z') or (ch >= '0' and ch <= '9') or ch == '_' or ch == '.';
                    if (!ok) break :blk false;
                    if (ch == '.') saw_dot = true;
                }
                break :blk saw_dot;
            };
            if (is_sweep_proj or is_cell_read or is_dotted_proj) {
                return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, "std/store:insert({s}): column '{s}' is owned - its value must be an instance the caller gives up (single ownership, 690_053); a row projection is a borrow the source store still owns, and accepting it would put one pointer under two teardowns. Take or build a fresh instance for this row instead.", .{ store_name, col }) } };
            }
        }
        call_args[i] = ast.Arg{
            .name = allocator.dupe(u8, col) catch unreachable,
            .value = allocator.dupe(u8, seed_val) catch unreachable,
        };
    }
    call_args[order.len] = ast.Arg{
        .name = allocator.dupe(u8, "__site_line") catch unreachable,
        .value = std.fmt.allocPrint(allocator, "{d}", .{flow.location.line}) catch unreachable,
    };

    // Handle form iff the site handles `| row …`; anything else on an
    // insert site is a loud wall this rung.
    const site_is_head = invocation == flow.inv();
    var has_row_cont = false;
    var has_full_cont = false;
    if (site_is_head) {
        for (flow.body.continuations) |*c| {
            const bname = std.mem.trim(u8, c.branch, " ");
            if (std.mem.eql(u8, bname, "row")) {
                has_row_cont = true;
            } else if (std.mem.eql(u8, bname, "full")) {
                has_full_cont = true;
            } else {
                return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, "std/store:insert({s}): branch '{s}' - insert answers `| row <binding>` and `| full` only (inserted/removed lifecycle is pinned at 690_016)", .{ store_name, c.branch }) } };
            }
        }
    }

    // Owned-store `| full` routes to insertf, which reissues column ownership
    // on the full arm (690_077). Sites without `| full` still panic via the
    // void/inserth append path.
    const target = if (has_full_cont)
        std.fmt.allocPrint(allocator, "__store_insertf_{s}", .{store_name}) catch unreachable
    else if (has_row_cont)
        std.fmt.allocPrint(allocator, "__store_inserth_{s}", .{store_name}) catch unreachable
    else
        std.fmt.allocPrint(allocator, "__store_insert_{s}", .{store_name}) catch unreachable;

    const call_inv = ast.Invocation{
        .path = H.mkPathH(allocator, home_ns, target),
        .args = call_args,
    };

    const conts: []ast.Continuation = if (has_row_cont or has_full_cont) blk: {
        const cloned = allocator.alloc(ast.Continuation, flow.body.continuations.len) catch unreachable;
        for (flow.body.continuations, 0..) |*c, i| {
            cloned[i] = ast_functional.cloneContinuation(allocator, c) catch unreachable;
        }
        break :blk cloned;
    } else &[_]ast.Continuation{};

    return .{ .transformed = .{ .replacement = ast.Item{ .flow = ast.Flow{
        .body = ast.rootSite(call_inv, conts, flow.location),
        .pre_label = null,
        .impl_of = flow.impl_of, // preserved: the site may BE an impl flow's head (e.g. a query body)
        .super_shape = null,
        .inline_body = null,
        .preamble_code = null,
        .is_pure = false,
        .is_transitively_pure = false,
        .location = flow.location,
        .module = allocator.dupe(u8, flow.module) catch unreachable,
    } } } };
}

// ============================================================================
// STORE.QUERY — row-level subscription + imperative sweep (rung two)
// ============================================================================
//
// The coordinator (create) has already transplanted this site's projection,
// guard, and body into the per-line qrow/qbody units and spliced standing
// enters into the insert path. The site itself becomes the SWEEP over the
// rows that exist when its program position executes ((l) lean: the
// imperative sweep IS the stripe).

~[keyword|comptime|transform|claims_descendants]pub tor rule {
    expr: Expression,
    invocation: *const Invocation,
    item: *const Item,
    program: *const Program,
    reporter: *std/compiler:ErrorReporter,
    allocator: std.mem.Allocator
} -> SiteResult

~[transform]proc rule|zig {
    const ast = @import("ast");

    if (item.* != .flow) @panic("store:rule transform: containing item is not a flow - walker dispatch contract broken");
    const flow = &item.flow;

    const H = struct {
        fn stripQuotes(n: []const u8) []const u8 {
            if (n.len >= 2 and n[0] == '"') return n[1 .. n.len - 1];
            return n;
        }
        fn mkPathH(alloc: std.mem.Allocator, module: []const u8, name: []const u8) ast.DottedPath {
            const segs = alloc.alloc([]const u8, 1) catch unreachable;
            segs[0] = alloc.dupe(u8, name) catch unreachable;
            return ast.DottedPath{ .module_qualifier = alloc.dupe(u8, module) catch unreachable, .segments = segs };
        }
    };

    var store_name: []const u8 = "";
    for (invocation.args) |arg| {
        if (std.mem.eql(u8, arg.name, "expr")) store_name = H.stripQuotes(arg.value);
    }
    if (store_name.len == 0) {
        return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, "std/store:rule requires a store name: query(name)", .{}) } };
    }

    // The generated units live in the STORE's home namespace, which is the
    // import-derived `app.lib` — not this flow's file-derived `lib`. They
    // coincide in the entry file and diverge inside a library (115_018).
    const home_ns = storeHome(allocator, program, store_name) orelse flow.module;
    // The coordinator names this site's units by its source line.
    const qsweep_name = std.fmt.allocPrint(allocator, "__store_qsweep_{s}_L{d}", .{ store_name, flow.location.line }) catch unreachable;
    var unit_exists = false;
    for (flatItems(allocator, program.items)) |pi| {
        if (pi.* != .event_decl) continue;
        const ed = &pi.event_decl;
        if (ed.path.segments.len == 1 and std.mem.eql(u8, ed.path.segments[0], qsweep_name)) {
            unit_exists = true;
            break;
        }
    }
    if (!unit_exists) {
        var create_exists = false;
        for (flatItems(allocator, program.items)) |pi| {
            if (pi.* != .flow) continue;
            const f = &pi.flow;
            const inv = f.inv();
            if (inv.path.segments.len != 1 or !std.mem.eql(u8, inv.path.segments[0], "new")) continue;
            const mq = inv.path.module_qualifier orelse continue;
            if (!std.mem.eql(u8, mq, "std.store")) continue;
            for (inv.args) |a| {
                if (std.mem.eql(u8, a.name, "expr") and std.mem.eql(u8, H.stripQuotes(a.value), store_name)) create_exists = true;
            }
        }
        if (create_exists) {
            return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, "std/store:rule({s}): the query precedes its store's create in source - declare the store first", .{store_name}) } };
        }

        // The create coordinator, once run, leaves persistent generated units
        // (`__store_insert_<s>`) even after the raw `new` flow lowers away. If
        // that unit exists but this query site got NO sweep unit, the store IS
        // declared — the query is just in a position the coordinator never
        // scans: a NESTED (handler / loop) body. `query` is a standing-rule
        // INSTALLATION (comptime-fused into the store's write paths), top-level-
        // only BY CONSTRUCTION (concept: frag-store-verb-placement) — a nested
        // body has nothing to install into. Teach that; don't lie "unknown
        // store" when the store is right there.
        const insert_unit = std.fmt.allocPrint(allocator, "__store_insert_{s}", .{store_name}) catch unreachable;
        var store_declared = false;
        for (flatItems(allocator, program.items)) |pi| {
            if (pi.* != .event_decl) continue;
            const ed = &pi.event_decl;
            if (ed.path.segments.len == 1 and std.mem.eql(u8, ed.path.segments[0], insert_unit)) {
                store_declared = true;
                break;
            }
        }
        if (store_declared) {
            return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, "std/store:rule({s}) is top-level-only: it cannot be nested inside a handler or loop body. `query` is a standing-rule installation (comptime-fused into the store's write paths), so a nested body has nothing to install into. The store IS declared - move the query to module (top-level) scope. Momentary verbs (insert/take) DO run in nested bodies.", .{store_name}) } };
        }

        // The store's OWN declaration was already refused; that diagnostic is the
        // true one and this lookup can only ever fail. Staying silent here is what
        // keeps one mistake to one error.
        if (ast.declarationRefused(allocator, program, flow.module, "std/store:new({s}):", .{store_name})) return .{ .transformed = .{} };
        return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, "std/store:rule({s}): unknown store - no std/store:new({s}) found (or the store is a capacity-1 value - queries need a container, declare `capacity: N` at create)", .{ store_name, store_name }) } };
    }

    const sweep_inv = ast.Invocation{
        .path = H.mkPathH(allocator, home_ns, qsweep_name),
        .args = &[_]ast.Arg{},
    };
    return .{ .transformed = .{ .replacement = ast.Item{ .flow = ast.Flow{
        .body = ast.rootSite(sweep_inv, &[_]ast.Continuation{}, flow.location),
        .pre_label = null,
        .impl_of = flow.impl_of, // preserved: the site may BE an impl flow's head (e.g. a query body)
        .super_shape = null,
        .inline_body = null,
        .preamble_code = null,
        .is_pure = false,
        .is_transitively_pure = false,
        .location = flow.location,
        .module = allocator.dupe(u8, flow.module) catch unreachable,
    } } } };
}

// ============================================================================
// STORE.SWEEP — momentary on-demand read of all live rows
// ============================================================================
//
//   std/store:query(items)
//   ! sweep e |> body(v: e.v)
//
// The MOMENTARY twin of query. query is a STANDING-RULE installation
// (comptime-fused into write paths, top-level-only BY CONSTRUCTION); sweep is a
// RUNTIME read of the corpus — "for each live row RIGHT NOW, project, run the
// body" — a momentary act like insert/take, so it composes in NESTED position
// (a vaxis `! draw` handler, a loop body). It lowers SITE-LOCAL: the sweep loop
// is emitted INLINE at the call site (`.replacement` inline_code + `.appended`
// body decls), NEVER via the top-level coordinator — that top-level scan is
// exactly what makes query top-level-only. Schema comes from the store's
// persistent `__store_insert_<s>` event (survives after `new` lowers — the same
// source insert.fieldOrder reads). This is the render-bridge primitive: a
// retained-mode renderer (vaxis `! draw`, fires on mount + resize with no store
// write) sweeps the live rows to repaint. See concept: frag-store-verb-placement.

// `claims_descendants`: query MUST fire before its own `! query <row> |> body`
// branch is walked. Otherwise print.ln (deeper, so depth-first-first) resolves
// the body's `{{ field }}` holes while the row binding isn't in scope yet
// (pre-transplant), leaving a raw template. query dodges this by having `create`
// drive the transplant early (on `new`); sweep drives its OWN transplant at the
// site, so it must claim its descendants to win the same race.
~[keyword|comptime|transform|claims_descendants]pub tor query {
    expr: Expression,
    invocation: *const Invocation,
    item: *const Item,
    program: *const Program,
    reporter: *std/compiler:ErrorReporter,
    allocator: std.mem.Allocator
} -> SiteResult

~[transform]proc query|zig {
    const ast = @import("ast");
    const ast_functional = @import("ast_functional");

    // THE TARGET, READ ONCE — the same move `new|zig` makes at :591. Query's
    // sweep road assembles a loop and a proc body out of host text, and every
    // shape in it (the counted loop, the handler's argument record, the cursor
    // cast, the generated proc's own target tag) is spelled differently by the
    // two hosts. Emitting the Zig spelling unconditionally is why 38 store
    // tests died on `__store_sweeprun_* has no |js proc`: the proc was minted
    // with `.target = "zig"` and the emitter had nothing to run.
    const HS = codegen_utils_store.HostShape;
    const host_is_js = std.mem.eql(u8, CompilerEnv.lang, "js");
    const host_target: codegen_utils_store.HostTarget = if (host_is_js) .js else .zig;
    const proc_target = if (host_is_js) "js" else "zig";

    if (item.* != .flow) @panic("store:query transform: containing item is not a flow - walker dispatch contract broken");
    const flow = &item.flow;

    const H = struct {
        fn stripQuotes(n: []const u8) []const u8 {
            if (n.len >= 2 and n[0] == '"') return n[1 .. n.len - 1];
            return n;
        }
        fn mkPathH(alloc: std.mem.Allocator, module: []const u8, name: []const u8) ast.DottedPath {
            const segs = alloc.alloc([]const u8, 1) catch unreachable;
            segs[0] = alloc.dupe(u8, name) catch unreachable;
            return ast.DottedPath{ .module_qualifier = alloc.dupe(u8, module) catch unreachable, .segments = segs };
        }
        // An owned column's __store_insert phantom is the CONSUMING form
        // `mod:!state` (ownership moves IN). A sweep projects it as a BARE BORROW
        // `mod:state` (no `!`) — read accepts it and consumes nothing, so the
        // store keeps the live `<state!>` it frees at teardown (query's qbody does
        // the same, store.kz:2261). Strip the `!` right after the `:`.
        fn bareBorrow(alloc: std.mem.Allocator, ph: []const u8) []const u8 {
            const colon = std.mem.indexOfScalar(u8, ph, ':') orelse return alloc.dupe(u8, ph) catch unreachable;
            if (colon + 1 < ph.len and ph[colon + 1] == '!') {
                const out = alloc.alloc(u8, ph.len - 1) catch unreachable;
                @memcpy(out[0 .. colon + 1], ph[0 .. colon + 1]);
                @memcpy(out[colon + 1 ..], ph[colon + 2 ..]);
                return out;
            }
            return alloc.dupe(u8, ph) catch unreachable;
        }
    };

    // --- store name from the invocation (arg named "expr") ---
    var store_name: []const u8 = "";
    for (invocation.args) |arg| {
        if (std.mem.eql(u8, arg.name, "expr")) store_name = H.stripQuotes(arg.value);
    }
    if (store_name.len == 0) {
        return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, "std/store:query requires a store name: query(name)", .{}) } };
    }

    // The generated units live in the STORE's home namespace, which is the
    // import-derived `app.lib` — not this flow's file-derived `lib`. They
    // coincide in the entry file and diverge inside a library (115_018).
    const home_ns = storeHome(allocator, program, store_name) orelse flow.module;
    // --- schema from the persistent __store_insert_<s> event (survives after
    //     the raw `new` flow lowers — the same source insert.fieldOrder reads).
    //     Its input fields ARE the columns; the trailing field is the synthetic
    //     __site_line arg. ---
    const insert_ev_name = std.fmt.allocPrint(allocator, "__store_insert_{s}", .{store_name}) catch unreachable;
    var col_names: []const []const u8 = &[_][]const u8{};
    var col_types: []const []const u8 = &[_][]const u8{};
    var col_mods: []const ?[]const u8 = &[_]?[]const u8{};
    var col_phantoms: []const ?[]const u8 = &[_]?[]const u8{};
    for (flatItems(allocator, program.items)) |pi| {
        if (pi.* != .event_decl) continue;
        const ed = &pi.event_decl;
        if (ed.path.segments.len == 1 and std.mem.eql(u8, ed.path.segments[0], insert_ev_name)) {
            const flds = ed.input.fields;
            const n = if (flds.len > 0) flds.len - 1 else 0;
            const nm = allocator.alloc([]const u8, n) catch unreachable;
            const ty = allocator.alloc([]const u8, n) catch unreachable;
            const mp = allocator.alloc(?[]const u8, n) catch unreachable;
            const ph = allocator.alloc(?[]const u8, n) catch unreachable;
            for (flds[0..n], 0..) |f2, i| {
                nm[i] = f2.name;
                ty[i] = f2.type;
                mp[i] = f2.module_path;
                ph[i] = f2.phantom;
            }
            col_names = nm;
            col_types = ty;
            col_mods = mp;
            col_phantoms = ph;
            break;
        }
    }
    if (col_names.len == 0) {
        // The store's OWN declaration was already refused; that diagnostic is the
        // true one and this lookup can only ever fail. Staying silent here is what
        // keeps one mistake to one error.
        if (ast.declarationRefused(allocator, program, flow.module, "std/store:new({s}):", .{store_name})) return .{ .transformed = .{} };
        return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, "std/store:query({s}): unknown plural store - no std/store:new({s}, capacity: N) found (query reads a plural container's live rows)", .{ store_name, store_name }) } };
    }

    // --- parse the `! query <row> |> body` branch ---
    //
    // The arm BINDS the row it visits, the way `! as acc` binds capture's cell
    // and `! each i` binds for's item (control.kz:120/189 declare `! each *`
    // and `! as *`). Every reference to the row goes through that binding, so
    // `<row>.<field>` is the ONE spelling — in a read, in a `when` guard, and
    // in a `stored` target alike. Which columns this site touches is DERIVED
    // from those references, not listed by the author: the projection block
    // said the same thing twice and let the two halves disagree.
    if (flow.body.continuations.len != 1) {
        return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, "std/store:query({s}): exactly one `! query <row>` branch per site", .{store_name}) } };
    }
    const sc = &flow.body.continuations[0];
    if (!std.mem.eql(u8, std.mem.trim(u8, sc.branch, " "), "query")) {
        return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, "std/store:query({s}): the row branch is spelled `! query <row>`", .{store_name}) } };
    }
    // A destructure block on the query arm is a REQUEST. Each entry carries a
    // PREFIX annotation naming what the visit should synthesize for it, and the
    // transform provides exactly what is asked for and nothing more:
    //
    //     ! query { [row]e, [ordinal]n } |> … n … e.v …
    //
    // `! query e` stays the shorthand for `! query { [row]e }`; 149 green
    // sites write it and rule 1 of the 690_086 ruleset still governs the row.
    //
    // WHAT IS STILL REFUSED, and why it is not the same thing. An UNANNOTATED
    // entry is the old projection block: a list of COLUMNS the body also
    // references, which said the same thing twice and let the two halves
    // disagree. Which columns a site touches stays DERIVED from
    // `<row>.<field>`. Nothing in a request block is a column, so nothing is
    // stated twice, and every entry is a binding, so nesting stays
    // unambiguous the way `entity` never was.
    //
    // An annotation this transform does not implement is REFUSED, never
    // ignored — the same law declared reductions carry.
    var req_row: ?[]const u8 = null;
    var req_ordinal: ?[]const u8 = null;
    var req_id: ?[]const u8 = null;
    for (sc.destructure) |df| {
        if (df.annotations.len == 0) {
            // Carries BOTH teachings deliberately. The entry may be the old
            // `entity.v` projection (690_089's migration wall pins that this
            // still refuses and still says "binds its row"), or a plain column
            // name someone reached for now that braces parse again. One
            // message covers both: what replaced the projection, and what a
            // request block is actually for.
            return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, "std/store:query({s}): '{s}' is an unannotated entry — the query arm binds its row (`! query <row> |> ... <row>.<field> ...`); a request block names what the VISIT synthesizes (`[row]`, `[ordinal]`), never columns", .{ store_name, df.name }) } };
        }
        for (df.annotations) |a| {
            if (std.mem.eql(u8, a, "row")) {
                req_row = df.name;
            } else if (std.mem.eql(u8, a, "ordinal")) {
                req_ordinal = df.name;
            } else if (std.mem.eql(u8, a, "id")) {
                req_id = df.name;
            } else {
                return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, "std/store:query({s}): unknown request `[{s}]` on '{s}' — this arm understands [row], [ordinal] and [id]", .{ store_name, a, df.name }) } };
            }
        }
    }
    if (sc.destructure.len > 0 and req_row == null) {
        return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, "std/store:query({s}): a request block must name the row — add `[row]<name>`", .{store_name}) } };
    }
    const row_bind = req_row orelse sc.binding orelse {
        return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, "std/store:query({s}): the query arm needs a row binding: `! query <row> |> ...`", .{store_name}) } };
    };

    // The row's projected fields and its cursor are keyed on the ARM — binding
    // and line — never on the bare field name. This body may be transplanted
    // into ANOTHER sweepbody's scope (a nested sweep), and a field-keyed name
    // minted there is the same name the inner arm mints for its own row: the
    // inner store's column claims the outer binding's reads, silently, at the
    // inner cursor (690_110). The binding says WHOSE row a reference is; the
    // line splits arms that share a spelling. `-` is not a Zig identifier
    // character, so a kebab binding is folded before it reaches emitted code.
    const bind_key = blk: {
        const k = allocator.dupe(u8, row_bind) catch unreachable;
        for (k) |*ch| {
            if (ch.* == '-') ch.* = '_';
        }
        break :blk k;
    };
    const srf_prefix = std.fmt.allocPrint(allocator, "__koru_srf_{s}_L{d}_", .{ bind_key, sc.location.line }) catch unreachable;
    // The cursor is the DENSE row index, not a generational handle. A sweep
    // stands on a row it can see, so its reads and writes need no handle
    // round-trip (the O10.iv elision) — the write-family units take dense
    // rows, and the `__koru_sdix_` spelling is the marker the stored
    // transform keys its pass-through on. Handle call sites (a stored row
    // binding, `__koru_qrow`) still resolve at their own write sites.
    const srow_name = std.fmt.allocPrint(allocator, "__koru_sdix_{s}_L{d}", .{ bind_key, sc.location.line }) catch unreachable;

    // --- the body: transplanted into a sweepbody impl flow (like query's qbody) ---
    const body_clone = ast_functional.cloneContinuation(allocator, sc) catch unreachable;
    const body_node = body_clone.node orelse {
        return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, "std/store:query({s}): the sweep branch needs a body (`|> ...`)", .{store_name}) } };
    };
    if (body_node != .invocation) {
        return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, "std/store:query({s}): the sweep body must start with an invocation this rung", .{store_name}) } };
    }

    // A sweep arm READS and WRITES the row it is standing on (690_083), and both
    // are spelled `<row>.<field>`. Three lowered forms, chosen by position:
    //
    //   .target — a `stored` LHS   → `<store>[<cursor>].<f>`, the indexed
    //             lvalue the `stored` transform expects to be handed.
    //   .live   — a `stored` RHS   → a direct column read at the cursor, so a
    //             block that writes one field and reads another sees the row as
    //             it is NOW, not as it was when the loop iteration began.
    //   .input  — everywhere else  → `<srf_prefix><f>`, the per-row value
    //             handed to the transplanted body as an event input.
    //
    // The `.input` name is MANGLED rather than the bare field name, and that is
    // what makes rule 5 (shadowing is allowed) free: `<row>.v` and an enclosing
    // `v` cannot collide, because the row's `v` never occupies the name `v` in
    // any emitted scope. The projection block could not offer that — it bound
    // the field's own name into the body's scope.
    //
    // Which columns get threaded is DERIVED here: `used[i]` is set by the
    // `.input` rewrite, so a site pays for exactly the fields it names, which is
    // what keeps the ordinal-free lowering KORU100-safe.
    const used_cols = allocator.alloc(bool, col_names.len) catch unreachable;
    for (used_cols) |*u| u.* = false;
    var unknown_field: ?[]const u8 = null;

    const SRewrite = struct {
        const Form = enum { target, live, input };
        fn isIdentCh(ch: u8) bool {
            return (ch >= 'a' and ch <= 'z') or (ch >= 'A' and ch <= 'Z') or (ch >= '0' and ch <= '9') or ch == '_' or ch == '-';
        }
        fn refs(alloc: std.mem.Allocator, text: []const u8, bind: []const u8, store: []const u8, fields: []const []const u8, srf: []const u8, cursor: []const u8, form: Form, used: []bool, unknown: *?[]const u8) []const u8 {
            const prefix = std.fmt.allocPrint(alloc, "{s}.", .{bind}) catch unreachable;
            const expr_ctx = ast.expressionMask(alloc, text);
            var out = std.ArrayList(u8).initCapacity(alloc, text.len + 32) catch unreachable;
            var i: usize = 0;
            while (i < text.len) {
                const at_boundary = ast.identBoundaryBefore(text, i);
                if (at_boundary and std.mem.startsWith(u8, text[i..], prefix)) {
                    const fstart = i + prefix.len;
                    var fend = fstart;
                    while (fend < text.len and isIdentCh(text[fend])) fend += 1;
                    const fname = text[fstart..fend];
                    var cidx: ?usize = null;
                    for (fields, 0..) |f, fi| {
                        if (std.mem.eql(u8, f, fname)) cidx = fi;
                    }
                    if (cidx) |ci| {
                        const t = switch (form) {
                            .target => std.fmt.allocPrint(alloc, "{s}[{s}].{s}", .{ store, cursor, fname }) catch unreachable,
                            // The cursor is dense — a direct column read, no
                            // resolve chain in the loop body (O10.iv elision).
                            .live => std.fmt.allocPrint(alloc, "__koru_store_{s}.{s}[{s}]", .{ store, fname, codegen_utils_store.HostShape.asIndex(alloc, storeHostTarget(), cursor) }) catch unreachable,
                            .input => blk3: {
                                used[ci] = true;
                                break :blk3 std.fmt.allocPrint(alloc, "{s}{s}", .{ srf, fname }) catch unreachable;
                            },
                        };
                        out.appendSlice(alloc, t) catch unreachable;
                        i = fend;
                        continue;
                    }
                    // `<row>.<not-a-column>`: the binding is unambiguous, so this
                    // is a typo the store can name, not a free name to pass on to
                    // the host as `undeclared identifier`.
                    if (fend > fstart and unknown.* == null) unknown.* = alloc.dupe(u8, fname) catch unreachable;
                }
                // A ONE-column store's row names no field, so the BARE binding is
                // the value: `! query n |> use(v: n)`. Derived from `fields`
                // rather than threaded — the column list already says it.
                const row_is_identity = fields.len == 1 and std.mem.eql(u8, fields[0], ast.STORE_IDENTITY_COLUMN);
                if (row_is_identity and expr_ctx[i] and at_boundary and std.mem.startsWith(u8, text[i..], bind)) {
                    const after = i + bind.len;
                    if (after >= text.len or (!isIdentCh(text[after]) and text[after] != '.')) {
                        const fname = fields[0];
                        const t = switch (form) {
                            .target => std.fmt.allocPrint(alloc, "{s}[{s}].{s}", .{ store, cursor, fname }) catch unreachable,
                            .live => std.fmt.allocPrint(alloc, "__koru_store_{s}.{s}[{s}]", .{ store, fname, codegen_utils_store.HostShape.asIndex(alloc, storeHostTarget(), cursor) }) catch unreachable,
                            .input => blk4: {
                                used[0] = true;
                                break :blk4 std.fmt.allocPrint(alloc, "{s}{s}", .{ srf, fname }) catch unreachable;
                            },
                        };
                        out.appendSlice(alloc, t) catch unreachable;
                        i = after;
                        continue;
                    }
                }
                out.append(alloc, text[i]) catch unreachable;
                i += 1;
            }
            return out.toOwnedSlice(alloc) catch unreachable;
        }
        // A row-addressed lvalue is TWO different things spelled as one string.
        // The head and the field are a write TARGET — Koru spelling, which the
        // `stored` transform re-parses below by splitting on the brackets. But
        // whatever sits BETWEEN the brackets is a READ, and it was getting the
        // target form too: `stored { other[r.h].v: … }` inside a sweep lowered
        // the index to `other[refs[cursor].h].v`, where the inner store name
        // never received its `__koru_store_` prefix because nothing downstream
        // re-lowers a target-form read. It failed as an undeclared identifier in
        // the emitted Zig.
        //
        // Reads already compose to any depth; this is the write side catching up
        // to one hop. The splitter below uses the FIRST `[` and the LAST `]`, so
        // a lowered read nested inside the brackets survives the re-parse.
        fn storedTarget(alloc: std.mem.Allocator, text: []const u8, bind: []const u8, store: []const u8, fields: []const []const u8, srf: []const u8, cursor: []const u8, used: []bool, unknown: *?[]const u8) []const u8 {
            const lb = std.mem.indexOfScalar(u8, text, '[') orelse
                return refs(alloc, text, bind, store, fields, srf, cursor, .target, used, unknown);
            const rb = std.mem.lastIndexOfScalar(u8, text, ']') orelse
                return refs(alloc, text, bind, store, fields, srf, cursor, .target, used, unknown);
            if (rb <= lb + 1) return refs(alloc, text, bind, store, fields, srf, cursor, .target, used, unknown);
            var out = std.ArrayList(u8).initCapacity(alloc, text.len + 64) catch unreachable;
            out.appendSlice(alloc, refs(alloc, text[0 .. lb + 1], bind, store, fields, srf, cursor, .target, used, unknown)) catch unreachable;
            out.appendSlice(alloc, refs(alloc, text[lb + 1 .. rb], bind, store, fields, srf, cursor, .live, used, unknown)) catch unreachable;
            out.appendSlice(alloc, refs(alloc, text[rb..], bind, store, fields, srf, cursor, .target, used, unknown)) catch unreachable;
            return out.toOwnedSlice(alloc) catch unreachable;
        }
        // A stored block is `target: value` pairs — targets take the indexed
        // lvalue, values read the live column.
        fn storedBlock(alloc: std.mem.Allocator, text: []const u8, bind: []const u8, store: []const u8, fields: []const []const u8, srf: []const u8, cursor: []const u8, used: []bool, unknown: *?[]const u8) []const u8 {
            const braced = std.fmt.allocPrint(alloc, "{{{s}}}", .{text}) catch unreachable;
            const struct_literal_s = @import("struct_literal");
            const pairs = struct_literal_s.parseFields(alloc, braced) catch return text;
            var out = std.ArrayList(u8).initCapacity(alloc, text.len + 64) catch unreachable;
            for (pairs, 0..) |pr, i| {
                if (i > 0) out.appendSlice(alloc, ", ") catch unreachable;
                out.appendSlice(alloc, storedTarget(alloc, pr.name, bind, store, fields, srf, cursor, used, unknown)) catch unreachable;
                out.appendSlice(alloc, ": ") catch unreachable;
                out.appendSlice(alloc, refs(alloc, pr.value, bind, store, fields, srf, cursor, .live, used, unknown)) catch unreachable;
            }
            return out.toOwnedSlice(alloc) catch unreachable;
        }
        fn walkCont(alloc: std.mem.Allocator, cont: *ast.Continuation, bind: []const u8, store: []const u8, fields: []const []const u8, srf: []const u8, cursor: []const u8, used: []bool, unknown: *?[]const u8) void {
            // A nested arm's `when` guard runs inside the body event, so it reads
            // the threaded inputs like any other body expression.
            if (cont.condition) |c| {
                @constCast(cont).condition = refs(alloc, c, bind, store, fields, srf, cursor, .input, used, unknown);
            }
            if (cont.node) |*n| {
                switch (@constCast(n).*) {
                    .invocation => |*inv| {
                        const is_stored = blk2: {
                            if (inv.path.module_qualifier) |mq| {
                                if (std.mem.eql(u8, mq, "std.store") and inv.path.segments.len == 1 and std.mem.eql(u8, inv.path.segments[0], "stored")) break :blk2 true;
                            }
                            break :blk2 false;
                        };
                        // An Arg carries its text up to three ways — `value`, the
                        // captured `expression_value` (what a `{{ hole }}` in a
                        // string literal resolves against), and `source_value`.
                        // All three must move together or the emitted code
                        // disagrees with itself; query rewrites the same trio
                        // (store.kz:1565).
                        for (inv.args) |*a| {
                            const is_source_block = is_stored and std.mem.eql(u8, a.name, "source");
                            @constCast(a).value = if (is_source_block)
                                storedBlock(alloc, a.value, bind, store, fields, srf, cursor, used, unknown)
                            else
                                refs(alloc, a.value, bind, store, fields, srf, cursor, .input, used, unknown);
                            if (a.expression_value) |ev| {
                                const fresh = alloc.create(ast.CapturedExpression) catch unreachable;
                                fresh.* = ev.*;
                                fresh.text = if (is_source_block)
                                    storedBlock(alloc, ev.text, bind, store, fields, srf, cursor, used, unknown)
                                else
                                    refs(alloc, ev.text, bind, store, fields, srf, cursor, .input, used, unknown);
                                @constCast(a).expression_value = fresh;
                            }
                            if (a.source_value) |sv| {
                                const fresh = alloc.create(ast.Source) catch unreachable;
                                fresh.* = sv.*;
                                fresh.text = if (is_source_block)
                                    storedBlock(alloc, sv.text, bind, store, fields, srf, cursor, used, unknown)
                                else
                                    refs(alloc, sv.text, bind, store, fields, srf, cursor, .input, used, unknown);
                                @constCast(a).source_value = fresh;
                            }
                        }
                    },
                    else => {},
                }
            }
            // Rule 4 of 690_086 — bindings resolve innermost first. A nested
            // sweep arm that REBINDS this name shadows it (rule 5): everything
            // under that arm reads the INNER row, and the inner site's own
            // transform claims those references. Descending past the rebind
            // would hand them to the outer row — a resolution decided by pass
            // order instead of by the rule.
            const node_is_sweep = blk5: {
                if (cont.node) |*n| {
                    if (n.* == .invocation) {
                        if (n.invocation.path.module_qualifier) |mq| {
                            if (std.mem.eql(u8, mq, "std.store") and n.invocation.path.segments.len == 1 and std.mem.eql(u8, n.invocation.path.segments[0], "query")) break :blk5 true;
                        }
                    }
                }
                break :blk5 false;
            };
            for (cont.continuations) |*c| {
                if (node_is_sweep and std.mem.eql(u8, std.mem.trim(u8, c.branch, " "), "query")) {
                    if (c.binding) |cb| {
                        if (std.mem.eql(u8, cb, bind)) continue;
                    }
                }
                walkCont(alloc, @constCast(c), bind, store, fields, srf, cursor, used, unknown);
            }
        }
    };
    SRewrite.walkCont(allocator, @constCast(&body_clone), row_bind, store_name, col_names, srf_prefix, srow_name, used_cols, &unknown_field);

    // The arm's own `when` guard is emitted in the LOOP, not the body event —
    // but it reads the same `<srf_prefix><f>` consts, which the loop binds just
    // above it. One spelling, two scopes, no second rule.
    const guard_z: ?[]const u8 = if (sc.condition) |c|
        SRewrite.refs(allocator, c, row_bind, store_name, col_names, srf_prefix, srow_name, .input, used_cols, &unknown_field)
    else
        null;

    if (unknown_field) |uf| {
        return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, "std/store:query({s}): '{s}.{s}' - '{s}' is not a field of store '{s}'", .{ store_name, row_bind, uf, uf, store_name }) } };
    }

    // The derived projection: every column the arm named, in declaration order.
    var pnames = std.ArrayList([]const u8).initCapacity(allocator, col_names.len) catch unreachable;
    var pcols = std.ArrayList(usize).initCapacity(allocator, col_names.len) catch unreachable;
    for (col_names, 0..) |cn, ci| {
        if (!used_cols[ci]) continue;
        pnames.append(allocator, std.fmt.allocPrint(allocator, "{s}{s}", .{ srf_prefix, cn }) catch unreachable) catch unreachable;
        pcols.append(allocator, ci) catch unreachable;
    }
    const proj_names = pnames.toOwnedSlice(allocator) catch unreachable;
    const proj_cols = pcols.toOwnedSlice(allocator) catch unreachable;

    // --- ENCLOSING CAPTURES (690_073 / todo_tui render bridge) ---
    // The sweep loop is site-local Zig (inline where `: n` / `: body` live), but
    // the transplanted sweepbody is a SEPARATE event. Free names from enclosing
    // mid-pipe binds must be threaded as extra inputs — otherwise the host
    // leaks `undeclared identifier`. Watch bodies REJECT enclosing names (they
    // run at write sites elsewhere); sweep bodies CAPTURE them (they run HERE).
    const Cap = struct {
        const Bind = struct {
            name: []const u8,
            type: []const u8,
            module_path: ?[]const u8 = null,
            phantom: ?[]const u8 = null,
            /// Emit THIS expression at the call site instead of the bare name.
            /// An ordinary capture passes `.n = n` — the name is already live
            /// in the loop's scope. A SYNTHESIZED request (`[ordinal]`) has no
            /// such local: its value is the loop cursor, so it rides the same
            /// threading with the expression carried here.
            value: ?[]const u8 = null,
        };
        // The column type of a `std.store:new(...)` seed field — the type an
        // interceptor destructure field binds (690_093). Reads the seed block
        // the same way the create transform does; null when the field is not a
        // declared column.
        fn storeColumnType(alloc: std.mem.Allocator, inv: *const ast.Invocation, want: []const u8) ?[]const u8 {
            var seed: ?[]const u8 = null;
            for (inv.args) |a| {
                if (std.mem.eql(u8, a.name, "source")) seed = a.value;
            }
            const s = seed orelse return null;
            const struct_literal = @import("struct_literal");
            const braced = std.fmt.allocPrint(alloc, "{{{s}}}", .{s}) catch return null;
            const cf = struct_literal.parseFields(alloc, braced) catch return null;
            for (cf) |c| {
                if (std.mem.eql(u8, c.name, want)) return alloc.dupe(u8, std.mem.trim(u8, c.value, " \t\n\r")) catch return null;
            }
            return null;
        }
        fn isIdentStart(ch: u8) bool {
            return (ch >= 'a' and ch <= 'z') or (ch >= 'A' and ch <= 'Z') or ch == '_';
        }
        fn isIdent(ch: u8) bool {
            return isIdentStart(ch) or (ch >= '0' and ch <= '9') or ch == '-';
        }
        fn textRefs(alloc: std.mem.Allocator, text: []const u8, out: *std.ArrayList([]const u8)) void {
            var i: usize = 0;
            while (i < text.len) {
                if (!isIdentStart(text[i])) {
                    i += 1;
                    continue;
                }
                const start = i;
                i += 1;
                while (i < text.len and isIdent(text[i])) i += 1;
                const tok = text[start..i];
                // Skip keywords / ambient.
                const skip = [_][]const u8{ "and", "or", "not", "true", "false", "_" };
                var skipped = false;
                for (skip) |s| {
                    if (std.mem.eql(u8, tok, s)) {
                        skipped = true;
                        break;
                    }
                }
                if (skipped) continue;
                out.append(alloc, tok) catch unreachable;
            }
        }
        fn collectRefs(alloc: std.mem.Allocator, cont: *const ast.Continuation, out: *std.ArrayList([]const u8)) void {
            if (cont.binding) |b| textRefs(alloc, b, out);
            if (cont.condition) |c| textRefs(alloc, c, out);
            if (cont.node) |*n| {
                if (n.* == .invocation) {
                    for (n.invocation.args) |a| textRefs(alloc, a.value, out);
                }
            }
            for (cont.continuations) |*c| collectRefs(alloc, c, out);
        }
        // Nested sites arrive as a siteView: the handler's `flow.body` is a
        // SHALLOW copy of the real holding continuation (transform_pass_runner
        // siteView). The invocation pointer is therefore NOT in program.items —
        // but the children slice IS shared. Locate the real holding by that
        // shared slice, then walk ancestor mid-pipe binds on the real host.
        fn findHolding(items: []const ast.Item, children: []const ast.Continuation) ?*const ast.Continuation {
            const walk = struct {
                fn call(cont: *const ast.Continuation, ch: []const ast.Continuation) ?*const ast.Continuation {
                    if (cont.continuations.ptr == ch.ptr and cont.continuations.len == ch.len) return cont;
                    for (cont.continuations) |*c| {
                        if (call(c, ch)) |f| return f;
                    }
                    return null;
                }
            }.call;
            for (items) |*pi| {
                if (pi.* == .flow) {
                    if (walk(&pi.flow.body, children)) |h| return h;
                } else if (pi.* == .module_decl) {
                    if (findHolding(pi.module_decl.items, children)) |h| return h;
                }
            }
            return null;
        }
        fn findHostFlow(items: []const ast.Item, holding: *const ast.Continuation) ?*const ast.Flow {
            const contains = struct {
                fn call(cont: *const ast.Continuation, t: *const ast.Continuation) bool {
                    if (cont == t) return true;
                    for (cont.continuations) |*c| {
                        if (call(c, t)) return true;
                    }
                    return false;
                }
            }.call;
            for (items) |*pi| {
                if (pi.* == .flow and contains(&pi.flow.body, holding)) return &pi.flow;
                if (pi.* == .module_decl) {
                    if (findHostFlow(pi.module_decl.items, holding)) |f| return f;
                }
            }
            return null;
        }
        // `phantom` carries the branch payload's obligation/state (`| list
        // *List_i64<list!>` -> the `<list!>` marker). Dropping it here is what
        // made a phantom-typed binding unusable inside a sweep arm: the capture
        // threading below copies type and module and synthesized an input with
        // NO state, so the checker saw an untracked name and refused the call
        // (690_252). Defaulted null because `lookupReturn*` shares this record
        // and a bare-return bind has no branch payload to read one from.
        const RetTy = struct { type: []const u8, module_path: ?[]const u8, phantom: ?[]const u8 = null };
        fn lookupReturnIn(its: []const ast.Item, name: []const u8) ?RetTy {
            for (its) |pi| {
                if (pi == .event_decl) {
                    const ed = &pi.event_decl;
                    if (ed.path.segments.len > 0 and std.mem.eql(u8, ed.path.segments[ed.path.segments.len - 1], name)) {
                        if (ed.return_type) |rt| {
                            // `koru/vaxis:Window` → type Window + module_path
                            if (std.mem.indexOfScalar(u8, rt, ':')) |colon| {
                                return .{ .type = rt[colon + 1 ..], .module_path = rt[0..colon] };
                            }
                            return .{ .type = rt, .module_path = null };
                        }
                    }
                } else if (pi == .module_decl) {
                    if (lookupReturnIn(pi.module_decl.items, name)) |r| return r;
                }
            }
            return null;
        }
        fn lookupReturn(items: []const ast.Item, path: ast.DottedPath) ?RetTy {
            const leaf = if (path.segments.len > 0) path.segments[path.segments.len - 1] else return null;
            return lookupReturnIn(items, leaf);
        }
        // The payload type of one BRANCH — the arm-binding twin of lookupReturn.
        // `! progress pr` binds the payload of `progress` on the event the arm
        // hangs off, exactly as `f(): n` binds that event's return.
        fn lookupBranchIn(its: []const ast.Item, name: []const u8, branch: []const u8) ?RetTy {
            for (its) |pi| {
                if (pi == .event_decl) {
                    const ed = &pi.event_decl;
                    if (ed.path.segments.len > 0 and std.mem.eql(u8, ed.path.segments[ed.path.segments.len - 1], name)) {
                        for (ed.branches) |b| {
                            if (!std.mem.eql(u8, b.name, branch)) continue;
                            // Identity payload only (`| ok *Response<open!>` /
                            // `! progress *Progress`): a multi-field payload is
                            // a record the arm destructures, not a single value
                            // a name stands for.
                            if (b.payload.fields.len != 1) return null;
                            const f = b.payload.fields[0];
                            if (!std.mem.eql(u8, f.name, "__type_ref")) return null;
                            if (f.module_path) |mp| return .{ .type = f.type, .module_path = mp, .phantom = f.phantom };
                            if (std.mem.indexOfScalar(u8, f.type, ':')) |colon| {
                                return .{ .type = f.type[colon + 1 ..], .module_path = f.type[0..colon], .phantom = f.phantom };
                            }
                            // A payload written bare (`! progress *Progress`)
                            // names a type in the DECLARING module's scope, and
                            // the capture lands in the consumer's. Pointer
                            // payloads only: `! beat i64` is a primitive that no
                            // module declares, and qualifying it invents
                            // `koru_vaxis.i64`.
                            if (std.mem.startsWith(u8, f.type, "*")) {
                                if (ed.path.module_qualifier) |mq| {
                                    if (mq.len > 0) return .{ .type = f.type, .module_path = mq, .phantom = f.phantom };
                                }
                            }
                            return .{ .type = f.type, .module_path = null, .phantom = f.phantom };
                        }
                    }
                } else if (pi == .module_decl) {
                    if (lookupBranchIn(pi.module_decl.items, name, branch)) |r| return r;
                }
            }
            return null;
        }
        fn lookupBranch(items: []const ast.Item, path: ast.DottedPath, branch: []const u8) ?RetTy {
            const leaf = if (path.segments.len > 0) path.segments[path.segments.len - 1] else return null;
            return lookupBranchIn(items, leaf, branch);
        }
        // A sweepbody impl flow's OWN event inputs are in scope for its body —
        // the outer sweep's projected row fields and cursor arrive as inputs,
        // keyed on the outer arm. A sweep transplanted INTO that body reads
        // them as free names, so they join `avail` and take the capture road
        // (690_073's `n`), which is what lets a row binding survive nesting
        // (690_110, 690_112).
        fn eventInputsIn(alloc: std.mem.Allocator, its: []const ast.Item, leaf: []const u8, mq: ?[]const u8, out: *std.ArrayList(Bind)) void {
            for (its) |pi| {
                if (pi == .event_decl) {
                    const ed = &pi.event_decl;
                    if (ed.path.segments.len == 0) continue;
                    if (!std.mem.eql(u8, ed.path.segments[ed.path.segments.len - 1], leaf)) continue;
                    if (mq) |m| {
                        if (ed.path.module_qualifier) |em| {
                            if (!std.mem.eql(u8, em, m)) continue;
                        }
                    }
                    for (ed.input.fields) |f| {
                        out.append(alloc, .{
                            .name = f.name,
                            .type = f.type,
                            .module_path = f.module_path,
                            .phantom = f.phantom,
                        }) catch unreachable;
                    }
                } else if (pi == .module_decl) {
                    eventInputsIn(alloc, pi.module_decl.items, leaf, mq, out);
                }
            }
        }
        fn collectEventInputs(alloc: std.mem.Allocator, items: []const ast.Item, path: ast.DottedPath, out: *std.ArrayList(Bind)) void {
            if (path.segments.len == 0) return;
            eventInputsIn(alloc, items, path.segments[path.segments.len - 1], path.module_qualifier, out);
        }
        fn collectBindsOnPath(alloc: std.mem.Allocator, items: []const ast.Item, cont: *const ast.Continuation, target: *const ast.Invocation, out: *std.ArrayList(Bind)) bool {
            // Returns true if `target` lives under `cont`. Pushes mid-pipe binds
            // on the path TO the target (ancestors only — not sibling arms or
            // the sweep body itself).
            if (cont.node) |*n| {
                if (n.* == .invocation and &n.invocation == target) return true;
            }
            for (cont.continuations) |*c| {
                if (collectBindsOnPath(alloc, items, c, target, out)) {
                    // The CHILD's arm binding is in scope for everything under
                    // it, so a sweep body nested in `! draw w` or `! progress
                    // pr` reads those names — and until this was recorded, the
                    // transplanted body got `use of undeclared identifier 'w'`.
                    // Its type is the branch payload on THIS cont's invocation,
                    // which is the event whose branches the child arm handles.
                    //
                    // gallery works around the gap by binding a sub-window
                    // mid-pipe first (`sub(parent: win, …): root`), which lands
                    // in the return_binding case below. That is a fine spelling
                    // and not the only one: an arm payload has no call to hang
                    // a mid-pipe bind on.
                    if (c.binding) |ab| {
                        if (!std.mem.eql(u8, ab, "_") and !std.mem.startsWith(u8, ab, "_")) {
                            if (cont.node) |*pn| {
                                if (pn.* == .invocation) {
                                    if (lookupBranch(items, pn.invocation.path, std.mem.trim(u8, c.branch, " "))) |bt| {
                                        out.append(alloc, .{
                                            .name = ab,
                                            .type = alloc.dupe(u8, bt.type) catch unreachable,
                                            .module_path = if (bt.module_path) |mp| alloc.dupe(u8, mp) catch unreachable else null,
                                            // The payload's obligation rides along, QUALIFIED with the
                                            // module that declared it. Without the phantom at all the
                                            // synthesized sweep-body input declares a bare type and the
                                            // checker sees an untracked name; without the qualifier the
                                            // state resolves against the CONSUMER's module and the
                                            // mismatch reads `expected 'std.list:list' but got
                                            // 'myprog:list'` (690_252).
                                            //
                                            // Written in the prefixed `mod:!state` spelling that the
                                            // rest of this file's phantom handling expects, from the
                                            // author's bare trailing-bang `state!`.
                                            .phantom = if (bt.phantom) |ph| blk_bph: {
                                                if (std.mem.indexOfScalar(u8, ph, ':') != null) break :blk_bph alloc.dupe(u8, ph) catch unreachable;
                                                const owed = ph.len > 1 and ph[ph.len - 1] == '!';
                                                const base = if (owed) ph[0 .. ph.len - 1] else ph;
                                                const mp = bt.module_path orelse break :blk_bph alloc.dupe(u8, ph) catch unreachable;
                                                break :blk_bph std.fmt.allocPrint(alloc, "{s}:{s}{s}", .{ mp, if (owed) "!" else "", base }) catch unreachable;
                                            } else null,
                                        }) catch unreachable;
                                    }
                                }
                            }
                        }
                    }
                    // A DESTRUCTURE arm (`! removed { id }`) binds its fields
                    // the same way — the interceptor-payload threading
                    // (690_093). The fields are the create's store columns, so
                    // the type resolves from the parent invocation's seed
                    // block, not lookupBranch (a record payload has no single
                    // type to return). Skipped when the parent is not a
                    // std.store:new — a generic destructure's field types are
                    // a record lookup this pass does not do, and an untyped
                    // capture is worse than none.
                    if (c.destructure.len > 0) {
                        if (cont.node) |*pn| {
                            if (pn.* == .invocation) {
                                const is_create = blk: {
                                    if (pn.invocation.path.module_qualifier) |mq| {
                                        if (std.mem.eql(u8, mq, "std.store") and pn.invocation.path.segments.len == 1 and std.mem.eql(u8, pn.invocation.path.segments[0], "new")) break :blk true;
                                    }
                                    break :blk false;
                                };
                                if (is_create) {
                                    for (c.destructure) |df| {
                                        if (storeColumnType(alloc, &pn.invocation, df.name)) |ft| {
                                            out.append(alloc, .{ .name = alloc.dupe(u8, df.name) catch unreachable, .type = ft }) catch unreachable;
                                        }
                                    }
                                }
                            }
                        }
                    }
                    // Child path hit — this cont is an ancestor. Record its
                    // mid-pipe bind if any, then bubble up.
                    if (cont.node) |*n| {
                        if (n.* == .invocation) {
                            if (n.invocation.return_binding) |rb| {
                                if (lookupReturn(items, n.invocation.path)) |rt| {
                                    out.append(alloc, .{
                                        .name = rb,
                                        .type = alloc.dupe(u8, rt.type) catch unreachable,
                                        .module_path = if (rt.module_path) |mp| alloc.dupe(u8, mp) catch unreachable else null,
                                    }) catch unreachable;
                                } else {
                                    out.append(alloc, .{
                                        .name = rb,
                                        .type = alloc.dupe(u8, "i64") catch unreachable,
                                    }) catch unreachable;
                                }
                            }
                        }
                    }
                    return true;
                }
            }
            return false;
        }
    };

    var refs = std.ArrayList([]const u8).initCapacity(allocator, 8) catch unreachable;
    Cap.collectRefs(allocator, &body_clone, &refs);

    var avail = std.ArrayList(Cap.Bind).initCapacity(allocator, 4) catch unreachable;
    // Resolve the REAL holding continuation (shared children slice survives
    // siteView's shallow copy) and collect enclosing mid-pipe binds from its
    // host flow. Pointer equality on `invocation` alone fails for nested sites.
    if (Cap.findHolding(program.items, flow.body.continuations)) |holding| {
        if (holding.node) |*hn| {
            if (hn.* == .invocation) {
                if (Cap.findHostFlow(program.items, holding)) |host| {
                    _ = Cap.collectBindsOnPath(allocator, program.items, &host.body, &hn.invocation, &avail);
                    // The host flow's own event INPUTS are in scope for its
                    // body, exactly like the mid-pipe binds collected above:
                    // `integrate { dt }` materializes `const dt` in the very
                    // frame that calls the sweeprun, one line above the call.
                    // Two kinds of host, one rule:
                    //
                    //   - a synthesized `__store_sweepbody_`: its inputs are
                    //     the OUTER row's arm-keyed projections and cursor
                    //     (the nested-sweep case).
                    //   - a user tor: its inputs are the parameters the author
                    //     declared, and `pos += vel * dt` is why it matters —
                    //     the most common thing an ECS system does.
                    //
                    // This was gated to sweepbody hosts on the theory that
                    // ordinary names would over-capture. They cannot: the
                    // filter below takes a name only when the body actually
                    // REFERENCES it, after skipping the row binding (rule 5
                    // shadowing) and the projections. An input that shadows a
                    // store name is rule 4 working as ruled — bindings resolve
                    // before module-local stores.
                    //
                    // Measured before widening: the SAME `dt` reached the same
                    // body when it arrived as a mid-chain bind
                    // (`tick(): dt |> query …`, green) and not when declared a
                    // parameter. One origin, not one scope, was the whole
                    // difference — the threading it needs already worked.
                    if (host.impl_of) |iof| {
                        Cap.collectEventInputs(allocator, program.items, iof, &avail);
                    }
                }
            }
        }
    }

    var captures = std.ArrayList(Cap.Bind).initCapacity(allocator, 4) catch unreachable;
    for (avail.items) |b| {
        // The row binding names THIS arm's row, never an enclosing value — an
        // outer bind of the same name is shadowed (rule 5), not captured.
        if (std.mem.eql(u8, b.name, row_bind)) continue;
        // Already a projection field? Skip.
        var is_proj = false;
        for (proj_names) |pn| {
            if (std.mem.eql(u8, pn, b.name)) {
                is_proj = true;
                break;
            }
        }
        if (is_proj) continue;
        // Referenced in the sweep body?
        var used = false;
        for (refs.items) |r| {
            if (std.mem.eql(u8, r, b.name)) {
                used = true;
                break;
            }
        }
        if (!used) continue;
        // Dedup.
        var seen = false;
        for (captures.items) |c| {
            if (std.mem.eql(u8, c.name, b.name)) {
                seen = true;
                break;
            }
        }
        if (seen) continue;
        captures.append(allocator, b) catch unreachable;
    }

    // `[ordinal]n` rides the capture threading. The cursor is already computed
    // by the loop and already handed to the body as `srow_name`; asking for it
    // by an author's name needs no new channel, only one more threaded value —
    // which is why this request costs a line rather than a mechanism.
    //
    // Synthesized ONLY when asked for: an arm that never writes `[ordinal]`
    // adds no field and threads nothing, the same demand-driven rule an unread
    // aggregate materializes no column under.
    if (req_ordinal) |on| {
        captures.append(allocator, .{
            .name = allocator.dupe(u8, on) catch unreachable,
            .type = allocator.dupe(u8, "i64") catch unreachable,
            .value = allocator.dupe(u8, "@as(i64, @intCast(__koru_si))") catch unreachable,
        }) catch unreachable;
    }

    // `[id]h` is `[ordinal]`'s twin and its opposite. The ordinal is WHERE the
    // visit is; the id is WHICH ROW it is standing on — the handle, branded and
    // generation-checked, the same value `| row` mints at insert.
    //
    // Both are needed and neither substitutes for the other, which is the whole
    // reason they are two annotations. A cell that names a row names it by
    // HANDLE, never by position (ruled): a take swap-removes the last row into
    // the freed slot, so an ordinal stored anywhere outlives its meaning by one
    // removal. Handing a body its ordinal and letting it be written to a column
    // would reintroduce the positional address the ruling exists to forbid;
    // `[id]` is what makes the correct value SPELLABLE instead of merely
    // recommended.
    //
    // Costs a line for the same reason `[ordinal]` does — the loop already
    // stands on the dense row, and `__koru_handle_of` is the resolve chain run
    // backwards, so the request threads one more value rather than opening a
    // channel. Synthesized ONLY when asked for.
    //
    // The unblocked shape is an intrusive chain: a sweep that reads a bucket
    // head, writes it to its own `next`, then writes ITSELF as the new head —
    // which needs to name itself, and until now could not (690_246).
    //
    // The cell reference carries the SAME qualifier every other reference in
    // this loop does (see `cellq` below). `[ordinal]`'s value names no store,
    // so the twin this mirrors was safe by accident — and a capture is exactly
    // what pushes the loop off the `__store_sweeprun_*` road, where a bare name
    // resolved only because the loop was emitted next to the cell it names. On
    // the other two roads the loop lands in the CALLER's namespace and a bare
    // `__koru_store_<s>` is undeclared (115_047, the cross-module mirror).
    if (req_id) |idn| {
        captures.append(allocator, .{
            .name = allocator.dupe(u8, idn) catch unreachable,
            .type = allocator.dupe(u8, "i64") catch unreachable,
            .value = std.fmt.allocPrint(allocator, "{s}__koru_store_{s}.__koru_handle_of(__koru_si)", .{ storeCellQualifier(allocator, home_ns, program.main_module_name), store_name }) catch unreachable,
        }) catch unreachable;
    }

    // Keyed on the SWEEP ARM's own line, not the enclosing flow's. Sweep
    // inherited query's flow-line site key, and that key is only unique because
    // query is top-level-only — one query is one flow by construction. Sweep
    // exists precisely to nest, and a sweep transplanted into another sweep's
    // body carries the parent flow's location, so two sweeps of the SAME store
    // in one flow minted identical symbols. Two sweeps of DIFFERENT stores were
    // disambiguated by store_name, which is why 690_087 never caught it.
    // Pinned: 690_110.
    const sbody_name = std.fmt.allocPrint(allocator, "__store_sweepbody_{s}_L{d}", .{ store_name, sc.location.line }) catch unreachable;
    // +1 for the arm-keyed row cursor. The projections hand the body
    // COPIES of the row's values; writing back needs the row itself. Query's
    // qbody takes `__koru_qrow` for exactly this reason (store.kz:1481).
    // Always threaded, never conditional on the body writing: an unused event
    // input lowers to a suppressed `_ = &x;`, so there is nothing to detect and
    // nothing to get wrong.
    const sbody_in = allocator.alloc(ast.Field, proj_names.len + captures.items.len + 1) catch unreachable;
    for (proj_names, proj_cols, 0..) |pn, ci, i| {
        // An owned column (insert phantom present) projects as a BARE borrow so
        // the body may read it without discharging; scalars/char project the
        // value type directly (the qbody owned/scalar split, store.kz:2261).
        sbody_in[i] = if (col_phantoms[ci]) |ins_ph| ast.Field{
            .name = allocator.dupe(u8, pn) catch unreachable,
            .type = allocator.dupe(u8, col_types[ci]) catch unreachable,
            .module_path = if (col_mods[ci]) |m| allocator.dupe(u8, m) catch unreachable else null,
            .phantom = H.bareBorrow(allocator, ins_ph),
        } else ast.Field{ .name = allocator.dupe(u8, pn) catch unreachable, .type = allocator.dupe(u8, col_types[ci]) catch unreachable };
    }
    for (captures.items, 0..) |c, i| {
        sbody_in[proj_names.len + i] = ast.Field{
            .name = allocator.dupe(u8, c.name) catch unreachable,
            .type = c.type,
            .module_path = c.module_path,
            // A BARE BORROW, never the obligation — the same demotion an owned
            // column's projection makes just above. The arm may read and mutate
            // the captured handle; it must not be asked to DISCHARGE it, because
            // the obligation belongs to the enclosing scope and the body runs
            // once per row. `<list!>` in, `<list>` here.
            //
            // TWO SPELLINGS reach here and only one of them is what `bareBorrow`
            // was written for. A projected column's phantom is the prefixed
            // `<qualifier>:!state`; a BRANCH PAYLOAD's is the bare trailing-bang
            // `state!` that the author wrote in the declaration. Feeding the
            // second to `bareBorrow` returns it untouched — it finds no colon —
            // and the input then tries to ISSUE the obligation, which KORU033
            // correctly refuses on a parameter.
            .phantom = if (c.phantom) |ph| blk_ph: {
                if (ph.len > 1 and ph[ph.len - 1] == '!') break :blk_ph allocator.dupe(u8, ph[0 .. ph.len - 1]) catch unreachable;
                break :blk_ph H.bareBorrow(allocator, ph);
            } else null,
        };
    }
    sbody_in[proj_names.len + captures.items.len] = ast.Field{
        .name = allocator.dupe(u8, srow_name) catch unreachable,
        .type = allocator.dupe(u8, "i64") catch unreachable,
    };
    const retain_ann = blk: {
        const anns = allocator.alloc([]const u8, 1) catch unreachable;
        anns[0] = allocator.dupe(u8, "retain") catch unreachable;
        break :blk anns;
    };
    var appended = std.ArrayList(ast.Item).initCapacity(allocator, 2) catch unreachable;
    appended.append(allocator, ast.Item{ .event_decl = ast.EventDecl{
        .path = H.mkPathH(allocator, home_ns, sbody_name),
        .input = ast.Shape{ .fields = sbody_in },
        .branches = &[_]ast.Branch{},
        .is_public = false,
        .is_implicit_flow = false,
        .annotations = retain_ann,
        .location = flow.location,
        .module = allocator.dupe(u8, flow.module) catch unreachable,
    } }) catch unreachable;
    appended.append(allocator, ast.Item{ .flow = ast.Flow{
        .body = ast.rootSite(body_node.invocation, body_clone.continuations, flow.location),
        .pre_label = null,
        .impl_of = H.mkPathH(allocator, home_ns, sbody_name),
        .super_shape = null,
        .inline_body = null,
        .preamble_code = null,
        .is_pure = false,
        .is_transitively_pure = false,
        .location = flow.location,
        .module = allocator.dupe(u8, flow.module) catch unreachable,
    } }) catch unreachable;

    // --- the inline sweep loop, emitted SITE-LOCAL (never a coordinator unit).
    //     Reads the SoA cell (__koru_store_<s>.len + column arrays), binds the
    //     projected fields per row, calls the transplanted body event — plus any
    //     enclosing captures (names already live in this Zig scope). ---
    var loop = std.ArrayList(u8).initCapacity(allocator, 256) catch unreachable;
    // The SoA cell is declared in the STORE'S OWN module, so every reference to
    // it needs the SAME qualifier the body call below already uses — both name
    // things living in `home_ns`.
    //
    // Emitting it bare was correct only by coincidence of placement. With no
    // capture this loop is lifted into a `__store_sweeprun_*` event that is
    // PLACED IN the store's module, so a bare `__koru_store_<s>` resolved
    // because it happened to be emitted next to the cell it names. A capture
    // keeps the loop INLINE at the sweep site to hold the captured value in
    // lexical scope — the CALLER's namespace — and the coincidence ends: one
    // emitted statement then qualified the body call and not the cell, three
    // tokens apart (115_043).
    //
    // Entry-file programs are unaffected: the qualifier is `main_module.` there
    // and the cell is declared inside `main_module`.
    const cellq = storeCellQualifier(allocator, home_ns, program.main_module_name);
    const cell_len = std.fmt.allocPrint(allocator, "{s}__koru_store_{s}.len", .{ cellq, store_name }) catch unreachable;
    loop.appendSlice(allocator, "{\n") catch unreachable;
    loop.appendSlice(allocator, HS.loopHead(allocator, host_target, "__koru_si", cell_len)) catch unreachable;
    for (proj_names, proj_cols) |pn, ci| {
        const read = std.fmt.allocPrint(allocator, "{s}__koru_store_{s}.{s}[__koru_si]", .{ cellq, store_name, col_names[ci] }) catch unreachable;
        loop.appendSlice(allocator, HS.constBind(allocator, host_target, pn, read)) catch unreachable;
    }
    // The arm's `when` guard, emitted AFTER the projection binds so it can read
    // them and BEFORE the body call so it can skip it (690_084). Query does the
    // same thing one line earlier in its own lowering — `if (!(g)) return;`
    // inside a per-row proc; a sweep is a loop, so the skip is `continue`.
    //
    // It used to be parsed, collected for captures, and then dropped: accepted
    // and silently ignored, so every row ran the body. A guard that is refused
    // costs one compile; a guard that is ignored reads as working and quietly
    // widens every write behind it.
    if (guard_z) |cond| {
        var unknown_op: []const u8 = "";
        const lowered_c = storeLowerExpr(allocator, cond, &unknown_op) orelse
            return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, "std/store:query({s}): the sweep guard names `@{s}`, and that operation has no lowering for this target - a store guard is a Koru expression, and the operations Koru names with `@` are the shared table in codegen_utils.lowerBuiltin", .{ store_name, unknown_op }) } };
        const gz = std.fmt.allocPrint(allocator, "if (!({s})) continue;\n", .{lowered_c}) catch unreachable;
        loop.appendSlice(allocator, gz) catch unreachable;
    }
    loop.appendSlice(allocator, storeEventQualifier(allocator, home_ns, program.main_module_name)) catch unreachable;
    loop.appendSlice(allocator, sbody_name) catch unreachable;
    // A derived projection can be EMPTY — an arm that never names a field of the
    // row it stands on (690_087's outer sweep only nests another sweep). The
    // authored projection block could not express that, so the separator was
    // free; now the cursor may be the only argument.
    // The argument record, assembled as pairs and then wrapped once, because
    // `.{ … }` and `{ … }` differ at BOTH ends and a per-pair split would put
    // the opening brace three statements away from the closing one.
    var argb = std.ArrayList(u8).initCapacity(allocator, 64) catch unreachable;
    for (proj_names) |pn| {
        if (argb.items.len > 0) argb.appendSlice(allocator, ", ") catch unreachable;
        argb.appendSlice(allocator, HS.recField(allocator, host_target, pn, pn)) catch unreachable;
    }
    for (captures.items) |c| {
        // An ordinary capture is already a live local here, so it passes by
        // name; a synthesized request carries its own expression.
        const cv = c.value orelse c.name;
        if (argb.items.len > 0) argb.appendSlice(allocator, ", ") catch unreachable;
        argb.appendSlice(allocator, HS.recField(allocator, host_target, c.name, cv)) catch unreachable;
    }
    if (argb.items.len > 0) argb.appendSlice(allocator, ", ") catch unreachable;
    argb.appendSlice(allocator, HS.recField(allocator, host_target, srow_name, HS.asI64(allocator, host_target, "__koru_si"))) catch unreachable;
    loop.appendSlice(allocator, "_event.handler(") catch unreachable;
    loop.appendSlice(allocator, HS.argRec(allocator, host_target, argb.items)) catch unreachable;
    loop.appendSlice(allocator, ");\n}\n}\n") catch unreachable;

    // WHERE this replacement lands is the runner's call, and the two placements
    // want different SHAPES. A nested site splices inline, inside a function
    // body, where a bare `{ … }` block is ordinary Zig. A HEAD site replaces the
    // whole Item — file scope — where the same block is
    // `expected type expression, found '{'` (690_081).
    //
    // Head means: this invocation IS the containing flow's head. That covers a
    // top-level statement (`std/store:query(s)` alone on a line) and a subflow
    // head (`scan = std/store:query(s)`) alike. A CHAINED sweep is not a head —
    // desugar-chains re-roots it into its own nested site before transforms
    // run, so the outer flow's head is still whatever preceded the `|>`.
    //
    // A head site therefore gets the loop wrapped in a synthesized void event,
    // and the replacement becomes a flow that invokes it — carrying `impl_of`
    // so a subflow head keeps implementing the event it was written to
    // implement.
    // BY POINTER: `|*hn|`, not `orelse` — the latter copies the payload and
    // compares the address of a local, which is never the runner's invocation.
    // Pointer identity is the established test here; findContainingItem locates
    // this very site the same way (ast.zig findInContinuation).
    //
    // Being the head is NOT enough on its own: a nested site is re-rooted into
    // its own flow before transforms run, so a chained sweep reads as a head
    // too. The load-bearing question is whether the loop DEPENDS ON ENCLOSING
    // SCOPE — captures are names it reads from the frame it is spliced into
    // (690_073's `make(): n |> for(0..1) ! each _ |> sweep(items)` reads `n`),
    // and lifting that into a separate event puts it out of scope. A loop with
    // no captures reads nothing but the store globals and its own projections,
    // so it can be lifted anywhere. A top-level statement has no enclosing
    // frame to capture from, which is exactly the case that needs lifting.
    const is_head = blk: {
        if (flow.body.node) |*hn| {
            if (hn.* != .invocation) break :blk false;
            break :blk &hn.invocation == invocation;
        }
        break :blk false;
    };

    // The head of an IMPL flow, with captures — the nested-sweep shape: this
    // site is the whole body of another sweep's transplanted sweepbody, and
    // its captures are that event's inputs (the outer row). The srun road
    // lifts the loop out of their scope; the inline road has no function body
    // to splice into, because the flow item IS the site. Third road: the flow
    // becomes a PROC implementing the same event. A proc impl binds every
    // event input as a const, so the captures are in scope by construction.
    // Only LEXICAL captures constrain WHERE this loop may live. A synthesized
    // request (`[ordinal]`) computes its value inside the loop from the cursor,
    // so it needs nothing from the enclosing scope and must not push a head
    // site onto the proc road below or the inline road further down — the
    // inline road at file scope is `expected type expression, found '{'`
    // (690_081), which is exactly what asking for an ordinal at a top-level
    // sweep produced before this distinction existed.
    const lexical_captures = blk: {
        var n: usize = 0;
        for (captures.items) |c| {
            if (c.value == null) n += 1;
        }
        break :blk n;
    };
    if (is_head and lexical_captures > 0) {
        if (flow.impl_of) |iof| {
            const pbody = std.fmt.allocPrint(allocator, "{s}return;", .{loop.items}) catch unreachable;
            return .{ .transformed = .{
                .replacement = ast.Item{ .proc_decl = ast.ProcDecl{
                    .path = iof,
                    .body = ast.Source{ .text = pbody, .location = flow.location, .scope = .{ .bindings = &[_]ast.ScopeBinding{} }, .phantom_type = null },
                    .annotations = &[_][]const u8{},
                    .target = allocator.dupe(u8, proc_target) catch unreachable,
                    .location = flow.location,
                    .module = allocator.dupe(u8, flow.module) catch unreachable,
                } },
                .appended = appended.toOwnedSlice(allocator) catch unreachable,
            } };
        }
    }

    const is_head_site = is_head and lexical_captures == 0;

    if (!is_head_site) {
        return .{ .transformed = .{
            .replacement = ast.Item{ .inline_code = ast.InlineCode{ .code = loop.toOwnedSlice(allocator) catch unreachable, .location = flow.location, .module = allocator.dupe(u8, flow.module) catch unreachable } },
            .appended = appended.toOwnedSlice(allocator) catch unreachable,
        } };
    }

    // Same arm-line key as sbody_name above — the two must agree.
    const srun_name = std.fmt.allocPrint(allocator, "__store_sweeprun_{s}_L{d}", .{ store_name, sc.location.line }) catch unreachable;
    appended.append(allocator, ast.Item{ .event_decl = ast.EventDecl{
        .path = H.mkPathH(allocator, home_ns, srun_name),
        .input = ast.Shape{ .fields = &[_]ast.Field{} },
        .branches = &[_]ast.Branch{},
        .is_public = false,
        .is_implicit_flow = false,
        .annotations = retain_ann,
        .location = flow.location,
        .module = allocator.dupe(u8, flow.module) catch unreachable,
    } }) catch unreachable;
    const srun_body = std.fmt.allocPrint(allocator, "{s}return;", .{loop.items}) catch unreachable;
    appended.append(allocator, ast.Item{ .proc_decl = ast.ProcDecl{
        .path = H.mkPathH(allocator, home_ns, srun_name),
        .body = ast.Source{ .text = srun_body, .location = flow.location, .scope = .{ .bindings = &[_]ast.ScopeBinding{} }, .phantom_type = null },
        .annotations = &[_][]const u8{},
        .target = allocator.dupe(u8, proc_target) catch unreachable,
        .location = flow.location,
        .module = allocator.dupe(u8, flow.module) catch unreachable,
    } }) catch unreachable;

    const srun_inv = ast.Invocation{
        .path = H.mkPathH(allocator, home_ns, srun_name),
        .args = &[_]ast.Arg{},
        .source_module = allocator.dupe(u8, flow.module) catch unreachable,
    };
    return .{ .transformed = .{
        .replacement = ast.Item{ .flow = ast.Flow{
            .body = ast.rootSite(srun_inv, &[_]ast.Continuation{}, flow.location),
            .pre_label = null,
            .impl_of = flow.impl_of,
            .super_shape = null,
            .inline_body = null,
            .preamble_code = null,
            .is_pure = false,
            .is_transitively_pure = false,
            .location = flow.location,
            .module = allocator.dupe(u8, flow.module) catch unreachable,
        } },
        .appended = appended.toOwnedSlice(allocator) catch unreachable,
    } };
}

// ============================================================================
// STORE.PREORDER — DFS pre-order forest walk over a [tree] store
// ============================================================================
//
//   std/store:preorder(tree)
//   ! preorder { entity.val } |> …
//
// The tree-store traversal surface (695_STORE_TREE, TT5). The coordinator
// (create) has already transplanted this site's projection/guard/body into
// qrow/qbody units — identical to query — and emitted a DFS pre-order sweep
// over the synthesized `parent` column (roots first, insertion order; each
// node before its children). The site itself becomes that sweep's call.
// Preorder on a non-[tree] store is rejected by the coordinator with a
// teaching diagnostic (no parent column to walk).

~[keyword|comptime|transform|claims_descendants]pub tor preorder {
    expr: Expression,
    invocation: *const Invocation,
    item: *const Item,
    program: *const Program,
    reporter: *std/compiler:ErrorReporter,
    allocator: std.mem.Allocator
} -> SiteResult

~[transform]proc preorder|zig {
    const ast = @import("ast");

    if (item.* != .flow) @panic("store:preorder transform: containing item is not a flow - walker dispatch contract broken");
    const flow = &item.flow;

    const H = struct {
        fn stripQuotes(n: []const u8) []const u8 {
            if (n.len >= 2 and n[0] == '"') return n[1 .. n.len - 1];
            return n;
        }
        fn mkPathH(alloc: std.mem.Allocator, module: []const u8, name: []const u8) ast.DottedPath {
            const segs = alloc.alloc([]const u8, 1) catch unreachable;
            segs[0] = alloc.dupe(u8, name) catch unreachable;
            return ast.DottedPath{ .module_qualifier = alloc.dupe(u8, module) catch unreachable, .segments = segs };
        }
    };

    var store_name: []const u8 = "";
    for (invocation.args) |arg| {
        if (std.mem.eql(u8, arg.name, "expr")) store_name = H.stripQuotes(arg.value);
    }
    if (store_name.len == 0) {
        return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, "std/store:preorder requires a store name: preorder(name)", .{}) } };
    }

    // The generated units live in the STORE's home namespace, which is the
    // import-derived `app.lib` — not this flow's file-derived `lib`. They
    // coincide in the entry file and diverge inside a library (115_018).
    const home_ns = storeHome(allocator, program, store_name) orelse flow.module;
    // The coordinator names this site's units by its source line (the same
    // qsweep scheme as query — only the emitted sweep body differs).
    const qsweep_name = std.fmt.allocPrint(allocator, "__store_qsweep_{s}_L{d}", .{ store_name, flow.location.line }) catch unreachable;
    var unit_exists = false;
    for (flatItems(allocator, program.items)) |pi| {
        if (pi.* != .event_decl) continue;
        const ed = &pi.event_decl;
        if (ed.path.segments.len == 1 and std.mem.eql(u8, ed.path.segments[0], qsweep_name)) {
            unit_exists = true;
            break;
        }
    }
    if (!unit_exists) {
        var create_exists = false;
        for (flatItems(allocator, program.items)) |pi| {
            if (pi.* != .flow) continue;
            const f = &pi.flow;
            const inv = f.inv();
            if (inv.path.segments.len != 1 or !std.mem.eql(u8, inv.path.segments[0], "new")) continue;
            const mq = inv.path.module_qualifier orelse continue;
            if (!std.mem.eql(u8, mq, "std.store")) continue;
            for (inv.args) |a| {
                if (std.mem.eql(u8, a.name, "expr") and std.mem.eql(u8, H.stripQuotes(a.value), store_name)) create_exists = true;
            }
        }
        if (create_exists) {
            return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, "std/store:preorder({s}): the preorder precedes its store's create in source - declare the store first", .{store_name}) } };
        }
        // The store's OWN declaration was already refused; that diagnostic is the
        // true one and this lookup can only ever fail. Staying silent here is what
        // keeps one mistake to one error.
        if (ast.declarationRefused(allocator, program, flow.module, "std/store:new({s}):", .{store_name})) return .{ .transformed = .{} };
        return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, "std/store:preorder({s}): unknown store - no std/store:new({s}) found (preorder walks a [tree] container store)", .{ store_name, store_name }) } };
    }

    const sweep_inv = ast.Invocation{
        .path = H.mkPathH(allocator, home_ns, qsweep_name),
        .args = &[_]ast.Arg{},
    };
    return .{ .transformed = .{ .replacement = ast.Item{ .flow = ast.Flow{
        .body = ast.rootSite(sweep_inv, &[_]ast.Continuation{}, flow.location),
        .pre_label = null,
        .impl_of = flow.impl_of, // preserved: the site may BE an impl flow's head
        .super_shape = null,
        .inline_body = null,
        .preamble_code = null,
        .is_pure = false,
        .is_transitively_pure = false,
        .location = flow.location,
        .module = allocator.dupe(u8, flow.module) catch unreachable,
    } } } };
}

// ============================================================================
// STORE.TAKE — extract a row with ownership through the handle head
// ============================================================================
//
//   std/store:take(game[r]) | item i |> …
//
// Swap-remove (legal: position is never identity — O2/O10.iii). Compiles to
// `__store_take_<s>(row: <handle>)`; the `| item {fields}` branch carries
// the row out. Obligation wiring (a taken row must be consumed or given
// back — 690_007/690_015) rides on the take event's phantom.

~[keyword|comptime|transform]pub tor take {
    expr: Expression,
    invocation: *const Invocation,
    item: *const Item,
    program: *const Program,
    reporter: *std/compiler:ErrorReporter,
    allocator: std.mem.Allocator
} -> SiteResult

~[transform]proc take|zig {
    const ast = @import("ast");
    const ast_functional = @import("ast_functional");

    if (item.* != .flow) @panic("store:take transform: containing item is not a flow - walker dispatch contract broken");
    const flow = &item.flow;

    const H = struct {
        fn stripQuotes(n: []const u8) []const u8 {
            if (n.len >= 2 and n[0] == '"') return n[1 .. n.len - 1];
            return n;
        }
        fn mkPathH(alloc: std.mem.Allocator, module: []const u8, name: []const u8) ast.DottedPath {
            const segs = alloc.alloc([]const u8, 1) catch unreachable;
            segs[0] = alloc.dupe(u8, name) catch unreachable;
            return ast.DottedPath{ .module_qualifier = alloc.dupe(u8, module) catch unreachable, .segments = segs };
        }
        fn isIdent(ch: u8) bool {
            return (ch >= 'a' and ch <= 'z') or (ch >= 'A' and ch <= 'Z') or (ch >= '0' and ch <= '9') or ch == '_' or ch == '-';
        }
        fn storeRefs(alloc: std.mem.Allocator, text: []const u8, name: []const u8) []const u8 {
            var out = std.ArrayList(u8).initCapacity(alloc, text.len + 32) catch unreachable;
            var i: usize = 0;
            while (i < text.len) {
                const at_boundary = ast.identBoundaryBefore(text, i);
                if (at_boundary and i + name.len < text.len and
                    std.mem.startsWith(u8, text[i..], name) and text[i + name.len] == '.')
                {
                    out.appendSlice(alloc, "__koru_store_") catch unreachable;
                    out.appendSlice(alloc, name) catch unreachable;
                    i += name.len;
                } else {
                    out.append(alloc, text[i]) catch unreachable;
                    i += 1;
                }
            }
            return out.toOwnedSlice(alloc) catch unreachable;
        }
        fn storeRefsAll(alloc: std.mem.Allocator, prog: *const ast.Program, text: []const u8) []const u8 {
            var t = text;
            for (flatItems(alloc, prog.items)) |pi| {
                if (pi.* != .event_decl) continue;
                const ed = &pi.event_decl;
                if (ed.path.segments.len == 1 and std.mem.startsWith(u8, ed.path.segments[0], "__store_apply_")) {
                    t = storeRefs(alloc, t, ed.path.segments[0]["__store_apply_".len..]);
                }
            }
            return t;
        }
    };

    var target_text: []const u8 = "";
    for (invocation.args) |arg| {
        if (std.mem.eql(u8, arg.name, "expr")) target_text = H.stripQuotes(arg.value);
    }
    const lb = std.mem.indexOfScalar(u8, target_text, '[') orelse {
        return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, "std/store:take addresses a row: take(store[handle]) - '{s}' has no addressing head", .{target_text}) } };
    };
    if (target_text.len == 0 or target_text[target_text.len - 1] != ']') {
        return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, "std/store:take: malformed addressing head '{s}'", .{target_text}) } };
    }
    const store_name = std.mem.trim(u8, target_text[0..lb], " ");
    // Cross-store cell index (`todos[ui.sel]`) must lower like stored (690_075).
    const row_expr = H.storeRefsAll(allocator, program, std.mem.trim(u8, target_text[lb + 1 .. target_text.len - 1], " "));
    if (store_name.len == 0 or row_expr.len == 0) {
        return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, "std/store:take: malformed addressing head '{s}' - take(store[handle])", .{target_text}) } };
    }

    // The generated units live in the STORE's home namespace, which is the
    // import-derived `app.lib` — not this flow's file-derived `lib`. They
    // coincide in the entry file and diverge inside a library (115_018).
    const home_ns = storeHome(allocator, program, store_name) orelse flow.module;
    const take_name = std.fmt.allocPrint(allocator, "__store_take_{s}", .{store_name}) catch unreachable;
    var unit_exists = false;
    for (flatItems(allocator, program.items)) |pi| {
        if (pi.* != .event_decl) continue;
        const ed = &pi.event_decl;
        if (ed.path.segments.len == 1 and std.mem.eql(u8, ed.path.segments[0], take_name)) {
            unit_exists = true;
            break;
        }
    }
    if (!unit_exists) {
        return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, "std/store:take({s}[...]): unknown or not-yet-created container store '{s}'", .{ store_name, store_name }) } };
    }

    const call_args = allocator.alloc(ast.Arg, 1) catch unreachable;
    call_args[0] = ast.Arg{
        .name = allocator.dupe(u8, "row") catch unreachable,
        .value = allocator.dupe(u8, row_expr) catch unreachable,
    };
    const call_inv = ast.Invocation{
        .path = H.mkPathH(allocator, home_ns, take_name),
        .args = call_args,
    };

    // The take site is usually NESTED (under insert's `| row r`); its own
    // continuations (`| item i |> …`) ride along on the replacement.
    const FindSite = struct {
        fn call(cont: *const ast.Continuation, target: *const ast.Invocation) ?*const ast.Continuation {
            if (cont.node) |*n| {
                if (n.* == .invocation and &n.invocation == target) return cont;
            }
            for (cont.continuations) |*c| {
                if (call(c, target)) |found| return found;
            }
            return null;
        }
    }.call;
    const site = FindSite(&flow.body, invocation);

    const conts: []ast.Continuation = blk: {
        if (site) |sc| {
            const cloned = allocator.alloc(ast.Continuation, sc.continuations.len) catch unreachable;
            for (sc.continuations, 0..) |*c, i| {
                cloned[i] = ast_functional.cloneContinuation(allocator, c) catch unreachable;
            }
            break :blk cloned;
        }
        break :blk &[_]ast.Continuation{};
    };

    return .{ .transformed = .{ .replacement = ast.Item{ .flow = ast.Flow{
        .body = ast.rootSite(call_inv, conts, flow.location),
        .pre_label = null,
        .impl_of = flow.impl_of, // preserved: the site may BE an impl flow's head (e.g. a query body)
        .super_shape = null,
        .inline_body = null,
        .preamble_code = null,
        .is_pure = false,
        .is_transitively_pure = false,
        .location = flow.location,
        .module = allocator.dupe(u8, flow.module) catch unreachable,
    } } } };
}

// ============================================================================
// STORE.STRIPE — the imperative sweep verb ((l)/O13, 690_014)
// ============================================================================
//
//   std/store:stripe(game)
//
// Announce-only: standing watches re-fire with CURRENT values. No write
// happens, so interceptors (the write contract) do NOT run. Compiles to
// the generated `__store_stripe_<s>` unit.

// std/store:clear(s) — empty a plural store in ONE step.
//
// The bulk twin of `take`. Where `take` removes one row and fires `removed`,
// `clear` removes every row and fires `cleared` once. Each removal verb has
// its own arm; neither fires the other's, which is what lets a bulk removal
// stay bulk instead of degenerating into a thousand per-row events.
//
// Outstanding handles go stale across it (the generation of every live slot is
// bumped), so the stale-handle trap 690_115 pins still fires afterwards.
//
// Refused where the meaning would be ambiguous rather than guessed at: a store
// with owned columns keeps `take` plus `! discharge` (obligations discharge one
// at a time, and a bulk reset would drop them silently), and a store with a
// `! removed` arm must declare `! cleared` to say what the aggregate means.

~[keyword|comptime|transform]pub tor clear {
    expr: Expression,
    invocation: *const Invocation,
    item: *const Item,
    program: *const Program,
    reporter: *std/compiler:ErrorReporter,
    allocator: std.mem.Allocator
} -> SiteResult

~[transform]proc clear|zig {
    const ast = @import("ast");

    if (item.* != .flow) @panic("store:clear transform: containing item is not a flow - walker dispatch contract broken");
    const flow = &item.flow;

    const H = struct {
        fn stripQuotes(n: []const u8) []const u8 {
            if (n.len >= 2 and n[0] == '"') return n[1 .. n.len - 1];
            return n;
        }
        fn mkPathH(alloc: std.mem.Allocator, module: []const u8, name: []const u8) ast.DottedPath {
            const segs = alloc.alloc([]const u8, 1) catch unreachable;
            segs[0] = alloc.dupe(u8, name) catch unreachable;
            return ast.DottedPath{ .module_qualifier = alloc.dupe(u8, module) catch unreachable, .segments = segs };
        }
    };

    var store_name: []const u8 = "";
    for (invocation.args) |arg| {
        if (std.mem.eql(u8, arg.name, "expr")) store_name = H.stripQuotes(arg.value);
    }
    if (store_name.len == 0) {
        return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, "std/store:clear requires a store name: clear(name)", .{}) } };
    }

    const home_ns = storeHome(allocator, program, store_name) orelse flow.module;
    const clr_name = std.fmt.allocPrint(allocator, "__store_clear_{s}", .{store_name}) catch unreachable;
    const stripe_probe = std.fmt.allocPrint(allocator, "__store_stripe_{s}", .{store_name}) catch unreachable;
    // A teardown unit is emitted for owned-column stores only (690_053), so
    // its presence is what tells the two refusals apart. Guessing between them
    // would put the author's eye on the wrong line — the failure this very
    // diagnostic exists to avoid.
    const td_probe = std.fmt.allocPrint(allocator, "__store_teardown_{s}", .{store_name}) catch unreachable;
    var unit_exists = false;
    var store_exists = false;
    var store_owned = false;
    for (flatItems(allocator, program.items)) |pi| {
        if (pi.* != .event_decl) continue;
        const ed = &pi.event_decl;
        if (ed.path.segments.len != 1) continue;
        if (std.mem.eql(u8, ed.path.segments[0], clr_name)) unit_exists = true;
        if (std.mem.eql(u8, ed.path.segments[0], stripe_probe)) store_exists = true;
        if (std.mem.eql(u8, ed.path.segments[0], td_probe)) store_owned = true;
    }
    if (!unit_exists) {
        if (ast.declarationRefused(allocator, program, flow.module, "std/store:new({s}):", .{store_name})) return .{ .transformed = .{} };
        // The store is fine; it is this VERB that is unavailable on it, and
        // the two reasons are different enough that one message for both would
        // send the author looking in the wrong place.
        if (store_owned) {
            return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, "std/store:clear({s}): this store has an OWNED column, and an owned row carries an obligation that discharges one at a time - emptying in bulk would drop them on the floor with nothing to report it. Remove rows with `std/store:take`, which hands each row's obligation back through `| item`", .{store_name}) } };
        }
        if (store_exists) {
            return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, "std/store:clear({s}): this store carries a `! removed` arm and no `! cleared` arm. `clear` does NOT fire `! removed` - firing it once per row is exactly the cost `clear` exists to remove - so declare `! cleared <count>` to say what emptying means for this store's observers, or remove rows with `std/store:take`", .{store_name}) } };
        }
        return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, "std/store:clear({s}): unknown store, or a store shape without a clear unit this rung (singleton stores hold one row and are written with `std/store:stored`)", .{store_name}) } };
    }

    const clr_inv = ast.Invocation{
        .path = H.mkPathH(allocator, home_ns, clr_name),
        .args = &[_]ast.Arg{},
    };
    // The chain tail joins the rewritten call, the same contract stripe and
    // stored carry: `clear(s) |> tail` runs the tail after the store is empty.
    return .{ .transformed = .{ .replacement = ast.Item{ .flow = ast.Flow{
        .body = ast.rootSite(clr_inv, flow.body.continuations, flow.location),
        .pre_label = null,
        .impl_of = flow.impl_of,
        .super_shape = null,
        .inline_body = null,
        .preamble_code = null,
        .is_pure = false,
        .is_transitively_pure = false,
        .location = flow.location,
        .module = allocator.dupe(u8, flow.module) catch unreachable,
    } } } };
}

~[keyword|comptime|transform]pub tor stripe {
    expr: Expression,
    invocation: *const Invocation,
    item: *const Item,
    program: *const Program,
    reporter: *std/compiler:ErrorReporter,
    allocator: std.mem.Allocator
} -> SiteResult

~[transform]proc stripe|zig {
    const ast = @import("ast");

    if (item.* != .flow) @panic("store:stripe transform: containing item is not a flow - walker dispatch contract broken");
    const flow = &item.flow;

    const H = struct {
        fn stripQuotes(n: []const u8) []const u8 {
            if (n.len >= 2 and n[0] == '"') return n[1 .. n.len - 1];
            return n;
        }
        fn mkPathH(alloc: std.mem.Allocator, module: []const u8, name: []const u8) ast.DottedPath {
            const segs = alloc.alloc([]const u8, 1) catch unreachable;
            segs[0] = alloc.dupe(u8, name) catch unreachable;
            return ast.DottedPath{ .module_qualifier = alloc.dupe(u8, module) catch unreachable, .segments = segs };
        }
    };

    var store_name: []const u8 = "";
    for (invocation.args) |arg| {
        if (std.mem.eql(u8, arg.name, "expr")) store_name = H.stripQuotes(arg.value);
    }
    if (store_name.len == 0) {
        return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, "std/store:stripe requires a store name: stripe(name)", .{}) } };
    }

    // The generated units live in the STORE's home namespace, which is the
    // import-derived `app.lib` — not this flow's file-derived `lib`. They
    // coincide in the entry file and diverge inside a library (115_018).
    const home_ns = storeHome(allocator, program, store_name) orelse flow.module;
    const stripe_name = std.fmt.allocPrint(allocator, "__store_stripe_{s}", .{store_name}) catch unreachable;
    var unit_exists = false;
    for (flatItems(allocator, program.items)) |pi| {
        if (pi.* != .event_decl) continue;
        const ed = &pi.event_decl;
        if (ed.path.segments.len == 1 and std.mem.eql(u8, ed.path.segments[0], stripe_name)) {
            unit_exists = true;
            break;
        }
    }
    if (!unit_exists) {
        // The store's OWN declaration was already refused; that diagnostic is the
        // true one and this lookup can only ever fail. Staying silent here is what
        // keeps one mistake to one error.
        if (ast.declarationRefused(allocator, program, flow.module, "std/store:new({s}):", .{store_name})) return .{ .transformed = .{} };
        return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, "std/store:stripe({s}): unknown store, or a store shape without a stripe unit this rung (plural / {{old,new}}-mode stripe is a later slice)", .{store_name}) } };
    }

    const stripe_inv = ast.Invocation{
        .path = H.mkPathH(allocator, home_ns, stripe_name),
        .args = &[_]ast.Arg{},
    };
    // The chain tail joins the rewritten call (690_028's `stored` contract):
    // `stripe(s) |> tail` runs the tail after the sweep, never swallows it.
    return .{ .transformed = .{ .replacement = ast.Item{ .flow = ast.Flow{
        .body = ast.rootSite(stripe_inv, flow.body.continuations, flow.location),
        .pre_label = null,
        .impl_of = flow.impl_of,
        .super_shape = null,
        .inline_body = null,
        .preamble_code = null,
        .is_pure = false,
        .is_transitively_pure = false,
        .location = flow.location,
        .module = allocator.dupe(u8, flow.module) catch unreachable,
    } } } };
}
