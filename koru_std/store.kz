// Koru Standard Library: Reactive Stores
// ========================================
//
// Application state as a compiled-reactivity substrate. The FULL design —
// 9 rulings, adversary-stamped theses, the open queue — lives in
// tests/regression/600_STDLIB/690_STORE/DESIGN.md (delete-when-pinned).
// The pins (690_001..008) are the acceptance tests; this file grows until
// they green, rung by rung.
//
// THE SPINE (ruled 2026-07-04):
//   - A store is COMPTIME-NAMED and second-class (ruling 9): never a value,
//     never passed, never nested. `create(game) { ... }` declares name +
//     shape + seed; anyone anywhere links by name.
//   - `stored { game.field: expr }` is the SOLE write path.
//   - Subscriptions (`watch`) compile INTO the write path — tap-style,
//     producer owns the guard, NO runtime registry (ruling 7).
//   - Ruling (f): all writes route through ONE centralizing write-subflow
//     per store; watches/interceptors/guards splice there ONCE.
//   - Writes interleave, never overlap: write + full cascade is the
//     atomicity unit ((h) lean); birth is not a write (O9 lean — the seed
//     is stored in memory, never dispatched as an event).
//
// RUNG ONE — COMPLETE (690_001-004 green runners, 690_006 green designed
// rejection; SHOWN 2026-07-05). The (f) architecture:
//   `create` is the coordinator. Per store it appends FIVE units:
//     1. The module-scope typed cell (capture's @Type builder, host_line).
//     2. An APPLY event — one terminal branch per field, announcing what
//        was written (`| entities i64`; with an `updated` interceptor the
//        payload is `{ old, new }` — the (c) usage-synthesis lean).
//     3. The apply |zig proc — switch on the comptime-constant field index,
//        write the cell, return the field's branch with the new value.
//        (kernel's raw-Zig generated-proc precedent.)
//     4. The WRITE event — the store's sole write surface, void.
//     5. The write event's implementing FLOW — head invokes apply; its
//        continuation arms ARE the transplanted interceptor+watch branches,
//        interceptors sequenced first ((h): watches observe settled state),
//        guards riding as arm conditions (producer owns the if). THIS is
//        the ruling-(f) centralizing write-subflow: bodies splice here
//        ONCE; the atomicity lock and T8 backend cells will live in this
//        body. A nested `stored` inside an interceptor body compiles into
//        a call into the OTHER store's write-subflow — the cascade is
//        ordinary calls through generated subflows, no runtime registry.
//   `stored` rewrites each write site into a plain invocation of the write
//   event — an ordinary flow, emitted inside a function like any call.
//   `watch` sites run the transplant-purity check (ruling (a): free names
//   ⊆ own bindings ∪ comptime-known — koru-level diagnostic, 690_006) and
//   self-erase once the coordinator has spliced their bodies.
//
// STILL WALLED (loud, never silent — KORU047 doctrine):
//   - Multiple watches on one field — needs taps' sequencing splice.
//   - Multi-field `stored` blocks — the (i) chain-envelope, rung two.
//   - Mixing `updated {old,new}` with field-level consumers on one store.
//   - Guarded watch on a field that also has interceptors.
//   - Nested (mid-flow) watch splicing; watch-before-create source order.
//   - Non-i64 fields; guarded interceptors; `inserted`/`removed` (rung 2).
//
// ARCHITECTURE NOTES:
//   - Generated decls follow kernel's precedent exactly (event_decl +
//     proc_decl with raw-Zig body, appended as top-level items; the
//     emitter finds impl_of flows by scanning items at emission time).
//   - Watch collection is kernel's findShapeSource pattern: the transform
//     receives *const Program and walks items for `std/store:watch(name)`
//     flows. Source order: create must precede its watches (loud wall
//     otherwise — the walker transforms in program order, and the
//     coordinator must still be able to see untransformed watch bodies).
//   - Validation happens IN the transforms (loud @compileError), not the
//     shape checker — checkers run after transforms (capture precedent).

const std = @import("std");

// ============================================================================
// STORE.CREATE — declare + instantiate a store; the (f) coordinator
// ============================================================================
//
//   ~std/store:new(game) { entities: 0[i64] }              — capacity-1 VALUE
//   ~std/store:new(pool, capacity: 64) { hp: i64 }         — CONTAINER (rows)
//
// Name arg + seed block (kernel:shape's surface). CAPACITY selects the
// shape (690_050 ruling): default 1 → reactive value, > 1 → container.
// A field is bare-typed (`hp: i64`) or carries a default via the bracket
// annotation (`hp: 100[i64]` — same parser as const/capture); defaults
// are orthogonal to shape.

~[keyword|comptime|transform]pub event new {
    expr: Expression,
    source: Source,
    invocation: *const Invocation,
    item: *const Item,
    program: *const Program,
    allocator: std.mem.Allocator
} -> SiteResult

~[transform]proc new|zig {
    const ast = @import("ast");
    const ast_functional = @import("ast_functional");
    const struct_literal = @import("struct_literal");

    if (item.* != .flow) @panic("store:new transform: containing item is not a flow - walker dispatch contract broken");
    const flow = &item.flow;

    const H = struct {
        fn stripQuotes(n: []const u8) []const u8 {
            if (n.len >= 2 and n[0] == '"') return n[1 .. n.len - 1];
            return n;
        }
        fn isStoreInv(f: *const ast.Flow, verb: []const u8, want_name: ?[]const u8) bool {
            const inv = f.inv();
            if (inv.path.segments.len != 1) return false;
            if (!std.mem.eql(u8, inv.path.segments[0], verb)) return false;
            const mq = inv.path.module_qualifier orelse return false;
            if (!std.mem.eql(u8, mq, "std.store")) return false;
            if (want_name) |n| {
                for (inv.args) |a| {
                    if (std.mem.eql(u8, a.name, "expr")) {
                        return std.mem.eql(u8, stripQuotes(a.value), n);
                    }
                }
                return false;
            }
            return true;
        }
        fn errItem(alloc: std.mem.Allocator, loc: anytype, module: []const u8, comptime fmt: []const u8, args: anytype) ast.Item {
            const inner = std.fmt.allocPrint(alloc, fmt, args) catch unreachable;
            const msg = std.fmt.allocPrint(alloc, "comptime {{ @compileError(\"{s}\"); }}", .{inner}) catch unreachable;
            return ast.Item{ .inline_code = ast.InlineCode{ .code = msg, .location = loc, .module = module } };
        }
        fn isIdentChar(ch: u8) bool {
            return (ch >= 'a' and ch <= 'z') or (ch >= 'A' and ch <= 'Z') or (ch >= '0' and ch <= '9') or ch == '_' or ch == '-';
        }
        fn mkPathH(alloc: std.mem.Allocator, module: []const u8, name: []const u8) ast.DottedPath {
            const segs = alloc.alloc([]const u8, 1) catch unreachable;
            segs[0] = alloc.dupe(u8, name) catch unreachable;
            return ast.DottedPath{ .module_qualifier = alloc.dupe(u8, module) catch unreachable, .segments = segs };
        }
        // Boundary-aware `<store>.` → `__koru_store_<store>.` rewrite over a
        // continuation tree (transplanted bodies read other stores' cells).
        fn storeRefsH(alloc: std.mem.Allocator, text: []const u8, name: []const u8) []const u8 {
            var out = std.ArrayList(u8).initCapacity(alloc, text.len + 32) catch unreachable;
            var i: usize = 0;
            while (i < text.len) {
                const at_boundary = i == 0 or !isIdentChar(text[i - 1]);
                if (at_boundary and i + name.len < text.len and
                    std.mem.startsWith(u8, text[i..], name) and text[i + name.len] == '.')
                {
                    out.appendSlice(alloc, "__koru_store_") catch unreachable;
                    out.appendSlice(alloc, name) catch unreachable;
                    i += name.len;
                } else {
                    out.append(alloc, text[i]) catch unreachable;
                    i += 1;
                }
            }
            return out.toOwnedSlice(alloc) catch unreachable;
        }
        fn storeRefsContH(alloc: std.mem.Allocator, cont: *ast.Continuation, names: []const []const u8) void {
            const ast2 = @import("ast");
            if (cont.condition) |cond| {
                var cnd = cond;
                for (names) |nm| cnd = storeRefsH(alloc, cnd, nm);
                @constCast(cont).condition = cnd;
            }
            if (cont.node) |*n| {
                switch (@constCast(n).*) {
                    .invocation => |*inv| {
                        const skip = blk: {
                            if (inv.path.module_qualifier) |mq| {
                                if (std.mem.eql(u8, mq, "std.store")) break :blk true;
                            }
                            break :blk false;
                        };
                        if (!skip) {
                            for (inv.args) |*a| {
                                var v = a.value;
                                for (names) |nm| v = storeRefsH(alloc, v, nm);
                                @constCast(a).value = v;
                                if (a.expression_value) |ev| {
                                    var t = ev.text;
                                    for (names) |nm| t = storeRefsH(alloc, t, nm);
                                    const fresh = alloc.create(ast2.CapturedExpression) catch unreachable;
                                    fresh.* = ev.*;
                                    fresh.text = t;
                                    @constCast(a).expression_value = fresh;
                                }
                            }
                        }
                    },
                    else => {},
                }
            }
            for (cont.continuations) |*c| storeRefsContH(alloc, @constCast(c), names);
        }
    };

    // Store name + seed block from the invocation args.
    var store_name: []const u8 = "";
    var seed_text: ?[]const u8 = null;
    for (invocation.args) |arg| {
        if (std.mem.eql(u8, arg.name, "expr")) {
            store_name = H.stripQuotes(arg.value);
        } else if (std.mem.eql(u8, arg.name, "source")) {
            seed_text = arg.value;
        }
    }
    if (store_name.len == 0 or seed_text == null) {
        return .{ .transformed = .{ .replacement = H.errItem(allocator, flow.location, flow.module, "std/store:new requires a name and a seed block: create(name) {{ field: value[type] }}", .{}) } };
    }

    // Per-store disposal contract: `[entity(<name>)]` opts this store into the
    // taken-obligation discipline. Its rows are named ENTITIES — `take` mints
    // `<std/store:taken!>` on a synthesized type (the arg capitalized, `enemy`
    // → `Enemy`, aliasing the row struct), and the USER authors the discharger
    // (the despawn handler consuming `<std/store:!taken>`). Absent → a bare
    // value table, `take` frictionless, no obligation.
    var entity_type: ?[]const u8 = null;
    for (flow.annotations) |ann| {
        if (std.mem.startsWith(u8, ann, "entity(") and ann.len > "entity(".len + 1 and ann[ann.len - 1] == ')') {
            const raw = ann["entity(".len .. ann.len - 1];
            if (raw.len > 0) {
                const cap = allocator.alloc(u8, raw.len) catch unreachable;
                @memcpy(cap, raw);
                cap[0] = std.ascii.toUpper(cap[0]);
                entity_type = cap;
            }
        }
    }

    // `[tree]` — the store is a FOREST (695_STORE_TREE, TT1/TT5): synthesize
    // the invisible canonical `parent` self-FK column (i64 row handle, -1 =
    // root; the 690_048 substrate) and enable the `preorder` traversal. The
    // user's row shape never declares `parent`; the annotation adds it.
    var is_tree = false;
    for (flow.annotations) |ann| {
        if (std.mem.eql(u8, ann, "tree") or
            (std.mem.startsWith(u8, ann, "tree(") and ann[ann.len - 1] == ')'))
        {
            is_tree = true;
        }
    }

    // Seed fields via the projector (capture's path exactly).
    const expr_braced = std.fmt.allocPrint(allocator, "{{{s}}}", .{seed_text.?}) catch unreachable;
    const cell_fields = struct_literal.parseFields(allocator, expr_braced) catch &[_]struct_literal.StructField{};
    if (cell_fields.len == 0) {
        return .{ .transformed = .{ .replacement = H.errItem(allocator, flow.location, flow.module, "std/store:new({s}): seed block has no fields", .{store_name}) } };
    }

    // ------------------------------------------------------------------
    // T2 / queue (d): the interceptor cascade graph is comptime-visible;
    // a cross-store cycle is rejected WITH THE CYCLE NAMED (690_012) -
    // never an infinite cascade at runtime. Runs on every create; the
    // first-in-source member of any cycle still sees all others
    // untransformed, so detection cannot be skewed by transform order.
    // ------------------------------------------------------------------
    {
        const CycleEdge = struct {
            from: []const u8,
            from_field: []const u8,
            to: []const u8,
            to_field: []const u8,
        };
        var edges = std.ArrayList(CycleEdge).initCapacity(allocator, 8) catch unreachable;
        const EdgeScan = struct {
            fn seedFields(alloc: std.mem.Allocator, seed2: []const u8) []const []const u8 {
                const struct_literal2 = @import("struct_literal");
                const braced2 = std.fmt.allocPrint(alloc, "{{{s}}}", .{seed2}) catch unreachable;
                const cf2 = struct_literal2.parseFields(alloc, braced2) catch return &[_][]const u8{};
                const names2 = alloc.alloc([]const u8, cf2.len) catch unreachable;
                for (cf2, 0..) |c2, ci2| names2[ci2] = c2.name;
                return names2;
            }
            // Field-name lookup for a store still visible as an
            // untransformed create (seed order) or already coordinated
            // (apply-event branch order).
            fn fieldNameByIndex(alloc: std.mem.Allocator, prog: *const ast.Program, store: []const u8, idx: usize) []const u8 {
                const struct_literal2 = @import("struct_literal");
                const apply_name2 = std.fmt.allocPrint(alloc, "__store_apply_{s}", .{store}) catch unreachable;
                for (prog.items) |pi2| {
                    switch (pi2) {
                        .event_decl => |*ed2| {
                            if (ed2.path.segments.len == 1 and std.mem.eql(u8, ed2.path.segments[0], apply_name2)) {
                                if (idx < ed2.branches.len) return ed2.branches[idx].name;
                            }
                        },
                        .flow => |*f2| {
                            const inv2 = f2.inv();
                            if (inv2.path.segments.len != 1 or !std.mem.eql(u8, inv2.path.segments[0], "new")) continue;
                            const mq2 = inv2.path.module_qualifier orelse continue;
                            if (!std.mem.eql(u8, mq2, "std.store")) continue;
                            var matches2 = false;
                            var seed3: ?[]const u8 = null;
                            for (inv2.args) |a2| {
                                if (std.mem.eql(u8, a2.name, "expr")) {
                                    var v2 = a2.value;
                                    if (v2.len >= 2 and v2[0] == '"') v2 = v2[1 .. v2.len - 1];
                                    matches2 = std.mem.eql(u8, v2, store);
                                } else if (std.mem.eql(u8, a2.name, "source")) {
                                    seed3 = a2.value;
                                }
                            }
                            if (!matches2 or seed3 == null) continue;
                            const braced3 = std.fmt.allocPrint(alloc, "{{{s}}}", .{seed3.?}) catch unreachable;
                            const cf3 = struct_literal2.parseFields(alloc, braced3) catch continue;
                            if (idx < cf3.len) return cf3[idx].name;
                        },
                        else => {},
                    }
                }
                return "?";
            }
            fn scanCont(alloc: std.mem.Allocator, prog: *const ast.Program, cont: *const ast.Continuation, from: []const u8, from_field: []const u8, list: *std.ArrayList(CycleEdge)) void {
                if (cont.node) |n| {
                    switch (n) {
                        .invocation => |inv| {
                            // Raw spelling: std/store:stored { to.field: ... }
                            if (inv.path.module_qualifier) |mq| {
                                if (std.mem.eql(u8, mq, "std.store") and inv.path.segments.len == 1 and std.mem.eql(u8, inv.path.segments[0], "stored")) {
                                    for (inv.args) |a| {
                                        if (!std.mem.eql(u8, a.name, "source")) continue;
                                        const struct_literal2 = @import("struct_literal");
                                        const braced2 = std.fmt.allocPrint(alloc, "{{{s}}}", .{a.value}) catch unreachable;
                                        const writes2 = struct_literal2.parseFields(alloc, braced2) catch continue;
                                        for (writes2) |w2| {
                                            const dot2 = std.mem.indexOfScalar(u8, w2.name, '.') orelse continue;
                                            list.append(alloc, .{
                                                .from = from,
                                                .from_field = from_field,
                                                .to = alloc.dupe(u8, w2.name[0..dot2]) catch unreachable,
                                                .to_field = alloc.dupe(u8, w2.name[dot2 + 1 ..]) catch unreachable,
                                            }) catch unreachable;
                                        }
                                    }
                                }
                            }
                            // Rewritten spelling: __store_write_<to>(field: <idx>, ...)
                            // (the walker transforms nested stored sites BEFORE
                            // their enclosing create's head - both spellings are
                            // live during coordination).
                            if (inv.path.segments.len == 1 and std.mem.startsWith(u8, inv.path.segments[0], "__store_write_")) {
                                const to_store = inv.path.segments[0]["__store_write_".len..];
                                var fidx2: usize = 0;
                                for (inv.args) |a| {
                                    if (std.mem.eql(u8, a.name, "field")) {
                                        fidx2 = std.fmt.parseInt(usize, std.mem.trim(u8, a.value, " "), 10) catch 0;
                                    }
                                }
                                list.append(alloc, .{
                                    .from = from,
                                    .from_field = from_field,
                                    .to = alloc.dupe(u8, to_store) catch unreachable,
                                    .to_field = alloc.dupe(u8, fieldNameByIndex(alloc, prog, to_store, fidx2)) catch unreachable,
                                }) catch unreachable;
                            }
                            // Per-field spelling (owned-containing stores,
                            // unit 4c): __store_fwrite_<to>_<idx>(row, value)
                            // — the field index rides the NAME's suffix after
                            // the last '_', not a `field` arg.
                            if (inv.path.segments.len == 1 and std.mem.startsWith(u8, inv.path.segments[0], "__store_fwrite_")) {
                                const rest = inv.path.segments[0]["__store_fwrite_".len..];
                                if (std.mem.lastIndexOfScalar(u8, rest, '_')) |up| {
                                    const to_store = rest[0..up];
                                    const fidx2 = std.fmt.parseInt(usize, rest[up + 1 ..], 10) catch 0;
                                    list.append(alloc, .{
                                        .from = from,
                                        .from_field = from_field,
                                        .to = alloc.dupe(u8, to_store) catch unreachable,
                                        .to_field = alloc.dupe(u8, fieldNameByIndex(alloc, prog, to_store, fidx2)) catch unreachable,
                                    }) catch unreachable;
                                }
                            }
                        },
                        else => {},
                    }
                }
                for (cont.continuations) |*c| scanCont(alloc, prog, c, from, from_field, list);
            }
        };
        for (program.items) |pi| {
            if (pi != .flow) continue;
            const cfp = &pi.flow;
            if (!H.isStoreInv(cfp, "new", null)) continue;
            var cname: []const u8 = "";
            var cseed: []const u8 = "";
            for (cfp.inv().args) |a| {
                if (std.mem.eql(u8, a.name, "expr")) cname = H.stripQuotes(a.value);
                if (std.mem.eql(u8, a.name, "source")) cseed = a.value;
            }
            if (cname.len == 0) continue;
            // FIELD-LEVEL graph (the whole point of the T2 detector): the
            // trigger of a field interceptor is that field; `updated`
            // triggers on every field of the store. hp->shield inside one
            // store is NOT a cycle (690_004); alpha.x->beta.y->alpha.x is.
            const seed_fields = EdgeScan.seedFields(allocator, cseed);
            for (cfp.body.continuations) |*icont| {
                const bname2 = std.mem.trim(u8, icont.branch, " ");
                if (std.mem.eql(u8, bname2, "updated")) {
                    for (seed_fields) |sf| {
                        EdgeScan.scanCont(allocator, program, icont, cname, sf, &edges);
                    }
                } else {
                    EdgeScan.scanCont(allocator, program, icont, cname, bname2, &edges);
                }
            }
        }
        // DFS from this store looking for a path back to itself.
        var path = std.ArrayList(CycleEdge).initCapacity(allocator, 8) catch unreachable;
        const Dfs = struct {
            fn nodeEql(a_s: []const u8, a_f: []const u8, b_s: []const u8, b_f: []const u8) bool {
                return std.mem.eql(u8, a_s, b_s) and std.mem.eql(u8, a_f, b_f);
            }
            fn walk(list: []const CycleEdge, at_s: []const u8, at_f: []const u8, t_s: []const u8, t_f: []const u8, depth: usize, pth: *std.ArrayList(CycleEdge), alloc: std.mem.Allocator) bool {
                if (depth > 16) return false;
                for (list) |e| {
                    if (!nodeEql(e.from, e.from_field, at_s, at_f)) continue;
                    pth.append(alloc, e) catch unreachable;
                    if (nodeEql(e.to, e.to_field, t_s, t_f)) return true;
                    if (walk(list, e.to, e.to_field, t_s, t_f, depth + 1, pth, alloc)) return true;
                    _ = pth.pop();
                }
                return false;
            }
        };
        var cycle_found = false;
        for (edges.items) |se| {
            if (!std.mem.eql(u8, se.from, store_name)) continue;
            path.clearRetainingCapacity();
            if (Dfs.walk(edges.items, se.from, se.from_field, se.from, se.from_field, 0, &path, allocator)) {
                cycle_found = true;
                break;
            }
        }
        if (cycle_found) {
            var msg = std.ArrayList(u8).initCapacity(allocator, 128) catch unreachable;
            msg.appendSlice(allocator, "std/store: store cascade cycle: ") catch unreachable;
            for (path.items, 0..) |e, ei| {
                if (ei == 0) {
                    msg.appendSlice(allocator, e.from) catch unreachable;
                    msg.appendSlice(allocator, ".") catch unreachable;
                    msg.appendSlice(allocator, e.from_field) catch unreachable;
                }
                msg.appendSlice(allocator, " -> ") catch unreachable;
                msg.appendSlice(allocator, e.to) catch unreachable;
                msg.appendSlice(allocator, ".") catch unreachable;
                msg.appendSlice(allocator, e.to_field) catch unreachable;
            }
            msg.appendSlice(allocator, " - interceptor contracts must be acyclic; a convergent self-write needs @converges (unbuilt, queue (d))") catch unreachable;
            return .{ .transformed = .{ .replacement = H.errItem(allocator, flow.location, flow.module, "{s}", .{msg.items}) } };
        }
    }

    // CAPACITY selects the shape (690_050 ruling). Two store shapes:
    //   capacity 1 (default)  — reactive VALUE: always present, direct
    //                           `store.field` access, stored/watch.
    //   capacity > 1          — reactive CONTAINER: rows, grows from empty,
    //                           insert/query/take, `store[r].field` access.
    // Initialization is ORTHOGONAL: a seeded field (`hp: 100[i64]`) means
    // only "this column has a default value" — legal at any capacity, never
    // the shape selector. A bare field (`hp: i64`) zero-defaults at
    // capacity 1. (O10: capacity is fixed static memory declared at create;
    // exhaustion is the insert's `| full` branch, 690_011.)
    var cap_buf: usize = 1;
    for (invocation.args) |a| {
        if (std.mem.eql(u8, a.name, "capacity")) {
            cap_buf = std.fmt.parseInt(usize, std.mem.trim(u8, a.value, " "), 10) catch {
                return .{ .transformed = .{ .replacement = H.errItem(allocator, flow.location, flow.module, "std/store:new({s}): capacity must be an integer literal (got '{s}')", .{ store_name, a.value }) } };
            };
            if (cap_buf == 0) {
                return .{ .transformed = .{ .replacement = H.errItem(allocator, flow.location, flow.module, "std/store:new({s}): capacity must be >= 1 (capacity 1 is the reactive value shape; capacity > 1 is the container shape)", .{store_name}) } };
            }
        }
    }
    const CAP: usize = cap_buf;
    const is_plural = CAP > 1;

    // [tree] sits on the container substrate — a capacity-1 value has no
    // rows to arrange into a forest.
    if (is_tree and !is_plural) {
        return .{ .transformed = .{ .replacement = H.errItem(allocator, flow.location, flow.module, "std/store:new({s}): [tree] needs a container store - declare a capacity (`capacity: N`, N > 1); a capacity-1 value has no rows to arrange", .{store_name}) } };
    }

    // TT1: the synthesized `parent` column is INVISIBLE — the user's seed
    // block declares only user fields; the tree annotation appends `parent`
    // (i64 self-FK, -1 = root) after them. `user_field_count` bounds the
    // insert surface: inserts never name `parent`.
    const user_field_count = cell_fields.len;
    const synth_count: usize = if (is_tree) 1 else 0;
    const field_names = allocator.alloc([]const u8, cell_fields.len + synth_count) catch unreachable;
    const field_types = allocator.alloc([]const u8, cell_fields.len + synth_count) catch unreachable;
    // Per-column optional default (the seed): `hp: 100[i64]` carries "100",
    // `hp: i64` carries none. Orthogonal to shape (690_050).
    const field_defaults = allocator.alloc(?[]const u8, cell_fields.len + synth_count) catch unreachable;
    // char[N] (690_052, Tier A strings): a FIXED-LENGTH byte column. Non-null
    // = the declared byte length N. The SoA column is [CAP][N]u8 — static,
    // zero-alloc, NO ownership (the variable-string take/discharge tier is a
    // LATER rung). Event-level (insert input, apply branch payload, qbody
    // projection) the column travels as `string` ([]const u8); only the Zig
    // cell/row emission and the read/write text consult N.
    const field_char_caps = allocator.alloc(?usize, cell_fields.len + synth_count) catch unreachable;
    // Owned-string column (B-narrow, 690_053): the column OWNS a
    // *std/string:String — the caller's <std/string:instance!> obligation
    // moves INTO the store at insert (the synthesized insert param consumes
    // <std.string:!instance>), back OUT at take (the item payload field
    // reissues <std.string:instance!>), and teardown auto-frees still-live
    // elements via the canonical discharger (std/string:free). This rung is
    // gated to exactly that one type; any other obligation-bearing qualified
    // column is a loud later-rung wall.
    const field_owned = allocator.alloc(bool, cell_fields.len + synth_count) catch unreachable;
    // Owned-column metadata (B-narrow GENERALIZED): for an owned column
    // `*mod:Type<state!>`, the store no longer hardcodes std/string — it reads
    // the type + module + state from the column type and DISCOVERS the canonical
    // discharger (the void `<!state>`-consuming event) from the program. `String`
    // is just the first instance; `*Player<allocated!>`, `*File<open!>` are the
    // same citizen. Non-null exactly when field_owned[i] is true; disch_* are
    // filled by the canonical-discharger search below.
    const OwnedCol = struct {
        type_name: []const u8, // "String" / "Resource" (base type, no `*`)
        module_slash: []const u8, // "std/string" (the type's module, slash form)
        module_dot: []const u8, // "std.string" (dot form, for phantom canon)
        host_type: []const u8, // "koru_std.koru_string.String" (Zig storage cell)
        state: []const u8, // "instance" / "owned"
        disch_event: []const u8, // canonical discharger event name ("free")
        disch_param: []const u8, // its consuming param field name ("s")
        disch_host: []const u8, // "koru_std.koru_string" (discharger module host)
    };
    const field_owned_info = allocator.alloc(?OwnedCol, cell_fields.len + synth_count) catch unreachable;
    for (field_owned_info) |*oi| oi.* = null;
    // module logical name (slash or dot) -> Zig host namespace: each '.'/'/'
    // segment gets a `koru_` prefix. Mirrors codegen_utils.buildKoruModulePath /
    // continuation_codegen.buildEventPath — the ONE convention for naming any
    // module's emitted handler; the store reuses it instead of hardcoding.
    const HostPath = struct {
        fn build(alloc: std.mem.Allocator, logical: []const u8) []const u8 {
            var buf = std.ArrayList(u8).initCapacity(alloc, 32) catch unreachable;
            var first = true;
            var it = std.mem.splitAny(u8, logical, "./");
            while (it.next()) |seg| {
                if (seg.len == 0) continue;
                if (!first) buf.append(alloc, '.') catch unreachable;
                buf.appendSlice(alloc, "koru_") catch unreachable;
                buf.appendSlice(alloc, seg) catch unreachable;
                first = false;
            }
            return buf.toOwnedSlice(alloc) catch unreachable;
        }
        fn toDot(alloc: std.mem.Allocator, logical: []const u8) []const u8 {
            const out = alloc.dupe(u8, logical) catch unreachable;
            for (out) |*c| {
                if (c.* == '/') c.* = '.';
            }
            return out;
        }
    };
    for (cell_fields, 0..) |cf, i| {
        if (is_tree and std.mem.eql(u8, cf.name, "parent")) {
            return .{ .transformed = .{ .replacement = H.errItem(allocator, flow.location, flow.module, "std/store:new({s}): [tree] synthesizes the `parent` column itself (TT1, invisible) - drop the explicit `parent` declaration", .{store_name}) } };
        }
        const peeled = struct_literal.peelBaseType(cf.value);
        const has_default = peeled.type.len != 0;
        const ftype = if (has_default) peeled.type else std.mem.trim(u8, cf.value, " ");
        // `label: char[16]` — the bracket size is the buffer length.
        var char_cap: ?usize = null;
        if (std.mem.startsWith(u8, ftype, "char[") and ftype.len > "char[".len and ftype[ftype.len - 1] == ']') {
            const digits = std.mem.trim(u8, ftype["char[".len .. ftype.len - 1], " ");
            const n = std.fmt.parseInt(usize, digits, 10) catch {
                return .{ .transformed = .{ .replacement = H.errItem(allocator, flow.location, flow.module, "std/store:new({s}): field '{s}': char[N] needs an integer byte length (got '{s}')", .{ store_name, cf.name, ftype }) } };
            };
            if (n == 0) {
                return .{ .transformed = .{ .replacement = H.errItem(allocator, flow.location, flow.module, "std/store:new({s}): field '{s}': char[N] needs N >= 1 - a zero-length fixed-char column holds nothing", .{ store_name, cf.name }) } };
            }
            if (!is_plural) {
                return .{ .transformed = .{ .replacement = H.errItem(allocator, flow.location, flow.module, "std/store:new({s}): field '{s}' is char[{d}] - fixed-char columns live on the container shape (declare `capacity: N`, N > 1); the capacity-1 value tier is scalar-only this rung", .{ store_name, cf.name, n }) } };
            }
            char_cap = n;
        }
        // Owned column (B-narrow GENERALIZED): `*mod:Type<state!>` — the store
        // owns an obligation-bearing value of ANY type and discharges it through
        // that type's own canonical discharger. Parse the type/module/state here;
        // the single-canonical-discharger check happens below. Any pointer- or
        // phantom-carrying column that isn't a well-formed `*mod:Type<state!>` is
        // a loud wall — never a silent scalar fallback.
        var owned_col = false;
        var owned_info: ?OwnedCol = null;
        if (std.mem.startsWith(u8, ftype, "*") or std.mem.indexOfScalar(u8, ftype, '<') != null) {
            if (!std.mem.startsWith(u8, ftype, "*") or std.mem.indexOfScalar(u8, ftype, '<') == null or ftype[ftype.len - 1] != '>') {
                return .{ .transformed = .{ .replacement = H.errItem(allocator, flow.location, flow.module, "std/store:new({s}): field '{s}' is {s} - an owned column must be a well-formed `*mod:Type<state!>` (pointer, module-qualified type, held obligation)", .{ store_name, cf.name, ftype }) } };
            }
            const lt = std.mem.indexOfScalar(u8, ftype, '<').?;
            const type_part = std.mem.trim(u8, ftype[1..lt], " "); // "mod:Type"
            var phantom_part = std.mem.trim(u8, ftype[lt + 1 .. ftype.len - 1], " "); // "mod:state!" | "state!"
            const tcolon = std.mem.lastIndexOfScalar(u8, type_part, ':');
            if (tcolon == null) {
                return .{ .transformed = .{ .replacement = H.errItem(allocator, flow.location, flow.module, "std/store:new({s}): field '{s}' is {s} - an owned column type must be module-qualified `*mod:Type<state!>` so the store can locate its discharger", .{ store_name, cf.name, ftype }) } };
            }
            const module_slash = type_part[0..tcolon.?];
            const type_name = type_part[tcolon.? + 1 ..];
            if (phantom_part.len == 0 or phantom_part[phantom_part.len - 1] != '!') {
                return .{ .transformed = .{ .replacement = H.errItem(allocator, flow.location, flow.module, "std/store:new({s}): field '{s}' is {s} - an owned column must hold a live obligation `<state!>` (a bare `<state>` borrow is not owned; 330_067/069)", .{ store_name, cf.name, ftype }) } };
            }
            phantom_part = phantom_part[0 .. phantom_part.len - 1]; // strip trailing '!'
            const state = if (std.mem.lastIndexOfScalar(u8, phantom_part, ':')) |pc| phantom_part[pc + 1 ..] else phantom_part;
            if (!is_plural) {
                return .{ .transformed = .{ .replacement = H.errItem(allocator, flow.location, flow.module, "std/store:new({s}): field '{s}' is an owned column - owned columns live on the container shape (declare `capacity: N`, N > 1); the capacity-1 value tier is scalar-only this rung", .{ store_name, cf.name }) } };
            }
            owned_col = true;
            owned_info = OwnedCol{
                .type_name = allocator.dupe(u8, type_name) catch unreachable,
                .module_slash = allocator.dupe(u8, module_slash) catch unreachable,
                .module_dot = HostPath.toDot(allocator, module_slash),
                .host_type = std.fmt.allocPrint(allocator, "{s}.{s}", .{ HostPath.build(allocator, module_slash), type_name }) catch unreachable,
                .state = allocator.dupe(u8, state) catch unreachable,
                .disch_event = "",
                .disch_param = "",
                .disch_host = "",
            };
        }
        // Scalar widening (690_020 tier 1): i64/i32/f64/f32 columns — the
        // kernel:shape f64 precedent (390_001) applied to the store cell.
        // Containers (690_049) and values (690_021) share the scalar tier;
        // a container carries per-field typed SoA columns.
        const known_scalar = std.mem.eql(u8, ftype, "i64") or std.mem.eql(u8, ftype, "i32") or
            std.mem.eql(u8, ftype, "f64") or std.mem.eql(u8, ftype, "f32");
        if (!known_scalar and char_cap == null and !owned_col) {
            return .{ .transformed = .{ .replacement = H.errItem(allocator, flow.location, flow.module, "std/store:new({s}): field '{s}' is {s} — columns are scalars (i64/i32/f64/f32), fixed-char (char[N], 690_052), or owned strings (*std/string:String<std/string:instance!>, 690_053); vec/mat tiers are pinned at 690_020", .{ store_name, cf.name, ftype }) } };
        }
        field_names[i] = cf.name;
        field_types[i] = if (char_cap != null)
            allocator.dupe(u8, "string") catch unreachable
        else if (owned_info) |oi|
            std.fmt.allocPrint(allocator, "*{s}", .{oi.type_name}) catch unreachable
        else
            ftype;
        field_char_caps[i] = char_cap;
        field_owned[i] = owned_col;
        field_owned_info[i] = owned_info;
        field_defaults[i] = if (has_default) peeled.value else null;
    }
    if (is_tree) {
        field_names[user_field_count] = allocator.dupe(u8, "parent") catch unreachable;
        field_types[user_field_count] = allocator.dupe(u8, "i64") catch unreachable;
        field_char_caps[user_field_count] = null;
        field_owned[user_field_count] = false;
        field_owned_info[user_field_count] = null;
        field_defaults[user_field_count] = null;
    }
    var has_owned = false;
    for (field_owned) |fo| {
        if (fo) has_owned = true;
    }
    // DRAIN rung (690_057/058): an owned column whose type has MORE THAN ONE
    // void `<!state>` discharger (commit|rollback) is AMBIGUOUS — the store
    // cannot pick. The column stays owned (insert still consumes the caller's
    // obligation into the store), but teardown fires a USER-provided
    // `! discharge item |> ...` effect branch bolted onto the store
    // declaration instead of a discovered canonical discharger. The store is
    // static (program-lifetime), so its discharger is declared statically AT
    // the store. drain_required marks the store; the ambig_* capture feeds
    // the teaching error when the `! discharge` branch is missing.
    var drain_required = false;
    var ambig_module: []const u8 = "";
    var ambig_type: []const u8 = "";
    var ambig_state: []const u8 = "";
    var ambig_count: usize = 0;
    if (has_owned) {
        // One obligation surface per store this rung: [entity] mints
        // <std/store:taken!> on the whole row; an owned column reissues
        // <std.string:instance!> on a field. Composing both is a later rung.
        if (entity_type != null) {
            return .{ .transformed = .{ .replacement = H.errItem(allocator, flow.location, flow.module, "std/store:new({s}): [entity(...)] with an owned-string column - one obligation surface per store this rung (the row's <taken!> and the field's <instance!> compose at a later rung)", .{store_name}) } };
        }
        if (is_tree) {
            return .{ .transformed = .{ .replacement = H.errItem(allocator, flow.location, flow.module, "std/store:new({s}): [tree] with an owned-string column is a later rung", .{store_name}) } };
        }
        for (field_char_caps) |cc| {
            if (cc != null) {
                return .{ .transformed = .{ .replacement = H.errItem(allocator, flow.location, flow.module, "std/store:new({s}): fixed-char (char[N]) and owned-string columns in one store are a later rung", .{store_name}) } };
            }
        }
        // The canonical-discharge wall (690_035, at the column boundary),
        // GENERALIZED past std/string: for EACH owned column type the program
        // must expose EXACTLY ONE void terminal discharger consuming <!state>
        // on *Type — e.g. std/string:free for *String<!instance>, or `free`/
        // `close` for a user *Resource<!owned>. Zero -> the module isn't in
        // scope; several -> ambiguous (commit|rollback), which needs a drain/
        // pick surface this rung does not build. The discharger's identity
        // (event + consuming param + host namespace) is captured for codegen.
        for (field_owned_info, 0..) |maybe_oi, oi_idx| {
            var oi = maybe_oi orelse continue;
            const want_type = std.fmt.allocPrint(allocator, "*{s}", .{oi.type_name}) catch unreachable;
            const want_consume = std.fmt.allocPrint(allocator, "!{s}", .{oi.state}) catch unreachable;
            var discharger_count: usize = 0;
            var saw_module = false;
            var found_event: []const u8 = "";
            var found_param: []const u8 = "";
            for (program.items) |pi| {
                if (pi != .module_decl) continue;
                const md = &pi.module_decl;
                if (!std.mem.eql(u8, md.logical_name, oi.module_dot) and !std.mem.eql(u8, md.logical_name, oi.module_slash)) continue;
                saw_module = true;
                for (md.items) |mi| {
                    if (mi != .event_decl) continue;
                    const ed = &mi.event_decl;
                    // Auto-discharge inserts VOID events only (KORU083 rule):
                    // any output (branch or bare return) disqualifies.
                    if (ed.branches.len > 0 or ed.return_type != null) continue;
                    for (ed.input.fields) |f| {
                        if (!std.mem.eql(u8, f.type, want_type)) continue;
                        const ph = f.phantom orelse continue;
                        // Union members split on '|'; a consuming member is `!state`.
                        var members = std.mem.splitScalar(u8, ph, '|');
                        while (members.next()) |m| {
                            if (std.mem.eql(u8, std.mem.trim(u8, m, " "), want_consume)) {
                                discharger_count += 1;
                                // Event name = path segments joined by '_' (the
                                // `<name>_event.handler` codegen convention).
                                var nb = std.ArrayList(u8).initCapacity(allocator, 16) catch unreachable;
                                for (ed.path.segments, 0..) |seg, si| {
                                    if (si > 0) nb.append(allocator, '_') catch unreachable;
                                    nb.appendSlice(allocator, seg) catch unreachable;
                                }
                                found_event = nb.toOwnedSlice(allocator) catch unreachable;
                                found_param = allocator.dupe(u8, f.name) catch unreachable;
                                break;
                            }
                        }
                    }
                }
            }
            if (!saw_module) {
                return .{ .transformed = .{ .replacement = H.errItem(allocator, flow.location, flow.module, "std/store:new({s}): an owned column of *{s}:{s} needs module {s} in scope - add `import {s}`", .{ store_name, oi.module_slash, oi.type_name, oi.module_slash, oi.module_slash }) } };
            }
            if (discharger_count == 0) {
                return .{ .transformed = .{ .replacement = H.errItem(allocator, flow.location, flow.module, "std/store:new({s}): column type *{s}:{s} has no terminal discharge candidate for <!{s}> - declare a void event in {s} consuming `*{s}<!{s}>` (the canonical discharger)", .{ store_name, oi.module_slash, oi.type_name, oi.state, oi.module_slash, oi.type_name, oi.state }) } };
            }
            if (discharger_count > 1) {
                // AMBIGUOUS: >1 dischargers (commit|rollback) — mark the store
                // drain-required and leave disch_* empty as the per-column
                // ambiguity marker. The `! discharge` branch is collected off
                // the store declaration below; teardown fires it per live
                // element instead of a discovered discharger.
                drain_required = true;
                ambig_module = oi.module_slash;
                ambig_type = oi.type_name;
                ambig_state = oi.state;
                ambig_count = discharger_count;
                continue;
            }
            oi.disch_event = found_event;
            oi.disch_param = found_param;
            oi.disch_host = HostPath.build(allocator, oi.module_slash);
            field_owned_info[oi_idx] = oi;
            // RETAIN the discovered discharger (its event_decl AND matching
            // proc_decl) so dead-strip preserves them. The teardown calls the
            // discharger from RAW HOST CODE (`<host>.<name>_event.handler`,
            // ~line 2441) — invisible to dead-strip's invocation scan. Without
            // this, an insert-then-query-only owned store (no user `take`-back
            // invoking the discharger) strips `free`/`close`, and the teardown
            // call dangles at a nonexistent `<mod>.<name>_event` (690_060). Same
            // @retain mechanism runtime.kz uses for registered events: mutate the
            // carried-forward program nodes in place (by pointer, not the
            // by-value discovery copies above).
            for (program.items) |*pi_c| {
                if (pi_c.* != .module_decl) continue;
                const md_m = &@constCast(pi_c).module_decl;
                if (!std.mem.eql(u8, md_m.logical_name, oi.module_dot) and !std.mem.eql(u8, md_m.logical_name, oi.module_slash)) continue;
                for (md_m.items) |*mi_c| {
                    const mi_m = @constCast(mi_c);
                    var segs: []const []const u8 = undefined;
                    switch (mi_m.*) {
                        .event_decl => |*e| segs = e.path.segments,
                        .proc_decl => |*p| segs = p.path.segments,
                        else => continue,
                    }
                    var jb = std.ArrayList(u8).initCapacity(allocator, 16) catch unreachable;
                    for (segs, 0..) |seg, si| {
                        if (si > 0) jb.append(allocator, '_') catch unreachable;
                        jb.appendSlice(allocator, seg) catch unreachable;
                    }
                    if (!std.mem.eql(u8, jb.items, oi.disch_event)) continue;
                    switch (mi_m.*) {
                        .event_decl => |*e| {
                            const na = allocator.alloc([]const u8, e.annotations.len + 1) catch unreachable;
                            @memcpy(na[0..e.annotations.len], e.annotations);
                            na[e.annotations.len] = "retain";
                            e.annotations = na;
                        },
                        .proc_decl => |*p| {
                            const na = allocator.alloc([]const u8, p.annotations.len + 1) catch unreachable;
                            @memcpy(na[0..p.annotations.len], p.annotations);
                            na[p.annotations.len] = "retain";
                            p.annotations = na;
                        },
                        else => {},
                    }
                }
            }
        }
        if (drain_required) {
            // One teardown surface per store this rung: the drain payload
            // carries the row's obligations for the user handler, while a
            // canonical column would ALSO auto-fire its discovered discharger
            // in the same loop — a double-discharge composition question.
            // Loud wall, later rung.
            for (field_owned_info) |maybe_oi| {
                const oi = maybe_oi orelse continue;
                if (oi.disch_event.len != 0) {
                    return .{ .transformed = .{ .replacement = H.errItem(allocator, flow.location, flow.module, "std/store:new({s}): mixing a canonical owned column (*{s}:{s}) with an ambiguous one (*{s}:{s}) in one store is a later rung - the drain's `! discharge` payload and auto-discharge compose there", .{ store_name, oi.module_slash, oi.type_name, ambig_module, ambig_type }) } };
                }
            }
        }
    }
    // The SINGLETON write plumbing carries ONE value type; a mixed-type
    // capacity-1 value is the per-field-event slice (690_020 tier 1
    // boundary). Containers carry per-field typed slots instead (690_049).
    if (!is_plural) {
        for (field_types[1..]) |ft| {
            if (!std.mem.eql(u8, ft, field_types[0])) {
                return .{ .transformed = .{ .replacement = H.errItem(allocator, flow.location, flow.module, "std/store:new({s}): mixed column types in one store are a later slice - all fields must share one scalar type for now", .{store_name}) } };
            }
        }
    }
    // Do the container's columns share one scalar type? The plural
    // `updated { old, new }` delta carries the written field's images in ONE
    // event (690_038), so its bind form needs a uniform column type this
    // rung; everything else is per-field typed and doesn't care.
    const types_uniform: bool = blk: {
        if (field_types.len == 0) break :blk true;
        for (field_types[1..]) |ft| {
            if (!std.mem.eql(u8, ft, field_types[0])) break :blk false;
        }
        break :blk true;
    };
    // value_type feeds the singleton (capacity-1) plumbing only.
    const value_type: []const u8 = if (cell_fields.len > 0 and !is_plural) field_types[0] else "i64";

    // ------------------------------------------------------------------
    // PLURAL STORE (rung two) — a separate coordinator path. Generates:
    //   1. The SoA cell: one column array per field + len.
    //   2. `__store_insert_<s>`  (void) and `__store_inserth_<s>`
    //      (`| row i64` handle branch) event+proc pairs. The proc appends
    //      the row, then fires standing query enters — but ONLY for query
    //      sites ABOVE the insert site in source (`__site_line` is a
    //      comptime-constant arg; the position check compiles away).
    //   3. Per query site (keyed by source line, so transform order can
    //      never skew numbering):
    //        `__store_qrow_<s>_L<n>`   — guard + projection over one row,
    //                                    calls the body event on match.
    //        `__store_qbody_<s>_L<n>`  — the transplanted body as an impl
    //                                    flow; projected names + __koru_qrow
    //                                    arrive as event inputs.
    //        `__store_qsweep_<s>_L<n>` — the imperative sweep over existing
    //                                    rows ((l) lean: the sweep IS the
    //                                    query's program-position firing).
    //   4. The row-addressed apply/write pair — same (f) centralizing
    //      subflow as rung one, plus `row`; watch bodies splice here, and
    //      UPDATE WHERE (`stored { entity.f: ... }` under a query branch)
    //      compiles into calls to it.
    //   5. `__store_take_<s>` — swap-remove through the handle head,
    //      returning `| item { fields }` (obligation wiring: 690_007).
    // ------------------------------------------------------------------
    if (is_plural) {
        // CAP is the declared capacity (parsed above — it IS the shape
        // selector). Fixed static memory with a LOUD overflow panic;
        // inserts that want graceful exhaustion handle `| full`.

        // ---- collect lifecycle interceptors (690_016, 690_038) ----
        // Ruling 5: stores emit inserted/removed/updated. The plural slice
        // wires `inserted` (fires in the insert write path), `removed`
        // (fires in take), and `updated` (fires in the row write path with
        // the written field's { old, new } images — the (c) usage-synthesis
        // lean, singleton grammar of 690_003). Each interceptor body is
        // transplanted as an impl flow — the qbody pattern — so its bindings
        // arrive as event inputs and a nested `stored { other.f: ... }`
        // resolves the sibling store's write. Field-named interceptors on
        // plural rows stay a later slice.
        const LifecycleArm = struct {
            fields: []const []const u8,
            body: ast.Continuation,
        };
        var inserted_arms = std.ArrayList(LifecycleArm).initCapacity(allocator, 2) catch unreachable;
        var removed_arms = std.ArrayList(LifecycleArm).initCapacity(allocator, 2) catch unreachable;
        var updated_arms = std.ArrayList(LifecycleArm).initCapacity(allocator, 2) catch unreachable;
        // The drain handler (690_057): `! discharge item |> ...` on the store
        // declaration. Collected as a WHOLE continuation and re-attached to
        // the synthesized teardown flow (the 400_105 effect-branch shape) —
        // the handler binds the row record, whose ambiguous owned fields
        // carry `<state!>`, so the phantom checker forces the body to
        // discharge each element. Exactly one per store.
        var discharge_arm: ?ast.Continuation = null;
        // KORU100 for interceptor payloads: a bound row field must be USED in
        // the body (or discarded with `_`). flow_checker's unused-binding pass
        // skips `[transform]` invocations, and `std/store:new` is one, so the
        // store transform enforces it here — scanning the body's expression /
        // source text for the field name at a word boundary.
        const Usage = struct {
            fn inText(text: []const u8, name: []const u8) bool {
                if (name.len == 0) return false;
                var i: usize = 0;
                while (i + name.len <= text.len) : (i += 1) {
                    if (!std.mem.eql(u8, text[i .. i + name.len], name)) continue;
                    const before_ok = i == 0 or !H.isIdentChar(text[i - 1]);
                    const after_ok = i + name.len == text.len or !H.isIdentChar(text[i + name.len]);
                    if (before_ok and after_ok) return true;
                }
                return false;
            }
            fn inCont(cont: *const ast.Continuation, name: []const u8) bool {
                if (cont.condition) |c| {
                    if (inText(c, name)) return true;
                }
                if (cont.node) |n| {
                    if (n == .invocation) {
                        for (n.invocation.args) |a| {
                            if (inText(a.value, name)) return true;
                            if (a.expression_value) |ev| {
                                if (inText(ev.text, name)) return true;
                            }
                            if (a.source_value) |sv| {
                                if (inText(sv.text, name)) return true;
                            }
                        }
                    }
                }
                for (cont.continuations) |*c| {
                    if (inCont(c, name)) return true;
                }
                return false;
            }
        };
        for (flow.body.continuations) |*ic| {
            const bname = std.mem.trim(u8, ic.branch, " ");
            if (ic.condition != null) {
                return .{ .transformed = .{ .replacement = H.errItem(allocator, flow.location, flow.module, "std/store:new({s}): guarded interceptors are a later slice - interceptors are the store's unconditional contract", .{store_name}) } };
            }
            if (std.mem.eql(u8, bname, "discharge")) {
                if (!drain_required) {
                    return .{ .transformed = .{ .replacement = H.errItem(allocator, flow.location, flow.module, "std/store:new({s}): `! discharge` applies only to a store with an AMBIGUOUS owned column (>1 dischargers) - this store's owned columns have canonical dischargers and auto-discharge at teardown", .{store_name}) } };
                }
                if (discharge_arm != null) {
                    return .{ .transformed = .{ .replacement = H.errItem(allocator, flow.location, flow.module, "std/store:new({s}): one `! discharge` handler per store - the teardown fires ONE handler per live element", .{store_name}) } };
                }
                if (ic.binding == null or ic.destructure.len != 0) {
                    return .{ .transformed = .{ .replacement = H.errItem(allocator, flow.location, flow.module, "std/store:new({s}): `! discharge` binds the whole row record - spell it `! discharge item |> ...(item.<field>)`", .{store_name}) } };
                }
                if (ic.node == null) {
                    return .{ .transformed = .{ .replacement = H.errItem(allocator, flow.location, flow.module, "std/store:new({s}): the `! discharge` handler needs a body that discharges the row's obligations (e.g. `! discharge item |> {s}:commit(item.<field>)`)", .{ store_name, ambig_module }) } };
                }
                discharge_arm = ast_functional.cloneContinuation(allocator, ic) catch unreachable;
                continue;
            }
            const is_inserted = std.mem.eql(u8, bname, "inserted");
            const is_removed = std.mem.eql(u8, bname, "removed");
            const is_updated = std.mem.eql(u8, bname, "updated");
            if (!is_inserted and !is_removed and !is_updated) {
                return .{ .transformed = .{ .replacement = H.errItem(allocator, flow.location, flow.module, "std/store:new({s}): plural interceptor branch '{s}' - the lifecycle slice wires `inserted`, `removed`, and `updated`; field interceptors on plural rows are a later slice", .{ store_name, bname }) } };
            }
            if (is_updated) {
                // `updated` carries the write contract — the written field's
                // { old, new } images ((c) usage-synthesis lean, mirroring the
                // singleton grammar of 690_003) — never row fields. The `_`
                // discard form is legal like the other lifecycle arms; a
                // discard arm synthesizes NO pre-image read (write-only path).
                const is_discard = ic.destructure.len == 0;
                if (!is_discard) {
                    var has_old = false;
                    var has_new = false;
                    for (ic.destructure) |df| {
                        if (std.mem.eql(u8, df.name, "old")) has_old = true;
                        if (std.mem.eql(u8, df.name, "new")) has_new = true;
                    }
                    if (!has_old or !has_new or ic.destructure.len != 2) {
                        return .{ .transformed = .{ .replacement = H.errItem(allocator, flow.location, flow.module, "std/store:new({s}): `! updated` binds the written field's images — destructure exactly {{ old, new }} (row fields ride `inserted`/`removed`)", .{store_name}) } };
                    }
                    if (!types_uniform) {
                        return .{ .transformed = .{ .replacement = H.errItem(allocator, flow.location, flow.module, "std/store:new({s}): `! updated {{ old, new }}` carries ONE written-field image type, but this store mixes column types - per-field updated deltas are a later rung; the discard form (`! updated _`) stays legal", .{store_name}) } };
                    }
                }
                const ubnode = ic.node orelse {
                    return .{ .transformed = .{ .replacement = H.errItem(allocator, flow.location, flow.module, "std/store:new({s}): the `! updated` interceptor needs a body (`|> std/store:stored {{ ... }}`)", .{store_name}) } };
                };
                if (ubnode != .invocation) {
                    return .{ .transformed = .{ .replacement = H.errItem(allocator, flow.location, flow.module, "std/store:new({s}): the `! updated` interceptor body must start with an invocation this rung", .{store_name}) } };
                }
                var unames = std.ArrayList([]const u8).initCapacity(allocator, 2) catch unreachable;
                if (!is_discard) {
                    unames.append(allocator, allocator.dupe(u8, "old") catch unreachable) catch unreachable;
                    unames.append(allocator, allocator.dupe(u8, "new") catch unreachable) catch unreachable;
                }
                updated_arms.append(allocator, .{
                    .fields = unames.toOwnedSlice(allocator) catch unreachable,
                    .body = ast_functional.cloneContinuation(allocator, ic) catch unreachable,
                }) catch unreachable;
                continue;
            }
            var dnames = std.ArrayList([]const u8).initCapacity(allocator, ic.destructure.len) catch unreachable;
            for (ic.destructure) |df| {
                if (df.type_text != null) {
                    return .{ .transformed = .{ .replacement = H.errItem(allocator, flow.location, flow.module, "std/store:new({s}): `! {s}` projects row fields by pun (`{{ {s} }}`); renames are a later slice", .{ store_name, bname, df.name }) } };
                }
                const known = blk: {
                    for (field_names) |fn3| {
                        if (std.mem.eql(u8, fn3, df.name)) break :blk true;
                    }
                    break :blk false;
                };
                if (!known) {
                    return .{ .transformed = .{ .replacement = H.errItem(allocator, flow.location, flow.module, "std/store:new({s}): `! {s}` payload field '{s}' is not a field of store '{s}'", .{ store_name, bname, df.name, store_name }) } };
                }
                dnames.append(allocator, allocator.dupe(u8, df.name) catch unreachable) catch unreachable;
            }
            const bnode = ic.node orelse {
                return .{ .transformed = .{ .replacement = H.errItem(allocator, flow.location, flow.module, "std/store:new({s}): the `! {s}` interceptor needs a body (`|> std/store:stored {{ ... }}`)", .{ store_name, bname }) } };
            };
            if (bnode != .invocation) {
                return .{ .transformed = .{ .replacement = H.errItem(allocator, flow.location, flow.module, "std/store:new({s}): the `! {s}` interceptor body must start with an invocation this rung", .{ store_name, bname }) } };
            }
            for (dnames.items) |fnm| {
                if (!Usage.inCont(ic, fnm)) {
                    return .{ .transformed = .{ .replacement = H.errItem(allocator, flow.location, flow.module, "std/store:new({s}): `! {s}` binds '{s}' but never uses it — discard the payload (`! {s} _`), or use the field in the body", .{ store_name, bname, fnm, bname }) } };
                }
            }
            const arm = LifecycleArm{
                .fields = dnames.toOwnedSlice(allocator) catch unreachable,
                .body = ast_functional.cloneContinuation(allocator, ic) catch unreachable,
            };
            if (is_inserted) {
                inserted_arms.append(allocator, arm) catch unreachable;
            } else {
                removed_arms.append(allocator, arm) catch unreachable;
            }
        }
        // Drain ENFORCEMENT (690_058): an ambiguous owned column with no
        // `! discharge` handler would leave still-live elements undischarged
        // at teardown — a silent leak. Refusing the declaration here keeps
        // the store's units unsynthesized, so any insert's obligation leaks
        // and the natural checker fires too (KORU030 "multiple discharge
        // options", which surfaces first when inserts exist); with no
        // inserts, THIS teaching error is the one the user sees.
        if (drain_required and discharge_arm == null) {
            return .{ .transformed = .{ .replacement = H.errItem(allocator, flow.location, flow.module, "std/store:new({s}): column *{s}:{s} has {d} dischargers for <!{s}> (ambiguous) - the store cannot pick one, so it must be DRAINED: bolt a `! discharge item |> ...` handler onto the store declaration to discharge each still-live element at teardown", .{ store_name, ambig_module, ambig_type, ambig_count, ambig_state }) } };
        }

        // ---- collect this store's watch arms (field-granular, plural) ----
        const WatchArmP = struct {
            field_idx: usize,
            cont: ast.Continuation,
        };
        var pwatch_arms = std.ArrayList(WatchArmP).initCapacity(allocator, 4) catch unreachable;
        for (program.items) |pi| {
            if (pi != .flow) continue;
            const wf = &pi.flow;
            if (!H.isStoreInv(wf, "watch", store_name)) continue;
            for (wf.body.continuations) |*wc| {
                const fidx: usize = blk: {
                    for (field_names, 0..) |fname, i| {
                        if (std.mem.eql(u8, std.mem.trim(u8, wc.branch, " "), fname)) break :blk i;
                    }
                    return .{ .transformed = .{ .replacement = H.errItem(allocator, wf.location, wf.module, "std/store:watch({s}): '{s}' is not a field of store '{s}'", .{ store_name, wc.branch, store_name }) } };
                };
                for (pwatch_arms.items) |existing| {
                    if (existing.field_idx == fidx) {
                        return .{ .transformed = .{ .replacement = H.errItem(allocator, wf.location, wf.module, "std/store:watch({s}): field '{s}' is watched more than once - multi-watch sequencing is pinned at 690_010", .{ store_name, wc.branch }) } };
                    }
                }
                // A `when` guard fuses into the write path as an arm condition
                // (producer owns the `if`) — the cloned continuation carries it
                // through to the apply/write flow's arm, and storeRefsContH
                // rewrites any cross-store guard reads to the cells (690_030,
                // the plural mirror of the singleton guarded reactive 690_026).
                const cloned = ast_functional.cloneContinuation(allocator, wc) catch unreachable;
                pwatch_arms.append(allocator, .{ .field_idx = fidx, .cont = cloned }) catch unreachable;
            }
        }

        // ---- collect this store's query sites (keyed by source line) ----
        const QuerySite = struct {
            line: usize,
            // projection: parallel arrays — bound name / store field index
            proj_names: [][]const u8,
            proj_fields: []usize,
            guard: ?[]const u8,
            body: ast.Continuation,
            // [name(x)] / [depends_on(a, b)] on the attach flow — the stripe
            // scheduler's vocabulary. Names are module-namespaced (bare binds
            // in the declaring module; cross-module references qualify as
            // mod:name — the phantom-state mirror, 330_087/088).
            rule_name: ?[]const u8,
            deps: [][]const u8,
            rule_module: []const u8,
            // `preorder` sites ride the same qrow/qbody machinery as `query`
            // (695_STORE_TREE TT5); only the sweep differs — a DFS pre-order
            // walk over the synthesized parent column instead of the linear
            // row scan. Preorder is a program-position walk: it takes no
            // standing insert subscription and joins no stripe.
            is_preorder: bool,
        };
        var qsites = std.ArrayList(QuerySite).initCapacity(allocator, 4) catch unreachable;
        for (program.items) |pi| {
            if (pi != .flow) continue;
            const qf = &pi.flow;
            const q_verb: []const u8 = if (H.isStoreInv(qf, "query", store_name))
                "query"
            else if (H.isStoreInv(qf, "preorder", store_name))
                "preorder"
            else
                continue;
            const q_is_preorder = std.mem.eql(u8, q_verb, "preorder");
            if (q_is_preorder and !is_tree) {
                return .{ .transformed = .{ .replacement = H.errItem(allocator, qf.location, qf.module, "std/store:preorder({s}): preorder needs a [tree] store - '{s}' has no synthesized parent column (declare it as [tree]std/store:new({s}) {{ ... }})", .{ store_name, store_name, store_name }) } };
            }
            if (qf.body.continuations.len != 1) {
                return .{ .transformed = .{ .replacement = H.errItem(allocator, qf.location, qf.module, "std/store:{s}({s}): exactly one `! {s} {{ ... }}` branch per site this rung", .{ q_verb, store_name, q_verb }) } };
            }
            const qc = &qf.body.continuations[0];
            if (!std.mem.eql(u8, std.mem.trim(u8, qc.branch, " "), q_verb)) {
                return .{ .transformed = .{ .replacement = H.errItem(allocator, qf.location, qf.module, "std/store:{s}({s}): branch '{s}' - the row branch is spelled `! {s} {{ projection }}` (O1 fire-vocabulary is open)", .{ q_verb, store_name, qc.branch, q_verb }) } };
            }
            if (qc.destructure.len == 0) {
                return .{ .transformed = .{ .replacement = H.errItem(allocator, qf.location, qf.module, "std/store:{s}({s}): the {s} branch needs a projection block: `! {s} {{ entity.field, name: entity.field }}`", .{ q_verb, store_name, q_verb, q_verb }) } };
            }
            var pnames = std.ArrayList([]const u8).initCapacity(allocator, qc.destructure.len) catch unreachable;
            var pfields = std.ArrayList(usize).initCapacity(allocator, qc.destructure.len) catch unreachable;
            for (qc.destructure) |df| {
                // Two projection shapes (ruling 6 + O2):
                //   `entity.hp`              — pun: binds `hp`
                //   `enemy_kind: entity.kind` — genuine rename
                // A redundant label (`kind: entity.kind`) violates mandatory
                // punning and is rejected.
                var bound: []const u8 = undefined;
                var path: []const u8 = undefined;
                if (df.type_text) |tt| {
                    bound = df.name;
                    path = tt;
                } else {
                    path = df.name;
                    const last_dot = std.mem.lastIndexOfScalar(u8, df.name, '.') orelse {
                        return .{ .transformed = .{ .replacement = H.errItem(allocator, qf.location, qf.module, "std/store:{s}({s}): projection entry '{s}' is not a path - project store fields as `entity.<field>`", .{ q_verb, store_name, df.name }) } };
                    };
                    bound = df.name[last_dot + 1 ..];
                }
                if (!std.mem.startsWith(u8, path, "entity.")) {
                    return .{ .transformed = .{ .replacement = H.errItem(allocator, qf.location, qf.module, "std/store:{s}({s}): projection path '{s}' must root at `entity.` (the bound row)", .{ q_verb, store_name, path }) } };
                }
                const fname = path["entity.".len..];
                if (df.type_text != null and std.mem.eql(u8, bound, fname)) {
                    return .{ .transformed = .{ .replacement = H.errItem(allocator, qf.location, qf.module, "std/store:{s}({s}): `{s}: entity.{s}` is a redundant label - punning is mandatory; write `entity.{s}`", .{ q_verb, store_name, bound, fname, fname }) } };
                }
                const fidx: usize = blk: {
                    for (field_names, 0..) |fn2, i| {
                        if (std.mem.eql(u8, fn2, fname)) break :blk i;
                    }
                    return .{ .transformed = .{ .replacement = H.errItem(allocator, qf.location, qf.module, "std/store:{s}({s}): 'entity.{s}' - '{s}' is not a field of store '{s}'", .{ q_verb, store_name, fname, fname, store_name }) } };
                };
                pnames.append(allocator, bound) catch unreachable;
                pfields.append(allocator, fidx) catch unreachable;
            }
            const body_clone = ast_functional.cloneContinuation(allocator, qc) catch unreachable;
            // [name]/[depends_on] off the attach flow (bare idents canonical).
            const ann_parser = @import("annotation_parser");
            var q_rule_name: ?[]const u8 = null;
            if (ann_parser.getCall(allocator, qf.annotations, "name") catch null) |nc| {
                if (nc.args.len != 1) {
                    return .{ .transformed = .{ .replacement = H.errItem(allocator, qf.location, qf.module, "std/store:query({s}): [name(...)] takes exactly one identifier — [name(movement)]", .{store_name}) } };
                }
                q_rule_name = allocator.dupe(u8, nc.args[0]) catch unreachable;
            }
            var q_deps = std.ArrayList([]const u8).initCapacity(allocator, 2) catch unreachable;
            if (ann_parser.getCall(allocator, qf.annotations, "depends_on") catch null) |dc| {
                for (dc.args) |da| q_deps.append(allocator, allocator.dupe(u8, da) catch unreachable) catch unreachable;
            }
            qsites.append(allocator, .{
                .line = qf.location.line,
                .proj_names = pnames.toOwnedSlice(allocator) catch unreachable,
                .proj_fields = pfields.toOwnedSlice(allocator) catch unreachable,
                .guard = if (qc.condition) |c| allocator.dupe(u8, c) catch unreachable else null,
                .body = body_clone,
                .rule_name = q_rule_name,
                .deps = q_deps.toOwnedSlice(allocator) catch unreachable,
                .rule_module = allocator.dupe(u8, qf.module) catch unreachable,
                .is_preorder = q_is_preorder,
            }) catch unreachable;
        }

        // ---- [name]/[depends_on] rule scheduling ----
        // Topological order over the declared DAG; rules with no edges keep
        // collection order RELATIVE TO EACH OTHER but that order is
        // contractually UNSPECIFIED (the fusion license). Cycle = comptime
        // error naming the members (690_012 mirror). Resolution follows the
        // phantom-state namespacing: bare = same module, mod:name across,
        // bare-outside = teaching error (330_087/088 mirror).
        var stripe_order = std.ArrayList(usize).initCapacity(allocator, qsites.items.len) catch unreachable;
        {
            // Duplicate [name] within one module is ambiguous — reject.
            for (qsites.items, 0..) |qa, ia| {
                const na = qa.rule_name orelse continue;
                for (qsites.items[ia + 1 ..]) |qb| {
                    const nb = qb.rule_name orelse continue;
                    if (std.mem.eql(u8, na, nb) and std.mem.eql(u8, qa.rule_module, qb.rule_module)) {
                        return .{ .transformed = .{ .replacement = H.errItem(allocator, flow.location, flow.module, "std/store:query({s}): two rules named [name({s})] in module '{s}' — rule names are unique per module", .{ store_name, na, qa.rule_module }) } };
                    }
                }
            }
            // Resolve dep edges: edges[i] = indices i depends on.
            var edges = std.ArrayList([]usize).initCapacity(allocator, qsites.items.len) catch unreachable;
            for (qsites.items) |qs2| {
                var row_edges = std.ArrayList(usize).initCapacity(allocator, qs2.deps.len) catch unreachable;
                for (qs2.deps) |dep| {
                    var dep_mod: ?[]const u8 = null;
                    var dep_name: []const u8 = dep;
                    if (std.mem.lastIndexOfScalar(u8, dep, ':')) |ci| {
                        dep_mod = dep[0..ci];
                        dep_name = dep[ci + 1 ..];
                    }
                    var found: ?usize = null;
                    var foreign_hit: ?[]const u8 = null;
                    for (qsites.items, 0..) |cand, ci2| {
                        const cn = cand.rule_name orelse continue;
                        if (!std.mem.eql(u8, cn, dep_name)) continue;
                        if (dep_mod) |dm| {
                            if (std.mem.eql(u8, cand.rule_module, dm)) found = ci2;
                        } else if (std.mem.eql(u8, cand.rule_module, qs2.rule_module)) {
                            found = ci2;
                        } else {
                            foreign_hit = cand.rule_module;
                        }
                    }
                    if (found == null) {
                        if (foreign_hit) |fm| {
                            return .{ .transformed = .{ .replacement = H.errItem(allocator, flow.location, flow.module, "std/store:query({s}): depends_on({s}) — bare rule names resolve in the declaring module only; rule '{s}' lives in module '{s}', write depends_on({s}:{s})", .{ store_name, dep, dep_name, fm, fm, dep_name }) } };
                        }
                        return .{ .transformed = .{ .replacement = H.errItem(allocator, flow.location, flow.module, "std/store:query({s}): depends_on({s}) — no rule named [name({s})] on this store in module '{s}'", .{ store_name, dep, dep_name, qs2.rule_module }) } };
                    }
                    row_edges.append(allocator, found.?) catch unreachable;
                }
                edges.append(allocator, row_edges.toOwnedSlice(allocator) catch unreachable) catch unreachable;
            }
            // Kahn: stable — ready nodes fire in collection order.
            const n = qsites.items.len;
            const indeg = allocator.alloc(usize, n) catch unreachable;
            @memset(indeg, 0);
            for (0..n) |i| indeg[i] = edges.items[i].len;
            const done_mark = allocator.alloc(bool, n) catch unreachable;
            @memset(done_mark, false);
            var emitted: usize = 0;
            while (emitted < n) {
                var progressed = false;
                for (0..n) |i| {
                    if (done_mark[i] or indeg[i] != 0) continue;
                    stripe_order.append(allocator, i) catch unreachable;
                    done_mark[i] = true;
                    emitted += 1;
                    progressed = true;
                    // lower indegree of nodes that depend on i
                    for (0..n) |j| {
                        if (done_mark[j]) continue;
                        for (edges.items[j]) |e| {
                            if (e == i) indeg[j] -= 1;
                        }
                    }
                }
                if (!progressed) {
                    var cyc = std.ArrayList(u8).initCapacity(allocator, 64) catch unreachable;
                    for (0..n) |i| {
                        if (done_mark[i]) continue;
                        if (qsites.items[i].rule_name) |rn| {
                            if (cyc.items.len > 0) cyc.appendSlice(allocator, ", ") catch unreachable;
                            cyc.appendSlice(allocator, rn) catch unreachable;
                        }
                    }
                    return .{ .transformed = .{ .replacement = H.errItem(allocator, flow.location, flow.module, "std/store:query({s}): depends_on cycle among rules: {s}", .{ store_name, cyc.items }) } };
                }
            }
        }

        // ---- rewrite transplanted bodies ----
        // Query bodies execute inside the qbody handler where the projected
        // names and `__koru_qrow` are event inputs. `entity.<f>` references:
        //   - in a nested `std/store:stored` block: the TARGET rewrites to
        //     the indexed lvalue head (`<store>[__koru_qrow].<f>` — O2
        //     query-row head), the VALUE side to a direct fresh column read.
        //   - anywhere else: direct fresh column read.
        const PRewrite = struct {
            fn colRead(alloc: std.mem.Allocator, store: []const u8, field: []const u8, is_char: bool) []const u8 {
                // A char column reads as the string slice up to the first NUL
                // (the same shape the qrow projection binds); scalars read
                // their cell slot directly.
                if (is_char) {
                    return std.fmt.allocPrint(alloc, "@import(\"std\").mem.sliceTo(&__koru_store_{s}.{s}[@as(usize, @intCast(__koru_qrow))], 0)", .{ store, field }) catch unreachable;
                }
                return std.fmt.allocPrint(alloc, "__koru_store_{s}.{s}[@as(usize, @intCast(__koru_qrow))]", .{ store, field }) catch unreachable;
            }
            fn entityRefs(alloc: std.mem.Allocator, text: []const u8, store: []const u8, fields: []const []const u8, char_caps: []const ?usize, target_form: bool) []const u8 {
                var out = std.ArrayList(u8).initCapacity(alloc, text.len + 32) catch unreachable;
                var i: usize = 0;
                while (i < text.len) {
                    const at_boundary = i == 0 or !H.isIdentChar(text[i - 1]);
                    if (at_boundary and std.mem.startsWith(u8, text[i..], "entity.")) {
                        const fstart = i + "entity.".len;
                        var fend = fstart;
                        while (fend < text.len and H.isIdentChar(text[fend])) fend += 1;
                        const fname = text[fstart..fend];
                        var known: ?usize = null;
                        for (fields, 0..) |f, kfi| {
                            if (std.mem.eql(u8, f, fname)) known = kfi;
                        }
                        if (known) |kidx| {
                            if (target_form) {
                                const t = std.fmt.allocPrint(alloc, "{s}[__koru_qrow].{s}", .{ store, fname }) catch unreachable;
                                out.appendSlice(alloc, t) catch unreachable;
                            } else {
                                out.appendSlice(alloc, colRead(alloc, store, fname, char_caps[kidx] != null)) catch unreachable;
                            }
                            i = fend;
                            continue;
                        }
                    }
                    // A BARE `entity` (not `entity.field`, not `entityXyz`) is the
                    // query's row cursor itself — e.g. `take(store[entity])`
                    // addresses the currently-swept row. Rewrite it to the qbody's
                    // row-cursor input so take/stored heads resolve it (690_031).
                    if (at_boundary and std.mem.startsWith(u8, text[i..], "entity")) {
                        const after = i + "entity".len;
                        const next_is_ident = after < text.len and H.isIdentChar(text[after]);
                        const next_is_dot = after < text.len and text[after] == '.';
                        if (!next_is_ident and !next_is_dot) {
                            out.appendSlice(alloc, "__koru_qrow") catch unreachable;
                            i = after;
                            continue;
                        }
                    }
                    out.append(alloc, text[i]) catch unreachable;
                    i += 1;
                }
                return out.toOwnedSlice(alloc) catch unreachable;
            }
            // A stored block is `target: value` pairs — target keys keep the
            // indexed-lvalue form, values read columns directly.
            fn storedBlock(alloc: std.mem.Allocator, text: []const u8, store: []const u8, fields: []const []const u8, char_caps: []const ?usize) []const u8 {
                const braced2 = std.fmt.allocPrint(alloc, "{{{s}}}", .{text}) catch unreachable;
                const struct_literal2 = @import("struct_literal");
                const pairs = struct_literal2.parseFields(alloc, braced2) catch return text;
                var out = std.ArrayList(u8).initCapacity(alloc, text.len + 64) catch unreachable;
                for (pairs, 0..) |pr, i| {
                    if (i > 0) out.appendSlice(alloc, ", ") catch unreachable;
                    out.appendSlice(alloc, entityRefs(alloc, pr.name, store, fields, char_caps, true)) catch unreachable;
                    out.appendSlice(alloc, ": ") catch unreachable;
                    out.appendSlice(alloc, entityRefs(alloc, pr.value, store, fields, char_caps, false)) catch unreachable;
                }
                return out.toOwnedSlice(alloc) catch unreachable;
            }
            fn walkCont(alloc: std.mem.Allocator, cont: *ast.Continuation, store: []const u8, fields: []const []const u8, char_caps: []const ?usize) void {
                if (cont.node) |*n| {
                    switch (@constCast(n).*) {
                        .invocation => |*inv| {
                            const is_stored = blk: {
                                if (inv.path.module_qualifier) |mq| {
                                    if (std.mem.eql(u8, mq, "std.store") and inv.path.segments.len == 1 and std.mem.eql(u8, inv.path.segments[0], "stored")) break :blk true;
                                }
                                break :blk false;
                            };
                            for (inv.args) |*a| {
                                if (is_stored and std.mem.eql(u8, a.name, "source")) {
                                    @constCast(a).value = storedBlock(alloc, a.value, store, fields, char_caps);
                                    if (a.source_value) |sv| {
                                        const fresh = alloc.create(ast.Source) catch unreachable;
                                        fresh.* = sv.*;
                                        fresh.text = storedBlock(alloc, sv.text, store, fields, char_caps);
                                        @constCast(a).source_value = fresh;
                                    }
                                } else {
                                    @constCast(a).value = entityRefs(alloc, a.value, store, fields, char_caps, false);
                                    if (a.expression_value) |ev| {
                                        const fresh = alloc.create(ast.CapturedExpression) catch unreachable;
                                        fresh.* = ev.*;
                                        fresh.text = entityRefs(alloc, ev.text, store, fields, char_caps, false);
                                        @constCast(a).expression_value = fresh;
                                    }
                                    if (a.source_value) |sv| {
                                        const fresh = alloc.create(ast.Source) catch unreachable;
                                        fresh.* = sv.*;
                                        fresh.text = entityRefs(alloc, sv.text, store, fields, char_caps, false);
                                        @constCast(a).source_value = fresh;
                                    }
                                }
                            }
                        },
                        else => {},
                    }
                }
                for (cont.continuations) |*c| walkCont(alloc, @constCast(c), store, fields, char_caps);
            }
        };
        for (qsites.items) |*qs| PRewrite.walkCont(allocator, &qs.body, store_name, field_names, field_char_caps);

        // Store-name rewriting for watch bodies (other stores readable —
        // same as rung one).
        var pstore_names = std.ArrayList([]const u8).initCapacity(allocator, 4) catch unreachable;
        for (program.items) |pi| {
            switch (pi) {
                .flow => |*f| {
                    if (H.isStoreInv(f, "new", null)) {
                        for (f.inv().args) |a| {
                            if (std.mem.eql(u8, a.name, "expr")) pstore_names.append(allocator, H.stripQuotes(a.value)) catch unreachable;
                        }
                    }
                },
                .event_decl => |*ed| {
                    if (ed.path.segments.len == 1 and std.mem.startsWith(u8, ed.path.segments[0], "__store_apply_")) {
                        pstore_names.append(allocator, ed.path.segments[0]["__store_apply_".len..]) catch unreachable;
                    }
                },
                else => {},
            }
        }
        for (pwatch_arms.items) |*wa| H.storeRefsContH(allocator, &wa.cont, pstore_names.items);

        // Owned-column stores build insert/take/teardown (690_053), the READ
        // surface (query/preorder, 690_060: an owned column projects as a BARE
        // borrow `*mod:Type<mod:state>` — no `!`, the store keeps the live
        // `<state!>`, `read` consumes nothing), REACT-on-insert (`inserted`
        // interceptor, 690_061), and — this rung — WRITE (stored-update,
        // 690_062: discharge-old + consume-new through the unit-4 apply/write
        // pair) with field-`watch` firing on the write (690_063: the apply
        // branch payload borrow-reads the fresh cell), and REACT-on-remove
        // (`removed` interceptor, 690_065: fires in the take path before the
        // swap-remove, bare-borrow-reading the outgoing row via the same
        // LC.emit projection). Still later rungs, loud walls, never silent
        // miscompiles: the `updated` interceptor (it carries TWO owned images —
        // old and new — of the written field, a distinct rung from removed's
        // single outgoing borrow), and watch over a DRAIN store (ambiguous
        // discharger — unit-4 is not generated there, so a watch arm would
        // silently never fire).
        if (has_owned) {
            if (drain_required and pwatch_arms.items.len > 0) {
                return .{ .transformed = .{ .replacement = H.errItem(allocator, flow.location, flow.module, "std/store:watch({s}): watch over a DRAIN store (ambiguous discharger) is a later rung - the write surface needs the canonical discharger to evict the old value (690_062), which *{s}:{s} does not have (declare exactly one, or drop the watch)", .{ store_name, ambig_module, ambig_type }) } };
            }
            if (updated_arms.items.len > 0) {
                return .{ .transformed = .{ .replacement = H.errItem(allocator, flow.location, flow.module, "std/store:new({s}): the `updated` interceptor over an owned column is a later rung - it carries TWO owned images (old and new) of the written field; `inserted`/`removed`/`watch` over owned are built (690_061/065/063)", .{store_name}) } };
            }
        }

        // ---- unit 1: the SoA cell ----
        var pc = std.ArrayList(u8).initCapacity(allocator, 512) catch unreachable;
        pc.appendSlice(allocator, "const __KoruStoreT_") catch unreachable;
        pc.appendSlice(allocator, store_name) catch unreachable;
        pc.appendSlice(allocator, " = struct {\n") catch unreachable;
        for (field_names, field_types, field_char_caps, field_owned_info) |fname, ftype, fcc, foi| {
            // A fixed-char column is [CAP][N]u8 (the event-level `string`
            // type never reaches Zig emission); an owned column is [CAP]*Type
            // (the store OWNS the pointers — teardown frees the live ones) with
            // Type the discovered host cell (e.g. koru_std.koru_string.String);
            // scalars emit their own type.
            const col = if (fcc) |n|
                std.fmt.allocPrint(allocator, "    {s}: [{d}][{d}]u8 = undefined,\n", .{ fname, CAP, n }) catch unreachable
            else if (foi) |oi|
                std.fmt.allocPrint(allocator, "    {s}: [{d}]*{s} = undefined,\n", .{ fname, CAP, oi.host_type }) catch unreachable
            else
                std.fmt.allocPrint(allocator, "    {s}: [{d}]{s} = undefined,\n", .{ fname, CAP, ftype }) catch unreachable;
            pc.appendSlice(allocator, col) catch unreachable;
        }
        pc.appendSlice(allocator, "    len: usize = 0,\n};\n") catch unreachable;
        pc.appendSlice(allocator, "var __koru_store_") catch unreachable;
        pc.appendSlice(allocator, store_name) catch unreachable;
        pc.appendSlice(allocator, ": __KoruStoreT_") catch unreachable;
        pc.appendSlice(allocator, store_name) catch unreachable;
        pc.appendSlice(allocator, " = .{};") catch unreachable;
        // The row-value type: what take extracts (obligation rides on it).
        pc.appendSlice(allocator, "\nconst __KoruStoreRow_") catch unreachable;
        pc.appendSlice(allocator, store_name) catch unreachable;
        pc.appendSlice(allocator, " = struct {") catch unreachable;
        for (field_names, field_types, 0..) |fname, ftype, fi| {
            if (fi > 0) pc.appendSlice(allocator, ",") catch unreachable;
            pc.appendSlice(allocator, " ") catch unreachable;
            pc.appendSlice(allocator, fname) catch unreachable;
            pc.appendSlice(allocator, ": ") catch unreachable;
            if (field_char_caps[fi]) |n| {
                const rt = std.fmt.allocPrint(allocator, "[{d}]u8", .{n}) catch unreachable;
                pc.appendSlice(allocator, rt) catch unreachable;
            } else if (field_owned_info[fi]) |oi| {
                pc.appendSlice(allocator, "*") catch unreachable;
                pc.appendSlice(allocator, oi.host_type) catch unreachable;
            } else {
                pc.appendSlice(allocator, ftype) catch unreachable;
            }
        }
        pc.appendSlice(allocator, " };") catch unreachable;
        // `[entity(<name>)]` → a user-nameable alias for the row type, so a
        // discharger can spell `Enemy<std/store:!taken>` without touching the
        // internal `__KoruStoreRow_` name. `pub` so a sibling module can name
        // it via `input:Enemy` (writeModulePath → main_module.Enemy).
        if (entity_type) |et| {
            pc.appendSlice(allocator, "\npub const ") catch unreachable;
            pc.appendSlice(allocator, et) catch unreachable;
            pc.appendSlice(allocator, " = __KoruStoreRow_") catch unreachable;
            pc.appendSlice(allocator, store_name) catch unreachable;
            pc.appendSlice(allocator, ";") catch unreachable;
        }
        const pcell_decl = pc.toOwnedSlice(allocator) catch unreachable;

        var appended_items = std.ArrayList(ast.Item).initCapacity(allocator, 8 + qsites.items.len * 3) catch unreachable;
        appended_items.append(allocator, ast.Item{ .host_line = ast.HostLine{
            .content = pcell_decl,
            .location = flow.location,
            .module = allocator.dupe(u8, flow.module) catch unreachable,
        } }) catch unreachable;

        // ---- shared: the row-append text + standing-enter calls ----
        var ap = std.ArrayList(u8).initCapacity(allocator, 512) catch unreachable;
        {
            const grow = std.fmt.allocPrint(allocator,
                \\if (__koru_store_{s}.len >= {d}) @panic("std/store: store '{s}' is full (capacity {d}) - declared capacity and the `| full` branch are pinned at 690_011");
                \\const __koru_new_row = __koru_store_{s}.len;
                \\
            , .{ store_name, CAP, store_name, CAP, store_name }) catch unreachable;
            ap.appendSlice(allocator, grow) catch unreachable;
            // User columns write their insert bindings; the [tree]-synthesized
            // `parent` has NO user binding (TT1 — invisible): every new row is
            // born a root (-1) and is attached by the self-FK stored write.
            for (field_names[0..user_field_count], 0..) |fname, fci| {
                // A fixed-char column copies the incoming string into its
                // [N]u8 buffer: zero the buffer, copy at most N bytes
                // (comptime-known overflow is a compile error at the insert
                // site; runtime bytes truncate — the `| toolong` branch is a
                // deferred refinement), zero-padding the rest.
                const w = if (field_char_caps[fci]) |n|
                    std.fmt.allocPrint(allocator,
                        \\__koru_store_{s}.{s}[__koru_new_row] = @import("std").mem.zeroes([{d}]u8);
                        \\const __koru_cl_{s} = @min({s}.len, {d});
                        \\@memcpy(__koru_store_{s}.{s}[__koru_new_row][0..__koru_cl_{s}], {s}[0..__koru_cl_{s}]);
                        \\
                    , .{ store_name, fname, n, fname, fname, n, store_name, fname, fname, fname, fname }) catch unreachable
                else
                    std.fmt.allocPrint(allocator, "__koru_store_{s}.{s}[__koru_new_row] = {s};\n", .{ store_name, fname, fname }) catch unreachable;
                ap.appendSlice(allocator, w) catch unreachable;
            }
            if (is_tree) {
                const w = std.fmt.allocPrint(allocator, "__koru_store_{s}.parent[__koru_new_row] = -1;\n", .{store_name}) catch unreachable;
                ap.appendSlice(allocator, w) catch unreachable;
            }
            const bump = std.fmt.allocPrint(allocator, "__koru_store_{s}.len += 1;\n", .{store_name}) catch unreachable;
            ap.appendSlice(allocator, bump) catch unreachable;
            // `inserted` lifecycle interceptors fire as part of the write (the
            // store's contract), before standing query enters observe settled
            // state ((h)). The destructured fields are in scope as insert
            // proc inputs.
            for (inserted_arms.items, 0..) |arm, ai| {
                const head = std.fmt.allocPrint(allocator, "main_module.__store_inserted_{s}_{d}_event.handler(.{{ ", .{ store_name, ai }) catch unreachable;
                ap.appendSlice(allocator, head) catch unreachable;
                for (arm.fields, 0..) |fnm, fi| {
                    if (fi > 0) ap.appendSlice(allocator, ", ") catch unreachable;
                    // An OWNED column reads FRESH from the stored cell — the
                    // interceptor borrows the pointer the store now owns (a bare
                    // <state>), NOT the insert param `fnm` which the store write
                    // just CONSUMED (<!state>): reusing the consumed param yields
                    // "no tracked phantom state" at the arm's read (690_061). The
                    // row is already appended here (__koru_new_row valid). Scalars
                    // /char pass the param by value as before.
                    var is_owned = false;
                    for (field_names, field_owned) |cn, co| {
                        if (co and std.mem.eql(u8, cn, fnm)) is_owned = true;
                    }
                    const p = if (is_owned)
                        std.fmt.allocPrint(allocator, ".{s} = __koru_store_{s}.{s}[__koru_new_row]", .{ fnm, store_name, fnm }) catch unreachable
                    else
                        std.fmt.allocPrint(allocator, ".{s} = {s}", .{ fnm, fnm }) catch unreachable;
                    ap.appendSlice(allocator, p) catch unreachable;
                }
                ap.appendSlice(allocator, " });\n") catch unreachable;
            }
            // Standing enters: a query subscribes inserts that FOLLOW it in
            // source. `__site_line` is comptime-constant per call site, so
            // the position check costs nothing at runtime. Preorder sites are
            // program-position WALKS, not subscriptions — no standing enter.
            for (qsites.items) |qs| {
                if (qs.is_preorder) continue;
                const call = std.fmt.allocPrint(allocator,
                    \\if (__site_line > {d}) {{
                    \\    main_module.__store_qrow_{s}_L{d}_event.handler(.{{ .row = @as(i64, @intCast(__koru_new_row)) }});
                    \\}}
                    \\
                , .{ qs.line, store_name, qs.line }) catch unreachable;
                ap.appendSlice(allocator, call) catch unreachable;
            }
        }
        const append_text = ap.toOwnedSlice(allocator) catch unreachable;

        const mkInsertInput = struct {
            // An owned column's insert param CONSUMES the caller's obligation:
            // `<mod:!state>` (dot-canonical, the form the type's own bare states
            // canonicalize to). Ownership moves INTO the store; the phantom
            // checker rejects a value not holding <state!> (690_054). Generalized
            // past std/string — the module/state come from the discovered type.
            fn call(alloc: std.mem.Allocator, fnames: []const []const u8, ftypes: []const []const u8, foinfo: []const ?OwnedCol) []ast.Field {
                const fields = alloc.alloc(ast.Field, fnames.len + 1) catch unreachable;
                for (fnames, ftypes, foinfo, 0..) |fname, ftype, foi, i| {
                    fields[i] = ast.Field{
                        .name = alloc.dupe(u8, fname) catch unreachable,
                        .type = alloc.dupe(u8, ftype) catch unreachable,
                        .module_path = if (foi) |oi| alloc.dupe(u8, oi.module_slash) catch unreachable else null,
                        .phantom = if (foi) |oi| std.fmt.allocPrint(alloc, "{s}:!{s}", .{ oi.module_dot, oi.state }) catch unreachable else null,
                    };
                }
                fields[fnames.len] = ast.Field{ .name = alloc.dupe(u8, "__site_line") catch unreachable, .type = alloc.dupe(u8, "i64") catch unreachable };
                return fields;
            }
        }.call;

        // ---- unit 2: insert (void) + inserth (`| row i64`) ----
        {
            const insert_name = std.fmt.allocPrint(allocator, "__store_insert_{s}", .{store_name}) catch unreachable;
            appended_items.append(allocator, ast.Item{ .event_decl = ast.EventDecl{
                .path = H.mkPathH(allocator, flow.module, insert_name),
                .input = ast.Shape{ .fields = mkInsertInput(allocator, field_names[0..user_field_count], field_types[0..user_field_count], field_owned_info[0..user_field_count]) },
                .branches = &[_]ast.Branch{},
                .is_public = false,
                .is_implicit_flow = false,
                .annotations = &[_][]const u8{},
                .location = flow.location,
                .module = allocator.dupe(u8, flow.module) catch unreachable,
            } }) catch unreachable;
            const body = std.fmt.allocPrint(allocator, "{s}return;", .{append_text}) catch unreachable;
            appended_items.append(allocator, ast.Item{ .proc_decl = ast.ProcDecl{
                .path = H.mkPathH(allocator, flow.module, insert_name),
                .body = ast.Source{ .text = body, .location = flow.location, .scope = .{ .bindings = &[_]ast.ScopeBinding{} }, .phantom_type = null },
                .annotations = &[_][]const u8{},
                .target = allocator.dupe(u8, "zig") catch unreachable,
                .location = flow.location,
                .module = allocator.dupe(u8, flow.module) catch unreachable,
            } }) catch unreachable;

            const inserth_name = std.fmt.allocPrint(allocator, "__store_inserth_{s}", .{store_name}) catch unreachable;
            const row_branches = allocator.alloc(ast.Branch, 1) catch unreachable;
            const row_pf = allocator.alloc(ast.Field, 1) catch unreachable;
            row_pf[0] = ast.Field{ .name = allocator.dupe(u8, "__type_ref") catch unreachable, .type = allocator.dupe(u8, "i64") catch unreachable };
            row_branches[0] = ast.Branch{
                .name = allocator.dupe(u8, "row") catch unreachable,
                .payload = ast.Shape{ .fields = row_pf },
                .kind = .terminal,
                .annotations = &[_][]const u8{},
            };
            appended_items.append(allocator, ast.Item{ .event_decl = ast.EventDecl{
                .path = H.mkPathH(allocator, flow.module, inserth_name),
                .input = ast.Shape{ .fields = mkInsertInput(allocator, field_names[0..user_field_count], field_types[0..user_field_count], field_owned_info[0..user_field_count]) },
                .branches = row_branches,
                .is_public = false,
                .is_implicit_flow = false,
                .annotations = &[_][]const u8{},
                .location = flow.location,
                .module = allocator.dupe(u8, flow.module) catch unreachable,
            } }) catch unreachable;
            const hbody = std.fmt.allocPrint(allocator, "{s}return .{{ .row = @as(i64, @intCast(__koru_new_row)) }};", .{append_text}) catch unreachable;
            appended_items.append(allocator, ast.Item{ .proc_decl = ast.ProcDecl{
                .path = H.mkPathH(allocator, flow.module, inserth_name),
                .body = ast.Source{ .text = hbody, .location = flow.location, .scope = .{ .bindings = &[_]ast.ScopeBinding{} }, .phantom_type = null },
                .annotations = &[_][]const u8{},
                .target = allocator.dupe(u8, "zig") catch unreachable,
                .location = flow.location,
                .module = allocator.dupe(u8, flow.module) catch unreachable,
            } }) catch unreachable;
        }


        // insertf: row + full — exhaustion is a BRANCH (O10, 690_011).
        // NOT generated for owned-string stores: the `| full` early return
        // happens AFTER the caller's obligation was consumed but BEFORE the
        // store kept the value — the ownership would silently leak. The
        // give-back shape (full re-issuing the obligation) is a later rung;
        // the insert transform walls the `| full` arm at the site.
        if (!has_owned) {
            const insertf_name = std.fmt.allocPrint(allocator, "__store_insertf_{s}", .{store_name}) catch unreachable;
            const f_branches = allocator.alloc(ast.Branch, 2) catch unreachable;
            const f_row_pf = allocator.alloc(ast.Field, 1) catch unreachable;
            f_row_pf[0] = ast.Field{ .name = allocator.dupe(u8, "__type_ref") catch unreachable, .type = allocator.dupe(u8, "i64") catch unreachable };
            f_branches[0] = ast.Branch{
                .name = allocator.dupe(u8, "row") catch unreachable,
                .payload = ast.Shape{ .fields = f_row_pf },
                .kind = .terminal,
                .annotations = &[_][]const u8{},
            };
            f_branches[1] = ast.Branch{
                .name = allocator.dupe(u8, "full") catch unreachable,
                .payload = ast.Shape{ .fields = &[_]ast.Field{} },
                .kind = .terminal,
                .annotations = &[_][]const u8{},
            };
            appended_items.append(allocator, ast.Item{ .event_decl = ast.EventDecl{
                .path = H.mkPathH(allocator, flow.module, insertf_name),
                .input = ast.Shape{ .fields = mkInsertInput(allocator, field_names[0..user_field_count], field_types[0..user_field_count], field_owned_info[0..user_field_count]) },
                .branches = f_branches,
                .is_public = false,
                .is_implicit_flow = false,
                .annotations = &[_][]const u8{},
                .location = flow.location,
                .module = allocator.dupe(u8, flow.module) catch unreachable,
            } }) catch unreachable;
            const fcheck = std.fmt.allocPrint(allocator, "if (__koru_store_{s}.len >= {d}) return .{{ .full = .{{}} }};\n", .{ store_name, CAP }) catch unreachable;
            const fbody = std.fmt.allocPrint(allocator, "{s}{s}return .{{ .row = @as(i64, @intCast(__koru_new_row)) }};", .{ fcheck, append_text }) catch unreachable;
            appended_items.append(allocator, ast.Item{ .proc_decl = ast.ProcDecl{
                .path = H.mkPathH(allocator, flow.module, insertf_name),
                .body = ast.Source{ .text = fbody, .location = flow.location, .scope = .{ .bindings = &[_]ast.ScopeBinding{} }, .phantom_type = null },
                .annotations = &[_][]const u8{},
                .target = allocator.dupe(u8, "zig") catch unreachable,
                .location = flow.location,
                .module = allocator.dupe(u8, flow.module) catch unreachable,
            } }) catch unreachable;
        }

        // ---- unit 4: the row-addressed apply/write pair ((f), plural) ----
        // Generated for owned-column stores too (the WRITE rung, 690_062/063):
        // an owned column's write is discharge-old + consume-new — the apply
        // arm evicts the old pointer through the discovered canonical
        // discharger, then moves the caller's consumed value in. NOT generated
        // for a DRAIN store (ambiguous discharger, 690_057/058): the eviction
        // has no canonical discharger to fire, so `stored`/watch sites fail
        // loudly at their own transforms instead of silently leaking the old
        // value.
        if (!drain_required) {
            const papply_name = std.fmt.allocPrint(allocator, "__store_apply_{s}", .{store_name}) catch unreachable;
            const pwrite_name = std.fmt.allocPrint(allocator, "__store_write_{s}", .{store_name}) catch unreachable;

            // Per-field typed value slots (690_049): the write surface carries
            // one slot per column (`value_<i>: <column type>`), so a mixed
            // container reads/writes each column in its own type. `field`
            // (a comptime constant at every generated call site) selects the
            // live slot; the other slots ride as typed zeros no arm reads.
            // An owned column's value slot mirrors mkInsertInput: it CONSUMES
            // the caller's obligation (`<mod:!state>`, dot-canonical) — the
            // move-in half of the WRITE rung (690_062). The consume phantom
            // rides the USER-FACING `__store_write_*` event (with_consume);
            // the internal `__store_apply_*` hop receives the already-owned
            // plain pointer (module_path still resolves the host cell type).
            const mkWriteInput = struct {
                fn call(alloc: std.mem.Allocator, ftypes: []const []const u8, foinfo: []const ?OwnedCol, with_consume: bool) []ast.Field {
                    const fields = alloc.alloc(ast.Field, ftypes.len + 2) catch unreachable;
                    fields[0] = ast.Field{ .name = alloc.dupe(u8, "row") catch unreachable, .type = alloc.dupe(u8, "i64") catch unreachable };
                    fields[1] = ast.Field{ .name = alloc.dupe(u8, "field") catch unreachable, .type = alloc.dupe(u8, "i64") catch unreachable };
                    for (ftypes, foinfo, 0..) |ft, foi, i| {
                        fields[2 + i] = ast.Field{
                            .name = std.fmt.allocPrint(alloc, "value_{d}", .{i}) catch unreachable,
                            .type = alloc.dupe(u8, ft) catch unreachable,
                            .module_path = if (foi) |oi| alloc.dupe(u8, oi.module_slash) catch unreachable else null,
                            .phantom = if (foi) |oi|
                                (if (with_consume) std.fmt.allocPrint(alloc, "{s}:!{s}", .{ oi.module_dot, oi.state }) catch unreachable else null)
                            else
                                null,
                        };
                    }
                    return fields;
                }
            }.call;
            const in_fields = mkWriteInput(allocator, field_types, field_owned_info, false);

            const papply_branches = allocator.alloc(ast.Branch, field_names.len) catch unreachable;
            for (field_names, 0..) |fname, i| {
                const pf = allocator.alloc(ast.Field, 1) catch unreachable;
                // An owned field's arm payload is the query projection's BARE
                // borrow `*mod:Type<mod:state>` (no `!`, 690_060/063): the
                // watch arm reads the just-written value and consumes nothing;
                // the store keeps the live `<state!>` it frees at teardown.
                pf[0] = ast.Field{
                    .name = allocator.dupe(u8, "__type_ref") catch unreachable,
                    .type = allocator.dupe(u8, field_types[i]) catch unreachable,
                    .module_path = if (field_owned_info[i]) |oi| allocator.dupe(u8, oi.module_slash) catch unreachable else null,
                    .phantom = if (field_owned_info[i]) |oi| std.fmt.allocPrint(allocator, "{s}:{s}", .{ oi.module_dot, oi.state }) catch unreachable else null,
                };
                papply_branches[i] = ast.Branch{
                    .name = allocator.dupe(u8, fname) catch unreachable,
                    .payload = ast.Shape{ .fields = pf },
                    .kind = .terminal,
                    .annotations = &[_][]const u8{},
                };
            }
            appended_items.append(allocator, ast.Item{ .event_decl = ast.EventDecl{
                .path = H.mkPathH(allocator, flow.module, papply_name),
                .input = ast.Shape{ .fields = in_fields },
                .branches = papply_branches,
                .is_public = false,
                .is_implicit_flow = false,
                .annotations = &[_][]const u8{},
                .location = flow.location,
                .module = allocator.dupe(u8, flow.module) catch unreachable,
            } }) catch unreachable;

            var pbody = std.ArrayList(u8).initCapacity(allocator, 256) catch unreachable;
            pbody.appendSlice(allocator, "const __koru_r = @as(usize, @intCast(row));\nreturn switch (field) {\n") catch unreachable;
            // `updated` lifecycle interceptors fire inside the write's atomic
            // step — after the cell write, before the field arm dispatches to
            // subscriptions — so no watch ever observes a row whose contract
            // (e.g. a maintained aggregate) hasn't settled. The pre-image read
            // is usage-synthesized ((c) lean): only an arm that binds
            // { old, new } materializes it; discard arms stay write-only.
            const updated_needs_old = blk: {
                for (updated_arms.items) |ua| {
                    if (ua.fields.len != 0) break :blk true;
                }
                break :blk false;
            };
            for (field_names, 0..) |fname, i| {
                var atext = std.ArrayList(u8).initCapacity(allocator, 128) catch unreachable;
                const head = std.fmt.allocPrint(allocator, "    {d} => blk: {{ ", .{i}) catch unreachable;
                atext.appendSlice(allocator, head) catch unreachable;
                // TT2 (695_002): the [tree]-synthesized parent write carries a
                // DEFAULT-ON acyclicity guard — walk the new parent's ancestor
                // chain; hitting `row` means the reparent would make the row its
                // own ancestor. Unhandled, the guard is a loud panic (the mirror
                // of insert's `| full` default above). A site that handles
                // `| cycle` routes through __store_writec_*, which refuses the
                // write BEFORE this arm — a cycle can never reach here from it.
                if (is_tree and i == user_field_count) {
                    const guard = std.fmt.allocPrint(allocator, "var __koru_cyc = value_{d}; while (__koru_cyc != -1) {{ if (__koru_cyc == row) @panic(\"std/store:stored: reparent in [tree] store '{s}' would make the row its own ancestor (cycle) - the write is rejected; handle it with a `| cycle` branch (default-on guard and branch are pinned at 695_002)\"); __koru_cyc = __koru_store_{s}.parent[@as(usize, @intCast(__koru_cyc))]; }} ", .{ i, store_name, store_name }) catch unreachable;
                    atext.appendSlice(allocator, guard) catch unreachable;
                }
                if (updated_needs_old) {
                    // A char column's pre-image is COPIED before the write (a
                    // slice into the cell would observe the overwrite), then
                    // sliced to the first NUL — the `updated` payload's
                    // `string` shape.
                    const oldr = if (field_char_caps[i] != null)
                        std.fmt.allocPrint(allocator, "const __koru_oldbuf = __koru_store_{s}.{s}[__koru_r]; const __koru_old = @import(\"std\").mem.sliceTo(&__koru_oldbuf, 0); ", .{ store_name, fname }) catch unreachable
                    else
                        std.fmt.allocPrint(allocator, "const __koru_old = __koru_store_{s}.{s}[__koru_r]; ", .{ store_name, fname }) catch unreachable;
                    atext.appendSlice(allocator, oldr) catch unreachable;
                }
                // An OWNED arm is discharge-old + consume-new (690_062): read
                // the OLD pointer UNCONDITIONALLY (eviction always needs it —
                // not gated on updated_needs_old, which serves the `updated`
                // interceptor's pre-image), fire the DISCOVERED canonical
                // discharger on it (the teardown call convention,
                // `<host>.<event>_event.handler`), then move the new pointer
                // in. The caller's <!state> was consumed at the write event.
                const wr = if (field_owned_info[i]) |oi|
                    std.fmt.allocPrint(allocator, "const __koru_old_ptr = __koru_store_{s}.{s}[__koru_r]; _ = {s}.{s}_event.handler(.{{ .{s} = __koru_old_ptr }}); __koru_store_{s}.{s}[__koru_r] = value_{d}; ", .{ store_name, fname, oi.disch_host, oi.disch_event, oi.disch_param, store_name, fname, i }) catch unreachable
                else if (field_char_caps[i]) |n|
                    std.fmt.allocPrint(allocator, "__koru_store_{s}.{s}[__koru_r] = @import(\"std\").mem.zeroes([{d}]u8); const __koru_wl = @min(value_{d}.len, {d}); @memcpy(__koru_store_{s}.{s}[__koru_r][0..__koru_wl], value_{d}[0..__koru_wl]); ", .{ store_name, fname, n, i, n, store_name, fname, i }) catch unreachable
                else
                    std.fmt.allocPrint(allocator, "__koru_store_{s}.{s}[__koru_r] = value_{d}; ", .{ store_name, fname, i }) catch unreachable;
                atext.appendSlice(allocator, wr) catch unreachable;
                for (updated_arms.items, 0..) |ua, ai| {
                    const call = if (ua.fields.len != 0)
                        std.fmt.allocPrint(allocator, "main_module.__store_updated_{s}_{d}_event.handler(.{{ .old = __koru_old, .new = value_{d} }}); ", .{ store_name, ai, i }) catch unreachable
                    else
                        std.fmt.allocPrint(allocator, "main_module.__store_updated_{s}_{d}_event.handler(.{{}}); ", .{ store_name, ai }) catch unreachable;
                    atext.appendSlice(allocator, call) catch unreachable;
                }
                // An owned arm dispatches the FRESH cell read, not the consumed
                // param (the 690_061 fresh-from-cell rule, 690_063): the watch
                // arm borrow-reads the value the store now owns.
                const tail = if (field_owned_info[i] != null)
                    std.fmt.allocPrint(allocator, "break :blk .{{ .{s} = __koru_store_{s}.{s}[__koru_r] }}; }},\n", .{ fname, store_name, fname }) catch unreachable
                else
                    std.fmt.allocPrint(allocator, "break :blk .{{ .{s} = value_{d} }}; }},\n", .{ fname, i }) catch unreachable;
                atext.appendSlice(allocator, tail) catch unreachable;
                pbody.appendSlice(allocator, atext.items) catch unreachable;
            }
            pbody.appendSlice(allocator, "    else => unreachable,\n};") catch unreachable;
            appended_items.append(allocator, ast.Item{ .proc_decl = ast.ProcDecl{
                .path = H.mkPathH(allocator, flow.module, papply_name),
                .body = ast.Source{ .text = pbody.toOwnedSlice(allocator) catch unreachable, .location = flow.location, .scope = .{ .bindings = &[_]ast.ScopeBinding{} }, .phantom_type = null },
                .annotations = &[_][]const u8{},
                .target = allocator.dupe(u8, "zig") catch unreachable,
                .location = flow.location,
                .module = allocator.dupe(u8, flow.module) catch unreachable,
            } }) catch unreachable;

            const win_fields = mkWriteInput(allocator, field_types, field_owned_info, true);
            appended_items.append(allocator, ast.Item{ .event_decl = ast.EventDecl{
                .path = H.mkPathH(allocator, flow.module, pwrite_name),
                .input = ast.Shape{ .fields = win_fields },
                .branches = &[_]ast.Branch{},
                .is_public = false,
                .is_implicit_flow = false,
                .annotations = &[_][]const u8{},
                .location = flow.location,
                .module = allocator.dupe(u8, flow.module) catch unreachable,
            } }) catch unreachable;

            const wapply_args = allocator.alloc(ast.Arg, field_names.len + 2) catch unreachable;
            wapply_args[0] = ast.Arg{ .name = allocator.dupe(u8, "row") catch unreachable, .value = allocator.dupe(u8, "row") catch unreachable };
            wapply_args[1] = ast.Arg{ .name = allocator.dupe(u8, "field") catch unreachable, .value = allocator.dupe(u8, "field") catch unreachable };
            for (0..field_names.len) |i| {
                const vn = std.fmt.allocPrint(allocator, "value_{d}", .{i}) catch unreachable;
                wapply_args[2 + i] = ast.Arg{ .name = vn, .value = allocator.dupe(u8, vn) catch unreachable };
            }
            const wapply_inv = ast.Invocation{
                .path = H.mkPathH(allocator, flow.module, papply_name),
                .args = wapply_args,
            };

            var warms = std.ArrayList(ast.Continuation).initCapacity(allocator, field_names.len) catch unreachable;
            for (field_names, 0..) |fname, i| {
                var arm_body: ?ast.Continuation = null;
                for (pwatch_arms.items) |*wa| {
                    if (wa.field_idx == i) {
                        var a = ast_functional.cloneContinuation(allocator, &wa.cont) catch unreachable;
                        a.branch = allocator.dupe(u8, fname) catch unreachable;
                        a.kind = .terminal;
                        a.binding = if (wa.cont.binding) |b| allocator.dupe(u8, b) catch unreachable else allocator.dupe(u8, "_") catch unreachable;
                        arm_body = a;
                    }
                }
                // The unguarded fallthrough for this field: the write always
                // lands, and an absent — or guard-FALSE — watch is a no-op. A
                // guarded watch arm covers only the guard-TRUE case, so it needs
                // this sibling to complete the apply switch (mirrors the
                // singleton guarded-watch path).
                const noop_arm = ast.Continuation{
                    .branch = allocator.dupe(u8, fname) catch unreachable,
                    .binding = allocator.dupe(u8, "_") catch unreachable,
                    .kind = .terminal,
                    .condition = null,
                    .node = .terminal,
                    .indent = 1,
                    .continuations = &[_]ast.Continuation{},
                    .location = flow.location,
                };
                if (arm_body) |a| {
                    warms.append(allocator, a) catch unreachable;
                    if (a.condition != null) warms.append(allocator, noop_arm) catch unreachable;
                } else {
                    warms.append(allocator, noop_arm) catch unreachable;
                }
            }
            appended_items.append(allocator, ast.Item{ .flow = ast.Flow{
                .body = ast.rootSite(wapply_inv, warms.toOwnedSlice(allocator) catch unreachable, flow.location),
                .pre_label = null,
                .impl_of = H.mkPathH(allocator, flow.module, pwrite_name),
                .super_shape = null,
                .inline_body = null,
                .preamble_code = null,
                .is_pure = false,
                .is_transitively_pure = false,
                .location = flow.location,
                .module = allocator.dupe(u8, flow.module) catch unreachable,
            } }) catch unreachable;

            // ---- unit 4c (owned-containing stores): per-field TARGETED writes ----
            // The bundled surface above carries one value slot per column, a
            // dead slot riding as a typed zero — but an OWNED slot has no
            // typed zero (its value is a consumed obligation; nothing can
            // synthesize one), so a `done`-only write in a `{label: owned,
            // done: i64}` store could never fill `label`'s slot (690_064).
            // The fix is the `captured` model: DE-BUNDLE into one targeted
            // event per field, `__store_fwrite_<s>_<i>(row, value)`, threading
            // ONLY that field's value. A scalar write never references an
            // owned sibling's slot or its obligation; the owned field's own
            // write keeps consume-new on its single slot (discharge-old lives
            // in its apply arm, 690_062) and its watch arm fires off the
            // fresh cell read (690_063). The `stored` transform routes EVERY
            // row-addressed write of an owned-containing store here; the
            // bundled surface above remains as the discovery surface (field
            // order, column types, the watch-splice marker). The distinct
            // `fwrite`/`fapply` prefixes are load-bearing: store-name
            // discovery strips `__store_apply_`/`__store_write_` prefixes,
            // and a per-field name sharing them would parse as a bogus store.
            if (has_owned) {
                for (field_names, 0..) |fname, i| {
                    const fwrite_name = std.fmt.allocPrint(allocator, "__store_fwrite_{s}_{d}", .{ store_name, i }) catch unreachable;
                    const fapply_name = std.fmt.allocPrint(allocator, "__store_fapply_{s}_{d}", .{ store_name, i }) catch unreachable;

                    // fapply: the internal hop — an owned column's value is the
                    // already-owned plain pointer (module_path resolves the
                    // host cell type; no phantom), mirroring the bundled
                    // in_fields (with_consume=false).
                    const fa_in = allocator.alloc(ast.Field, 2) catch unreachable;
                    fa_in[0] = ast.Field{ .name = allocator.dupe(u8, "row") catch unreachable, .type = allocator.dupe(u8, "i64") catch unreachable };
                    fa_in[1] = ast.Field{
                        .name = allocator.dupe(u8, "value") catch unreachable,
                        .type = allocator.dupe(u8, field_types[i]) catch unreachable,
                        .module_path = if (field_owned_info[i]) |oi| allocator.dupe(u8, oi.module_slash) catch unreachable else null,
                    };
                    // The single arm carries the same bare-borrow payload as
                    // the bundled apply's arm for this field (690_060/063):
                    // the watch arm reads the just-written value, consuming
                    // nothing; the store keeps the live `<state!>`.
                    const fa_pf = allocator.alloc(ast.Field, 1) catch unreachable;
                    fa_pf[0] = ast.Field{
                        .name = allocator.dupe(u8, "__type_ref") catch unreachable,
                        .type = allocator.dupe(u8, field_types[i]) catch unreachable,
                        .module_path = if (field_owned_info[i]) |oi| allocator.dupe(u8, oi.module_slash) catch unreachable else null,
                        .phantom = if (field_owned_info[i]) |oi| std.fmt.allocPrint(allocator, "{s}:{s}", .{ oi.module_dot, oi.state }) catch unreachable else null,
                    };
                    const fa_branches = allocator.alloc(ast.Branch, 1) catch unreachable;
                    fa_branches[0] = ast.Branch{
                        .name = allocator.dupe(u8, fname) catch unreachable,
                        .payload = ast.Shape{ .fields = fa_pf },
                        .kind = .terminal,
                        .annotations = &[_][]const u8{},
                    };
                    appended_items.append(allocator, ast.Item{ .event_decl = ast.EventDecl{
                        .path = H.mkPathH(allocator, flow.module, fapply_name),
                        .input = ast.Shape{ .fields = fa_in },
                        .branches = fa_branches,
                        .is_public = false,
                        .is_implicit_flow = false,
                        .annotations = &[_][]const u8{},
                        .location = flow.location,
                        .module = allocator.dupe(u8, flow.module) catch unreachable,
                    } }) catch unreachable;

                    // The proc body is the bundled switch's arm for field i,
                    // straight-lined: `value` in place of `value_<i>`.
                    var fatext = std.ArrayList(u8).initCapacity(allocator, 256) catch unreachable;
                    fatext.appendSlice(allocator, "const __koru_r = @as(usize, @intCast(row));\n") catch unreachable;
                    if (is_tree and i == user_field_count) {
                        const fguard = std.fmt.allocPrint(allocator, "var __koru_cyc = value; while (__koru_cyc != -1) {{ if (__koru_cyc == row) @panic(\"std/store:stored: reparent in [tree] store '{s}' would make the row its own ancestor (cycle) - the write is rejected; handle it with a `| cycle` branch (default-on guard and branch are pinned at 695_002)\"); __koru_cyc = __koru_store_{s}.parent[@as(usize, @intCast(__koru_cyc))]; }} ", .{ store_name, store_name }) catch unreachable;
                        fatext.appendSlice(allocator, fguard) catch unreachable;
                    }
                    if (updated_needs_old) {
                        const foldr = if (field_char_caps[i] != null)
                            std.fmt.allocPrint(allocator, "const __koru_oldbuf = __koru_store_{s}.{s}[__koru_r]; const __koru_old = @import(\"std\").mem.sliceTo(&__koru_oldbuf, 0); ", .{ store_name, fname }) catch unreachable
                        else
                            std.fmt.allocPrint(allocator, "const __koru_old = __koru_store_{s}.{s}[__koru_r]; ", .{ store_name, fname }) catch unreachable;
                        fatext.appendSlice(allocator, foldr) catch unreachable;
                    }
                    // An OWNED arm is discharge-old + consume-new (690_062);
                    // the caller's <!state> was consumed at the fwrite event.
                    const fwr = if (field_owned_info[i]) |oi|
                        std.fmt.allocPrint(allocator, "const __koru_old_ptr = __koru_store_{s}.{s}[__koru_r]; _ = {s}.{s}_event.handler(.{{ .{s} = __koru_old_ptr }}); __koru_store_{s}.{s}[__koru_r] = value; ", .{ store_name, fname, oi.disch_host, oi.disch_event, oi.disch_param, store_name, fname }) catch unreachable
                    else if (field_char_caps[i]) |n|
                        std.fmt.allocPrint(allocator, "__koru_store_{s}.{s}[__koru_r] = @import(\"std\").mem.zeroes([{d}]u8); const __koru_wl = @min(value.len, {d}); @memcpy(__koru_store_{s}.{s}[__koru_r][0..__koru_wl], value[0..__koru_wl]); ", .{ store_name, fname, n, n, store_name, fname }) catch unreachable
                    else
                        std.fmt.allocPrint(allocator, "__koru_store_{s}.{s}[__koru_r] = value; ", .{ store_name, fname }) catch unreachable;
                    fatext.appendSlice(allocator, fwr) catch unreachable;
                    for (updated_arms.items, 0..) |ua, ai| {
                        const fcall = if (ua.fields.len != 0)
                            std.fmt.allocPrint(allocator, "main_module.__store_updated_{s}_{d}_event.handler(.{{ .old = __koru_old, .new = value }}); ", .{ store_name, ai }) catch unreachable
                        else
                            std.fmt.allocPrint(allocator, "main_module.__store_updated_{s}_{d}_event.handler(.{{}}); ", .{ store_name, ai }) catch unreachable;
                        fatext.appendSlice(allocator, fcall) catch unreachable;
                    }
                    // An owned arm dispatches the FRESH cell read (690_061/063).
                    const ftail = if (field_owned_info[i] != null)
                        std.fmt.allocPrint(allocator, "return .{{ .{s} = __koru_store_{s}.{s}[__koru_r] }};", .{ fname, store_name, fname }) catch unreachable
                    else
                        std.fmt.allocPrint(allocator, "return .{{ .{s} = value }};", .{fname}) catch unreachable;
                    fatext.appendSlice(allocator, ftail) catch unreachable;
                    appended_items.append(allocator, ast.Item{ .proc_decl = ast.ProcDecl{
                        .path = H.mkPathH(allocator, flow.module, fapply_name),
                        .body = ast.Source{ .text = fatext.toOwnedSlice(allocator) catch unreachable, .location = flow.location, .scope = .{ .bindings = &[_]ast.ScopeBinding{} }, .phantom_type = null },
                        .annotations = &[_][]const u8{},
                        .target = allocator.dupe(u8, "zig") catch unreachable,
                        .location = flow.location,
                        .module = allocator.dupe(u8, flow.module) catch unreachable,
                    } }) catch unreachable;

                    // fwrite: the user-facing event — the consume phantom
                    // (`<mod:!state>`) rides ONLY an owned field's own value.
                    const fw_in = allocator.alloc(ast.Field, 2) catch unreachable;
                    fw_in[0] = ast.Field{ .name = allocator.dupe(u8, "row") catch unreachable, .type = allocator.dupe(u8, "i64") catch unreachable };
                    fw_in[1] = ast.Field{
                        .name = allocator.dupe(u8, "value") catch unreachable,
                        .type = allocator.dupe(u8, field_types[i]) catch unreachable,
                        .module_path = if (field_owned_info[i]) |oi| allocator.dupe(u8, oi.module_slash) catch unreachable else null,
                        .phantom = if (field_owned_info[i]) |oi| std.fmt.allocPrint(allocator, "{s}:!{s}", .{ oi.module_dot, oi.state }) catch unreachable else null,
                    };
                    appended_items.append(allocator, ast.Item{ .event_decl = ast.EventDecl{
                        .path = H.mkPathH(allocator, flow.module, fwrite_name),
                        .input = ast.Shape{ .fields = fw_in },
                        .branches = &[_]ast.Branch{},
                        .is_public = false,
                        .is_implicit_flow = false,
                        .annotations = &[_][]const u8{},
                        .location = flow.location,
                        .module = allocator.dupe(u8, flow.module) catch unreachable,
                    } }) catch unreachable;

                    // The fwrite → fapply flow carries THIS field's watch arm
                    // (or the unguarded no-op fallthrough), mirroring the
                    // bundled warms loop one field at a time.
                    const fap_args = allocator.alloc(ast.Arg, 2) catch unreachable;
                    fap_args[0] = ast.Arg{ .name = allocator.dupe(u8, "row") catch unreachable, .value = allocator.dupe(u8, "row") catch unreachable };
                    fap_args[1] = ast.Arg{ .name = allocator.dupe(u8, "value") catch unreachable, .value = allocator.dupe(u8, "value") catch unreachable };
                    const fap_inv = ast.Invocation{
                        .path = H.mkPathH(allocator, flow.module, fapply_name),
                        .args = fap_args,
                    };
                    var fwarms = std.ArrayList(ast.Continuation).initCapacity(allocator, 2) catch unreachable;
                    var farm_body: ?ast.Continuation = null;
                    for (pwatch_arms.items) |*wa| {
                        if (wa.field_idx == i) {
                            var a = ast_functional.cloneContinuation(allocator, &wa.cont) catch unreachable;
                            a.branch = allocator.dupe(u8, fname) catch unreachable;
                            a.kind = .terminal;
                            a.binding = if (wa.cont.binding) |b| allocator.dupe(u8, b) catch unreachable else allocator.dupe(u8, "_") catch unreachable;
                            farm_body = a;
                        }
                    }
                    const fnoop_arm = ast.Continuation{
                        .branch = allocator.dupe(u8, fname) catch unreachable,
                        .binding = allocator.dupe(u8, "_") catch unreachable,
                        .kind = .terminal,
                        .condition = null,
                        .node = .terminal,
                        .indent = 1,
                        .continuations = &[_]ast.Continuation{},
                        .location = flow.location,
                    };
                    if (farm_body) |a| {
                        fwarms.append(allocator, a) catch unreachable;
                        if (a.condition != null) fwarms.append(allocator, fnoop_arm) catch unreachable;
                    } else {
                        fwarms.append(allocator, fnoop_arm) catch unreachable;
                    }
                    appended_items.append(allocator, ast.Item{ .flow = ast.Flow{
                        .body = ast.rootSite(fap_inv, fwarms.toOwnedSlice(allocator) catch unreachable, flow.location),
                        .pre_label = null,
                        .impl_of = H.mkPathH(allocator, flow.module, fwrite_name),
                        .super_shape = null,
                        .inline_body = null,
                        .preamble_code = null,
                        .is_pure = false,
                        .is_transitively_pure = false,
                        .location = flow.location,
                        .module = allocator.dupe(u8, flow.module) catch unreachable,
                    } }) catch unreachable;
                }
            }
        }

        // ---- unit 4b ([tree] only): the cycle-guarded parent write ----
        // Mirror of insertf (exhaustion is a branch, 690_011): acyclicity is a
        // BRANCH. `__store_writec_*` answers `| ok` (the write landed, through
        // the ordinary write/apply/watch path) and `| cycle` (the write is
        // REFUSED, the tree left intact, the arm's continuation runs). The
        // stored transform targets this variant only when the site handles
        // `| cycle` on the synthesized parent write (TT2, pinned at 695_002).
        if (is_tree) {
            const pwritec_name = std.fmt.allocPrint(allocator, "__store_writec_{s}", .{store_name}) catch unreachable;
            const cin_fields = allocator.alloc(ast.Field, 3) catch unreachable;
            cin_fields[0] = ast.Field{ .name = allocator.dupe(u8, "row") catch unreachable, .type = allocator.dupe(u8, "i64") catch unreachable };
            cin_fields[1] = ast.Field{ .name = allocator.dupe(u8, "field") catch unreachable, .type = allocator.dupe(u8, "i64") catch unreachable };
            cin_fields[2] = ast.Field{ .name = allocator.dupe(u8, "value") catch unreachable, .type = allocator.dupe(u8, "i64") catch unreachable };
            const c_branches = allocator.alloc(ast.Branch, 2) catch unreachable;
            c_branches[0] = ast.Branch{
                .name = allocator.dupe(u8, "ok") catch unreachable,
                .payload = ast.Shape{ .fields = &[_]ast.Field{} },
                .kind = .terminal,
                .annotations = &[_][]const u8{},
            };
            c_branches[1] = ast.Branch{
                .name = allocator.dupe(u8, "cycle") catch unreachable,
                .payload = ast.Shape{ .fields = &[_]ast.Field{} },
                .kind = .terminal,
                .annotations = &[_][]const u8{},
            };
            appended_items.append(allocator, ast.Item{ .event_decl = ast.EventDecl{
                .path = H.mkPathH(allocator, flow.module, pwritec_name),
                .input = ast.Shape{ .fields = cin_fields },
                .branches = c_branches,
                .is_public = false,
                .is_implicit_flow = false,
                .annotations = &[_][]const u8{},
                .location = flow.location,
                .module = allocator.dupe(u8, flow.module) catch unreachable,
            } }) catch unreachable;
            // The forward fills every per-field slot: `value` lands in the
            // parent slot (writec guards ONLY the synthesized parent write —
            // the stored transform enforces target_field == "parent"); the
            // other slots are zeros the parent arm never reads.
            var cw_slots = std.ArrayList(u8).initCapacity(allocator, 64) catch unreachable;
            for (0..field_names.len) |ci| {
                if (ci == user_field_count) {
                    const s = std.fmt.allocPrint(allocator, ", .value_{d} = value", .{ci}) catch unreachable;
                    cw_slots.appendSlice(allocator, s) catch unreachable;
                } else {
                    // A char slot's typed zero is the empty string (the slot
                    // type is `string`); scalars ride comptime-int 0.
                    const s = if (field_char_caps[ci] != null)
                        std.fmt.allocPrint(allocator, ", .value_{d} = \"\"", .{ci}) catch unreachable
                    else
                        std.fmt.allocPrint(allocator, ", .value_{d} = 0", .{ci}) catch unreachable;
                    cw_slots.appendSlice(allocator, s) catch unreachable;
                }
            }
            const cbody = std.fmt.allocPrint(allocator,
                \\var __koru_cyc = value;
                \\while (__koru_cyc != -1) {{
                \\    if (__koru_cyc == row) return .{{ .cycle = .{{}} }};
                \\    __koru_cyc = __koru_store_{s}.parent[@as(usize, @intCast(__koru_cyc))];
                \\}}
                \\main_module.__store_write_{s}_event.handler(.{{ .row = row, .field = field{s} }});
                \\return .{{ .ok = .{{}} }};
            , .{ store_name, store_name, cw_slots.items }) catch unreachable;
            appended_items.append(allocator, ast.Item{ .proc_decl = ast.ProcDecl{
                .path = H.mkPathH(allocator, flow.module, pwritec_name),
                .body = ast.Source{ .text = cbody, .location = flow.location, .scope = .{ .bindings = &[_]ast.ScopeBinding{} }, .phantom_type = null },
                .annotations = &[_][]const u8{},
                .target = allocator.dupe(u8, "zig") catch unreachable,
                .location = flow.location,
                .module = allocator.dupe(u8, flow.module) catch unreachable,
            } }) catch unreachable;
        }

        // ---- unit 3: per-query units (qrow / qbody / qsweep) ----
        for (qsites.items) |*qs| {
            const qrow_name = std.fmt.allocPrint(allocator, "__store_qrow_{s}_L{d}", .{ store_name, qs.line }) catch unreachable;
            const qbody_name = std.fmt.allocPrint(allocator, "__store_qbody_{s}_L{d}", .{ store_name, qs.line }) catch unreachable;
            const qsweep_name = std.fmt.allocPrint(allocator, "__store_qsweep_{s}_L{d}", .{ store_name, qs.line }) catch unreachable;

            // qrow: guard + projection over one row; fires the body event.
            const qrow_in = allocator.alloc(ast.Field, 1) catch unreachable;
            qrow_in[0] = ast.Field{ .name = allocator.dupe(u8, "row") catch unreachable, .type = allocator.dupe(u8, "i64") catch unreachable };
            const retain_ann = blk: {
                const anns = allocator.alloc([]const u8, 1) catch unreachable;
                anns[0] = allocator.dupe(u8, "retain") catch unreachable;
                break :blk anns;
            };
            appended_items.append(allocator, ast.Item{ .event_decl = ast.EventDecl{
                .path = H.mkPathH(allocator, flow.module, qrow_name),
                .input = ast.Shape{ .fields = qrow_in },
                .branches = &[_]ast.Branch{},
                .is_public = false,
                .is_implicit_flow = false,
                .annotations = retain_ann,
                .location = flow.location,
                .module = allocator.dupe(u8, flow.module) catch unreachable,
            } }) catch unreachable;

            var qr = std.ArrayList(u8).initCapacity(allocator, 256) catch unreachable;
            qr.appendSlice(allocator, "const __koru_r = @as(usize, @intCast(row));\n") catch unreachable;
            for (qs.proj_names, qs.proj_fields) |pname, pfidx| {
                // A char column projects as a string slice into the cell —
                // the bytes up to the first NUL (zero-padded buffers trim;
                // an N-full buffer yields all N bytes).
                const ld = if (field_char_caps[pfidx] != null)
                    std.fmt.allocPrint(allocator, "const {s} = @import(\"std\").mem.sliceTo(&__koru_store_{s}.{s}[__koru_r], 0);\n_ = &{s};\n", .{ pname, store_name, field_names[pfidx], pname }) catch unreachable
                else
                    std.fmt.allocPrint(allocator, "const {s} = __koru_store_{s}.{s}[__koru_r];\n_ = &{s};\n", .{ pname, store_name, field_names[pfidx], pname }) catch unreachable;
                qr.appendSlice(allocator, ld) catch unreachable;
            }
            if (qs.guard) |g| {
                const gz = std.fmt.allocPrint(allocator, "if (!({s})) return;\n", .{g}) catch unreachable;
                qr.appendSlice(allocator, gz) catch unreachable;
            }
            qr.appendSlice(allocator, "main_module.") catch unreachable;
            qr.appendSlice(allocator, qbody_name) catch unreachable;
            qr.appendSlice(allocator, "_event.handler(.{ ") catch unreachable;
            for (qs.proj_names, 0..) |pname, i| {
                if (i > 0) qr.appendSlice(allocator, ", ") catch unreachable;
                const p = std.fmt.allocPrint(allocator, ".{s} = {s}", .{ pname, pname }) catch unreachable;
                qr.appendSlice(allocator, p) catch unreachable;
            }
            if (qs.proj_names.len > 0) qr.appendSlice(allocator, ", ") catch unreachable;
            qr.appendSlice(allocator, ".__koru_qrow = row });\nreturn;") catch unreachable;
            appended_items.append(allocator, ast.Item{ .proc_decl = ast.ProcDecl{
                .path = H.mkPathH(allocator, flow.module, qrow_name),
                .body = ast.Source{ .text = qr.toOwnedSlice(allocator) catch unreachable, .location = flow.location, .scope = .{ .bindings = &[_]ast.ScopeBinding{} }, .phantom_type = null },
                .annotations = &[_][]const u8{},
                .target = allocator.dupe(u8, "zig") catch unreachable,
                .location = flow.location,
                .module = allocator.dupe(u8, flow.module) catch unreachable,
            } }) catch unreachable;

            // qbody: the transplanted body as an impl flow; inputs = the
            // projected names + the row cursor.
            const qbody_in = allocator.alloc(ast.Field, qs.proj_names.len + 1) catch unreachable;
            for (qs.proj_names, qs.proj_fields, 0..) |pname, pfidx, i| {
                // An owned column projects as a BARE borrow `*mod:Type<mod:state>`
                // (no `!`): `read` accepts the bare state and consumes nothing, so
                // the qbody carries no obligation to discharge and the store keeps
                // the live `<state!>` it frees at teardown. Scalars/char project
                // their value type directly.
                qbody_in[i] = if (field_owned_info[pfidx]) |oi| ast.Field{
                    .name = allocator.dupe(u8, pname) catch unreachable,
                    .type = allocator.dupe(u8, field_types[pfidx]) catch unreachable,
                    .module_path = allocator.dupe(u8, oi.module_slash) catch unreachable,
                    .phantom = std.fmt.allocPrint(allocator, "{s}:{s}", .{ oi.module_dot, oi.state }) catch unreachable,
                } else ast.Field{ .name = allocator.dupe(u8, pname) catch unreachable, .type = allocator.dupe(u8, field_types[pfidx]) catch unreachable };
            }
            qbody_in[qs.proj_names.len] = ast.Field{ .name = allocator.dupe(u8, "__koru_qrow") catch unreachable, .type = allocator.dupe(u8, "i64") catch unreachable };
            appended_items.append(allocator, ast.Item{ .event_decl = ast.EventDecl{
                .path = H.mkPathH(allocator, flow.module, qbody_name),
                .input = ast.Shape{ .fields = qbody_in },
                .branches = &[_]ast.Branch{},
                .is_public = false,
                .is_implicit_flow = false,
                .annotations = retain_ann,
                .location = flow.location,
                .module = allocator.dupe(u8, flow.module) catch unreachable,
            } }) catch unreachable;

            const body_node = qs.body.node orelse {
                return .{ .transformed = .{ .replacement = H.errItem(allocator, flow.location, flow.module, "std/store:query({s}): the query branch needs a body (`|> ...`)", .{store_name}) } };
            };
            if (body_node != .invocation) {
                return .{ .transformed = .{ .replacement = H.errItem(allocator, flow.location, flow.module, "std/store:query({s}): the query body must start with an invocation this rung", .{store_name}) } };
            }
            appended_items.append(allocator, ast.Item{ .flow = ast.Flow{
                .body = ast.rootSite(body_node.invocation, qs.body.continuations, flow.location),
                .pre_label = null,
                .impl_of = H.mkPathH(allocator, flow.module, qbody_name),
                .super_shape = null,
                .inline_body = null,
                .preamble_code = null,
                .is_pure = false,
                .is_transitively_pure = false,
                .location = flow.location,
                .module = allocator.dupe(u8, flow.module) catch unreachable,
            } }) catch unreachable;

            // qsweep: the imperative sweep over the rows that exist when
            // the query's program position executes.
            appended_items.append(allocator, ast.Item{ .event_decl = ast.EventDecl{
                .path = H.mkPathH(allocator, flow.module, qsweep_name),
                .input = ast.Shape{ .fields = &[_]ast.Field{} },
                .branches = &[_]ast.Branch{},
                .is_public = false,
                .is_implicit_flow = false,
                .annotations = &[_][]const u8{},
                .location = flow.location,
                .module = allocator.dupe(u8, flow.module) catch unreachable,
            } }) catch unreachable;
            // The sweep tolerates a query body that REMOVES its own row (a
            // `take` under the query branch). swap-remove drops the last row
            // into the freed slot, so when the len shrinks we must re-check the
            // SAME index — the swapped-in row has not been seen — rather than
            // advance past it. A body that leaves len unchanged advances
            // normally, so non-mutating queries are byte-identical (690_031).
            //
            // A PREORDER site sweeps the forest in DFS pre-order instead
            // (695_STORE_TREE TT5): roots (parent == -1) in ascending
            // insertion order, each node emitted before its children,
            // children in ascending insertion order. Explicit stack, pushed
            // in reverse so the lowest index pops first; every row is pushed
            // at most once (as a root, or by its unique parent), so CAP
            // bounds the stack. The naive O(n^2) child scan is the
            // correctness rung.
            const sweep_body = if (qs.is_preorder) std.fmt.allocPrint(allocator,
                \\var __koru_stack: [{d}]usize = undefined;
                \\var __koru_sp: usize = 0;
                \\var __koru_i: usize = __koru_store_{s}.len;
                \\while (__koru_i > 0) {{
                \\    __koru_i -= 1;
                \\    if (__koru_store_{s}.parent[__koru_i] == -1) {{
                \\        __koru_stack[__koru_sp] = __koru_i;
                \\        __koru_sp += 1;
                \\    }}
                \\}}
                \\while (__koru_sp > 0) {{
                \\    __koru_sp -= 1;
                \\    const __koru_cur = __koru_stack[__koru_sp];
                \\    main_module.{s}_event.handler(.{{ .row = @as(i64, @intCast(__koru_cur)) }});
                \\    var __koru_j: usize = __koru_store_{s}.len;
                \\    while (__koru_j > 0) {{
                \\        __koru_j -= 1;
                \\        if (__koru_store_{s}.parent[__koru_j] == @as(i64, @intCast(__koru_cur))) {{
                \\            __koru_stack[__koru_sp] = __koru_j;
                \\            __koru_sp += 1;
                \\        }}
                \\    }}
                \\}}
                \\return;
            , .{ CAP, store_name, store_name, qrow_name, store_name, store_name }) catch unreachable else std.fmt.allocPrint(allocator,
                \\var __koru_i: usize = 0;
                \\while (__koru_i < __koru_store_{s}.len) {{
                \\    const __koru_len_before = __koru_store_{s}.len;
                \\    main_module.{s}_event.handler(.{{ .row = @as(i64, @intCast(__koru_i)) }});
                \\    if (__koru_store_{s}.len >= __koru_len_before) __koru_i += 1;
                \\}}
                \\return;
            , .{ store_name, store_name, qrow_name, store_name }) catch unreachable;
            appended_items.append(allocator, ast.Item{ .proc_decl = ast.ProcDecl{
                .path = H.mkPathH(allocator, flow.module, qsweep_name),
                .body = ast.Source{ .text = sweep_body, .location = flow.location, .scope = .{ .bindings = &[_]ast.ScopeBinding{} }, .phantom_type = null },
                .annotations = &[_][]const u8{},
                .target = allocator.dupe(u8, "zig") catch unreachable,
                .location = flow.location,
                .module = allocator.dupe(u8, flow.module) catch unreachable,
            } }) catch unreachable;
        }

        // ---- unit 5: take — swap-remove through the handle head ----
        {
            const take_name = std.fmt.allocPrint(allocator, "__store_take_{s}", .{store_name}) catch unreachable;
            const take_in = allocator.alloc(ast.Field, 1) catch unreachable;
            take_in[0] = ast.Field{ .name = allocator.dupe(u8, "row") catch unreachable, .type = allocator.dupe(u8, "i64") catch unreachable };
            // Identity payload: the row VALUE. A BARE store mints NO obligation
            // (frictionless remove-with-value). An `[entity(<name>)]` store mints
            // the stable `<std/store:taken!>` obligation on the NAMED entity type
            // — the per-store disposal contract. The user then authors the
            // discharger consuming `<std/store:!taken>`; the store presumes nothing.
            // State is module-qualified (cross-module nameable); base type stays
            // on the user module via field.module_path so writeFieldType does not
            // confuse type-home with state-home (frag-std-store-design.md rung 2).
            // An owned-string store's take payload is a STRUCT of the row's
            // fields (not the identity `__type_ref` row) so the owned column
            // can REISSUE its obligation per field: `i.name` leaves take
            // holding <std.string:instance!> (dot-canonical — the form
            // std/string's own states canonicalize to today), and scope-exit
            // auto-discharge resolves the canonical discharger
            // (std/string:free) across the module boundary — the record-field
            // seeding both checkers already run on branch payloads.
            const item_pf = if (has_owned) blk: {
                const pf = allocator.alloc(ast.Field, field_names.len) catch unreachable;
                for (field_names, field_types, field_owned_info, 0..) |pfname, pftype, pfoi, pfi| {
                    pf[pfi] = ast.Field{
                        .name = allocator.dupe(u8, pfname) catch unreachable,
                        .type = allocator.dupe(u8, pftype) catch unreachable,
                        .module_path = if (pfoi) |oi| allocator.dupe(u8, oi.module_slash) catch unreachable else null,
                        .phantom = if (pfoi) |oi| std.fmt.allocPrint(allocator, "{s}:{s}!", .{ oi.module_dot, oi.state }) catch unreachable else null,
                    };
                }
                break :blk pf;
            } else blk: {
                const pf = allocator.alloc(ast.Field, 1) catch unreachable;
                pf[0] = ast.Field{
                    .name = allocator.dupe(u8, "__type_ref") catch unreachable,
                    .type = if (entity_type) |et| allocator.dupe(u8, et) catch unreachable else std.fmt.allocPrint(allocator, "__KoruStoreRow_{s}", .{store_name}) catch unreachable,
                    .module_path = if (entity_type != null) allocator.dupe(u8, flow.module) catch unreachable else null,
                    .phantom = if (entity_type != null) allocator.dupe(u8, "std/store:taken!") catch unreachable else null,
                };
                break :blk pf;
            };
            const take_branches = allocator.alloc(ast.Branch, 1) catch unreachable;
            take_branches[0] = ast.Branch{
                .name = allocator.dupe(u8, "item") catch unreachable,
                .payload = ast.Shape{ .fields = item_pf },
                .kind = .terminal,
                .annotations = &[_][]const u8{},
            };
            appended_items.append(allocator, ast.Item{ .event_decl = ast.EventDecl{
                .path = H.mkPathH(allocator, flow.module, take_name),
                .input = ast.Shape{ .fields = take_in },
                .branches = take_branches,
                .is_public = false,
                .is_implicit_flow = false,
                .annotations = &[_][]const u8{},
                .location = flow.location,
                .module = allocator.dupe(u8, flow.module) catch unreachable,
            } }) catch unreachable;

            var tb = std.ArrayList(u8).initCapacity(allocator, 256) catch unreachable;
            const thead = std.fmt.allocPrint(allocator,
                \\const __koru_r = @as(usize, @intCast(row));
                \\if (__koru_r >= __koru_store_{s}.len) @panic("std/store: take({s}[...]) - row handle out of range (generational staleness checks are O10)");
                \\
            , .{ store_name, store_name }) catch unreachable;
            tb.appendSlice(allocator, thead) catch unreachable;
            for (field_names) |fname| {
                const ld = std.fmt.allocPrint(allocator, "const __koru_out_{s} = __koru_store_{s}.{s}[__koru_r];\n", .{ fname, store_name, fname }) catch unreachable;
                tb.appendSlice(allocator, ld) catch unreachable;
            }
            // `removed` lifecycle interceptors fire before the swap-remove, with
            // the row's outgoing values (the qbody pattern, take side).
            for (removed_arms.items, 0..) |arm, ai| {
                const head = std.fmt.allocPrint(allocator, "main_module.__store_removed_{s}_{d}_event.handler(.{{ ", .{ store_name, ai }) catch unreachable;
                tb.appendSlice(allocator, head) catch unreachable;
                for (arm.fields, 0..) |fnm, fi| {
                    if (fi > 0) tb.appendSlice(allocator, ", ") catch unreachable;
                    // A char field's payload is the NUL-trimmed slice of the
                    // outgoing COPY (`__koru_out_*` outlives the handler call;
                    // the cell slot is about to be swap-clobbered).
                    const fnm_is_char = blk: {
                        for (field_names, field_char_caps) |cn, cc| {
                            if (std.mem.eql(u8, cn, fnm)) break :blk cc != null;
                        }
                        break :blk false;
                    };
                    const p = if (fnm_is_char)
                        std.fmt.allocPrint(allocator, ".{s} = @import(\"std\").mem.sliceTo(&__koru_out_{s}, 0)", .{ fnm, fnm }) catch unreachable
                    else
                        std.fmt.allocPrint(allocator, ".{s} = __koru_out_{s}", .{ fnm, fnm }) catch unreachable;
                    tb.appendSlice(allocator, p) catch unreachable;
                }
                tb.appendSlice(allocator, " });\n") catch unreachable;
            }
            const swap = std.fmt.allocPrint(allocator, "const __koru_last = __koru_store_{s}.len - 1;\nif (__koru_r != __koru_last) {{\n", .{store_name}) catch unreachable;
            tb.appendSlice(allocator, swap) catch unreachable;
            for (field_names) |fname| {
                const mv = std.fmt.allocPrint(allocator, "    __koru_store_{s}.{s}[__koru_r] = __koru_store_{s}.{s}[__koru_last];\n", .{ store_name, fname, store_name, fname }) catch unreachable;
                tb.appendSlice(allocator, mv) catch unreachable;
            }
            const tail = std.fmt.allocPrint(allocator, "}}\n__koru_store_{s}.len = __koru_last;\n", .{store_name}) catch unreachable;
            tb.appendSlice(allocator, tail) catch unreachable;
            tb.appendSlice(allocator, "return .{ .item = .{ ") catch unreachable;
            for (field_names, 0..) |fname, i| {
                if (i > 0) tb.appendSlice(allocator, ", ") catch unreachable;
                const o = std.fmt.allocPrint(allocator, ".{s} = __koru_out_{s}", .{ fname, fname }) catch unreachable;
                tb.appendSlice(allocator, o) catch unreachable;
            }
            tb.appendSlice(allocator, " } };") catch unreachable;
            appended_items.append(allocator, ast.Item{ .proc_decl = ast.ProcDecl{
                .path = H.mkPathH(allocator, flow.module, take_name),
                .body = ast.Source{ .text = tb.toOwnedSlice(allocator) catch unreachable, .location = flow.location, .scope = .{ .bindings = &[_]ast.ScopeBinding{} }, .phantom_type = null },
                .annotations = &[_][]const u8{},
                .target = allocator.dupe(u8, "zig") catch unreachable,
                .location = flow.location,
                .module = allocator.dupe(u8, flow.module) catch unreachable,
            } }) catch unreachable;
        }

        // ---- lifecycle interceptor units (inserted/removed, 690_016) ----
        // Each arm becomes an event whose inputs are its destructured row
        // fields plus an impl flow carrying the transplanted body (the qbody
        // pattern). `retain` keeps them alive — their only caller is the
        // generated host code in the insert/take procs. The store-name rewrite
        // is a no-op over `std/store:stored` invocations (they resolve their
        // own target) but keeps non-store body references (e.g. an interpolated
        // sibling-store read) coherent, matching watch-body treatment.
        {
            const LC = struct {
                fn emit(
                    alloc: std.mem.Allocator,
                    items: *std.ArrayList(ast.Item),
                    module: []const u8,
                    loc: anytype,
                    ev_name: []const u8,
                    arm_fields: []const []const u8,
                    arm_types: []const []const u8,
                    arm_owned: []const ?OwnedCol,
                    arm_body: *const ast.Continuation,
                    pnames: []const []const u8,
                ) void {
                    const ev_in = alloc.alloc(ast.Field, arm_fields.len) catch unreachable;
                    for (arm_fields, arm_types, arm_owned, 0..) |fnm, ftp, aoi, fi| {
                        // An owned column binds into the reactive arm as a BARE
                        // borrow `*mod:Type<mod:state>` (no `!`): the interceptor
                        // reads it (read accepts the bare state, consumes nothing)
                        // while the store keeps the live <state!> it frees at
                        // teardown — 690_060's query projection, now in the
                        // `inserted` arm (690_061). Scalars/char bind their value.
                        ev_in[fi] = if (aoi) |oi| ast.Field{
                            .name = alloc.dupe(u8, fnm) catch unreachable,
                            .type = alloc.dupe(u8, ftp) catch unreachable,
                            .module_path = alloc.dupe(u8, oi.module_slash) catch unreachable,
                            .phantom = std.fmt.allocPrint(alloc, "{s}:{s}", .{ oi.module_dot, oi.state }) catch unreachable,
                        } else ast.Field{ .name = alloc.dupe(u8, fnm) catch unreachable, .type = alloc.dupe(u8, ftp) catch unreachable };
                    }
                    const retain = blk: {
                        const anns = alloc.alloc([]const u8, 1) catch unreachable;
                        anns[0] = alloc.dupe(u8, "retain") catch unreachable;
                        break :blk anns;
                    };
                    items.append(alloc, ast.Item{ .event_decl = ast.EventDecl{
                        .path = H.mkPathH(alloc, module, ev_name),
                        .input = ast.Shape{ .fields = ev_in },
                        .branches = &[_]ast.Branch{},
                        .is_public = false,
                        .is_implicit_flow = false,
                        .annotations = retain,
                        .location = loc,
                        .module = alloc.dupe(u8, module) catch unreachable,
                    } }) catch unreachable;
                    var body_clone = ast_functional.cloneContinuation(alloc, arm_body) catch unreachable;
                    H.storeRefsContH(alloc, &body_clone, pnames);
                    const lbody_node = body_clone.node.?;
                    items.append(alloc, ast.Item{ .flow = ast.Flow{
                        .body = ast.rootSite(lbody_node.invocation, body_clone.continuations, loc),
                        .pre_label = null,
                        .impl_of = H.mkPathH(alloc, module, ev_name),
                        .super_shape = null,
                        .inline_body = null,
                        .preamble_code = null,
                        .is_pure = false,
                        .is_transitively_pure = false,
                        .location = loc,
                        .module = alloc.dupe(u8, module) catch unreachable,
                    } }) catch unreachable;
                }
            };
            // Interceptor payload types: inserted/removed bind ROW FIELDS by
            // name — each gets its column's type. updated binds {old, new} —
            // the written field's images; its bind form is walled to
            // uniform-typed containers above, so the shared column type is
            // exact (the discard form has no payload to type).
            const colTypes = struct {
                fn call(alloc: std.mem.Allocator, names: []const []const u8, types: []const []const u8, wanted: []const []const u8) []const []const u8 {
                    const out = alloc.alloc([]const u8, wanted.len) catch unreachable;
                    for (wanted, 0..) |w, i| {
                        out[i] = blk: {
                            for (names, types) |n, t| {
                                if (std.mem.eql(u8, n, w)) break :blk t;
                            }
                            unreachable; // arm fields were validated against field_names at collection
                        };
                    }
                    return out;
                }
            }.call;
            // Parallel of colTypes: the OwnedCol info per arm field (null for
            // scalar/char), so the reactive arm binds an owned column as a bare
            // borrow (690_061). Non-owned stores get all-null — a no-op.
            const colOwned = struct {
                fn call(alloc: std.mem.Allocator, names: []const []const u8, owned: []const ?OwnedCol, wanted: []const []const u8) []const ?OwnedCol {
                    const out = alloc.alloc(?OwnedCol, wanted.len) catch unreachable;
                    for (wanted, 0..) |w, i| {
                        out[i] = blk: {
                            for (names, owned) |n, o| {
                                if (std.mem.eql(u8, n, w)) break :blk o;
                            }
                            break :blk null;
                        };
                    }
                    return out;
                }
            }.call;
            for (inserted_arms.items, 0..) |*arm, ai| {
                const ev_name = std.fmt.allocPrint(allocator, "__store_inserted_{s}_{d}", .{ store_name, ai }) catch unreachable;
                LC.emit(allocator, &appended_items, flow.module, flow.location, ev_name, arm.fields, colTypes(allocator, field_names, field_types, arm.fields), colOwned(allocator, field_names, field_owned_info, arm.fields), &arm.body, pstore_names.items);
            }
            for (removed_arms.items, 0..) |*arm, ai| {
                const ev_name = std.fmt.allocPrint(allocator, "__store_removed_{s}_{d}", .{ store_name, ai }) catch unreachable;
                LC.emit(allocator, &appended_items, flow.module, flow.location, ev_name, arm.fields, colTypes(allocator, field_names, field_types, arm.fields), colOwned(allocator, field_names, field_owned_info, arm.fields), &arm.body, pstore_names.items);
            }
            for (updated_arms.items, 0..) |*arm, ai| {
                const ev_name = std.fmt.allocPrint(allocator, "__store_updated_{s}_{d}", .{ store_name, ai }) catch unreachable;
                const utypes = allocator.alloc([]const u8, arm.fields.len) catch unreachable;
                for (utypes) |*ut| ut.* = if (field_types.len > 0) field_types[0] else "i64";
                LC.emit(allocator, &appended_items, flow.module, flow.location, ev_name, arm.fields, utypes, colOwned(allocator, field_names, field_owned_info, arm.fields), &arm.body, pstore_names.items);
            }
        }

        // Rung 0 (per-store disposal contract): the store provides NO disposal
        // verb. A BARE store's `take` carries no obligation (frictionless). When
        // a store opts in via `[entity(<name>)]`, `take` mints `<std/store:taken!>`
        // on the named row type and the USER authors the discharger (the despawn
        // handler consuming `<!std/store:taken>`) — the store never presumes how
        // to dispose. (give-back / destroy as store-provided verbs are retired.)

        // ---- stripe unit: __store_stripe_<s> fires the standing rules'
        // qsweeps in depends_on topo order (rung: naive per-rule passes;
        // fusion is a later, semantics-preserving scheduling change). With
        // zero rules the unit is a void no-op, so stripe of a rule-less
        // store is legal and does nothing. The existing stripe VERB rewrite
        // targets this unit wherever the call sits — including inlined
        // effect-branch bodies (the per-frame firing point).
        {
            const pstripe_name = std.fmt.allocPrint(allocator, "__store_stripe_{s}", .{store_name}) catch unreachable;
            appended_items.append(allocator, ast.Item{ .event_decl = ast.EventDecl{
                .path = H.mkPathH(allocator, flow.module, pstripe_name),
                .input = ast.Shape{ .fields = &[_]ast.Field{} },
                .branches = &[_]ast.Branch{},
                .is_public = false,
                .is_implicit_flow = false,
                .annotations = &[_][]const u8{},
                .location = flow.location,
                .module = allocator.dupe(u8, flow.module) catch unreachable,
            } }) catch unreachable;
            // Preorder walks are program-position traversals, never standing
            // rules — they do not join the stripe.
            {
                var filtered = std.ArrayList(usize).initCapacity(allocator, stripe_order.items.len) catch unreachable;
                for (stripe_order.items) |qi| {
                    if (!qsites.items[qi].is_preorder) filtered.append(allocator, qi) catch unreachable;
                }
                stripe_order = filtered;
            }
            if (stripe_order.items.len == 0) {
                appended_items.append(allocator, ast.Item{ .proc_decl = ast.ProcDecl{
                    .path = H.mkPathH(allocator, flow.module, pstripe_name),
                    .body = ast.Source{ .text = allocator.dupe(u8, "return;") catch unreachable, .location = flow.location, .scope = .{ .bindings = &[_]ast.ScopeBinding{} }, .phantom_type = null },
                    .annotations = &[_][]const u8{},
                    .target = allocator.dupe(u8, "zig") catch unreachable,
                    .location = flow.location,
                    .module = allocator.dupe(u8, flow.module) catch unreachable,
                } }) catch unreachable;
            } else {
                // Impl flow: qsweep calls chained as sequential void steps,
                // nested back-to-front so execution follows stripe_order.
                var chain: ?ast.Continuation = null;
                var k = stripe_order.items.len;
                while (k > 1) : (k -= 1) {
                    const qidx = stripe_order.items[k - 1];
                    const qn = std.fmt.allocPrint(allocator, "__store_qsweep_{s}_L{d}", .{ store_name, qsites.items[qidx].line }) catch unreachable;
                    var step = ast.Continuation{
                        .branch = allocator.dupe(u8, "") catch unreachable,
                        .binding = null,
                        .kind = .terminal,
                        .condition = null,
                        .node = .{ .invocation = ast.Invocation{
                            .path = H.mkPathH(allocator, flow.module, qn),
                            .args = &[_]ast.Arg{},
                        } },
                        .indent = 1,
                        .continuations = &[_]ast.Continuation{},
                        .is_transformed_subtree = true,
                        .location = flow.location,
                    };
                    if (chain) |c| {
                        const kids = allocator.alloc(ast.Continuation, 1) catch unreachable;
                        kids[0] = c;
                        step.continuations = kids;
                    }
                    chain = step;
                }
                const head_name = std.fmt.allocPrint(allocator, "__store_qsweep_{s}_L{d}", .{ store_name, qsites.items[stripe_order.items[0]].line }) catch unreachable;
                const head_inv = ast.Invocation{
                    .path = H.mkPathH(allocator, flow.module, head_name),
                    .args = &[_]ast.Arg{},
                };
                var head_conts: []ast.Continuation = &[_]ast.Continuation{};
                if (chain) |c| {
                    const kids = allocator.alloc(ast.Continuation, 1) catch unreachable;
                    kids[0] = c;
                    head_conts = kids;
                }
                appended_items.append(allocator, ast.Item{ .flow = ast.Flow{
                    .body = ast.rootSite(head_inv, head_conts, flow.location),
                    .pre_label = null,
                    .impl_of = H.mkPathH(allocator, flow.module, pstripe_name),
                    .super_shape = null,
                    .inline_body = null,
                    .preamble_code = null,
                    .is_pure = false,
                    .is_transitively_pure = false,
                    .location = flow.location,
                    .module = allocator.dupe(u8, flow.module) catch unreachable,
                } }) catch unreachable;
            }
        }

        // ---- teardown unit (owned-string stores only, 690_053) ----
        // The store OWNS its live elements; at program end each still-live
        // owned pointer is discharged through the canonical discharger's
        // handler (std/string:free — the same call auto-discharge inserts,
        // 690_036's cross-module resolution done at generation time). The
        // teardown FLOW is appended LAST, and appended items land at the END
        // of program.items (transform_pass_runner), so it runs after every
        // user flow — before the emitter's leak check.
        if (has_owned) {
            const td_name = std.fmt.allocPrint(allocator, "__store_teardown_{s}", .{store_name}) catch unreachable;
            // Drain (690_057): the teardown event declares the `! discharge`
            // EFFECT branch (the 400_105 producer shape). Its payload is the
            // ROW RECORD — every column as a field, the ambiguous owned
            // fields carrying `<state!>` (dot-canonical, the take-item form)
            // so the phantom checker FORCES the user's handler to discharge
            // each fired element. That per-element forcing IS the drain
            // enforcement; the store adds no manual check.
            var td_branches: []ast.Branch = &[_]ast.Branch{};
            if (drain_required) {
                const dpf = allocator.alloc(ast.Field, field_names.len) catch unreachable;
                for (field_names, field_types, field_owned_info, 0..) |pfname, pftype, pfoi, pfi| {
                    dpf[pfi] = ast.Field{
                        .name = allocator.dupe(u8, pfname) catch unreachable,
                        .type = allocator.dupe(u8, pftype) catch unreachable,
                        .module_path = if (pfoi) |oi| allocator.dupe(u8, oi.module_slash) catch unreachable else null,
                        .phantom = if (pfoi) |oi| std.fmt.allocPrint(allocator, "{s}:{s}!", .{ oi.module_dot, oi.state }) catch unreachable else null,
                    };
                }
                const tdb = allocator.alloc(ast.Branch, 1) catch unreachable;
                tdb[0] = ast.Branch{
                    .name = allocator.dupe(u8, "discharge") catch unreachable,
                    .payload = ast.Shape{ .fields = dpf },
                    .kind = .effect,
                };
                td_branches = tdb;
            }
            appended_items.append(allocator, ast.Item{ .event_decl = ast.EventDecl{
                .path = H.mkPathH(allocator, flow.module, td_name),
                .input = ast.Shape{ .fields = &[_]ast.Field{} },
                .branches = td_branches,
                .is_public = false,
                .is_implicit_flow = false,
                .annotations = &[_][]const u8{},
                .location = flow.location,
                .module = allocator.dupe(u8, flow.module) catch unreachable,
            } }) catch unreachable;
            var td = std.ArrayList(u8).initCapacity(allocator, 256) catch unreachable;
            const td_head = std.fmt.allocPrint(allocator, "for (0..__koru_store_{s}.len) |__koru_i| {{\n", .{store_name}) catch unreachable;
            td.appendSlice(allocator, td_head) catch unreachable;
            if (drain_required) {
                // Fire the user's `! discharge` handler with the row record —
                // the 400_105 producer move (`make(r)`), record payload per
                // 400_079: `discharge(.{ .f = col[i], ... })`. Ownership of
                // each ambiguous element moves OUT through the payload; the
                // handler is forced to discharge it within the firing.
                td.appendSlice(allocator, "    discharge(.{ ") catch unreachable;
                for (field_names, 0..) |fname, fi| {
                    if (fi > 0) td.appendSlice(allocator, ", ") catch unreachable;
                    const p = std.fmt.allocPrint(allocator, ".{s} = __koru_store_{s}.{s}[__koru_i]", .{ fname, store_name, fname }) catch unreachable;
                    td.appendSlice(allocator, p) catch unreachable;
                }
                td.appendSlice(allocator, " });\n") catch unreachable;
            } else {
                for (field_names, field_owned_info) |fname, foi| {
                    const oi = foi orelse continue;
                    // Discharge each live element through the DISCOVERED canonical
                    // discharger: <host>.<event>_event.handler(.{ .<param> = elem }),
                    // the same `<name>_event.handler` convention every emitted call
                    // uses (buildKoruModulePath). std/string's `free` is just one
                    // instance; a user *Resource routes to its own `free`/`close`.
                    const fr = std.fmt.allocPrint(allocator, "    _ = {s}.{s}_event.handler(.{{ .{s} = __koru_store_{s}.{s}[__koru_i] }});\n", .{ oi.disch_host, oi.disch_event, oi.disch_param, store_name, fname }) catch unreachable;
                    td.appendSlice(allocator, fr) catch unreachable;
                }
            }
            const td_tail = std.fmt.allocPrint(allocator, "}}\n__koru_store_{s}.len = 0;\nreturn;", .{store_name}) catch unreachable;
            td.appendSlice(allocator, td_tail) catch unreachable;
            appended_items.append(allocator, ast.Item{ .proc_decl = ast.ProcDecl{
                .path = H.mkPathH(allocator, flow.module, td_name),
                .body = ast.Source{ .text = td.toOwnedSlice(allocator) catch unreachable, .location = flow.location, .scope = .{ .bindings = &[_]ast.ScopeBinding{} }, .phantom_type = null },
                .annotations = &[_][]const u8{},
                .target = allocator.dupe(u8, "zig") catch unreachable,
                .location = flow.location,
                .module = allocator.dupe(u8, flow.module) catch unreachable,
            } }) catch unreachable;
            const td_inv = ast.Invocation{
                .path = H.mkPathH(allocator, flow.module, td_name),
                .args = &[_]ast.Arg{},
            };
            // The user's `! discharge item |> ...` continuation rides the
            // teardown flow as its handler — the consumer half of 400_105
            // (`! make r |> destroy(r)`), verbatim from the store declaration.
            var td_conts: []ast.Continuation = &[_]ast.Continuation{};
            if (discharge_arm) |da| {
                const tdc = allocator.alloc(ast.Continuation, 1) catch unreachable;
                tdc[0] = da;
                td_conts = tdc;
            }
            appended_items.append(allocator, ast.Item{ .flow = ast.Flow{
                .body = ast.rootSite(td_inv, td_conts, flow.location),
                .pre_label = null,
                .impl_of = null,
                .super_shape = null,
                .inline_body = null,
                .preamble_code = null,
                .is_pure = false,
                .is_transitively_pure = false,
                .location = flow.location,
                .module = allocator.dupe(u8, flow.module) catch unreachable,
            } }) catch unreachable;
        }

        const pconsumed = std.fmt.allocPrint(allocator, "// std/store: plural store '{s}' created (SoA cell + insert/query/write/take/stripe units)", .{store_name}) catch unreachable;
        return .{ .transformed = .{
            .replacement = ast.Item{ .host_line = ast.HostLine{
                .content = pconsumed,
                .location = flow.location,
                .module = allocator.dupe(u8, flow.module) catch unreachable,
            } },
            .appended = appended_items.toOwnedSlice(allocator) catch unreachable,
        } };
    }

    // ------------------------------------------------------------------
    // Interceptors: effect branches on create — the store's CONTRACT
    // (ruling 4). Two shapes this slice:
    //   `! <field> _`             — field interceptor, payload discarded
    //   `! updated { old, new }`  — lifecycle interceptor; flips the store's
    //                               write payload to {old,new} (the (c)
    //                               usage-synthesis lean: the old-image read
    //                               exists BECAUSE a body binds it)
    // Everything else is a loud wall.
    // ------------------------------------------------------------------
    const FieldIceptor = struct {
        field_idx: usize,
        cont: ast.Continuation,
    };
    var field_iceptors = std.ArrayList(FieldIceptor).initCapacity(allocator, 2) catch unreachable;
    var updated_iceptors = std.ArrayList(ast.Continuation).initCapacity(allocator, 2) catch unreachable;
    for (flow.body.continuations) |*ic| {
        const bname = std.mem.trim(u8, ic.branch, " ");
        if (ic.condition != null) {
            return .{ .transformed = .{ .replacement = H.errItem(allocator, flow.location, flow.module, "std/store:new({s}): guarded interceptors are a later slice - interceptors are the store's unconditional contract", .{store_name}) } };
        }
        if (std.mem.eql(u8, bname, "updated")) {
            var has_old = false;
            var has_new = false;
            for (ic.destructure) |df| {
                if (std.mem.eql(u8, df.name, "old")) has_old = true;
                if (std.mem.eql(u8, df.name, "new")) has_new = true;
            }
            if (!has_old or !has_new or ic.destructure.len != 2) {
                return .{ .transformed = .{ .replacement = H.errItem(allocator, flow.location, flow.module, "std/store:new({s}): `! updated` must destructure exactly {{ old, new }} this slice", .{store_name}) } };
            }
            updated_iceptors.append(allocator, ast_functional.cloneContinuation(allocator, ic) catch unreachable) catch unreachable;
            continue;
        }
        const fidx: usize = blk: {
            for (field_names, 0..) |fname, i| {
                if (std.mem.eql(u8, bname, fname)) break :blk i;
            }
            return .{ .transformed = .{ .replacement = H.errItem(allocator, flow.location, flow.module, "std/store:new({s}): interceptor branch '{s}' is neither a field nor `updated` (inserted/removed are rung two)", .{ store_name, bname }) } };
        };
        const b = ic.binding orelse "";
        if (!std.mem.eql(u8, b, "_")) {
            return .{ .transformed = .{ .replacement = H.errItem(allocator, flow.location, flow.module, "std/store:new({s}): field interceptor `! {s}` must discard its payload (`! {s} _`) this slice - bind values via `updated {{ old, new }}`", .{ store_name, bname, bname }) } };
        }
        field_iceptors.append(allocator, .{ .field_idx = fidx, .cont = ast_functional.cloneContinuation(allocator, ic) catch unreachable }) catch unreachable;
    }

    // ------------------------------------------------------------------
    // Collect watches: every `~std/store:watch(<this store>)` flow's
    // branches. One watch per field for now (sequencing splice = later).
    // ------------------------------------------------------------------
    const WatchArm = struct {
        field_idx: usize,
        cont: ast.Continuation,
    };
    var watch_arms = std.ArrayList(WatchArm).initCapacity(allocator, 4) catch unreachable;
    for (program.items) |pi| {
        if (pi != .flow) continue;
        const wf = &pi.flow;
        if (!H.isStoreInv(wf, "watch", store_name)) continue;
        for (wf.body.continuations) |*wc| {
            const fidx: usize = blk: {
                for (field_names, 0..) |fname, i| {
                    if (std.mem.eql(u8, std.mem.trim(u8, wc.branch, " "), fname)) break :blk i;
                }
                return .{ .transformed = .{ .replacement = H.errItem(allocator, wf.location, wf.module, "std/store:watch({s}): '{s}' is not a field of store '{s}'", .{ store_name, wc.branch, store_name }) } };
            };
            // Ruling 4: subscriptions are consumer-level and MANY - every
            // watch on a field fires, in source order (690_010).
            const cloned = ast_functional.cloneContinuation(allocator, wc) catch unreachable;
            watch_arms.append(allocator, .{ .field_idx = fidx, .cont = cloned }) catch unreachable;
        }
    }

    // ------------------------------------------------------------------
    // Cross-store guard closure (690_013): a watch on store T guarded by
    // `when S.field == ...` must re-evaluate when S.field is WRITTEN -
    // S's write path announces T's watched field (level-trigger on write;
    // edge-trigger/dedup is undesigned). Collected here, spliced into
    // this store's arms below.
    // ------------------------------------------------------------------
    const ForeignGuard = struct {
        local_field_idx: usize, // which of OUR fields the guard reads
        target_store: []const u8,
        target_field_idx: usize, // watched field's index in the target store
    };
    var foreign_guards = std.ArrayList(ForeignGuard).initCapacity(allocator, 2) catch unreachable;
    {
        const FG = struct {
            fn fieldOrderOf(alloc: std.mem.Allocator, prog: *const ast.Program, store: []const u8) ?[]const []const u8 {
                const struct_literal2 = @import("struct_literal");
                // Already-coordinated stores: read the apply event's branches.
                const apply_name2 = std.fmt.allocPrint(alloc, "__store_apply_{s}", .{store}) catch unreachable;
                for (prog.items) |pi2| {
                    if (pi2 != .event_decl) continue;
                    const ed2 = &pi2.event_decl;
                    if (ed2.path.segments.len == 1 and std.mem.eql(u8, ed2.path.segments[0], apply_name2)) {
                        const names2b = alloc.alloc([]const u8, ed2.branches.len) catch unreachable;
                        for (ed2.branches, 0..) |b2, bi2| names2b[bi2] = b2.name;
                        return names2b;
                    }
                }
                for (prog.items) |pi2| {
                    if (pi2 != .flow) continue;
                    const f2 = &pi2.flow;
                    const inv2 = f2.inv();
                    if (inv2.path.segments.len != 1 or !std.mem.eql(u8, inv2.path.segments[0], "new")) continue;
                    const mq2 = inv2.path.module_qualifier orelse continue;
                    if (!std.mem.eql(u8, mq2, "std.store")) continue;
                    var matches2 = false;
                    var seed3: ?[]const u8 = null;
                    for (inv2.args) |a2| {
                        if (std.mem.eql(u8, a2.name, "expr")) {
                            var v2 = a2.value;
                            if (v2.len >= 2 and v2[0] == '"') v2 = v2[1 .. v2.len - 1];
                            matches2 = std.mem.eql(u8, v2, store);
                        } else if (std.mem.eql(u8, a2.name, "source")) {
                            seed3 = a2.value;
                        }
                    }
                    if (!matches2 or seed3 == null) continue;
                    const braced3 = std.fmt.allocPrint(alloc, "{{{s}}}", .{seed3.?}) catch unreachable;
                    const cf3 = struct_literal2.parseFields(alloc, braced3) catch continue;
                    const names3 = alloc.alloc([]const u8, cf3.len) catch unreachable;
                    for (cf3, 0..) |c3, ci3| names3[ci3] = c3.name;
                    return names3;
                }
                return null;
            }
        };
        for (program.items) |pi| {
            if (pi != .flow) continue;
            const wfg = &pi.flow;
            if (!H.isStoreInv(wfg, "watch", null)) continue;
            var target_store: []const u8 = "";
            for (wfg.inv().args) |a| {
                if (std.mem.eql(u8, a.name, "expr")) target_store = H.stripQuotes(a.value);
            }
            if (target_store.len == 0 or std.mem.eql(u8, target_store, store_name)) continue;
            const t_order = FG.fieldOrderOf(allocator, program, target_store) orelse continue;
            for (wfg.body.continuations) |*wcg| {
                const cond = wcg.condition orelse continue;
                // Which of OUR fields does the guard read (`<store>.<field>`)?
                for (cell_fields, 0..) |cfw, lf_idx| {
                    const needle = std.fmt.allocPrint(allocator, "{s}.{s}", .{ store_name, cfw.name }) catch unreachable;
                    if (std.mem.indexOf(u8, cond, needle) == null) continue;
                    // The watched field's index in the target store.
                    const wbranch = std.mem.trim(u8, wcg.branch, " ");
                    const t_idx: usize = blk: {
                        for (t_order, 0..) |tn, ti| {
                            if (std.mem.eql(u8, tn, wbranch)) break :blk ti;
                        }
                        break :blk 0;
                    };
                    foreign_guards.append(allocator, .{
                        .local_field_idx = lf_idx,
                        .target_store = allocator.dupe(u8, target_store) catch unreachable,
                        .target_field_idx = t_idx,
                    }) catch unreachable;
                }
            }
        }
    }

    // Payload mode: an `updated` interceptor flips the store's write payload
    // to {old,new} ((c) lean — the old-image read is synthesized because a
    // body binds it). Mixing lifecycle and field-level consumers on one
    // store is a later slice.
    const old_new_mode = updated_iceptors.items.len != 0;
    if (old_new_mode and (watch_arms.items.len != 0 or field_iceptors.items.len != 0)) {
        return .{ .transformed = .{ .replacement = H.errItem(allocator, flow.location, flow.module, "std/store:new({s}): mixing `updated {{ old, new }}` with field watches/interceptors on one store is a later slice", .{store_name}) } };
    }

    // All store names visible in the program — untransformed creates plus
    // already-generated apply events — so transplanted bodies get their
    // store reads rewritten to the cells (`game.shield` in a watch body →
    // `__koru_store_game.shield`, including inside `{{ }}` interpolations).
    var store_names = std.ArrayList([]const u8).initCapacity(allocator, 4) catch unreachable;
    for (program.items) |pi| {
        switch (pi) {
            .flow => |*f| {
                if (H.isStoreInv(f, "new", null)) {
                    for (f.inv().args) |a| {
                        if (std.mem.eql(u8, a.name, "expr")) store_names.append(allocator, H.stripQuotes(a.value)) catch unreachable;
                    }
                }
            },
            .event_decl => |*ed| {
                if (ed.path.segments.len == 1 and std.mem.startsWith(u8, ed.path.segments[0], "__store_apply_")) {
                    store_names.append(allocator, ed.path.segments[0]["__store_apply_".len..]) catch unreachable;
                }
            },
            else => {},
        }
    }

    const Rewrite = struct {
        fn isIdent(ch: u8) bool {
            return (ch >= 'a' and ch <= 'z') or (ch >= 'A' and ch <= 'Z') or (ch >= '0' and ch <= '9') or ch == '_' or ch == '-';
        }
        fn storeRefs(alloc: std.mem.Allocator, text: []const u8, name: []const u8) []const u8 {
            var out = std.ArrayList(u8).initCapacity(alloc, text.len + 32) catch unreachable;
            var i: usize = 0;
            while (i < text.len) {
                const at_boundary = i == 0 or !isIdent(text[i - 1]);
                if (at_boundary and i + name.len < text.len and
                    std.mem.startsWith(u8, text[i..], name) and text[i + name.len] == '.')
                {
                    out.appendSlice(alloc, "__koru_store_") catch unreachable;
                    out.appendSlice(alloc, name) catch unreachable;
                    i += name.len;
                } else {
                    out.append(alloc, text[i]) catch unreachable;
                    i += 1;
                }
            }
            return out.toOwnedSlice(alloc) catch unreachable;
        }
        // Whole-identifier rewrite (`new` → `__koru_upd.new`), boundary-aware
        // and skipping `.field` accesses. Applied to every arg value in a
        // transplanted body, INCLUDING nested store-block sources (an
        // interceptor's `stored { ... }` value expr references these
        // bindings; the nested transform preserves them verbatim).
        fn identRefs(alloc: std.mem.Allocator, text: []const u8, name: []const u8, replacement: []const u8) []const u8 {
            var out = std.ArrayList(u8).initCapacity(alloc, text.len + 32) catch unreachable;
            var i: usize = 0;
            while (i < text.len) {
                const prev_ok = i == 0 or (!isIdent(text[i - 1]) and text[i - 1] != '.');
                const next_i = i + name.len;
                const next_ok = next_i >= text.len or !isIdent(text[next_i]);
                if (prev_ok and next_ok and next_i <= text.len and std.mem.startsWith(u8, text[i..], name)) {
                    out.appendSlice(alloc, replacement) catch unreachable;
                    i += name.len;
                } else {
                    out.append(alloc, text[i]) catch unreachable;
                    i += 1;
                }
            }
            return out.toOwnedSlice(alloc) catch unreachable;
        }
        fn rewriteIdentInCont(alloc: std.mem.Allocator, cont: *ast.Continuation, name: []const u8, replacement: []const u8) void {
            if (cont.node) |*n| {
                switch (@constCast(n).*) {
                    .invocation => |*inv| {
                        for (inv.args) |*a| {
                            @constCast(a).value = identRefs(alloc, a.value, name, replacement);
                            if (a.expression_value) |ev| {
                                const fresh = alloc.create(ast.CapturedExpression) catch unreachable;
                                fresh.* = ev.*;
                                fresh.text = identRefs(alloc, ev.text, name, replacement);
                                @constCast(a).expression_value = fresh;
                            }
                            if (a.source_value) |sv| {
                                const fresh = alloc.create(ast.Source) catch unreachable;
                                fresh.* = sv.*;
                                fresh.text = identRefs(alloc, sv.text, name, replacement);
                                @constCast(a).source_value = fresh;
                            }
                        }
                    },
                    else => {},
                }
            }
            for (cont.continuations) |*c| rewriteIdentInCont(alloc, @constCast(c), name, replacement);
        }
        // Store-invocation args (stored/watch/create blocks) keep their raw
        // source — those transforms own their own rewriting.
        fn rewriteNode(alloc: std.mem.Allocator, n: *ast.Node, names: []const []const u8) void {
            switch (n.*) {
                .invocation => |*inv| {
                    if (inv.path.module_qualifier) |mq| {
                        if (std.mem.eql(u8, mq, "std.store")) return;
                    }
                    for (inv.args) |*a| {
                        var v = a.value;
                        for (names) |nm| v = storeRefs(alloc, v, nm);
                        @constCast(a).value = v;
                        // Expression args carry their text separately — the
                        // emitter reads THAT, not .value. cloneContinuation
                        // shares these pointers with the ORIGINAL tree (the
                        // documented clone footgun), so swap in a fresh copy
                        // rather than mutating shared state.
                        if (a.expression_value) |ev| {
                            var t = ev.text;
                            for (names) |nm| t = storeRefs(alloc, t, nm);
                            const fresh = alloc.create(ast.CapturedExpression) catch unreachable;
                            fresh.* = ev.*;
                            fresh.text = t;
                            @constCast(a).expression_value = fresh;
                        }
                    }
                },
                else => {},
            }
        }
        fn rewriteCont(alloc: std.mem.Allocator, cont: *ast.Continuation, names: []const []const u8) void {
            // Guards ride as arm conditions at the write site - their
            // cross-store reads rewrite to the cells too (690_013).
            if (cont.condition) |cond| {
                var cnd = cond;
                for (names) |nm| cnd = storeRefs(alloc, cnd, nm);
                @constCast(cont).condition = cnd;
            }
            if (cont.node) |*n| rewriteNode(alloc, @constCast(n), names);
            for (cont.continuations) |*c| rewriteCont(alloc, @constCast(c), names);
        }
    };
    for (watch_arms.items) |*wa| Rewrite.rewriteCont(allocator, &wa.cont, store_names.items);
    for (field_iceptors.items) |*fi| Rewrite.rewriteCont(allocator, &fi.cont, store_names.items);
    for (updated_iceptors.items) |*ui| Rewrite.rewriteCont(allocator, ui, store_names.items);

    // ------------------------------------------------------------------
    // Unit 1: the module-scope typed cell (slice one, unchanged).
    // ------------------------------------------------------------------
    var seed = std.ArrayList(u8).initCapacity(allocator, 64) catch unreachable;
    seed.appendSlice(allocator, ".{ ") catch unreachable;
    for (cell_fields, 0..) |cf, i| {
        if (i > 0) seed.appendSlice(allocator, ", ") catch unreachable;
        seed.append(allocator, '.') catch unreachable;
        seed.appendSlice(allocator, cf.name) catch unreachable;
        seed.appendSlice(allocator, " = ") catch unreachable;
        // Declared default when seeded; a bare field zero-defaults
        // (initialization is orthogonal to shape — 690_050).
        seed.appendSlice(allocator, "@as(") catch unreachable;
        seed.appendSlice(allocator, field_types[i]) catch unreachable;
        seed.appendSlice(allocator, ", ") catch unreachable;
        seed.appendSlice(allocator, field_defaults[i] orelse "0") catch unreachable;
        seed.appendSlice(allocator, ")") catch unreachable;
    }
    seed.appendSlice(allocator, " }") catch unreachable;
    const init_zig = seed.toOwnedSlice(allocator) catch unreachable;

    var p = std.ArrayList(u8).initCapacity(allocator, 512) catch unreachable;
    p.appendSlice(allocator, "const __KoruStoreT_") catch unreachable;
    p.appendSlice(allocator, store_name) catch unreachable;
    // Container-level const initializers are already comptime scope — no
    // `comptime` keyword (capture's twin builder needs it because its
    // preamble lands inside a function body).
    p.appendSlice(allocator, " = blk: {\n") catch unreachable;
    p.appendSlice(allocator, "    const __info = @typeInfo(@TypeOf(") catch unreachable;
    p.appendSlice(allocator, init_zig) catch unreachable;
    p.appendSlice(allocator, "));\n") catch unreachable;
    p.appendSlice(allocator, "    var __fields: [__info.@\"struct\".fields.len]@import(\"std\").builtin.Type.StructField = undefined;\n") catch unreachable;
    p.appendSlice(allocator, "    for (__info.@\"struct\".fields, 0..) |__f, __i| {\n") catch unreachable;
    p.appendSlice(allocator, "        __fields[__i] = .{ .name = __f.name, .type = __f.type, .default_value_ptr = null, .is_comptime = false, .alignment = __f.alignment };\n") catch unreachable;
    p.appendSlice(allocator, "    }\n") catch unreachable;
    p.appendSlice(allocator, "    break :blk @Type(.{ .@\"struct\" = .{ .layout = .auto, .fields = &__fields, .decls = &.{}, .is_tuple = false } });\n") catch unreachable;
    p.appendSlice(allocator, "};\n") catch unreachable;
    p.appendSlice(allocator, "var __koru_store_") catch unreachable;
    p.appendSlice(allocator, store_name) catch unreachable;
    p.appendSlice(allocator, ": __KoruStoreT_") catch unreachable;
    p.appendSlice(allocator, store_name) catch unreachable;
    p.appendSlice(allocator, " = ") catch unreachable;
    p.appendSlice(allocator, init_zig) catch unreachable;
    p.appendSlice(allocator, ";") catch unreachable;
    const cell_decl = p.toOwnedSlice(allocator) catch unreachable;

    // ------------------------------------------------------------------
    // Unit 2+3: the apply event (one terminal branch per field) + its
    // |zig proc (write the cell, announce the field).
    // ------------------------------------------------------------------
    const apply_name = std.fmt.allocPrint(allocator, "__store_apply_{s}", .{store_name}) catch unreachable;
    const write_name = std.fmt.allocPrint(allocator, "__store_write_{s}", .{store_name}) catch unreachable;

    const mkInput = struct {
        fn call(alloc: std.mem.Allocator, vtype: []const u8) []ast.Field {
            const fields = alloc.alloc(ast.Field, 2) catch unreachable;
            fields[0] = ast.Field{ .name = alloc.dupe(u8, "field") catch unreachable, .type = alloc.dupe(u8, "i64") catch unreachable };
            fields[1] = ast.Field{ .name = alloc.dupe(u8, "value") catch unreachable, .type = alloc.dupe(u8, vtype) catch unreachable };
            return fields;
        }
    }.call;

    const apply_branches = allocator.alloc(ast.Branch, cell_fields.len) catch unreachable;
    for (field_names, 0..) |fname, i| {
        const payload: ast.Shape = if (old_new_mode) blk: {
            const pf = allocator.alloc(ast.Field, 2) catch unreachable;
            pf[0] = ast.Field{ .name = allocator.dupe(u8, "old") catch unreachable, .type = allocator.dupe(u8, field_types[i]) catch unreachable };
            pf[1] = ast.Field{ .name = allocator.dupe(u8, "new") catch unreachable, .type = allocator.dupe(u8, field_types[i]) catch unreachable };
            break :blk ast.Shape{ .fields = pf };
        } else blk: {
            const pf = allocator.alloc(ast.Field, 1) catch unreachable;
            pf[0] = ast.Field{
                .name = allocator.dupe(u8, "__type_ref") catch unreachable,
                .type = allocator.dupe(u8, field_types[i]) catch unreachable,
            };
            break :blk ast.Shape{ .fields = pf };
        };
        apply_branches[i] = ast.Branch{
            .name = allocator.dupe(u8, fname) catch unreachable,
            .payload = payload,
            .kind = .terminal,
            .annotations = &[_][]const u8{},
        };
    }

    const mkPath = struct {
        fn call(alloc: std.mem.Allocator, module: []const u8, name: []const u8) ast.DottedPath {
            const segs = alloc.alloc([]const u8, 1) catch unreachable;
            segs[0] = alloc.dupe(u8, name) catch unreachable;
            return ast.DottedPath{ .module_qualifier = alloc.dupe(u8, module) catch unreachable, .segments = segs };
        }
    }.call;

    const apply_event_item = ast.Item{ .event_decl = ast.EventDecl{
        .path = mkPath(allocator, flow.module, apply_name),
        .input = ast.Shape{ .fields = mkInput(allocator, value_type) },
        .branches = apply_branches,
        .is_public = false,
        .is_implicit_flow = false,
        .annotations = &[_][]const u8{},
        .location = flow.location,
        .module = allocator.dupe(u8, flow.module) catch unreachable,
    } };

    var pb = std.ArrayList(u8).initCapacity(allocator, 256) catch unreachable;
    pb.appendSlice(allocator, "return switch (field) {\n") catch unreachable;
    for (field_names, 0..) |fname, i| {
        const arm = if (old_new_mode)
            std.fmt.allocPrint(allocator, "    {d} => blk: {{ const __old = __koru_store_{s}.{s}; __koru_store_{s}.{s} = value; break :blk .{{ .{s} = .{{ .old = __old, .new = value }} }}; }},\n", .{ i, store_name, fname, store_name, fname, fname }) catch unreachable
        else
            std.fmt.allocPrint(allocator, "    {d} => blk: {{ __koru_store_{s}.{s} = value; break :blk .{{ .{s} = value }}; }},\n", .{ i, store_name, fname, fname }) catch unreachable;
        pb.appendSlice(allocator, arm) catch unreachable;
    }
    pb.appendSlice(allocator, "    else => unreachable,\n};") catch unreachable;
    const apply_proc_body = pb.toOwnedSlice(allocator) catch unreachable;

    const apply_proc_item = ast.Item{ .proc_decl = ast.ProcDecl{
        .path = mkPath(allocator, flow.module, apply_name),
        .body = ast.Source{ .text = apply_proc_body, .location = flow.location, .scope = .{ .bindings = &[_]ast.ScopeBinding{} }, .phantom_type = null },
        .annotations = &[_][]const u8{},
        .target = allocator.dupe(u8, "zig") catch unreachable,
        .location = flow.location,
        .module = allocator.dupe(u8, flow.module) catch unreachable,
    } };

    // ------------------------------------------------------------------
    // Unit 4+5: the write event (void — the store's sole write surface)
    // and its implementing flow: head invokes apply, arms are the
    // transplanted watch branches. THE (f) CENTRALIZING WRITE-SUBFLOW.
    // ------------------------------------------------------------------
    const write_event_item = ast.Item{ .event_decl = ast.EventDecl{
        .path = mkPath(allocator, flow.module, write_name),
        .input = ast.Shape{ .fields = mkInput(allocator, value_type) },
        .branches = &[_]ast.Branch{},
        .is_public = false,
        .is_implicit_flow = false,
        .annotations = &[_][]const u8{},
        .location = flow.location,
        .module = allocator.dupe(u8, flow.module) catch unreachable,
    } };

    const apply_args = allocator.alloc(ast.Arg, 2) catch unreachable;
    apply_args[0] = ast.Arg{ .name = allocator.dupe(u8, "field") catch unreachable, .value = allocator.dupe(u8, "field") catch unreachable };
    apply_args[1] = ast.Arg{ .name = allocator.dupe(u8, "value") catch unreachable, .value = allocator.dupe(u8, "value") catch unreachable };
    const apply_inv = ast.Invocation{
        .path = mkPath(allocator, flow.module, apply_name),
        .args = apply_args,
    };

    // One arm per field. Per arm, the spliced sequence is: field
    // interceptors first (the contract runs inside the cascade), then the
    // watch body (watches observe settled state — the (h) lean). Sequenced
    // bodies ride as `branch:""` void-chain steps (capture's dissolution
    // shape). In {old,new} mode every field's arm carries every `updated`
    // interceptor body (the lifecycle fires on all writes). A guarded
    // stand-alone watch gets an unguarded do-nothing sibling so the
    // dispatch stays exhaustive (210_085's coverage rule, 400_089's rescue
    // shape).
    const Graft = struct {
        fn atEnds(alloc: std.mem.Allocator, cont: *ast.Continuation, next: *const ast.Continuation) void {
            if (cont.continuations.len == 0) {
                const kids = alloc.alloc(ast.Continuation, 1) catch unreachable;
                kids[0] = ast_functional.cloneContinuation(alloc, next) catch unreachable;
                cont.continuations = kids;
                return;
            }
            for (cont.continuations) |*c| atEnds(alloc, @constCast(c), next);
        }
        // A body continuation re-shaped as a sequential void step.
        fn asVoidStep(alloc: std.mem.Allocator, body: *const ast.Continuation) ast.Continuation {
            const cloned = ast_functional.cloneContinuation(alloc, body) catch unreachable;
            return ast.Continuation{
                .branch = alloc.dupe(u8, "") catch unreachable,
                .binding = null,
                .kind = .terminal,
                .condition = null,
                .node = cloned.node,
                .indent = cloned.indent,
                .continuations = cloned.continuations,
                .is_transformed_subtree = true,
                .location = cloned.location,
            };
        }
    };

    var arms = std.ArrayList(ast.Continuation).initCapacity(allocator, cell_fields.len + 2) catch unreachable;
    for (field_names, 0..) |fname, i| {
        // Gather this field's spliced bodies in firing order.
        var segments = std.ArrayList(*const ast.Continuation).initCapacity(allocator, 4) catch unreachable;
        var watch_seg: ?*const ast.Continuation = null;
        var watch_count: usize = 0;
        if (old_new_mode) {
            for (updated_iceptors.items) |*ui| segments.append(allocator, ui) catch unreachable;
        } else {
            for (field_iceptors.items) |*fi| {
                if (fi.field_idx == i) segments.append(allocator, &fi.cont) catch unreachable;
            }
            for (watch_arms.items) |*wa| {
                if (wa.field_idx == i) {
                    if (watch_seg == null) watch_seg = &wa.cont;
                    watch_count += 1;
                    segments.append(allocator, &wa.cont) catch unreachable;
                }
            }
        }

        // Foreign-guard announce steps for THIS field (690_013).
        var fg_steps = std.ArrayList(ast.Continuation).initCapacity(allocator, 2) catch unreachable;
        for (foreign_guards.items) |fg| {
            if (fg.local_field_idx != i) continue;
            const t_announce = std.fmt.allocPrint(allocator, "__store_announce_{s}", .{fg.target_store}) catch unreachable;
            const fg_args = allocator.alloc(ast.Arg, 1) catch unreachable;
            fg_args[0] = ast.Arg{
                .name = allocator.dupe(u8, "field") catch unreachable,
                .value = std.fmt.allocPrint(allocator, "{d}", .{fg.target_field_idx}) catch unreachable,
            };
            fg_steps.append(allocator, ast.Continuation{
                .branch = allocator.dupe(u8, "") catch unreachable,
                .binding = null,
                .kind = .terminal,
                .condition = null,
                .node = .{ .invocation = ast.Invocation{
                    .path = mkPath(allocator, flow.module, t_announce),
                    .args = fg_args,
                } },
                .indent = 1,
                .continuations = &[_]ast.Continuation{},
                .is_transformed_subtree = true,
                .location = flow.location,
            }) catch unreachable;
        }

        if (segments.items.len == 0 and fg_steps.items.len == 0) {
            arms.append(allocator, ast.Continuation{
                .branch = allocator.dupe(u8, fname) catch unreachable,
                .binding = allocator.dupe(u8, "_") catch unreachable,
                .kind = .terminal,
                .condition = null,
                .node = .terminal,
                .indent = 1,
                .continuations = &[_]ast.Continuation{},
                .location = flow.location,
            }) catch unreachable;
            continue;
        }
        if (segments.items.len == 0) {
            // Arm exists ONLY to re-announce foreign guarded watches.
            var fg_arm = fg_steps.items[0];
            fg_arm.branch = allocator.dupe(u8, fname) catch unreachable;
            fg_arm.binding = allocator.dupe(u8, "_") catch unreachable;
            for (fg_steps.items[1..]) |*extra| {
                Graft.atEnds(allocator, &fg_arm, extra);
            }
            arms.append(allocator, fg_arm) catch unreachable;
            continue;
        }

        var any_watch_guarded = false;
        for (segments.items) |seg| {
            if (seg.condition != null) any_watch_guarded = true;
        }
        const watch_guarded = any_watch_guarded;
        if (watch_guarded and segments.items.len > 1) {
            return .{ .transformed = .{ .replacement = H.errItem(allocator, flow.location, flow.module, "std/store:new({s}): a guarded watch on a field that also has interceptors or sibling watches is a later slice", .{store_name}) } };
        }

        var arm = ast_functional.cloneContinuation(allocator, segments.items[0]) catch unreachable;
        arm.branch = allocator.dupe(u8, fname) catch unreachable;
        arm.kind = .terminal;
        if (old_new_mode) {
            // The subflow emitter's switch-arm head supports plain bindings
            // only (no destructure) — bind the {old,new} payload to a
            // synthesized name and rewrite the body's `old`/`new` idents to
            // field accesses (taps' string-level binding-rewrite precedent).
            for (arm.destructure) |df| {
                const repl = std.fmt.allocPrint(allocator, "__koru_upd.{s}", .{df.name}) catch unreachable;
                Rewrite.rewriteIdentInCont(allocator, &arm, df.name, repl);
            }
            arm.destructure = &.{};
            arm.binding = allocator.dupe(u8, "__koru_upd") catch unreachable;
        } else {
            // The arm binds the watch's name where a watch exists (interceptor
            // segments discard their payload by contract).
            if (watch_seg) |ws| {
                arm.binding = if (ws.binding) |b| allocator.dupe(u8, b) catch unreachable else allocator.dupe(u8, "_") catch unreachable;
            } else {
                arm.binding = allocator.dupe(u8, "_") catch unreachable;
            }
        }
        for (segments.items[1..]) |seg| {
            var step = Graft.asVoidStep(allocator, seg);
            // A sibling watch body references ITS OWN binding; the arm binds
            // the FIRST watch's name. Rewrite (taps' binding-rewrite shape).
            if (!old_new_mode) {
                if (seg.binding) |sb| {
                    if (arm.binding) |ab| {
                        if (!std.mem.eql(u8, sb, ab) and !std.mem.eql(u8, sb, "_")) {
                            Rewrite.rewriteIdentInCont(allocator, &step, sb, ab);
                        }
                    }
                }
            }
            Graft.atEnds(allocator, &arm, &step);
        }
        for (fg_steps.items) |*fgs| Graft.atEnds(allocator, &arm, fgs);
        arms.append(allocator, arm) catch unreachable;

        if (watch_guarded) {
            arms.append(allocator, ast.Continuation{
                .branch = allocator.dupe(u8, fname) catch unreachable,
                .binding = allocator.dupe(u8, "_") catch unreachable,
                .kind = .terminal,
                .condition = null,
                .node = .terminal,
                .indent = arm.indent,
                .continuations = &[_]ast.Continuation{},
                .location = flow.location,
            }) catch unreachable;
        }
    }

    const impl_flow_item = ast.Item{ .flow = ast.Flow{
        .body = ast.rootSite(apply_inv, arms.toOwnedSlice(allocator) catch unreachable, flow.location),
        .pre_label = null,
        .impl_of = mkPath(allocator, flow.module, write_name),
        .super_shape = null,
        .inline_body = null,
        .preamble_code = null,
        .is_pure = false,
        .is_transitively_pure = false,
        .location = flow.location,
        .module = allocator.dupe(u8, flow.module) catch unreachable,
    } };

    // ------------------------------------------------------------------
    // Unit 6+7: ANNOUNCE (dispatch-only re-fire of standing watches with
    // CURRENT values - no write, no interceptors) and STRIPE (the
    // imperative sweep verb, (l)/O13: announce every field). 690_014.
    // ------------------------------------------------------------------
    var stripe_items = std.ArrayList(ast.Item).initCapacity(allocator, 4) catch unreachable;
    if (!old_new_mode) {
        const announce_name = std.fmt.allocPrint(allocator, "__store_announce_{s}", .{store_name}) catch unreachable;
        const peek_name = std.fmt.allocPrint(allocator, "__store_peek_{s}", .{store_name}) catch unreachable;
        const stripe_name = std.fmt.allocPrint(allocator, "__store_stripe_{s}", .{store_name}) catch unreachable;

        const ann_in = allocator.alloc(ast.Field, 1) catch unreachable;
        ann_in[0] = ast.Field{ .name = allocator.dupe(u8, "field") catch unreachable, .type = allocator.dupe(u8, "i64") catch unreachable };
        const peek_in = allocator.alloc(ast.Field, 1) catch unreachable;
        peek_in[0] = ast.Field{ .name = allocator.dupe(u8, "field") catch unreachable, .type = allocator.dupe(u8, "i64") catch unreachable };
        const ann_branches = allocator.alloc(ast.Branch, cell_fields.len) catch unreachable;
        for (field_names, 0..) |fname, i| {
            const pf = allocator.alloc(ast.Field, 1) catch unreachable;
            pf[0] = ast.Field{ .name = allocator.dupe(u8, "__type_ref") catch unreachable, .type = allocator.dupe(u8, field_types[i]) catch unreachable };
            ann_branches[i] = ast.Branch{
                .name = allocator.dupe(u8, fname) catch unreachable,
                .payload = ast.Shape{ .fields = pf },
                .kind = .terminal,
                .annotations = &[_][]const u8{},
            };
        }
        const retain_ann2 = blk: {
            const anns = allocator.alloc([]const u8, 1) catch unreachable;
            anns[0] = allocator.dupe(u8, "retain") catch unreachable;
            break :blk anns;
        };
        stripe_items.append(allocator, ast.Item{ .event_decl = ast.EventDecl{
            .path = mkPath(allocator, flow.module, peek_name),
            .input = ast.Shape{ .fields = peek_in },
            .branches = ann_branches,
            .is_public = false,
            .is_implicit_flow = false,
            .annotations = &[_][]const u8{},
            .location = flow.location,
            .module = allocator.dupe(u8, flow.module) catch unreachable,
        } }) catch unreachable;
        // announce: the VOID dispatcher (retained — raw-Zig callers only).
        stripe_items.append(allocator, ast.Item{ .event_decl = ast.EventDecl{
            .path = mkPath(allocator, flow.module, announce_name),
            .input = ast.Shape{ .fields = ann_in },
            .branches = &[_]ast.Branch{},
            .is_public = false,
            .is_implicit_flow = false,
            .annotations = retain_ann2,
            .location = flow.location,
            .module = allocator.dupe(u8, flow.module) catch unreachable,
        } }) catch unreachable;

        // Peek proc: read the CURRENT value, announce the field branch.
        var pk = std.ArrayList(u8).initCapacity(allocator, 256) catch unreachable;
        pk.appendSlice(allocator, "return switch (field) {\n") catch unreachable;
        for (field_names, 0..) |fname, i| {
            const arm = std.fmt.allocPrint(allocator, "    {d} => .{{ .{s} = __koru_store_{s}.{s} }},\n", .{ i, fname, store_name, fname }) catch unreachable;
            pk.appendSlice(allocator, arm) catch unreachable;
        }
        pk.appendSlice(allocator, "    else => unreachable,\n};") catch unreachable;
        stripe_items.append(allocator, ast.Item{ .proc_decl = ast.ProcDecl{
            .path = mkPath(allocator, flow.module, peek_name),
            .body = ast.Source{ .text = pk.toOwnedSlice(allocator) catch unreachable, .location = flow.location, .scope = .{ .bindings = &[_]ast.ScopeBinding{} }, .phantom_type = null },
            .annotations = &[_][]const u8{},
            .target = allocator.dupe(u8, "zig") catch unreachable,
            .location = flow.location,
            .module = allocator.dupe(u8, flow.module) catch unreachable,
        } }) catch unreachable;

        // The announce impl flow re-dispatches the SAME watch arms (fresh
        // clones - the shared-pointer footgun is real).
        var ann_arms = std.ArrayList(ast.Continuation).initCapacity(allocator, cell_fields.len) catch unreachable;
        for (field_names, 0..) |fname, i| {
            var seg_list = std.ArrayList(*const ast.Continuation).initCapacity(allocator, 4) catch unreachable;
            for (watch_arms.items) |*wa| {
                if (wa.field_idx == i) seg_list.append(allocator, &wa.cont) catch unreachable;
            }
            if (seg_list.items.len == 0) {
                ann_arms.append(allocator, ast.Continuation{
                    .branch = allocator.dupe(u8, fname) catch unreachable,
                    .binding = allocator.dupe(u8, "_") catch unreachable,
                    .kind = .terminal,
                    .condition = null,
                    .node = .terminal,
                    .indent = 1,
                    .continuations = &[_]ast.Continuation{},
                    .location = flow.location,
                }) catch unreachable;
                continue;
            }
            var arm2 = ast_functional.cloneContinuation(allocator, seg_list.items[0]) catch unreachable;
            arm2.branch = allocator.dupe(u8, fname) catch unreachable;
            arm2.kind = .terminal;
            arm2.binding = if (seg_list.items[0].binding) |b| allocator.dupe(u8, b) catch unreachable else allocator.dupe(u8, "_") catch unreachable;
            for (seg_list.items[1..]) |seg| {
                var step2 = Graft.asVoidStep(allocator, seg);
                if (seg.binding) |sb| {
                    if (arm2.binding) |ab| {
                        if (!std.mem.eql(u8, sb, ab) and !std.mem.eql(u8, sb, "_")) {
                            Rewrite.rewriteIdentInCont(allocator, &step2, sb, ab);
                        }
                    }
                }
                Graft.atEnds(allocator, &arm2, &step2);
            }
            const guarded2 = arm2.condition != null;
            ann_arms.append(allocator, arm2) catch unreachable;
            if (guarded2) {
                ann_arms.append(allocator, ast.Continuation{
                    .branch = allocator.dupe(u8, fname) catch unreachable,
                    .binding = allocator.dupe(u8, "_") catch unreachable,
                    .kind = .terminal,
                    .condition = null,
                    .node = .terminal,
                    .indent = arm2.indent,
                    .continuations = &[_]ast.Continuation{},
                    .location = flow.location,
                }) catch unreachable;
            }
        }
        const ann_call_args = allocator.alloc(ast.Arg, 1) catch unreachable;
        ann_call_args[0] = ast.Arg{ .name = allocator.dupe(u8, "field") catch unreachable, .value = allocator.dupe(u8, "field") catch unreachable };
        stripe_items.append(allocator, ast.Item{ .flow = ast.Flow{
            .body = ast.rootSite(ast.Invocation{
                .path = mkPath(allocator, flow.module, peek_name),
                .args = ann_call_args,
            }, ann_arms.toOwnedSlice(allocator) catch unreachable, flow.location),
            .pre_label = null,
            .impl_of = mkPath(allocator, flow.module, announce_name),
            .super_shape = null,
            .inline_body = null,
            .preamble_code = null,
            .is_pure = false,
            .is_transitively_pure = false,
            .location = flow.location,
            .module = allocator.dupe(u8, flow.module) catch unreachable,
        } }) catch unreachable;

        // envwrite: write-only (no dispatch) - the chain-envelope's first
        // half (690_009): all writes land, THEN announce dispatches.
        {
            const envw_name = std.fmt.allocPrint(allocator, "__store_envwrite_{s}", .{store_name}) catch unreachable;
            const ew_in = allocator.alloc(ast.Field, 2) catch unreachable;
            ew_in[0] = ast.Field{ .name = allocator.dupe(u8, "field") catch unreachable, .type = allocator.dupe(u8, "i64") catch unreachable };
            ew_in[1] = ast.Field{ .name = allocator.dupe(u8, "value") catch unreachable, .type = allocator.dupe(u8, value_type) catch unreachable };
            stripe_items.append(allocator, ast.Item{ .event_decl = ast.EventDecl{
                .path = mkPath(allocator, flow.module, envw_name),
                .input = ast.Shape{ .fields = ew_in },
                .branches = &[_]ast.Branch{},
                .is_public = false,
                .is_implicit_flow = false,
                .annotations = &[_][]const u8{},
                .location = flow.location,
                .module = allocator.dupe(u8, flow.module) catch unreachable,
            } }) catch unreachable;
            var ew = std.ArrayList(u8).initCapacity(allocator, 128) catch unreachable;
            ew.appendSlice(allocator, "switch (field) {\n") catch unreachable;
            for (field_names, 0..) |fname, i| {
                const arm3 = std.fmt.allocPrint(allocator, "    {d} => __koru_store_{s}.{s} = value,\n", .{ i, store_name, fname }) catch unreachable;
                ew.appendSlice(allocator, arm3) catch unreachable;
            }
            ew.appendSlice(allocator, "    else => unreachable,\n}\nreturn;") catch unreachable;
            stripe_items.append(allocator, ast.Item{ .proc_decl = ast.ProcDecl{
                .path = mkPath(allocator, flow.module, envw_name),
                .body = ast.Source{ .text = ew.toOwnedSlice(allocator) catch unreachable, .location = flow.location, .scope = .{ .bindings = &[_]ast.ScopeBinding{} }, .phantom_type = null },
                .annotations = &[_][]const u8{},
                .target = allocator.dupe(u8, "zig") catch unreachable,
                .location = flow.location,
                .module = allocator.dupe(u8, flow.module) catch unreachable,
            } }) catch unreachable;
        }

        // stripe: loop the fields, announcing each.
        stripe_items.append(allocator, ast.Item{ .event_decl = ast.EventDecl{
            .path = mkPath(allocator, flow.module, stripe_name),
            .input = ast.Shape{ .fields = &[_]ast.Field{} },
            .branches = &[_]ast.Branch{},
            .is_public = false,
            .is_implicit_flow = false,
            .annotations = &[_][]const u8{},
            .location = flow.location,
            .module = allocator.dupe(u8, flow.module) catch unreachable,
        } }) catch unreachable;
        var sb2 = std.ArrayList(u8).initCapacity(allocator, 128) catch unreachable;
        for (field_names, 0..) |_, i| {
            const call2 = std.fmt.allocPrint(allocator, "main_module.{s}_event.handler(.{{ .field = {d} }});\n", .{ announce_name, i }) catch unreachable;
            sb2.appendSlice(allocator, call2) catch unreachable;
        }
        sb2.appendSlice(allocator, "return;") catch unreachable;
        stripe_items.append(allocator, ast.Item{ .proc_decl = ast.ProcDecl{
            .path = mkPath(allocator, flow.module, stripe_name),
            .body = ast.Source{ .text = sb2.toOwnedSlice(allocator) catch unreachable, .location = flow.location, .scope = .{ .bindings = &[_]ast.ScopeBinding{} }, .phantom_type = null },
            .annotations = &[_][]const u8{},
            .target = allocator.dupe(u8, "zig") catch unreachable,
            .location = flow.location,
            .module = allocator.dupe(u8, flow.module) catch unreachable,
        } }) catch unreachable;
    }

    // ------------------------------------------------------------------
    // Assemble: the create site dissolves into a comment; the five
    // generated units append as top-level items.
    // ------------------------------------------------------------------
    const consumed = std.fmt.allocPrint(allocator, "// std/store: '{s}' created (cell + write-subflow at module scope)", .{store_name}) catch unreachable;
    const replacement = ast.Item{ .host_line = ast.HostLine{
        .content = consumed,
        .location = flow.location,
        .module = allocator.dupe(u8, flow.module) catch unreachable,
    } };

    const appended = allocator.alloc(ast.Item, 5 + stripe_items.items.len) catch unreachable;
    appended[0] = ast.Item{ .host_line = ast.HostLine{
        .content = cell_decl,
        .location = flow.location,
        .module = allocator.dupe(u8, flow.module) catch unreachable,
    } };
    appended[1] = apply_event_item;
    appended[2] = apply_proc_item;
    appended[3] = write_event_item;
    appended[4] = impl_flow_item;
    for (stripe_items.items, 0..) |si, sii| appended[5 + sii] = si;

    return .{ .transformed = .{ .replacement = replacement, .appended = appended } };
}

// ============================================================================
// STORE.STORED — the sole write path: an ordinary call into the subflow
// ============================================================================
//
//   ~std/store:stored { game.entities: game.entities + 1 }
//
// Rewritten into `__store_write_game(field: <idx>, value: <expr'>)` where
// <expr'> has dotted store reads rewritten to the cell. The replacement is
// a real flow, so it is emitted inside a function like any other call.

~[keyword|comptime|transform]pub event stored {
    source: Source,
    invocation: *const Invocation,
    item: *const Item,
    program: *const Program,
    allocator: std.mem.Allocator
} -> SiteResult

~[transform]proc stored|zig {
    const ast = @import("ast");
    const ast_functional = @import("ast_functional");
    const struct_literal = @import("struct_literal");

    if (item.* != .flow) @panic("store:stored transform: containing item is not a flow - walker dispatch contract broken");
    const flow = &item.flow;

    const H = struct {
        fn stripQuotes(n: []const u8) []const u8 {
            if (n.len >= 2 and n[0] == '"') return n[1 .. n.len - 1];
            return n;
        }
        fn errItem(alloc: std.mem.Allocator, loc: anytype, module: []const u8, comptime fmt: []const u8, args: anytype) ast.Item {
            const inner = std.fmt.allocPrint(alloc, fmt, args) catch unreachable;
            const msg = std.fmt.allocPrint(alloc, "comptime {{ @compileError(\"{s}\"); }}", .{inner}) catch unreachable;
            return ast.Item{ .inline_code = ast.InlineCode{ .code = msg, .location = loc, .module = module } };
        }
        fn mkPathH2(alloc: std.mem.Allocator, module: []const u8, name: []const u8) ast.DottedPath {
            const segs2 = alloc.alloc([]const u8, 1) catch unreachable;
            segs2[0] = alloc.dupe(u8, name) catch unreachable;
            return ast.DottedPath{ .module_qualifier = alloc.dupe(u8, module) catch unreachable, .segments = segs2 };
        }
        fn isIdent(ch: u8) bool {
            return (ch >= 'a' and ch <= 'z') or (ch >= 'A' and ch <= 'Z') or (ch >= '0' and ch <= '9') or ch == '_' or ch == '-';
        }
        // Boundary-aware store-name rewrite: `game.entities` → the cell path,
        // only where `game` is a whole identifier followed by a dot.
        fn storeRefs(alloc: std.mem.Allocator, text: []const u8, name: []const u8) []const u8 {
            var out = std.ArrayList(u8).initCapacity(alloc, text.len + 32) catch unreachable;
            var i: usize = 0;
            while (i < text.len) {
                const at_boundary = i == 0 or !isIdent(text[i - 1]);
                if (at_boundary and i + name.len < text.len and
                    std.mem.startsWith(u8, text[i..], name) and text[i + name.len] == '.')
                {
                    out.appendSlice(alloc, "__koru_store_") catch unreachable;
                    out.appendSlice(alloc, name) catch unreachable;
                    i += name.len;
                } else {
                    out.append(alloc, text[i]) catch unreachable;
                    i += 1;
                }
            }
            return out.toOwnedSlice(alloc) catch unreachable;
        }
        // Field order for a store: from the generated apply event if the
        // coordinator already ran, else from the untransformed create flow's
        // seed block. Deterministic under any transform order.
        fn fieldOrder(alloc: std.mem.Allocator, prog: *const ast.Program, store: []const u8) ?[]const []const u8 {
            const apply_name = std.fmt.allocPrint(alloc, "__store_apply_{s}", .{store}) catch unreachable;
            for (prog.items) |pi| {
                if (pi != .event_decl) continue;
                const ed = &pi.event_decl;
                if (ed.path.segments.len == 1 and std.mem.eql(u8, ed.path.segments[0], apply_name)) {
                    const names = alloc.alloc([]const u8, ed.branches.len) catch unreachable;
                    for (ed.branches, 0..) |b, i| names[i] = b.name;
                    return names;
                }
            }
            for (prog.items) |pi| {
                if (pi != .flow) continue;
                const f = &pi.flow;
                const inv = f.inv();
                if (inv.path.segments.len != 1 or !std.mem.eql(u8, inv.path.segments[0], "new")) continue;
                const mq = inv.path.module_qualifier orelse continue;
                if (!std.mem.eql(u8, mq, "std.store")) continue;
                var name_matches = false;
                var seed: ?[]const u8 = null;
                for (inv.args) |a| {
                    if (std.mem.eql(u8, a.name, "expr")) {
                        name_matches = std.mem.eql(u8, stripQuotes(a.value), store);
                    } else if (std.mem.eql(u8, a.name, "source")) {
                        seed = a.value;
                    }
                }
                if (!name_matches or seed == null) continue;
                const braced = std.fmt.allocPrint(alloc, "{{{s}}}", .{seed.?}) catch unreachable;
                const cf = struct_literal.parseFields(alloc, braced) catch &[_]struct_literal.StructField{};
                if (cf.len == 0) return null;
                const names = alloc.alloc([]const u8, cf.len) catch unreachable;
                for (cf, 0..) |c, i| names[i] = c.name;
                return names;
            }
            return null;
        }
    };

    var block_text: ?[]const u8 = null;
    for (invocation.args) |arg| {
        if (std.mem.eql(u8, arg.name, "source")) block_text = arg.value;
    }
    if (block_text == null) {
        return .{ .transformed = .{ .replacement = H.errItem(allocator, flow.location, flow.module, "std/store:stored requires a write block: stored {{ store.field: expr }}", .{}) } };
    }

    const braced = std.fmt.allocPrint(allocator, "{{{s}}}", .{block_text.?}) catch unreachable;
    const writes = struct_literal.parseFields(allocator, braced) catch &[_]struct_literal.StructField{};
    if (writes.len == 0) {
        return .{ .transformed = .{ .replacement = H.errItem(allocator, flow.location, flow.module, "std/store:stored: write block is empty", .{}) } };
    }

    // THE CHAIN IS THE ENVELOPE ((i) lean, 690_009): a multi-field block
    // is ONE atomic unit - every write lands (write-only envwrite), THEN
    // dispatch runs in write order (announce, which reads settled state).
    if (writes.len > 1) {
        // All targets must be the same singleton store this rung.
        var env_store: []const u8 = "";
        const env_fields = allocator.alloc([]const u8, writes.len) catch unreachable;
        const env_values = allocator.alloc([]const u8, writes.len) catch unreachable;
        for (writes, 0..) |wm, wi| {
            const dotm = std.mem.indexOfScalar(u8, wm.name, '.') orelse {
                return .{ .transformed = .{ .replacement = H.errItem(allocator, flow.location, flow.module, "std/store:stored: envelope target '{s}' must be store.field", .{wm.name}) } };
            };
            const st = wm.name[0..dotm];
            if (env_store.len == 0) {
                env_store = st;
            } else if (!std.mem.eql(u8, env_store, st)) {
                return .{ .transformed = .{ .replacement = H.errItem(allocator, flow.location, flow.module, "std/store:stored: a multi-field envelope writes ONE store this rung ('{s}' vs '{s}')", .{ env_store, st }) } };
            }
            env_fields[wi] = wm.name[dotm + 1 ..];
            env_values[wi] = H.storeRefs(allocator, wm.value, st);
        }
        const order_env = H.fieldOrder(allocator, program, env_store) orelse {
            return .{ .transformed = .{ .replacement = H.errItem(allocator, flow.location, flow.module, "std/store:stored: unknown store '{s}'", .{env_store}) } };
        };
        const env_idx = allocator.alloc(usize, writes.len) catch unreachable;
        for (env_fields, 0..) |ef, wi| {
            env_idx[wi] = blk: {
                for (order_env, 0..) |fname, i| {
                    if (std.mem.eql(u8, fname, ef)) break :blk i;
                }
                return .{ .transformed = .{ .replacement = H.errItem(allocator, flow.location, flow.module, "std/store:stored: '{s}' is not a field of store '{s}'", .{ ef, env_store }) } };
            };
        }
        // Build the chain: envwrite each, then announce each (write order).
        const envw_name = std.fmt.allocPrint(allocator, "__store_envwrite_{s}", .{env_store}) catch unreachable;
        const ann_name = std.fmt.allocPrint(allocator, "__store_announce_{s}", .{env_store}) catch unreachable;
        const total = writes.len * 2;
        var invs = allocator.alloc(ast.Invocation, total) catch unreachable;
        for (writes, 0..) |_, wi| {
            const a1 = allocator.alloc(ast.Arg, 2) catch unreachable;
            a1[0] = ast.Arg{ .name = allocator.dupe(u8, "field") catch unreachable, .value = std.fmt.allocPrint(allocator, "{d}", .{env_idx[wi]}) catch unreachable };
            a1[1] = ast.Arg{ .name = allocator.dupe(u8, "value") catch unreachable, .value = env_values[wi] };
            invs[wi] = ast.Invocation{
                .path = H.mkPathH2(allocator, flow.module, envw_name),
                .args = a1,
            };
            const a2 = allocator.alloc(ast.Arg, 1) catch unreachable;
            a2[0] = ast.Arg{ .name = allocator.dupe(u8, "field") catch unreachable, .value = std.fmt.allocPrint(allocator, "{d}", .{env_idx[wi]}) catch unreachable };
            invs[writes.len + wi] = ast.Invocation{
                .path = H.mkPathH2(allocator, flow.module, ann_name),
                .args = a2,
            };
        }
        // Nested void chain, last step innermost. The chain BOTTOMS OUT in the
        // containing flow's original continuations (the `stored{…} |> next`
        // tail) — un-marked, so the runner's fixed-point pass re-lowers a tail
        // `stored`. The synthesized envwrite/announce nodes stay
        // `is_transformed_subtree` (they must not re-fire); only the user tail
        // beneath them is walked again. Empty here dropped the tail (690_028).
        var chain: []const ast.Continuation = flow.body.continuations;
        var k: usize = total;
        while (k > 1) {
            k -= 1;
            const one = allocator.alloc(ast.Continuation, 1) catch unreachable;
            one[0] = ast.Continuation{
                .branch = allocator.dupe(u8, "") catch unreachable,
                .binding = null,
                .kind = .terminal,
                .condition = null,
                .node = .{ .invocation = invs[k] },
                .indent = 1,
                .continuations = chain,
                .is_transformed_subtree = true,
                .location = flow.location,
            };
            chain = one;
        }
        return .{ .transformed = .{ .replacement = ast.Item{ .flow = ast.Flow{
            .body = ast.rootSite(invs[0], chain, flow.location),
            .pre_label = null,
            .impl_of = flow.impl_of,
            .super_shape = null,
            .inline_body = null,
            .preamble_code = null,
            .is_pure = false,
            .is_transitively_pure = false,
            .location = flow.location,
            .module = allocator.dupe(u8, flow.module) catch unreachable,
        } } } };
    }

    const w = writes[0];
    // Two lvalue heads this rung (O2: one path grammar, four heads):
    //   `store.field`            — elided-singleton head (singleton stores)
    //   `store[handle].field`    — handle / query-row head (plural stores)
    var target_store: []const u8 = undefined;
    var target_field: []const u8 = undefined;
    var row_expr: ?[]const u8 = null;
    if (std.mem.indexOfScalar(u8, w.name, '[')) |lb| {
        const rb = std.mem.lastIndexOfScalar(u8, w.name, ']') orelse {
            return .{ .transformed = .{ .replacement = H.errItem(allocator, flow.location, flow.module, "std/store:stored: malformed addressing head '{s}'", .{w.name}) } };
        };
        if (rb + 1 >= w.name.len or w.name[rb + 1] != '.') {
            return .{ .transformed = .{ .replacement = H.errItem(allocator, flow.location, flow.module, "std/store:stored: addressing head '{s}' needs a field: store[handle].field", .{w.name}) } };
        }
        target_store = std.mem.trim(u8, w.name[0..lb], " ");
        row_expr = std.mem.trim(u8, w.name[lb + 1 .. rb], " ");
        target_field = w.name[rb + 2 ..];
    } else {
        const dot = std.mem.indexOfScalar(u8, w.name, '.') orelse {
            return .{ .transformed = .{ .replacement = H.errItem(allocator, flow.location, flow.module, "std/store:stored target '{s}' must be a dotted store path (store.field)", .{w.name}) } };
        };
        target_store = w.name[0..dot];
        target_field = w.name[dot + 1 ..];
    }

    // A plural store's write surface is row-addressed; the elided-singleton
    // head on it has no row to mean.
    const is_plural_store = blk: {
        const inserth_name = std.fmt.allocPrint(allocator, "__store_inserth_{s}", .{target_store}) catch unreachable;
        for (program.items) |pi| {
            if (pi != .event_decl) continue;
            const ed = &pi.event_decl;
            if (ed.path.segments.len == 1 and std.mem.eql(u8, ed.path.segments[0], inserth_name)) break :blk true;
        }
        break :blk false;
    };
    if (row_expr == null and is_plural_store) {
        return .{ .transformed = .{ .replacement = H.errItem(allocator, flow.location, flow.module, "std/store:stored: '{s}' is a container store (capacity > 1) - address the row ({s}[handle].{s}, or write through a query branch)", .{ target_store, target_store, target_field }) } };
    }
    if (row_expr != null and !is_plural_store) {
        return .{ .transformed = .{ .replacement = H.errItem(allocator, flow.location, flow.module, "std/store:stored: '{s}' is a capacity-1 value store - write it as {s}.{s}", .{ target_store, target_store, target_field }) } };
    }

    // Owned-column stores now generate the write surface (the WRITE rung,
    // 690_062: discharge-old + consume-new) — EXCEPT a DRAIN store (ambiguous
    // discharger, 690_057/058), where unit-4 stays ungated-off: the write's
    // eviction has no canonical discharger to fire. Detect that store FIRST
    // (teardown unit exists, apply unit does not) and name the real rung —
    // otherwise H.fieldOrder below would leak a raw "unknown store".
    {
        const td_probe = std.fmt.allocPrint(allocator, "__store_teardown_{s}", .{target_store}) catch unreachable;
        const apply_probe = std.fmt.allocPrint(allocator, "__store_apply_{s}", .{target_store}) catch unreachable;
        var has_teardown = false;
        var has_apply = false;
        for (program.items) |pi| {
            if (pi != .event_decl) continue;
            const ed = &pi.event_decl;
            if (ed.path.segments.len != 1) continue;
            if (std.mem.eql(u8, ed.path.segments[0], td_probe)) has_teardown = true;
            if (std.mem.eql(u8, ed.path.segments[0], apply_probe)) has_apply = true;
        }
        if (has_teardown and !has_apply) {
            return .{ .transformed = .{ .replacement = H.errItem(allocator, flow.location, flow.module, "std/store:stored: store '{s}' is a DRAIN store (ambiguous discharger) - a stored write must evict the old value through the canonical discharger, which its owned column does not have; declare exactly one void discharger for the column type (690_062 pins the write; 690_057/058 pin the drain)", .{target_store}) } };
        }
    }

    const order = H.fieldOrder(allocator, program, target_store) orelse {
        return .{ .transformed = .{ .replacement = H.errItem(allocator, flow.location, flow.module, "std/store:stored: unknown store '{s}' - no std/store:new({s}) found", .{ target_store, target_store }) } };
    };
    const field_idx: usize = blk: {
        for (order, 0..) |fname, i| {
            if (std.mem.eql(u8, fname, target_field)) break :blk i;
        }
        return .{ .transformed = .{ .replacement = H.errItem(allocator, flow.location, flow.module, "std/store:stored: '{s}' is not a field of store '{s}'", .{ target_field, target_store }) } };
    };

    // SELF-FK traversal head: `store[handle.reffield]` addresses the row whose
    // index IS the value of `reffield` in row `handle` — i.e. it FOLLOWS a
    // stored self-foreign-key. `reffield` must be a field of THIS store (a
    // handle-carrying column); the head is rewritten to a column read so the
    // ref dereferences to a row index (one hop). A plain handle head (`[a]`,
    // `[__koru_qrow]`) has no dot and is left untouched.
    if (row_expr) |re| {
        if (std.mem.indexOfScalar(u8, re, '.')) |dp| {
            const base = std.mem.trim(u8, re[0..dp], " ");
            const ref_field = std.mem.trim(u8, re[dp + 1 ..], " ");
            var ref_ok = false;
            for (order) |fname| {
                if (std.mem.eql(u8, fname, ref_field)) {
                    ref_ok = true;
                    break;
                }
            }
            if (!ref_ok) {
                return .{ .transformed = .{ .replacement = H.errItem(allocator, flow.location, flow.module, "std/store:stored: self-FK head '{s}[{s}]' - '{s}' is not a field of store '{s}' (a reference head follows a handle-carrying column of the same store)", .{ target_store, re, ref_field, target_store }) } };
            }
            row_expr = std.fmt.allocPrint(allocator, "__koru_store_{s}.{s}[@as(usize, @intCast({s}))]", .{ target_store, ref_field, base }) catch unreachable;
        }
    }

    const rewritten_expr = H.storeRefs(allocator, w.value, target_store);

    // TT2 (695_002): a site that handles `| cycle` routes to the guarded
    // variant `__store_writec_*` — the insertf pattern (the target event's
    // branch set matches what the site handles). The un-branched `|>` tail
    // becomes the `| ok` arm (it runs only when the write landed); a missing
    // ok arm is synthesized as a no-op so the dispatch is exhaustive.
    var has_cycle_cont = false;
    for (flow.body.continuations) |*c| {
        if (std.mem.eql(u8, std.mem.trim(u8, c.branch, " "), "cycle")) has_cycle_cont = true;
    }
    if (has_cycle_cont) {
        const writec_name = std.fmt.allocPrint(allocator, "__store_writec_{s}", .{target_store}) catch unreachable;
        const store_is_tree = blk: {
            for (program.items) |pi| {
                if (pi != .event_decl) continue;
                const ed = &pi.event_decl;
                if (ed.path.segments.len == 1 and std.mem.eql(u8, ed.path.segments[0], writec_name)) break :blk true;
            }
            break :blk false;
        };
        if (!store_is_tree) {
            return .{ .transformed = .{ .replacement = H.errItem(allocator, flow.location, flow.module, "std/store:stored: `| cycle` guards the synthesized parent write of a [tree] store - '{s}' is not a [tree] store", .{target_store}) } };
        }
        if (!std.mem.eql(u8, target_field, "parent")) {
            return .{ .transformed = .{ .replacement = H.errItem(allocator, flow.location, flow.module, "std/store:stored: `| cycle` attaches to the [tree]-synthesized parent write - '{s}.{s}' is not the parent column", .{ target_store, target_field }) } };
        }
        const re = row_expr orelse {
            return .{ .transformed = .{ .replacement = H.errItem(allocator, flow.location, flow.module, "std/store:stored: `| cycle` needs a row-addressed parent write ({s}[handle].parent)", .{target_store}) } };
        };
        var cyc_conts = std.ArrayList(ast.Continuation).initCapacity(allocator, flow.body.continuations.len + 1) catch unreachable;
        var has_ok_cont = false;
        for (flow.body.continuations) |*c| {
            const bname = std.mem.trim(u8, c.branch, " ");
            var cl = ast_functional.cloneContinuation(allocator, c) catch unreachable;
            if (bname.len == 0) {
                // The success tail rides the ok arm — mirror of `| row <b> |> tail`.
                cl.branch = allocator.dupe(u8, "ok") catch unreachable;
                has_ok_cont = true;
            } else if (!std.mem.eql(u8, bname, "cycle")) {
                return .{ .transformed = .{ .replacement = H.errItem(allocator, flow.location, flow.module, "std/store:stored: branch '{s}' - a guarded parent write answers `|>` (ok) and `| cycle` only", .{c.branch}) } };
            }
            cyc_conts.append(allocator, cl) catch unreachable;
        }
        if (!has_ok_cont) {
            cyc_conts.append(allocator, ast.Continuation{
                .branch = allocator.dupe(u8, "ok") catch unreachable,
                .binding = null,
                .kind = .terminal,
                .condition = null,
                .node = .terminal,
                .indent = 1,
                .continuations = &[_]ast.Continuation{},
                .location = flow.location,
            }) catch unreachable;
        }
        const csegs = allocator.alloc([]const u8, 1) catch unreachable;
        csegs[0] = writec_name;
        const cargs = allocator.alloc(ast.Arg, 3) catch unreachable;
        cargs[0] = ast.Arg{ .name = allocator.dupe(u8, "row") catch unreachable, .value = allocator.dupe(u8, re) catch unreachable };
        cargs[1] = ast.Arg{ .name = allocator.dupe(u8, "field") catch unreachable, .value = std.fmt.allocPrint(allocator, "{d}", .{field_idx}) catch unreachable };
        cargs[2] = ast.Arg{ .name = allocator.dupe(u8, "value") catch unreachable, .value = rewritten_expr };
        const writec_inv = ast.Invocation{
            .path = ast.DottedPath{
                .module_qualifier = allocator.dupe(u8, flow.module) catch unreachable,
                .segments = csegs,
            },
            .args = cargs,
        };
        return .{ .transformed = .{ .replacement = ast.Item{ .flow = ast.Flow{
            .body = ast.rootSite(writec_inv, cyc_conts.toOwnedSlice(allocator) catch unreachable, flow.location),
            .pre_label = null,
            .impl_of = flow.impl_of,
            .super_shape = null,
            .inline_body = null,
            .preamble_code = null,
            .is_pure = false,
            .is_transitively_pure = false,
            .location = flow.location,
            .module = allocator.dupe(u8, flow.module) catch unreachable,
        } } } };
    }

    // The target event: the bundled `__store_write_<s>` surface, EXCEPT for a
    // row-addressed write in an owned-containing store, which routes to the
    // per-field targeted event `__store_fwrite_<s>_<i>` (unit 4c) — resolved
    // inside the plural block below once column owned-ness is known.
    var write_name = std.fmt.allocPrint(allocator, "__store_write_{s}", .{target_store}) catch unreachable;
    // A PLURAL write surface carries per-field typed value slots (690_049):
    // `value_<i>: <column type>`, the written column's slot gets the
    // expression, the others typed zeros its arm never reads. Column types
    // come off the generated apply event's branch payloads — the plural
    // path guarantees create ran (is_plural_store keys off the generated
    // inserth event). A SINGLETON keeps the uniform {field, value} shape.
    const call_args = if (row_expr != null) blk: {
        // Column owned-ness rides the apply event's branch payloads (an owned
        // field's payload carries the bare-borrow phantom, 690_063) — the
        // stored transform reads it back rather than re-deriving the column
        // types from the declaration.
        var col_owned: []const bool = &[_]bool{};
        const col_types: []const []const u8 = types_blk: {
            const apply_name = std.fmt.allocPrint(allocator, "__store_apply_{s}", .{target_store}) catch unreachable;
            for (program.items) |pi| {
                if (pi != .event_decl) continue;
                const ed = &pi.event_decl;
                if (ed.path.segments.len == 1 and std.mem.eql(u8, ed.path.segments[0], apply_name)) {
                    const types = allocator.alloc([]const u8, ed.branches.len) catch unreachable;
                    const owneds = allocator.alloc(bool, ed.branches.len) catch unreachable;
                    for (ed.branches, 0..) |b, bi| {
                        types[bi] = if (b.payload.fields.len > 0) b.payload.fields[0].type else "i64";
                        owneds[bi] = b.payload.fields.len > 0 and b.payload.fields[0].phantom != null;
                    }
                    col_owned = owneds;
                    break :types_blk types;
                }
            }
            return .{ .transformed = .{ .replacement = H.errItem(allocator, flow.location, flow.module, "std/store:stored: internal - plural store '{s}' has no generated apply event (create must have run: inserth exists without apply)", .{target_store}) } };
        };
        // A write rides ONE typed value slot per column; a slot no arm reads
        // is a typed zero (690_049). An OWNED column has no typed zero — a
        // dead owned slot would need a consumed obligation it does not hold.
        // So an owned-containing store's write is DE-BUNDLED (the `captured`
        // model, 690_064): it targets the per-field event
        // `__store_fwrite_<s>_<i>(row, value)`, threading ONLY the written
        // field's value — a scalar write never references an owned sibling's
        // slot or its obligation, and the owned field's own write consumes
        // its <!state> on its single slot (690_062).
        var store_has_owned = false;
        for (col_owned) |co| {
            if (co) store_has_owned = true;
        }
        if (store_has_owned) {
            write_name = std.fmt.allocPrint(allocator, "__store_fwrite_{s}_{d}", .{ target_store, field_idx }) catch unreachable;
            const fargs = allocator.alloc(ast.Arg, 2) catch unreachable;
            fargs[0] = ast.Arg{
                .name = allocator.dupe(u8, "row") catch unreachable,
                .value = allocator.dupe(u8, row_expr.?) catch unreachable,
            };
            fargs[1] = ast.Arg{
                .name = allocator.dupe(u8, "value") catch unreachable,
                .value = rewritten_expr,
            };
            break :blk fargs;
        }
        const args = allocator.alloc(ast.Arg, col_types.len + 2) catch unreachable;
        args[0] = ast.Arg{
            .name = allocator.dupe(u8, "row") catch unreachable,
            .value = allocator.dupe(u8, row_expr.?) catch unreachable,
        };
        args[1] = ast.Arg{
            .name = allocator.dupe(u8, "field") catch unreachable,
            .value = std.fmt.allocPrint(allocator, "{d}", .{field_idx}) catch unreachable,
        };
        for (col_types, 0..) |ct, ci| {
            const is_float = std.mem.eql(u8, ct, "f64") or std.mem.eql(u8, ct, "f32");
            // A fixed-char column's slot is `string` — its typed zero is the
            // empty string literal (690_052).
            const is_string = std.mem.eql(u8, ct, "string") or std.mem.eql(u8, ct, "[]const u8");
            args[2 + ci] = ast.Arg{
                .name = std.fmt.allocPrint(allocator, "value_{d}", .{ci}) catch unreachable,
                .value = if (ci == field_idx)
                    rewritten_expr
                else
                    allocator.dupe(u8, if (is_string) "\"\"" else if (is_float) "0.0" else "0") catch unreachable,
            };
        }
        break :blk args;
    } else blk: {
        const args = allocator.alloc(ast.Arg, 2) catch unreachable;
        args[0] = ast.Arg{
            .name = allocator.dupe(u8, "field") catch unreachable,
            .value = std.fmt.allocPrint(allocator, "{d}", .{field_idx}) catch unreachable,
        };
        args[1] = ast.Arg{
            .name = allocator.dupe(u8, "value") catch unreachable,
            .value = rewritten_expr,
        };
        break :blk args;
    };
    const segs = allocator.alloc([]const u8, 1) catch unreachable;
    segs[0] = write_name;
    const write_inv = ast.Invocation{
        .path = ast.DottedPath{
            .module_qualifier = allocator.dupe(u8, flow.module) catch unreachable,
            .segments = segs,
        },
        .args = call_args,
    };

    return .{ .transformed = .{ .replacement = ast.Item{ .flow = ast.Flow{
        // `stored` is an ordinary void step: whatever was chained after it
        // (`stored{…} |> next`) is the containing flow's continuations, and it
        // must survive the rewrite. Threading `flow.body.continuations` through
        // — UN-marked — lets the transform runner's fixed-point pass re-lower a
        // tail that is itself a `stored` (690_028). Empty here dropped the tail.
        .body = ast.rootSite(write_inv, flow.body.continuations, flow.location),
        .pre_label = null,
        .impl_of = flow.impl_of, // preserved: the site may BE an impl flow's head (e.g. a query body)
        .super_shape = null,
        .inline_body = null,
        .preamble_code = null,
        .is_pure = false,
        .is_transitively_pure = false,
        .location = flow.location,
        .module = allocator.dupe(u8, flow.module) catch unreachable,
    } } } };
}

// ============================================================================
// STORE.DEFAULT — the bare reference form as a program-wide reactive attach
// ============================================================================
//
//   std/store(enemies)
//   ! hp h |> …                     // a standing rule, from anywhere
//
// `std/store(name)` is the store's reference; `std/store(name) ! arms` attaches
// those arms as standing reactive rules — a program-wide `watch`. This is a
// `[pre]`-phase rewrite: it renames the bare `default` invocation to `watch`
// BEFORE `create` scans for watch arms, so the entire (already-green) watch
// machinery — create-time splice into the write-subflow, transplant-purity,
// self-erase — handles it with no duplication. Reactive rules are top-level
// only; they are standing rules, not mid-flow steps.

~[keyword|comptime|transform|pre]pub event default {
    expr: Expression,
    invocation: *const Invocation,
    item: *const Item,
    program: *const Program,
    allocator: std.mem.Allocator
} -> SiteResult

~[transform]proc default|zig {
    const ast = @import("ast");
    const ast_functional = @import("ast_functional");
    if (item.* != .flow) @panic("store:default transform: containing item is not a flow - walker dispatch contract broken");
    const flow = &item.flow;

    // The bare `std/store(name)` form names its positional arg by the store
    // name itself (`{name:"game", value:"game"}`), not under `expr` like the
    // `:verb(arg)` forms — so pull the store name and hand watch a proper
    // `expr` arg.
    if (invocation.args.len == 0) {
        const msg = std.fmt.allocPrint(allocator, "comptime {{ @compileError(\"std/store(name): the reference form needs a store name\"); }}", .{}) catch unreachable;
        return .{ .transformed = .{ .replacement = ast.Item{ .inline_code = ast.InlineCode{ .code = msg, .location = flow.location, .module = flow.module } } } };
    }
    const store_name = invocation.args[0].value;

    // Dispatch on branch kind. `!` reactive arms (`.effect`) → watch, below.
    // Any other branch — a `| store s` operation binding (`.terminal`) — is the
    // OPERATION form of the reference, which isn't built yet. Say so at the koru
    // level rather than mis-rewriting to watch (which reads the branch name as a
    // field: the misleading "'store' is not a field" leak).
    if (flow.body.continuations.len > 0 and flow.body.continuations[0].kind != .effect) {
        const inner = std.fmt.allocPrint(allocator, "std/store({s}): only the reactive-attach form of the reference is built — `std/store({s}) ! <field> <bind> |> ...`. The operation form (`| store s |> ...`) is a later rung; for now operate by name (std/store:insert({s}), std/store:stored).", .{ store_name, store_name, store_name }) catch unreachable;
        const msg = std.fmt.allocPrint(allocator, "comptime {{ @compileError(\"{s}\"); }}", .{inner}) catch unreachable;
        return .{ .transformed = .{ .replacement = ast.Item{ .inline_code = ast.InlineCode{ .code = msg, .location = flow.location, .module = flow.module } } } };
    }

    // Rename the invocation default → watch, carrying the store name as `expr`
    // and the same `!` arm continuations. From here the watch path runs.
    const segs = allocator.alloc([]const u8, 1) catch unreachable;
    segs[0] = allocator.dupe(u8, "watch") catch unreachable;
    const watch_args = allocator.alloc(ast.Arg, 1) catch unreachable;
    watch_args[0] = ast.Arg{ .name = allocator.dupe(u8, "expr") catch unreachable, .value = allocator.dupe(u8, store_name) catch unreachable };
    const watch_inv = ast.Invocation{
        .path = ast.DottedPath{ .module_qualifier = allocator.dupe(u8, "std.store") catch unreachable, .segments = segs },
        .args = watch_args,
    };
    const conts = allocator.alloc(ast.Continuation, flow.body.continuations.len) catch unreachable;
    for (flow.body.continuations, 0..) |*c, i| {
        conts[i] = ast_functional.cloneContinuation(allocator, c) catch unreachable;
    }
    return .{ .transformed = .{ .replacement = ast.Item{ .flow = ast.Flow{
        .body = ast.rootSite(watch_inv, conts, flow.location),
        .pre_label = null,
        .impl_of = flow.impl_of,
        .super_shape = null,
        .inline_body = null,
        .preamble_code = null,
        .is_pure = false,
        .is_transitively_pure = false,
        .location = flow.location,
        .module = allocator.dupe(u8, flow.module) catch unreachable,
    } } } };
}

// ============================================================================
// STORE.WATCH — subscriptions; bodies are transplanted by the coordinator
// ============================================================================
//
// By the time this transform fires for a well-formed program, create has
// already spliced this watch's branches into the write-subflow — the site
// self-erases. Firing with the store's create still untransformed means the
// watch precedes its create in source (a rung-one ordering wall); no create
// anywhere is a plain unknown-store diagnostic.

~[keyword|comptime|transform]pub event watch {
    expr: Expression,
    invocation: *const Invocation,
    item: *const Item,
    program: *const Program,
    allocator: std.mem.Allocator
} -> SiteResult

~[transform]proc watch|zig {
    const ast = @import("ast");
    if (item.* != .flow) @panic("store:watch transform: containing item is not a flow - walker dispatch contract broken");
    const flow = &item.flow;

    const H = struct {
        fn stripQuotes(n: []const u8) []const u8 {
            if (n.len >= 2 and n[0] == '"') return n[1 .. n.len - 1];
            return n;
        }
        fn errItem(alloc: std.mem.Allocator, loc: anytype, module: []const u8, comptime fmt: []const u8, args: anytype) ast.Item {
            const inner = std.fmt.allocPrint(alloc, fmt, args) catch unreachable;
            const msg = std.fmt.allocPrint(alloc, "comptime {{ @compileError(\"{s}\"); }}", .{inner}) catch unreachable;
            return ast.Item{ .inline_code = ast.InlineCode{ .code = msg, .location = loc, .module = module } };
        }
    };

    var store_name: []const u8 = "";
    for (invocation.args) |arg| {
        if (std.mem.eql(u8, arg.name, "expr")) store_name = H.stripQuotes(arg.value);
    }
    if (store_name.len == 0) {
        return .{ .transformed = .{ .replacement = H.errItem(allocator, flow.location, flow.module, "std/store:watch requires a store name: watch(name)", .{}) } };
    }

    // ------------------------------------------------------------------
    // TRANSPLANT PURITY (ruling (a), thesis T1; 690_006 is the acceptance
    // rejection). A watch body executes at the store's WRITE SITES, not at
    // its lexical position — its free names must be its own branch
    // bindings or comptime-known names (store names; qualified calls live
    // in node paths, not arg text). The check runs HERE, rewrite-time,
    // pre-checker: a koru-level diagnostic, never a raw Zig
    // undeclared-identifier leak.
    // ------------------------------------------------------------------
    const Purity = struct {
        const Ctx = struct {
            // Names in scope at the CURRENT point in the arm: the branch
            // payload of each enclosing continuation plus the mid-pipe
            // `: name` binds (Invocation.return_binding) produced by earlier
            // steps of the SAME arm. Grown/shrunk push-pop as scanCont
            // descends, so a pipe bind is visible to downstream steps but not
            // to itself or to sibling arms. A name from the ENCLOSING flow is
            // never pushed here — that is precisely the 690_006 rejection.
            scope: *std.ArrayList([]const u8),
            allocator: std.mem.Allocator,
            stores: []const []const u8,
            violation: ?[]const u8 = null,
        };
        fn isIdentStart(ch: u8) bool {
            return (ch >= 'a' and ch <= 'z') or (ch >= 'A' and ch <= 'Z') or ch == '_';
        }
        fn isIdent(ch: u8) bool {
            return isIdentStart(ch) or (ch >= '0' and ch <= '9') or ch == '-';
        }
        fn rootAllowed(ctx: *const Ctx, root: []const u8) bool {
            if (std.mem.startsWith(u8, root, "__koru_")) return true;
            const keywords = [_][]const u8{ "and", "or", "not", "true", "false", "_" };
            for (keywords) |k| if (std.mem.eql(u8, root, k)) return true;
            for (ctx.scope.items) |a| if (std.mem.eql(u8, root, a)) return true;
            for (ctx.stores) |s| if (std.mem.eql(u8, root, s)) return true;
            return false;
        }
        // Scan expression text for free ident roots. Inside string literals
        // only `{{ }}` interpolation holes count (and a hole's `:fmt` tail
        // is a format spec, not a name).
        fn scanText(ctx: *Ctx, text: []const u8) void {
            var i: usize = 0;
            var in_str = false;
            var in_hole = false;
            var hole_past_colon = false;
            while (i < text.len) {
                const c = text[i];
                if (!in_str) {
                    if (c == '"') {
                        in_str = true;
                        i += 1;
                        continue;
                    }
                    if (isIdentStart(c)) {
                        i = checkIdent(ctx, text, i);
                        if (ctx.violation != null) return;
                        continue;
                    }
                    i += 1;
                    continue;
                }
                if (in_hole) {
                    if (i + 1 < text.len and text[i] == '}' and text[i + 1] == '}') {
                        in_hole = false;
                        hole_past_colon = false;
                        i += 2;
                        continue;
                    }
                    if (c == ':') {
                        hole_past_colon = true;
                        i += 1;
                        continue;
                    }
                    if (!hole_past_colon and isIdentStart(c)) {
                        i = checkIdent(ctx, text, i);
                        if (ctx.violation != null) return;
                        continue;
                    }
                    i += 1;
                    continue;
                }
                if (i + 1 < text.len and text[i] == '{' and text[i + 1] == '{') {
                    in_hole = true;
                    i += 2;
                    continue;
                }
                if (c == '"') in_str = false;
                i += 1;
            }
        }
        // Read one dotted ident chain starting at `start`; only the ROOT is
        // name-resolved (the rest are field accesses on it).
        fn checkIdent(ctx: *Ctx, text: []const u8, start: usize) usize {
            var j = start;
            while (j < text.len and isIdent(text[j])) j += 1;
            const root = text[start..j];
            while (j + 1 < text.len and text[j] == '.' and isIdentStart(text[j + 1])) {
                j += 1;
                while (j < text.len and isIdent(text[j])) j += 1;
            }
            if (!rootAllowed(ctx, root)) ctx.violation = root;
            return j;
        }
        fn scanCont(ctx: *Ctx, cont: *const ast.Continuation) void {
            if (ctx.violation != null) return;
            const base = ctx.scope.items.len;
            // This continuation's branch payload is in scope for its own node
            // args (`! clicks c |> f(c)`) and for everything below it.
            if (cont.binding) |b| ctx.scope.append(ctx.allocator, b) catch unreachable;
            for (cont.destructure) |df| ctx.scope.append(ctx.allocator, df.name) catch unreachable;

            if (cont.condition) |cond| scanText(ctx, cond);
            if (cont.node) |n| {
                switch (n) {
                    .invocation => |inv| {
                        for (inv.args) |a| {
                            scanText(ctx, a.value);
                            if (a.expression_value) |ev| scanText(ctx, ev.text);
                            if (a.source_value) |sv| scanText(ctx, sv.text);
                            if (ctx.violation != null) break;
                        }
                    },
                    else => {},
                }
            }

            if (ctx.violation == null) {
                // The pipe result of THIS step (`... : l |>`) is in scope for
                // the downstream steps (its continuations), NOT for its own
                // args above. return_binding / return_destructure are the
                // mid-chain binds the flat allowed-set used to miss.
                if (cont.node) |n| switch (n) {
                    .invocation => |inv| {
                        if (inv.return_binding) |rb| ctx.scope.append(ctx.allocator, rb) catch unreachable;
                        for (inv.return_destructure) |df| ctx.scope.append(ctx.allocator, df.name) catch unreachable;
                    },
                    else => {},
                };
                for (cont.continuations) |*c| scanCont(ctx, c);
            }

            // Pop everything this level pushed: siblings must not see these binds.
            ctx.scope.shrinkRetainingCapacity(base);
        }
    };

    // All store names in the program (untransformed creates + generated
    // apply events) — comptime-known, always legal in a watch body.
    var known_stores = std.ArrayList([]const u8).initCapacity(allocator, 4) catch unreachable;
    for (program.items) |pi| {
        switch (pi) {
            .flow => |*f| {
                const finv = f.inv();
                if (finv.path.segments.len == 1 and std.mem.eql(u8, finv.path.segments[0], "new")) {
                    if (finv.path.module_qualifier) |mq| {
                        if (std.mem.eql(u8, mq, "std.store")) {
                            for (finv.args) |a| {
                                if (std.mem.eql(u8, a.name, "expr")) known_stores.append(allocator, H.stripQuotes(a.value)) catch unreachable;
                            }
                        }
                    }
                }
            },
            .event_decl => |*ed| {
                if (ed.path.segments.len == 1 and std.mem.startsWith(u8, ed.path.segments[0], "__store_apply_")) {
                    known_stores.append(allocator, ed.path.segments[0]["__store_apply_".len..]) catch unreachable;
                }
            },
            else => {},
        }
    }

    // Find this watch site's branch continuations within the containing
    // flow (the invocation pointer points into the tree).
    const FindSite = struct {
        fn call(cont: *const ast.Continuation, target: *const ast.Invocation) ?*const ast.Continuation {
            if (cont.node) |*n| {
                if (n.* == .invocation and &n.invocation == target) return cont;
            }
            for (cont.continuations) |*c| {
                if (call(c, target)) |found| return found;
            }
            return null;
        }
    }.call;
    const site: ?*const ast.Continuation = FindSite(&flow.body, invocation);

    if (site) |sc| {
        for (sc.continuations) |*wc| {
            // scanCont owns all scope: it pushes wc's own payload binding and
            // every mid-pipe `: name` bind as it descends, so the initial
            // scope is empty (comptime-known store names live in `stores`).
            var scope = std.ArrayList([]const u8).initCapacity(allocator, 8) catch unreachable;
            var pctx = Purity.Ctx{ .scope = &scope, .allocator = allocator, .stores = known_stores.items };
            Purity.scanCont(&pctx, wc);
            if (pctx.violation) |name| {
                return .{ .transformed = .{ .replacement = H.errItem(allocator, flow.location, flow.module, "std/store: watch body references '{s}', runtime state of the enclosing flow - a watch body executes at '{s}'s write sites, not here; bind it through a store or react at a write site", .{ name, store_name }) } };
            }
        }
    }

    // A pure watch nested mid-flow is legal placement by design
    // (organizational principle) but its splice is a later slice — wall it
    // rather than silently dropping the subscription.
    const is_top_level = invocation == flow.inv();
    if (!is_top_level) {
        return .{ .transformed = .{ .replacement = H.errItem(allocator, flow.location, flow.module, "std/store:watch({s}): nested watch splicing is a later slice - place the watch at top level for now", .{store_name}) } };
    }

    // Did the coordinator already run? Its generated write event is the marker.
    const write_name = std.fmt.allocPrint(allocator, "__store_write_{s}", .{store_name}) catch unreachable;
    var spliced = false;
    for (program.items) |pi| {
        if (pi != .event_decl) continue;
        const ed = &pi.event_decl;
        if (ed.path.segments.len == 1 and std.mem.eql(u8, ed.path.segments[0], write_name)) {
            spliced = true;
            break;
        }
    }
    if (spliced) {
        const consumed = std.fmt.allocPrint(allocator, "// std/store: watch({s}) spliced into the write-subflow", .{store_name}) catch unreachable;
        return .{ .transformed = .{ .replacement = ast.Item{ .host_line = ast.HostLine{
            .content = consumed,
            .location = flow.location,
            .module = allocator.dupe(u8, flow.module) catch unreachable,
        } } } };
    }

    // Not spliced: is there an untransformed create later in the program?
    var create_exists = false;
    for (program.items) |pi| {
        if (pi != .flow) continue;
        const f = &pi.flow;
        const inv = f.inv();
        if (inv.path.segments.len != 1 or !std.mem.eql(u8, inv.path.segments[0], "new")) continue;
        const mq = inv.path.module_qualifier orelse continue;
        if (!std.mem.eql(u8, mq, "std.store")) continue;
        for (inv.args) |a| {
            if (std.mem.eql(u8, a.name, "expr") and std.mem.eql(u8, H.stripQuotes(a.value), store_name)) {
                create_exists = true;
            }
        }
    }
    if (create_exists) {
        return .{ .transformed = .{ .replacement = H.errItem(allocator, flow.location, flow.module, "std/store:watch({s}): the watch precedes its store's create in source - declare the store first (rung-one ordering)", .{store_name}) } };
    }
    return .{ .transformed = .{ .replacement = H.errItem(allocator, flow.location, flow.module, "std/store:watch({s}): unknown store - no std/store:new({s}) found", .{ store_name, store_name }) } };
}

// ============================================================================
// STORE.INSERT — append a row to a plural store (rung two)
// ============================================================================
//
//   ~std/store:insert(game) { hp: 30, kind: 1 }              — bare append
//   ~std/store:insert(game) { hp: 50, kind: 1 } | row r |> … — handle form
//
// Rewritten into `__store_insert_<s>(…)` (void) or `__store_inserth_<s>(…)`
// (`| row i64`) — the site's own continuations ride along. `__site_line`
// carries the site's source position so standing query enters stay honest
// about program order (a query only hears inserts BELOW it in source).

~[keyword|comptime|transform]pub event insert {
    expr: Expression,
    source: Source,
    invocation: *const Invocation,
    item: *const Item,
    program: *const Program,
    allocator: std.mem.Allocator
} -> SiteResult

~[transform]proc insert|zig {
    const ast = @import("ast");
    const ast_functional = @import("ast_functional");
    const struct_literal = @import("struct_literal");

    if (item.* != .flow) @panic("store:insert transform: containing item is not a flow - walker dispatch contract broken");
    const flow = &item.flow;

    const H = struct {
        fn stripQuotes(n: []const u8) []const u8 {
            if (n.len >= 2 and n[0] == '"') return n[1 .. n.len - 1];
            return n;
        }
        fn errItem(alloc: std.mem.Allocator, loc: anytype, module: []const u8, comptime fmt: []const u8, args: anytype) ast.Item {
            const inner = std.fmt.allocPrint(alloc, fmt, args) catch unreachable;
            const msg = std.fmt.allocPrint(alloc, "comptime {{ @compileError(\"{s}\"); }}", .{inner}) catch unreachable;
            return ast.Item{ .inline_code = ast.InlineCode{ .code = msg, .location = loc, .module = module } };
        }
        fn mkPathH(alloc: std.mem.Allocator, module: []const u8, name: []const u8) ast.DottedPath {
            const segs = alloc.alloc([]const u8, 1) catch unreachable;
            segs[0] = alloc.dupe(u8, name) catch unreachable;
            return ast.DottedPath{ .module_qualifier = alloc.dupe(u8, module) catch unreachable, .segments = segs };
        }
        // The INSERT surface's column order. Preferred source: the generated
        // `__store_insert_<s>` event's input shape (its fields ARE the insert
        // contract — user columns + trailing __site_line), which excludes any
        // [tree]-synthesized `parent` column. Fallbacks: the apply event's
        // branches (pre-tree stores where insert == full column set), then
        // the untransformed create's seed block.
        fn fieldOrder(alloc: std.mem.Allocator, prog: *const ast.Program, store: []const u8) ?[]const []const u8 {
            const insert_ev_name = std.fmt.allocPrint(alloc, "__store_insert_{s}", .{store}) catch unreachable;
            for (prog.items) |pi| {
                if (pi != .event_decl) continue;
                const ed = &pi.event_decl;
                if (ed.path.segments.len == 1 and std.mem.eql(u8, ed.path.segments[0], insert_ev_name)) {
                    const flds = ed.input.fields;
                    if (flds.len == 0) return null;
                    // The trailing field is the synthetic __site_line arg.
                    const names = alloc.alloc([]const u8, flds.len - 1) catch unreachable;
                    for (flds[0 .. flds.len - 1], 0..) |f2, i| names[i] = f2.name;
                    return names;
                }
            }
            const apply_name = std.fmt.allocPrint(alloc, "__store_apply_{s}", .{store}) catch unreachable;
            for (prog.items) |pi| {
                if (pi != .event_decl) continue;
                const ed = &pi.event_decl;
                if (ed.path.segments.len == 1 and std.mem.eql(u8, ed.path.segments[0], apply_name)) {
                    const names = alloc.alloc([]const u8, ed.branches.len) catch unreachable;
                    for (ed.branches, 0..) |b, i| names[i] = b.name;
                    return names;
                }
            }
            for (prog.items) |pi| {
                if (pi != .flow) continue;
                const f = &pi.flow;
                const inv = f.inv();
                if (inv.path.segments.len != 1 or !std.mem.eql(u8, inv.path.segments[0], "new")) continue;
                const mq = inv.path.module_qualifier orelse continue;
                if (!std.mem.eql(u8, mq, "std.store")) continue;
                var name_matches = false;
                var seed: ?[]const u8 = null;
                for (inv.args) |a| {
                    if (std.mem.eql(u8, a.name, "expr")) {
                        name_matches = std.mem.eql(u8, stripQuotes(a.value), store);
                    } else if (std.mem.eql(u8, a.name, "source")) {
                        seed = a.value;
                    }
                }
                if (!name_matches or seed == null) continue;
                const braced = std.fmt.allocPrint(alloc, "{{{s}}}", .{seed.?}) catch unreachable;
                const cf = struct_literal.parseFields(alloc, braced) catch &[_]struct_literal.StructField{};
                if (cf.len == 0) return null;
                const names = alloc.alloc([]const u8, cf.len) catch unreachable;
                for (cf, 0..) |c, i| names[i] = c.name;
                return names;
            }
            return null;
        }
        // Is `col` a fixed-char column, and how many bytes does it hold?
        // (690_052 — the comptime-literal overflow check needs N at the
        // insert site.) Sources, mirroring fieldOrder's transform-order
        // tolerance: the generated SoA cell host_line when create already
        // ran (`<col>: [CAP][N]u8` — store.kz owns both the writer and this
        // reader), else the untransformed create's seed block (`char[N]`).
        fn charCap(alloc: std.mem.Allocator, prog: *const ast.Program, store: []const u8, col: []const u8) ?usize {
            const marker = std.fmt.allocPrint(alloc, "const __KoruStoreT_{s} = struct {{", .{store}) catch unreachable;
            for (prog.items) |pi| {
                if (pi != .host_line) continue;
                const t = pi.host_line.content;
                if (std.mem.indexOf(u8, t, marker) == null) continue;
                const fkey = std.fmt.allocPrint(alloc, "\n    {s}: [", .{col}) catch unreachable;
                const fpos = std.mem.indexOf(u8, t, fkey) orelse return null;
                const rest = t[fpos + fkey.len ..];
                // scalar: `8]i64 = undefined`; fixed-char: `8][16]u8 = undefined`
                const close = std.mem.indexOfScalar(u8, rest, ']') orelse return null;
                const after = rest[close + 1 ..];
                if (after.len == 0 or after[0] != '[') return null;
                const close2 = std.mem.indexOfScalar(u8, after, ']') orelse return null;
                if (!std.mem.startsWith(u8, after[close2 + 1 ..], "u8")) return null;
                return std.fmt.parseInt(usize, after[1..close2], 10) catch null;
            }
            // create not yet transformed: read the raw seed block.
            for (prog.items) |pi| {
                if (pi != .flow) continue;
                const f = &pi.flow;
                const inv = f.inv();
                if (inv.path.segments.len != 1 or !std.mem.eql(u8, inv.path.segments[0], "new")) continue;
                const mq = inv.path.module_qualifier orelse continue;
                if (!std.mem.eql(u8, mq, "std.store")) continue;
                var name_matches = false;
                var seed: ?[]const u8 = null;
                for (inv.args) |a| {
                    if (std.mem.eql(u8, a.name, "expr")) {
                        name_matches = std.mem.eql(u8, stripQuotes(a.value), store);
                    } else if (std.mem.eql(u8, a.name, "source")) {
                        seed = a.value;
                    }
                }
                if (!name_matches or seed == null) continue;
                const braced = std.fmt.allocPrint(alloc, "{{{s}}}", .{seed.?}) catch unreachable;
                const cf = struct_literal.parseFields(alloc, braced) catch return null;
                for (cf) |c| {
                    if (!std.mem.eql(u8, c.name, col)) continue;
                    const v = std.mem.trim(u8, c.value, " ");
                    if (std.mem.startsWith(u8, v, "char[") and v.len > "char[".len and v[v.len - 1] == ']') {
                        return std.fmt.parseInt(usize, std.mem.trim(u8, v["char[".len .. v.len - 1], " "), 10) catch null;
                    }
                    return null;
                }
                return null;
            }
            return null;
        }
        // Unescaped byte length of a string literal's inner text: `\n` is one
        // byte, `\x41` is one byte. (`\u{...}` overcounts — acceptable
        // conservatism for a fixed-buffer limit check this rung.)
        fn literalByteLen(lit: []const u8) usize {
            var blen: usize = 0;
            var k: usize = 0;
            while (k < lit.len) {
                if (lit[k] == '\\' and k + 1 < lit.len) {
                    if (lit[k + 1] == 'x' and k + 3 < lit.len) {
                        k += 4;
                    } else {
                        k += 2;
                    }
                } else {
                    k += 1;
                }
                blen += 1;
            }
            return blen;
        }
    };

    var store_name: []const u8 = "";
    var block_text: ?[]const u8 = null;
    for (invocation.args) |arg| {
        if (std.mem.eql(u8, arg.name, "expr")) store_name = H.stripQuotes(arg.value);
        if (std.mem.eql(u8, arg.name, "source")) block_text = arg.value;
    }
    if (store_name.len == 0 or block_text == null) {
        return .{ .transformed = .{ .replacement = H.errItem(allocator, flow.location, flow.module, "std/store:insert requires a store name and a row block: insert(name) {{ field: value }}", .{}) } };
    }

    const order = H.fieldOrder(allocator, program, store_name) orelse {
        return .{ .transformed = .{ .replacement = H.errItem(allocator, flow.location, flow.module, "std/store:insert: unknown store '{s}' - no std/store:new({s}) found", .{ store_name, store_name }) } };
    };

    const braced = std.fmt.allocPrint(allocator, "{{{s}}}", .{block_text.?}) catch unreachable;
    const row_fields = struct_literal.parseFields(allocator, braced) catch &[_]struct_literal.StructField{};
    if (row_fields.len != order.len) {
        return .{ .transformed = .{ .replacement = H.errItem(allocator, flow.location, flow.module, "std/store:insert({s}): a row block names every column exactly once ({d} given, {d} declared)", .{ store_name, row_fields.len, order.len }) } };
    }

    // Args in declared column order; every column required.
    const call_args = allocator.alloc(ast.Arg, order.len + 1) catch unreachable;
    for (order, 0..) |col, i| {
        const val: []const u8 = blk: {
            for (row_fields) |rf| {
                if (std.mem.eql(u8, rf.name, col)) break :blk rf.value;
            }
            return .{ .transformed = .{ .replacement = H.errItem(allocator, flow.location, flow.module, "std/store:insert({s}): row block is missing column '{s}'", .{ store_name, col }) } };
        };
        // Fixed-char overflow (690_052): a COMPTIME-KNOWN string literal that
        // exceeds the column's byte length is a compile error naming column +
        // limit. Runtime values truncate in the insert proc (the `| toolong`
        // branch is a deferred refinement).
        if (H.charCap(allocator, program, store_name, col)) |ncap| {
            const v = std.mem.trim(u8, val, " ");
            if (v.len >= 2 and v[0] == '"' and v[v.len - 1] == '"') {
                const blen = H.literalByteLen(v[1 .. v.len - 1]);
                if (blen > ncap) {
                    return .{ .transformed = .{ .replacement = H.errItem(allocator, flow.location, flow.module, "std/store:insert({s}): string literal ({d} bytes) overflows char[{d}] column '{s}' - a fixed-char column holds at most its declared byte length", .{ store_name, blen, ncap, col }) } };
                }
            }
        }
        call_args[i] = ast.Arg{
            .name = allocator.dupe(u8, col) catch unreachable,
            .value = allocator.dupe(u8, val) catch unreachable,
        };
    }
    call_args[order.len] = ast.Arg{
        .name = allocator.dupe(u8, "__site_line") catch unreachable,
        .value = std.fmt.allocPrint(allocator, "{d}", .{flow.location.line}) catch unreachable,
    };

    // Handle form iff the site handles `| row …`; anything else on an
    // insert site is a loud wall this rung.
    const site_is_head = invocation == flow.inv();
    var has_row_cont = false;
    var has_full_cont = false;
    if (site_is_head) {
        for (flow.body.continuations) |*c| {
            const bname = std.mem.trim(u8, c.branch, " ");
            if (std.mem.eql(u8, bname, "row")) {
                has_row_cont = true;
            } else if (std.mem.eql(u8, bname, "full")) {
                has_full_cont = true;
            } else {
                return .{ .transformed = .{ .replacement = H.errItem(allocator, flow.location, flow.module, "std/store:insert({s}): branch '{s}' - insert answers `| row <binding>` and `| full` only (inserted/removed lifecycle is pinned at 690_016)", .{ store_name, c.branch }) } };
            }
        }
    }

    // Owned-string store (690_053): the `| full` give-back is a later rung —
    // insertf's early return would consume the caller's obligation without
    // keeping the value (a silent ownership leak). Detected from the
    // generated SoA cell text (store.kz owns both the writer and this
    // reader, the charCap pattern).
    if (has_full_cont) {
        const cell_marker = std.fmt.allocPrint(allocator, "const __KoruStoreT_{s} = struct {{", .{store_name}) catch unreachable;
        for (program.items) |pi| {
            if (pi != .host_line) continue;
            const t = pi.host_line.content;
            if (std.mem.indexOf(u8, t, cell_marker) == null) continue;
            // Any owned column emits a `[CAP]*Type` pointer cell (`]*`);
            // scalars/char never do. Type-independent so it catches *String and
            // any generalized owned column (*Resource, *File, …) alike.
            if (std.mem.indexOf(u8, t, "]*") != null) {
                return .{ .transformed = .{ .replacement = H.errItem(allocator, flow.location, flow.module, "std/store:insert({s}): the `| full` branch on an owned store is a later rung - graceful exhaustion (690_011) must GIVE BACK the consumed ownership, a surface 690_053 does not build; drop `| full` (capacity overflow panics loudly)", .{store_name}) } };
            }
            break;
        }
    }
    const target = if (has_full_cont)
        std.fmt.allocPrint(allocator, "__store_insertf_{s}", .{store_name}) catch unreachable
    else if (has_row_cont)
        std.fmt.allocPrint(allocator, "__store_inserth_{s}", .{store_name}) catch unreachable
    else
        std.fmt.allocPrint(allocator, "__store_insert_{s}", .{store_name}) catch unreachable;

    const call_inv = ast.Invocation{
        .path = H.mkPathH(allocator, flow.module, target),
        .args = call_args,
    };

    const conts: []ast.Continuation = if (has_row_cont or has_full_cont) blk: {
        const cloned = allocator.alloc(ast.Continuation, flow.body.continuations.len) catch unreachable;
        for (flow.body.continuations, 0..) |*c, i| {
            cloned[i] = ast_functional.cloneContinuation(allocator, c) catch unreachable;
        }
        break :blk cloned;
    } else &[_]ast.Continuation{};

    return .{ .transformed = .{ .replacement = ast.Item{ .flow = ast.Flow{
        .body = ast.rootSite(call_inv, conts, flow.location),
        .pre_label = null,
        .impl_of = flow.impl_of, // preserved: the site may BE an impl flow's head (e.g. a query body)
        .super_shape = null,
        .inline_body = null,
        .preamble_code = null,
        .is_pure = false,
        .is_transitively_pure = false,
        .location = flow.location,
        .module = allocator.dupe(u8, flow.module) catch unreachable,
    } } } };
}

// ============================================================================
// STORE.QUERY — row-level subscription + imperative sweep (rung two)
// ============================================================================
//
// The coordinator (create) has already transplanted this site's projection,
// guard, and body into the per-line qrow/qbody units and spliced standing
// enters into the insert path. The site itself becomes the SWEEP over the
// rows that exist when its program position executes ((l) lean: the
// imperative sweep IS the stripe).

~[keyword|comptime|transform]pub event query {
    expr: Expression,
    invocation: *const Invocation,
    item: *const Item,
    program: *const Program,
    allocator: std.mem.Allocator
} -> SiteResult

~[transform]proc query|zig {
    const ast = @import("ast");

    if (item.* != .flow) @panic("store:query transform: containing item is not a flow - walker dispatch contract broken");
    const flow = &item.flow;

    const H = struct {
        fn stripQuotes(n: []const u8) []const u8 {
            if (n.len >= 2 and n[0] == '"') return n[1 .. n.len - 1];
            return n;
        }
        fn errItem(alloc: std.mem.Allocator, loc: anytype, module: []const u8, comptime fmt: []const u8, args: anytype) ast.Item {
            const inner = std.fmt.allocPrint(alloc, fmt, args) catch unreachable;
            const msg = std.fmt.allocPrint(alloc, "comptime {{ @compileError(\"{s}\"); }}", .{inner}) catch unreachable;
            return ast.Item{ .inline_code = ast.InlineCode{ .code = msg, .location = loc, .module = module } };
        }
        fn mkPathH(alloc: std.mem.Allocator, module: []const u8, name: []const u8) ast.DottedPath {
            const segs = alloc.alloc([]const u8, 1) catch unreachable;
            segs[0] = alloc.dupe(u8, name) catch unreachable;
            return ast.DottedPath{ .module_qualifier = alloc.dupe(u8, module) catch unreachable, .segments = segs };
        }
    };

    var store_name: []const u8 = "";
    for (invocation.args) |arg| {
        if (std.mem.eql(u8, arg.name, "expr")) store_name = H.stripQuotes(arg.value);
    }
    if (store_name.len == 0) {
        return .{ .transformed = .{ .replacement = H.errItem(allocator, flow.location, flow.module, "std/store:query requires a store name: query(name)", .{}) } };
    }

    // The coordinator names this site's units by its source line.
    const qsweep_name = std.fmt.allocPrint(allocator, "__store_qsweep_{s}_L{d}", .{ store_name, flow.location.line }) catch unreachable;
    var unit_exists = false;
    for (program.items) |pi| {
        if (pi != .event_decl) continue;
        const ed = &pi.event_decl;
        if (ed.path.segments.len == 1 and std.mem.eql(u8, ed.path.segments[0], qsweep_name)) {
            unit_exists = true;
            break;
        }
    }
    if (!unit_exists) {
        var create_exists = false;
        for (program.items) |pi| {
            if (pi != .flow) continue;
            const f = &pi.flow;
            const inv = f.inv();
            if (inv.path.segments.len != 1 or !std.mem.eql(u8, inv.path.segments[0], "new")) continue;
            const mq = inv.path.module_qualifier orelse continue;
            if (!std.mem.eql(u8, mq, "std.store")) continue;
            for (inv.args) |a| {
                if (std.mem.eql(u8, a.name, "expr") and std.mem.eql(u8, H.stripQuotes(a.value), store_name)) create_exists = true;
            }
        }
        if (create_exists) {
            return .{ .transformed = .{ .replacement = H.errItem(allocator, flow.location, flow.module, "std/store:query({s}): the query precedes its store's create in source - declare the store first", .{store_name}) } };
        }
        return .{ .transformed = .{ .replacement = H.errItem(allocator, flow.location, flow.module, "std/store:query({s}): unknown store - no std/store:new({s}) found (or the store is a capacity-1 value - queries need a container, declare `capacity: N` at create)", .{ store_name, store_name }) } };
    }

    const sweep_inv = ast.Invocation{
        .path = H.mkPathH(allocator, flow.module, qsweep_name),
        .args = &[_]ast.Arg{},
    };
    return .{ .transformed = .{ .replacement = ast.Item{ .flow = ast.Flow{
        .body = ast.rootSite(sweep_inv, &[_]ast.Continuation{}, flow.location),
        .pre_label = null,
        .impl_of = flow.impl_of, // preserved: the site may BE an impl flow's head (e.g. a query body)
        .super_shape = null,
        .inline_body = null,
        .preamble_code = null,
        .is_pure = false,
        .is_transitively_pure = false,
        .location = flow.location,
        .module = allocator.dupe(u8, flow.module) catch unreachable,
    } } } };
}

// ============================================================================
// STORE.PREORDER — DFS pre-order forest walk over a [tree] store
// ============================================================================
//
//   std/store:preorder(tree)
//   ! preorder { entity.val } |> …
//
// The tree-store traversal surface (695_STORE_TREE, TT5). The coordinator
// (create) has already transplanted this site's projection/guard/body into
// qrow/qbody units — identical to query — and emitted a DFS pre-order sweep
// over the synthesized `parent` column (roots first, insertion order; each
// node before its children). The site itself becomes that sweep's call.
// Preorder on a non-[tree] store is rejected by the coordinator with a
// teaching diagnostic (no parent column to walk).

~[keyword|comptime|transform]pub event preorder {
    expr: Expression,
    invocation: *const Invocation,
    item: *const Item,
    program: *const Program,
    allocator: std.mem.Allocator
} -> SiteResult

~[transform]proc preorder|zig {
    const ast = @import("ast");

    if (item.* != .flow) @panic("store:preorder transform: containing item is not a flow - walker dispatch contract broken");
    const flow = &item.flow;

    const H = struct {
        fn stripQuotes(n: []const u8) []const u8 {
            if (n.len >= 2 and n[0] == '"') return n[1 .. n.len - 1];
            return n;
        }
        fn errItem(alloc: std.mem.Allocator, loc: anytype, module: []const u8, comptime fmt: []const u8, args: anytype) ast.Item {
            const inner = std.fmt.allocPrint(alloc, fmt, args) catch unreachable;
            const msg = std.fmt.allocPrint(alloc, "comptime {{ @compileError(\"{s}\"); }}", .{inner}) catch unreachable;
            return ast.Item{ .inline_code = ast.InlineCode{ .code = msg, .location = loc, .module = module } };
        }
        fn mkPathH(alloc: std.mem.Allocator, module: []const u8, name: []const u8) ast.DottedPath {
            const segs = alloc.alloc([]const u8, 1) catch unreachable;
            segs[0] = alloc.dupe(u8, name) catch unreachable;
            return ast.DottedPath{ .module_qualifier = alloc.dupe(u8, module) catch unreachable, .segments = segs };
        }
    };

    var store_name: []const u8 = "";
    for (invocation.args) |arg| {
        if (std.mem.eql(u8, arg.name, "expr")) store_name = H.stripQuotes(arg.value);
    }
    if (store_name.len == 0) {
        return .{ .transformed = .{ .replacement = H.errItem(allocator, flow.location, flow.module, "std/store:preorder requires a store name: preorder(name)", .{}) } };
    }

    // The coordinator names this site's units by its source line (the same
    // qsweep scheme as query — only the emitted sweep body differs).
    const qsweep_name = std.fmt.allocPrint(allocator, "__store_qsweep_{s}_L{d}", .{ store_name, flow.location.line }) catch unreachable;
    var unit_exists = false;
    for (program.items) |pi| {
        if (pi != .event_decl) continue;
        const ed = &pi.event_decl;
        if (ed.path.segments.len == 1 and std.mem.eql(u8, ed.path.segments[0], qsweep_name)) {
            unit_exists = true;
            break;
        }
    }
    if (!unit_exists) {
        var create_exists = false;
        for (program.items) |pi| {
            if (pi != .flow) continue;
            const f = &pi.flow;
            const inv = f.inv();
            if (inv.path.segments.len != 1 or !std.mem.eql(u8, inv.path.segments[0], "new")) continue;
            const mq = inv.path.module_qualifier orelse continue;
            if (!std.mem.eql(u8, mq, "std.store")) continue;
            for (inv.args) |a| {
                if (std.mem.eql(u8, a.name, "expr") and std.mem.eql(u8, H.stripQuotes(a.value), store_name)) create_exists = true;
            }
        }
        if (create_exists) {
            return .{ .transformed = .{ .replacement = H.errItem(allocator, flow.location, flow.module, "std/store:preorder({s}): the preorder precedes its store's create in source - declare the store first", .{store_name}) } };
        }
        return .{ .transformed = .{ .replacement = H.errItem(allocator, flow.location, flow.module, "std/store:preorder({s}): unknown store - no std/store:new({s}) found (preorder walks a [tree] container store)", .{ store_name, store_name }) } };
    }

    const sweep_inv = ast.Invocation{
        .path = H.mkPathH(allocator, flow.module, qsweep_name),
        .args = &[_]ast.Arg{},
    };
    return .{ .transformed = .{ .replacement = ast.Item{ .flow = ast.Flow{
        .body = ast.rootSite(sweep_inv, &[_]ast.Continuation{}, flow.location),
        .pre_label = null,
        .impl_of = flow.impl_of, // preserved: the site may BE an impl flow's head
        .super_shape = null,
        .inline_body = null,
        .preamble_code = null,
        .is_pure = false,
        .is_transitively_pure = false,
        .location = flow.location,
        .module = allocator.dupe(u8, flow.module) catch unreachable,
    } } } };
}

// ============================================================================
// STORE.TAKE — extract a row with ownership through the handle head
// ============================================================================
//
//   std/store:take(game[r]) | item i |> …
//
// Swap-remove (legal: position is never identity — O2/O10.iii). Compiles to
// `__store_take_<s>(row: <handle>)`; the `| item {fields}` branch carries
// the row out. Obligation wiring (a taken row must be consumed or given
// back — 690_007/690_015) rides on the take event's phantom.

~[keyword|comptime|transform]pub event take {
    expr: Expression,
    invocation: *const Invocation,
    item: *const Item,
    program: *const Program,
    allocator: std.mem.Allocator
} -> SiteResult

~[transform]proc take|zig {
    const ast = @import("ast");
    const ast_functional = @import("ast_functional");

    if (item.* != .flow) @panic("store:take transform: containing item is not a flow - walker dispatch contract broken");
    const flow = &item.flow;

    const H = struct {
        fn stripQuotes(n: []const u8) []const u8 {
            if (n.len >= 2 and n[0] == '"') return n[1 .. n.len - 1];
            return n;
        }
        fn errItem(alloc: std.mem.Allocator, loc: anytype, module: []const u8, comptime fmt: []const u8, args: anytype) ast.Item {
            const inner = std.fmt.allocPrint(alloc, fmt, args) catch unreachable;
            const msg = std.fmt.allocPrint(alloc, "comptime {{ @compileError(\"{s}\"); }}", .{inner}) catch unreachable;
            return ast.Item{ .inline_code = ast.InlineCode{ .code = msg, .location = loc, .module = module } };
        }
        fn mkPathH(alloc: std.mem.Allocator, module: []const u8, name: []const u8) ast.DottedPath {
            const segs = alloc.alloc([]const u8, 1) catch unreachable;
            segs[0] = alloc.dupe(u8, name) catch unreachable;
            return ast.DottedPath{ .module_qualifier = alloc.dupe(u8, module) catch unreachable, .segments = segs };
        }
    };

    var target_text: []const u8 = "";
    for (invocation.args) |arg| {
        if (std.mem.eql(u8, arg.name, "expr")) target_text = H.stripQuotes(arg.value);
    }
    const lb = std.mem.indexOfScalar(u8, target_text, '[') orelse {
        return .{ .transformed = .{ .replacement = H.errItem(allocator, flow.location, flow.module, "std/store:take addresses a row: take(store[handle]) - '{s}' has no addressing head", .{target_text}) } };
    };
    if (target_text.len == 0 or target_text[target_text.len - 1] != ']') {
        return .{ .transformed = .{ .replacement = H.errItem(allocator, flow.location, flow.module, "std/store:take: malformed addressing head '{s}'", .{target_text}) } };
    }
    const store_name = std.mem.trim(u8, target_text[0..lb], " ");
    const row_expr = std.mem.trim(u8, target_text[lb + 1 .. target_text.len - 1], " ");
    if (store_name.len == 0 or row_expr.len == 0) {
        return .{ .transformed = .{ .replacement = H.errItem(allocator, flow.location, flow.module, "std/store:take: malformed addressing head '{s}' - take(store[handle])", .{target_text}) } };
    }

    const take_name = std.fmt.allocPrint(allocator, "__store_take_{s}", .{store_name}) catch unreachable;
    var unit_exists = false;
    for (program.items) |pi| {
        if (pi != .event_decl) continue;
        const ed = &pi.event_decl;
        if (ed.path.segments.len == 1 and std.mem.eql(u8, ed.path.segments[0], take_name)) {
            unit_exists = true;
            break;
        }
    }
    if (!unit_exists) {
        return .{ .transformed = .{ .replacement = H.errItem(allocator, flow.location, flow.module, "std/store:take({s}[...]): unknown or not-yet-created container store '{s}'", .{ store_name, store_name }) } };
    }

    const call_args = allocator.alloc(ast.Arg, 1) catch unreachable;
    call_args[0] = ast.Arg{
        .name = allocator.dupe(u8, "row") catch unreachable,
        .value = allocator.dupe(u8, row_expr) catch unreachable,
    };
    const call_inv = ast.Invocation{
        .path = H.mkPathH(allocator, flow.module, take_name),
        .args = call_args,
    };

    // The take site is usually NESTED (under insert's `| row r`); its own
    // continuations (`| item i |> …`) ride along on the replacement.
    const FindSite = struct {
        fn call(cont: *const ast.Continuation, target: *const ast.Invocation) ?*const ast.Continuation {
            if (cont.node) |*n| {
                if (n.* == .invocation and &n.invocation == target) return cont;
            }
            for (cont.continuations) |*c| {
                if (call(c, target)) |found| return found;
            }
            return null;
        }
    }.call;
    const site = FindSite(&flow.body, invocation);

    const conts: []ast.Continuation = blk: {
        if (site) |sc| {
            const cloned = allocator.alloc(ast.Continuation, sc.continuations.len) catch unreachable;
            for (sc.continuations, 0..) |*c, i| {
                cloned[i] = ast_functional.cloneContinuation(allocator, c) catch unreachable;
            }
            break :blk cloned;
        }
        break :blk &[_]ast.Continuation{};
    };

    return .{ .transformed = .{ .replacement = ast.Item{ .flow = ast.Flow{
        .body = ast.rootSite(call_inv, conts, flow.location),
        .pre_label = null,
        .impl_of = flow.impl_of, // preserved: the site may BE an impl flow's head (e.g. a query body)
        .super_shape = null,
        .inline_body = null,
        .preamble_code = null,
        .is_pure = false,
        .is_transitively_pure = false,
        .location = flow.location,
        .module = allocator.dupe(u8, flow.module) catch unreachable,
    } } } };
}

// ============================================================================
// STORE.STRIPE — the imperative sweep verb ((l)/O13, 690_014)
// ============================================================================
//
//   ~std/store:stripe(game)
//
// Announce-only: standing watches re-fire with CURRENT values. No write
// happens, so interceptors (the write contract) do NOT run. Compiles to
// the generated `__store_stripe_<s>` unit.

~[keyword|comptime|transform]pub event stripe {
    expr: Expression,
    invocation: *const Invocation,
    item: *const Item,
    program: *const Program,
    allocator: std.mem.Allocator
} -> SiteResult

~[transform]proc stripe|zig {
    const ast = @import("ast");

    if (item.* != .flow) @panic("store:stripe transform: containing item is not a flow - walker dispatch contract broken");
    const flow = &item.flow;

    const H = struct {
        fn stripQuotes(n: []const u8) []const u8 {
            if (n.len >= 2 and n[0] == '"') return n[1 .. n.len - 1];
            return n;
        }
        fn errItem(alloc: std.mem.Allocator, loc: anytype, module: []const u8, comptime fmt: []const u8, args: anytype) ast.Item {
            const inner = std.fmt.allocPrint(alloc, fmt, args) catch unreachable;
            const msg = std.fmt.allocPrint(alloc, "comptime {{ @compileError(\"{s}\"); }}", .{inner}) catch unreachable;
            return ast.Item{ .inline_code = ast.InlineCode{ .code = msg, .location = loc, .module = module } };
        }
        fn mkPathH(alloc: std.mem.Allocator, module: []const u8, name: []const u8) ast.DottedPath {
            const segs = alloc.alloc([]const u8, 1) catch unreachable;
            segs[0] = alloc.dupe(u8, name) catch unreachable;
            return ast.DottedPath{ .module_qualifier = alloc.dupe(u8, module) catch unreachable, .segments = segs };
        }
    };

    var store_name: []const u8 = "";
    for (invocation.args) |arg| {
        if (std.mem.eql(u8, arg.name, "expr")) store_name = H.stripQuotes(arg.value);
    }
    if (store_name.len == 0) {
        return .{ .transformed = .{ .replacement = H.errItem(allocator, flow.location, flow.module, "std/store:stripe requires a store name: stripe(name)", .{}) } };
    }

    const stripe_name = std.fmt.allocPrint(allocator, "__store_stripe_{s}", .{store_name}) catch unreachable;
    var unit_exists = false;
    for (program.items) |pi| {
        if (pi != .event_decl) continue;
        const ed = &pi.event_decl;
        if (ed.path.segments.len == 1 and std.mem.eql(u8, ed.path.segments[0], stripe_name)) {
            unit_exists = true;
            break;
        }
    }
    if (!unit_exists) {
        return .{ .transformed = .{ .replacement = H.errItem(allocator, flow.location, flow.module, "std/store:stripe({s}): unknown store, or a store shape without a stripe unit this rung (plural / {{old,new}}-mode stripe is a later slice)", .{store_name}) } };
    }

    const stripe_inv = ast.Invocation{
        .path = H.mkPathH(allocator, flow.module, stripe_name),
        .args = &[_]ast.Arg{},
    };
    return .{ .transformed = .{ .replacement = ast.Item{ .flow = ast.Flow{
        .body = ast.rootSite(stripe_inv, &[_]ast.Continuation{}, flow.location),
        .pre_label = null,
        .impl_of = flow.impl_of,
        .super_shape = null,
        .inline_body = null,
        .preamble_code = null,
        .is_pure = false,
        .is_transitively_pure = false,
        .location = flow.location,
        .module = allocator.dupe(u8, flow.module) catch unreachable,
    } } } };
}
