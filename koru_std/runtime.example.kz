// Koru Standard Library: the `example` part of runtime.kz.
// Joined via `~part example` in runtime.kz; merged into the runtime
// module at load.
// ============================================================================
// PARSE.WIRE.EXAMPLE - the chain rule's worked example, derived per scope
// ============================================================================
//
// The shape rules in the wire grammar text are fixed prose — they describe
// the grammar itself, which is one law for every scope. The chain rule's
// worked EXAMPLE is different: it names verbs, and verbs belong to a scope.
// A fixed cast teaches notes on every register (kopium hole 9: on calc,
// `open` and `append` are event-denied and nothing mints a handle). So the
// cast is synthesized from the scope's own manifest — the same record the
// dispatcher and the vocabulary render are minted from — and a scope with
// nothing provably chainable gets the rule with no fabricated example.
// The selection (`scopeChainPick`) and the arg spelling (`wireCallArgs` /
// `wireChainArgs`) live in the `wiregrammar` part, shared with the
// grammar's own threading example.

// The chain rule's worked example, synthesized from the scope's own
// manifest — the only cast that cannot drift from what the wall enforces.
// Returns null when nothing is provably chainable — the caller renders the
// rule with no fabricated example.
fn scopeChainExample(allocator: std.mem.Allocator, m: *const ScopeManifest) ?[]const u8 {
    const p = scopeChainPick(m) orelse return null;

    var lit: usize = 0;
    var ex = std.ArrayList(u8).initCapacity(allocator, 96) catch return null;
    ex.appendSlice(allocator, p.head.name) catch return null;
    ex.append(allocator, '(') catch return null;
    ex.appendSlice(allocator, wireCallArgs(allocator, p.head, &lit)) catch return null;
    ex.appendSlice(allocator, ") | ") catch return null;
    ex.appendSlice(allocator, p.arm) catch return null;
    ex.appendSlice(allocator, " v |> ") catch return null;
    ex.appendSlice(allocator, p.target.name) catch return null;
    ex.append(allocator, '(') catch return null;
    const targs = wireChainArgs(allocator, p.target, p.bound_arg, "v", &lit);
    // A discharge record naming an arg the verb no longer takes would emit
    // a chain that doesn't bind — refuse the example rather than lie.
    if (!targs.wrote_bound) return null;
    ex.appendSlice(allocator, targs.text) catch return null;
    ex.append(allocator, ')') catch return null;
    return ex.toOwnedSlice(allocator) catch return null;
}
