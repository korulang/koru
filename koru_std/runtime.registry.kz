// Koru Standard Library: the `registry` part of runtime.kz.
// Joined via `~part registry` in runtime.kz; merged into the runtime module at load.
//
// REGISTRY COMMON - shared comptime machinery: register's emission, the
// scope-manifest builder, and the [explainer] all derive from these.
// Includes the scope-def marker protocol: a register site leaves a
// __KORU_SCOPE_DEF__ host_line so `scope(other)` entries at later sites
// resolve order-free (the site's own transform consumes its flow).
    const registry_helpers_marker = "__KORU_RUNTIME_REGISTRY_HELPERS__";

    // A register site's transform REPLACES its flow with the generated
    // dispatcher, erasing the scope definition from the AST — so a
    // `scope(other)` written at a LATER site would resolve nothing.
    // Each site therefore leaves this marker host_line behind carrying its
    // scope name and base64 source block; collectScopeDefs unions live defs
    // with these markers so composition is order-free.
    const scope_def_marker = "// __KORU_SCOPE_DEF__";

    const Helpers = struct {
        fn stripQuotes(value: []const u8) []const u8 {
            if (value.len >= 2 and value[0] == '"' and value[value.len - 1] == '"') {
                return value[1 .. value.len - 1];
            }
            return value;
        }

        fn findScopeAnnotation(annotations: []const []const u8) ?[]const u8 {
            for (annotations) |raw| {
                var ann = std.mem.trim(u8, raw, " \t\r\n");
                if (ann.len == 0) continue;
                if (ann[0] == '@' and ann.len > 1) ann = ann[1..];

                const open = std.mem.indexOf(u8, ann, "(") orelse continue;
                if (ann[ann.len - 1] != ')') continue;
                const name = std.mem.trim(u8, ann[0..open], " \t");
                if (!std.mem.eql(u8, name, "registry:scope")) continue;

                const arg = std.mem.trim(u8, ann[open + 1 .. ann.len - 1], " \t");
                if (arg.len == 0) continue;
                return stripQuotes(arg);
            }
            return null;
        }

        fn extractScopeName(inv: *const ast_reg.Invocation, flow_annotations: []const []const u8) []const u8 {
            for (inv.args) |arg| {
                if (std.mem.eql(u8, arg.name, "scope")) {
                    return stripQuotes(arg.value);
                }
            }
            if (findScopeAnnotation(inv.annotations)) |name| return name;
            if (findScopeAnnotation(flow_annotations)) |name| return name;
            return "default";
        }

        fn hasRegistryHelpers(prog: *const ast_reg.Program, module_name: []const u8) bool {
            return findInItems(prog.items, module_name);
        }

        // The module the register SITE lives in — a merged companion copies
        // the flow to top level AND the module_decl, each transformed on its
        // own; the dedupe key must be the site's items list or one copy's
        // marker suppresses the other's helpers.
        fn siteHomeModule(prog: *const ast_reg.Program, site: *const ast_reg.Item) []const u8 {
            for (prog.items) |*it| if (it == site) return "main";
            for (prog.items) |*it| if (it.* == .module_decl) for (it.module_decl.items) |*mi| if (mi == site) return it.module_decl.logical_name;
            return "main";
        }

        fn findInItems(items: []const ast_reg.Item, module_name: []const u8) bool {
            for (items) |*ast_item| {
                switch (ast_item.*) {
                    .host_line => |hl| {
                        if (std.mem.eql(u8, hl.module, module_name) and
                            std.mem.indexOf(u8, hl.content, registry_helpers_marker) != null) {
                            return true;
                        }
                    },
                    .module_decl => |mod| {
                        if (findInItems(mod.items, module_name)) return true;
                    },
                    else => {},
                }
            }
            return false;
        }

        fn matchGlob(prefix: []const u8, event_name: []const u8) bool {
            if (std.mem.startsWith(u8, event_name, prefix)) {
                const rest = event_name[prefix.len..];
                if (rest.len > 0 and (rest[0] == ':' or rest[0] == '.')) {
                    return true;
                }
            }
            return false;
        }

        fn mangleIdentifier(alloc: std.mem.Allocator, name: []const u8) []const u8 {
            var out = std.ArrayList(u8){ .items = &.{}, .capacity = 0 };
            for (name) |c| {
                const is_alnum = (c >= 'a' and c <= 'z') or
                    (c >= 'A' and c <= 'Z') or
                    (c >= '0' and c <= '9') or
                    (c == '_');
                out.append(alloc, if (is_alnum) c else '_') catch continue;
            }
            return out.toOwnedSlice(alloc) catch name;
        }

        fn buildEventName(alloc: std.mem.Allocator, segments: []const []const u8) []const u8 {
            if (segments.len == 0) return "";
            var total_len: usize = 0;
            for (segments) |seg| total_len += seg.len;
            total_len += if (segments.len > 1) segments.len - 1 else 0;
            var buf = alloc.alloc(u8, total_len) catch return "";
            var pos: usize = 0;
            for (segments, 0..) |seg, i| {
                if (i > 0) {
                    buf[pos] = '.';
                    pos += 1;
                }
                @memcpy(buf[pos..][0..seg.len], seg);
                pos += seg.len;
            }
            return buf;
        }

        fn buildEventStructName(alloc: std.mem.Allocator, segments: []const []const u8) []const u8 {
            var out = std.ArrayList(u8){ .items = &.{}, .capacity = 0 };
            for (segments, 0..) |seg, idx| {
                if (idx > 0) out.append(alloc, '_') catch continue;
                for (seg) |c| {
                    if (c == '*') {
                        out.appendSlice(alloc, "_star_") catch continue;
                    } else if (c == '.' or c == '-') {
                        // `.` and kebab `-` both lower to `_` in the Zig symbol.
                        out.append(alloc, '_') catch continue;
                    } else {
                        out.append(alloc, c) catch continue;
                    }
                }
            }
            return out.toOwnedSlice(alloc) catch "";
        }

        fn buildModulePath(alloc: std.mem.Allocator, module_path: []const u8, main_module_name: []const u8) []const u8 {
            // SHADOW of codegen_utils.buildKoruModulePath — kept in sync manually
            // because this lives in stdlib Koru source (not src/) and can't import
            // codegen_utils directly. Centralization candidate; see TODO.
            if (std.mem.eql(u8, module_path, main_module_name) or std.mem.eql(u8, module_path, "main")) {
                return alloc.dupe(u8, "main_module") catch "main_module";
            }

            var out = std.ArrayList(u8){ .items = &.{}, .capacity = 0 };
            var splitter = if (std.mem.indexOfScalar(u8, module_path, '/')) |_| std.mem.splitScalar(u8, module_path, '/')
                else std.mem.splitScalar(u8, module_path, '.');
            var first = true;
            while (splitter.next()) |segment| {
                if (!first) out.append(alloc, '.') catch continue;
                out.appendSlice(alloc, "koru_") catch continue;
                out.appendSlice(alloc, segment) catch continue;
                first = false;
            }
            return out.toOwnedSlice(alloc) catch module_path;
        }

        fn buildEventSymbol(alloc: std.mem.Allocator, module_path: ?[]const u8, segments: []const []const u8, main_module_name: []const u8) []const u8 {
            const event_struct = buildEventStructName(alloc, segments);
            if (module_path) |mp| {
                const module_prefix = buildModulePath(alloc, mp, main_module_name);
                return std.fmt.allocPrint(alloc, "{s}.{s}_event", .{ module_prefix, event_struct }) catch event_struct;
            }
            return std.fmt.allocPrint(alloc, "main_module.{s}_event", .{ event_struct }) catch event_struct;
        }
    };

    const LocalCreateSpec = struct {
        obligation_module: []const u8,
        obligation_name: []const u8,
        field_name: []const u8,
        resource_type: []const u8, branch: ?[]const u8 = null, // branch carrying this create; null = bare return
        tainted: bool = false, // bare `<type>` phantom: mint a tracked handle that owes no discharge
    };

    const LocalDischargeSpec = struct {
        obligation_module: []const u8,
        obligation_name: []const u8,
        arg_name: []const u8,
    };

    // LocalBranchField/LocalBranchSpec and extractBranches moved to the
    // `branchex` part — the outcome types beside their extraction.

    // Local input-field specs for codegen (mirrors runtime InputFieldSpec).
    // The input shape is the ARGUMENT vocabulary of an tor — what the
    // caller must name when invoking it (`handle: string<!open>`), as opposed
    // to `branches`, which describe output shapes.
    const LocalInputField = struct {
        name: []const u8,
        type_name: []const u8,
        is_optional: bool,
        phantom: ?[]const u8,  // raw phantom: "!open" discharges, "open!" creates
    };

    const EventEntry = struct {
        name: []const u8,
        cost: u64,
        creates_obligations: []const []const u8,    // Legacy: just names
        discharges_obligations: []const []const u8, // Legacy: just names
        creates_specs: []const LocalCreateSpec,     // Full specs
        discharges_specs: []const LocalDischargeSpec,
        branches: []const LocalBranchSpec,          // Branch specs for shape validation
        input_fields: []const LocalInputField,      // Input/argument vocabulary
        doc: []const u8,                            // Declaration prose — vertical annotation block text
        symbol: []const u8,
        dispatch_name: []const u8,
        module_name: ?[]const u8,                   // Module this tor belongs to
    };

    const ScopeDef = struct {
        name: []const u8,
        source_text: []const u8,
        annotations: []const []const u8,
        /// The module the `register` block was WRITTEN in, as its
        /// import-derived logical name (`app.lib`), or null at program top
        /// level. A scope entry names a tor the way the author writes it in the
        /// interpreted source — bare `expensive` — while the tor registers
        /// under `app.lib:expensive`, so the lookup needs the home to close the
        /// gap. Without it the entry resolved to nothing, the registry came up
        /// with zero tors, and the program COMPILED and took its
        /// `| scope-not-found` arm at run time (115_036).
        home_module: ?[]const u8,
    };

    const EventInfo = struct {
        name: []const u8,
        module_name: ?[]const u8,
        event_decl: *const ast_reg.EventDecl,
    };

    const EntryKind = enum { event, glob, scope_ref };

    const Entry = struct {
        kind: EntryKind,
        name: []const u8,
        internal_name: ?[]const u8,
        cost: u64,
    };

    const ResolvedEvent = struct {
        name: []const u8,
        internal_name: ?[]const u8,
        cost: u64,
        /// The home of the scope that named this tor — see `ScopeDef`.
        home: ?[]const u8,
    };

    // RegistryHelper moved to the `registry-collect` part — scope-def and
    // event-info collection, scope-entry parsing and resolution, proc
    // retain/impl detection.

    // Helper: Parse phantom string to extract obligation name and optional module qualifier
    // Input: "opened!", "!opened", "sqlite3:opened!", "!fs:opened", "opened"
    // Returns (module, name, is_creates, is_discharges). A BARE phantom
    // (`<type>`, neither mark) still returns its module/name with both flags
    // false — the caller reads that shape as a borrow taint: a tracked,
    // typed handle that owes no discharge.
    const parsePhantom = struct {
        fn parse(alloc: std.mem.Allocator, phantom_str: []const u8) struct {
            module: ?[]const u8,  // Module qualifier if present (e.g., "sqlite3")
            name: ?[]const u8,    // Obligation name (e.g., "opened")
            creates: bool,
            discharges: bool,
        } {
            if (phantom_str.len == 0) return .{ .module = null, .name = null, .creates = false, .discharges = false };

            var str = phantom_str;
            var discharges = false;
            var creates = false;

            // Check for ! prefix (discharges obligation)
            if (str[0] == '!') {
                discharges = true;
                str = str[1..];
            }

            // Check for ! suffix (creates obligation)
            if (str.len > 0 and str[str.len - 1] == '!') {
                creates = true;
                str = str[0 .. str.len - 1];
            }

            if (str.len == 0) return .{ .module = null, .name = null, .creates = creates, .discharges = discharges };

            // Check for module qualifier (e.g., "sqlite3:opened")
            var module: ?[]const u8 = null;
            var name = str;
            if (std.mem.indexOf(u8, str, ":")) |colon_idx| {
                module = alloc.dupe(u8, str[0..colon_idx]) catch null;
                name = str[colon_idx + 1 ..];
            }

            return .{
                .module = module,
                .name = alloc.dupe(u8, name) catch null,
                .creates = creates,
                .discharges = discharges,
            };
        }
    }.parse;

    // Helper: the bare resource type a handle is minted for — pointer syntax,
    // bracket phantom and module qualifier stripped. Shared by both places a
    // create-phantom can ride: a branch payload field and a bare return.
    const bareResourceType = struct {
        fn strip(declared: []const u8) []const u8 {
            var res_type = declared;
            if (std.mem.startsWith(u8, res_type, "*")) {
                res_type = res_type[1..];
            }
            if (std.mem.indexOf(u8, res_type, "[")) |idx| {
                res_type = std.mem.trim(u8, res_type[0..idx], " ");
            }
            if (std.mem.lastIndexOf(u8, res_type, ":")) |colon_idx| {
                res_type = res_type[colon_idx + 1 ..];
            }
            return res_type;
        }
    }.strip;

    // A bare phantom mints a taint only when it names a TYPE: `*`, empty,
    // state variables (`'x`) and unions (`a|b`) are spellings the custody
    // ledger cannot hold — they stay spec-free exactly as before.
    const taintableName = struct {
        fn check(name: ?[]const u8) ?[]const u8 {
            const n = name orelse return null;
            if (n.len == 0) return null;
            if (std.mem.eql(u8, n, "*")) return null;
            if (std.mem.indexOfScalar(u8, n, '\'') != null) return null;
            if (std.mem.indexOfScalar(u8, n, '|') != null) return null;
            return n;
        }
    }.check;

    // Helper: Extract obligations from EventDecl with full field/arg info
    const extractObligations = struct {
        fn extract(alloc: std.mem.Allocator, ed: *const ast_reg.EventDecl, module_name: ?[]const u8) struct {
            creates: []const []const u8,
            discharges: []const []const u8,
            creates_specs: []const LocalCreateSpec,
            discharges_specs: []const LocalDischargeSpec,
        } {
            var creates = std.ArrayList([]const u8){ .items = &.{}, .capacity = 0 };
            var discharges = std.ArrayList([]const u8){ .items = &.{}, .capacity = 0 };
            var creates_specs = std.ArrayList(LocalCreateSpec){ .items = &.{}, .capacity = 0 };
            var discharges_specs = std.ArrayList(LocalDischargeSpec){ .items = &.{}, .capacity = 0 };

            const default_module = module_name orelse "main";

            // Check input fields for <!state> (discharges)
            for (ed.input.fields) |field| {
                if (field.phantom) |phantom_str| {
                    const result = parsePhantom(alloc, phantom_str);
                    if (result.discharges) {
                        if (result.name) |name| {
                            // Prefer phantom qualifier, fall back to tor module
                            const obl_module = result.module orelse alloc.dupe(u8, default_module) catch default_module;
                            discharges.append(alloc, name) catch continue;
                            discharges_specs.append(alloc, .{
                                .obligation_module = obl_module,
                                .obligation_name = name,
                                .arg_name = alloc.dupe(u8, field.name) catch field.name,
                            }) catch continue;
                        }
                    }
                }
            }

            // Check branch output fields for <state!> (creates obligation)
            // and <state> (taint: mints a tracked handle that owes no
            // discharge — borrows and affordance gating read it, the sweep
            // releases it silently).
            for (ed.branches) |branch| {
                for (branch.payload.fields) |field| {
                    if (field.phantom) |phantom_str| {
                        const result = parsePhantom(alloc, phantom_str);
                        if (result.creates) {
                            if (result.name) |name| {
                                // Prefer phantom qualifier, fall back to tor module
                                const obl_module = result.module orelse alloc.dupe(u8, default_module) catch default_module;
                                creates.append(alloc, name) catch continue;
                                const res_type = bareResourceType(field.type);
                                creates_specs.append(alloc, .{
                                    .obligation_module = obl_module,
                                    .obligation_name = name,
                                    .field_name = alloc.dupe(u8, field.name) catch field.name,
                                    .resource_type = alloc.dupe(u8, res_type) catch res_type, .branch = alloc.dupe(u8, branch.name) catch branch.name,
                                }) catch continue;
                            }
                        } else if (!result.discharges) {
                            if (taintableName(result.name)) |name| {
                                const obl_module = result.module orelse alloc.dupe(u8, default_module) catch default_module;
                                const res_type = bareResourceType(field.type);
                                creates_specs.append(alloc, .{
                                    .obligation_module = obl_module,
                                    .obligation_name = name,
                                    .field_name = alloc.dupe(u8, field.name) catch field.name,
                                    .resource_type = alloc.dupe(u8, res_type) catch res_type, .branch = alloc.dupe(u8, branch.name) catch branch.name,
                                    .tainted = true,
                                }) catch continue;
                            }
                        }
                    }
                }
            }

            // A bare return carries its phantom on the DECLARATION, not on a
            // branch payload field: `-> *R<active!>` has no branches at all, and
            // the parser forces a lone handle into exactly that shape (PARSE003
            // rejects `| opened { h: T<opened!> }`). Reading only `ed.branches`
            // meant the canonical way to spell "this call mints a resource" was
            // invisible to the registry, so no handle was ever minted for it.
            //
            // The dispatcher reports a bare return on `__type_ref` — the same
            // channel an identity branch uses — so the spec is identical to the
            // branch case; only where the phantom is READ from differs.
            if (ed.return_phantom) |phantom_str| {
                const result = parsePhantom(alloc, phantom_str);
                if (result.creates) {
                    if (result.name) |name| {
                        const obl_module = result.module orelse alloc.dupe(u8, default_module) catch default_module;
                        creates.append(alloc, name) catch {};
                        const res_type = bareResourceType(ed.return_type orelse "unknown");
                        creates_specs.append(alloc, .{
                            .obligation_module = obl_module,
                            .obligation_name = name,
                            .field_name = alloc.dupe(u8, "__type_ref") catch "__type_ref",
                            .resource_type = alloc.dupe(u8, res_type) catch res_type,
                        }) catch {};
                    }
                } else if (!result.discharges) {
                    // `-> T<state>` bare: same mint channel as `T<state!>`,
                    // minus the discharge obligation — a borrow taint.
                    if (taintableName(result.name)) |name| {
                        const obl_module = result.module orelse alloc.dupe(u8, default_module) catch default_module;
                        const res_type = bareResourceType(ed.return_type orelse "unknown");
                        creates_specs.append(alloc, .{
                            .obligation_module = obl_module,
                            .obligation_name = name,
                            .field_name = alloc.dupe(u8, "__type_ref") catch "__type_ref",
                            .resource_type = alloc.dupe(u8, res_type) catch res_type,
                            .tainted = true,
                        }) catch {};
                    }
                }
            }

            return .{
                .creates = creates.toOwnedSlice(alloc) catch &.{},
                .discharges = discharges.toOwnedSlice(alloc) catch &.{},
                .creates_specs = creates_specs.toOwnedSlice(alloc) catch &.{},
                .discharges_specs = discharges_specs.toOwnedSlice(alloc) catch &.{},
            };
        }
    }.extract;

    // Helper: Extract the tor's INPUT fields — its argument vocabulary. This
    // is what makes "ask a scope what it holds" answerable for a caller that
    // must name the arguments (`open(path: ...)`), and where the possession
    // phantoms (`<!open>`) live. Branches above are the OUTPUT side.
    const extractInputFields = struct {
        fn extract(alloc: std.mem.Allocator, ed: *const ast_reg.EventDecl) []const LocalInputField {
            var field_specs = std.ArrayList(LocalInputField){ .items = &.{}, .capacity = 0 };

            for (ed.input.fields) |field| {
                const is_optional = field.type.len > 0 and field.type[0] == '?';
                const type_name = if (is_optional) field.type[1..] else field.type;
                field_specs.append(alloc, .{
                    .name = alloc.dupe(u8, field.name) catch field.name,
                    .type_name = alloc.dupe(u8, type_name) catch type_name,
                    .is_optional = is_optional,
                    .phantom = if (field.phantom) |p| alloc.dupe(u8, p) catch p else null,
                }) catch continue;
            }

            return field_specs.toOwnedSlice(alloc) catch &.{};
        }
    }.extract;
