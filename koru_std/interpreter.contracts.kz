// Koru Standard Library: the `contracts` part of interpreter — the
// dispatcher and obligation-spec type surface. Joined via `~part contracts`
// in interpreter.kz; merged into the interpreter module at load.
//
// Everything here is declaration-level types: the host-dispatch contract
// (HostView / HostDispatchFn / the dispatch-detail channel), the fn-ptr
// vocabulary the runtime generates dispatchers against, and the
// obligation CreateSpec/DischargeSpec specs.

// DISPATCHER TYPE - Function signature for scope dispatchers
// ============================================================================

pub const Invocation = ast.Invocation;
pub const DispatchFn = *const fn(*const ast.Invocation, *DispatchResult) anyerror!void;
// HostView — the slice of interpreter state a host verb may see.
// Deliberately NOT *InterpreterContext: a fn-ptr naming its storing
// struct is a dependency loop. The env fields are the binding layers a
// state render labels: session (durable), turn (multi-item arms), run
// (this item's own); handle_pool/trace are the held-handle and path reads.
pub const HostView = struct {
    scope_name: []const u8,
    defined: ?*DefinedFlows,
    allocator: std.mem.Allocator,
    error_detail: *?[]const u8,
    session_env: ?*Environment = null,
    mounted: ?[]const @import("root").koru_std.koru_runtime.ScopeRuntime = null,
    turn_env: ?*Environment = null, run_env: ?*Environment = null,
    handle_pool: ?*HandlePool = null, trace: ?*const std.ArrayListUnmanaged(TraceEntry) = null,
};
// Dispatch-detail/dispatch-pool channels moved to the `resdispatch` part —
// the threadlocals a generated dispatcher reports and resolves through.

// Host-provided verbs, consulted only when the scope's dispatcher returns
// EventDenied: session-level capabilities (vocabulary, grammar) not part of
// the registered scope but still dispatched like any call — parsed, armed,
// refused. Returns error.EventDenied when the host does not claim the name.
pub const HostDispatchFn = *const fn(
    name: []const u8,
    inv: *const ast.Invocation,
    view: *const HostView,
    out: *DispatchResult,
) anyerror!void;
pub const CostFn = *const fn([]const u8) u64;
// Obligation functions - tors can create/discharge multiple obligations
pub const ObligationsArrayFn = *const fn([]const u8) []const []const u8;  // tor -> []obligations
pub const DischargeEventFn = *const fn([]const u8) ?[]const u8;  // obligation -> tor name

// CreateSpec describes an obligation created by an tor's output field
pub const CreateSpec = struct {
    obligation_module: []const u8,  // e.g., "sqlite3"
    obligation_name: []const u8,    // e.g., "opened"
    field_name: []const u8,         // which output field holds the handle ID
    resource_type: []const u8,      // e.g., "Connection"
    // Outcome branch carrying this create, in source spelling — null = bare
    // return. A branched tor books only the spec whose branch FIRED.
    branch: ?[]const u8 = null,
};

// DischargeSpec describes an obligation discharged by an tor's input arg
pub const DischargeSpec = struct {
    obligation_module: []const u8,  // e.g., "sqlite3"
    obligation_name: []const u8,    // e.g., "opened"
    arg_name: []const u8,           // which input arg carries the handle ID
};

// Spec lookup functions - return full specs with field/arg names
pub const CreatesSpecFn = *const fn([]const u8) []const CreateSpec;    // tor -> []CreateSpec
pub const DischargesSpecFn = *const fn([]const u8) []const DischargeSpec;  // tor -> []DischargeSpec

// Input-field lookup - an tor's declared argument vocabulary. Null means
// the name is not this scope's verb at all (vocabulary membership answers
// first); an empty list means the verb takes no fields, so ANY named field
// is foreign.
pub const InputFieldSpec = @import("root").koru_std.koru_runtime.InputFieldSpec;
pub const InputLookupFn = *const fn([]const u8) ?[]const InputFieldSpec;

// Outcome lookup — an tor's declared branch vocabulary; what an arm word
// must spell. Empty means the single anonymous outcome, spelled `ok` on
// the wire. The scope's table answers empty for a non-member name too,
// so arm-word checks ride under the input_fn membership answer.
pub const BranchSpec = @import("root").koru_std.koru_runtime.BranchSpec;
pub const BranchesLookupFn = @import("root").koru_std.koru_runtime.BranchesLookupFn;
