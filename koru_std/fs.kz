// Koru Standard Library: Filesystem
// File operations with phantom types for resource safety

~[comptime|runtime]

const std = @import("std");

// ============================================================================
// HIGH-LEVEL API (convenience, no handle management)
// ============================================================================

// Read a file as a stream of lines — the EFFECT SHAPE (FRONTIERS gap 5,
// charter-ratified): `! line l` fires per line DURING the read (handlers
// complete before the buffer is freed — borrow-safe by construction),
// `| done n` delivers the line count after, `| failed e` the error.
// The old array shape (`| lines [][]const u8`) was a structural leaker:
// it returned allocator-owned slices no Koru caller could free.
~pub event read-lines { path: []const u8 }
! line []const u8
| done usize
| failed []const u8

~proc read-lines|zig {
    const __koru_rl_file = std.fs.cwd().openFile(path, .{}) catch |err| {
        const __koru_rl_msg = switch (err) {
            error.FileNotFound => "File not found",
            error.AccessDenied => "Access denied",
            error.IsDir => "Path is a directory",
            else => "Failed to open file",
        };
        return .{ .failed = __koru_rl_msg };
    };
    defer __koru_rl_file.close();

    // No artificial cap: read the whole file, bounded only by real memory.
    // An over-RAM file fails LOUDLY as OutOfMemory rather than silently at an
    // arbitrary limit. (`read-lines` should ultimately stream line-by-line for
    // constant memory on >RAM inputs; that's a separate capability, not this
    // bug — the bug was the silent 10MB cap.)
    const __koru_rl_content = __koru_rl_file.readToEndAlloc(koru_allocator(), std.math.maxInt(usize)) catch |err| {
        const __koru_rl_msg = switch (err) {
            error.OutOfMemory => "Out of memory reading file",
            else => "Failed to read file",
        };
        return .{ .failed = __koru_rl_msg };
    };
    defer koru_allocator().free(__koru_rl_content);

    // HYGIENE: this body INLINES into the consumer's frame (effect
    // lowering), so locals are __koru-prefixed to never collide with
    // user bindings in the surrounding flow.
    var __koru_rl_n: usize = 0;
    var __koru_rl_it = std.mem.splitScalar(u8, __koru_rl_content, '\n');
    while (__koru_rl_it.next()) |__koru_rl_raw| {
        // A trailing newline yields one final empty slice - not a line.
        if (__koru_rl_raw.len == 0 and __koru_rl_it.peek() == null) break;
        const __koru_rl_l = if (__koru_rl_raw.len > 0 and __koru_rl_raw[__koru_rl_raw.len - 1] == '\r') __koru_rl_raw[0 .. __koru_rl_raw.len - 1] else __koru_rl_raw;
        line(__koru_rl_l);
        __koru_rl_n += 1;
    }
    return .{ .done = __koru_rl_n };
}

// ============================================================================
// LOW-LEVEL API (phantom types, full control) - FUTURE
// ============================================================================

