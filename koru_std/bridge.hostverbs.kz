// Koru Standard Library: the `hostverbs` part of bridge — the session-
// level verbs the interpreter dispatches when the scope's own dispatcher
// denies: `vocabulary`, `grammar`, and `bind`, plus the tor surfaces
// that render the same text to host callers. Joined via `~part hostverbs`
// in bridge.kz; merged into the bridge module at load.

// ============================================================================
// VOCABULARY - the derived prompt, session-shaped
// ============================================================================
//
// `std/runtime:scope-vocabulary` renders a scope's COMPILED tors — the
// base vocabulary the program was built with. This tor grows that with the
// session's DEFINED flows, so the prompt walks the whole environment a REPL
// accumulates: compiled scopes plus the verbs the agent invented on earlier
// turns. That visibility is the second half of the R1 claim — an invention
// the agent never sees in its own prompt is an invention it will not use.
//
// The same arena discipline as scope-vocabulary: the returned string is
// page-backed and intentionally never freed, because it must outlive this
// call and land in the caller's prompt buffer.

~pub tor vocabulary { br: *Bridge<session> }
| ok string
| not-found string

~proc vocabulary|zig {
    var arena_state = std.heap.ArenaAllocator.init(std.heap.page_allocator);
    const allocator = arena_state.allocator();
    const text = renderVocabulary(allocator, br.scope, br.defined, br.introspection, br.session_env, br.mounted_scopes.items)
        orelse return .{ .not_found = br.scope };
    return .{ .ok = text };
}

// `renderVocabulary` and `renderGrammar` — the surfaces both the tors and
// the wire verbs draw — moved to the `render` part, beside
// `appendBoundLines`/`appendDefinedLines`. Mounted scopes render through
// the same line emitters the compiled scope uses.

// ============================================================================
// GRAMMAR - the derived prompt, complete: the wire's rules + the session's
// whole vocabulary
// ============================================================================
//
// `std/runtime:scope-grammar` renders the wire's shape rules above the
// scope's COMPILED verbs. The prompt an agent actually lives under needs one
// more thing: the session's DEFINED flows, the verbs it invented on earlier
// turns. This render is that whole surface — rules, compiled base, and
// inventions, one string — so the agent's prompt is the register block plus
// its own growth, and nothing hand-typed. A turn judged by the wire gate
// (parse.wire, in `run` above) and a prompt built from this render are the
// same declaration read twice.

~pub tor grammar { br: *Bridge<session> }
| ok string
| not-found string

~proc grammar|zig {
    var arena_state = std.heap.ArenaAllocator.init(std.heap.page_allocator);
    const allocator = arena_state.allocator();
    const text = renderGrammar(allocator, br.scope, br.defined, br.introspection, br.mounted_scopes.items)
        orelse return .{ .not_found = br.scope };
    return .{ .ok = text };
}

// renderGrammar lives in the `render` part — the verb's render beside
// the vocabulary it composes.

// ============================================================================
// HOST VERBS - introspection as ordinary wire calls
// ============================================================================
//
// `vocabulary()` and `grammar()` on the wire are not register-block verbs and
// not a protocol side channel: they are host-provided verbs, granted per
// session by `create(introspection: true)` and consulted by the interpreter
// only when the scope's dispatcher denies — so a scope verb or a `define`d
// verb of the same name always outranks them, and an ungranted session hears
// event-denied exactly as for a forged word. Their answer is the live
// session: the compiled scope, the granted host verbs themselves, and every
// verb the session has invented.

const Interp = @import("root").koru_std.koru_interpreter;

pub fn hostDispatch(
    name: []const u8,
    inv: *const Interp.Invocation,
    view: *const Interp.HostView,
    out: *Interp.DispatchResult,
) anyerror!void {
    if (hostInputLookup(name) == null) return error.EventDenied;
    if (std.mem.eql(u8, name, "bind")) return hostBind(view, inv, out);
    if (std.mem.eql(u8, name, "note")) return hostNote(view, inv, out);
    if (std.mem.eql(u8, name, "abandon")) return hostAbandon(view, inv, out);
    if (inv.args.len != 0) {
        view.error_detail.* = std.fmt.allocPrint(view.allocator,
            "'{s}' takes no fields — call it bare: {s}()", .{ name, name })
            catch "'vocabulary'/'grammar'/'state' take no fields";
        return error.DispatchFailed;
    }
    if (std.mem.eql(u8, name, "state")) return hostState(view, out);
    const text = (if (std.mem.eql(u8, name, "vocabulary"))
        renderVocabulary(view.allocator, view.scope_name, view.defined, true, view.session_env, view.mounted)
    else
        renderGrammar(view.allocator, view.scope_name, view.defined, true, view.mounted)) orelse {
            view.error_detail.* = "host verb on a scope the registry does not know";
            return error.DispatchFailed;
        };
    const S = struct { threadlocal var field_buf: [1]Interp.NamedField = undefined; };
    S.field_buf[0] = .{ .name = "__type_ref", .value = .{ .string_val = text } };
    out.* = .{ .branch = "", .fields = S.field_buf[0..1] };
}
