// Koru Standard Library: JSON — the scratch-buffer emit arms' decls.
// Joined via `~part emitln` in json.kz; merged into the json module at
// load. EmitDrive (the shared site driver, all three writer modes) lives
// in json.emitdrive.kz — this file pins only the two non-allocating call
// surfaces.
//
// emit.ln is the write-side twin of fmt:ln's discipline: the site emits
// into a per-callsite threadlocal scratch (default 4096 bytes,
// `[size(Nk)]` / `[size(Nm)]` on the call resizes THIS site) and binds
// `string<scratch@scoped>` — the borrow dies with the frame, so it can
// feed a synchronous sink (a send buffer, a file write) but can never be
// stored or returned. No heap allocation, no emit.free — scratch needs
// no discharge. Overflow panics naming the site's size, same as fmt:ln.
// CAVEAT (shared with fmt:ln): scratch@scoped promises frame-safety but
// same-callsite REENTRANCY (recursion, a callback between emit and
// consume) overwrites the buffer while the outer value is still alive —
// silent corruption the phantom cannot see. Intended use only: emit →
// consume with nothing reentrant between.
//
// emit.into is the zero-copy arm: `buf:` names a writable []u8 slice
// (spliced verbatim into the generated writer — a connection's send
// region, a stack array) and the site returns `usize`, bytes written.
// snprintf contract: no slice return, because the phantom system cannot
// honestly express "borrows caller's buf". Args resolve BY NAME, so
// `value:` and `buf:` may arrive in either order. Overflow panics naming
// emit.into; the buffer length is runtime, so the message says "exceeds
// the provided buffer". No reserve pass — same as emit.ln.
//
//   std/json:emit.ln [size(8k)] (value: { posts: ps }): out
//   |> orisha:respond(req, status: 200, body: out, ...): r
//
//   std/json:emit.into(buf: tgt.buf[tgt.head_pad..], value: { posts: ps }): n
//   |> orisha:respond-filled(req, status: 200, tgt, n, ...): r

~[comptime|transform]pub tor emit.ln { value: string, reporter: *std/compiler:ErrorReporter } -> string<scratch@scoped>

~[transform]proc emit.ln|zig {
    return .{ .transformed = EmitDrive.drive(allocator, reporter, item, invocation, program, .ln) };
}

~[comptime|transform]pub tor emit.into { buf: string, value: string, reporter: *std/compiler:ErrorReporter } -> usize

~[transform]proc emit.into|zig {
    return .{ .transformed = EmitDrive.drive(allocator, reporter, item, invocation, program, .into) };
}
