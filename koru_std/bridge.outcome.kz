// Koru Standard Library: the `outcome` part of bridge — the single-item
// dispatch boundary's outcome mapping (Runtime run_event -> brute's two-tier
// shape) plus the guide lines that ride its text slots. Split out of `error`
// when the guide injection made it grow past its pin; joined via
// `~part outcome` in bridge.kz.

// The single-item dispatch boundary: copy the interpreter's fine-grained
// outcome into run's two-tier shape — findings pass through verbatim, and
// every failure class packs into RunError with `kind` naming the variant.
//
// Guide lines ride the outcome's own text slot: the item's report
// (`result.trace`, a dispatch-error's `trace`, an unhandled branch's
// `guides`). The lines were rendered by the same lookup that stamped the
// call_step records, so the model view and the log cannot disagree. An
// outcome that dispatched nothing has an empty guide buffer by
// construction — this function never invents teaching where no call ran.
fn withGuides(alloc: std.mem.Allocator, base: []const u8, guides: []const u8) []const u8 {
    if (guides.len == 0) return base;
    return std.fmt.allocPrint(alloc, "{s}{s}", .{ base, guides }) catch base;
}

fn runOutcome(br: *Bridge, r: Runtime.run_event.Output, comptime Out: type) Out {
    const guides = br.guide_text.items;
    return switch (r) {
        .result => |v| blk: {
            var ok = v;
            ok.trace = withGuides(br.allocator, v.trace, guides);
            break :blk .{ .result = .{
                .value = ok.value, .used = ok.used, .handles = ok.handles,
                // The terminal dispatch bound itself via the trace; a turn
                // that dispatched nothing (pure flow) still needs a name.
                .bound = if (ok.bound.len > 0) ok.bound else bindResult(br, ok.value),
                .trace = ok.trace,
            } };
        },
        .unhandled_branch => |u| .{ .unhandled_branch = .{
            .branch = u.branch, .payload = u.payload, .handles = u.handles, .bound = u.bound,
            .guides = br.allocator.dupe(u8, guides) catch "",
        } },
        .exhausted => |e| blk: {
            var err = mkErr("exhausted", "the turn exhausted its cost budget");
            err.used = e.used; err.last_event = e.last_event; err.handles = e.handles;
            break :blk .{ .@"error" = err };
        },
        .parse_error => |e| blk: {
            var err = mkErr("parse-error", e.message);
            err.line = e.line; err.column = e.column;
            break :blk .{ .@"error" = err };
        },
        .validation_error => |e| .{ .@"error" = mkErr("validation-error", e) },
        .shape_error => |e| blk: {
            var err = mkErr("shape-error", e.message);
            err.branch = e.branch; err.field = e.field orelse "";
            break :blk .{ .@"error" = err };
        },
        .event_denied => |e| .{ .@"error" = mkErr("event-denied", e) },
        .dispatch_error => |e| blk: {
            var err = mkErr("dispatch-error", e.message);
            err.event_name = e.event_name;
            err.trace = withGuides(br.allocator, e.trace, guides);
            break :blk .{ .@"error" = err };
        },
        .scope_not_found => |e| .{ .@"error" = mkErr("scope-not-found", e) },
    };
}

