            code.appendSlice(allocator, I ++ "                if (__koru_ptr_info.size == .slice and __koru_ptr_info.child == u8) {\n") catch unreachable;
            code.appendSlice(allocator, I ++ "                    __koru_S.buf[0] = .{ .name = \"__type_ref\", .value = __koru_FieldValue{ .string_val = __koru_own(u8, __koru_p) } };\n") catch unreachable;
            code.appendSlice(allocator, I ++ "                } else if (__koru_ptr_info.size == .slice and __koru_ptr_info.child == []const u8) {\n                    __koru_S.buf[0] = .{ .name = \"__type_ref\", .value = __koru_FieldValue{ .string_array = __koru_own([]const u8, __koru_p) } };\n") catch unreachable;
            code.appendSlice(allocator, I ++ "                } else {\n") catch unreachable;
            code.appendSlice(allocator, I ++ "                    __koru_S.buf[0] = .{ .name = \"__type_ref\", .value = __koru_FieldValue{ .string_val = koru_std.koru_interpreter.registerDispatchResource(@typeName(__koru_ptr_info.child), __koru_p) } };\n") catch unreachable;
            code.appendSlice(allocator, I ++ "                }\n") catch unreachable;
            code.appendSlice(allocator, I ++ "            } else {\n") catch unreachable;
            code.appendSlice(allocator, I ++ "                break :blk @as(usize, 0);\n") catch unreachable;
            code.appendSlice(allocator, I ++ "            }\n") catch unreachable;
            code.appendSlice(allocator, I ++ "            break :blk @as(usize, 1);\n") catch unreachable;
            code.appendSlice(allocator, I ++ "        }\n") catch unreachable;
            code.appendSlice(allocator, I ++ "        // Compound __koru_branch - iterate over struct fields\n") catch unreachable;
            code.appendSlice(allocator, I ++ "        const __koru_payload_fields = __koru_dispatcher_std.meta.fields(__koru_P);\n") catch unreachable;
            code.appendSlice(allocator, I ++ "        comptime var __koru_count: usize = 0;\n") catch unreachable;
            code.appendSlice(allocator, I ++ "        inline for (__koru_payload_fields) |__koru_field| {\n") catch unreachable;
            code.appendSlice(allocator, I ++ "            const __koru_T = __koru_field.type;\n") catch unreachable;
            code.appendSlice(allocator, I ++ "            if (__koru_T == bool) {\n") catch unreachable;
            code.appendSlice(allocator, I ++ "                __koru_S.buf[__koru_count] = .{ .name = __koru_field.name, .value = __koru_FieldValue{ .bool_val = @field(__koru_p, __koru_field.name) } };\n") catch unreachable;
            code.appendSlice(allocator, I ++ "                __koru_count += 1;\n") catch unreachable;
            code.appendSlice(allocator, I ++ "            } else switch (@typeInfo(__koru_T)) {\n") catch unreachable;
            code.appendSlice(allocator, I ++ "                .int => {\n") catch unreachable;
            code.appendSlice(allocator, I ++ "                    __koru_S.buf[__koru_count] = .{ .name = __koru_field.name, .value = __koru_FieldValue{ .int_val = @as(i64, @intCast(@field(__koru_p, __koru_field.name))) } };\n") catch unreachable;
            code.appendSlice(allocator, I ++ "                    __koru_count += 1;\n") catch unreachable;
            code.appendSlice(allocator, I ++ "                },\n") catch unreachable;
            code.appendSlice(allocator, I ++ "                .float => {\n") catch unreachable;
            code.appendSlice(allocator, I ++ "                    __koru_S.buf[__koru_count] = .{ .name = __koru_field.name, .value = __koru_FieldValue{ .float_val = @as(f64, @floatCast(@field(__koru_p, __koru_field.name))) } };\n") catch unreachable;
            code.appendSlice(allocator, I ++ "                    __koru_count += 1;\n") catch unreachable;
            code.appendSlice(allocator, I ++ "                },\n") catch unreachable;
            code.appendSlice(allocator, I ++ "                .pointer => |__koru_ptr_info| {\n") catch unreachable;
            code.appendSlice(allocator, I ++ "                    if (__koru_ptr_info.size == .slice and __koru_ptr_info.child == u8) {\n") catch unreachable;
            code.appendSlice(allocator, I ++ "                        __koru_S.buf[__koru_count] = .{ .name = __koru_field.name, .value = __koru_FieldValue{ .string_val = __koru_own(u8, @field(__koru_p, __koru_field.name)) } };\n") catch unreachable;
            code.appendSlice(allocator, I ++ "                        __koru_count += 1;\n") catch unreachable;
            code.appendSlice(allocator, I ++ "                    } else if (__koru_ptr_info.size == .slice and __koru_ptr_info.child == []const u8) {\n                        __koru_S.buf[__koru_count] = .{ .name = __koru_field.name, .value = __koru_FieldValue{ .string_array = __koru_own([]const u8, @field(__koru_p, __koru_field.name)) } };\n                        __koru_count += 1;\n") catch unreachable;
            code.appendSlice(allocator, I ++ "                    } else if (__koru_ptr_info.size == .one) {\n") catch unreachable;
            code.appendSlice(allocator, I ++ "                        __koru_S.buf[__koru_count] = .{ .name = __koru_field.name, .value = __koru_FieldValue{ .string_val = koru_std.koru_interpreter.registerDispatchResource(@typeName(__koru_ptr_info.child), @field(__koru_p, __koru_field.name)) } };\n") catch unreachable;
            code.appendSlice(allocator, I ++ "                        __koru_count += 1;\n") catch unreachable;
            code.appendSlice(allocator, I ++ "                    }\n") catch unreachable;
            code.appendSlice(allocator, I ++ "                },\n") catch unreachable;
            code.appendSlice(allocator, I ++ "                else => {},\n") catch unreachable;
            code.appendSlice(allocator, I ++ "            }\n") catch unreachable;
            code.appendSlice(allocator, I ++ "        }\n") catch unreachable;
            code.appendSlice(allocator, I ++ "        break :blk __koru_count;\n") catch unreachable;
            code.appendSlice(allocator, I ++ "    }};\n") catch unreachable;
            code.appendSlice(allocator, I ++ "    __koru_out.* = .{ .branch = __koru_branch, .fields = __koru_S.buf[0..__koru_field_count] };\n") catch unreachable;
            code.appendSlice(allocator, I ++ "    return;\n") catch unreachable;
