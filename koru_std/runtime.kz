    code.appendSlice(allocator, I ++ "                if (__koru_dispatcher_std.mem.eql(u8, __koru_obligation, __koru_cre)) { __koru_reissues = true; break; }\n") catch unreachable;
    code.appendSlice(allocator, I ++ "            }\n") catch unreachable;
