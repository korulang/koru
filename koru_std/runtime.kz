    code.appendSlice(allocator, ") |__koru_ev| {\n") catch unreachable;
    code.appendSlice(allocator, I ++ "        if (__koru_dispatcher_std.mem.eql(u8, __koru_event_name, __koru_ev.name)) return __koru_ev.branches;\n") catch unreachable;
