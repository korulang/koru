    code.appendSlice(allocator, I ++ "    return &[_]koru_std.koru_runtime.BranchSpec{};\n") catch unreachable;
    code.appendSlice(allocator, I ++ "}\n\n") catch unreachable;

    // Generate event-name enumeration - returns the scope's whole vocabulary.
