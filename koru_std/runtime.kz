    // provide by itself.
    code.appendSlice(allocator, I ++ "const ") catch unreachable;
    code.appendSlice(allocator, scope_ident) catch unreachable;
    code.appendSlice(allocator, "_event_names = blk: {\n") catch unreachable;
    code.appendSlice(allocator, I ++ "    @setEvalBranchQuota(1_000_000);\n") catch unreachable;
    code.appendSlice(allocator, I ++ "    var __koru_arr: [scope_events_") catch unreachable;
    code.appendSlice(allocator, scope_ident) catch unreachable;
    code.appendSlice(allocator, ".len][]const u8 = undefined;\n") catch unreachable;
    code.appendSlice(allocator, I ++ "    for (scope_events_") catch unreachable;
    code.appendSlice(allocator, scope_ident) catch unreachable;
    code.appendSlice(allocator, ", 0..) |__koru_ev, __koru_i| __koru_arr[__koru_i] = __koru_ev.name;\n") catch unreachable;
    code.appendSlice(allocator, I ++ "    break :blk __koru_arr;\n") catch unreachable;
    code.appendSlice(allocator, I ++ "};\n") catch unreachable;
    code.appendSlice(allocator, I ++ "pub fn get_events_") catch unreachable;
    code.appendSlice(allocator, scope_ident) catch unreachable;
    code.appendSlice(allocator, "() []const []const u8 {\n") catch unreachable;
    code.appendSlice(allocator, I ++ "    return &") catch unreachable;
    code.appendSlice(allocator, scope_ident) catch unreachable;
    code.appendSlice(allocator, "_event_names;\n") catch unreachable;
    code.appendSlice(allocator, I ++ "}\n\n") catch unreachable;

    // Generate doc lookup — the tor's declaration prose (vertical
    // annotation block text), empty when the decl carried none.
    code.appendSlice(allocator, I ++ "pub fn get_event_doc_") catch unreachable;
    code.appendSlice(allocator, scope_ident) catch unreachable;
    code.appendSlice(allocator, "(__koru_event_name: []const u8) []const u8 {\n") catch unreachable;
    code.appendSlice(allocator, I ++ "    inline for (scope_events_") catch unreachable;
    code.appendSlice(allocator, scope_ident) catch unreachable;
    code.appendSlice(allocator, ") |__koru_ev| {\n") catch unreachable;
    code.appendSlice(allocator, I ++ "        if (__koru_dispatcher_std.mem.eql(u8, __koru_event_name, __koru_ev.name)) return __koru_ev.doc;\n") catch unreachable;
    code.appendSlice(allocator, I ++ "    }\n") catch unreachable;
    code.appendSlice(allocator, I ++ "    return \"\";\n") catch unreachable;
    code.appendSlice(allocator, I ++ "}\n\n") catch unreachable;

    // Generate input-field lookup - an tor's argument vocabulary (null = not this scope's verb).
    code.appendSlice(allocator, I ++ "pub fn get_event_input_") catch unreachable;
    code.appendSlice(allocator, scope_ident) catch unreachable;
    code.appendSlice(allocator, "(__koru_event_name: []const u8) ?[]const koru_std.koru_runtime.InputFieldSpec {\n") catch unreachable;
    code.appendSlice(allocator, I ++ "    inline for (scope_events_") catch unreachable;
    code.appendSlice(allocator, scope_ident) catch unreachable;
    code.appendSlice(allocator, ") |__koru_ev| {\n") catch unreachable;
    code.appendSlice(allocator, I ++ "        if (__koru_dispatcher_std.mem.eql(u8, __koru_event_name, __koru_ev.name)) return __koru_ev.input_fields;\n") catch unreachable;
    code.appendSlice(allocator, I ++ "    }\n") catch unreachable;
    code.appendSlice(allocator, I ++ "    return null;\n") catch unreachable;
    code.appendSlice(allocator, I ++ "}\n\n") catch unreachable;

    code.appendSlice(allocator, I ++ "pub const ") catch unreachable;
    code.appendSlice(allocator, scope_ident) catch unreachable;
    code.appendSlice(allocator, "_descriptor: __koru_ScopeDescriptor = .{ .name = \"") catch unreachable;
    code.appendSlice(allocator, scope_name) catch unreachable;
    code.appendSlice(allocator, "\", .events = &scope_events_") catch unreachable;
    code.appendSlice(allocator, scope_ident) catch unreachable;
    code.appendSlice(allocator, " };\n") catch unreachable;

    // The scope manifest: the register block minted as DATA, beside the
    // descriptor. Built by the SAME shared producer the explainer and the
    // served JSON use (scopeManifestForScope) — one record, three views, and
    // the contract can never drift from enforcement.
    const scope_manifest = scopeManifestForScope(allocator, program, scope_name, debug_enabled);

    code.appendSlice(allocator, I ++ "pub const ") catch unreachable;
    code.appendSlice(allocator, scope_ident) catch unreachable;
    code.appendSlice(allocator, "_manifest: __koru_ScopeManifest = .{ .scope = \"") catch unreachable;
    code.appendSlice(allocator, scope_name) catch unreachable;
    code.appendSlice(allocator, "\", .events = &[_]__koru_ManifestEvent{\n") catch unreachable;
    for (scope_manifest.events) |event| {
        code.appendSlice(allocator, I ++ "    .{ .name = \"") catch unreachable;
        code.appendSlice(allocator, event.name) catch unreachable;
        code.appendSlice(allocator, "\", .cost = ") catch unreachable;
        var manifest_cost_buf: [32]u8 = undefined;
        const manifest_cost_str = std.fmt.bufPrint(&manifest_cost_buf, "{d}", .{event.cost}) catch "1";
        code.appendSlice(allocator, manifest_cost_str) catch unreachable;
        code.appendSlice(allocator, ", .home = ") catch unreachable;
        if (event.home) |event_home| {
            code.appendSlice(allocator, "\"") catch unreachable;
            code.appendSlice(allocator, event_home) catch unreachable;
            code.appendSlice(allocator, "\"") catch unreachable;
        } else {
            code.appendSlice(allocator, "null") catch unreachable;
        }

        // Argument vocabulary — the caller's side of the surface.
        code.appendSlice(allocator, ", .args = &[_]__koru_ManifestArg{") catch unreachable;
        for (event.args, 0..) |arg_field, ai| {
            if (ai > 0) code.appendSlice(allocator, ", ") catch unreachable;
            code.appendSlice(allocator, ".{ .name = \"") catch unreachable;
            code.appendSlice(allocator, arg_field.name) catch unreachable;
            code.appendSlice(allocator, "\", .type_name = \"") catch unreachable;
            code.appendSlice(allocator, arg_field.type_name) catch unreachable;
            code.appendSlice(allocator, "\", .is_optional = ") catch unreachable;
            code.appendSlice(allocator, if (arg_field.is_optional) "true" else "false") catch unreachable;
            code.appendSlice(allocator, ", .phantom = ") catch unreachable;
            if (arg_field.phantom) |phantom_str| {
                code.appendSlice(allocator, "\"") catch unreachable;
                code.appendSlice(allocator, phantom_str) catch unreachable;
                code.appendSlice(allocator, "\"") catch unreachable;
            } else {
                code.appendSlice(allocator, "null") catch unreachable;
            }
            code.appendSlice(allocator, " }") catch unreachable;
        }
        code.appendSlice(allocator, "}") catch unreachable;

        // Possession: what the tor mints.
        code.appendSlice(allocator, ", .creates = &[_]__koru_ManifestCreate{") catch unreachable;
        for (event.creates, 0..) |create_spec, ci| {
            if (ci > 0) code.appendSlice(allocator, ", ") catch unreachable;
            code.appendSlice(allocator, ".{ .obligation = \"") catch unreachable;
            code.appendSlice(allocator, create_spec.obligation) catch unreachable;
            code.appendSlice(allocator, "\", .module = \"") catch unreachable;
            code.appendSlice(allocator, create_spec.module) catch unreachable;
            code.appendSlice(allocator, "\", .field = \"") catch unreachable;
            code.appendSlice(allocator, create_spec.field) catch unreachable;
            code.appendSlice(allocator, "\", .resource_type = \"") catch unreachable;
            code.appendSlice(allocator, create_spec.resource_type) catch unreachable;
            code.appendSlice(allocator, "\"") catch unreachable;
            if (create_spec.branch) |br| {
                code.appendSlice(allocator, ", .branch = \"") catch unreachable;
                code.appendSlice(allocator, br) catch unreachable;
                code.appendSlice(allocator, "\"") catch unreachable;
            }
            if (create_spec.tainted) code.appendSlice(allocator, ", .tainted = true") catch unreachable;
            code.appendSlice(allocator, " }") catch unreachable;
        }
        code.appendSlice(allocator, "}") catch unreachable;

        // Possession: what the tor consumes.
        code.appendSlice(allocator, ", .discharges = &[_]__koru_ManifestDischarge{") catch unreachable;
        for (event.discharges, 0..) |discharge_spec, di| {
            if (di > 0) code.appendSlice(allocator, ", ") catch unreachable;
            code.appendSlice(allocator, ".{ .obligation = \"") catch unreachable;
            code.appendSlice(allocator, discharge_spec.obligation) catch unreachable;
            code.appendSlice(allocator, "\", .module = \"") catch unreachable;
            code.appendSlice(allocator, discharge_spec.module) catch unreachable;
            code.appendSlice(allocator, "\", .arg = \"") catch unreachable;
            code.appendSlice(allocator, discharge_spec.arg) catch unreachable;
            code.appendSlice(allocator, "\" }") catch unreachable;
        }
        code.appendSlice(allocator, "}") catch unreachable;

        // Output shapes.
        code.appendSlice(allocator, ", .branches = &[_]__koru_ManifestBranch{") catch unreachable;
        for (event.branches, 0..) |branch_spec, bi| {
            if (bi > 0) code.appendSlice(allocator, ", ") catch unreachable;
            code.appendSlice(allocator, ".{ .name = \"") catch unreachable;
            code.appendSlice(allocator, branch_spec.name) catch unreachable;
            code.appendSlice(allocator, "\", .fields = &[_]__koru_ManifestBranchField{") catch unreachable;
            for (branch_spec.fields, 0..) |branch_field, fi| {
                if (fi > 0) code.appendSlice(allocator, ", ") catch unreachable;
                code.appendSlice(allocator, ".{ .name = \"") catch unreachable;
                code.appendSlice(allocator, branch_field.name) catch unreachable;
                code.appendSlice(allocator, "\", .type_name = \"") catch unreachable;
                code.appendSlice(allocator, branch_field.type_name) catch unreachable;
                code.appendSlice(allocator, "\", .is_optional = ") catch unreachable;
                code.appendSlice(allocator, if (branch_field.is_optional) "true" else "false") catch unreachable;
                code.appendSlice(allocator, " }") catch unreachable;
            }
            code.appendSlice(allocator, "}, .is_optional = ") catch unreachable;
            code.appendSlice(allocator, if (branch_spec.is_optional) "true" else "false") catch unreachable;
            code.appendSlice(allocator, " }") catch unreachable;
        }
        code.appendSlice(allocator, "}") catch unreachable;
        if (event.doc.len > 0) {
            code.appendSlice(allocator, ", .doc = \"") catch unreachable;
            for (event.doc) |ch| {
                switch (ch) {
                    '"' => code.appendSlice(allocator, "\\\"") catch unreachable,
                    '\\' => code.appendSlice(allocator, "\\\\") catch unreachable,
                    '\n' => code.appendSlice(allocator, "\\n") catch unreachable,
                    else => code.append(allocator, ch) catch unreachable,
                }
            }
            code.appendSlice(allocator, "\"") catch unreachable;
        }
        code.appendSlice(allocator, " },\n") catch unreachable;
    }
    code.appendSlice(allocator, I ++ "},\n") catch unreachable;
    code.appendSlice(allocator, I ++ "    .includes = &[_][]const u8{") catch unreachable;
    for (scope_manifest.includes, 0..) |inc, ii| {
        if (ii > 0) code.appendSlice(allocator, ", ") catch unreachable;
        code.appendSlice(allocator, "\"") catch unreachable;
        code.appendSlice(allocator, inc) catch unreachable;
        code.appendSlice(allocator, "\"") catch unreachable;
    }
    code.appendSlice(allocator, "},\n") catch unreachable;
    if (scope_manifest.doc.len > 0) {
        code.appendSlice(allocator, I ++ "    .doc = \"") catch unreachable;
        for (scope_manifest.doc) |ch| {
            switch (ch) {
                '"' => code.appendSlice(allocator, "\\\"") catch unreachable,
                '\\' => code.appendSlice(allocator, "\\\\") catch unreachable,
                '\n' => code.appendSlice(allocator, "\\n") catch unreachable,
                else => code.append(allocator, ch) catch unreachable,
            }
        }
        code.appendSlice(allocator, "\",\n") catch unreachable;
    }
    code.appendSlice(allocator, I ++ "};\n\n") catch unreachable;

    code.appendSlice(allocator, I ++ "pub fn dispatch_") catch unreachable;
    code.appendSlice(allocator, scope_ident) catch unreachable;
    code.appendSlice(allocator, "(__koru_inv: *const __koru_dispatcher_ast.Invocation, __koru_out: *koru_std.koru_runtime.DispatchResult) !void {\n") catch unreachable;
    code.appendSlice(allocator, I ++ "    var __koru_name_buf: [256]u8 = undefined;\n") catch unreachable;
    code.appendSlice(allocator, I ++ "    var __koru_name_len: usize = 0;\n") catch unreachable;
    code.appendSlice(allocator, I ++ "    if (__koru_inv.path.module_qualifier) |__koru_mq| {\n") catch unreachable;
    code.appendSlice(allocator, I ++ "        @memcpy(__koru_name_buf[__koru_name_len..][0..__koru_mq.len], __koru_mq);\n") catch unreachable;
    code.appendSlice(allocator, I ++ "        __koru_name_len += __koru_mq.len;\n") catch unreachable;
    code.appendSlice(allocator, I ++ "        __koru_name_buf[__koru_name_len] = ':';\n") catch unreachable;
    code.appendSlice(allocator, I ++ "        __koru_name_len += 1;\n") catch unreachable;
    code.appendSlice(allocator, I ++ "    }\n") catch unreachable;
    code.appendSlice(allocator, I ++ "    for (__koru_inv.path.segments, 0..) |__koru_seg, __koru_i| {\n") catch unreachable;
    code.appendSlice(allocator, I ++ "        if (__koru_i > 0) { __koru_name_buf[__koru_name_len] = '.'; __koru_name_len += 1; }\n") catch unreachable;
    code.appendSlice(allocator, I ++ "        @memcpy(__koru_name_buf[__koru_name_len..][0..__koru_seg.len], __koru_seg);\n") catch unreachable;
    code.appendSlice(allocator, I ++ "        __koru_name_len += __koru_seg.len;\n") catch unreachable;
    code.appendSlice(allocator, I ++ "    }\n") catch unreachable;
    code.appendSlice(allocator, I ++ "    const __koru_event_name = __koru_name_buf[0..__koru_name_len];\n") catch unreachable;
    code.appendSlice(allocator, I ++ "    inline for (scope_events_") catch unreachable;
    code.appendSlice(allocator, scope_ident) catch unreachable;
    code.appendSlice(allocator, ") |__koru_ev| {\n") catch unreachable;
    code.appendSlice(allocator, I ++ "        if (__koru_dispatcher_std.mem.eql(u8, __koru_event_name, __koru_ev.name)) {\n") catch unreachable;
    code.appendSlice(allocator, I ++ "            return __koru_ev.dispatcher(__koru_inv, __koru_out);\n") catch unreachable;
    code.appendSlice(allocator, I ++ "        }\n") catch unreachable;
    code.appendSlice(allocator, I ++ "    }\n") catch unreachable;
    code.appendSlice(allocator, I ++ "    return error.EventDenied;\n") catch unreachable;
    code.appendSlice(allocator, I ++ "}\n") catch unreachable;

    const generated_code = code.toOwnedSlice(allocator) catch unreachable;
    std.debug.print("[REGISTRY] Generated {d} bytes\n", .{generated_code.len});

    // Replace this flow with generated code
    const new_item = ast_reg.Item{
        .host_line = .{
            .content = generated_code,
            .location = .{ .file = "runtime:register", .line = 0, .column = 0 },
            .module = module_name,
        },
    };

    // The replacement erases this scope's definition from the AST. Leave a
    // marker carrying name + base64 source so a `scope(other)` entry at a
    // LATER site still resolves — collectScopeDefs reads these back.
    var self_source: []const u8 = "";
    for (invocation.args) |arg| {
        if (arg.source_value) |src| {
            self_source = src.text;
            break;
        }
    }
    const enc = std.base64.standard.Encoder;
    const b64 = allocator.alloc(u8, enc.calcSize(self_source.len)) catch return .{ .replacement = new_item };
    _ = enc.encode(b64, self_source);
    const marker_content = std.fmt.allocPrint(allocator, "{s}:{s}:{s}", .{ scope_def_marker, scope_name, b64 }) catch return .{ .replacement = new_item };
    const appended = allocator.alloc(ast_reg.Item, 1) catch return .{ .replacement = new_item };
    appended[0] = .{ .host_line = .{
        .content = marker_content,
        .location = .{ .file = "runtime:register", .line = 0, .column = 0 },
        .module = module_name,
    } };
    return .{ .replacement = new_item, .appended = appended };
}

// ============================================================================
// GET SCOPE - Runtime tor to look up a scope's dispatcher

// Use interpreter's types to ensure compatibility
// At runtime, koru_std.koru_interpreter is available via root import
pub const DispatchResult = @import("root").koru_std.koru_interpreter.DispatchResult;
pub const DispatchFn = @import("root").koru_std.koru_interpreter.DispatchFn;
pub const CostFn = @import("root").koru_std.koru_interpreter.CostFn;
pub const ObligationsArrayFn = @import("root").koru_std.koru_interpreter.ObligationsArrayFn;
pub const DischargeEventFn = @import("root").koru_std.koru_interpreter.DischargeEventFn;
pub const FieldValue = @import("root").koru_std.koru_interpreter.FieldValue;
pub const NamedField = @import("root").koru_std.koru_interpreter.NamedField;
// Import spec types from interpreter
pub const CreateSpec = @import("root").koru_std.koru_interpreter.CreateSpec;
pub const DischargeSpec = @import("root").koru_std.koru_interpreter.DischargeSpec;
pub const CreatesSpecFn = @import("root").koru_std.koru_interpreter.CreatesSpecFn;
pub const DischargesSpecFn = @import("root").koru_std.koru_interpreter.DischargesSpecFn;

pub const ScopeRuntime = struct {
    name: []const u8,
    dispatcher: DispatchFn,
    cost_fn: ?CostFn,
    creates_obligations_fn: ?ObligationsArrayFn,
    discharges_obligations_fn: ?ObligationsArrayFn,
    discharge_event_fn: ?DischargeEventFn,
    // Full spec lookups with field/arg names
    creates_spec_fn: ?CreatesSpecFn,
    discharges_spec_fn: ?DischargesSpecFn,
    // Branch specs for shape validation
    branches_fn: ?BranchesLookupFn,
    // Vocabulary enumeration: tor names + per-event input/arg fields
    events_fn: ?EventsLookupFn,
    input_fn: ?InputLookupFn,
    // Declaration prose per verb — what the tor IS, beside its signature
    doc_fn: ?DocLookupFn,
    // The scope's manifest record — minted at scope creation (register) from
    // the same EventEntry data the dispatch tables are emitted from. null
    // never occurs for a descriptor register built: the two are emitted side
    // by side. Defined flows (session growth) are absent by construction.
    manifest: ?*const ScopeManifest = null,
};

// The scope-manifest record types moved to the `manifest-record` part —
// the served contract's shape, beside the `manifest` serializer.

fn mangleScopeName(comptime name: []const u8) []const u8 {
    if (name.len == 0) return "";
    comptime var buf: [name.len]u8 = undefined;
    inline for (name, 0..) |c, i| {
        const is_alnum = (c >= 'a' and c <= 'z') or
            (c >= 'A' and c <= 'Z') or
            (c >= '0' and c <= '9') or
            (c == '_');
        buf[i] = if (is_alnum) c else '_';
    }
    return buf[0..];
}

/// Every namespace a generated scope registry can live in: the root itself,
/// its struct declarations, and theirs — `main_module`, `koru_app`, and
/// `koru_app.koru_lib`, two levels being exactly the depth the emitter nests
/// a dotted module name to.
///
/// A `register` written inside a library emits its descriptor and dispatcher
/// BESIDE the tors they name, which is the only place they can be: Zig gives
/// a sibling struct no path to the entry struct, so the dispatcher has to sit
/// where it can reach `koru_app.koru_lib.expensive_event`. A table built from
/// `main_module` alone therefore found nothing — and found nothing SILENTLY.
/// The program compiled, ran, and took its `| scope-not-found` arm: a
/// well-formed answer built on an empty registry, which is the one failure
/// shape on this boundary with no compile step left to fail in (115_036).
fn scopeNamespaces() []const type {
    // The walk is O(declarations in the whole program), and Zig's default
    // budget is 1000 backwards branches. A program that links enough — vaxis
    // plus curl plus yyjson plus sse was the case that found this — blows it
    // and fails with "evaluation exceeded 1000 backwards branches" pointing at
    // generated code, saying nothing about scopes or `register`. The quota is
    // a compile-time-only cost and nothing here is recursive without bound:
    // `collectNamespaces` is depth-limited to 2.
    @setEvalBranchQuota(1_000_000);
    return collectNamespaces(@import("root"), 2, &[_]type{});
}

fn collectNamespaces(comptime C: type, comptime depth: usize, comptime acc: []const type) []const type {
    comptime var out: []const type = acc ++ &[_]type{C};
    if (depth == 0) return out;
    inline for (std.meta.declarations(C)) |d| {
        const V = @field(C, d.name);
        if (@TypeOf(V) != type) continue;
        if (@typeInfo(V) != .@"struct") continue;
        out = collectNamespaces(V, depth - 1, out);
    }
    return out;
}

fn buildScopeTable() []const ScopeRuntime {
    @setEvalBranchQuota(1_000_000);
    comptime var count: usize = 0;
    inline for (comptime scopeNamespaces()) |NS| {
        inline for (std.meta.declarations(NS)) |decl| {
            if (!std.mem.endsWith(u8, decl.name, "_descriptor")) continue;
            const decl_value = @field(NS, decl.name);
            if (@TypeOf(decl_value) != ScopeDescriptor) continue;
            const scope_ident = mangleScopeName(decl_value.name);
            const dispatch_name = std.fmt.comptimePrint("dispatch_{s}", .{scope_ident});
            if (!@hasDecl(NS, dispatch_name)) continue;
            count += 1;
        }
    }

    var table: [count]ScopeRuntime = undefined;
    comptime var i: usize = 0;
    inline for (comptime scopeNamespaces()) |NS| {
        inline for (std.meta.declarations(NS)) |decl| {
            if (!std.mem.endsWith(u8, decl.name, "_descriptor")) continue;
            const decl_value = @field(NS, decl.name);
            if (@TypeOf(decl_value) != ScopeDescriptor) continue;
            const desc = decl_value;
            const scope_ident = mangleScopeName(desc.name);
            const dispatch_name = std.fmt.comptimePrint("dispatch_{s}", .{scope_ident});
            if (!@hasDecl(NS, dispatch_name)) continue;

            const cost_name = std.fmt.comptimePrint("get_event_cost_{s}", .{scope_ident});
            const creates_name = std.fmt.comptimePrint("get_creates_obligations_{s}", .{scope_ident});
            const discharges_name = std.fmt.comptimePrint("get_discharges_obligations_{s}", .{scope_ident});
            const discharge_event_name = std.fmt.comptimePrint("get_discharge_event_{s}", .{scope_ident});
            const creates_spec_name = std.fmt.comptimePrint("get_creates_spec_{s}", .{scope_ident});
            const discharges_spec_name = std.fmt.comptimePrint("get_discharges_spec_{s}", .{scope_ident});
            const branches_name = std.fmt.comptimePrint("get_event_branches_{s}", .{scope_ident});
            const events_name = std.fmt.comptimePrint("get_events_{s}", .{scope_ident});
            const input_name = std.fmt.comptimePrint("get_event_input_{s}", .{scope_ident});
            const doc_name = std.fmt.comptimePrint("get_event_doc_{s}", .{scope_ident});
            const manifest_name = std.fmt.comptimePrint("{s}_manifest", .{scope_ident});

            table[i] = .{
                .name = desc.name,
                .dispatcher = &@field(NS, dispatch_name),
                .cost_fn = if (@hasDecl(NS, cost_name)) &@field(NS, cost_name) else null,
                .creates_obligations_fn = if (@hasDecl(NS, creates_name)) &@field(NS, creates_name) else null,
                .discharges_obligations_fn = if (@hasDecl(NS, discharges_name)) &@field(NS, discharges_name) else null,
                .discharge_event_fn = if (@hasDecl(NS, discharge_event_name)) &@field(NS, discharge_event_name) else null,
                .creates_spec_fn = if (@hasDecl(NS, creates_spec_name)) &@field(NS, creates_spec_name) else null,
                .discharges_spec_fn = if (@hasDecl(NS, discharges_spec_name)) &@field(NS, discharges_spec_name) else null,
                .branches_fn = if (@hasDecl(NS, branches_name)) &@field(NS, branches_name) else null,
                .events_fn = if (@hasDecl(NS, events_name)) &@field(NS, events_name) else null,
                .input_fn = if (@hasDecl(NS, input_name)) &@field(NS, input_name) else null,
                .doc_fn = if (@hasDecl(NS, doc_name)) &@field(NS, doc_name) else null,
                .manifest = if (@hasDecl(NS, manifest_name)) &@field(NS, manifest_name) else null,
            };
            i += 1;
        }
    }

    return table[0..];
}

// The scope introspection tors — get-scope, scope-vocabulary,
// scope-manifest, scope-grammar (and the scope-affordances tor decl) —
// moved to the `scopeverbs` part.

// ============================================================================
// EXPLAIN-RUNTIME - the `[explainer]` for the scope registry
//
// koruc's `koru_explain_gather` calls every discovered `[explainer]` once with
// the program AST; the `explain` command renders whatever this returns. This
// explainer builds every registered scope's manifest through the SAME shared
// producer (`scopeManifestForScope`) the register emission uses, then reports:
// a note (the human vocabulary lines) plus a `manifest` property carrying the
// EXACT JSON the `scope-manifest` tor serves — so `explain` shows the served
// contract bytes, never a hand-written copy.

// @retain: explain_runtime_event is referenced from generated code (koruc's
// koru_explain_gather invokes every discovered [explainer]).
~[comptime|explainer]pub tor explain-runtime {
    program: *const ast.Program,
    allocator: std.mem.Allocator
} -> ExplainReport

~proc explain-runtime|zig {
    const ast_mod = @import("ast");
    const CompilerEnvRt = @import("root").CompilerEnv;
    const debug_enabled = CompilerEnvRt.hasFlag("debug");

    const scope_defs = RegistryHelper.collectScopeDefs(allocator, program);
    var names = std.ArrayList([]const u8){ .items = &.{}, .capacity = 0 };
    for (scope_defs) |def| {
        var dup = false;
        for (names.items) |n| if (std.mem.eql(u8, n, def.name)) {
            dup = true;
            break;
        };
        if (!dup) names.append(allocator, def.name) catch continue;
    }

    if (names.items.len == 0) {
        var entries = std.ArrayList(ast_mod.ExplainReport.Entry){ .items = &.{}, .capacity = 0 };
        entries.append(allocator, .{ .note = "no scopes registered — declare one with std/runtime:register(scope: \"...\") { open(1) close(1) }" }) catch {};
        var sections = std.ArrayList(ast_mod.ExplainReport.Section){ .items = &.{}, .capacity = 0 };
        sections.append(allocator, .{ .heading = "scopes", .entries = entries.toOwnedSlice(allocator) catch &.{} }) catch {};
        return .{ .title = "std/runtime", .sections = sections.toOwnedSlice(allocator) catch &.{} };
    }

    var sections = std.ArrayList(ast_mod.ExplainReport.Section){ .items = &.{}, .capacity = 0 };
    for (names.items) |name| {
        const manifest = scopeManifestForScope(allocator, program, name, debug_enabled);
        const text = scopeManifestToText(allocator, &manifest);
        const json = scopeManifestToJson(allocator, &manifest) catch "";

        var entries = std.ArrayList(ast_mod.ExplainReport.Entry){ .items = &.{}, .capacity = 0 };
        entries.append(allocator, .{ .note = text }) catch continue;
        entries.append(allocator, .{ .property = .{ .key = "manifest", .value = .{ .string = json } } }) catch continue;

        sections.append(allocator, .{
            .heading = name,
            .entries = entries.toOwnedSlice(allocator) catch &.{},
        }) catch continue;
    }

    return .{
        .title = "std/runtime",
        .sections = sections.toOwnedSlice(allocator) catch &.{},
    };
}

// Internal helper: Look up tor branches for shape validation
fn lookupEventBranches(scope_name: []const u8, event_name: []const u8) []const BranchSpec {
    inline for (comptime buildScopeTable()) |scope_info| {
        if (std.mem.eql(u8, scope_name, scope_info.name)) {
            if (scope_info.branches_fn) |branches_fn| {
                return branches_fn(event_name);
            }
        }
    }
    return &[_]BranchSpec{};
}

// ============================================================================
// PARSE - Parse interpreter source without executing it
//
// Delegates to `std/interpreter:parse`, which is the interpreter's own parser.
// It takes no file name on purpose: interpreted source has no file, therefore
// no host half and no ``. This entry point used to hold a copy of the
// COMPILER's file parser (`std/koru:parse.source`), which derives its
// host/pure mode from the filename extension — so a synthetic `"x.kz"`
// silently put interpreted source in host mode and made `` mandatory, the
// exact inverse of the rule `run` enforces.
~pub tor parse.source {
    source: string,
    allocator: std.mem.Allocator
}
| parsed *const ast.Flow
| parse-error { message: string, line: u32, column: u32 }

~proc parse.source|zig {
    const interpreter_mod = @import("root").koru_std.koru_interpreter;

    return switch (interpreter_mod.parse_event.handler(.{
        .source = source,
        .allocator = allocator,
    })) {
        .flow => |f| .{ .parsed = f },
        .parse_error => |e| .{ .parse_error = .{
            .message = e.message,
            .line = e.line,
            .column = e.column,
        }},
    };
}
// RUN - Parse and execute Koru source against a named scope (shape: optional tor name to validate response against)
// @retain: run_event is referenced from generated Zig code in user pipelines (std/runtime:run invocations in continuations compile to run_event.handler(...))
~part eval
~part parsewire
~part example
~part run
