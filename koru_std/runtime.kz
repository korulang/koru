// Runtime Registry Standard Library
// Enables scoped runtime evaluation of parsed Koru code
//
// DESIGN:
// - std/runtime:register(scope: "name") { events } declares a scope (norun)
// - std/runtime:collect-scopes walks AST and generates dispatch tables
// - std/runtime:get-scope(name: "...") looks up a scope at runtime

~[comptime|runtime]

~import std/compiler_types
~import std/interpreter

const std = @import("std");
const ast = @import("ast");

// ============================================================================
// SCOPE DECLARATION - [norun] declaration collected by collect-scopes
// ============================================================================

~[comptime|transform]pub tor register {
    source: Source,
    invocation: *const Invocation,
    item: *const Item,
    program: *const Program,
    allocator: std.mem.Allocator
} -> SiteResult

// ============================================================================
// REGISTRY COMMON - shared comptime machinery: register's emission, the
// scope-manifest builder, and the [explainer] all derive from these
// ============================================================================
const ast_reg = @import("ast");

    const registry_helpers_marker = "__KORU_RUNTIME_REGISTRY_HELPERS__";

    const Helpers = struct {
        fn stripQuotes(value: []const u8) []const u8 {
            if (value.len >= 2 and value[0] == '"' and value[value.len - 1] == '"') {
                return value[1 .. value.len - 1];
            }
            return value;
        }

        fn findScopeAnnotation(annotations: []const []const u8) ?[]const u8 {
            for (annotations) |raw| {
                var ann = std.mem.trim(u8, raw, " \t\r\n");
                if (ann.len == 0) continue;
                if (ann[0] == '@' and ann.len > 1) ann = ann[1..];

                const open = std.mem.indexOf(u8, ann, "(") orelse continue;
                if (ann[ann.len - 1] != ')') continue;
                const name = std.mem.trim(u8, ann[0..open], " \t");
                if (!std.mem.eql(u8, name, "registry:scope")) continue;

                const arg = std.mem.trim(u8, ann[open + 1 .. ann.len - 1], " \t");
                if (arg.len == 0) continue;
                return stripQuotes(arg);
            }
            return null;
        }

        fn extractScopeName(inv: *const ast_reg.Invocation, flow_annotations: []const []const u8) []const u8 {
            for (inv.args) |arg| {
                if (std.mem.eql(u8, arg.name, "scope")) {
                    return stripQuotes(arg.value);
                }
            }
            if (findScopeAnnotation(inv.annotations)) |name| return name;
            if (findScopeAnnotation(flow_annotations)) |name| return name;
            return "default";
        }

        fn hasRegistryHelpers(prog: *const ast_reg.Program, module_name: []const u8) bool {
            return findInItems(prog.items, module_name);
        }

        fn findInItems(items: []const ast_reg.Item, module_name: []const u8) bool {
            for (items) |*ast_item| {
                switch (ast_item.*) {
                    .host_line => |hl| {
                        if (std.mem.eql(u8, hl.module, module_name) and
                            std.mem.indexOf(u8, hl.content, registry_helpers_marker) != null) {
                            return true;
                        }
                    },
                    .module_decl => |mod| {
                        if (findInItems(mod.items, module_name)) return true;
                    },
                    else => {},
                }
            }
            return false;
        }

        fn matchGlob(prefix: []const u8, event_name: []const u8) bool {
            if (std.mem.startsWith(u8, event_name, prefix)) {
                const rest = event_name[prefix.len..];
                if (rest.len > 0 and (rest[0] == ':' or rest[0] == '.')) {
                    return true;
                }
            }
            return false;
        }

        fn mangleIdentifier(alloc: std.mem.Allocator, name: []const u8) []const u8 {
            var out = std.ArrayList(u8){ .items = &.{}, .capacity = 0 };
            for (name) |c| {
                const is_alnum = (c >= 'a' and c <= 'z') or
                    (c >= 'A' and c <= 'Z') or
                    (c >= '0' and c <= '9') or
                    (c == '_');
                out.append(alloc, if (is_alnum) c else '_') catch continue;
            }
            return out.toOwnedSlice(alloc) catch name;
        }

        fn buildEventName(alloc: std.mem.Allocator, segments: []const []const u8) []const u8 {
            if (segments.len == 0) return "";
            var total_len: usize = 0;
            for (segments) |seg| total_len += seg.len;
            total_len += if (segments.len > 1) segments.len - 1 else 0;
            var buf = alloc.alloc(u8, total_len) catch return "";
            var pos: usize = 0;
            for (segments, 0..) |seg, i| {
                if (i > 0) {
                    buf[pos] = '.';
                    pos += 1;
                }
                @memcpy(buf[pos..][0..seg.len], seg);
                pos += seg.len;
            }
            return buf;
        }

        fn buildEventStructName(alloc: std.mem.Allocator, segments: []const []const u8) []const u8 {
            var out = std.ArrayList(u8){ .items = &.{}, .capacity = 0 };
            for (segments, 0..) |seg, idx| {
                if (idx > 0) out.append(alloc, '_') catch continue;
                for (seg) |c| {
                    if (c == '*') {
                        out.appendSlice(alloc, "_star_") catch continue;
                    } else if (c == '.' or c == '-') {
                        // `.` and kebab `-` both lower to `_` in the Zig symbol.
                        out.append(alloc, '_') catch continue;
                    } else {
                        out.append(alloc, c) catch continue;
                    }
                }
            }
            return out.toOwnedSlice(alloc) catch "";
        }

        fn buildModulePath(alloc: std.mem.Allocator, module_path: []const u8, main_module_name: []const u8) []const u8 {
            // SHADOW of codegen_utils.buildKoruModulePath — kept in sync manually
            // because this lives in stdlib Koru source (not src/) and can't import
            // codegen_utils directly. Centralization candidate; see TODO.
            if (std.mem.eql(u8, module_path, main_module_name) or std.mem.eql(u8, module_path, "main")) {
                return alloc.dupe(u8, "main_module") catch "main_module";
            }

            var out = std.ArrayList(u8){ .items = &.{}, .capacity = 0 };
            var splitter = if (std.mem.indexOfScalar(u8, module_path, '/')) |_| std.mem.splitScalar(u8, module_path, '/')
                else std.mem.splitScalar(u8, module_path, '.');
            var first = true;
            while (splitter.next()) |segment| {
                if (!first) out.append(alloc, '.') catch continue;
                out.appendSlice(alloc, "koru_") catch continue;
                out.appendSlice(alloc, segment) catch continue;
                first = false;
            }
            return out.toOwnedSlice(alloc) catch module_path;
        }

        fn buildEventSymbol(alloc: std.mem.Allocator, module_path: ?[]const u8, segments: []const []const u8, main_module_name: []const u8) []const u8 {
            const event_struct = buildEventStructName(alloc, segments);
            if (module_path) |mp| {
                const module_prefix = buildModulePath(alloc, mp, main_module_name);
                return std.fmt.allocPrint(alloc, "{s}.{s}_event", .{ module_prefix, event_struct }) catch event_struct;
            }
            return std.fmt.allocPrint(alloc, "main_module.{s}_event", .{ event_struct }) catch event_struct;
        }
    };

    const LocalCreateSpec = struct {
        obligation_module: []const u8,
        obligation_name: []const u8,
        field_name: []const u8,
        resource_type: []const u8,
    };

    const LocalDischargeSpec = struct {
        obligation_module: []const u8,
        obligation_name: []const u8,
        arg_name: []const u8,
    };

    // Local branch specs for codegen (mirrors runtime BranchSpec/BranchField)
    const LocalBranchField = struct {
        name: []const u8,
        type_name: []const u8,
        is_optional: bool,
    };

    const LocalBranchSpec = struct {
        name: []const u8,
        fields: []const LocalBranchField,
        is_optional: bool,
    };

    // Local input-field specs for codegen (mirrors runtime InputFieldSpec).
    // The input shape is the ARGUMENT vocabulary of an event — what the
    // caller must name when invoking it (`handle: string<!open>`), as opposed
    // to `branches`, which describe output shapes.
    const LocalInputField = struct {
        name: []const u8,
        type_name: []const u8,
        is_optional: bool,
        phantom: ?[]const u8,  // raw phantom: "!open" discharges, "open!" creates
    };

    const EventEntry = struct {
        name: []const u8,
        cost: u64,
        creates_obligations: []const []const u8,    // Legacy: just names
        discharges_obligations: []const []const u8, // Legacy: just names
        creates_specs: []const LocalCreateSpec,     // Full specs
        discharges_specs: []const LocalDischargeSpec,
        branches: []const LocalBranchSpec,          // Branch specs for shape validation
        input_fields: []const LocalInputField,      // Input/argument vocabulary
        symbol: []const u8,
        dispatch_name: []const u8,
        module_name: ?[]const u8,                   // Module this event belongs to
    };

    const ScopeDef = struct {
        name: []const u8,
        source_text: []const u8,
        annotations: []const []const u8,
        /// The module the `register` block was WRITTEN in, as its
        /// import-derived logical name (`app.lib`), or null at program top
        /// level. A scope entry names a tor the way the author writes it in the
        /// interpreted source — bare `expensive` — while the event registers
        /// under `app.lib:expensive`, so the lookup needs the home to close the
        /// gap. Without it the entry resolved to nothing, the registry came up
        /// with zero events, and the program COMPILED and took its
        /// `| scope-not-found` arm at run time (115_036).
        home_module: ?[]const u8,
    };

    const EventInfo = struct {
        name: []const u8,
        module_name: ?[]const u8,
        event_decl: *const ast_reg.EventDecl,
    };

    const EntryKind = enum { event, glob, scope_ref };

    const Entry = struct {
        kind: EntryKind,
        name: []const u8,
        internal_name: ?[]const u8,
        cost: u64,
    };

    const ResolvedEvent = struct {
        name: []const u8,
        internal_name: ?[]const u8,
        cost: u64,
        /// The home of the scope that named this event — see `ScopeDef`.
        home: ?[]const u8,
    };

    const RegistryHelper = struct {
        fn collectEventInfos(alloc: std.mem.Allocator, prog: *const ast_reg.Program) []EventInfo {
            var infos = std.ArrayList(EventInfo){ .items = &.{}, .capacity = 0 };
            for (prog.items) |*prog_item| {
                switch (prog_item.*) {
                    .event_decl => |*ed| {
                        const event_name = Helpers.buildEventName(alloc, ed.path.segments);
                        infos.append(alloc, .{
                            .name = event_name,
                            .module_name = null,
                            .event_decl = ed,
                        }) catch continue;
                    },
                    .module_decl => |mod| {
                        for (mod.items) |*mod_item| {
                            if (mod_item.* == .event_decl) {
                                const ed = &mod_item.event_decl;
                                const event_name = Helpers.buildEventName(alloc, ed.path.segments);
                                const qualified = std.fmt.allocPrint(alloc, "{s}:{s}", .{ mod.logical_name, event_name }) catch event_name;
                                infos.append(alloc, .{
                                    .name = qualified,
                                    .module_name = alloc.dupe(u8, mod.logical_name) catch mod.logical_name,
                                    .event_decl = ed,
                                }) catch continue;
                            }
                        }
                    },
                    else => {},
                }
            }
            return infos.toOwnedSlice(alloc) catch &.{};
        }

        fn collectScopeDefs(alloc: std.mem.Allocator, prog: *const ast_reg.Program) []ScopeDef {
            var defs = std.ArrayList(ScopeDef){ .items = &.{}, .capacity = 0 };
            for (prog.items) |prog_item| {
                switch (prog_item) {
                    .flow => |flow_item| {
                        if (isRegisterFlow(flow_item.inv())) {
                            addScopeDef(alloc, &defs, flow_item.inv(), flow_item.annotations, null);
                        }
                    },
                    .module_decl => |mod| {
                        for (mod.items) |mod_item| {
                            if (mod_item == .flow) {
                                const flow_item = mod_item.flow;
                                if (isRegisterFlow(flow_item.inv())) {
                                    addScopeDef(alloc, &defs, flow_item.inv(), flow_item.annotations, mod.logical_name);
                                }
                            }
                        }
                    },
                    else => {},
                }
            }
            return defs.toOwnedSlice(alloc) catch &.{};
        }

        fn isRegisterFlow(inv: *const ast_reg.Invocation) bool {
            if (inv.path.module_qualifier) |mq| {
                if (std.mem.eql(u8, mq, "std.runtime") and inv.path.segments.len == 1 and
                    std.mem.eql(u8, inv.path.segments[0], "register")) {
                    return true;
                }
            }
            return false;
        }

        fn addScopeDef(
            alloc: std.mem.Allocator,
            defs: *std.ArrayList(ScopeDef),
            inv: *const ast_reg.Invocation,
            annotations: []const []const u8,
            home: ?[]const u8,
        ) void {
            var source_text: []const u8 = "";
            for (inv.args) |arg| {
                if (arg.source_value) |src| {
                    source_text = src.text;
                    break;
                }
            }

            const name = Helpers.extractScopeName(inv, annotations);
            defs.append(alloc, .{
                .name = alloc.dupe(u8, name) catch name,
                .source_text = alloc.dupe(u8, source_text) catch source_text,
                .annotations = annotations,
                .home_module = if (home) |h| (alloc.dupe(u8, h) catch h) else null,
            }) catch {};
        }

        fn parseEntries(alloc: std.mem.Allocator, source_text: []const u8, debug_enabled: bool) []Entry {
            var entries = std.ArrayList(Entry){ .items = &.{}, .capacity = 0 };
            var lines = std.mem.splitScalar(u8, source_text, '\n');
            while (lines.next()) |line| {
                var trimmed = std.mem.trim(u8, line, " \t\r");
                if (trimmed.len == 0) continue;
                if (std.mem.startsWith(u8, trimmed, "//")) continue;
                if (std.mem.indexOf(u8, trimmed, "//")) |idx| {
                    trimmed = std.mem.trim(u8, trimmed[0..idx], " \t");
                }

                var entry_text = trimmed;
                if (entry_text.len > 0 and entry_text[0] == '[') {
                    if (std.mem.indexOf(u8, entry_text, "]")) |close| {
                        const flag = entry_text[1..close];
                        if (std.mem.eql(u8, flag, "debug") and !debug_enabled) {
                            continue;
                        }
                        entry_text = std.mem.trim(u8, entry_text[close + 1 ..], " \t");
                    }
                }

                if (entry_text.len == 0) continue;

                if (std.mem.startsWith(u8, entry_text, "scope(")) {
                    const close = std.mem.indexOf(u8, entry_text, ")") orelse continue;
                    const scope_ref_name = std.mem.trim(u8, entry_text[6..close], " \t");
                    entries.append(alloc, .{ .kind = .scope_ref, .name = alloc.dupe(u8, scope_ref_name) catch scope_ref_name, .internal_name = null, .cost = 1 }) catch continue;
                    continue;
                }

                if (entry_text.len >= 2 and (std.mem.endsWith(u8, entry_text, ":*") or std.mem.endsWith(u8, entry_text, ".*"))) {
                    const prefix = std.mem.trim(u8, entry_text[0 .. entry_text.len - 2], " \t");
                    entries.append(alloc, .{ .kind = .glob, .name = alloc.dupe(u8, prefix) catch prefix, .internal_name = null, .cost = 1 }) catch continue;
                    continue;
                }

                // Check for alias: internal_path -> alias(cost)
                var alias_source = entry_text;
                var internal_name_val: ?[]const u8 = null;
                if (std.mem.indexOf(u8, entry_text, "->")) |arrow_idx| {
                    const left = std.mem.trim(u8, entry_text[0..arrow_idx], " \t");
                    internal_name_val = alloc.dupe(u8, left) catch left;
                    alias_source = std.mem.trim(u8, entry_text[arrow_idx + 2 ..], " \t");
                }

                var event_name = alias_source;
                var cost: u64 = 1;
                if (std.mem.lastIndexOf(u8, alias_source, "(")) |paren_start| {
                    if (alias_source[alias_source.len - 1] == ')') {
                        const cost_str = alias_source[paren_start + 1 .. alias_source.len - 1];
                        event_name = std.mem.trim(u8, alias_source[0..paren_start], " \t");
                        cost = std.fmt.parseInt(u64, cost_str, 10) catch 1;
                    }
                }

                entries.append(alloc, .{ .kind = .event, .name = alloc.dupe(u8, event_name) catch event_name, .internal_name = internal_name_val, .cost = cost }) catch continue;
            }
            return entries.toOwnedSlice(alloc) catch &.{};
        }

        fn findScopeDef(scope_defs: []const ScopeDef, name: []const u8) ?*const ScopeDef {
            for (scope_defs) |*scope| {
                if (std.mem.eql(u8, scope.name, name)) return scope;
            }
            return null;
        }

        fn findEventInfo(event_infos: []const EventInfo, name: []const u8) ?*const EventInfo {
            for (event_infos) |*info| {
                if (std.mem.eql(u8, info.name, name)) return info;
            }
            return null;
        }

        /// A scope entry names an event the way the interpreted source will:
        /// bare `expensive`. An event declared inside a module registers as
        /// `app.lib:expensive`. Try the bare name first — a top-level event
        /// wins its own name — then the scope's own home. Two lookups, not a
        /// substring match, so a scope can never silently reach into a module
        /// it was not written in.
        fn findEventInfoHomed(
            alloc: std.mem.Allocator,
            event_infos: []const EventInfo,
            name: []const u8,
            home: ?[]const u8,
        ) ?*const EventInfo {
            if (findEventInfo(event_infos, name)) |info| return info;
            const h = home orelse return null;
            const qualified = std.fmt.allocPrint(alloc, "{s}:{s}", .{ h, name }) catch return null;
            return findEventInfo(event_infos, qualified);
        }

        fn appendUnique(events: *std.ArrayList(ResolvedEvent), alloc: std.mem.Allocator, name: []const u8, internal_name: ?[]const u8, cost: u64, home: ?[]const u8) void {
            for (events.items) |existing| {
                if (std.mem.eql(u8, existing.name, name)) return;
            }
            events.append(alloc, .{ .name = name, .internal_name = internal_name, .cost = cost, .home = home }) catch {};
        }

        fn resolveScope(
            alloc: std.mem.Allocator,
            scope_defs: []const ScopeDef,
            event_infos: []const EventInfo,
            scope_id: []const u8,
            debug_enabled: bool,
            visited: *std.StringHashMap(void),
            out_events: *std.ArrayList(ResolvedEvent),
        ) void {
            if (visited.contains(scope_id)) return;
            visited.put(scope_id, {}) catch {};

            const scope_def = findScopeDef(scope_defs, scope_id) orelse return;
            const entries = parseEntries(alloc, scope_def.source_text, debug_enabled);

            for (entries) |entry| {
                switch (entry.kind) {
                    .event => appendUnique(out_events, alloc, entry.name, entry.internal_name, entry.cost, scope_def.home_module),
                    .glob => {
                        for (event_infos) |info| {
                            if (Helpers.matchGlob(entry.name, info.name)) {
                                appendUnique(out_events, alloc, info.name, null, entry.cost, null);
                            }
                        }
                    },
                    .scope_ref => resolveScope(alloc, scope_defs, event_infos, entry.name, debug_enabled, visited, out_events),
                }
            }
        }

        /// Add @retain to proc_decls matching a given event_decl path
        fn retainMatchingProc(alloc: std.mem.Allocator, prog: *const ast_reg.Program, ed: *const ast_reg.EventDecl) void {
            retainProcInItems(alloc, prog.items, ed);
        }

        fn retainProcInItems(alloc: std.mem.Allocator, items: []const ast_reg.Item, ed: *const ast_reg.EventDecl) void {
            for (items) |*ast_item| {
                switch (ast_item.*) {
                    .proc_decl => |*pd| {
                        if (pathsMatch(&ed.path, &pd.path)) {
                            const mpd = @constCast(pd);
                            const new_anns = alloc.alloc([]const u8, mpd.annotations.len + 1) catch continue;
                            @memcpy(new_anns[0..mpd.annotations.len], mpd.annotations);
                            new_anns[mpd.annotations.len] = "retain";
                            mpd.annotations = new_anns;
                        }
                    },
                    .module_decl => |mod| retainProcInItems(alloc, mod.items, ed),
                    else => {},
                }
            }
        }

        fn pathsMatch(a: *const ast_reg.DottedPath, b: *const ast_reg.DottedPath) bool {
            // Compare module qualifiers
            if (a.module_qualifier) |amq| {
                if (b.module_qualifier) |bmq| {
                    if (!std.mem.eql(u8, amq, bmq)) return false;
                } else return false;
            } else if (b.module_qualifier != null) return false;
            // Compare segments
            if (a.segments.len != b.segments.len) return false;
            for (a.segments, b.segments) |sa, sb| {
                if (!std.mem.eql(u8, sa, sb)) return false;
            }
            return true;
        }
    };

    // Helper: Parse phantom string to extract obligation name and optional module qualifier
    // Input: "opened!", "!opened", "sqlite3:opened!", "!fs:opened"
    // Returns (module, name, is_creates, is_discharges)
    const parsePhantom = struct {
        fn parse(alloc: std.mem.Allocator, phantom_str: []const u8) struct {
            module: ?[]const u8,  // Module qualifier if present (e.g., "sqlite3")
            name: ?[]const u8,    // Obligation name (e.g., "opened")
            creates: bool,
            discharges: bool,
        } {
            if (phantom_str.len == 0) return .{ .module = null, .name = null, .creates = false, .discharges = false };

            var str = phantom_str;
            var discharges = false;
            var creates = false;

            // Check for ! prefix (discharges obligation)
            if (str[0] == '!') {
                discharges = true;
                str = str[1..];
            }

            // Check for ! suffix (creates obligation)
            if (str.len > 0 and str[str.len - 1] == '!') {
                creates = true;
                str = str[0 .. str.len - 1];
            }

            // Skip if neither creates nor discharges
            if (!creates and !discharges) return .{ .module = null, .name = null, .creates = false, .discharges = false };

            // Check for module qualifier (e.g., "sqlite3:opened")
            var module: ?[]const u8 = null;
            var name = str;
            if (std.mem.indexOf(u8, str, ":")) |colon_idx| {
                module = alloc.dupe(u8, str[0..colon_idx]) catch null;
                name = str[colon_idx + 1 ..];
            }

            return .{
                .module = module,
                .name = alloc.dupe(u8, name) catch null,
                .creates = creates,
                .discharges = discharges,
            };
        }
    }.parse;

    // Helper: the bare resource type a handle is minted for — pointer syntax,
    // bracket phantom and module qualifier stripped. Shared by both places a
    // create-phantom can ride: a branch payload field and a bare return.
    const bareResourceType = struct {
        fn strip(declared: []const u8) []const u8 {
            var res_type = declared;
            if (std.mem.startsWith(u8, res_type, "*")) {
                res_type = res_type[1..];
            }
            if (std.mem.indexOf(u8, res_type, "[")) |idx| {
                res_type = std.mem.trim(u8, res_type[0..idx], " ");
            }
            if (std.mem.lastIndexOf(u8, res_type, ":")) |colon_idx| {
                res_type = res_type[colon_idx + 1 ..];
            }
            return res_type;
        }
    }.strip;

    // Helper: Extract obligations from EventDecl with full field/arg info
    const extractObligations = struct {
        fn extract(alloc: std.mem.Allocator, ed: *const ast_reg.EventDecl, module_name: ?[]const u8) struct {
            creates: []const []const u8,
            discharges: []const []const u8,
            creates_specs: []const LocalCreateSpec,
            discharges_specs: []const LocalDischargeSpec,
        } {
            var creates = std.ArrayList([]const u8){ .items = &.{}, .capacity = 0 };
            var discharges = std.ArrayList([]const u8){ .items = &.{}, .capacity = 0 };
            var creates_specs = std.ArrayList(LocalCreateSpec){ .items = &.{}, .capacity = 0 };
            var discharges_specs = std.ArrayList(LocalDischargeSpec){ .items = &.{}, .capacity = 0 };

            const default_module = module_name orelse "main";

            // Check input fields for <!state> (discharges)
            for (ed.input.fields) |field| {
                if (field.phantom) |phantom_str| {
                    const result = parsePhantom(alloc, phantom_str);
                    if (result.discharges) {
                        if (result.name) |name| {
                            // Prefer phantom qualifier, fall back to event module
                            const obl_module = result.module orelse alloc.dupe(u8, default_module) catch default_module;
                            discharges.append(alloc, name) catch continue;
                            discharges_specs.append(alloc, .{
                                .obligation_module = obl_module,
                                .obligation_name = name,
                                .arg_name = alloc.dupe(u8, field.name) catch field.name,
                            }) catch continue;
                        }
                    }
                }
            }

            // Check branch output fields for <state!> (creates)
            for (ed.branches) |branch| {
                for (branch.payload.fields) |field| {
                    if (field.phantom) |phantom_str| {
                        const result = parsePhantom(alloc, phantom_str);
                        if (result.creates) {
                            if (result.name) |name| {
                                // Prefer phantom qualifier, fall back to event module
                                const obl_module = result.module orelse alloc.dupe(u8, default_module) catch default_module;
                                creates.append(alloc, name) catch continue;
                                const res_type = bareResourceType(field.type);
                                creates_specs.append(alloc, .{
                                    .obligation_module = obl_module,
                                    .obligation_name = name,
                                    .field_name = alloc.dupe(u8, field.name) catch field.name,
                                    .resource_type = alloc.dupe(u8, res_type) catch res_type,
                                }) catch continue;
                            }
                        }
                    }
                }
            }

            // A bare return carries its phantom on the DECLARATION, not on a
            // branch payload field: `-> *R<active!>` has no branches at all, and
            // the parser forces a lone handle into exactly that shape (PARSE003
            // rejects `| opened { h: T<opened!> }`). Reading only `ed.branches`
            // meant the canonical way to spell "this call mints a resource" was
            // invisible to the registry, so no handle was ever minted for it.
            //
            // The dispatcher reports a bare return on `__type_ref` — the same
            // channel an identity branch uses — so the spec is identical to the
            // branch case; only where the phantom is READ from differs.
            if (ed.return_phantom) |phantom_str| {
                const result = parsePhantom(alloc, phantom_str);
                if (result.creates) {
                    if (result.name) |name| {
                        const obl_module = result.module orelse alloc.dupe(u8, default_module) catch default_module;
                        creates.append(alloc, name) catch {};
                        const res_type = bareResourceType(ed.return_type orelse "unknown");
                        creates_specs.append(alloc, .{
                            .obligation_module = obl_module,
                            .obligation_name = name,
                            .field_name = alloc.dupe(u8, "__type_ref") catch "__type_ref",
                            .resource_type = alloc.dupe(u8, res_type) catch res_type,
                        }) catch {};
                    }
                }
            }

            return .{
                .creates = creates.toOwnedSlice(alloc) catch &.{},
                .discharges = discharges.toOwnedSlice(alloc) catch &.{},
                .creates_specs = creates_specs.toOwnedSlice(alloc) catch &.{},
                .discharges_specs = discharges_specs.toOwnedSlice(alloc) catch &.{},
            };
        }
    }.extract;

    // Helper: Extract branch specs from EventDecl for shape validation
    const extractBranches = struct {
        fn extract(alloc: std.mem.Allocator, ed: *const ast_reg.EventDecl) []const LocalBranchSpec {
            var branch_specs = std.ArrayList(LocalBranchSpec){ .items = &.{}, .capacity = 0 };

            for (ed.branches) |branch| {
                var field_specs = std.ArrayList(LocalBranchField){ .items = &.{}, .capacity = 0 };

                for (branch.payload.fields) |field| {
                    // Check if field type starts with ? (optional)
                    const is_optional = field.type.len > 0 and field.type[0] == '?';
                    const type_name = if (is_optional) field.type[1..] else field.type;

                    field_specs.append(alloc, .{
                        .name = alloc.dupe(u8, field.name) catch field.name,
                        .type_name = alloc.dupe(u8, type_name) catch type_name,
                        .is_optional = is_optional,
                    }) catch continue;
                }

                branch_specs.append(alloc, .{
                    .name = alloc.dupe(u8, branch.name) catch branch.name,
                    .fields = field_specs.toOwnedSlice(alloc) catch &.{},
                    .is_optional = branch.is_optional,
                }) catch continue;
            }

            return branch_specs.toOwnedSlice(alloc) catch &.{};
        }
    }.extract;

    // Helper: Extract the event's INPUT fields — its argument vocabulary. This
    // is what makes "ask a scope what it holds" answerable for a caller that
    // must name the arguments (`open(path: ...)`), and where the possession
    // phantoms (`<!open>`) live. Branches above are the OUTPUT side.
    const extractInputFields = struct {
        fn extract(alloc: std.mem.Allocator, ed: *const ast_reg.EventDecl) []const LocalInputField {
            var field_specs = std.ArrayList(LocalInputField){ .items = &.{}, .capacity = 0 };

            for (ed.input.fields) |field| {
                const is_optional = field.type.len > 0 and field.type[0] == '?';
                const type_name = if (is_optional) field.type[1..] else field.type;
                field_specs.append(alloc, .{
                    .name = alloc.dupe(u8, field.name) catch field.name,
                    .type_name = alloc.dupe(u8, type_name) catch type_name,
                    .is_optional = is_optional,
                    .phantom = if (field.phantom) |p| alloc.dupe(u8, p) catch p else null,
                }) catch continue;
            }

            return field_specs.toOwnedSlice(alloc) catch &.{};
        }
    }.extract;

~proc register|zig {
    const CompilerEnvRt = @import("root").CompilerEnv;
    // Get the flow from the item
    const flow = if (item.* == .flow) &item.flow else return .{};

    // Extract scope name from args or registry annotations
    const scope_name = Helpers.extractScopeName(invocation, flow.annotations);

    std.debug.print("[REGISTRY] Creating dispatcher for scope '{s}'\n", .{scope_name});

    // Parse events from source block with optional costs and composition
    // Syntax:
    //   event_name              - default cost 1
    //   event_name(cost)        - custom cost
    //   scope(other)            - include another scope
    //   module:*                - include all events under module prefix
    //
    // Obligations are extracted from event signatures using phantom types:
    //   <state!> in output = creates obligation (! suffix)
    //   <!state> in input = discharges obligation (! prefix)

    // Local CreateSpec/DischargeSpec for codegen (mirrors runtime types)
    const event_infos = RegistryHelper.collectEventInfos(allocator, program);
    const scope_defs = RegistryHelper.collectScopeDefs(allocator, program);
    const debug_enabled = CompilerEnvRt.hasFlag("debug");

    var resolved_events = std.ArrayList(ResolvedEvent){ .items = &.{}, .capacity = 0 };
    var visited = std.StringHashMap(void).init(allocator);
    defer visited.deinit();
    RegistryHelper.resolveScope(allocator, scope_defs, event_infos, scope_name, debug_enabled, &visited, &resolved_events);

    // Add @retain annotation to registered events so dead strip preserves them.
    // The event_infos point into the original program; replaceFlowRecursive clones
    // them, carrying the annotations into the new program.
    for (resolved_events.items) |resolved| {
        const lookup_name = resolved.internal_name orelse resolved.name;
        const info = RegistryHelper.findEventInfoHomed(allocator, event_infos, lookup_name, resolved.home) orelse continue;
        // Retain the event_decl
        const mutable_decl = @constCast(info.event_decl);
        const new_anns = allocator.alloc([]const u8, mutable_decl.annotations.len + 1) catch continue;
        @memcpy(new_anns[0..mutable_decl.annotations.len], mutable_decl.annotations);
        new_anns[mutable_decl.annotations.len] = "retain";
        mutable_decl.annotations = new_anns;
        // Also retain the matching proc_decl (same path)
        RegistryHelper.retainMatchingProc(allocator, program, info.event_decl);
    }

    const scope_ident = Helpers.mangleIdentifier(allocator, scope_name);
    const module_name = flow.inv().path.module_qualifier orelse "main";
    const emit_helpers = !Helpers.hasRegistryHelpers(program, module_name);
    var events_list = std.ArrayList(EventEntry){ .items = &.{}, .capacity = 0 };
    for (resolved_events.items) |resolved| {
        const lookup_name = resolved.internal_name orelse resolved.name;
        const info = RegistryHelper.findEventInfoHomed(allocator, event_infos, lookup_name, resolved.home) orelse continue;
        const obligations = extractObligations(allocator, info.event_decl, info.module_name);
        const branches = extractBranches(allocator, info.event_decl);
        const input_fields = extractInputFields(allocator, info.event_decl);
        const symbol = Helpers.buildEventSymbol(allocator, info.module_name, info.event_decl.path.segments, program.main_module_name);
        const dispatch_ident = Helpers.mangleIdentifier(allocator, resolved.name);
        const dispatch_name = std.fmt.allocPrint(allocator, "dispatch_{s}_{s}", .{ scope_ident, dispatch_ident }) catch dispatch_ident;

        if (obligations.creates.len > 0 or obligations.discharges.len > 0) {
            std.debug.print("[REGISTRY] Event '{s}': creates={d} specs, discharges={d} specs\n",
                .{resolved.name, obligations.creates_specs.len, obligations.discharges_specs.len});
        }

        events_list.append(allocator, .{
            .name = resolved.name,
            .cost = resolved.cost,
            .creates_obligations = obligations.creates,
            .discharges_obligations = obligations.discharges,
            .creates_specs = obligations.creates_specs,
            .discharges_specs = obligations.discharges_specs,
            .branches = branches,
            .input_fields = input_fields,
            .symbol = symbol,
            .dispatch_name = dispatch_name,
            .module_name = info.module_name,
        }) catch continue;
    }

    std.debug.print("[REGISTRY] Found {d} events\n", .{events_list.items.len});

    // Generate dispatcher code (indented for main_module)
    var code = std.ArrayList(u8){ .items = &.{}, .capacity = 0 };
    const I = "    "; // 4 spaces for main_module indentation

    if (emit_helpers) {
        code.appendSlice(allocator, I ++ "// " ++ registry_helpers_marker ++ "\n") catch unreachable;

        // Import required modules for generated code
        code.appendSlice(allocator, I ++ "const dispatcher_std = @import(\"std\");\n") catch unreachable;
        code.appendSlice(allocator, I ++ "const dispatcher_ast = @import(\"ast\");\n\n") catch unreachable;

        // Export type aliases for user code (so they can use bare names like Path, Invocation, etc.)
        code.appendSlice(allocator, I ++ "pub const Path = dispatcher_ast.DottedPath;\n") catch unreachable;
        code.appendSlice(allocator, I ++ "pub const Arg = dispatcher_ast.Arg;\n") catch unreachable;
        code.appendSlice(allocator, I ++ "pub const Invocation = dispatcher_ast.Invocation;\n") catch unreachable;
        code.appendSlice(allocator, I ++ "pub const DispatchResult = koru_std.koru_runtime.DispatchResult;\n") catch unreachable;
        code.appendSlice(allocator, I ++ "const ScopeEvent = koru_std.koru_runtime.ScopeEvent;\n") catch unreachable;
        code.appendSlice(allocator, I ++ "const ScopeDescriptor = koru_std.koru_runtime.ScopeDescriptor;\n") catch unreachable;
        code.appendSlice(allocator, I ++ "const ScopeManifest = koru_std.koru_runtime.ScopeManifest;\n") catch unreachable;
        code.appendSlice(allocator, I ++ "const ManifestEvent = koru_std.koru_runtime.ManifestEvent;\n") catch unreachable;
        code.appendSlice(allocator, I ++ "const ManifestArg = koru_std.koru_runtime.ManifestArg;\n") catch unreachable;
        code.appendSlice(allocator, I ++ "const ManifestCreate = koru_std.koru_runtime.ManifestCreate;\n") catch unreachable;
        code.appendSlice(allocator, I ++ "const ManifestDischarge = koru_std.koru_runtime.ManifestDischarge;\n") catch unreachable;
        code.appendSlice(allocator, I ++ "const ManifestBranch = koru_std.koru_runtime.ManifestBranch;\n") catch unreachable;
        code.appendSlice(allocator, I ++ "const ManifestBranchField = koru_std.koru_runtime.ManifestBranchField;\n") catch unreachable;
        code.appendSlice(allocator, I ++ "const FieldValue = koru_std.koru_runtime.FieldValue;\n") catch unreachable;
        code.appendSlice(allocator, I ++ "const NamedField = koru_std.koru_runtime.NamedField;\n\n") catch unreachable;

        // Helper function - strips quotes from string values
        code.appendSlice(allocator, I ++ "fn getArg(args: []const dispatcher_ast.Arg, n: []const u8) ?[]const u8 {\n") catch unreachable;
        code.appendSlice(allocator, I ++ "    for (args) |arg| {\n") catch unreachable;
        code.appendSlice(allocator, I ++ "        if (dispatcher_std.mem.eql(u8, arg.name, n)) {\n") catch unreachable;
        code.appendSlice(allocator, I ++ "            var v = arg.value;\n") catch unreachable;
        code.appendSlice(allocator, I ++ "            if (v.len >= 2 and v[0] == '\"' and v[v.len-1] == '\"') v = v[1..v.len-1];\n") catch unreachable;
        code.appendSlice(allocator, I ++ "            return v;\n") catch unreachable;
        code.appendSlice(allocator, I ++ "        }\n") catch unreachable;
        code.appendSlice(allocator, I ++ "    }\n") catch unreachable;
        code.appendSlice(allocator, I ++ "    return null;\n") catch unreachable;
        code.appendSlice(allocator, I ++ "}\n\n") catch unreachable;

        // Helper function - builds Input struct from args using comptime reflection
        code.appendSlice(allocator, I ++ "fn buildInput(comptime T: type, args: []const dispatcher_ast.Arg) T {\n") catch unreachable;
        code.appendSlice(allocator, I ++ "    var input: T = undefined;\n") catch unreachable;
        code.appendSlice(allocator, I ++ "    inline for (dispatcher_std.meta.fields(T)) |field| {\n") catch unreachable;
        code.appendSlice(allocator, I ++ "        const raw = getArg(args, field.name) orelse \"\";\n") catch unreachable;
        code.appendSlice(allocator, I ++ "        const F = field.type;\n") catch unreachable;
        code.appendSlice(allocator, I ++ "        if (F == bool) {\n") catch unreachable;
        code.appendSlice(allocator, I ++ "            @field(input, field.name) = dispatcher_std.mem.eql(u8, raw, \"true\") or dispatcher_std.mem.eql(u8, raw, \"1\");\n") catch unreachable;
        code.appendSlice(allocator, I ++ "        } else switch (@typeInfo(F)) {\n") catch unreachable;
        code.appendSlice(allocator, I ++ "            .int => {\n") catch unreachable;
        code.appendSlice(allocator, I ++ "                @field(input, field.name) = dispatcher_std.fmt.parseInt(F, raw, 10) catch 0;\n") catch unreachable;
        code.appendSlice(allocator, I ++ "            },\n") catch unreachable;
        code.appendSlice(allocator, I ++ "            .float => {\n") catch unreachable;
        code.appendSlice(allocator, I ++ "                @field(input, field.name) = dispatcher_std.fmt.parseFloat(F, raw) catch 0;\n") catch unreachable;
        code.appendSlice(allocator, I ++ "            },\n") catch unreachable;
        code.appendSlice(allocator, I ++ "            .pointer => |ptr_info| {\n") catch unreachable;
        code.appendSlice(allocator, I ++ "                if (ptr_info.size == .slice and ptr_info.child == u8) {\n") catch unreachable;
        code.appendSlice(allocator, I ++ "                    @field(input, field.name) = raw;\n") catch unreachable;
        code.appendSlice(allocator, I ++ "                } else {\n") catch unreachable;
        code.appendSlice(allocator, I ++ "                    @field(input, field.name) = dispatcher_std.mem.zeroes(F);\n") catch unreachable;
        code.appendSlice(allocator, I ++ "                }\n") catch unreachable;
        code.appendSlice(allocator, I ++ "            },\n") catch unreachable;
        code.appendSlice(allocator, I ++ "            else => {\n") catch unreachable;
        code.appendSlice(allocator, I ++ "                @field(input, field.name) = dispatcher_std.mem.zeroes(F);\n") catch unreachable;
        code.appendSlice(allocator, I ++ "            },\n") catch unreachable;
        code.appendSlice(allocator, I ++ "        }\n") catch unreachable;
        code.appendSlice(allocator, I ++ "    }\n") catch unreachable;
        code.appendSlice(allocator, I ++ "    return input;\n") catch unreachable;
        code.appendSlice(allocator, I ++ "}\n\n") catch unreachable;
    }

    // Per-event dispatchers and descriptor table
    for (events_list.items) |event| {
        const is_control_flow = std.mem.eql(u8, event.name, "if") or
                                std.mem.eql(u8, event.name, "for") or
                                std.mem.eql(u8, event.name, "std.control:if") or
                                std.mem.eql(u8, event.name, "std.control:for");

        code.appendSlice(allocator, I ++ "fn ") catch unreachable;
        code.appendSlice(allocator, event.dispatch_name) catch unreachable;
        code.appendSlice(allocator, "(inv: *const dispatcher_ast.Invocation, out: *koru_std.koru_runtime.DispatchResult) !void {\n") catch unreachable;

        if (is_control_flow) {
            code.appendSlice(allocator, I ++ "    _ = inv; // Control flow - interpreter handles this\n") catch unreachable;
            code.appendSlice(allocator, I ++ "    out.* = .{ .branch = \"control\", .fields = &.{} };\n") catch unreachable;
            code.appendSlice(allocator, I ++ "    return;\n") catch unreachable;
        } else {
            // Generate dispatcher that handles both void and branched events
            code.appendSlice(allocator, I ++ "    const Input = ") catch unreachable;
            code.appendSlice(allocator, event.symbol) catch unreachable;
            code.appendSlice(allocator, ".Input;\n") catch unreachable;
            code.appendSlice(allocator, I ++ "    const Handler = ") catch unreachable;
            code.appendSlice(allocator, event.symbol) catch unreachable;
            code.appendSlice(allocator, ";\n") catch unreachable;
            code.appendSlice(allocator, I ++ "    const ReturnType = @typeInfo(@TypeOf(Handler.handler)).@\"fn\".return_type.?;\n") catch unreachable;
            code.appendSlice(allocator, I ++ "    if (ReturnType == void) {\n") catch unreachable;
            code.appendSlice(allocator, I ++ "        // Void event - just call and return empty branch\n") catch unreachable;
            code.appendSlice(allocator, I ++ "        Handler.handler(buildInput(Input, inv.args));\n") catch unreachable;
            code.appendSlice(allocator, I ++ "        out.* = .{ .branch = \"\", .fields = &.{} };\n") catch unreachable;
            code.appendSlice(allocator, I ++ "        return;\n") catch unreachable;
            code.appendSlice(allocator, I ++ "    }\n") catch unreachable;
            code.appendSlice(allocator, I ++ "    if (@typeInfo(ReturnType) != .@\"union\") {\n") catch unreachable;
            code.appendSlice(allocator, I ++ "        // Single-return tor (`-> T`): the value BINDS, it does not select a\n") catch unreachable;
            code.appendSlice(allocator, I ++ "        // branch. Reported as the empty branch with the value on __type_ref,\n") catch unreachable;
            code.appendSlice(allocator, I ++ "        // the same channel identity branches use for bare payloads.\n") catch unreachable;
            code.appendSlice(allocator, I ++ "        const v = Handler.handler(buildInput(Input, inv.args));\n") catch unreachable;
            code.appendSlice(allocator, I ++ "        const V = @TypeOf(v);\n") catch unreachable;
            code.appendSlice(allocator, I ++ "        const SR = struct { threadlocal var buf: [1]NamedField = undefined; };\n") catch unreachable;
            code.appendSlice(allocator, I ++ "        var n: usize = 0;\n") catch unreachable;
            code.appendSlice(allocator, I ++ "        if (V == bool) {\n") catch unreachable;
            code.appendSlice(allocator, I ++ "            SR.buf[0] = .{ .name = \"__type_ref\", .value = FieldValue{ .bool_val = v } };\n") catch unreachable;
            code.appendSlice(allocator, I ++ "            n = 1;\n") catch unreachable;
            code.appendSlice(allocator, I ++ "        } else if (@typeInfo(V) == .int) {\n") catch unreachable;
            code.appendSlice(allocator, I ++ "            SR.buf[0] = .{ .name = \"__type_ref\", .value = FieldValue{ .int_val = @as(i64, @intCast(v)) } };\n") catch unreachable;
            code.appendSlice(allocator, I ++ "            n = 1;\n") catch unreachable;
            code.appendSlice(allocator, I ++ "        } else if (@typeInfo(V) == .float) {\n") catch unreachable;
            code.appendSlice(allocator, I ++ "            SR.buf[0] = .{ .name = \"__type_ref\", .value = FieldValue{ .float_val = @as(f64, @floatCast(v)) } };\n") catch unreachable;
            code.appendSlice(allocator, I ++ "            n = 1;\n") catch unreachable;
            code.appendSlice(allocator, I ++ "        } else if (@typeInfo(V) == .pointer) {\n") catch unreachable;
            code.appendSlice(allocator, I ++ "            const ptr_info = @typeInfo(V).pointer;\n") catch unreachable;
            code.appendSlice(allocator, I ++ "            if (ptr_info.size == .slice and ptr_info.child == u8) {\n") catch unreachable;
            code.appendSlice(allocator, I ++ "                SR.buf[0] = .{ .name = \"__type_ref\", .value = FieldValue{ .string_val = v } };\n") catch unreachable;
            code.appendSlice(allocator, I ++ "                n = 1;\n") catch unreachable;
            code.appendSlice(allocator, I ++ "            }\n") catch unreachable;
            code.appendSlice(allocator, I ++ "        }\n") catch unreachable;
            code.appendSlice(allocator, I ++ "        out.* = .{ .branch = \"\", .fields = SR.buf[0..n] };\n") catch unreachable;
            code.appendSlice(allocator, I ++ "        return;\n") catch unreachable;
            code.appendSlice(allocator, I ++ "    }\n") catch unreachable;
            code.appendSlice(allocator, I ++ "    // Branched event - extract branch and fields\n") catch unreachable;
            code.appendSlice(allocator, I ++ "    const r = Handler.handler(buildInput(Input, inv.args));\n") catch unreachable;
            code.appendSlice(allocator, I ++ "    const S = struct { threadlocal var buf: [16]NamedField = undefined; };\n") catch unreachable;
            code.appendSlice(allocator, I ++ "    const branch = @tagName(r);\n") catch unreachable;
            code.appendSlice(allocator, I ++ "    const field_count = switch (r) { inline else => |p| blk: {\n") catch unreachable;
            code.appendSlice(allocator, I ++ "        const P = @TypeOf(p);\n") catch unreachable;
            code.appendSlice(allocator, I ++ "        // Identity branches have bare types, not structs\n") catch unreachable;
            code.appendSlice(allocator, I ++ "        if (@typeInfo(P) != .@\"struct\") {\n") catch unreachable;
            code.appendSlice(allocator, I ++ "            // Identity branch - create synthetic __type_ref field\n") catch unreachable;
            code.appendSlice(allocator, I ++ "            if (P == bool) {\n") catch unreachable;
            code.appendSlice(allocator, I ++ "                S.buf[0] = .{ .name = \"__type_ref\", .value = FieldValue{ .bool_val = p } };\n") catch unreachable;
            code.appendSlice(allocator, I ++ "            } else if (@typeInfo(P) == .int) {\n") catch unreachable;
            code.appendSlice(allocator, I ++ "                S.buf[0] = .{ .name = \"__type_ref\", .value = FieldValue{ .int_val = @as(i64, @intCast(p)) } };\n") catch unreachable;
            code.appendSlice(allocator, I ++ "            } else if (@typeInfo(P) == .float) {\n") catch unreachable;
            code.appendSlice(allocator, I ++ "                S.buf[0] = .{ .name = \"__type_ref\", .value = FieldValue{ .float_val = @as(f64, @floatCast(p)) } };\n") catch unreachable;
            code.appendSlice(allocator, I ++ "            } else if (@typeInfo(P) == .pointer) {\n") catch unreachable;
            code.appendSlice(allocator, I ++ "                const ptr_info = @typeInfo(P).pointer;\n") catch unreachable;
            code.appendSlice(allocator, I ++ "                if (ptr_info.size == .slice and ptr_info.child == u8) {\n") catch unreachable;
            code.appendSlice(allocator, I ++ "                    S.buf[0] = .{ .name = \"__type_ref\", .value = FieldValue{ .string_val = p } };\n") catch unreachable;
            code.appendSlice(allocator, I ++ "                } else {\n") catch unreachable;
            code.appendSlice(allocator, I ++ "                    break :blk @as(usize, 0);\n") catch unreachable;
            code.appendSlice(allocator, I ++ "                }\n") catch unreachable;
            code.appendSlice(allocator, I ++ "            } else {\n") catch unreachable;
            code.appendSlice(allocator, I ++ "                break :blk @as(usize, 0);\n") catch unreachable;
            code.appendSlice(allocator, I ++ "            }\n") catch unreachable;
            code.appendSlice(allocator, I ++ "            break :blk @as(usize, 1);\n") catch unreachable;
            code.appendSlice(allocator, I ++ "        }\n") catch unreachable;
            code.appendSlice(allocator, I ++ "        // Compound branch - iterate over struct fields\n") catch unreachable;
            code.appendSlice(allocator, I ++ "        const payload_fields = dispatcher_std.meta.fields(P);\n") catch unreachable;
            code.appendSlice(allocator, I ++ "        comptime var count: usize = 0;\n") catch unreachable;
            code.appendSlice(allocator, I ++ "        inline for (payload_fields) |field| {\n") catch unreachable;
            code.appendSlice(allocator, I ++ "            const T = field.type;\n") catch unreachable;
            code.appendSlice(allocator, I ++ "            if (T == bool) {\n") catch unreachable;
            code.appendSlice(allocator, I ++ "                S.buf[count] = .{ .name = field.name, .value = FieldValue{ .bool_val = @field(p, field.name) } };\n") catch unreachable;
            code.appendSlice(allocator, I ++ "                count += 1;\n") catch unreachable;
            code.appendSlice(allocator, I ++ "            } else switch (@typeInfo(T)) {\n") catch unreachable;
            code.appendSlice(allocator, I ++ "                .int => {\n") catch unreachable;
            code.appendSlice(allocator, I ++ "                    S.buf[count] = .{ .name = field.name, .value = FieldValue{ .int_val = @as(i64, @intCast(@field(p, field.name))) } };\n") catch unreachable;
            code.appendSlice(allocator, I ++ "                    count += 1;\n") catch unreachable;
            code.appendSlice(allocator, I ++ "                },\n") catch unreachable;
            code.appendSlice(allocator, I ++ "                .float => {\n") catch unreachable;
            code.appendSlice(allocator, I ++ "                    S.buf[count] = .{ .name = field.name, .value = FieldValue{ .float_val = @as(f64, @floatCast(@field(p, field.name))) } };\n") catch unreachable;
            code.appendSlice(allocator, I ++ "                    count += 1;\n") catch unreachable;
            code.appendSlice(allocator, I ++ "                },\n") catch unreachable;
            code.appendSlice(allocator, I ++ "                .pointer => |ptr_info| {\n") catch unreachable;
            code.appendSlice(allocator, I ++ "                    if (ptr_info.size == .slice and ptr_info.child == u8) {\n") catch unreachable;
            code.appendSlice(allocator, I ++ "                        S.buf[count] = .{ .name = field.name, .value = FieldValue{ .string_val = @field(p, field.name) } };\n") catch unreachable;
            code.appendSlice(allocator, I ++ "                        count += 1;\n") catch unreachable;
            code.appendSlice(allocator, I ++ "                    }\n") catch unreachable;
            code.appendSlice(allocator, I ++ "                },\n") catch unreachable;
            code.appendSlice(allocator, I ++ "                else => {},\n") catch unreachable;
            code.appendSlice(allocator, I ++ "            }\n") catch unreachable;
            code.appendSlice(allocator, I ++ "        }\n") catch unreachable;
            code.appendSlice(allocator, I ++ "        break :blk count;\n") catch unreachable;
            code.appendSlice(allocator, I ++ "    }};\n") catch unreachable;
            code.appendSlice(allocator, I ++ "    out.* = .{ .branch = branch, .fields = S.buf[0..field_count] };\n") catch unreachable;
            code.appendSlice(allocator, I ++ "    return;\n") catch unreachable;
        }

        code.appendSlice(allocator, I ++ "}\n\n") catch unreachable;
    }

    // Scope descriptor and public dispatcher
    // Obligations are extracted from event signatures using phantom types
    code.appendSlice(allocator, I ++ "const scope_events_") catch unreachable;
    code.appendSlice(allocator, scope_ident) catch unreachable;
    code.appendSlice(allocator, " = [_]ScopeEvent{\n") catch unreachable;
    for (events_list.items) |event| {
        code.appendSlice(allocator, I ++ "    .{ .name = \"") catch unreachable;
        code.appendSlice(allocator, event.name) catch unreachable;
        code.appendSlice(allocator, "\", .cost = ") catch unreachable;
        var cost_buf: [32]u8 = undefined;
        const cost_str = std.fmt.bufPrint(&cost_buf, "{d}", .{event.cost}) catch "1";
        code.appendSlice(allocator, cost_str) catch unreachable;

        // Emit creates_obligations array (legacy)
        code.appendSlice(allocator, ", .creates_obligations = &[_][]const u8{") catch unreachable;
        for (event.creates_obligations, 0..) |obl, i| {
            if (i > 0) code.appendSlice(allocator, ", ") catch unreachable;
            code.appendSlice(allocator, "\"") catch unreachable;
            code.appendSlice(allocator, obl) catch unreachable;
            code.appendSlice(allocator, "\"") catch unreachable;
        }
        code.appendSlice(allocator, "}") catch unreachable;

        // Emit discharges_obligations array (legacy)
        code.appendSlice(allocator, ", .discharges_obligations = &[_][]const u8{") catch unreachable;
        for (event.discharges_obligations, 0..) |obl, i| {
            if (i > 0) code.appendSlice(allocator, ", ") catch unreachable;
            code.appendSlice(allocator, "\"") catch unreachable;
            code.appendSlice(allocator, obl) catch unreachable;
            code.appendSlice(allocator, "\"") catch unreachable;
        }
        code.appendSlice(allocator, "}") catch unreachable;

        // Emit creates_specs array (full specs with field names)
        code.appendSlice(allocator, ", .creates_specs = &[_]koru_std.koru_runtime.CreateSpec{") catch unreachable;
        for (event.creates_specs, 0..) |spec, i| {
            if (i > 0) code.appendSlice(allocator, ", ") catch unreachable;
            code.appendSlice(allocator, ".{ .obligation_module = \"") catch unreachable;
            code.appendSlice(allocator, spec.obligation_module) catch unreachable;
            code.appendSlice(allocator, "\", .obligation_name = \"") catch unreachable;
            code.appendSlice(allocator, spec.obligation_name) catch unreachable;
            code.appendSlice(allocator, "\", .field_name = \"") catch unreachable;
            code.appendSlice(allocator, spec.field_name) catch unreachable;
            code.appendSlice(allocator, "\", .resource_type = \"") catch unreachable;
            code.appendSlice(allocator, spec.resource_type) catch unreachable;
            code.appendSlice(allocator, "\" }") catch unreachable;
        }
        code.appendSlice(allocator, "}") catch unreachable;

        // Emit discharges_specs array (full specs with arg names)
        code.appendSlice(allocator, ", .discharges_specs = &[_]koru_std.koru_runtime.DischargeSpec{") catch unreachable;
        for (event.discharges_specs, 0..) |spec, i| {
            if (i > 0) code.appendSlice(allocator, ", ") catch unreachable;
            code.appendSlice(allocator, ".{ .obligation_module = \"") catch unreachable;
            code.appendSlice(allocator, spec.obligation_module) catch unreachable;
            code.appendSlice(allocator, "\", .obligation_name = \"") catch unreachable;
            code.appendSlice(allocator, spec.obligation_name) catch unreachable;
            code.appendSlice(allocator, "\", .arg_name = \"") catch unreachable;
            code.appendSlice(allocator, spec.arg_name) catch unreachable;
            code.appendSlice(allocator, "\" }") catch unreachable;
        }
        code.appendSlice(allocator, "}") catch unreachable;

        // Emit branches array (for shape validation)
        code.appendSlice(allocator, ", .branches = &[_]koru_std.koru_runtime.BranchSpec{") catch unreachable;
        for (event.branches, 0..) |branch, bi| {
            if (bi > 0) code.appendSlice(allocator, ", ") catch unreachable;
            code.appendSlice(allocator, ".{ .name = \"") catch unreachable;
            code.appendSlice(allocator, branch.name) catch unreachable;
            code.appendSlice(allocator, "\", .fields = &[_]koru_std.koru_runtime.BranchField{") catch unreachable;
            for (branch.fields, 0..) |field, fi| {
                if (fi > 0) code.appendSlice(allocator, ", ") catch unreachable;
                code.appendSlice(allocator, ".{ .name = \"") catch unreachable;
                code.appendSlice(allocator, field.name) catch unreachable;
                code.appendSlice(allocator, "\", .type_name = \"") catch unreachable;
                code.appendSlice(allocator, field.type_name) catch unreachable;
                code.appendSlice(allocator, "\", .is_optional = ") catch unreachable;
                code.appendSlice(allocator, if (field.is_optional) "true" else "false") catch unreachable;
                code.appendSlice(allocator, " }") catch unreachable;
            }
            code.appendSlice(allocator, "}, .is_optional = ") catch unreachable;
            code.appendSlice(allocator, if (branch.is_optional) "true" else "false") catch unreachable;
            code.appendSlice(allocator, " }") catch unreachable;
        }
        code.appendSlice(allocator, "}") catch unreachable;

        // Emit input_fields array — the event's argument vocabulary, carrying
        // the possession phantoms (`!open`) a caller must honor. This is what
        // lets a running program tell a model what `open(path: ...)` and
        // `append(handle: ...<!open>)` actually take.
        code.appendSlice(allocator, ", .input_fields = &[_]koru_std.koru_runtime.InputFieldSpec{") catch unreachable;
        for (event.input_fields, 0..) |field, fi| {
            if (fi > 0) code.appendSlice(allocator, ", ") catch unreachable;
            code.appendSlice(allocator, ".{ .name = \"") catch unreachable;
            code.appendSlice(allocator, field.name) catch unreachable;
            code.appendSlice(allocator, "\", .type_name = \"") catch unreachable;
            code.appendSlice(allocator, field.type_name) catch unreachable;
            code.appendSlice(allocator, "\", .is_optional = ") catch unreachable;
            code.appendSlice(allocator, if (field.is_optional) "true" else "false") catch unreachable;
            code.appendSlice(allocator, ", .phantom = ") catch unreachable;
            if (field.phantom) |p| {
                code.appendSlice(allocator, "\"") catch unreachable;
                code.appendSlice(allocator, p) catch unreachable;
                code.appendSlice(allocator, "\"") catch unreachable;
            } else {
                code.appendSlice(allocator, "null") catch unreachable;
            }
            code.appendSlice(allocator, " }") catch unreachable;
        }
        code.appendSlice(allocator, "}") catch unreachable;

        code.appendSlice(allocator, ", .dispatcher = ") catch unreachable;
        code.appendSlice(allocator, event.dispatch_name) catch unreachable;
        code.appendSlice(allocator, " },\n") catch unreachable;
    }
    code.appendSlice(allocator, I ++ "};\n\n") catch unreachable;

    // Generate cost lookup function
    code.appendSlice(allocator, I ++ "pub fn get_event_cost_") catch unreachable;
    code.appendSlice(allocator, scope_ident) catch unreachable;
    code.appendSlice(allocator, "(event_name: []const u8) u64 {\n") catch unreachable;
    code.appendSlice(allocator, I ++ "    inline for (scope_events_") catch unreachable;
    code.appendSlice(allocator, scope_ident) catch unreachable;
    code.appendSlice(allocator, ") |ev| {\n") catch unreachable;
    code.appendSlice(allocator, I ++ "        if (dispatcher_std.mem.eql(u8, event_name, ev.name)) return ev.cost;\n") catch unreachable;
    code.appendSlice(allocator, I ++ "    }\n") catch unreachable;
    code.appendSlice(allocator, I ++ "    return 1; // Default cost\n") catch unreachable;
    code.appendSlice(allocator, I ++ "}\n\n") catch unreachable;

    // Generate obligation lookup functions (return arrays for multiple obligations)
    code.appendSlice(allocator, I ++ "pub fn get_creates_obligations_") catch unreachable;
    code.appendSlice(allocator, scope_ident) catch unreachable;
    code.appendSlice(allocator, "(event_name: []const u8) []const []const u8 {\n") catch unreachable;
    code.appendSlice(allocator, I ++ "    inline for (scope_events_") catch unreachable;
    code.appendSlice(allocator, scope_ident) catch unreachable;
    code.appendSlice(allocator, ") |ev| {\n") catch unreachable;
    code.appendSlice(allocator, I ++ "        if (dispatcher_std.mem.eql(u8, event_name, ev.name)) return ev.creates_obligations;\n") catch unreachable;
    code.appendSlice(allocator, I ++ "    }\n") catch unreachable;
    code.appendSlice(allocator, I ++ "    return &[_][]const u8{};\n") catch unreachable;
    code.appendSlice(allocator, I ++ "}\n\n") catch unreachable;

    code.appendSlice(allocator, I ++ "pub fn get_discharges_obligations_") catch unreachable;
    code.appendSlice(allocator, scope_ident) catch unreachable;
    code.appendSlice(allocator, "(event_name: []const u8) []const []const u8 {\n") catch unreachable;
    code.appendSlice(allocator, I ++ "    inline for (scope_events_") catch unreachable;
    code.appendSlice(allocator, scope_ident) catch unreachable;
    code.appendSlice(allocator, ") |ev| {\n") catch unreachable;
    code.appendSlice(allocator, I ++ "        if (dispatcher_std.mem.eql(u8, event_name, ev.name)) return ev.discharges_obligations;\n") catch unreachable;
    code.appendSlice(allocator, I ++ "    }\n") catch unreachable;
    code.appendSlice(allocator, I ++ "    return &[_][]const u8{};\n") catch unreachable;
    code.appendSlice(allocator, I ++ "}\n\n") catch unreachable;

    // Generate discharge event lookup (for auto-discharge). An event that
    // RE-ISSUES the obligation it consumes is NOT a discharger: `append`
    // (`<!open> -> <open!>`) hands back another obligation exactly like
    // `tx.exec` does, so calling it releases nothing. The compiled path has
    // excluded that shape since `eventReIssuesObligation`
    // (auto_discharge_inserter.zig); this lookup returned the FIRST match and
    // so handed a bridge a "discharger" that reopened the resource it was asked
    // to let go of — measured in kopium-headless, where the session's hang-up
    // invoked `append` and the file descriptor survived it.
    code.appendSlice(allocator, I ++ "pub fn get_discharge_event_") catch unreachable;
    code.appendSlice(allocator, scope_ident) catch unreachable;
    code.appendSlice(allocator, "(obligation: []const u8) ?[]const u8 {\n") catch unreachable;
    code.appendSlice(allocator, I ++ "    inline for (scope_events_") catch unreachable;
    code.appendSlice(allocator, scope_ident) catch unreachable;
    code.appendSlice(allocator, ") |ev| {\n") catch unreachable;
    code.appendSlice(allocator, I ++ "        var discharges_it = false;\n") catch unreachable;
    code.appendSlice(allocator, I ++ "        for (ev.discharges_obligations) |dis| {\n") catch unreachable;
    code.appendSlice(allocator, I ++ "            if (dispatcher_std.mem.eql(u8, obligation, dis)) { discharges_it = true; break; }\n") catch unreachable;
    code.appendSlice(allocator, I ++ "        }\n") catch unreachable;
    code.appendSlice(allocator, I ++ "        if (discharges_it) {\n") catch unreachable;
    code.appendSlice(allocator, I ++ "            var reissues = false;\n") catch unreachable;
    code.appendSlice(allocator, I ++ "            for (ev.creates_obligations) |cre| {\n") catch unreachable;
    code.appendSlice(allocator, I ++ "                if (dispatcher_std.mem.eql(u8, obligation, cre)) { reissues = true; break; }\n") catch unreachable;
    code.appendSlice(allocator, I ++ "            }\n") catch unreachable;
    code.appendSlice(allocator, I ++ "            if (!reissues) return ev.name;\n") catch unreachable;
    code.appendSlice(allocator, I ++ "        }\n") catch unreachable;
    code.appendSlice(allocator, I ++ "    }\n") catch unreachable;
    code.appendSlice(allocator, I ++ "    return null;\n") catch unreachable;
    code.appendSlice(allocator, I ++ "}\n\n") catch unreachable;

    // Generate creates_spec lookup - returns full specs for handle creation
    code.appendSlice(allocator, I ++ "pub fn get_creates_spec_") catch unreachable;
    code.appendSlice(allocator, scope_ident) catch unreachable;
    code.appendSlice(allocator, "(event_name: []const u8) []const koru_std.koru_runtime.CreateSpec {\n") catch unreachable;
    code.appendSlice(allocator, I ++ "    inline for (scope_events_") catch unreachable;
    code.appendSlice(allocator, scope_ident) catch unreachable;
    code.appendSlice(allocator, ") |ev| {\n") catch unreachable;
    code.appendSlice(allocator, I ++ "        if (dispatcher_std.mem.eql(u8, event_name, ev.name)) return ev.creates_specs;\n") catch unreachable;
    code.appendSlice(allocator, I ++ "    }\n") catch unreachable;
    code.appendSlice(allocator, I ++ "    return &[_]koru_std.koru_runtime.CreateSpec{};\n") catch unreachable;
    code.appendSlice(allocator, I ++ "}\n\n") catch unreachable;

    // Generate discharges_spec lookup - returns full specs for discharge
    code.appendSlice(allocator, I ++ "pub fn get_discharges_spec_") catch unreachable;
    code.appendSlice(allocator, scope_ident) catch unreachable;
    code.appendSlice(allocator, "(event_name: []const u8) []const koru_std.koru_runtime.DischargeSpec {\n") catch unreachable;
    code.appendSlice(allocator, I ++ "    inline for (scope_events_") catch unreachable;
    code.appendSlice(allocator, scope_ident) catch unreachable;
    code.appendSlice(allocator, ") |ev| {\n") catch unreachable;
    code.appendSlice(allocator, I ++ "        if (dispatcher_std.mem.eql(u8, event_name, ev.name)) return ev.discharges_specs;\n") catch unreachable;
    code.appendSlice(allocator, I ++ "    }\n") catch unreachable;
    code.appendSlice(allocator, I ++ "    return &[_]koru_std.koru_runtime.DischargeSpec{};\n") catch unreachable;
    code.appendSlice(allocator, I ++ "}\n\n") catch unreachable;

    // Generate branches lookup - returns branch specs for shape validation
    code.appendSlice(allocator, I ++ "pub fn get_event_branches_") catch unreachable;
    code.appendSlice(allocator, scope_ident) catch unreachable;
    code.appendSlice(allocator, "(event_name: []const u8) []const koru_std.koru_runtime.BranchSpec {\n") catch unreachable;
    code.appendSlice(allocator, I ++ "    inline for (scope_events_") catch unreachable;
    code.appendSlice(allocator, scope_ident) catch unreachable;
    code.appendSlice(allocator, ") |ev| {\n") catch unreachable;
    code.appendSlice(allocator, I ++ "        if (dispatcher_std.mem.eql(u8, event_name, ev.name)) return ev.branches;\n") catch unreachable;
    code.appendSlice(allocator, I ++ "    }\n") catch unreachable;
    code.appendSlice(allocator, I ++ "    return &[_]koru_std.koru_runtime.BranchSpec{};\n") catch unreachable;
    code.appendSlice(allocator, I ++ "}\n\n") catch unreachable;

    // Generate event-name enumeration - returns the scope's whole vocabulary.
    // This is the surface a running program needs to ask a scope what it holds
    // (and hand that to a model as its prompt), which no event-keyed lookup can
    // provide by itself.
    code.appendSlice(allocator, I ++ "const ") catch unreachable;
    code.appendSlice(allocator, scope_ident) catch unreachable;
    code.appendSlice(allocator, "_event_names = blk: {\n") catch unreachable;
    code.appendSlice(allocator, I ++ "    @setEvalBranchQuota(1_000_000);\n") catch unreachable;
    code.appendSlice(allocator, I ++ "    var arr: [scope_events_") catch unreachable;
    code.appendSlice(allocator, scope_ident) catch unreachable;
    code.appendSlice(allocator, ".len][]const u8 = undefined;\n") catch unreachable;
    code.appendSlice(allocator, I ++ "    for (scope_events_") catch unreachable;
    code.appendSlice(allocator, scope_ident) catch unreachable;
    code.appendSlice(allocator, ", 0..) |ev, i| arr[i] = ev.name;\n") catch unreachable;
    code.appendSlice(allocator, I ++ "    break :blk arr;\n") catch unreachable;
    code.appendSlice(allocator, I ++ "};\n") catch unreachable;
    code.appendSlice(allocator, I ++ "pub fn get_events_") catch unreachable;
    code.appendSlice(allocator, scope_ident) catch unreachable;
    code.appendSlice(allocator, "() []const []const u8 {\n") catch unreachable;
    code.appendSlice(allocator, I ++ "    return &") catch unreachable;
    code.appendSlice(allocator, scope_ident) catch unreachable;
    code.appendSlice(allocator, "_event_names;\n") catch unreachable;
    code.appendSlice(allocator, I ++ "}\n\n") catch unreachable;

    // Generate input-field lookup - returns an event's argument vocabulary.
    code.appendSlice(allocator, I ++ "pub fn get_event_input_") catch unreachable;
    code.appendSlice(allocator, scope_ident) catch unreachable;
    code.appendSlice(allocator, "(event_name: []const u8) []const koru_std.koru_runtime.InputFieldSpec {\n") catch unreachable;
    code.appendSlice(allocator, I ++ "    inline for (scope_events_") catch unreachable;
    code.appendSlice(allocator, scope_ident) catch unreachable;
    code.appendSlice(allocator, ") |ev| {\n") catch unreachable;
    code.appendSlice(allocator, I ++ "        if (dispatcher_std.mem.eql(u8, event_name, ev.name)) return ev.input_fields;\n") catch unreachable;
    code.appendSlice(allocator, I ++ "    }\n") catch unreachable;
    code.appendSlice(allocator, I ++ "    return &[_]koru_std.koru_runtime.InputFieldSpec{};\n") catch unreachable;
    code.appendSlice(allocator, I ++ "}\n\n") catch unreachable;

    code.appendSlice(allocator, I ++ "pub const ") catch unreachable;
    code.appendSlice(allocator, scope_ident) catch unreachable;
    code.appendSlice(allocator, "_descriptor: ScopeDescriptor = .{ .name = \"") catch unreachable;
    code.appendSlice(allocator, scope_name) catch unreachable;
    code.appendSlice(allocator, "\", .events = &scope_events_") catch unreachable;
    code.appendSlice(allocator, scope_ident) catch unreachable;
    code.appendSlice(allocator, " };\n") catch unreachable;

    // The scope manifest: the register block minted as DATA, beside the
    // descriptor. Built by the SAME shared producer the explainer and the
    // served JSON use (scopeManifestForScope) — one record, three views, and
    // the contract can never drift from enforcement.
    const scope_manifest = scopeManifestForScope(allocator, program, scope_name, debug_enabled);

    code.appendSlice(allocator, I ++ "pub const ") catch unreachable;
    code.appendSlice(allocator, scope_ident) catch unreachable;
    code.appendSlice(allocator, "_manifest: ScopeManifest = .{ .scope = \"") catch unreachable;
    code.appendSlice(allocator, scope_name) catch unreachable;
    code.appendSlice(allocator, "\", .events = &[_]ManifestEvent{\n") catch unreachable;
    for (scope_manifest.events) |event| {
        code.appendSlice(allocator, I ++ "    .{ .name = \"") catch unreachable;
        code.appendSlice(allocator, event.name) catch unreachable;
        code.appendSlice(allocator, "\", .cost = ") catch unreachable;
        var manifest_cost_buf: [32]u8 = undefined;
        const manifest_cost_str = std.fmt.bufPrint(&manifest_cost_buf, "{d}", .{event.cost}) catch "1";
        code.appendSlice(allocator, manifest_cost_str) catch unreachable;
        code.appendSlice(allocator, ", .home = ") catch unreachable;
        if (event.home) |event_home| {
            code.appendSlice(allocator, "\"") catch unreachable;
            code.appendSlice(allocator, event_home) catch unreachable;
            code.appendSlice(allocator, "\"") catch unreachable;
        } else {
            code.appendSlice(allocator, "null") catch unreachable;
        }

        // Argument vocabulary — the caller's side of the surface.
        code.appendSlice(allocator, ", .args = &[_]ManifestArg{") catch unreachable;
        for (event.args, 0..) |arg_field, ai| {
            if (ai > 0) code.appendSlice(allocator, ", ") catch unreachable;
            code.appendSlice(allocator, ".{ .name = \"") catch unreachable;
            code.appendSlice(allocator, arg_field.name) catch unreachable;
            code.appendSlice(allocator, "\", .type_name = \"") catch unreachable;
            code.appendSlice(allocator, arg_field.type_name) catch unreachable;
            code.appendSlice(allocator, "\", .is_optional = ") catch unreachable;
            code.appendSlice(allocator, if (arg_field.is_optional) "true" else "false") catch unreachable;
            code.appendSlice(allocator, ", .phantom = ") catch unreachable;
            if (arg_field.phantom) |phantom_str| {
                code.appendSlice(allocator, "\"") catch unreachable;
                code.appendSlice(allocator, phantom_str) catch unreachable;
                code.appendSlice(allocator, "\"") catch unreachable;
            } else {
                code.appendSlice(allocator, "null") catch unreachable;
            }
            code.appendSlice(allocator, " }") catch unreachable;
        }
        code.appendSlice(allocator, "}") catch unreachable;

        // Possession: what the event mints.
        code.appendSlice(allocator, ", .creates = &[_]ManifestCreate{") catch unreachable;
        for (event.creates, 0..) |create_spec, ci| {
            if (ci > 0) code.appendSlice(allocator, ", ") catch unreachable;
            code.appendSlice(allocator, ".{ .obligation = \"") catch unreachable;
            code.appendSlice(allocator, create_spec.obligation) catch unreachable;
            code.appendSlice(allocator, "\", .module = \"") catch unreachable;
            code.appendSlice(allocator, create_spec.module) catch unreachable;
            code.appendSlice(allocator, "\", .field = \"") catch unreachable;
            code.appendSlice(allocator, create_spec.field) catch unreachable;
            code.appendSlice(allocator, "\", .resource_type = \"") catch unreachable;
            code.appendSlice(allocator, create_spec.resource_type) catch unreachable;
            code.appendSlice(allocator, "\" }") catch unreachable;
        }
        code.appendSlice(allocator, "}") catch unreachable;

        // Possession: what the event consumes.
        code.appendSlice(allocator, ", .discharges = &[_]ManifestDischarge{") catch unreachable;
        for (event.discharges, 0..) |discharge_spec, di| {
            if (di > 0) code.appendSlice(allocator, ", ") catch unreachable;
            code.appendSlice(allocator, ".{ .obligation = \"") catch unreachable;
            code.appendSlice(allocator, discharge_spec.obligation) catch unreachable;
            code.appendSlice(allocator, "\", .module = \"") catch unreachable;
            code.appendSlice(allocator, discharge_spec.module) catch unreachable;
            code.appendSlice(allocator, "\", .arg = \"") catch unreachable;
            code.appendSlice(allocator, discharge_spec.arg) catch unreachable;
            code.appendSlice(allocator, "\" }") catch unreachable;
        }
        code.appendSlice(allocator, "}") catch unreachable;

        // Output shapes.
        code.appendSlice(allocator, ", .branches = &[_]ManifestBranch{") catch unreachable;
        for (event.branches, 0..) |branch_spec, bi| {
            if (bi > 0) code.appendSlice(allocator, ", ") catch unreachable;
            code.appendSlice(allocator, ".{ .name = \"") catch unreachable;
            code.appendSlice(allocator, branch_spec.name) catch unreachable;
            code.appendSlice(allocator, "\", .fields = &[_]ManifestBranchField{") catch unreachable;
            for (branch_spec.fields, 0..) |branch_field, fi| {
                if (fi > 0) code.appendSlice(allocator, ", ") catch unreachable;
                code.appendSlice(allocator, ".{ .name = \"") catch unreachable;
                code.appendSlice(allocator, branch_field.name) catch unreachable;
                code.appendSlice(allocator, "\", .type_name = \"") catch unreachable;
                code.appendSlice(allocator, branch_field.type_name) catch unreachable;
                code.appendSlice(allocator, "\", .is_optional = ") catch unreachable;
                code.appendSlice(allocator, if (branch_field.is_optional) "true" else "false") catch unreachable;
                code.appendSlice(allocator, " }") catch unreachable;
            }
            code.appendSlice(allocator, "}, .is_optional = ") catch unreachable;
            code.appendSlice(allocator, if (branch_spec.is_optional) "true" else "false") catch unreachable;
            code.appendSlice(allocator, " }") catch unreachable;
        }
        code.appendSlice(allocator, "} },\n") catch unreachable;
    }
    code.appendSlice(allocator, I ++ "},\n") catch unreachable;
    code.appendSlice(allocator, I ++ "    .includes = &[_][]const u8{") catch unreachable;
    for (scope_manifest.includes, 0..) |inc, ii| {
        if (ii > 0) code.appendSlice(allocator, ", ") catch unreachable;
        code.appendSlice(allocator, "\"") catch unreachable;
        code.appendSlice(allocator, inc) catch unreachable;
        code.appendSlice(allocator, "\"") catch unreachable;
    }
    code.appendSlice(allocator, "}\n") catch unreachable;
    code.appendSlice(allocator, I ++ "};\n\n") catch unreachable;

    code.appendSlice(allocator, I ++ "pub fn dispatch_") catch unreachable;
    code.appendSlice(allocator, scope_ident) catch unreachable;
    code.appendSlice(allocator, "(inv: *const dispatcher_ast.Invocation, out: *koru_std.koru_runtime.DispatchResult) !void {\n") catch unreachable;
    code.appendSlice(allocator, I ++ "    var name_buf: [256]u8 = undefined;\n") catch unreachable;
    code.appendSlice(allocator, I ++ "    var name_len: usize = 0;\n") catch unreachable;
    code.appendSlice(allocator, I ++ "    if (inv.path.module_qualifier) |mq| {\n") catch unreachable;
    code.appendSlice(allocator, I ++ "        @memcpy(name_buf[name_len..][0..mq.len], mq);\n") catch unreachable;
    code.appendSlice(allocator, I ++ "        name_len += mq.len;\n") catch unreachable;
    code.appendSlice(allocator, I ++ "        name_buf[name_len] = ':';\n") catch unreachable;
    code.appendSlice(allocator, I ++ "        name_len += 1;\n") catch unreachable;
    code.appendSlice(allocator, I ++ "    }\n") catch unreachable;
    code.appendSlice(allocator, I ++ "    for (inv.path.segments, 0..) |seg, i| {\n") catch unreachable;
    code.appendSlice(allocator, I ++ "        if (i > 0) { name_buf[name_len] = '.'; name_len += 1; }\n") catch unreachable;
    code.appendSlice(allocator, I ++ "        @memcpy(name_buf[name_len..][0..seg.len], seg);\n") catch unreachable;
    code.appendSlice(allocator, I ++ "        name_len += seg.len;\n") catch unreachable;
    code.appendSlice(allocator, I ++ "    }\n") catch unreachable;
    code.appendSlice(allocator, I ++ "    const event_name = name_buf[0..name_len];\n") catch unreachable;
    code.appendSlice(allocator, I ++ "    inline for (scope_events_") catch unreachable;
    code.appendSlice(allocator, scope_ident) catch unreachable;
    code.appendSlice(allocator, ") |ev| {\n") catch unreachable;
    code.appendSlice(allocator, I ++ "        if (dispatcher_std.mem.eql(u8, event_name, ev.name)) {\n") catch unreachable;
    code.appendSlice(allocator, I ++ "            return ev.dispatcher(inv, out);\n") catch unreachable;
    code.appendSlice(allocator, I ++ "        }\n") catch unreachable;
    code.appendSlice(allocator, I ++ "    }\n") catch unreachable;
    code.appendSlice(allocator, I ++ "    return error.EventDenied;\n") catch unreachable;
    code.appendSlice(allocator, I ++ "}\n") catch unreachable;

    const generated_code = code.toOwnedSlice(allocator) catch unreachable;
    std.debug.print("[REGISTRY] Generated {d} bytes\n", .{generated_code.len});

    // Replace this flow with generated code
    const new_item = ast_reg.Item{
        .host_line = .{
            .content = generated_code,
            .location = .{ .file = "runtime:register", .line = 0, .column = 0 },
            .module = module_name,
        },
    };

    return .{ .replacement = new_item };
}

// ============================================================================
// GET SCOPE - Runtime event to look up a scope's dispatcher
// ============================================================================

// Use interpreter's types to ensure compatibility
// At runtime, koru_std.koru_interpreter is available via root import
pub const DispatchResult = @import("root").koru_std.koru_interpreter.DispatchResult;
pub const DispatchFn = @import("root").koru_std.koru_interpreter.DispatchFn;
pub const CostFn = @import("root").koru_std.koru_interpreter.CostFn;
pub const ObligationsArrayFn = @import("root").koru_std.koru_interpreter.ObligationsArrayFn;
pub const DischargeEventFn = @import("root").koru_std.koru_interpreter.DischargeEventFn;
pub const FieldValue = @import("root").koru_std.koru_interpreter.FieldValue;
pub const NamedField = @import("root").koru_std.koru_interpreter.NamedField;
// Import spec types from interpreter
pub const CreateSpec = @import("root").koru_std.koru_interpreter.CreateSpec;
pub const DischargeSpec = @import("root").koru_std.koru_interpreter.DischargeSpec;
pub const CreatesSpecFn = @import("root").koru_std.koru_interpreter.CreatesSpecFn;
pub const DischargesSpecFn = @import("root").koru_std.koru_interpreter.DischargesSpecFn;

// Branch field metadata for shape validation
pub const BranchField = struct {
    name: []const u8,
    type_name: []const u8,
    is_optional: bool = false,
};

// Branch metadata for shape validation
pub const BranchSpec = struct {
    name: []const u8,
    fields: []const BranchField,
    is_optional: bool = false,
};

// Input-field metadata — the argument vocabulary of an event, what a caller
// must NAME when invoking it. Carries the raw possession phantom (`!open`
// discharges, `open!` creates) so the vocabulary is renderable as
// `handle: string<!open>` — the exact spelling the scope enforces.
pub const InputFieldSpec = struct {
    name: []const u8,
    type_name: []const u8,
    is_optional: bool = false,
    phantom: ?[]const u8 = null,
};

pub const ScopeEvent = struct {
    name: []const u8,
    cost: u64,  // Budget cost for this event
    creates_obligations: []const []const u8,    // Legacy: just obligation names
    discharges_obligations: []const []const u8, // Legacy: just obligation names
    creates_specs: []const CreateSpec,          // Full specs with field names
    discharges_specs: []const DischargeSpec,    // Full specs with arg names
    branches: []const BranchSpec = &.{},        // Branch specs for shape validation
    input_fields: []const InputFieldSpec = &.{}, // Input/argument vocabulary
    dispatcher: DispatchFn,
};
pub const ScopeDescriptor = struct {
    name: []const u8,
    events: []const ScopeEvent,
};

// Branches lookup function type for shape validation
pub const BranchesLookupFn = *const fn([]const u8) []const BranchSpec;
// Event-name enumeration type — the scope's whole vocabulary, order-preserving
pub const EventsLookupFn = *const fn() []const []const u8;
// Input-field lookup type — an event's argument vocabulary
pub const InputLookupFn = *const fn([]const u8) []const InputFieldSpec;

pub const ScopeRuntime = struct {
    name: []const u8,
    dispatcher: DispatchFn,
    cost_fn: ?CostFn,
    creates_obligations_fn: ?ObligationsArrayFn,
    discharges_obligations_fn: ?ObligationsArrayFn,
    discharge_event_fn: ?DischargeEventFn,
    // Full spec lookups with field/arg names
    creates_spec_fn: ?CreatesSpecFn,
    discharges_spec_fn: ?DischargesSpecFn,
    // Branch specs for shape validation
    branches_fn: ?BranchesLookupFn,
    // Vocabulary enumeration: event names + per-event input/arg fields
    events_fn: ?EventsLookupFn,
    input_fn: ?InputLookupFn,
    // The scope's manifest record — minted at scope creation (register) from
    // the same EventEntry data the dispatch tables are emitted from. null
    // never occurs for a descriptor register built: the two are emitted side
    // by side. Defined flows (session growth) are absent by construction.
    manifest: ?*const ScopeManifest = null,
};

// ============================================================================
// SCOPE MANIFEST - the vocabulary minted as a data structure at scope creation
// ============================================================================
//
// `register` reshapes the EventEntry records it emits dispatch tables from
// into this record and embeds it beside the descriptor. One minting, many
// served views: the `scope-manifest` tor serializes it to JSON for a running
// contract endpoint (Orisha), `explain` will consume the same record at
// compile time, and neither view is ever hand-written. Defined flows (session
// growth) are absent by construction: the record is minted when the scope is
// created, before any session exists — it is the compiled base.

/// One event's argument — the caller's side of the surface.
pub const ManifestArg = struct {
    name: []const u8,
    type_name: []const u8,
    is_optional: bool = false,
    /// Raw possession spelling: `"!open"` discharges, `"open!"` creates.
    phantom: ?[]const u8 = null,
};

/// An obligation an event MINTS — carried by an output field (or
/// `__type_ref` for a bare return). Fields mirror CreateSpec so the contract
/// and the enforcement are the same bytes.
pub const ManifestCreate = struct {
    obligation: []const u8,
    module: []const u8,
    field: []const u8,
    resource_type: []const u8,
};

/// An obligation an event CONSUMES — discharged by a named input arg.
pub const ManifestDischarge = struct {
    obligation: []const u8,
    module: []const u8,
    arg: []const u8,
};

/// An output branch's payload field.
pub const ManifestBranchField = struct {
    name: []const u8,
    type_name: []const u8,
    is_optional: bool = false,
};

/// An output branch ("shape") an event can end in.
pub const ManifestBranch = struct {
    name: []const u8,
    fields: []const ManifestBranchField = &.{},
    is_optional: bool = false,
};

/// One surface verb: what it takes, what it mints, what it consumes.
pub const ManifestEvent = struct {
    name: []const u8,
    cost: u64 = 1,
    /// Module that DECLARED the event (the home that closes the bare-name
    /// gap), or null for a top-level event.
    home: ?[]const u8 = null,
    args: []const ManifestArg = &.{},
    creates: []const ManifestCreate = &.{},
    discharges: []const ManifestDischarge = &.{},
    branches: []const ManifestBranch = &.{},
};

/// The served contract for one scope: the register block as data.
pub const ScopeManifest = struct {
    kind: []const u8 = "koru/scope-manifest",
    version: u32 = 1,
    scope: []const u8,
    events: []const ManifestEvent = &.{},
    /// Direct `scope(other)` includes named in THIS register block, in
    /// declaration order. Transitive closures stay implicit.
    includes: []const []const u8 = &.{},
};

fn mangleScopeName(comptime name: []const u8) []const u8 {
    if (name.len == 0) return "";
    comptime var buf: [name.len]u8 = undefined;
    inline for (name, 0..) |c, i| {
        const is_alnum = (c >= 'a' and c <= 'z') or
            (c >= 'A' and c <= 'Z') or
            (c >= '0' and c <= '9') or
            (c == '_');
        buf[i] = if (is_alnum) c else '_';
    }
    return buf[0..];
}

/// Every namespace a generated scope registry can live in: the root itself,
/// its struct declarations, and theirs — `main_module`, `koru_app`, and
/// `koru_app.koru_lib`, two levels being exactly the depth the emitter nests
/// a dotted module name to.
///
/// A `register` written inside a library emits its descriptor and dispatcher
/// BESIDE the events they name, which is the only place they can be: Zig gives
/// a sibling struct no path to the entry struct, so the dispatcher has to sit
/// where it can reach `koru_app.koru_lib.expensive_event`. A table built from
/// `main_module` alone therefore found nothing — and found nothing SILENTLY.
/// The program compiled, ran, and took its `| scope-not-found` arm: a
/// well-formed answer built on an empty registry, which is the one failure
/// shape on this boundary with no compile step left to fail in (115_036).
fn scopeNamespaces() []const type {
    // The walk is O(declarations in the whole program), and Zig's default
    // budget is 1000 backwards branches. A program that links enough — vaxis
    // plus curl plus yyjson plus sse was the case that found this — blows it
    // and fails with "evaluation exceeded 1000 backwards branches" pointing at
    // generated code, saying nothing about scopes or `register`. The quota is
    // a compile-time-only cost and nothing here is recursive without bound:
    // `collectNamespaces` is depth-limited to 2.
    @setEvalBranchQuota(1_000_000);
    return collectNamespaces(@import("root"), 2, &[_]type{});
}

fn collectNamespaces(comptime C: type, comptime depth: usize, comptime acc: []const type) []const type {
    comptime var out: []const type = acc ++ &[_]type{C};
    if (depth == 0) return out;
    inline for (std.meta.declarations(C)) |d| {
        const V = @field(C, d.name);
        if (@TypeOf(V) != type) continue;
        if (@typeInfo(V) != .@"struct") continue;
        out = collectNamespaces(V, depth - 1, out);
    }
    return out;
}

fn buildScopeTable() []const ScopeRuntime {
    @setEvalBranchQuota(1_000_000);
    comptime var count: usize = 0;
    inline for (comptime scopeNamespaces()) |NS| {
        inline for (std.meta.declarations(NS)) |decl| {
            if (!std.mem.endsWith(u8, decl.name, "_descriptor")) continue;
            const decl_value = @field(NS, decl.name);
            if (@TypeOf(decl_value) != ScopeDescriptor) continue;
            const scope_ident = mangleScopeName(decl_value.name);
            const dispatch_name = std.fmt.comptimePrint("dispatch_{s}", .{scope_ident});
            if (!@hasDecl(NS, dispatch_name)) continue;
            count += 1;
        }
    }

    var table: [count]ScopeRuntime = undefined;
    comptime var i: usize = 0;
    inline for (comptime scopeNamespaces()) |NS| {
        inline for (std.meta.declarations(NS)) |decl| {
            if (!std.mem.endsWith(u8, decl.name, "_descriptor")) continue;
            const decl_value = @field(NS, decl.name);
            if (@TypeOf(decl_value) != ScopeDescriptor) continue;
            const desc = decl_value;
            const scope_ident = mangleScopeName(desc.name);
            const dispatch_name = std.fmt.comptimePrint("dispatch_{s}", .{scope_ident});
            if (!@hasDecl(NS, dispatch_name)) continue;

            const cost_name = std.fmt.comptimePrint("get_event_cost_{s}", .{scope_ident});
            const creates_name = std.fmt.comptimePrint("get_creates_obligations_{s}", .{scope_ident});
            const discharges_name = std.fmt.comptimePrint("get_discharges_obligations_{s}", .{scope_ident});
            const discharge_event_name = std.fmt.comptimePrint("get_discharge_event_{s}", .{scope_ident});
            const creates_spec_name = std.fmt.comptimePrint("get_creates_spec_{s}", .{scope_ident});
            const discharges_spec_name = std.fmt.comptimePrint("get_discharges_spec_{s}", .{scope_ident});
            const branches_name = std.fmt.comptimePrint("get_event_branches_{s}", .{scope_ident});
            const events_name = std.fmt.comptimePrint("get_events_{s}", .{scope_ident});
            const input_name = std.fmt.comptimePrint("get_event_input_{s}", .{scope_ident});
            const manifest_name = std.fmt.comptimePrint("{s}_manifest", .{scope_ident});

            table[i] = .{
                .name = desc.name,
                .dispatcher = &@field(NS, dispatch_name),
                .cost_fn = if (@hasDecl(NS, cost_name)) &@field(NS, cost_name) else null,
                .creates_obligations_fn = if (@hasDecl(NS, creates_name)) &@field(NS, creates_name) else null,
                .discharges_obligations_fn = if (@hasDecl(NS, discharges_name)) &@field(NS, discharges_name) else null,
                .discharge_event_fn = if (@hasDecl(NS, discharge_event_name)) &@field(NS, discharge_event_name) else null,
                .creates_spec_fn = if (@hasDecl(NS, creates_spec_name)) &@field(NS, creates_spec_name) else null,
                .discharges_spec_fn = if (@hasDecl(NS, discharges_spec_name)) &@field(NS, discharges_spec_name) else null,
                .branches_fn = if (@hasDecl(NS, branches_name)) &@field(NS, branches_name) else null,
                .events_fn = if (@hasDecl(NS, events_name)) &@field(NS, events_name) else null,
                .input_fn = if (@hasDecl(NS, input_name)) &@field(NS, input_name) else null,
                .manifest = if (@hasDecl(NS, manifest_name)) &@field(NS, manifest_name) else null,
            };
            i += 1;
        }
    }

    return table[0..];
}

~[retain]pub tor get-scope { name: string }
| scope {
    dispatcher: DispatchFn,
    cost_fn: ?CostFn,
    creates_obligations_fn: ?ObligationsArrayFn,
    discharges_obligations_fn: ?ObligationsArrayFn,
    discharge_event_fn: ?DischargeEventFn,
    creates_spec_fn: ?CreatesSpecFn,
    discharges_spec_fn: ?DischargesSpecFn,
    events_fn: ?EventsLookupFn,
    input_fn: ?InputLookupFn
}
| not-found

// Look up scope dispatcher by name
// Dispatchers are generated into main_module with naming convention: dispatch_<scope>
~proc get-scope|zig {
    inline for (comptime buildScopeTable()) |scope_info| {
        if (std.mem.eql(u8, name, scope_info.name)) {
            return .{ .scope = .{
                .dispatcher = scope_info.dispatcher,
                .cost_fn = scope_info.cost_fn,
                .creates_obligations_fn = scope_info.creates_obligations_fn,
                .discharges_obligations_fn = scope_info.discharges_obligations_fn,
                .discharge_event_fn = scope_info.discharge_event_fn,
                .creates_spec_fn = scope_info.creates_spec_fn,
                .discharges_spec_fn = scope_info.discharges_spec_fn,
                .events_fn = scope_info.events_fn,
                .input_fn = scope_info.input_fn,
            } };
        }
    }
    return .{ .not_found = .{} };
}

// ============================================================================
// SCOPE-VOCABULARY - Render a scope's vocabulary for an external reader
// ============================================================================
//
// The whole point of the enumeration surface: a model driving this interpreter
// must be told, accurately, what it may call — and that description must come
// from the register declaration, not a hand-typed script that can drift. This
// renders exactly the surface the register block enforces, as one line per
// event with its named arguments and possession phantoms:
//
//   open(path: string)
//   append(handle: string<!open>, text: string)
//   close(handle: string<!open>)
//   say(text: string)
//
// No JSON schema, no second source of truth: the prompt and the enforcement
// are the same bytes.

// @retain: scope_vocabulary_event is referenced from generated Zig code in user
// pipelines (std/bridge:vocabulary compiles to scope_vocabulary_event.handler).
~[retain]pub tor scope-vocabulary { name: string }
| ok string
| not-found

~proc scope-vocabulary|zig {
    // A local arena over page_allocator — the same substrate the interpreter's
    // own arena and its message dupes use. ArrayList growth here allocates
    // fresh chunks (arena realloc resolves to alloc+copy, which works in this
    // binary; direct realloc-based growth OOMs). The arena is intentionally
    // never freed: the returned string must outlive this call, and a few pages
    // per vocabulary render are tolerated exactly like parse-error messages.
    var arena_state = std.heap.ArenaAllocator.init(std.heap.page_allocator);
    const allocator = arena_state.allocator();
    var out = std.ArrayList(u8).initCapacity(allocator, 256) catch unreachable;

    inline for (comptime buildScopeTable()) |scope_info| {
        if (std.mem.eql(u8, name, scope_info.name)) {
            const events = scope_info.events_fn.?();
            for (events) |event_name| {
                if (out.items.len > 0) out.append(allocator, '\n') catch unreachable;
                out.appendSlice(allocator, event_name) catch unreachable;
                out.append(allocator, '(') catch unreachable;
                const input = if (scope_info.input_fn) |f| f(event_name) else &.{};
                for (input, 0..) |field, i| {
                    if (i > 0) out.appendSlice(allocator, ", ") catch unreachable;
                    out.appendSlice(allocator, field.name) catch unreachable;
                    out.appendSlice(allocator, ": ") catch unreachable;
                    out.appendSlice(allocator, field.type_name) catch unreachable;
                    if (field.phantom) |p| {
                        out.append(allocator, '<') catch unreachable;
                        out.appendSlice(allocator, p) catch unreachable;
                        out.append(allocator, '>') catch unreachable;
                    }
                }
                out.append(allocator, ')') catch unreachable;
            }
            return .{ .ok = out.toOwnedSlice(allocator) catch unreachable };
        }
    }
    return .{ .not_found = .{} };
}

// ============================================================================
// SCOPE-MANIFEST - Serve a scope's vocabulary as a data contract (JSON)
// ============================================================================
//
// The manifest record is minted at scope creation (register) from the same
// EventEntry data the dispatch tables are emitted from; this tor serializes
// it to JSON so a running program can serve it as a contract endpoint
// (Orisha) or hand it to a tool. The emitted JSON has no hand-authored bytes:
// every field derives from the scope declaration, so the served contract and
// the enforcement cannot drift. Defined flows (session growth) are NOT part
// of this record — it is the compiled base, minted before any session exists.

// @retain: scope_manifest_event is referenced from generated Zig code in user
// pipelines (Orisha serves it as the .json endpoint; explain consumes it).
~[retain]pub tor scope-manifest { name: string }
| ok string
| not-found

~proc scope-manifest|zig {
    inline for (comptime buildScopeTable()) |scope_info| {
        if (std.mem.eql(u8, name, scope_info.name)) {
            const m = scope_info.manifest orelse {
                std.debug.print("[RUNTIME] scope '{s}' has no manifest record\n", .{name});
                return .{ .not_found = .{} };
            };
            var arena_state = std.heap.ArenaAllocator.init(std.heap.page_allocator);
            const allocator = arena_state.allocator();
            const json = scopeManifestToJson(allocator, m) catch return .{ .not_found = .{} };
            return .{ .ok = json };
        }
    }
    return .{ .not_found = .{} };
}

// ============================================================================
// EXPLAIN-RUNTIME - the `[explainer]` for the scope registry
// ============================================================================
//
// koruc's `koru_explain_gather` calls every discovered `[explainer]` once with
// the program AST; the `explain` command renders whatever this returns. This
// explainer builds every registered scope's manifest through the SAME shared
// producer (`scopeManifestForScope`) the register emission uses, then reports:
// a note (the human vocabulary lines) plus a `manifest` property carrying the
// EXACT JSON the `scope-manifest` tor serves — so `explain` shows the served
// contract bytes, never a hand-written copy.

// @retain: explain_runtime_event is referenced from generated code (koruc's
// koru_explain_gather invokes every discovered [explainer]).
~[comptime|explainer]pub tor explain-runtime {
    program: *const ast.Program,
    allocator: std.mem.Allocator
} -> ExplainReport

~proc explain-runtime|zig {
    const ast_mod = @import("ast");
    const CompilerEnvRt = @import("root").CompilerEnv;
    const debug_enabled = CompilerEnvRt.hasFlag("debug");

    const scope_defs = RegistryHelper.collectScopeDefs(allocator, program);
    var names = std.ArrayList([]const u8){ .items = &.{}, .capacity = 0 };
    for (scope_defs) |def| {
        var dup = false;
        for (names.items) |n| if (std.mem.eql(u8, n, def.name)) {
            dup = true;
            break;
        };
        if (!dup) names.append(allocator, def.name) catch continue;
    }

    if (names.items.len == 0) {
        var entries = std.ArrayList(ast_mod.ExplainReport.Entry){ .items = &.{}, .capacity = 0 };
        entries.append(allocator, .{ .note = "no scopes registered — declare one with std/runtime:register(scope: \"...\") { open(1) close(1) }" }) catch {};
        var sections = std.ArrayList(ast_mod.ExplainReport.Section){ .items = &.{}, .capacity = 0 };
        sections.append(allocator, .{ .heading = "scopes", .entries = entries.toOwnedSlice(allocator) catch &.{} }) catch {};
        return .{ .title = "std/runtime", .sections = sections.toOwnedSlice(allocator) catch &.{} };
    }

    var sections = std.ArrayList(ast_mod.ExplainReport.Section){ .items = &.{}, .capacity = 0 };
    for (names.items) |name| {
        const manifest = scopeManifestForScope(allocator, program, name, debug_enabled);
        const text = scopeManifestToText(allocator, &manifest);
        const json = scopeManifestToJson(allocator, &manifest) catch "";

        var entries = std.ArrayList(ast_mod.ExplainReport.Entry){ .items = &.{}, .capacity = 0 };
        entries.append(allocator, .{ .note = text }) catch continue;
        entries.append(allocator, .{ .property = .{ .key = "manifest", .value = .{ .string = json } } }) catch continue;

        sections.append(allocator, .{
            .heading = name,
            .entries = entries.toOwnedSlice(allocator) catch &.{},
        }) catch continue;
    }

    return .{
        .title = "std/runtime",
        .sections = sections.toOwnedSlice(allocator) catch &.{},
    };
}

fn jsonAppendString(out: *std.ArrayList(u8), alloc: std.mem.Allocator, s: []const u8) void {
    // Identifiers, module paths and obligation names cannot carry quotes or
    // control bytes in Koru; the escape keeps caller-supplied scope names
    // honest anyway (the only string in the manifest not shaped by the
    // language).
    out.append(alloc, '"') catch return;
    for (s) |c| {
        switch (c) {
            '"' => out.appendSlice(alloc, "\\\"") catch return,
            '\\' => out.appendSlice(alloc, "\\\\") catch return,
            // All control bytes escape as \u — including \t/\n/\r, which the
            // (valid, but longer) named forms would overlap in switch terms.
            0...0x1f => |cc| {
                var buf: [7]u8 = undefined;
                const code = std.fmt.bufPrint(&buf, "\\u{x:0>4}", .{cc}) catch continue;
                out.appendSlice(alloc, code) catch return;
            },
            else => out.append(alloc, c) catch return,
        }
    }
    out.append(alloc, '"') catch return;
}

fn jsonAppendNumber(out: *std.ArrayList(u8), alloc: std.mem.Allocator, n: anytype) void {
    var buf: [32]u8 = undefined;
    const s = std.fmt.bufPrint(&buf, "{d}", .{n}) catch return;
    out.appendSlice(alloc, s) catch return;
}

/// Serialize a scope manifest to JSON. The record is the contract; this is
/// one projection of it (the `explain` host and the Orisha endpoint consume
/// the same record — or this same function — never a hand-written copy).
fn scopeManifestToJson(alloc: std.mem.Allocator, m: *const ScopeManifest) ![]const u8 {
    var out = std.ArrayList(u8).initCapacity(alloc, 512) catch return error.OutOfMemory;

    try out.appendSlice(alloc, "{");
    try out.appendSlice(alloc, "\"kind\":"); jsonAppendString(&out, alloc, m.kind);
    try out.appendSlice(alloc, ",\"version\":"); jsonAppendNumber(&out, alloc, m.version);
    try out.appendSlice(alloc, ",\"scope\":"); jsonAppendString(&out, alloc, m.scope);

    try out.appendSlice(alloc, ",\"events\":[");
    for (m.events, 0..) |ev, i| {
        if (i > 0) try out.append(alloc, ',');
        try out.append(alloc, '{');
        try out.appendSlice(alloc, "\"name\":"); jsonAppendString(&out, alloc, ev.name);
        try out.appendSlice(alloc, ",\"cost\":"); jsonAppendNumber(&out, alloc, ev.cost);
        try out.appendSlice(alloc, ",\"home\":");
        if (ev.home) |h| jsonAppendString(&out, alloc, h) else try out.appendSlice(alloc, "null");
        try out.appendSlice(alloc, ",\"args\":[");
        for (ev.args, 0..) |arg, ai| {
            if (ai > 0) try out.append(alloc, ',');
            try out.append(alloc, '{');
            try out.appendSlice(alloc, "\"name\":"); jsonAppendString(&out, alloc, arg.name);
            try out.appendSlice(alloc, ",\"type\":"); jsonAppendString(&out, alloc, arg.type_name);
            try out.appendSlice(alloc, ",\"optional\":"); if (arg.is_optional) try out.appendSlice(alloc, "true") else try out.appendSlice(alloc, "false");
            try out.appendSlice(alloc, ",\"phantom\":");
            if (arg.phantom) |p| jsonAppendString(&out, alloc, p) else try out.appendSlice(alloc, "null");
            try out.append(alloc, '}');
        }
        try out.append(alloc, ']');
        try out.appendSlice(alloc, ",\"creates\":[");
        for (ev.creates, 0..) |create, ci| {
            if (ci > 0) try out.append(alloc, ',');
            try out.append(alloc, '{');
            try out.appendSlice(alloc, "\"obligation\":"); jsonAppendString(&out, alloc, create.obligation);
            try out.appendSlice(alloc, ",\"module\":"); jsonAppendString(&out, alloc, create.module);
            try out.appendSlice(alloc, ",\"field\":"); jsonAppendString(&out, alloc, create.field);
            try out.appendSlice(alloc, ",\"resource_type\":"); jsonAppendString(&out, alloc, create.resource_type);
            try out.append(alloc, '}');
        }
        try out.append(alloc, ']');
        try out.appendSlice(alloc, ",\"discharges\":[");
        for (ev.discharges, 0..) |discharge, di| {
            if (di > 0) try out.append(alloc, ',');
            try out.append(alloc, '{');
            try out.appendSlice(alloc, "\"obligation\":"); jsonAppendString(&out, alloc, discharge.obligation);
            try out.appendSlice(alloc, ",\"module\":"); jsonAppendString(&out, alloc, discharge.module);
            try out.appendSlice(alloc, ",\"arg\":"); jsonAppendString(&out, alloc, discharge.arg);
            try out.append(alloc, '}');
        }
        try out.append(alloc, ']');
        try out.appendSlice(alloc, ",\"branches\":[");
        for (ev.branches, 0..) |branch, bi| {
            if (bi > 0) try out.append(alloc, ',');
            try out.append(alloc, '{');
            try out.appendSlice(alloc, "\"name\":"); jsonAppendString(&out, alloc, branch.name);
            try out.appendSlice(alloc, ",\"optional\":"); if (branch.is_optional) try out.appendSlice(alloc, "true") else try out.appendSlice(alloc, "false");
            try out.appendSlice(alloc, ",\"fields\":[");
            for (branch.fields, 0..) |bf, fi| {
                if (fi > 0) try out.append(alloc, ',');
                try out.append(alloc, '{');
                try out.appendSlice(alloc, "\"name\":"); jsonAppendString(&out, alloc, bf.name);
                try out.appendSlice(alloc, ",\"type\":"); jsonAppendString(&out, alloc, bf.type_name);
                try out.appendSlice(alloc, ",\"optional\":"); if (bf.is_optional) try out.appendSlice(alloc, "true") else try out.appendSlice(alloc, "false");
                try out.append(alloc, '}');
            }
            try out.append(alloc, ']');
            try out.append(alloc, '}');
        }
        try out.append(alloc, ']');
        try out.append(alloc, '}');
    }
    try out.appendSlice(alloc, "],\"includes\":[");
    for (m.includes, 0..) |inc, ii| {
        if (ii > 0) try out.append(alloc, ',');
        jsonAppendString(&out, alloc, inc);
    }
    try out.appendSlice(alloc, "]}");
    return out.toOwnedSlice(alloc);
}

/// Build ONE scope's manifest record from the program AST — the shared
/// producer. `register` walks the returned record to emit its embedded const;
/// the `[explainer]` renders it. Both derive from the same lifted RegistryHelper
/// + extraction machinery as the dispatch tables, so the record can never drift
/// from what is actually enforced.
pub fn scopeManifestForScope(
    alloc: std.mem.Allocator,
    program: *const ast.Program,
    scope_name: []const u8,
    debug_enabled: bool,
) ScopeManifest {
    const event_infos = RegistryHelper.collectEventInfos(alloc, program);
    const scope_defs = RegistryHelper.collectScopeDefs(alloc, program);

    var resolved_events = std.ArrayList(ResolvedEvent){ .items = &.{}, .capacity = 0 };
    var visited = std.StringHashMap(void).init(alloc);
    RegistryHelper.resolveScope(alloc, scope_defs, event_infos, scope_name, debug_enabled, &visited, &resolved_events);

    var events = std.ArrayList(ManifestEvent){ .items = &.{}, .capacity = 0 };
    for (resolved_events.items) |resolved| {
        const lookup_name = resolved.internal_name orelse resolved.name;
        const info = RegistryHelper.findEventInfoHomed(alloc, event_infos, lookup_name, resolved.home) orelse continue;
        const obligations = extractObligations(alloc, info.event_decl, info.module_name);
        const branches = extractBranches(alloc, info.event_decl);
        const input_fields = extractInputFields(alloc, info.event_decl);

        var args = std.ArrayList(ManifestArg){ .items = &.{}, .capacity = 0 };
        for (input_fields) |f| args.append(alloc, .{
            .name = f.name, .type_name = f.type_name, .is_optional = f.is_optional, .phantom = f.phantom,
        }) catch continue;
        var creates = std.ArrayList(ManifestCreate){ .items = &.{}, .capacity = 0 };
        for (obligations.creates_specs) |spec| creates.append(alloc, .{
            .obligation = spec.obligation_name, .module = spec.obligation_module, .field = spec.field_name, .resource_type = spec.resource_type,
        }) catch continue;
        var discharges = std.ArrayList(ManifestDischarge){ .items = &.{}, .capacity = 0 };
        for (obligations.discharges_specs) |spec| discharges.append(alloc, .{
            .obligation = spec.obligation_name, .module = spec.obligation_module, .arg = spec.arg_name,
        }) catch continue;
        var branch_records = std.ArrayList(ManifestBranch){ .items = &.{}, .capacity = 0 };
        for (branches) |spec| {
            var fields = std.ArrayList(ManifestBranchField){ .items = &.{}, .capacity = 0 };
            for (spec.fields) |f| fields.append(alloc, .{
                .name = f.name, .type_name = f.type_name, .is_optional = f.is_optional,
            }) catch continue;
            branch_records.append(alloc, .{
                .name = spec.name, .fields = fields.toOwnedSlice(alloc) catch &.{}, .is_optional = spec.is_optional,
            }) catch continue;
        }

        events.append(alloc, .{
            .name = resolved.name,
            .cost = resolved.cost,
            .home = info.module_name,
            .args = args.toOwnedSlice(alloc) catch &.{},
            .creates = creates.toOwnedSlice(alloc) catch &.{},
            .discharges = discharges.toOwnedSlice(alloc) catch &.{},
            .branches = branch_records.toOwnedSlice(alloc) catch &.{},
        }) catch continue;
    }

    // Direct `scope(other)` includes named in THIS register block, in order, deduped.
    var includes = std.ArrayList([]const u8){ .items = &.{}, .capacity = 0 };
    if (RegistryHelper.findScopeDef(scope_defs, scope_name)) |def| {
        for (RegistryHelper.parseEntries(alloc, def.source_text, debug_enabled)) |entry| {
            if (entry.kind == .scope_ref) {
                var dup = false;
                for (includes.items) |inc| if (std.mem.eql(u8, inc, entry.name)) {
                    dup = true;
                    break;
                };
                if (!dup) includes.append(alloc, entry.name) catch {};
            }
        }
    }

    return .{
        .scope = scope_name,
        .events = events.toOwnedSlice(alloc) catch &.{},
        .includes = includes.toOwnedSlice(alloc) catch &.{},
    };
}

/// Human text projection of a scope manifest — the same `open(path: string)`
/// shape the model prompt uses, so a person reading `explain` sees exactly the
/// vocabulary the runtime serves.
pub fn scopeManifestToText(alloc: std.mem.Allocator, m: *const ScopeManifest) []const u8 {
    var out = std.ArrayList(u8).initCapacity(alloc, 256) catch return "";
    for (m.events, 0..) |ev, i| {
        if (i > 0) out.append(alloc, '\n') catch continue;
        out.appendSlice(alloc, ev.name) catch continue;
        out.append(alloc, '(') catch continue;
        for (ev.args, 0..) |arg, ai| {
            if (ai > 0) out.appendSlice(alloc, ", ") catch continue;
            out.appendSlice(alloc, arg.name) catch continue;
            out.appendSlice(alloc, ": ") catch continue;
            out.appendSlice(alloc, arg.type_name) catch continue;
            if (arg.phantom) |p| {
                out.append(alloc, '<') catch continue;
                out.appendSlice(alloc, p) catch continue;
                out.append(alloc, '>') catch continue;
            }
        }
        out.append(alloc, ')') catch continue;
    }
    return out.toOwnedSlice(alloc) catch "";
}

// Internal helper: Look up event branches for shape validation
fn lookupEventBranches(scope_name: []const u8, event_name: []const u8) []const BranchSpec {
    inline for (comptime buildScopeTable()) |scope_info| {
        if (std.mem.eql(u8, scope_name, scope_info.name)) {
            if (scope_info.branches_fn) |branches_fn| {
                return branches_fn(event_name);
            }
        }
    }
    return &[_]BranchSpec{};
}

// ============================================================================
// PARSE - Parse interpreter source without executing it
// ============================================================================
//
// Delegates to `std/interpreter:parse`, which is the interpreter's own parser.
// It takes no file name on purpose: interpreted source has no file, therefore
// no host half and no ``. This entry point used to hold a copy of the
// COMPILER's file parser (`std/koru:parse.source`), which derives its
// host/pure mode from the filename extension — so a synthetic `"x.kz"`
// silently put interpreted source in host mode and made `` mandatory, the
// exact inverse of the rule `run` enforces.

~pub tor parse.source {
    source: string,
    allocator: std.mem.Allocator
}
| parsed *const ast.Flow
| parse-error { message: string, line: u32, column: u32 }

~proc parse.source|zig {
    const interpreter_mod = @import("root").koru_std.koru_interpreter;

    return switch (interpreter_mod.parse_event.handler(.{
        .source = source,
        .allocator = allocator,
    })) {
        .flow => |f| .{ .parsed = f },
        .parse_error => |e| .{ .parse_error = .{
            .message = e.message,
            .line = e.line,
            .column = e.column,
        }},
    };
}

// ============================================================================
// EVAL - Run a parsed AST against a named scope
// ============================================================================

~pub tor eval {
    flow: *const ast.Flow,
    scope: string,
    budget: ?u64,
    handle_pool: ?*@import("root").koru_std.koru_interpreter.HandlePool,
    auto_discharge: bool = true,
    defined: ?*@import("root").koru_std.koru_interpreter.DefinedFlows = null
}
| result { value: @import("root").koru_std.koru_interpreter.Value, used: u64, handles: u32 }
| exhausted { used: u64, last_event: string, handles: u32 }
| validation-error string
| event-denied string
| dispatch-error { event_name: string, message: string }
| scope-not-found string

~proc eval|zig {
    const interpreter_mod = @import("root").koru_std.koru_interpreter;

    const scope_result = get_scope_event.handler(.{ .name = scope });
    switch (scope_result) {
        .scope => |s| {
            const result = interpreter_mod.eval_event.handler(.{
                .flow = flow,
                .dispatcher = s.dispatcher,
                .cost_fn = s.cost_fn,
                .creates_obligations_fn = s.creates_obligations_fn,
                .discharges_obligations_fn = s.discharges_obligations_fn,
                .discharge_event_fn = s.discharge_event_fn,
                .creates_spec_fn = s.creates_spec_fn,
                .discharges_spec_fn = s.discharges_spec_fn,
                .budget = budget,
                .handle_pool = handle_pool,
                .scope_name = scope,  // Pass actual scope name for handle isolation
                .auto_discharge = auto_discharge,
                .defined = defined,
            });
            switch (result) {
                .result => |r| return .{ .result = .{
                    .value = r.value,
                    .used = r.used,
                    .handles = r.handles,
                } },
                .exhausted => |e| return .{ .exhausted = .{
                    .used = e.used,
                    .last_event = e.last_event,
                    .handles = e.handles,
                } },
                .validation_error => |e| return .{ .validation_error = e },
                .dispatch_error => |e| {
                    if (std.mem.eql(u8, e.message, "EventDenied")) {
                        return .{ .event_denied = e.event_name };
                    }
                    return .{ .dispatch_error = .{
                        .event_name = e.event_name,
                        .message = e.message,
                    } };
                },
            }
        },
        .not_found => return .{ .scope_not_found = scope },
    }
}

// ============================================================================
// RUN - Parse and execute Koru source against a named scope
// ============================================================================

// shape: Optional event name to validate response shape against
// @retain: run_event is referenced from generated Zig code in user pipelines
// (std/runtime:run invocations in continuations compile to run_event.handler(...))
~[retain]pub tor run {
    source: string,
    scope: string,
    budget: ?u64 = null,
    handle_pool: ?*@import("root").koru_std.koru_interpreter.HandlePool = null,
    fail_fast: bool = true,
    auto_discharge: bool = true,
    shape: ?[]const u8 = null,
    defined: ?*@import("root").koru_std.koru_interpreter.DefinedFlows = null
}
| result { value: @import("root").koru_std.koru_interpreter.Value, used: u64, handles: u32 }
| exhausted { used: u64, last_event: string, handles: u32 }
| parse-error { message: string, line: u32, column: u32 }
| validation-error string
| shape-error { branch: string, field: ?[]const u8, message: string }
| event-denied string
| dispatch-error { event_name: string, message: string }
| scope-not-found string

~proc run|zig {
    const interpreter_mod = @import("root").koru_std.koru_interpreter;

    const scope_result = get_scope_event.handler(.{ .name = scope });
    switch (scope_result) {
        .scope => |s| {
            const result = interpreter_mod.run_event.handler(.{
                .source = source,
                .dispatcher = s.dispatcher,
                .cost_fn = s.cost_fn,
                .creates_obligations_fn = s.creates_obligations_fn,
                .discharges_obligations_fn = s.discharges_obligations_fn,
                .discharge_event_fn = s.discharge_event_fn,
                .creates_spec_fn = s.creates_spec_fn,
                .discharges_spec_fn = s.discharges_spec_fn,
                .budget = budget,
                .handle_pool = handle_pool,
                .fail_fast = fail_fast,
                .scope_name = scope,  // Pass actual scope name for handle isolation
                .auto_discharge = auto_discharge,
                .defined = defined,
            });
            switch (result) {
                .result => |r| {
                    // Shape validation: if shape is specified, validate the result
                    if (shape) |shape_event_name| {
                        const shape_branches = lookupEventBranches(scope, shape_event_name);
                        if (shape_branches.len > 0) {
                            // Check if the result branch matches any of the shape's branches
                            var branch_valid = false;
                            var matching_branch: ?BranchSpec = null;
                            for (shape_branches) |branch_spec| {
                                if (std.mem.eql(u8, r.value.branch, branch_spec.name)) {
                                    branch_valid = true;
                                    matching_branch = branch_spec;
                                    break;
                                }
                            }

                            if (!branch_valid) {
                                return .{ .shape_error = .{
                                    .branch = r.value.branch,
                                    .field = null,
                                    .message = "unknown branch - not in shape contract",
                                } };
                            }

                            // Check required fields if we have a matching branch
                            if (matching_branch) |mb| {
                                for (mb.fields) |field_spec| {
                                    if (field_spec.is_optional) continue;
                                    // Check if the required field exists in the result
                                    var field_found = false;
                                    for (r.value.fields) |result_field| {
                                        if (std.mem.eql(u8, result_field.name, field_spec.name)) {
                                            field_found = true;
                                            break;
                                        }
                                    }
                                    if (!field_found) {
                                        return .{ .shape_error = .{
                                            .branch = r.value.branch,
                                            .field = field_spec.name,
                                            .message = "missing required field",
                                        } };
                                    }
                                }
                            }
                        }
                    }

                    return .{ .result = .{
                        .value = r.value,
                        .used = r.used,
                        .handles = r.handles,
                    } };
                },
                .exhausted => |e| return .{ .exhausted = .{
                    .used = e.used,
                    .last_event = e.last_event,
                    .handles = e.handles,
                } },
                .parse_error => |e| return .{ .parse_error = .{
                    .message = e.message,
                    .line = e.line,
                    .column = e.column,
                } },
                .validation_error => |e| return .{ .validation_error = e },
                .dispatch_error => |e| {
                    if (std.mem.eql(u8, e.message, "EventDenied")) {
                        return .{ .event_denied = e.event_name };
                    }
                    return .{ .dispatch_error = .{
                        .event_name = e.event_name,
                        .message = e.message,
                    } };
                },
            }
        },
        .not_found => return .{ .scope_not_found = scope },
    }
}

// RUN_CACHED - Parse and execute Koru source against a named scope with cached parsing
~pub tor run-cached {
    source: string,
    scope: string,
    budget: ?u64 = null,
    handle_pool: ?*@import("root").koru_std.koru_interpreter.HandlePool = null,
    fail_fast: bool = true,
    auto_discharge: bool = true,
    shape: ?[]const u8 = null
}
| result { value: @import("root").koru_std.koru_interpreter.Value, used: u64, handles: u32 }
| exhausted { used: u64, last_event: string, handles: u32 }
| parse-error { message: string, line: u32, column: u32 }
| validation-error string
| shape-error { branch: string, field: ?[]const u8, message: string }
| event-denied string
| dispatch-error { event_name: string, message: string }
| scope-not-found string

~proc run-cached|zig {
    const interpreter_mod = @import("root").koru_std.koru_interpreter;

    const scope_result = get_scope_event.handler(.{ .name = scope });
    switch (scope_result) {
        .scope => |s| {
            const result = interpreter_mod.run_cached_event.handler(.{
                .source = source,
                .dispatcher = s.dispatcher,
                .cost_fn = s.cost_fn,
                .creates_obligations_fn = s.creates_obligations_fn,
                .discharges_obligations_fn = s.discharges_obligations_fn,
                .discharge_event_fn = s.discharge_event_fn,
                .creates_spec_fn = s.creates_spec_fn,
                .discharges_spec_fn = s.discharges_spec_fn,
                .budget = budget,
                .handle_pool = handle_pool,
                .fail_fast = fail_fast,
                .scope_name = scope,
                .auto_discharge = auto_discharge,
            });
            switch (result) {
                .result => |r| return .{ .result = .{
                    .value = r.value,
                    .used = r.used,
                    .handles = r.handles,
                } },
                .exhausted => |e| return .{ .exhausted = .{
                    .used = e.used,
                    .last_event = e.last_event,
                    .handles = e.handles,
                } },
                .parse_error => |e| return .{ .parse_error = .{
                    .message = e.message,
                    .line = e.line,
                    .column = e.column,
                } },
                .validation_error => |e| return .{ .validation_error = e },
                .dispatch_error => |e| {
                    if (std.mem.eql(u8, e.message, "EventDenied")) {
                        return .{ .event_denied = e.event_name };
                    }
                    return .{ .dispatch_error = .{
                        .event_name = e.event_name,
                        .message = e.message,
                    } };
                },
            }
        },
        .not_found => return .{ .scope_not_found = scope },
    }
}

// ============================================================================
// COLLECT SCOPES - Comptime event that walks AST and generates dispatchers
// ============================================================================

~[comptime]pub tor collect-scopes {}

~proc collect-scopes|zig {
    // Access PROGRAM_AST from backend
    const root = @import("root");
    const ast_items = root.PROGRAM_AST.items;

    // Use a simple allocator for comptime
    var gpa = std.heap.GeneralPurposeAllocator(.{}){};
    const allocator = gpa.allocator();

    // Scope info collected from AST
    const ScopeInfo = struct {
        name: []const u8,
        module: []const u8,
        events: std.ArrayList([]const u8),
    };

    var scopes = std.ArrayList(ScopeInfo){
        .items = &.{},
        .capacity = 0,
    };

    // Walk AST looking for std.runtime:register flows
    for (ast_items) |item| {
        switch (item) {
            .flow => |flow| {
                if (flow.inv().path.module_qualifier) |mq| {
                    const is_register = (std.mem.eql(u8, mq, "std.runtime") and
                        flow.inv().path.segments.len == 1 and
                        std.mem.eql(u8, flow.inv().path.segments[0], "register"));

                    if (is_register) {
                        var scope_name: []const u8 = "default";
                        var source_text: []const u8 = "";

                        for (flow.inv().args) |arg| {
                            if (std.mem.eql(u8, arg.name, "scope")) {
                                var val = arg.value;
                                if (val.len >= 2 and val[0] == '"' and val[val.len - 1] == '"') {
                                    val = val[1..val.len - 1];
                                }
                                scope_name = val;
                            }
                            if (arg.source_value) |src| {
                                source_text = src.text;
                            }
                        }

                        // Parse events from source block
                        var events = std.ArrayList([]const u8){ .items = &.{}, .capacity = 0 };
                        var lines = std.mem.splitScalar(u8, source_text, '\n');
                        while (lines.next()) |line| {
                            var trimmed = std.mem.trim(u8, line, " \t\r");
                            if (trimmed.len == 0) continue;
                            if (std.mem.startsWith(u8, trimmed, "//")) continue;
                            if (std.mem.indexOf(u8, trimmed, "//")) |idx| {
                                trimmed = std.mem.trim(u8, trimmed[0..idx], " \t");
                            }
                            if (trimmed.len > 0) {
                                events.append(allocator, allocator.dupe(u8, trimmed) catch continue) catch continue;
                            }
                        }

                        scopes.append(allocator, .{
                            .name = allocator.dupe(u8, scope_name) catch continue,
                            .module = "main",
                            .events = events,
                        }) catch continue;

                        std.debug.print("[RUNTIME] Found scope '{s}' with {d} events\n", .{scope_name, events.items.len});
                    }
                }
            },
            .module_decl => |module| {
                for (module.items) |mod_item| {
                    if (mod_item == .flow) {
                        const flow = mod_item.flow;
                        if (flow.inv().path.module_qualifier) |mq| {
                            const is_register = (std.mem.eql(u8, mq, "std.runtime") and
                                flow.inv().path.segments.len == 1 and
                                std.mem.eql(u8, flow.inv().path.segments[0], "register"));

                            if (is_register) {
                                var scope_name: []const u8 = "default";
                                var source_text: []const u8 = "";

                                for (flow.inv().args) |arg| {
                                    if (std.mem.eql(u8, arg.name, "scope")) {
                                        var val = arg.value;
                                        if (val.len >= 2 and val[0] == '"' and val[val.len - 1] == '"') {
                                            val = val[1..val.len - 1];
                                        }
                                        scope_name = val;
                                    }
                                    if (arg.source_value) |src| {
                                        source_text = src.text;
                                    }
                                }

                                var events = std.ArrayList([]const u8){ .items = &.{}, .capacity = 0 };
                                var lines = std.mem.splitScalar(u8, source_text, '\n');
                                while (lines.next()) |line| {
                                    var trimmed = std.mem.trim(u8, line, " \t\r");
                                    if (trimmed.len == 0) continue;
                                    if (std.mem.startsWith(u8, trimmed, "//")) continue;
                                    if (std.mem.indexOf(u8, trimmed, "//")) |idx| {
                                        trimmed = std.mem.trim(u8, trimmed[0..idx], " \t");
                                    }
                                    if (trimmed.len > 0) {
                                        events.append(allocator, allocator.dupe(u8, trimmed) catch continue) catch continue;
                                    }
                                }

                                scopes.append(allocator, .{
                                    .name = allocator.dupe(u8, scope_name) catch continue,
                                    .module = module.logical_name,
                                    .events = events,
                                }) catch continue;

                                std.debug.print("[RUNTIME] Found scope '{s}' in module '{s}' with {d} events\n",
                                    .{scope_name, module.logical_name, events.items.len});
                            }
                        }
                    }
                }
            },
            else => {},
        }
    }

    std.debug.print("[RUNTIME] Collected {d} scope(s)\n", .{scopes.items.len});

    // TODO: Generate dispatch tables into std.runtime module
}
