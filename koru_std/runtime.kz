// Runtime Registry Standard Library
// Enables scoped runtime evaluation of parsed Koru code
//
// DESIGN:
// - std/runtime:register(scope: "name") { tors } declares a scope (norun)
// - std/runtime:collect-scopes walks AST and generates dispatch tables
// - std/runtime:get-scope(name: "...") looks up a scope at runtime

~[comptime|runtime]

~import std/compiler_types
~import std/interpreter

const std = @import("std");
const ast = @import("ast");

// ============================================================================
// SCOPE DECLARATION - [norun] declaration collected by collect-scopes

~[comptime|transform]pub tor register {
    source: Source,
    invocation: *const Invocation,
    item: *const std/compiler:Item,
    program: *const std/compiler:Program,
    allocator: std.mem.Allocator
} -> SiteResult

// REGISTRY COMMON moved to runtime.registry.kz (~part registry) — shared
// comptime machinery for register's emission, the scope-manifest builder,
// and the [explainer].
const ast_reg = @import("ast");

~proc register|zig {
    const CompilerEnvRt = @import("root").CompilerEnv;
    // Get the flow from the item
    const flow = if (item.* == .flow) &item.flow else return .{};

    // Extract scope name from args or registry annotations
    const scope_name = Helpers.extractScopeName(invocation, flow.annotations);

    std.debug.print("[REGISTRY] Creating dispatcher for scope '{s}'\n", .{scope_name});

    // Parse tors from source block with optional costs and composition
    // Syntax:
    //   event_name              - default cost 1
    //   event_name(cost)        - custom cost
    //   scope(other)            - include another scope
    //   module:*                - include all tors under module prefix
    //
    // Obligations are extracted from tor signatures using phantom types:
    //   <state!> in output = creates obligation (! suffix)
    //   <!state> in input = discharges obligation (! prefix)

    // Local CreateSpec/DischargeSpec for codegen (mirrors runtime types)
    const event_infos = RegistryHelper.collectEventInfos(allocator, program);
    const scope_defs = RegistryHelper.collectScopeDefs(allocator, program);
    const debug_enabled = CompilerEnvRt.hasFlag("debug");

    var resolved_events = std.ArrayList(ResolvedEvent){ .items = &.{}, .capacity = 0 };
    var visited = std.StringHashMap(void).init(allocator);
    defer visited.deinit();
    RegistryHelper.resolveScope(allocator, scope_defs, event_infos, scope_name, debug_enabled, &visited, &resolved_events);

    // Add @retain annotation to registered tors so dead strip preserves them.
    // The event_infos point into the original program; replaceFlowRecursive clones
    // them, carrying the annotations into the new program.
    for (resolved_events.items) |resolved| {
        const lookup_name = resolved.internal_name orelse resolved.name;
        const info = RegistryHelper.findEventInfoHomed(allocator, event_infos, lookup_name, resolved.home) orelse continue;
        // Retain the event_decl
        const mutable_decl = @constCast(info.event_decl);
        const new_anns = allocator.alloc([]const u8, mutable_decl.annotations.len + 1) catch continue;
        @memcpy(new_anns[0..mutable_decl.annotations.len], mutable_decl.annotations);
        new_anns[mutable_decl.annotations.len] = "retain";
        mutable_decl.annotations = new_anns;
        // Also retain the matching proc_decl (same path)
        RegistryHelper.retainMatchingProc(allocator, program, info.event_decl);
    }

    const scope_ident = Helpers.mangleIdentifier(allocator, scope_name);
    const module_name = Helpers.siteHomeModule(program, item);
    const emit_helpers = !Helpers.hasRegistryHelpers(program, module_name);
    var events_list = std.ArrayList(EventEntry){ .items = &.{}, .capacity = 0 };
    for (resolved_events.items) |resolved| {
        const lookup_name = resolved.internal_name orelse resolved.name;
        const info = RegistryHelper.findEventInfoHomed(allocator, event_infos, lookup_name, resolved.home) orelse continue;
        var obligations = extractObligations(allocator, info.event_decl, info.module_name);
        const branches = extractBranches(allocator, info.event_decl);
        const input_fields = extractInputFields(allocator, info.event_decl);
        const symbol = Helpers.buildEventSymbol(allocator, info.module_name, info.event_decl.path.segments, program.main_module_name);
        const dispatch_ident = Helpers.mangleIdentifier(allocator, resolved.name);
        const dispatch_name = std.fmt.allocPrint(allocator, "dispatch_{s}_{s}", .{ scope_ident, dispatch_ident }) catch dispatch_ident;

        // A discharge claim (input phantom `<!state>`) on an tor with NO
        // implementation is a lie the pool would otherwise trust: the
        // synthesized no-op handler "releases" the handle without releasing
        // anything, and close reports success with the resource still held
        // (440_016 probe). Refuse to emit the discharge claim — the
        // obligation then strands at hang-up and close panics honestly,
        // naming the leak instead of papering over it.
        if ((obligations.discharges.len > 0 or obligations.discharges_specs.len > 0) and
            !RegistryHelper.eventHasImpl(program, info.event_decl))
        {
            std.debug.print("[REGISTRY] WARNING: '{s}' declares a discharge "
                ++ "phantom but has no implementation — discharge claim refused; "
                ++ "its obligation strands at hang-up.\n", .{resolved.name});
            obligations.discharges = &.{};
            obligations.discharges_specs = &.{};
        }

        if (obligations.creates.len > 0 or obligations.discharges.len > 0) {
            std.debug.print("[REGISTRY] Event '{s}': creates={d} specs, discharges={d} specs\n",
                .{resolved.name, obligations.creates_specs.len, obligations.discharges_specs.len});
        }

        events_list.append(allocator, .{
            .name = resolved.name,
            .cost = resolved.cost,
            .creates_obligations = obligations.creates,
            .discharges_obligations = obligations.discharges,
            .creates_specs = obligations.creates_specs,
            .discharges_specs = obligations.discharges_specs,
            .branches = branches,
            .input_fields = input_fields,
            .doc = info.event_decl.prose,
            .symbol = symbol,
            .dispatch_name = dispatch_name,
            .module_name = info.module_name,
        }) catch continue;
    }

    std.debug.print("[REGISTRY] Found {d} events\n", .{events_list.items.len});

    // Generate dispatcher code (indented for main_module)
    var code = std.ArrayList(u8){ .items = &.{}, .capacity = 0 };
    const I = "    "; // 4 spaces for main_module indentation

    if (emit_helpers) {
        code.appendSlice(allocator, I ++ "// " ++ registry_helpers_marker ++ "\n") catch unreachable;

        // Import required modules for generated code
        code.appendSlice(allocator, I ++ "const __koru_dispatcher_std = @import(\"std\");\n") catch unreachable;
        code.appendSlice(allocator, I ++ "const __koru_dispatcher_ast = @import(\"ast\");\n\n") catch unreachable;

        // Export type aliases for user code (so they can use bare names like Path, Invocation, etc.)
        code.appendSlice(allocator, I ++ "pub const Path = __koru_dispatcher_ast.DottedPath;\n") catch unreachable;
        code.appendSlice(allocator, I ++ "pub const Arg = __koru_dispatcher_ast.Arg;\n") catch unreachable;
        code.appendSlice(allocator, I ++ "pub const Invocation = __koru_dispatcher_ast.Invocation;\n") catch unreachable;
        code.appendSlice(allocator, I ++ "pub const DispatchResult = koru_std.koru_runtime.DispatchResult;\n") catch unreachable;
        code.appendSlice(allocator, I ++ "const __koru_ScopeEvent = koru_std.koru_runtime.ScopeEvent;\n") catch unreachable;
        code.appendSlice(allocator, I ++ "const __koru_ScopeDescriptor = koru_std.koru_runtime.ScopeDescriptor;\n") catch unreachable;
        code.appendSlice(allocator, I ++ "const __koru_ScopeManifest = koru_std.koru_runtime.ScopeManifest;\n") catch unreachable;
        code.appendSlice(allocator, I ++ "const __koru_ManifestEvent = koru_std.koru_runtime.ManifestEvent;\n") catch unreachable;
        code.appendSlice(allocator, I ++ "const __koru_ManifestArg = koru_std.koru_runtime.ManifestArg;\n") catch unreachable;
        code.appendSlice(allocator, I ++ "const __koru_ManifestCreate = koru_std.koru_runtime.ManifestCreate;\n") catch unreachable;
        code.appendSlice(allocator, I ++ "const __koru_ManifestDischarge = koru_std.koru_runtime.ManifestDischarge;\n") catch unreachable;
        code.appendSlice(allocator, I ++ "const __koru_ManifestBranch = koru_std.koru_runtime.ManifestBranch;\n") catch unreachable;
        code.appendSlice(allocator, I ++ "const __koru_ManifestBranchField = koru_std.koru_runtime.ManifestBranchField;\n") catch unreachable;
        code.appendSlice(allocator, I ++ "const __koru_FieldValue = koru_std.koru_runtime.FieldValue;\n") catch unreachable;
        code.appendSlice(allocator, I ++ "const __koru_NamedField = koru_std.koru_runtime.NamedField;\n\n") catch unreachable;

        // Helper function - strips quotes from string values
        code.appendSlice(allocator, I ++ "fn __koru_getArg(__koru_args: []const __koru_dispatcher_ast.Arg, __koru_n: []const u8) ?[]const u8 {\n") catch unreachable;
        code.appendSlice(allocator, I ++ "    for (__koru_args) |__koru_arg| {\n") catch unreachable;
        code.appendSlice(allocator, I ++ "        if (__koru_dispatcher_std.mem.eql(u8, __koru_arg.name, __koru_n)) {\n") catch unreachable;
        code.appendSlice(allocator, I ++ "            var __koru_v = __koru_arg.value;\n") catch unreachable;
        code.appendSlice(allocator, I ++ "            if (__koru_v.len >= 2 and __koru_v[0] == '\"' and __koru_v[__koru_v.len-1] == '\"') __koru_v = __koru_v[1..__koru_v.len-1];\n") catch unreachable;
        code.appendSlice(allocator, I ++ "            return __koru_v;\n") catch unreachable;
        code.appendSlice(allocator, I ++ "        }\n") catch unreachable;
        code.appendSlice(allocator, I ++ "    }\n") catch unreachable;
        code.appendSlice(allocator, I ++ "    return null;\n") catch unreachable;
        code.appendSlice(allocator, I ++ "}\n\n") catch unreachable;

        // Helper function - builds Input struct from args using comptime reflection
        code.appendSlice(allocator, I ++ "fn __koru_buildInput(comptime __koru_T: type, __koru_args: []const __koru_dispatcher_ast.Arg) !__koru_T {\n") catch unreachable;
        code.appendSlice(allocator, I ++ "    var __koru_input: __koru_T = undefined;\n") catch unreachable;
        code.appendSlice(allocator, I ++ "    inline for (__koru_dispatcher_std.meta.fields(__koru_T)) |__koru_field| {\n") catch unreachable;
        code.appendSlice(allocator, I ++ "        const __koru_raw = __koru_getArg(__koru_args, __koru_field.name) orelse \"\";\n") catch unreachable;
        code.appendSlice(allocator, I ++ "        const __koru_F = __koru_field.type;\n") catch unreachable;
        code.appendSlice(allocator, I ++ "        if (__koru_F == bool) {\n") catch unreachable;
        code.appendSlice(allocator, I ++ "            @field(__koru_input, __koru_field.name) = __koru_dispatcher_std.mem.eql(u8, __koru_raw, \"true\") or __koru_dispatcher_std.mem.eql(u8, __koru_raw, \"1\");\n") catch unreachable;
        code.appendSlice(allocator, I ++ "        } else switch (@typeInfo(__koru_F)) {\n") catch unreachable;
        code.appendSlice(allocator, I ++ "            .int => {\n") catch unreachable;
        code.appendSlice(allocator, I ++ "                @field(__koru_input, __koru_field.name) = __koru_dispatcher_std.fmt.parseInt(__koru_F, __koru_raw, 10) catch {\n") catch unreachable;
        code.appendSlice(allocator, I ++ "                    koru_std.koru_interpreter.setDispatchDetail(__koru_dispatcher_std.fmt.allocPrint(__koru_dispatcher_std.heap.page_allocator, \"field '{s}' expected \" ++ @typeName(__koru_F) ++ \", got '{s}'\", .{ __koru_field.name, __koru_raw }) catch @panic(\"dispatch: OOM\"));\n") catch unreachable;
        code.appendSlice(allocator, I ++ "                    return error.InvalidArgument;\n") catch unreachable;
        code.appendSlice(allocator, I ++ "                };\n") catch unreachable;
        code.appendSlice(allocator, I ++ "            },\n") catch unreachable;
        code.appendSlice(allocator, I ++ "            .float => {\n") catch unreachable;
        code.appendSlice(allocator, I ++ "                @field(__koru_input, __koru_field.name) = __koru_dispatcher_std.fmt.parseFloat(__koru_F, __koru_raw) catch {\n") catch unreachable;
        code.appendSlice(allocator, I ++ "                    koru_std.koru_interpreter.setDispatchDetail(__koru_dispatcher_std.fmt.allocPrint(__koru_dispatcher_std.heap.page_allocator, \"field '{s}' expected \" ++ @typeName(__koru_F) ++ \", got '{s}'\", .{ __koru_field.name, __koru_raw }) catch @panic(\"dispatch: OOM\"));\n") catch unreachable;
        code.appendSlice(allocator, I ++ "                    return error.InvalidArgument;\n") catch unreachable;
        code.appendSlice(allocator, I ++ "                };\n") catch unreachable;
        code.appendSlice(allocator, I ++ "            },\n") catch unreachable;
        code.appendSlice(allocator, I ++ "            .pointer => |__koru_ptr_info| {\n") catch unreachable;
        code.appendSlice(allocator, I ++ "                if (__koru_ptr_info.size == .slice and __koru_ptr_info.child == u8) {\n") catch unreachable;
        code.appendSlice(allocator, I ++ "                    @field(__koru_input, __koru_field.name) = __koru_raw;\n") catch unreachable;
        code.appendSlice(allocator, I ++ "                } else {\n") catch unreachable;
        code.appendSlice(allocator, I ++ "                    @field(__koru_input, __koru_field.name) = koru_std.koru_interpreter.resolveDispatchResource(__koru_F, __koru_raw) orelse {\n") catch unreachable;
        code.appendSlice(allocator, I ++ "                        koru_std.koru_interpreter.setDispatchDetail(__koru_dispatcher_std.fmt.allocPrint(__koru_dispatcher_std.heap.page_allocator, \"field '{s}' names a resource token this pool does not hold — got '{s}'\", .{ __koru_field.name, __koru_raw }) catch @panic(\"dispatch: OOM\"));\n") catch unreachable;
        code.appendSlice(allocator, I ++ "                        return error.InvalidArgument;\n") catch unreachable;
        code.appendSlice(allocator, I ++ "                    };\n") catch unreachable;
        code.appendSlice(allocator, I ++ "                }\n") catch unreachable;
        code.appendSlice(allocator, I ++ "            },\n") catch unreachable;
        code.appendSlice(allocator, I ++ "            else => {\n") catch unreachable;
        code.appendSlice(allocator, I ++ "                @field(__koru_input, __koru_field.name) = __koru_dispatcher_std.mem.zeroes(__koru_F);\n") catch unreachable;
        code.appendSlice(allocator, I ++ "            },\n") catch unreachable;
        code.appendSlice(allocator, I ++ "        }\n") catch unreachable;
        code.appendSlice(allocator, I ++ "    }\n") catch unreachable;
        code.appendSlice(allocator, I ++ "    return __koru_input;\n") catch unreachable;
        code.appendSlice(allocator, I ++ "}\n\n") catch unreachable;

        // Helper - owns a result payload. A |zig proc's returns are slices
        // into its dead stack frame; payloads copy to page memory at pack
        // time (the never-freed tolerance wireReject and parse.wire carry).
        code.appendSlice(allocator, I ++ "fn __koru_own(comptime __koru_T: type, __koru_s: []const __koru_T) []const __koru_T {\n    const __koru_a = __koru_dispatcher_std.heap.page_allocator;\n    if (__koru_T == u8) return __koru_a.dupe(u8, __koru_s) catch @panic(\"dispatch: OOM owning result\");\n") catch unreachable;
        code.appendSlice(allocator, I ++ "    const __koru_out = __koru_a.alloc(__koru_T, __koru_s.len) catch @panic(\"dispatch: OOM owning result\");\n    for (__koru_s, 0..) |__koru_e, __koru_i| __koru_out[__koru_i] = __koru_a.dupe(u8, __koru_e) catch @panic(\"dispatch: OOM owning result\");\n    return __koru_out;\n}\n\n") catch unreachable;
    }

    // Per-event dispatchers and descriptor table
    for (events_list.items) |event| {
        const is_control_flow = std.mem.eql(u8, event.name, "if") or
                                std.mem.eql(u8, event.name, "for") or
                                std.mem.eql(u8, event.name, "std.control:if") or
                                std.mem.eql(u8, event.name, "std.control:for");

        code.appendSlice(allocator, I ++ "fn ") catch unreachable;
        code.appendSlice(allocator, event.dispatch_name) catch unreachable;
        code.appendSlice(allocator, "(__koru_inv: *const __koru_dispatcher_ast.Invocation, __koru_out: *koru_std.koru_runtime.DispatchResult) !void {\n") catch unreachable;

        if (is_control_flow) {
            code.appendSlice(allocator, I ++ "    _ = __koru_inv; // Control flow - interpreter handles this\n") catch unreachable;
            code.appendSlice(allocator, I ++ "    __koru_out.* = .{ .branch = \"control\", .fields = &.{} };\n") catch unreachable;
            code.appendSlice(allocator, I ++ "    return;\n") catch unreachable;
        } else {
            // Generate dispatcher that handles both void and branched tors
            code.appendSlice(allocator, I ++ "    const __koru_Input = ") catch unreachable;
            code.appendSlice(allocator, event.symbol) catch unreachable;
            code.appendSlice(allocator, ".Input;\n") catch unreachable;
            code.appendSlice(allocator, I ++ "    const __koru_Handler = ") catch unreachable;
            code.appendSlice(allocator, event.symbol) catch unreachable;
            code.appendSlice(allocator, ";\n") catch unreachable;
            code.appendSlice(allocator, I ++ "    const __koru_ReturnType = @typeInfo(@TypeOf(__koru_Handler.handler)).@\"fn\".return_type.?;\n") catch unreachable;
            code.appendSlice(allocator, I ++ "    if (__koru_ReturnType == void) {\n") catch unreachable;
            code.appendSlice(allocator, I ++ "        // Void event - just call and return empty __koru_branch\n") catch unreachable;
            code.appendSlice(allocator, I ++ "        __koru_Handler.handler(try __koru_buildInput(__koru_Input, __koru_inv.args));\n") catch unreachable;
            code.appendSlice(allocator, I ++ "        __koru_out.* = .{ .branch = \"\", .fields = &.{} };\n") catch unreachable;
            code.appendSlice(allocator, I ++ "        return;\n") catch unreachable;
            code.appendSlice(allocator, I ++ "    }\n") catch unreachable;
            code.appendSlice(allocator, I ++ "    if (@typeInfo(__koru_ReturnType) != .@\"union\") {\n") catch unreachable;
            code.appendSlice(allocator, I ++ "        // Single-return tor (`-> __koru_T`): the value BINDS, it does not select a\n") catch unreachable;
            code.appendSlice(allocator, I ++ "        // __koru_branch. Reported as the empty __koru_branch with the value on __type_ref,\n") catch unreachable;
            code.appendSlice(allocator, I ++ "        // the same channel identity branches use for bare payloads.\n") catch unreachable;
            code.appendSlice(allocator, I ++ "        const __koru_v = __koru_Handler.handler(try __koru_buildInput(__koru_Input, __koru_inv.args));\n") catch unreachable;
            code.appendSlice(allocator, I ++ "        const __koru_V = @TypeOf(__koru_v);\n") catch unreachable;
            code.appendSlice(allocator, I ++ "        const __koru_SR = struct { threadlocal var buf: [1]__koru_NamedField = undefined; };\n") catch unreachable;
            code.appendSlice(allocator, I ++ "        var __koru_n: usize = 0;\n") catch unreachable;
            code.appendSlice(allocator, I ++ "        if (__koru_V == bool) {\n") catch unreachable;
            code.appendSlice(allocator, I ++ "            __koru_SR.buf[0] = .{ .name = \"__type_ref\", .value = __koru_FieldValue{ .bool_val = __koru_v } };\n") catch unreachable;
            code.appendSlice(allocator, I ++ "            __koru_n = 1;\n") catch unreachable;
            code.appendSlice(allocator, I ++ "        } else if (@typeInfo(__koru_V) == .int) {\n") catch unreachable;
            code.appendSlice(allocator, I ++ "            __koru_SR.buf[0] = .{ .name = \"__type_ref\", .value = __koru_FieldValue{ .int_val = @as(i64, @intCast(__koru_v)) } };\n") catch unreachable;
            code.appendSlice(allocator, I ++ "            __koru_n = 1;\n") catch unreachable;
            code.appendSlice(allocator, I ++ "        } else if (@typeInfo(__koru_V) == .float) {\n") catch unreachable;
            code.appendSlice(allocator, I ++ "            __koru_SR.buf[0] = .{ .name = \"__type_ref\", .value = __koru_FieldValue{ .float_val = @as(f64, @floatCast(__koru_v)) } };\n") catch unreachable;
            code.appendSlice(allocator, I ++ "            __koru_n = 1;\n") catch unreachable;
            code.appendSlice(allocator, I ++ "        } else if (@typeInfo(__koru_V) == .pointer) {\n") catch unreachable;
            code.appendSlice(allocator, I ++ "            const __koru_ptr_info = @typeInfo(__koru_V).pointer;\n") catch unreachable;
            code.appendSlice(allocator, I ++ "            if (__koru_ptr_info.size == .slice and __koru_ptr_info.child == u8) {\n") catch unreachable;
            code.appendSlice(allocator, I ++ "                __koru_SR.buf[0] = .{ .name = \"__type_ref\", .value = __koru_FieldValue{ .string_val = __koru_own(u8, __koru_v) } };\n") catch unreachable;
            code.appendSlice(allocator, I ++ "                __koru_n = 1;\n") catch unreachable;
            code.appendSlice(allocator, I ++ "            } else if (__koru_ptr_info.size == .slice and __koru_ptr_info.child == []const u8) {\n                __koru_SR.buf[0] = .{ .name = \"__type_ref\", .value = __koru_FieldValue{ .string_array = __koru_own([]const u8, __koru_v) } };\n                __koru_n = 1;\n") catch unreachable;
            code.appendSlice(allocator, I ++ "            } else {\n") catch unreachable;
            code.appendSlice(allocator, I ++ "                __koru_SR.buf[0] = .{ .name = \"__type_ref\", .value = __koru_FieldValue{ .string_val = koru_std.koru_interpreter.registerDispatchResource(@typeName(__koru_ptr_info.child), __koru_v) } };\n") catch unreachable;
            code.appendSlice(allocator, I ++ "                __koru_n = 1;\n") catch unreachable;
            code.appendSlice(allocator, I ++ "            }\n") catch unreachable;
            code.appendSlice(allocator, I ++ "        }\n") catch unreachable;
            code.appendSlice(allocator, I ++ "        __koru_out.* = .{ .branch = \"\", .fields = __koru_SR.buf[0..__koru_n] };\n") catch unreachable;
            code.appendSlice(allocator, I ++ "        return;\n") catch unreachable;
            code.appendSlice(allocator, I ++ "    }\n") catch unreachable;
            code.appendSlice(allocator, I ++ "    // Branched event - extract __koru_branch and fields\n") catch unreachable;
            code.appendSlice(allocator, I ++ "    const __koru_r = __koru_Handler.handler(try __koru_buildInput(__koru_Input, __koru_inv.args));\n") catch unreachable;
            code.appendSlice(allocator, I ++ "    const __koru_S = struct { threadlocal var buf: [16]__koru_NamedField = undefined; };\n") catch unreachable;
            code.appendSlice(allocator, I ++ "    const __koru_branch = @tagName(__koru_r);\n") catch unreachable;
            code.appendSlice(allocator, I ++ "    const __koru_field_count = switch (__koru_r) { inline else => |__koru_p| blk: {\n") catch unreachable;
            code.appendSlice(allocator, I ++ "        const __koru_P = @TypeOf(__koru_p);\n") catch unreachable;
            code.appendSlice(allocator, I ++ "        // Identity branches have bare types, not structs\n") catch unreachable;
            code.appendSlice(allocator, I ++ "        if (@typeInfo(__koru_P) != .@\"struct\") {\n") catch unreachable;
            code.appendSlice(allocator, I ++ "            // Identity __koru_branch - create synthetic __type_ref __koru_field\n") catch unreachable;
            code.appendSlice(allocator, I ++ "            if (__koru_P == bool) {\n") catch unreachable;
            code.appendSlice(allocator, I ++ "                __koru_S.buf[0] = .{ .name = \"__type_ref\", .value = __koru_FieldValue{ .bool_val = __koru_p } };\n") catch unreachable;
            code.appendSlice(allocator, I ++ "            } else if (@typeInfo(__koru_P) == .int) {\n") catch unreachable;
