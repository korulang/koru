    code.appendSlice(allocator, I ++ "            if (__koru_dispatcher_std.mem.eql(u8, __koru_obligation, __koru_dis)) { __koru_discharges_it = true; break; }\n") catch unreachable;
    code.appendSlice(allocator, I ++ "        }\n") catch unreachable;
    code.appendSlice(allocator, I ++ "        if (__koru_discharges_it) {\n") catch unreachable;
    code.appendSlice(allocator, I ++ "            var __koru_reissues = false;\n") catch unreachable;
