// Koru Standard Library: the `manifest-text` part of runtime — the human
// text projection of a scope manifest, the same `open(path: string)`
// shape the model prompt uses. Joined via `~part manifest-text` in
// runtime.kz; merged into the runtime module at load.

/// Human text projection of a scope manifest — the same `open(path: string)`
/// shape the model prompt uses, so a person reading `explain` sees exactly the
/// vocabulary the runtime serves.
pub fn scopeManifestToText(alloc: std.mem.Allocator, m: *const ScopeManifest) []const u8 {
    var out = std.ArrayList(u8).initCapacity(alloc, 256) catch return "";
    for (m.events, 0..) |ev, i| {
        if (i > 0) out.append(alloc, '\n') catch continue;
        out.appendSlice(alloc, ev.name) catch continue;
        out.append(alloc, '(') catch continue;
        for (ev.args, 0..) |arg, ai| {
            if (ai > 0) out.appendSlice(alloc, ", ") catch continue;
            out.appendSlice(alloc, arg.name) catch continue;
            out.appendSlice(alloc, ": ") catch continue;
            out.appendSlice(alloc, arg.type_name) catch continue;
            if (arg.phantom) |p| {
                out.append(alloc, '<') catch continue;
                out.appendSlice(alloc, p) catch continue;
                out.append(alloc, '>') catch continue;
            }
        }
        out.append(alloc, ')') catch continue;
    }
    return out.toOwnedSlice(alloc) catch "";
}
