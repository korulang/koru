// std/args — Zig implementation facet.
//
// Events are declared in the `args.k` companion (merged at import). This file
// holds the Zig-side helper and the `|zig` proc bodies.

const std = @import("std");

// ============================================================================
// Cached args - loaded once on first access
// ============================================================================

// ZERO-ALLOC: spans into the process's own argv memory (std.os.argv,
// POSIX), cached in a static buffer. The old argsAlloc cache was a
// process-lifetime allocation the exit-time leak meter rightly refused
// to exempt (first caught by 650_001, the file-reading vertical).
var _argv_buf: [64][:0]u8 = undefined;
var _argv_len: usize = 0;
var _argv_init: bool = false;

fn _get_argv() [][:0]u8 {
    if (!_argv_init) {
        if (std.os.argv.len > _argv_buf.len) @panic("std/args: more than 64 argv entries - raise the cap");
        for (std.os.argv, 0..) |p, i| _argv_buf[i] = std.mem.span(p);
        _argv_len = std.os.argv.len;
        _argv_init = true;
    }
    return _argv_buf[0.._argv_len];
}

~proc all|zig {
    return _get_argv();
}

~proc count|zig {
    return _get_argv().len;
}

~proc get|zig {
    const argv = _get_argv();
    if (index >= argv.len) {
        return .{ .out_of_bounds = .{} };
    }
    return .{ .arg = argv[index] };
}

~proc rest|zig {
    const argv = _get_argv();
    if (argv.len <= 1) {
        return &.{};
    }
    return argv[1..];
}
