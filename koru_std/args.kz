// $std/args — Zig implementation facet.
//
// Events are declared in the `args.k` companion (merged at import). This file
// holds the Zig-side helper and the `|zig` proc bodies.

const std = @import("std");

// ============================================================================
// Cached args - loaded once on first access
// ============================================================================

var _cached_argv: ?[][:0]u8 = null;

fn _get_argv() [][:0]u8 {
    if (_cached_argv) |argv| {
        return argv;
    }
    _cached_argv = std.process.argsAlloc(koru_allocator()) catch &.{};
    return _cached_argv.?;
}

~proc all|zig {
    return .{ .args = _get_argv() };
}

~proc count|zig {
    return .{ .count = _get_argv().len };
}

~proc get|zig {
    const argv = _get_argv();
    if (index >= argv.len) {
        return .{ .out_of_bounds = .{} };
    }
    return .{ .arg = argv[index] };
}

~proc rest|zig {
    const argv = _get_argv();
    if (argv.len <= 1) {
        return .{ .args = &.{} };
    }
    return .{ .args = argv[1..] };
}
