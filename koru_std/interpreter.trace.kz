// Koru Standard Library: the `trace` part of interpreter.kz — the run's
// dispatch trace rendering and the durable naming a failure report
// needs. Joined via `~part trace` in interpreter.kz; merged into the
// interpreter module at load. The TraceEntry record itself and the
// call_step field builders live in the `callrec` part.

/// Render the dispatch trace as report lines — `event -> <json> bound: rN
/// (as arm)`. A single-link turn renders nothing: the `result:` line already
/// carries it, and duplicating one call's outcome is noise, not teaching.
pub fn renderTrace(trace: *std.ArrayListUnmanaged(TraceEntry), allocator: std.mem.Allocator) []const u8 {
    sinkTraceEntries(trace);
    if (trace.items.len <= 1) return "";
    var tb = std.ArrayListUnmanaged(u8){};
    const tw = tb.writer(allocator);
    for (trace.items) |t| {
        tw.print("{s} -> {s}", .{ t.event, t.json }) catch {};
        if (t.bound.len > 0) tw.print(" bound: {s}", .{t.bound}) catch {};
        if (t.arm) |a| tw.print(" as {s}", .{a}) catch {};
        tw.writeByte('\n') catch {};
    }
    return std.heap.page_allocator.dupe(u8, tb.items) catch "";
}

/// The terminal dispatch's durable name — the `result`'s value and the last
/// trace entry are the same dispatch, so its name comes from the trace, not
/// a second mint.
pub fn lastBound(trace: *std.ArrayListUnmanaged(TraceEntry)) []const u8 {
    if (trace.items.len == 0) return "";
    return trace.items[trace.items.len - 1].bound;
}

/// The invocation's fully qualified tor name, on memory that OUTLIVES the run.
///
/// Every dispatch-error site used to build this into a `[256]u8` stack local and
/// return a slice of it, so the name a caller read was a dead frame. It printed
/// as garbage, which is why `dispatch-error` has been unreadable for as long as
/// it has been firing — the failure that hid the resource bridge for six days
/// reported itself as four replacement characters.
fn persistentEventName(inv: *const ast.Invocation) []const u8 {
    const alloc = std.heap.page_allocator;
    var name = std.ArrayList(u8){ .items = &.{}, .capacity = 0 };
    if (inv.path.module_qualifier) |mq| {
        name.appendSlice(alloc, mq) catch return "unknown";
        name.append(alloc, ':') catch return "unknown";
    }
    for (inv.path.segments, 0..) |seg, i| {
        if (i > 0) name.append(alloc, '.') catch return "unknown";
        name.appendSlice(alloc, seg) catch return "unknown";
    }
    return name.toOwnedSlice(alloc) catch "unknown";
}
