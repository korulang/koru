// std/list — growable list with an active/free ownership model.
//
// The i64 trunk (List_i64) stays hand-written exactly as it always was; the
// container-generating machinery generalizes it: `new(<element>)` is a
// [transform] that routes by element name (the 660_026 dispatch-gap doctrine:
// events lower keyed by NAME only, so every concrete container gets its own
// suffixed events). A PRIMITIVE element routes to the hand-written
// constructor (`new(i64)` -> `new-i64`); a PROTO entry (see std/types.proto,
// types.kz) routes to a SYNTHESIZED container: the element struct, the
// `List_<Name>` handle, and the full op set (push/len/get/pop/free) are
// appended into the caller's module the first time that element is seen.
// The five op events are [transform]s too: each rewrites its call site to the
// suffixed event by resolving the container binding's element in the
// enclosing flow (a `std/list:new` invocation whose binding branch carries the
// handle — the findShapeSource-style walk, same power std/store uses to find
// watch bodies).
//
// Ownership states (phantom on *List_<T> / *List_i64 — identical
// protocol for every element type):
//   <list!>  - new issues the obligation: this list must be freed (or drained).
//   <list>   - borrowed: read/mutate in place (push, len), obligation untouched.
//   <!list>  - consumed: free discharges the obligation.
// Sliced scope (reported honestly): synthesized containers land in the CALLER's
// module (the module of the flow invoking `std/list:new`) — a library declaring
// a proto from which another module derives is beyond this rung. Ops route by
// HANDLE, not by flow: the tor resolves the container from the `new` site that
// bound it in the same flow, or from the enclosing tor's parameter type
// (`*List_<Name>`) when the handle crosses flows. A handle the program never
// built falls back to the `-i64` trunk and the shape check judges it there —
// loud, never silent misrouting.

const std = @import("std");
const ast_find = @import("ast");

pub const List_i64 = struct {
    items: std.ArrayList(i64),
    allocator: std.mem.Allocator,

    // Package-private — only free/auto-discharge calls this.
    fn deinit(self: *List_i64) void {
        self.items.deinit(self.allocator);
        self.allocator.destroy(self);
    }
};

// ============================================
// Construction
// ============================================

// Generic constructor. `new(i64)` reads the element-type expression at comptime
// and rewrites its call site to the concrete `new-<type>` runtime constructor
// (e.g. `new-i64`). This is generic-by-name: when `new-f64` exists, `new(f64)`
// routes to it automatically. A type expression is inherently comptime, so this
// must be a [transform] — a plain event taking the type as an Expression would make
// the whole flow comptime. The branches (`| list` / `| err`) carry over to
// the concrete constructor unchanged.
//
// A PROTO element routes to SYNTHESIS, not a hand-written constructor: the
// element's fields are read from the `std/types.proto(<Name>)` declaration
// flow's body source (the `source:` argument), and the container the entry
// promises to derive is appended into this flow's module exactly once per
// element name. The dedupe marker is the REWRITTEN FIRST SITE: a later site
// counting a `new-<Name>` invocation already present in the program skips
// synthesis and rewrites to the same event the first site's units announced.
// No heap state.
~[comptime|transform]pub tor new {
    expr: Expression,
    invocation: *const Invocation,
    item: *const Item,
    program: *const Program,
    reporter: *std/compiler:ErrorReporter,
    allocator: std.mem.Allocator
} -> SiteResult

~proc new|zig {
    const ast = @import("ast");

    const flow = if (item.* == .flow) &item.flow else @panic("std/list:new: expected a flow site");

    // Element type as written, e.g. "i64" or "app/car:Engine".
    const elem = std.mem.trim(u8, expr, " \t");

    // A primitive keeps the old single-segment hand-written route; a proto
    // entry goes through synthesis.
    const proto_name = protoEntryName(allocator, elem);
    const is_proto_elem = if (proto_name) |pn| programHasProto(program, pn) else false;

    var appended_items: []const ast.Item = &.{};

    // The stage loop can re-fire this same site after its own successful
    // splice (the walker revisits the rewritten tree), and a NESTED
    // `std/list:new(<proto>)` site reaches this handler through a synthetic
    // site-view whose wrapper fields are not the real flow's. `hasRewrittenNew`
    // is the dedupe marker for the re-fired case — the container already
    // exists, so this pass just rewrites its call site. Refusing there made
    // the re-fire fatal (KORU173 on an already-synthesized program).
    const routed_name = if (is_proto_elem) blk: {
        if (!hasRewrittenNew(program, proto_name.?)) {
            appended_items = synthesizeContainer(allocator, program, flow, proto_name.?, elem);
            if (appended_items.len == 0) {
                return .{ .replacement = ast.refusal(allocator, reporter, .KORU173, flow.location, flow.module, "std/list:new({s}): container synthesis produced no units — the proto entry was not found or has no parseable fields", .{elem}) };
            }
        }
        break :blk proto_name.?;
    } else elem;

    const seg = std.fmt.allocPrint(allocator, "new-{s}", .{routed_name}) catch unreachable;
    const new_segments = allocator.alloc([]const u8, 1) catch unreachable;
    new_segments[0] = seg;

    // The rewrite addresses the module the ROUTED CONSTRUCTOR lives in.
    // A primitive constructor stays in std.list — its hand-written home;
    // stamping the caller's module here minted `<entry>:new-i64`, a tor no
    // module declares (KORU040 on every primitive `new(i64)` site). A proto
    // container's constructor is SYNTHESIZED into the caller's module, so it
    // must be addressed there: appended items never get canonicalized, the
    // path is spelled from the start.
    const routed_qualifier: ?[]const u8 = if (is_proto_elem)
        allocator.dupe(u8, flow.module) catch unreachable
    else if (invocation.path.module_qualifier) |mq|
        allocator.dupe(u8, mq) catch unreachable
    else
        null;
    const new_inv = ast.Invocation{
        .path = ast.DottedPath{
            .module_qualifier = routed_qualifier,
            .segments = new_segments,
        },
        .args = &[_]ast.Arg{},
    };

    // Ops over THIS site's bindings route to the synthesized suffixed events
    // (`std/list:push(xs, …)` → `<caller>:push-<Name>(xs, …)`), resolved from
    // the names the site's own branches bind. A handle used in a LATER flow
    // still refuses loudly at the shape check — the sliced-scope boundary the
    // module header states.
    const carried = if (is_proto_elem)
        rewriteProtoOps(allocator, flow.module, flow.body.continuations, routed_name)
    else
        flow.body.continuations;

    const new_item = ast.Item{
        .flow = ast.Flow{
            .body = ast.rootSite(new_inv, carried, flow.location),
            .pre_label = if (flow.pre_label) |l| allocator.dupe(u8, l) catch unreachable else null,
            .impl_of = flow.impl_of,
            .super_shape = null,
            .inline_body = null,
            .preamble_code = null,
            .is_pure = flow.is_pure,
            .is_transitively_pure = flow.is_transitively_pure,
            .location = flow.location,

            .module = allocator.dupe(u8, flow.module) catch unreachable,
        },
    };

    return .{ .replacement = new_item, .appended = appended_items };
}



fn protoNameDbg(prog: *const astz.Program, elem: []const u8) bool {
    if (findProtoDecl(prog, elem) != null) return true;
    if (programHasProto(prog, elem)) return true;
    return false;
}

// Concrete i64 constructor (runtime). `new(i64)` rewrites to this. Carries the
// <list!> ownership obligation.
~pub tor new-i64 {}
| list *List_i64<list!>
| err string

~proc new-i64|zig {
    const allocator = koru_allocator();
    const self = allocator.create(List_i64) catch {
        return .{ .err = "allocation failed" };
    };
    self.* = .{
        .items = std.ArrayList(i64).initCapacity(allocator, 0) catch {
            allocator.destroy(self);
            return .{ .err = "allocation failed" };
        },
        .allocator = allocator,
    };
    return .{ .list = self };
}

// ============================================
// Mutation (borrow — obligation untouched)
// ============================================

// Append a value. Void, chains with `|>`. OOM panics (the approved split: a
// growable push is loud-on-failure, not a per-call error branch).
//
// PROTO containers route by the DISPATCH-GAP doctrine (660_026): events lower
// keyed by NAME only, so every concrete container gets its OWN suffixed
// events. `push(xs, v)` over the hand-written i64 trunk stays monomorphic
// HERE; a proto-derived container's op is the SYNTHESIZED `push-<Name>` the
// container's constructor mints alongside it (see the synthesis section).
// The unified overload-by-container dispatch is the post-milestone gap
// (660_026 red pin), not this rung's surface.
~[comptime|transform]pub tor push {
    invocation: *const Invocation,
    item: *const Item,
    program: *const Program,
    allocator: std.mem.Allocator
} -> SiteResult

~proc push|zig {
    if (item.* != .flow) @panic("std/list:push transform: containing item is not a flow");
    return routeOpCall(allocator, program, &item.flow, "push", invocation);
}

~pub tor push-i64 { xs: *List_i64<list>, v: i64 }

~proc push-i64|zig {
    xs.items.append(xs.allocator, v) catch {
        @panic("std/list:push — out of memory");
    };
}

// ============================================
// Read (borrow)
// ============================================

// Current length as a scalar. (The `xs.len` expression form rides a separate
// bridge; this event is the plain call form.)
~[comptime|transform]pub tor len {
    invocation: *const Invocation,
    item: *const Item,
    program: *const Program,
    allocator: std.mem.Allocator
} -> SiteResult

~proc len|zig {
    if (item.* != .flow) @panic("std/list:len transform: containing item is not a flow");
    return routeOpCall(allocator, program, &item.flow, "len", invocation);
}

~pub tor len-i64 { xs: *List_i64<list> } -> usize

~proc len-i64|zig {
    return xs.items.items.len;
}

// Random access by index. <list> borrow — read, list untouched. `out-of-bounds`
// when i is past the end.
~[comptime|transform]pub tor get {
    invocation: *const Invocation,
    item: *const Item,
    program: *const Program,
    allocator: std.mem.Allocator
} -> SiteResult

~proc get|zig {
    if (item.* != .flow) @panic("std/list:get transform: containing item is not a flow");
    return routeOpCall(allocator, program, &item.flow, "get", invocation);
}

~pub tor get-i64 { xs: *List_i64<list>, i: usize }
| item i64
| out-of-bounds

~proc get-i64|zig {
    if (i < xs.items.items.len) {
        return .{ .item = xs.items.items[i] };
    }
    return .out_of_bounds;
}

// Remove and return the last element. <list> borrow: the list stays alive (the
// binding keeps <list!>), so it can be popped again or freed. `empty` when there
// is nothing to pop. For scalar elements the popped value carries no obligation.
~[comptime|transform]pub tor pop {
    invocation: *const Invocation,
    item: *const Item,
    program: *const Program,
    allocator: std.mem.Allocator
} -> SiteResult

~proc pop|zig {
    if (item.* != .flow) @panic("std/list:pop transform: containing item is not a flow");
    return routeOpCall(allocator, program, &item.flow, "pop", invocation);
}

~pub tor pop-i64 { xs: *List_i64<list> }
| item i64
| empty

~proc pop-i64|zig {
    if (xs.items.pop()) |v| {
        return .{ .item = v };
    }
    return .empty;
}

~[comptime|transform]pub tor free {
    invocation: *const Invocation,
    item: *const Item,
    program: *const Program,
    allocator: std.mem.Allocator
} -> SiteResult

~proc free|zig {
    if (item.* != .flow) @panic("std/list:free transform: containing item is not a flow");
    return routeOpCall(allocator, program, &item.flow, "free", invocation);
}

~pub tor free-i64 { xs: *List_i64<!list> }

~proc free-i64|zig {
    xs.deinit();
}

// Concrete i64 constructor + trunk ops: `new(i64)` routes to `new-i64`, and
// every op tor is a [transform] that routes by handle — i64 handles to the
// `-i64` trunk event, proto handles to the synthesized `op-<Name>`. The
// unsuffixed op spellings never lower directly. (A proto container's ops are
// all synthesized under the container's own suffix — `push-Engine`,
// `pop-Engine`, … — so two protos' containers never collide on one event name.)

// ============================================
// PROTO-DERIVED CONTAINER SYNTHESIS — host half
// ============================================
// These helpers run inside the compiler (comptime land). They read proto
// declaration flows out of the program AST (findShapeSource — the walk
// std/store uses to find watch bodies) and synthesize the container units into
// the CALLER's module. Everything here is Zig embedded in the .kz — the same
// mechanism std/types:string, std/store, std/field use for their host bodies.

const astz = ast_find;

/// Bare entry name a proto-qualified element expression names, or null for a
/// primitive. `i64` -> null; `Engine` -> "Engine"; `app/car:Engine` -> "Engine".
fn protoEntryName(alloc: std.mem.Allocator, elem: []const u8) ?[]const u8 {
    const trimmed = std.mem.trim(u8, elem, " \t");
    if (trimmed.len == 0) return null;
    const name = if (std.mem.lastIndexOfScalar(u8, trimmed, ':')) |ci|
        std.mem.trim(u8, trimmed[ci + 1 ..], " \t")
    else
        trimmed;
    if (name.len == 0) return null;
    const primitives = [_][]const u8{ "i64", "i32", "i16", "i8", "u64", "u32", "u16", "u8", "f64", "f32", "bool", "usize", "string", "void", "char" };
    for (primitives) |p| {
        if (std.mem.eql(u8, name, p)) return null;
    }
    return alloc.dupe(u8, name) catch unreachable;
}

const ProtoFields = struct {
    names: []const []const u8,
    types: []const []const u8,
};

/// True when a continuation tree carries a `new-<elem>` invocation — the
/// rewritten marker of a container's first synthesis site.
fn contHasNew(cont: *const astz.Continuation, want: []const u8) bool {
    if (cont.node) |*n| {
        if (n.* == .invocation) {
            const inv = &n.invocation;
            if (inv.path.segments.len == 1 and std.mem.eql(u8, inv.path.segments[0], want)) return true;
        }
    }
    for (cont.continuations) |c| {
        if (contHasNew(&c, want)) return true;
    }
    return false;
}
fn hasRewrittenNew(prog: *const astz.Program, elem: []const u8) bool {
    const prefix = std.fmt.allocPrint(std.heap.page_allocator, "new-{s}", .{elem}) catch unreachable;
    const N = struct {
        fn has(items: []const astz.Item, want: []const u8) bool {
            for (items) |pi| {
                switch (pi) {
                    .flow => |*f| {
                        if (contHasNew(&f.body, want)) return true;
                    },
                    .module_decl => |*m| {
                        if (has(m.items, want)) return true;
                    },
                    else => {},
                }
            }
            return false;
        }
    };
    return N.has(prog.items, prefix);
}

/// The proto declaration flow an element expression names. `elem` may be bare
/// (`Engine`) or module-qualified (`app/car:Engine`); the entry is matched on
/// the bare name, and a qualifier additionally requires the declaring module.
/// Duplicate names across the whole program are refused by the checker's proto
/// scan (the loud two-registrant wall), so a bare match is unambiguous.
fn findProtoDecl(prog: *const astz.Program, elem: []const u8) ?*const astz.Flow {
    const trimmed = std.mem.trim(u8, elem, " \t");
    const want_name = if (std.mem.lastIndexOfScalar(u8, trimmed, ':')) |ci|
        std.mem.trim(u8, trimmed[ci + 1 ..], " \t")
    else
        trimmed;
    var want_mod: ?[]const u8 = null;
    if (std.mem.lastIndexOfScalar(u8, trimmed, ':')) |ci| {
        const qual = std.mem.trim(u8, trimmed[0..ci], " \t");
        if (qual.len > 0) {
            const dotted = std.mem.replaceOwned(u8, std.heap.page_allocator, qual, "/", ".") catch unreachable;
            want_mod = dotted;
        }
    }
    const Finder = struct {
        fn invokesProto(f: *const astz.Flow, name: []const u8, mod: ?[]const u8) bool {
            const inv = f.inv();
            if (inv.path.segments.len != 1) return false;
            const verb = inv.path.segments[0];
            const mq = inv.path.module_qualifier orelse return false;
            // Two doors to the same registry entry: the original
            // `std/types:proto(Name)` verb form, and the default-door form
            // `std/proto(Name)` ≡ `std/proto:default(Name)` that the
            // default-event rule rewrites a bare module call into
            // (import_pipeline.zig rewriteDefaultEventCalls; the post-rewrite
            // mq is the canonical dotted path "std.proto").
            const types_door = std.mem.eql(u8, verb, "proto") and
                (std.mem.eql(u8, mq, "std.types") or std.mem.eql(u8, mq, "std/types"));
            const default_door = std.mem.eql(u8, verb, "default") and
                (std.mem.eql(u8, mq, "std.proto") or std.mem.eql(u8, mq, "std/proto"));
            if (!(types_door or default_door)) return false;
            if (inv.args.len == 0) return false;
            var nm = inv.args[0].value;
            if (nm.len >= 2 and nm[0] == '"' and nm[nm.len - 1] == '"') nm = nm[1 .. nm.len - 1];
            if (!std.mem.eql(u8, nm, name)) return false;
            if (mod) |m| {
                if (f.module.len > 0 and std.mem.eql(u8, f.module, m)) return true;
                return false;
            }
            return true;
        }
        fn findIn(items: []const astz.Item, name: []const u8, mod: ?[]const u8) ?*const astz.Flow {
            for (items) |pi| {
                switch (pi) {
                    .flow => |*f| {
                        if (invokesProto(f, name, mod)) return f;
                    },
                    .module_decl => |*m| {
                        if (findIn(m.items, name, mod)) |hit| return hit;
                    },
                    else => {},
                }
            }
            return null;
        }
    };
    return Finder.findIn(prog.items, want_name, want_mod);
}

/// True when the program carries the proto entry `elem` in EITHER of the two
/// forms the transform fixed point leaves behind: the declaration flow
/// (pre-erase) or the self-erased `// proto <Name>: ...` marker comment
/// (post-erase). Pass ordering decides which form a `std/list:new` site sees —
/// a proto declared EARLIER in the file erases first, and detection keyed on
/// the live flow alone then misroutes a proto element as a primitive
/// (`new-Engine` with no such tor → KORU040).
fn programHasProto(prog: *const astz.Program, elem: []const u8) bool {
    if (findProtoDecl(prog, elem)) |_| return true;
    const trimmed = std.mem.trim(u8, elem, " \t");
    const want_name = if (std.mem.lastIndexOfScalar(u8, trimmed, ':')) |ci|
        std.mem.trim(u8, trimmed[ci + 1 ..], " \t")
    else
        trimmed;
    var want_mod: ?[]const u8 = null;
    if (std.mem.lastIndexOfScalar(u8, trimmed, ':')) |ci| {
        const qual = std.mem.trim(u8, trimmed[0..ci], " \t");
        if (qual.len > 0) {
            want_mod = std.mem.replaceOwned(u8, std.heap.page_allocator, qual, "/", ".") catch unreachable;
        }
    }
    const Marker = struct {
        fn matches(ic: *const astz.InlineCode, name: []const u8, mod: ?[]const u8) bool {
            const prefix = "// proto ";
            if (!std.mem.startsWith(u8, ic.code, prefix)) return false;
            const colon = std.mem.indexOfScalar(u8, ic.code, ':') orelse return false;
            if (!std.mem.eql(u8, std.mem.trim(u8, ic.code[prefix.len..colon], " \t"), name)) return false;
            if (mod) |m| {
                if (ic.module.len > 0 and std.mem.eql(u8, ic.module, m)) return true;
                return false;
            }
            return true;
        }
        fn find(items: []const astz.Item, name: []const u8, mod: ?[]const u8) bool {
            for (items) |pi| {
                switch (pi) {
                    .inline_code => |*ic| {
                        if (matches(ic, name, mod)) return true;
                    },
                    .module_decl => |*m| {
                        if (find(m.items, name, mod)) return true;
                    },
                    else => {},
                }
            }
            return false;
        }
    };
    return Marker.find(prog.items, want_name, want_mod);
}

/// The fields of a proto declaration flow, parsed from its `source:` argument's
/// text (`rpm: i32, serial: string`).
fn protoFieldsOf(alloc: std.mem.Allocator, decl: *const astz.Flow) ProtoFields {
    const inv = decl.inv();
    var src: ?[]const u8 = null;
    for (inv.args) |a| {
        if (a.source_value) |sv| {
            src = sv.text;
            break;
        }
    }
    const text = src orelse return .{ .names = &.{}, .types = &.{} };
    // First pass: count the fields.
    var count: usize = 0;
    var lines1 = std.mem.splitScalar(u8, text, '\n');
    while (lines1.next()) |line_raw| {
        const line = std.mem.trim(u8, line_raw, " \t\r,");
        if (line.len == 0) continue;
        const colon = std.mem.indexOfScalar(u8, line, ':') orelse continue;
        const fname = std.mem.trim(u8, line[0..colon], " \t");
        const ftype = std.mem.trim(u8, line[colon + 1 ..], " \t,");
        if (fname.len > 0 and ftype.len > 0) count += 1;
    }
    const names = alloc.alloc([]const u8, count) catch unreachable;
    const types = alloc.alloc([]const u8, count) catch unreachable;
    var w: usize = 0;
    var lines2 = std.mem.splitScalar(u8, text, '\n');
    while (lines2.next()) |line_raw| {
        const line = std.mem.trim(u8, line_raw, " \t\r,");
        if (line.len == 0) continue;
        const colon = std.mem.indexOfScalar(u8, line, ':') orelse continue;
        const fname = std.mem.trim(u8, line[0..colon], " \t");
        const ftype = std.mem.trim(u8, line[colon + 1 ..], " \t,");
        if (fname.len == 0 or ftype.len == 0) continue;
        names[w] = alloc.dupe(u8, fname) catch unreachable;
        types[w] = alloc.dupe(u8, ftype) catch unreachable;
        w += 1;
    }
    return .{ .names = names[0..w], .types = types[0..w] };
}

/// The fields of a proto entry, from whichever representation the walker's
/// fixed point has left: the declaration flow (pre-self-erase) or the erased
/// `// proto Name: fields` comment. `elem` may be module-qualified.
fn protoFieldsOfProgram(alloc: std.mem.Allocator, prog: *const astz.Program, elem: []const u8) ProtoFields {
    if (findProtoDecl(prog, elem)) |decl| {
        return protoFieldsOf(alloc, decl);
    }
    const trimmed = std.mem.trim(u8, elem, " \t");
    const want_name = if (std.mem.lastIndexOfScalar(u8, trimmed, ':')) |ci|
        std.mem.trim(u8, trimmed[ci + 1 ..], " \t")
    else
        trimmed;
    const N = struct {
        fn find(items: []const astz.Item, name: []const u8, out: *?[]const u8) bool {
            for (items) |pi| {
                switch (pi) {
                    .inline_code => |ic| {
                        const c = ic.code;
                        const prefix = "// proto ";
                        if (std.mem.startsWith(u8, c, prefix)) {
                            if (std.mem.indexOfScalar(u8, c, ':')) |colon| {
                                if (std.mem.eql(u8, std.mem.trim(u8, c[prefix.len..colon], " \t"), name)) {
                                    out.* = c[colon + 1 ..];
                                    return true;
                                }
                            }
                        }
                    },
                    .module_decl => |*m| {
                        if (find(m.items, name, out)) return true;
                    },
                    else => {},
                }
            }
            return false;
        }
    };
    var rest: ?[]const u8 = null;
    _ = N.find(prog.items, want_name, &rest);
    const text = rest orelse return .{ .names = &.{}, .types = &.{} };
    // Parse the trailing fields text like a proto body source. The erased
    // marker is ONE line (`// proto Name: f: t, g: u`), so fields separate on
    // ',' as well as '\n'.
    var count: usize = 0;
    var lines1 = std.mem.tokenizeAny(u8, text, "\n,");
    while (lines1.next()) |line_raw| {
        const line = std.mem.trim(u8, line_raw, " \t\r,");
        if (line.len == 0) continue;
        const colon = std.mem.indexOfScalar(u8, line, ':') orelse continue;
        const fname = std.mem.trim(u8, line[0..colon], " \t");
        const ftype = std.mem.trim(u8, line[colon + 1 ..], " \t,");
        if (fname.len > 0 and ftype.len > 0) count += 1;
    }
    const names = alloc.alloc([]const u8, count) catch unreachable;
    const types = alloc.alloc([]const u8, count) catch unreachable;
    var w: usize = 0;
    var lines2 = std.mem.tokenizeAny(u8, text, "\n,");
    while (lines2.next()) |line_raw| {
        const line = std.mem.trim(u8, line_raw, " \t\r,");
        if (line.len == 0) continue;
        const colon = std.mem.indexOfScalar(u8, line, ':') orelse continue;
        const fname = std.mem.trim(u8, line[0..colon], " \t");
        const ftype = std.mem.trim(u8, line[colon + 1 ..], " \t,");
        if (fname.len == 0 or ftype.len == 0) continue;
        names[w] = alloc.dupe(u8, fname) catch unreachable;
        types[w] = alloc.dupe(u8, ftype) catch unreachable;
        w += 1;
    }
    return .{ .names = names[0..w], .types = types[0..w] };
}

/// The element a container handle was bound from, found in the enclosing flow:
/// a `std/list:new(<elem>)` invocation whose binding branch carries the handle.
/// The new transform rewrites `new` -> `new-<elem>` in place, so the scan keys
/// on the REWRITTEN segment prefix.



/// Zig type for a proto field type string (`string` lowers at the emission
/// boundary; the struct body needs the Zig slice form today).
fn elementZigType(alloc: std.mem.Allocator, ftype: []const u8) []const u8 {
    if (std.mem.eql(u8, ftype, "string")) return alloc.dupe(u8, "[]const u8") catch unreachable;
    return alloc.dupe(u8, ftype) catch unreachable;
}

/// A synthesized event decl + its `|zig` proc, appended as two Items.
fn synthOp(
    allocator: std.mem.Allocator,
    flow: *const astz.Flow,
    name: []const u8,
    input_fields: []const astz.Field,
    branches: []const astz.Branch,
    return_type: ?[]const u8,
    proc_body: []const u8
) [2]astz.Item {
    const path = astz.DottedPath{
        .module_qualifier = allocator.dupe(u8, flow.module) catch unreachable,
        .segments = blk: {
            const segs = allocator.alloc([]const u8, 1) catch unreachable;
            segs[0] = allocator.dupe(u8, name) catch unreachable;
            break :blk segs;
        },
    };
    const ed = astz.Item{ .event_decl = astz.EventDecl{
        .path = path,
        .input = astz.Shape{ .fields = input_fields },
        .branches = branches,
        .return_type = return_type,
        .is_public = false,
        .is_implicit_flow = false,
        .annotations = &.{},
        .location = flow.location,
        .module = allocator.dupe(u8, flow.module) catch unreachable,
    } };
    const pd = astz.Item{ .proc_decl = astz.ProcDecl{
        .path = path,
        .body = astz.Source{
            .text = allocator.dupe(u8, proc_body) catch unreachable,
            .location = flow.location,
            .scope = .{ .bindings = &.{} },
            .phantom_type = null,
        },
        .annotations = &.{},
        .target = allocator.dupe(u8, "zig") catch unreachable,
        .location = flow.location,
        .module = allocator.dupe(u8, flow.module) catch unreachable,
    } };
    return .{ ed, pd };
}

/// The std/list ops a proto container's site routes to suffixed events.
fn isRoutedOp(name: []const u8) bool {
    const ops = [_][]const u8{ "push", "len", "get", "pop", "free" };
    for (ops) |op| {
        if (std.mem.eql(u8, name, op)) return true;
    }
    return false;
}

fn collectBinds(conts: []const astz.Continuation, bound: *std.StringHashMap(void)) void {
    for (conts) |*c| {
        if (c.binding) |b| bound.put(b, {}) catch unreachable;
        if (c.node) |*n| {
            if (n.* == .invocation) {
                if (n.invocation.return_binding) |rb| bound.put(rb, {}) catch unreachable;
            }
        }
        collectBinds(c.continuations, bound);
    }
}

fn rewriteConts(
    alloc: std.mem.Allocator,
    caller_module: []const u8,
    conts: []const astz.Continuation,
    elem: []const u8,
    bound: *std.StringHashMap(void)
) []const astz.Continuation {
    var out = std.ArrayList(astz.Continuation).initCapacity(alloc, conts.len) catch unreachable;
    for (conts) |c| {
        var nc = c;
        if (nc.node) |*n| {
            if (n.* == .invocation) {
                const inv = &n.invocation;
                if (inv.path.segments.len == 1 and inv.args.len > 0 and
                    isRoutedOp(inv.path.segments[0]))
                {
                    const target = std.mem.trim(u8, inv.args[0].value, " \t");
                    if (bound.contains(target)) {
                        var ni = inv.*;
                        const segs = alloc.alloc([]const u8, 1) catch unreachable;
                        segs[0] = std.fmt.allocPrint(alloc, "{s}-{s}", .{ inv.path.segments[0], elem }) catch unreachable;
                        ni.path = astz.DottedPath{
                            .module_qualifier = alloc.dupe(u8, caller_module) catch unreachable,
                            .segments = segs,
                        };
                        nc.node = .{ .invocation = ni };
                    }
                }
            }
        }
        nc.continuations = rewriteConts(alloc, caller_module, c.continuations, elem, bound);
        out.append(alloc, nc) catch unreachable;
    }
    return out.toOwnedSlice(alloc) catch unreachable;
}

/// Route the std/list ops called over THIS new site's own bindings to the
/// synthesized suffixed events in the caller's module. Scoped to the names the
/// site's branch tree binds (`| list xs` → `xs`): an op over any other name is
/// not this site's container and stays for the shape check to judge.
fn rewriteProtoOps(
    alloc: std.mem.Allocator,
    caller_module: []const u8,
    conts: []const astz.Continuation,
    elem: []const u8
) []const astz.Continuation {
    var bound = std.StringHashMap(void).init(alloc);
    defer bound.deinit();
    collectBinds(conts, &bound);
    return rewriteConts(alloc, caller_module, conts, elem, &bound);
}
/// True when a continuation subtree binds `name` — a branch binding
/// (`| list xs`) or a `: name` return binding. The same-flow half of op
/// routing keys on this: the `new(<elem>)` site whose subtree carries the
/// handle owns the element for that handle.
fn subtreeBinds(cont: *const astz.Continuation, name: []const u8) bool {
    if (cont.binding) |b| {
        if (std.mem.eql(u8, std.mem.trim(u8, b, " \t"), name)) return true;
    }
    if (cont.node) |*n| {
        if (n.* == .invocation) {
            if (n.invocation.return_binding) |rb| {
                if (std.mem.eql(u8, std.mem.trim(u8, rb, " \t"), name)) return true;
            }
        }
    }
    for (cont.continuations) |*cc| {
        if (subtreeBinds(cc, name)) return true;
    }
    return false;
}

/// The element for a handle bound in the SAME flow: the `new(<elem>)` /
/// `new-<elem>` site whose subtree binds it. Returns the element expression
/// (bare or qualified) or null when no site in this flow owns the handle.
fn flowNewElemForHandle(conts: []const astz.Continuation, handle: []const u8) ?[]const u8 {
    for (conts) |*c| {
        if (c.node) |*n| {
            if (n.* == .invocation) {
                const inv = &n.invocation;
                if (inv.path.segments.len == 1 and inv.args.len > 0) {
                    const seg = inv.path.segments[0];
                    var elem: ?[]const u8 = null;
                    if (std.mem.eql(u8, seg, "new")) {
                        elem = std.mem.trim(u8, inv.args[0].value, " \t");
                    } else if (std.mem.startsWith(u8, seg, "new-")) {
                        elem = seg["new-".len..];
                    }
                    if (elem) |e| {
                        if (subtreeBinds(c, handle)) return e;
                    }
                }
            }
        }
        if (flowNewElemForHandle(c.continuations, handle)) |e| return e;
    }
    return null;
}

/// True when a continuation's own triple is the site's.
fn locEq(loc: anytype, file: []const u8, line: usize, column: usize) bool {
    return std.mem.eql(u8, loc.file, file) and loc.line == line and loc.column == column;
}

/// True when a continuation tree holds the site triple — the root counts:
/// a nested view's body.node IS the firing site, and a creating flow's root
/// IS the `new` site its branch ops resolve against.
fn subtreeHasLocation(cont: *const astz.Continuation, file: []const u8, line: usize, column: usize) bool {
    if (locEq(cont.location, file, line, column)) return true;
    for (cont.continuations) |*c| {
        if (subtreeHasLocation(c, file, line, column)) return true;
    }
    return false;
}

/// The REAL flow containing this view's site, by source location. A nested
/// site reaches its transform through a synthetic view that sees only the
/// holding subtree: ancestors (the same-flow `new` site) and `impl_of` are
/// cut off. The location triple is unique program-wide, so the walk
/// re-anchors to the full tree. Preference order: a true container (whose own
/// root triple differs — the synthetic copy's root triple always equals the
/// site's, so the copy can never win this pass), then an `impl_of`-bearing
/// match, then the handed flow itself.
fn anchorFlow(program: *const astz.Program, flow: *const astz.Flow) *const astz.Flow {
    const loc = flow.body.location;
    if (anchorScan(program.items, loc.file, loc.line, loc.column, false)) |found| return found;
    if (anchorScan(program.items, loc.file, loc.line, loc.column, true)) |found| return found;
    return flow;
}

/// want_impl: false takes only true containers (root triple differs);
/// true takes only `impl_of`-bearers.
fn anchorScan(items: []const astz.Item, file: []const u8, line: usize, column: usize, want_impl: bool) ?*const astz.Flow {
    for (items) |*pi| {
        switch (pi.*) {
            .flow => |*f| {
                const root_differs = !locEq(f.body.location, file, line, column);
                const impl_ok = if (f.impl_of) |io| io.segments.len > 0 else false;
                const take = if (want_impl) impl_ok else root_differs;
                if (take and subtreeHasLocation(&f.body, file, line, column)) return f;
            },
            .module_decl => |*m| {
                if (anchorScan(m.items, file, line, column, want_impl)) |found| return found;
            },
            else => {},
        }
    }
    return null;
}

/// Same-flow element, root-inclusive: the creating flow's root IS the `new`
/// invocation, so a children-only scan misses exactly the site that matters.
fn flowElemForHandle(flow: *const astz.Flow, handle: []const u8) ?[]const u8 {
    if (flow.body.node) |*n| {
        if (n.* == .invocation) {
            const inv = &n.invocation;
            if (inv.path.segments.len == 1 and inv.args.len > 0) {
                const seg = inv.path.segments[0];
                var elem: ?[]const u8 = null;
                if (std.mem.eql(u8, seg, "new")) {
                    elem = std.mem.trim(u8, inv.args[0].value, " \t");
                } else if (std.mem.startsWith(u8, seg, "new-")) {
                    elem = seg["new-".len..];
                }
                if (elem) |e| {
                    for (flow.body.continuations) |*c| {
                        if (subtreeBinds(c, handle)) return e;
                    }
                }
            }
        }
    }
    return flowNewElemForHandle(flow.body.continuations, handle);
}
/// The element for a handle arriving as a tor PARAMETER: the enclosing tor's
/// input field type names the container (`*List_<Name>`), and the name IS the
/// element. `tor_name` comes from the anchor flow's `impl_of`, recovered by
/// location when the site arrived through a synthetic view.
fn torParamHandleElem(program: *const astz.Program, tor_name: ?[]const u8, handle: []const u8) ?[]const u8 {
    const want = tor_name orelse return null;
    for (program.items) |*pi| {
        const decl = switch (pi.*) {
            .event_decl => |*d| d,
            else => continue,
        };
        if (decl.path.segments.len == 0) continue;
        if (!std.mem.eql(u8, decl.path.segments[decl.path.segments.len - 1], want)) continue;
        for (decl.input.fields) |field| {
            if (!std.mem.eql(u8, field.name, handle)) continue;
            const prefix = "*List_";
            if (!std.mem.startsWith(u8, field.type, prefix)) return null;
            const rest = field.type[prefix.len..];
            const name = if (std.mem.lastIndexOfScalar(u8, rest, ':')) |ci| rest[ci + 1 ..] else rest;
            if (name.len == 0) return null;
            return name;
        }
        return null;
    }
    return null;
}

/// Bare element name (`Engine` from `Engine` or `app/car:Engine`), the key
/// synthesis and sibling sites are counted under.
fn elemBare(elem: []const u8) []const u8 {
    const trimmed = std.mem.trim(u8, elem, " \t");
    if (std.mem.lastIndexOfScalar(u8, trimmed, ':')) |ci| return trimmed[ci + 1 ..];
    return trimmed;
}

/// True when some flow in the program carries a `new(<elem>)` / `new-<elem>`
/// site: the container WILL be synthesized (or already was), so routing an
/// op to it cannot dangle — regardless of whether that site's own transform
/// has fired yet. Order-proof where `hasRewrittenNew` alone is not: a tor
/// parameter site textually before the `new` site.
fn programHasNewSite(program: *const astz.Program, elem: []const u8) bool {
    const want = elemBare(elem);
    for (program.items) |*pi| {
        switch (pi.*) {
            .flow => |*f| {
                if (flowHoldsNewSite(f, want)) return true;
            },
            .module_decl => |*m| {
                for (m.items) |*mi| {
                    if (mi.* == .flow) {
                        if (flowHoldsNewSite(&mi.flow, want)) return true;
                    }
                }
            },
            else => {},
        }
    }
    return false;
}

fn programHasNewSiteInConts(conts: []const astz.Continuation, needle: []const u8) bool {
    for (conts) |*c| {
        if (c.node) |*n| {
            if (n.* == .invocation) {
                const inv = &n.invocation;
                if (inv.path.segments.len == 1) {
                    const seg = inv.path.segments[0];
                    if (std.mem.eql(u8, seg, "new") and inv.args.len > 0) {
                        const arg_elem = std.mem.trim(u8, inv.args[0].value, " \t");
                        if (std.mem.eql(u8, elemBare(arg_elem), needle)) return true;
                    } else if (std.mem.startsWith(u8, seg, "new-")) {
                        if (std.mem.eql(u8, seg["new-".len..], needle)) return true;
                    }
                }
            }
        }
        if (programHasNewSiteInConts(c.continuations, needle)) return true;
    }
    return false;
}

/// A flow carries a `new(<elem>)` site at its root or in its tree. The
/// creating flow's root IS the `new` invocation — children-only scans miss
/// exactly the program's own construction site.
fn flowHoldsNewSite(flow: *const astz.Flow, want: []const u8) bool {
    if (flow.body.node) |*n| {
        if (n.* == .invocation) {
            const inv = &n.invocation;
            if (inv.path.segments.len == 1) {
                const seg = inv.path.segments[0];
                if (std.mem.eql(u8, seg, "new") and inv.args.len > 0) {
                    if (std.mem.eql(u8, elemBare(std.mem.trim(u8, inv.args[0].value, " \t")), want)) return true;
                } else if (std.mem.startsWith(u8, seg, "new-")) {
                    if (std.mem.eql(u8, seg["new-".len..], want)) return true;
                }
            }
        }
    }
    return programHasNewSiteInConts(flow.body.continuations, want);
}

/// Whole-tree rewrite of one handle's bare op sites to a suffixed target.
/// `rewriteConts` covers the proto case (caller-module qualifier); this
/// covers the legacy fallback (original qualifier preserved) with the same
/// single-handle scoping, so one firing never reroutes a sibling container.
fn rewriteOpHandle(
    alloc: std.mem.Allocator,
    conts: []const astz.Continuation,
    op: []const u8,
    handle: []const u8,
    target_seg: []const u8,
    target_qual: ?[]const u8,
) []const astz.Continuation {
    var out = std.ArrayList(astz.Continuation).initCapacity(alloc, conts.len) catch unreachable;
    for (conts) |c| {
        var nc = c;
        if (nc.node) |*n| {
            if (n.* == .invocation) {
                const inv = &n.invocation;
                if (inv.path.segments.len == 1 and inv.args.len > 0 and
                    std.mem.eql(u8, inv.path.segments[0], op))
                {
                    const target = std.mem.trim(u8, inv.args[0].value, " \t");
                    if (std.mem.eql(u8, target, handle)) {
                        var ni = inv.*;
                        const segs = alloc.alloc([]const u8, 1) catch unreachable;
                        segs[0] = alloc.dupe(u8, target_seg) catch unreachable;
                        ni.path = astz.DottedPath{
                            .module_qualifier = if (target_qual) |q| alloc.dupe(u8, q) catch unreachable else null,
                            .segments = segs,
                        };
                        nc.node = .{ .invocation = ni };
                    }
                }
            }
        }
        nc.continuations = rewriteOpHandle(alloc, c.continuations, op, handle, target_seg, target_qual);
        out.append(alloc, nc) catch unreachable;
    }
    return out.toOwnedSlice(alloc) catch unreachable;
}

/// Shared body for the five op transforms. TOTAL: every `std/list:<op>` site
/// is rewritten — proto handles to `op-<Name>` in the caller's module,
/// everything else to the legacy `op-i64` trunk with the original qualifier.
/// Never a passthrough (a transform tor has no runtime lowering to fall back
/// to), never a dangle (proto routes require a program `new` site or an
/// already-synthesized container). Suffixed names never re-fire the tor, so
/// the walker converges.
fn routeOpCall(
    allocator: std.mem.Allocator,
    program: *const astz.Program,
    flow: *const astz.Flow,
    op: []const u8,
    inv: *const astz.Invocation,
) astz.SiteResult {
    const handle = if (inv.args.len > 0) std.mem.trim(u8, inv.args[0].value, " \t") else "";
    // Re-anchor: a nested site arrives through a synthetic view holding only
    // the site subtree — ancestors and `impl_of` are cut off. The location
    // triple re-anchors to the real containing flow with the full tree.
    const anchor = anchorFlow(program, flow);
    var tor_name: ?[]const u8 = null;
    if (anchor.impl_of) |io| {
        if (io.segments.len > 0) tor_name = io.segments[io.segments.len - 1];
    }
    var elem: ?[]const u8 = null;
    if (handle.len > 0) {
        if (flowElemForHandle(anchor, handle)) |e| elem = e;
        if (elem == null) {
            if (torParamHandleElem(program, tor_name, handle)) |e| elem = e;
        }
    }
    var proto_route = false;
    if (elem) |e| {
        proto_route = programHasProto(program, e) and
            (programHasNewSite(program, e) or hasRewrittenNew(program, e));
    }
    var target_seg: []const u8 = undefined;
    var target_qual: ?[]const u8 = undefined;
    if (proto_route) {
        target_seg = std.fmt.allocPrint(allocator, "{s}-{s}", .{ op, elemBare(elem.?) }) catch unreachable;
        target_qual = allocator.dupe(u8, flow.module) catch unreachable;
    } else {
        target_seg = std.fmt.allocPrint(allocator, "{s}-i64", .{op}) catch unreachable;
        target_qual = if (inv.path.module_qualifier) |q| allocator.dupe(u8, q) catch unreachable else null;
    }
    const new_conts = rewriteOpHandle(allocator, flow.body.continuations, op, handle, target_seg, target_qual);
    var new_flow = flow.*;
    new_flow.body.continuations = new_conts;
    // The site itself: a nested view's body.node IS the firing invocation,
    // and the children walk above never touches it. Leave it and the
    // circuit-breaker fires (1 before, 1 after) on an otherwise perfect
    // rewrite.
    if (handle.len > 0) {
        if (new_flow.body.node) |*n| {
            if (n.* == .invocation) {
                const root_inv = &n.invocation;
                if (root_inv.path.segments.len == 1 and
                    std.mem.eql(u8, root_inv.path.segments[0], op) and
                    root_inv.args.len > 0 and
                    std.mem.eql(u8, std.mem.trim(u8, root_inv.args[0].value, " \t"), handle))
                {
                    var ni = root_inv.*;
                    const segs = allocator.alloc([]const u8, 1) catch unreachable;
                    segs[0] = allocator.dupe(u8, target_seg) catch unreachable;
                    ni.path = astz.DottedPath{
                        .module_qualifier = if (target_qual) |q| allocator.dupe(u8, q) catch unreachable else null,
                        .segments = segs,
                    };
                    new_flow.body.node = .{ .invocation = ni };
                }
            }
        }
    }
    return .{ .replacement = astz.Item{ .flow = new_flow } };
}


/// Synthesize the container units for a proto element into the caller's module:
/// element + handle structs (inline_code), then the six op events and their
/// `|zig` procs (new/push/len/get/pop/free).
fn synthesizeContainer(
    allocator: std.mem.Allocator,
    program: *const astz.Program,
    flow: *const astz.Flow,
    proto_name: []const u8,
    elem_expr: []const u8
) []const astz.Item {
    
    const list_name = std.fmt.allocPrint(allocator, "List_{s}", .{proto_name}) catch unreachable;
    // The proto declaration's fields (see protoFieldsOfProgram).
    const pf = protoFieldsOfProgram(allocator, program, elem_expr);
    if (pf.names.len == 0) @panic("proto-fields-empty");

    // NEWTYPE reading this rung: the container stores the entry's FIRST
    // field's type. The entry's job is the IDENTITY (frag-type-system-design:
    // two protos over the same shape never interchange — refused at the KORU
    // layer by name), and every probe surface pushes the field value
    // (`std/list:push(xs, v: 10)` over `proto(Engine) { rpm: i32 }`); a record
    // has no construction surface yet. The full record struct is still emitted
    // below as the registry's readable content.
    const elem_zig = elementZigType(allocator, pf.types[0]);


    var units = std.ArrayList(astz.Item).initCapacity(allocator, 13) catch unreachable;

    // 1. Element alias + List_<Name> handle struct (inline_code into the
    //    caller's module). The entry is a NEWTYPE this rung: `pub const
    //    Engine = i32;` — the same lowering std/types:string uses — so the
    //    synthesized ops can declare their element slots under the PROTO NAME
    //    (`v: Engine`) while Zig sees the underlying scalar. The name is what
    //    carries the identity: two protos over one shape never interchange
    //    (the KORU030 nominal gate), even though both lower to i32 here.
    {
        var sb = std.ArrayList(u8).initCapacity(allocator, 128) catch unreachable;
        sb.appendSlice(allocator, "pub const ") catch unreachable;
        sb.appendSlice(allocator, proto_name) catch unreachable;
        sb.appendSlice(allocator, " = ") catch unreachable;
        sb.appendSlice(allocator, elem_zig) catch unreachable;
        sb.appendSlice(allocator, ";\n") catch unreachable;
        sb.appendSlice(allocator, "pub const ") catch unreachable;
        sb.appendSlice(allocator, list_name) catch unreachable;
        sb.appendSlice(allocator, " = struct {\n    items: @import(\"std\").ArrayList(") catch unreachable;
        sb.appendSlice(allocator, elem_zig) catch unreachable;
        sb.appendSlice(allocator, "),\n    allocator: @import(\"std\").mem.Allocator,\n    fn deinit(self: *") catch unreachable;
        sb.appendSlice(allocator, list_name) catch unreachable;
        sb.appendSlice(allocator, ") void {\n        self.items.deinit(self.allocator);\n        self.allocator.destroy(self);\n    }\n};\n") catch unreachable;
        units.append(allocator, astz.Item{ .inline_code = astz.InlineCode{
            .code = sb.toOwnedSlice(allocator) catch unreachable,
            .location = flow.location,
            .module = allocator.dupe(u8, flow.module) catch unreachable,
        } }) catch unreachable;
    }

    // 2. new-<Name> constructor: empty input, `| list` (obligation) + `| err`.
    {
        const list_ptr = listPtrType(allocator, list_name, "list!");
        const err_f = field1(allocator, "__type_ref", "string");
        const br = allocator.alloc(astz.Branch, 2) catch unreachable;
        br[0] = astz.Branch{
            .name = allocator.dupe(u8, "list") catch unreachable,
            .payload = astz.Shape{ .fields = fields1(allocator, list_ptr) },
            .kind = .terminal,
            .annotations = &.{},
        };
        br[1] = astz.Branch{
            .name = allocator.dupe(u8, "err") catch unreachable,
            .payload = astz.Shape{ .fields = fields1(allocator, err_f) },
            .kind = .terminal,
            .annotations = &.{},
        };
        const new_name = std.fmt.allocPrint(allocator, "new-{s}", .{proto_name}) catch unreachable;
        const body = std.fmt.allocPrint(
            allocator,
            "const allocator = koru_allocator();\nconst self = allocator.create({s}) catch {{\n    return .{{ .err = \"allocation failed\" }};\n}};\nself.* = .{{\n    .items = @import(\"std\").ArrayList({s}).initCapacity(allocator, 0) catch {{\n        allocator.destroy(self);\n        return .{{ .err = \"allocation failed\" }};\n    }},\n    .allocator = allocator,\n}};\nreturn .{{ .list = self }};",
            .{ list_name, elem_zig },
        ) catch unreachable;
        const pair = synthOp(allocator, flow, new_name, &.{}, br, null, body);
        units.append(allocator, pair[0]) catch unreachable;
        units.append(allocator, pair[1]) catch unreachable;
    }

    // 3. push-<Name>: (xs borrow, v element) -> void.
    {
        const op_name = std.fmt.allocPrint(allocator, "push-{s}", .{proto_name}) catch unreachable;
        const in = allocator.alloc(astz.Field, 2) catch unreachable;
        in[0] = field_s(allocator, "xs", list_name, "list");
        in[1] = field_plain(allocator, "v", pf.types[0]);
        const body = "xs.items.append(xs.allocator, v) catch {\n    @panic(\"std/list:push — out of memory\");\n};";
        const pair = synthOp(allocator, flow, op_name, in, &.{}, null, body);
        units.append(allocator, pair[0]) catch unreachable;
        units.append(allocator, pair[1]) catch unreachable;
    }

    // 4. len-<Name>: (xs borrow) -> usize.
    {
        const op_name = std.fmt.allocPrint(allocator, "len-{s}", .{proto_name}) catch unreachable;
        const in = allocator.alloc(astz.Field, 1) catch unreachable;
        in[0] = field_s(allocator, "xs", list_name, "list");
        const pair = synthOp(allocator, flow, op_name, in, &.{}, "usize", "return xs.items.items.len;");
        units.append(allocator, pair[0]) catch unreachable;
        units.append(allocator, pair[1]) catch unreachable;
    }

    // 5. get-<Name>: (xs borrow, i) -> | item T | out-of-bounds.
    {
        const op_name = std.fmt.allocPrint(allocator, "get-{s}", .{proto_name}) catch unreachable;
        const in = allocator.alloc(astz.Field, 2) catch unreachable;
        in[0] = field_s(allocator, "xs", list_name, "list");
        in[1] = field_plain(allocator, "i", "usize");
        const br = allocator.alloc(astz.Branch, 2) catch unreachable;
        br[0] = astz.Branch{
            .name = allocator.dupe(u8, "item") catch unreachable,
            .payload = astz.Shape{ .fields = fields1(allocator, field_plain(allocator, "__type_ref", pf.types[0])) },
            .kind = .terminal,
            .annotations = &.{},
        };
        br[1] = emptyBranch(allocator, "out-of-bounds");
        const pair = synthOp(
            allocator,
            flow,
            op_name,
            in,
            br,
            null,
            "if (i < xs.items.items.len) {\n    return .{ .item = xs.items.items[i] };\n}\nreturn .out_of_bounds;",
        );
        units.append(allocator, pair[0]) catch unreachable;
        units.append(allocator, pair[1]) catch unreachable;
    }

    // 6. pop-<Name>: (xs borrow) -> | item T | empty.
    {
        const op_name = std.fmt.allocPrint(allocator, "pop-{s}", .{proto_name}) catch unreachable;
        const in = allocator.alloc(astz.Field, 1) catch unreachable;
        in[0] = field_s(allocator, "xs", list_name, "list");
        const br = allocator.alloc(astz.Branch, 2) catch unreachable;
        br[0] = astz.Branch{
            .name = allocator.dupe(u8, "item") catch unreachable,
            .payload = astz.Shape{ .fields = fields1(allocator, field_plain(allocator, "__type_ref", pf.types[0])) },
            .kind = .terminal,
            .annotations = &.{},
        };
        br[1] = emptyBranch(allocator, "empty");
        const pair = synthOp(
            allocator,
            flow,
            op_name,
            in,
            br,
            null,
            "if (xs.items.pop()) |v| {\n    return .{ .item = v };\n}\nreturn .empty;",
        );
        units.append(allocator, pair[0]) catch unreachable;
        units.append(allocator, pair[1]) catch unreachable;
    }

    // 7. free-<Name>: (xs consume) -> void.
    {
        const op_name = std.fmt.allocPrint(allocator, "free-{s}", .{proto_name}) catch unreachable;
        const in = allocator.alloc(astz.Field, 1) catch unreachable;
        in[0] = field_s(allocator, "xs", list_name, "!list");
        const pair = synthOp(allocator, flow, op_name, in, &.{}, null, "xs.deinit();");
        units.append(allocator, pair[0]) catch unreachable;
        units.append(allocator, pair[1]) catch unreachable;
    }

    const u = units.toOwnedSlice(allocator) catch unreachable;
    return u;
}

/// A one-field Shape field list on the HEAP. `&[_]astz.Field{f}` with a
/// runtime element materializes the array as a block-scoped const — the slice
/// dangles when the block ends, and the next splice's whole-program clone
/// reads freed bytes as Field structs (crash: cloneField → dupe of garbage).
fn fields1(alloc: std.mem.Allocator, f: astz.Field) []const astz.Field {
    const out = alloc.alloc(astz.Field, 1) catch unreachable;
    out[0] = f;
    return out;
}

/// A `*List_<Name><phantom>` input field.
fn field_s(allocator: std.mem.Allocator, name: []const u8, type_base: []const u8, phantom: ?[]const u8) astz.Field {
    const t = std.fmt.allocPrint(allocator, "*{s}", .{type_base}) catch unreachable;
    return astz.Field{
        .name = allocator.dupe(u8, name) catch unreachable,
        .type = t,
        .phantom = if (phantom) |p| allocator.dupe(u8, p) catch unreachable else null,
    };
}

/// A plain (non-handle) input field — element values and indices. `field_s`
/// is the container-HANDLE helper and stars every type; a starred element
/// (`v: *i32`) makes every push call a type error at the emission boundary.
fn field_plain(allocator: std.mem.Allocator, name: []const u8, t: []const u8) astz.Field {
    return astz.Field{
        .name = allocator.dupe(u8, name) catch unreachable,
        .type = allocator.dupe(u8, t) catch unreachable,
        .phantom = null,
    };
}
/// `*List_<Name><phantom>` as the branch's IDENTITY payload — the single
/// `__type_ref` field is what the emitter lowers to a BARE union variant
/// (`list: *List_<Name>`), matching the hand-written `| list *List_i64<list!>`
/// shape; a named field would wrap the payload in a struct and break every
/// `.{ .list = self }` return in the proc body.
fn listPtrType(allocator: std.mem.Allocator, list_name: []const u8, phantom: []const u8) astz.Field {
    return astz.Field{
        .name = allocator.dupe(u8, "__type_ref") catch unreachable,
        .type = std.fmt.allocPrint(allocator, "*{s}", .{list_name}) catch unreachable,
        .phantom = allocator.dupe(u8, phantom) catch unreachable,
    };
}
fn field1(allocator: std.mem.Allocator, name: []const u8, t: []const u8) astz.Field {
    return astz.Field{
        .name = allocator.dupe(u8, name) catch unreachable,
        .type = allocator.dupe(u8, t) catch unreachable,
        .phantom = null,
    };
}
fn emptyBranch(allocator: std.mem.Allocator, name: []const u8) astz.Branch {
    return astz.Branch{
        .name = allocator.dupe(u8, name) catch unreachable,
        .payload = astz.Shape{ .fields = &.{} },
        .kind = .terminal,
        .annotations = &.{},
    };
}