// std/rand — randomness from the host's cryptographic source.
//
// The gap this closes: Java's ThreadLocalRandom — ambient, OS-seeded,
// no seed threading through your flow. std.crypto.random IS that,
// seeded by the OS; these tors are just its honest branch surface.
//
// Usage:
//   import std/rand
//   std/rand:between(lo: 1, hi: 7): f |> ...
//   std/rand:below(n: 6): v |> ...

const std = @import("std");

// Uniform integer in [lo, hi) — nextInt(lo, hi). Contract: hi > lo —
// an empty or inverted range is a programmer error, not an outcome, so
// there is no `| empty` to arm at every call site; the zig safety check
// inside intRangeAtMost is the enforcer and panics on violation.
~pub tor between { lo: i64, hi: i64 } -> i64

~proc between|zig {
    return std.crypto.random.intRangeAtMost(i64, lo, hi - 1);
}

// Uniform integer in [0, n) — nextInt(n). Contract: n > 0, same class.
~pub tor below { n: i64 } -> i64

~proc below|zig {
    return std.crypto.random.intRangeAtMost(i64, 0, n - 1);
}
