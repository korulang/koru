// std/rand — randomness from the host's cryptographic source.
//
// The gap this closes: Java's ThreadLocalRandom — ambient, OS-seeded,
// no seed threading through your flow. std.crypto.random IS that,
// seeded by the OS; these tors are just its honest branch surface.
//
// Usage:
//   import std/rand
//   std/rand:between(lo: 1, hi: 7) | n f |> ... | empty |> ...
//   std/rand:below(n: 6) | n f |> ... | empty |> ...

const std = @import("std");

// Uniform integer in [lo, hi) — nextInt(lo, hi). An empty or inverted
// range isn't an exception, it's a named outcome.
~pub tor between { lo: i64, hi: i64 }
| n i64
| empty

~proc between|zig {
    if (hi <= lo) return .{ .empty = .{} };
    return .{ .n = std.crypto.random.intRangeAtMost(i64, lo, hi - 1) };
}

// Uniform integer in [0, n) — nextInt(n). n <= 0 is `empty`.
~pub tor below { n: i64 }
| v i64
| empty

~proc below|zig {
    if (n <= 0) return .{ .empty = .{} };
    return .{ .v = std.crypto.random.intRangeAtMost(i64, 0, n - 1) };
}
