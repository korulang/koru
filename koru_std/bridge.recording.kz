// Koru Standard Library: the `recording` part of bridge — the call_step
// serializer. Split out of `calls` when the dispatch-time guide stamp made
// the emitter grow past its pin; joined via `~part recording` in bridge.kz.

/// Append this item's dispatch records to the session's call log — one
/// JSONL object per TraceEntry, stamped with the item context the bridge
/// alone knows. Empty `steps` (prose, define, gate-refused items) writes
/// nothing: a call_step exists only where a dispatch ran.
fn emitCallSteps(br: *Bridge, steps: []const Interp.TraceEntry, outcome: []const u8, step: u32, of: u32, sh: []const u8) void {
    if (steps.len == 0) return;
    const alloc = br.session_arena.allocator();
    const w = br.call_log.writer(alloc);
    for (steps) |t| {
        br.call_seq += 1;
        w.print("{{\"type\":\"call_step\",\"seq\":{d},\"turn\":{d},\"step\":{d},\"of\":{d},\"item_outcome\":\"{s}\",\"state_hash\":\"{s}\",\"verb\":", .{ br.call_seq, br.turn_count, step, of, outcome, sh }) catch return;
        w.writeAll(Interp.jsonQuote(alloc, t.event)) catch return;
        w.writeAll(",\"args\":") catch return;
        w.writeAll(if (t.args.len > 0) t.args else "[]") catch return;
        w.writeAll(",\"armed\":") catch return;
        w.writeAll(if (t.armed.len > 0) t.armed else "[]") catch return;
        w.writeAll(",\"arm_word\":") catch return;
        w.writeAll(Interp.jsonQuote(alloc, t.arm_word)) catch return;
        w.writeAll(",\"arm_name\":") catch return;
        w.writeAll(Interp.jsonQuote(alloc, t.arm orelse "")) catch return;
        w.writeAll(",\"branch\":") catch return;
        w.writeAll(Interp.jsonQuote(alloc, t.branch)) catch return;
        w.writeAll(",\"payload\":") catch return;
        w.writeAll(if (t.json.len > 0) t.json else "{}") catch return;
        w.writeAll(",\"bound\":") catch return;
        w.writeAll(Interp.jsonQuote(alloc, t.bound)) catch return;
        w.writeAll(",\"handles\":") catch return;
        w.writeAll(if (t.handles.len > 0) t.handles else "[]") catch return;
        w.writeAll(",\"used\":") catch return;
        w.print("{d}", .{t.used}) catch return;
        // Guides fire here, at the dispatch record's own facts — the same
        // lookup appends the rendered line to the item's report, so the
        // record's `fired_guides` and what the model reads cannot disagree.
        const fired = fireGuideForEntry(br, t);
        w.writeAll(",\"fired_guides\":[") catch return;
        var gi: u8 = 0;
        while (gi < fired.len) : (gi += 1) {
            if (fired.items[gi]) |gk| {
                if (gi > 0) w.writeAll(",") catch return;
                w.writeAll(Interp.jsonQuote(alloc, gk)) catch return;
            }
        }
        w.writeAll("]") catch return;
        w.print(",\"failed\":{s},\"error\":", .{if (t.failed) "true" else "false"}) catch return;
        w.writeAll(Interp.jsonQuote(alloc, t.error_msg)) catch return;
        w.writeAll("}\n") catch return;
    }
}

