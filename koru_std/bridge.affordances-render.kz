// Koru Standard Library: the `affordances-render` part of bridge — the
// `affordances` verb's Zig impl. Joined via `~part affordances-render` in
// bridge.kz; merged into the bridge module at load. The tor decl rides in
// the `affordances` part.

~proc affordances|zig {
    const rt = @import("root").koru_std.koru_runtime;

    var arena_state = std.heap.ArenaAllocator.init(std.heap.page_allocator);
    const allocator = arena_state.allocator();
    var out = std.ArrayList(u8).initCapacity(allocator, 256) catch unreachable;

    // The held state, deduped by resource type: the possession set.
    var held_types: [64][]const u8 = undefined;
    var held_count: usize = 0;
    out.appendSlice(allocator, "you hold: ") catch unreachable;
    var first_handle = true;
    for (br.pool.handles.items) |h| {
        if (h.discharged) continue;
        if (!first_handle) out.appendSlice(allocator, ", ") catch unreachable;
        out.appendSlice(allocator, h.handle_id) catch unreachable;
        out.append(allocator, '(') catch unreachable;
        out.appendSlice(allocator, h.created_by_event) catch unreachable;
        out.append(allocator, ')') catch unreachable;
        first_handle = false;
        const htype = if (std.mem.lastIndexOfScalar(u8, h.created_by_event, ':')) |idx|
            h.created_by_event[idx + 1 ..]
        else
            h.created_by_event;
        var seen = false;
        for (held_types[0..held_count]) |t| {
            if (std.mem.eql(u8, t, htype)) {
                seen = true;
                break;
            }
        }
        if (!seen and held_count < held_types.len) {
            held_types[held_count] = htype;
            held_count += 1;
        }
        // The phantom type the handle CARRIES is its obligation_name — the
        // spelling `<!type>` consumes and `<type>` borrows gate on. A taint
        // minted by `search` as `<found>` holds "found", not "search";
        // creator-name stays beside it so nothing that gated before ungates.
        seen = false;
        for (held_types[0..held_count]) |t| {
            if (std.mem.eql(u8, t, h.obligation_name)) {
                seen = true;
                break;
            }
        }
        if (!seen and held_count < held_types.len) {
            held_types[held_count] = h.obligation_name;
            held_count += 1;
        }
    }
    if (first_handle) out.appendSlice(allocator, "nothing") catch unreachable;

    // The possession set, comma-joined for the runtime projection.
    var joined: [512]u8 = undefined;
    var joined_len: usize = 0;
    for (held_types[0..held_count], 0..) |t, i| {
        if (i > 0) {
            joined[joined_len] = ',';
            joined_len += 1;
        }
        @memcpy(joined[joined_len..][0..t.len], t);
        joined_len += t.len;
    }

    out.appendSlice(allocator, "\ncallable now: ") catch unreachable;
    switch (rt.scope_affordances_event.handler(.{ .name = br.scope, .held = joined[0..joined_len] })) {
        .ok => |v| out.appendSlice(allocator, v) catch unreachable,
        .not_found => return .{ .not_found = br.scope },
    }

    // The session's inventions, same visibility rule as vocabulary.
    appendDefinedLines(&out, allocator, br.defined);

    return .{ .ok = out.toOwnedSlice(allocator) catch unreachable };
}
