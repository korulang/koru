// Koru Standard Library: the `armrefuse` part of interpreter — the two
// outcome-judge refusals for arm continuations on a verb: a named arm
// word on a void tor, and an anonymous `|>` after an outcome-bearing
// tor. Joined via `~part armrefuse` in interpreter.kz; merged into the
// interpreter module at load.

// A tor declaring no outcomes and no bare return is void — an empty
// outcome list means exactly that: a `-> T` bare return earns a
// synthetic "ok" outcome at registration, so only the truly void tor
// reaches the arm-word check with nothing declared. ANY arm word on it
// is a shape bug — it can never fire; refuse it like an undeclared arm
// word, bound or not. A bare `|>` is not an arm word — it sequences on
// the step completing and is the legal way to chain a void call.
fn refuseVoidArm(outcomes: []const BranchSpec, event_name: []const u8, arm: *const ast.Continuation, allocator: std.mem.Allocator) ?ValidationError {
    if (outcomes.len != 0) return null;
    if (arm.branch.len == 0) return null;
    const arm_text = if (arm.binding) |b| if (std.mem.eql(u8, b, "_")) arm.branch else
        std.fmt.allocPrint(allocator, "{s} {s}", .{ arm.branch, b }) catch arm.branch
    else
        arm.branch;
    return .{
        .message = std.fmt.allocPrint(allocator, "'{s}' is void — it issues no outcome, so '| {s} |>' has nothing to arm; chain the next call with a bare |>", .{ event_name, arm_text }) catch "void tor armed",
        .binding_name = arm.binding orelse arm.branch,
    };
}

// An anonymous `|>` after an outcome-bearing tor is a meaning error in
// compiled Koru, not an unhandled outcome, so the wire refuses it too.
// koruc's own verdict depends on shape: with no arms it reports each
// branch unhandled (KORU022 per branch); the "ambiguous — N non-panic
// branches" KORU022 fires only when an anonymous `|>` sits ahead of
// named arms. The wire's lenient model hands unarmed outcomes back, so
// naming the one branch to continue on is the workable spelling here.
// With exactly one outcome — only reachable as the synthetic `ok` a
// `-> T` bare return earns, since a single declared branch is illegal
// Koru — koruc binds the value `verb(): name` and refuses `| ok` on it
// (KORU021). The wire has no `:` spelling yet, so the honest refusal
// says the result cannot be chained rather than teaching an arm koruc
// rejects.
fn refuseBarePipeOutcome(outcomes: []const BranchSpec, event_name: []const u8, allocator: std.mem.Allocator) ?ValidationError {
    if (outcomes.len == 0) return null;
    if (outcomes.len >= 2) {
        return .{
            .message = std.fmt.allocPrint(allocator, "anonymous '|>' after '{s}' — name the outcome to continue on ('| <branch> |>')", .{event_name}) catch "ambiguous bare pipe",
            .binding_name = "",
        };
    }
    return .{
        .message = std.fmt.allocPrint(allocator, "the value produced by '{s}' has nowhere to land — a -> T result cannot be chained on the wire yet", .{event_name}) catch "bare pipe drops the value",
        .binding_name = "",
    };
}
