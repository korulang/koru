// std/string - String library with view/instance ownership model
//
// Ownership states:
//   [view!]     - read-only access, can be promoted to instance
//   [instance!] - full control, can read/write/free
//
// The String struct carries its allocator, so it can be freed anywhere.

const std = @import("std");

pub const String = struct {
    data: []u8,
    allocator: std.mem.Allocator,

    // For Zig interop - get the slice
    pub fn slice(self: String) []const u8 {
        return self.data;
    }

    // Package-private - only auto-discharge calls this
    fn deinit(self: String) void {
        self.allocator.free(self.data);
    }
};

// ============================================
// Creation events - different allocator sources
// ============================================

// Create with explicit allocator
~pub event new { allocator: std.mem.Allocator, text: []const u8 }
| ok *String<view!>
| err []const u8

~proc new|zig {
    const data = allocator.alloc(u8, text.len) catch {
        return .{ .err = "allocation failed" };
    };
    @memcpy(data, text);

    const s = allocator.create(String) catch {
        allocator.free(data);
        return .{ .err = "allocation failed" };
    };
    s.* = .{ .data = data, .allocator = allocator };
    return .{ .ok = s };
}

// Create with page allocator (simple, for demos)
~pub event from-page { text: []const u8 }
| ok *String<view!>
| err []const u8

~proc from-page|zig {
    const allocator = koru_allocator();
    const data = allocator.alloc(u8, text.len) catch {
        return .{ .err = "allocation failed" };
    };
    @memcpy(data, text);

    const s = allocator.create(String) catch {
        allocator.free(data);
        return .{ .err = "allocation failed" };
    };
    s.* = .{ .data = data, .allocator = allocator };
    return .{ .ok = s };
}

// ============================================
// Ownership transitions
// ============================================

// Take ownership - view becomes instance
~pub event take { s: *String<!view> }
| instance *String<instance!>

~proc take|zig {
    return .{ .instance = s };
}

// Release ownership - instance becomes view
~pub event release { s: *String<!instance> }
| view *String<view!>

~proc release|zig {
    return .{ .view = s };
}

// ============================================
// Cleanup
// ============================================

// Free - works on either view or instance (consume-marker on BOTH members, so
// the union discharges either state; `<!view|instance>` marked only `view`,
// hiding `free` from `instance!` obligations — the discharge-finder's
// .state_union branch keys off each member's own consume marker).
~pub event free { s: *String<!view|!instance> }

~proc free|zig {
    s.allocator.free(s.data);
    s.allocator.destroy(s);
}

// ============================================
// Read operations - work on view or instance
// ============================================

~pub event read { s: *String<view|instance> }
| slice []const u8

~proc read|zig {
    return .{ .slice = s.data };
}

~pub event len { s: *String<view|instance> }
| len usize

~proc len|zig {
    return .{ .len = s.data.len };
}

// ============================================
// Query / transform operations (FRONTIERS gap 4)
//
// Safe-by-construction: each op returns a scalar or a NEW owned String, never
// a borrowed sub-view of `s`. So the ratified borrow model holds trivially —
// `|` terminal payloads OWN what they carry (a scalar owns itself; substring
// allocates a fresh copy) with zero borrow machinery. Cheap views wait on the
// borrow-obligation surface; `split` (many parts) waits on the store.
// ============================================

// Parse the string's text as a base-10 integer.
~pub event parse-int { s: *String<view|instance> }
| ok i64
| err []const u8

~proc parse-int|zig {
    const n = std.fmt.parseInt(i64, s.data, 10) catch {
        return .{ .err = "not an integer" };
    };
    return .{ .ok = n };
}

// Build a NEW owned String from a base-10 integer (the int→string mirror of
// parse-int). Owned return, so it carries its own ownership obligation.
~pub event from-int { n: i64 }
| ok *String<view!>
| err []const u8

~proc from-int|zig {
    const allocator = koru_allocator();
    const data = std.fmt.allocPrint(allocator, "{d}", .{n}) catch {
        return .{ .err = "allocation failed" };
    };
    const s = allocator.create(String) catch {
        allocator.free(data);
        return .{ .err = "allocation failed" };
    };
    s.* = .{ .data = data, .allocator = allocator };
    return .{ .ok = s };
}

// Does the string contain `needle`?
~pub event contains { s: *String<view|instance>, needle: []const u8 }
| yes
| no

~proc contains|zig {
    if (std.mem.indexOf(u8, s.data, needle) != null) {
        return .yes;
    }
    return .no;
}

// First index of `needle`, or not-found.
~pub event index-of { s: *String<view|instance>, needle: []const u8 }
| found usize
| not-found

~proc index-of|zig {
    if (std.mem.indexOf(u8, s.data, needle)) |idx| {
        return .{ .found = idx };
    }
    return .not_found;
}

// Extract [start, end) as a NEW owned String<view!> (a fresh copy, not a
// borrow into `s`). The result carries its own ownership obligation.
~pub event substring { s: *String<view|instance>, start: usize, end: usize }
| ok *String<view!>
| err []const u8

~proc substring|zig {
    if (start > end or end > s.data.len) {
        return .{ .err = "range out of bounds" };
    }
    const allocator = s.allocator;
    const out_data = allocator.alloc(u8, end - start) catch {
        return .{ .err = "allocation failed" };
    };
    @memcpy(out_data, s.data[start..end]);
    const out = allocator.create(String) catch {
        allocator.free(out_data);
        return .{ .err = "allocation failed" };
    };
    out.* = .{ .data = out_data, .allocator = allocator };
    return .{ .ok = out };
}

// ============================================
// Write operations - require instance
// ============================================

~pub event append { s: *String<instance>, text: []const u8 }
| ok
| err []const u8

~proc append|zig {
    const new_len = s.data.len + text.len;
    const new_data = s.allocator.realloc(s.data, new_len) catch {
        return .{ .err = "realloc failed" };
    };
    @memcpy(new_data[s.data.len..], text);
    s.data = new_data;
    return .ok;
}

~pub event clear { s: *String<instance> }

~proc clear|zig {
    s.data.len = 0;
}
