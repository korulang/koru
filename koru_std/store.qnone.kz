// Koru Standard Library: Reactive Stores — the `| none` arm emit.
// Joined via `~part qnone` in store.kz; merged into the store module at load.

// ============================================================================
// STORE.QUERY.NONE — the `| none` arm's emitted-body builder
// ============================================================================
//
// `| none` is the absent case of a `! first` site: its body transplants into
// its own tor exactly as the sweep arm does, minus the row — no
// projections, no cursor, captures only. The call lands after the loop
// under `if (!__koru_found)` (emitted by the query transform on both loop
// paths). This builder owns the body's construction end to end: mint the
// __store_nonebody_* event + impl flow pair into `appended`, hand back the
// body's name, the capture-record text for the call, and the lexical count
// the site's own capture bookkeeping needs.

const QueryNone = struct {
    // Container scope, not module scope: each transform proc re-imports
    // `ast_functional` locally, and a file-level decl here would collide
    // with all of them in the merged module.
    const ast_functional = @import("ast_functional");
    const Emit = struct { name: []const u8, args: []const u8, lexical: usize };

    const H = struct {
        const mkPathH = @import("emitter_helpers").mkPathH;
        // An owned column's phantom arrives in the CONSUMING form `mod:!state`
        // (ownership moves IN); the none arm's captures project it as a BARE
        // BORROW `mod:state` — read accepts it and consumes nothing.
        const bareBorrow = @import("emitter_helpers").bareBorrow;
    };

    /// Mint the `__store_nonebody_*` event + impl flow for `none_arm` into
    /// `appended`; on success hand back its name, the capture-record text for
    /// the post-loop call, and how many of those captures were lexical. A
    /// refusal carries the KORU161 message — the caller wraps it in
    /// `ast.refusal` so the diagnostic keeps the site's own location/module.
    fn emit(
        alloc: std.mem.Allocator,
        na: *const ast_find.Continuation,
        avail: []const Cap.Bind,
        home_ns: []const u8,
        store_name: []const u8,
        flow: *const ast_find.Flow,
        retain_ann: []const []const u8,
        host_target: codegen_utils_store.HostTarget,
        appended: *std.ArrayList(ast_find.Item),
    ) union(enum) { ok: Emit, refuse: []const u8 } {
        const HS = codegen_utils_store.HostShape;
        const npeel = TapPeel.peel(na) orelse na;
        var none_clone = ast_functional.cloneContinuation(alloc, npeel) catch unreachable;
        const none_node = none_clone.node orelse {
            return .{ .refuse = std.fmt.allocPrint(alloc, "std/store:query({s}): the `| none` branch needs a body (`|> ...`)", .{store_name}) catch unreachable };
        };
        if (none_node != .invocation and none_node != .label_with_invocation) {
            return .{ .refuse = std.fmt.allocPrint(alloc, "std/store:query({s}): the `| none` body must start with an invocation this rung", .{store_name}) catch unreachable };
        }
        const none_inv = switch (none_clone.node.?) {
            .invocation => |i| i,
            .label_with_invocation => |l| l.invocation,
            else => unreachable,
        };
        var nrefs = std.ArrayList([]const u8).initCapacity(alloc, 4) catch unreachable;
        Cap.collectRefs(alloc, &none_clone, &nrefs);
        const picked = switch (Pick.pickCaptures(alloc, avail, nrefs.items, "the `| none` body", store_name)) {
            .ok => |p| p,
            .refuse => |m| return .{ .refuse = m },
        };
        const ncaps = picked.caps;
        const lexical = picked.lexical;
        const nbody_in = alloc.alloc(ast_find.Field, ncaps.items.len) catch unreachable;
        for (ncaps.items, 0..) |c, i| {
            nbody_in[i] = ast_find.Field{
                .name = alloc.dupe(u8, c.name) catch unreachable,
                .type = c.type,
                .module_path = c.module_path,
                .phantom = if (c.phantom) |ph| blk_ph: {
                    if (ph.len > 1 and ph[ph.len - 1] == '!') break :blk_ph alloc.dupe(u8, ph[0 .. ph.len - 1]) catch unreachable;
                    break :blk_ph H.bareBorrow(alloc, ph);
                } else null,
            };
        }
        const nbody_name = std.fmt.allocPrint(alloc, "__store_nonebody_{s}_L{d}_{s}", .{ store_name, na.location.line, storeSiteTag(alloc, na.location.file) }) catch unreachable;
        appended.append(alloc, ast_find.Item{ .event_decl = ast_find.EventDecl{
            .path = H.mkPathH(alloc, home_ns, nbody_name),
            .input = ast_find.Shape{ .fields = nbody_in },
            .branches = &[_]ast_find.Branch{},
            .is_public = false,
            .is_implicit_flow = false,
            .annotations = retain_ann,
            .location = flow.location,
            .module = alloc.dupe(u8, flow.module) catch unreachable,
        } }) catch unreachable;
        appended.append(alloc, ast_find.Item{ .flow = ast_find.Flow{
            .body = ast_find.rootSite(none_inv, none_clone.continuations, flow.location),
            .pre_label = null,
            .impl_of = H.mkPathH(alloc, home_ns, nbody_name),
            .super_shape = null,
            .inline_body = null,
            .preamble_code = null,
            .is_pure = false,
            .is_transitively_pure = false,
            .location = flow.location,
            .module = alloc.dupe(u8, flow.module) catch unreachable,
        } }) catch unreachable;
        var nargb = std.ArrayList(u8).initCapacity(alloc, 32) catch unreachable;
        for (ncaps.items) |c| {
            const cv = c.value orelse c.name;
            if (nargb.items.len > 0) nargb.appendSlice(alloc, ", ") catch unreachable;
            nargb.appendSlice(alloc, HS.recField(alloc, host_target, c.name, cv)) catch unreachable;
        }
        return .{ .ok = .{ .name = nbody_name, .args = alloc.dupe(u8, nargb.items) catch unreachable, .lexical = lexical } };
    }
};
