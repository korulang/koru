// std/quantity — quantity calculus over arbitrary-precision decimals,
// taint-sourced like std/num.
//
// Port source: isa-physics `plex/lib/structural_arithmetic/tensor_quantity.py`
// (Q = dimension + magnitude + uncertainty) and the isar-proofs
// `ISAR/QuantityKernel.lean` (DimExpr free abelian group over the 7 SI bases,
// MetricExpr exact-rational layer, propagateVarAdd/Mul linearized variance
// laws plus the shared-source covariance term).
//
// A `qty` is ONE canonical marked string:
//     "<num>|<dim>|<unc>[@<cov>]"
//   <num>:  std/num canonical decimal           e.g. "9.81e0"
//   <dim>:  all 7 SI exps, fixed order          "m^1 s^-2 kg^0 A^0 K^0 mol^0 cd^0"
//   <unc>:  num canon or "-"                    e.g. "1e-1" / "1e-1@bias"
//   <cov>:  shared-source tag; absent           "-"
// Canonical => quantity equivalence is string equality (`qty:equiv`).
// A "-" uncertainty is "0e0" internally: no uncertainty contributes zero
// variance, and pack writes "-" back out.
//
// Covariance model (linearized, GUM-adjacent): `unc@<group>` asserts the
// whole sigma stems from shared source <group>. A leading '-' on the tag
// marks a negated instance (what qty:neg produces): same group opposite
// sign is a FULLY ANTI-CORRELATED source, and the covariance term flips
// sign — a−b sharing a bias cancels it. Same group + sign adds 2·u_a·u_b;
// different groups => | mixed-cov — the correlation is unknowable, so the
// op refuses the axis instead of silently assuming independence. One-sided
// tags propagate conservatively: independent sigma, tag carried forward.
//
// Taint: same shape as std/num — `ingest`/`ingest-owned` issue <external!>,
// `parse`/`lit` discharge it into <exact!>, ops consume <!exact> linearly,
// `dup` forks, `free` deallocates, `render` swaps to <std/io:allocated!>.
// `qty:mag` unwraps the magnitude INTO the number tower as <std/num:exact!>
// — the lawful crossing between the two marks; `qty:unpack` decomposes the
// pack into marked fields, `qty:pack` reassembles it.
//
// Boundary vs impl: the zig procs below are ONLY mark-boundary machinery —
// ingest/split/pack/unpack issue and consume marks, dim-* compose the
// canonical dim vector, cov-* carry the shared-source policy. Every
// arithmetic law is a Koru impl (`~name = ...`) calling std/num tors —
// the decimal core lives in ONE place (num.kz) and ops compose through the
// tor mechanism: data crosses boundaries, logic does not.

~import std/io
~import std/num
~import std/sym

const std = @import("std");

fn ownedCopy(s: []const u8) []u8 {
    return koru_allocator().dupe(u8, s) catch @panic("std/quantity: out of memory");
}

fn qtyFree(s: []const u8) void {
    koru_allocator().free(s);
}

// ============================================================================
// Dimensions — the free abelian group over 7 SI bases, index order
// (m, s, kg, A, K, mol, cd). Canon: "m^1 s^-2 kg^0 A^0 K^0 mol^0 cd^0".
// ============================================================================

const Dim = [7]i32;
const DIM_ZERO: Dim = .{ 0, 0, 0, 0, 0, 0, 0 };
const DIM_NAMES = [7][]const u8{ "m", "s", "kg", "A", "K", "mol", "cd" };

fn dimCanon(alloc: std.mem.Allocator, d: Dim) ![]u8 {
    var out = std.ArrayList(u8).initCapacity(alloc, 48) catch return error.OutOfMemory;
    errdefer out.deinit(alloc);
    var buf: [16]u8 = undefined;
    for (DIM_NAMES, 0..) |name, i| {
        if (i > 0) try out.append(alloc, ' ');
        try out.appendSlice(alloc, name);
        try out.append(alloc, '^');
        const es = std.fmt.bufPrint(&buf, "{d}", .{d[i]}) catch unreachable;
        try out.appendSlice(alloc, es);
    }
    return out.toOwnedSlice(alloc);
}

fn dimParse(s: []const u8, d: *Dim) bool {
    var it = std.mem.tokenizeScalar(u8, s, ' ');
    var i: usize = 0;
    while (it.next()) |tok| {
        if (i >= 7) return false;
        const caret = std.mem.indexOfScalar(u8, tok, '^') orelse return false;
        if (!std.mem.eql(u8, tok[0..caret], DIM_NAMES[i])) return false;
        d[i] = std.fmt.parseInt(i32, tok[caret + 1 ..], 10) catch return false;
        i += 1;
    }
    return i == 7;
}

// Unit-name -> (dim, value scale). `g` scales by 1e-3 — the plex source mapped
// g to raw MASS without scaling; that is a preserved bug, not a law. Scale it.
const UnitDef = struct { dim: Dim, scale: f64 };

fn unitLookup(name: []const u8) ?UnitDef {
    const M = Dim{ 0, 0, 1, 0, 0, 0, 0 };
    const table = .{
        .{ "m", UnitDef{ .dim = .{ 1, 0, 0, 0, 0, 0, 0 }, .scale = 1.0 } },
        .{ "s", UnitDef{ .dim = .{ 0, 1, 0, 0, 0, 0, 0 }, .scale = 1.0 } },
        .{ "kg", UnitDef{ .dim = M, .scale = 1.0 } },
        .{ "g", UnitDef{ .dim = M, .scale = 1e-3 } },
        .{ "A", UnitDef{ .dim = .{ 0, 0, 0, 1, 0, 0, 0 }, .scale = 1.0 } },
        .{ "K", UnitDef{ .dim = .{ 0, 0, 0, 0, 1, 0, 0 }, .scale = 1.0 } },
        .{ "mol", UnitDef{ .dim = .{ 0, 0, 0, 0, 0, 1, 0 }, .scale = 1.0 } },
        .{ "cd", UnitDef{ .dim = .{ 0, 0, 0, 0, 0, 0, 1 }, .scale = 1.0 } },
        .{ "Hz", UnitDef{ .dim = .{ 0, -1, 0, 0, 0, 0, 0 }, .scale = 1.0 } },
        .{ "N", UnitDef{ .dim = .{ 1, -2, 1, 0, 0, 0, 0 }, .scale = 1.0 } },
        .{ "J", UnitDef{ .dim = .{ 2, -2, 1, 0, 0, 0, 0 }, .scale = 1.0 } },
        .{ "W", UnitDef{ .dim = .{ 2, -3, 1, 0, 0, 0, 0 }, .scale = 1.0 } },
        .{ "Pa", UnitDef{ .dim = .{ -1, -2, 1, 0, 0, 0, 0 }, .scale = 1.0 } },
        .{ "V", UnitDef{ .dim = .{ 2, -3, 1, -1, 0, 0, 0 }, .scale = 1.0 } },
        .{ "C", UnitDef{ .dim = .{ 0, 1, 0, 1, 0, 0, 0 }, .scale = 1.0 } },
        .{ "F", UnitDef{ .dim = .{ -2, 4, -1, 2, 0, 0, 0 }, .scale = 1.0 } },
        .{ "Ohm", UnitDef{ .dim = .{ 2, -3, 1, -2, 0, 0, 0 }, .scale = 1.0 } },
    };
    inline for (table) |entry| {
        if (std.mem.eql(u8, name, entry[0])) return entry[1];
    }
    return null;
}

// Parse a unit expression into a Dim: "kg", "m/s", "m/s^2", "kg·m·s^-2",
// "m²", "m·s⁻¹". Factors left of '/' contribute +exp, right of '/' -exp.
// UTF-8 superscripts are normalized to ASCII first.
fn unitScan(alloc: std.mem.Allocator, expr_in: []const u8, d: *Dim, scale: *f64) bool {
    d.* = DIM_ZERO;
    scale.* = 1.0;
    const expr = std.mem.trim(u8, expr_in, " \t");
    if (expr.len == 0) return true;

    var buf = std.ArrayList(u8).initCapacity(alloc, expr.len + 8) catch return false;
    defer buf.deinit(alloc);
    var i: usize = 0;
    while (i < expr.len) {
        var advanced = false;
        if (i + 1 < expr.len and expr[i] == 0xC2) {
            const c1 = expr[i + 1];
            const rep: []const u8 = switch (c1) {
                0xB2 => "^2", // ²
                0xB3 => "^3", // ³
                0xB7 => "*", // ·
                else => "",
            };
            if (rep.len > 0) {
                buf.appendSlice(alloc, rep) catch return false;
                i += 2;
                advanced = true;
            }
        }
        if (!advanced and i + 4 < expr.len and expr[i] == 0xE2 and expr[i + 1] == 0x81 and expr[i + 2] == 0xBB and expr[i + 3] == 0xC2) {
            const rep: []const u8 = switch (expr[i + 4]) {
                0xB9 => "^-1",
                0xB2 => "^-2",
                0xB3 => "^-3",
                else => "",
            };
            if (rep.len > 0) {
                buf.appendSlice(alloc, rep) catch return false;
                i += 5;
                advanced = true;
            }
        }
        if (!advanced) {
            buf.append(alloc, expr[i]) catch return false;
            i += 1;
        }
    }

    // Split into numerator zone and denominator zone at '/'.
    const slash = std.mem.indexOfScalar(u8, buf.items, '/');
    const zones = [2][]const u8{
        if (slash) |p| buf.items[0..p] else buf.items,
        if (slash) |p| buf.items[p + 1 ..] else "",
    };
    for (zones, 0..) |zone, zi| {
        const neg = zi == 1;
        var it = std.mem.tokenizeAny(u8, zone, " *");
        while (it.next()) |tok| {
            var name = tok;
            var exp: i32 = 1;
            if (std.mem.indexOfScalar(u8, tok, '^')) |caret| {
                name = tok[0..caret];
                exp = std.fmt.parseInt(i32, tok[caret + 1 ..], 10) catch return false;
            }
            const ud = unitLookup(name) orelse return false;
            const signed_exp: i32 = if (neg) -exp else exp;
            for (0..7) |k| {
                d[k] += signed_exp * ud.dim[k];
            }
            var j: i32 = 0;
            const ae: i32 = if (exp < 0) -exp else exp;
            while (j < ae) : (j += 1) {
                scale.* *= if (neg) 1.0 / ud.scale else ud.scale;
            }
        }
    }
    return true;
}

// ============================================================================
// Pack: "<num>|<dim>|<unc>[@<cov>]"
// ============================================================================

// Join canonical fields. "0e0" unc renders "-" (no sigma, and any cov tag is
// dropped — a shared source with no sigma is a contradiction).
fn qtyJoin(alloc: std.mem.Allocator, mag: []const u8, dim_txt: []const u8, unc: []const u8, cov: []const u8) ![]u8 {
    const sure = std.mem.eql(u8, unc, "0e0");
    var out = std.ArrayList(u8).initCapacity(alloc, mag.len + dim_txt.len + unc.len + cov.len + 4) catch return error.OutOfMemory;
    errdefer out.deinit(alloc);
    try out.appendSlice(alloc, mag);
    try out.append(alloc, '|');
    try out.appendSlice(alloc, dim_txt);
    try out.append(alloc, '|');
    if (sure) {
        try out.append(alloc, '-');
    } else {
        try out.appendSlice(alloc, unc);
        if (!std.mem.eql(u8, cov, "-")) {
            try out.append(alloc, '@');
            try out.appendSlice(alloc, cov);
        }
    }
    return out.toOwnedSlice(alloc);
}

// ============================================================================
// Split: "2.0+-0.1@bias kg" / "3.0 m/s" / "π m" -> raw field text.
// Fields are RAW strings — num:parse canonicalizes them in `canon`.
// ============================================================================

const PI_DIGITS = "3.14159265358979323846264338327950288";
const PHI_DIGITS = "1.61803398874989484820458683436563811";
const E_DIGITS = "2.71828182845904523536028747135266249";

const SplitFields = struct {
    mag: []const u8,
    unc: []const u8,
    scale: []const u8,
    dim: []u8, // owned canon
    cov: []const u8,
};

fn qtySplitText(alloc: std.mem.Allocator, s_in: []const u8, out: *SplitFields) !void {
    const s = std.mem.trim(u8, s_in, " \t\r\n");
    if (s.len == 0) return error.BadQuantity;

    var value_str: []const u8 = s;
    var unc_str: []const u8 = "0e0";
    var unit_str: []const u8 = "";
    var cov_str: []const u8 = "-";

    // split on ± (U+00B1: C2 B1) or "+-"
    var pm: ?usize = null;
    var pmw: usize = 0;
    if (std.mem.indexOf(u8, s, "\xc2\xb1")) |p| {
        pm = p;
        pmw = 2;
    } else if (std.mem.indexOf(u8, s, "+-")) |p| {
        pm = p;
        pmw = 2;
    }
    if (pm) |p| {
        value_str = std.mem.trim(u8, s[0..p], " \t");
        const rest = std.mem.trim(u8, s[p + pmw ..], " \t");
        const sp = std.mem.indexOfAny(u8, rest, " \t") orelse rest.len;
        var u = std.mem.trim(u8, rest[0..sp], " \t");
        unit_str = std.mem.trim(u8, rest[sp..], " \t");
        if (std.mem.indexOfScalar(u8, u, '@')) |at| {
            cov_str = std.mem.trim(u8, u[at + 1 ..], " \t");
            u = u[0..at];
            if (cov_str.len == 0) return error.BadQuantity;
        }
        unc_str = u;
    } else {
        const sp = std.mem.indexOfAny(u8, s, " \t") orelse s.len;
        value_str = std.mem.trim(u8, s[0..sp], " \t");
        unit_str = std.mem.trim(u8, s[sp..], " \t");
    }

    // magnitude: literal, or a named constant folded to digits at the boundary
    var mag_str: []const u8 = value_str;
    if (std.mem.eql(u8, value_str, "π") or std.mem.eql(u8, value_str, "pi")) {
        mag_str = PI_DIGITS;
    } else if (std.mem.eql(u8, value_str, "φ") or std.mem.eql(u8, value_str, "phi")) {
        mag_str = PHI_DIGITS;
    } else if (std.mem.eql(u8, value_str, "e")) {
        mag_str = E_DIGITS;
    }

    var dim: Dim = DIM_ZERO;
    var scale: f64 = 1.0;
    if (!unitScan(alloc, unit_str, &dim, &scale)) return error.BadQuantity;

    var sbuf: [40]u8 = undefined;
    const scale_str = std.fmt.bufPrint(&sbuf, "{d}", .{scale}) catch return error.BadQuantity;

    out.* = .{
        .mag = try alloc.dupe(u8, mag_str),
        .unc = try alloc.dupe(u8, unc_str),
        .scale = try alloc.dupe(u8, scale_str),
        .dim = try dimCanon(alloc, dim),
        .cov = try alloc.dupe(u8, cov_str),
    };
}

// ============================================================================
// Boundary — mark machinery only
// ============================================================================

~pub tor ingest { s: string } -> string<external!>

~proc ingest|zig {
    return ownedCopy(s);
}

~pub tor ingest-owned { s: string<!allocated> } -> string<external!>

~proc ingest-owned|zig {
    return s;
}

// The parse boundary: splits "mag+-unc@cov unit" into RAW field strings and
// issues <std/num:external!> on the numeric fields — num:parse discharges
// them in `canon`. dim/cov come out owned (<std/io:allocated!>).
~pub tor split { s: string<!external> }
| fields { mag: string<std/num:external!>, unc: string<std/num:external!>, scale: string<std/num:external!>, dim: string<std/io:allocated!>, cov: string<std/io:allocated!> }
| bad string<std/io:allocated!>

~proc split|zig {
    var f: SplitFields = undefined;
    qtySplitText(koru_allocator(), s, &f) catch |err| switch (err) {
        error.OutOfMemory => @panic("std/quantity: out of memory"),
        else => return .{ .bad = s },
    };
    defer qtyFree(s);
    return .{ .fields = .{
        .mag = f.mag,
        .unc = f.unc,
        .scale = f.scale,
        .dim = f.dim,
        .cov = f.cov,
    } };
}

// The canonicalizer: external field text -> canonical pack. num:parse does
// the decimal work; the unit scale multiplies through magnitude AND
// uncertainty (2 g ± 0.1 g -> 2e-3 kg ± 1e-4).
~tor canon { mag: string<std/num:!external>, unc: string<std/num:!external>, scale: string<std/num:!external>, dim: string<std/io:!allocated>, cov: string<std/io:!allocated> }
| exact string<exact!>
| bad string<std/io:allocated!>

~canon = std/num:parse(s: mag)
| bad e |> std/num:drop(s: unc) |> std/num:drop(s: scale) |> std/io:free(content: dim) |> std/io:free(content: cov) => bad e
| exact pm |> std/num:parse(s: unc)
    | bad e |> std/num:free(n: pm) |> std/num:drop(s: scale) |> std/io:free(content: dim) |> std/io:free(content: cov) => bad e
    | exact pu |> std/num:parse(s: scale)
        | bad e |> std/num:free(n: pm) |> std/num:free(n: pu) |> std/io:free(content: dim) |> std/io:free(content: cov) => bad e
        | exact ps |> std/num:dup(n: ps): sd |> std/num:mul(a: pm, b: sd.a): ms |> std/num:mul(a: pu, sd.b): us |> pack(mag: ms, unc: us, dim, cov): q => exact q

~pub tor parse { s: string<!external> }
| exact string<exact!>
| bad string<std/io:allocated!>

~parse = split(s)
| fields f |> canon(f.mag, f.unc, f.scale, f.dim, f.cov)
    | exact q => exact q
    | bad e => bad e
| bad m => bad m

// Trusted literal: same boundary, issued <external!> because the fields still
// have to be validated — the mark means "unparsed", and parse is the only
// discharge that canonicalizes. `bad` stays an unmarked message: the caller
// wrote s themselves; the owned buffers are freed here rather than pushed
// onto the caller as an obligation.
~pub tor lit { source: Source }
| exact string<exact!>
| bad string

~lit = ingest(s: source.text): ext |> split(s: ext)
| fields f |> canon(f.mag, f.unc, f.scale, f.dim, f.cov)
    | exact q => exact q
    | bad e |> std/io:free(content: e) => bad "malformed quantity"
| bad m |> std/io:free(content: m) => bad "malformed quantity"

// Symbolic literal: a canonical sexpr magnitude plus unit text — `lit` for
// the MetricSymbolic lane. The unit's scale multiplies through the
// magnitude symbolically (lit-sym(π,"g") -> (1e-3*π) kg). unc/cov are
// literal text, validated at the boundary like `lit`'s fields.
~pub tor lit-sym { mag: string<std/sym:!sexpr>, unit: string, unc: string, cov: string }
| exact string<exact!>
| bad-lit string

~lit-sym = unit-dim(s: unit)
| bad-unit |> std/sym:free(n: mag) => bad-lit "unknown unit"
| ok u |> std/num:ingest(s: unc): ue |> std/num:parse(s: ue)
    | bad e |> std/io:free(content: e) |> std/io:free(content: u.dim) |> std/sym:free(n: mag) => bad-lit "bad uncertainty"
    | exact pu |> std/num:parse(s: u.scale)
        | bad e |> std/io:free(content: e) |> std/io:free(content: u.dim) |> std/sym:free(n: mag) |> std/num:free(n: pu) => bad-lit "bad unit scale"
        | exact sc |> cov-tag(s: cov)
            | bad-tag |> std/num:free(n: pu) |> std/num:free(n: sc) |> std/io:free(content: u.dim) |> std/sym:free(n: mag) => bad-lit "bad cov tag"
            | ok cv |> std/sym:of-dec(n: sc): ss |> std/sym:mul(a: mag, b: ss): rm |> pack-sym(mag: rm, unc: pu, u.dim, cov: cv): q => exact q

// Pack canonical fields into the qty string. Consumes all four inputs —
// dim/cov are discharged by the pack itself (their bytes land in the pack).
// dim must be canonical: a malformed dim is an internal defect, panicked.
fn packEmit(alloc: std.mem.Allocator, mag: []const u8, unc: []const u8, dim: []const u8, cov: []const u8) []u8 {
    var d: Dim = undefined;
    if (!dimParse(dim, &d)) @panic("std/quantity:pack: malformed dim operand");
    defer qtyFree(dim);
    defer qtyFree(cov);
    const dc = dimCanon(alloc, d) catch @panic("std/quantity: out of memory");
    defer alloc.free(dc);
    const joined = qtyJoin(alloc, mag, dc, unc, cov) catch @panic("std/quantity: out of memory");
    qtyFree(mag);
    qtyFree(unc);
    return joined;
}

~pub tor pack { mag: string<std/num:!exact>, unc: string<std/num:!exact>, dim: string<std/io:!allocated>, cov: string<std/io:!allocated> } -> string<exact!>

~proc pack|zig {
    return packEmit(koru_allocator(), mag, unc, dim, cov);
}

// Same pack, symbolic lane: the mag field holds sexpr canon — identical
// pack shape, a different mark at the boundary.
~pub tor pack-sym { mag: string<std/sym:!sexpr>, unc: string<std/num:!exact>, dim: string<std/io:!allocated>, cov: string<std/io:!allocated> } -> string<exact!>

~proc pack-sym|zig {
    return packEmit(koru_allocator(), mag, unc, dim, cov);
}

// Decimal canon shape: -?d+(.d+)?e-?d+ — the numeric-leaf alphabet.
// Anything else in the mag field is symbolic canon (π, (a*b), inv(x), √).
fn magIsDec(m: []const u8) bool {
    var i: usize = 0;
    if (i < m.len and m[i] == '-') i += 1;
    const ds = i;
    while (i < m.len and m[i] >= '0' and m[i] <= '9') i += 1;
    if (i == ds) return false;
    if (i < m.len and m[i] == '.') {
        i += 1;
        const fs = i;
        while (i < m.len and m[i] >= '0' and m[i] <= '9') i += 1;
        if (i == fs) return false;
    }
    if (i >= m.len or m[i] != 'e') return false;
    i += 1;
    if (i < m.len and m[i] == '-') i += 1;
    const es = i;
    while (i < m.len and m[i] >= '0' and m[i] <= '9') i += 1;
    return i > es and i == m.len;
}

// Decompose a qty into marked fields — a lane union on the magnitude:
// | num carries decimal canon under <std/num:exact!>, | sym carries sexpr
// canon under <std/sym:sexpr!>. unc is decimal on both lanes; dim/cov are
// owned text. "-" uncertainty unpacks as canonical "0e0"; absent cov as "-".
~pub tor unpack { n: string<!exact> }
| num { mag: string<std/num:exact!>, unc: string<std/num:exact!>, dim: string<std/io:allocated!>, cov: string<std/io:allocated!> }
| sym { mag: string<std/sym:sexpr!>, unc: string<std/num:exact!>, dim: string<std/io:allocated!>, cov: string<std/io:allocated!> }

~proc unpack|zig {
    const p1 = std.mem.indexOfScalar(u8, n, '|') orelse @panic("std/quantity:unpack: malformed operand");
    const p2 = std.mem.indexOfScalarPos(u8, n, p1 + 1, '|') orelse @panic("std/quantity:unpack: malformed operand");
    const mag = ownedCopy(n[0..p1]);
    const dim = ownedCopy(n[p1 + 1 .. p2]);
    var u = n[p2 + 1 ..];
    var cov: []const u8 = "-";
    if (std.mem.indexOfScalar(u8, u, '@')) |at| {
        cov = u[at + 1 ..];
        u = u[0..at];
    }
    const unc = ownedCopy(if (std.mem.eql(u8, u, "-")) "0e0" else u);
    const covs = ownedCopy(cov);
    defer qtyFree(n);
    if (magIsDec(mag)) return .{ .num = .{ .mag = mag, .unc = unc, .dim = dim, .cov = covs } };
    return .{ .sym = .{ .mag = mag, .unc = unc, .dim = dim, .cov = covs } };
}

// Unit text -> (scale, canonical dim) — the same table split's grammar
// uses. Scale comes out <std/num:external!>: unparsed decimal text that
// num:parse discharges. | bad names the unknown-unit axis.
~pub tor unit-dim { s: string }
| ok { scale: string<std/num:external!>, dim: string<std/io:allocated!> }
| bad-unit

~proc unit-dim|zig {
    var d: Dim = undefined;
    var sc: f64 = 1.0;
    if (!unitScan(koru_allocator(), s, &d, &sc)) return .{ .bad_unit = .{} };
    var sbuf: [64]u8 = undefined;
    const scale_str = std.fmt.bufPrint(&sbuf, "{d}", .{sc}) catch return .{ .bad_unit = .{} };
    const dc = dimCanon(koru_allocator(), d) catch @panic("std/quantity: out of memory");
    return .{ .ok = .{ .scale = ownedCopy(scale_str), .dim = dc } };
}

// The independent cov tag as an owned field — lit-sym's fresh source.
~tor cov-none { } -> string<std/io:allocated!>

~proc cov-none|zig {
    return ownedCopy("-");
}

// Cov tag text -> owned canonical tag. "-" is independence; "-name" is a
// negated instance of a shared source. | bad names the malformed axis.
~tor cov-tag { s: string }
| ok string<std/io:allocated!>
| bad-tag

~proc cov-tag|zig {
    if (s.len == 0) return .{ .bad_tag = .{} };
    if (std.mem.eql(u8, s, "-")) return .{ .ok = ownedCopy("-") };
    var t = s;
    if (t[0] == '-') t = t[1..];
    if (t.len == 0) return .{ .bad_tag = .{} };
    for (t) |ch| {
        const ok = (ch >= 'a' and ch <= 'z') or (ch >= '0' and ch <= '9') or ch == '_' or ch == '-';
        if (!ok) return .{ .bad_tag = .{} };
    }
    return .{ .ok = ownedCopy(s) };
}

// ============================================================================
// Dim algebra — borrowed canonical dim text in, owned canonical text out.
// The free abelian group: compose adds, invert negates, scale multiplies.
// ============================================================================

~pub tor dim-compose { a: string<std/io:allocated>, b: string<std/io:allocated> } -> string<std/io:allocated!>

~proc dim-compose|zig {
    var da: Dim = undefined;
    var db: Dim = undefined;
    if (!dimParse(a, &da)) @panic("std/quantity:dim-compose: malformed dim");
    if (!dimParse(b, &db)) @panic("std/quantity:dim-compose: malformed dim");
    var d: Dim = DIM_ZERO;
    for (0..7) |i| d[i] = da[i] + db[i];
    return dimCanon(koru_allocator(), d) catch @panic("std/quantity: out of memory");
}

~pub tor dim-invert { a: string<std/io:allocated> } -> string<std/io:allocated!>

~proc dim-invert|zig {
    var da: Dim = undefined;
    if (!dimParse(a, &da)) @panic("std/quantity:dim-invert: malformed dim");
    var d: Dim = DIM_ZERO;
    for (0..7) |i| d[i] = -da[i];
    return dimCanon(koru_allocator(), d) catch @panic("std/quantity: out of memory");
}

~pub tor dim-scale { a: string<std/io:allocated>, n: i64 } -> string<std/io:allocated!>

~proc dim-scale|zig {
    var da: Dim = undefined;
    if (!dimParse(a, &da)) @panic("std/quantity:dim-scale: malformed dim");
    var d: Dim = DIM_ZERO;
    for (0..7) |i| d[i] = da[i] * @as(i32, @intCast(n));
    return dimCanon(koru_allocator(), d) catch @panic("std/quantity: out of memory");
}

~pub tor dim-eq { a: string<std/io:allocated>, b: string<std/io:allocated> }
| same
| diff

~proc dim-eq|zig {
    if (std.mem.eql(u8, a, b)) return .{ .same = .{} };
    return .{ .diff = .{} };
}

// The covariance-join policy, in one place. Tags: "-", "g", "-g" (negated
// instance of shared source g — what qty:neg emits).
//   "-" + "-"      -> | indep "-"     (both independent)
//   "-" + t        -> | indep t       (one-sided: independent sigma, tag kept)
//   g   + g        -> | corr g        (positive full correlation)
//   g   + "-g"     -> | opp g         (negated instance: anti-correlated)
//   g1  + g2       -> | mixed         (correlation unknowable — refuse)
~pub tor cov-join { a: string<std/io:allocated>, b: string<std/io:allocated> }
| indep string<std/io:allocated!>
| corr string<std/io:allocated!>
| opp string<std/io:allocated!>
| mixed

~proc cov-join|zig {
    const Cov = struct { group: []const u8, inv: bool };
    const parse = struct {
        fn go(t: []const u8) ?Cov {
            if (std.mem.eql(u8, t, "-")) return null;
            if (t.len > 1 and t[0] == '-') return .{ .group = t[1..], .inv = true };
            return .{ .group = t, .inv = false };
        }
    }.go;
    const ca = parse(a);
    const cb = parse(b);
    if (ca == null and cb == null) return .{ .indep = ownedCopy("-") };
    if (ca == null) return .{ .indep = ownedCopy(b) };
    if (cb == null) return .{ .indep = ownedCopy(a) };
    if (!std.mem.eql(u8, ca.?.group, cb.?.group)) return .{ .mixed = .{} };
    if (ca.?.inv == cb.?.inv) return .{ .corr = ownedCopy(ca.?.group) };
    return .{ .opp = ownedCopy(ca.?.group) };
}

// Flip a cov tag's instance sign — the tag negation qty:neg applies.
// "-" stays "-" (no source to flip).
~pub tor cov-flip { c: string<std/io:allocated> } -> string<std/io:allocated!>

~proc cov-flip|zig {
    if (std.mem.eql(u8, c, "-")) return ownedCopy("-");
    if (c.len > 1 and c[0] == '-') return ownedCopy(c[1..]);
    return std.mem.concat(koru_allocator(), u8, &.{ "-", c }) catch @panic("std/quantity: out of memory");
}

// The defect sink: declared string<exact!> so an impossible arm can produce
// it and satisfy the checker — it panics if ever reached.
~tor unreachable { } -> string<exact!>

~proc unreachable|zig {
    @panic("std/quantity: unreachable arm reached");
}


// ============================================================================
// Arithmetic — Koru impls. The laws are declared data: every step is a
// std/num call, and the uncertainty formula is spelled in the open.
// ============================================================================

// Free every field of two unpacked quantities — the dim-mismatch/mixed-cov
// discharge path.
~tor free-fields { am: string<std/num:!exact>, au: string<std/num:!exact>, ad: string<std/io:!allocated>, ac: string<std/io:!allocated>, bm: string<std/num:!exact>, bu: string<std/num:!exact>, bd: string<std/io:!allocated>, bc: string<std/io:!allocated> }

~free-fields = std/num:free(n: am) |> std/num:free(n: au) |> std/io:free(content: ad) |> std/io:free(content: ac) |> std/num:free(n: bm) |> std/num:free(n: bu) |> std/io:free(content: bd) |> std/io:free(content: bc)

// Same discharge for the symbolic lane — mags go to sym:free.
~tor free-fields-s { am: string<std/sym:!sexpr>, au: string<std/num:!exact>, ad: string<std/io:!allocated>, ac: string<std/io:!allocated>, bm: string<std/sym:!sexpr>, bu: string<std/num:!exact>, bd: string<std/io:!allocated>, bc: string<std/io:!allocated> }

~free-fields-s = std/sym:free(n: am) |> std/sym:free(n: bm) |> std/num:free(n: au) |> std/num:free(n: bu) |> std/io:free(content: ad) |> std/io:free(content: ac) |> std/io:free(content: bd) |> std/io:free(content: bc)

// Symbolic add lane: magnitudes combine through std/sym; the sigma law is
// unchanged — uncs are decimal on both lanes, so correlated groups still
// join linearly and quadrature still applies.
~tor add-finish-s { sig: string<std/num:!exact>, am: string<std/sym:!sexpr>, bm: string<std/sym:!sexpr>, ad: string<std/io:!allocated>, ac: string<std/io:!allocated>, bd: string<std/io:!allocated>, bc: string<std/io:!allocated>, g: string<std/io:!allocated> } -> string<exact!>

~add-finish-s = std/sym:add(a: am, b: bm): rm |> pack-sym(mag: rm, unc: sig, dim: ad, cov: g): q |> std/io:free(content: ac) |> std/io:free(content: bd) |> std/io:free(content: bc) -> q

~tor add-sym { am: string<std/sym:!sexpr>, au: string<std/num:!exact>, ad: string<std/io:!allocated>, ac: string<std/io:!allocated>, bm: string<std/sym:!sexpr>, bu: string<std/num:!exact>, bd: string<std/io:!allocated>, bc: string<std/io:!allocated> }
| exact string<exact!>
| dim-mismatch
| mixed-cov

~add-sym = dim-eq(a: ad, b: bd)
| diff |> free-fields-s(am, au, ad, ac, bm, bu, bd, bc) => dim-mismatch
| same |> cov-join(a: ac, b: bc)
    | mixed |> free-fields-s(am, au, ad, ac, bm, bu, bd, bc) => mixed-cov
    | indep g |> std/num:qadd(a: au, b: bu, prec: 15): sig |> add-finish-s(sig, am, bm, ad, ac, bd, bc, g): q => exact q
    | corr g |> std/num:add(a: au, b: bu): sig |> add-finish-s(sig, am, bm, ad, ac, bd, bc, g): q => exact q
    | opp g |> std/num:sub(a: au, b: bu): sd |> std/num:abs(a: sd): sig |> add-finish-s(sig, am, bm, ad, ac, bd, bc, g): q => exact q

// add requires equal dimensions — | dim-mismatch is a lawful outcome, not an
// error path. Sigma law, all four cov cases:
//   indep: σ² = u_a² + u_b²           (quadrature)
//   corr:  σ  = u_a + u_b             (fully correlated — cov = +u_a·u_b)
//   opp:   σ  = |u_a − u_b|           (anti-correlated — bias cancels)
~tor add-finish { sig: string<std/num:!exact>, am: string<std/num:!exact>, bm: string<std/num:!exact>, ad: string<std/io:!allocated>, ac: string<std/io:!allocated>, bd: string<std/io:!allocated>, bc: string<std/io:!allocated>, g: string<std/io:!allocated> } -> string<exact!>

~add-finish = std/num:add(a: am, b: bm): rm |> pack(mag: rm, unc: sig, dim: ad, cov: g): q |> std/io:free(content: ac) |> std/io:free(content: bd) |> std/io:free(content: bc) -> q

~pub tor add { a: string<!exact>, b: string<!exact> }
| exact string<exact!>
| dim-mismatch
| mixed-cov

~add = unpack(n: a)
| num fa |> unpack(n: b)
    | num fb |> dim-eq(a: fa.dim, b: fb.dim)
        | diff |> free-fields(am: fa.mag, au: fa.unc, ad: fa.dim, ac: fa.cov, bm: fb.mag, bu: fb.unc, bd: fb.dim, bc: fb.cov) => dim-mismatch
        | same |> cov-join(a: fa.cov, b: fb.cov)
            | mixed |> free-fields(am: fa.mag, au: fa.unc, ad: fa.dim, ac: fa.cov, bm: fb.mag, bu: fb.unc, bd: fb.dim, bc: fb.cov) => mixed-cov
            | indep g |> std/num:qadd(a: fa.unc, b: fb.unc, prec: 15): sig |> add-finish(sig, am: fa.mag, bm: fb.mag, ad: fa.dim, ac: fa.cov, bd: fb.dim, bc: fb.cov, g): q => exact q
            | corr g |> std/num:add(a: fa.unc, b: fb.unc): sig |> add-finish(sig, am: fa.mag, bm: fb.mag, ad: fa.dim, ac: fa.cov, bd: fb.dim, bc: fb.cov, g): q => exact q
            | opp g |> std/num:sub(a: fa.unc, b: fb.unc): sd |> std/num:abs(a: sd): sig |> add-finish(sig, am: fa.mag, bm: fb.mag, ad: fa.dim, ac: fa.cov, bd: fb.dim, bc: fb.cov, g): q => exact q
    | sym fb |> std/sym:of-dec(n: fa.mag): sm |> add-sym(am: sm, au: fa.unc, ad: fa.dim, ac: fa.cov, bm: fb.mag, bu: fb.unc, bd: fb.dim, bc: fb.cov)
        | exact q => exact q
        | dim-mismatch => dim-mismatch
        | mixed-cov => mixed-cov
| sym fa |> unpack(n: b)
    | num fb |> std/sym:of-dec(n: fb.mag): sm |> add-sym(am: fa.mag, au: fa.unc, ad: fa.dim, ac: fa.cov, bm: sm, bu: fb.unc, bd: fb.dim, bc: fb.cov)
        | exact q => exact q
        | dim-mismatch => dim-mismatch
        | mixed-cov => mixed-cov
    | sym fb |> add-sym(am: fa.mag, au: fa.unc, ad: fa.dim, ac: fa.cov, bm: fb.mag, bu: fb.unc, bd: fb.dim, bc: fb.cov)
        | exact q => exact q
        | dim-mismatch => dim-mismatch
        | mixed-cov => mixed-cov

// Negation: magnitude flips, sigma keeps its size, the cov tag flips sign —
// "-g" is the same shared source seen through a negated instance, which is
// what makes bias cancellation in `sub` lawful.
~pub tor neg { n: string<!exact> } -> string<exact!>

~neg = unpack(n)
| num f |> cov-flip(c: f.cov): nc |> std/num:neg(a: f.mag): nm |> pack(mag: nm, f.unc, f.dim, cov: nc): q |> std/io:free(content: f.cov) -> q
| sym f |> cov-flip(c: f.cov): nc |> std/sym:neg(a: f.mag): nm |> pack-sym(mag: nm, f.unc, f.dim, cov: nc): q |> std/io:free(content: f.cov) -> q

~pub tor sub { a: string<!exact>, b: string<!exact> }
| exact string<exact!>
| dim-mismatch
| mixed-cov

~sub = neg(n: b): nb |> add(a, b: nb)
| exact q => exact q
| dim-mismatch => dim-mismatch
| mixed-cov => mixed-cov

// rel-term: u / |m| — a factor's relative sigma. u == "0e0" contributes zero
// even at |m| == 0 (the 0·∞ case resolves to the zero limit); only a nonzero
// sigma over a zero magnitude lands on | undef.
~tor rel-term { u: string<std/num:!exact>, m: string<std/num:!exact> }
| ok string<std/num:exact!>
| undef

~rel-term = std/num:dup(n: u): du |> std/num:is-zero(n: du.a)
| zero |> std/num:free(n: du.a) |> std/num:free(n: m) => ok du.b
| nonzero |> std/num:free(n: du.a) |> std/num:abs(a: m): am |> std/num:div(a: du.b, b: am, prec: 15)
    | exact r => ok r
    | div-zero => undef

// mul/div shared prep: result magnitude + both relative sigmas.
~tor mul-prep { am: string<std/num:!exact>, au: string<std/num:!exact>, bm: string<std/num:!exact>, bu: string<std/num:!exact> }
| ok { rm: string<std/num:exact!>, ra: string<std/num:exact!>, rb: string<std/num:exact!> }
| undef

~mul-prep = std/num:dup(n: am): da |> std/num:dup(n: bm): db |> std/num:mul(da.a, b: db.a): rm |> rel-term(u: au, m: da.b)
| undef |> std/num:free(n: rm) |> std/num:free(n: db.b) |> std/num:free(n: bu) => undef
| ok ra |> rel-term(u: bu, m: db.b)
    | undef |> std/num:free(n: rm) |> std/num:free(n: ra) => undef
    | ok rb => ok { rm, ra, rb }

~tor mul-finish { rel: string<std/num:!exact>, rm: string<std/num:!exact>, ad: string<std/io:!allocated>, ac: string<std/io:!allocated>, bd: string<std/io:!allocated>, bc: string<std/io:!allocated>, g: string<std/io:!allocated> } -> string<exact!>

~mul-finish = dim-compose(a: ad, b: bd): rd |> std/num:dup(n: rm): dr |> std/num:abs(dr.a): ar |> std/num:mul(a: ar, b: rel): sig |> pack(mag: dr.b, unc: sig, dim: rd, cov: g): q |> std/io:free(content: ad) |> std/io:free(content: ac) |> std/io:free(content: bd) |> std/io:free(content: bc) -> q

// Dimensions compose under multiplication (the free abelian group adds).
// Sigma law on the RELATIVE uncertainties — same four cov cases as add:
//   indep -> quadrature, corr -> sum, opp -> |difference|; then σ=|mag|·σ_rel.
// Symbolic magnitude lane for mul/div: exact quantities (unc "0e0")
// compose freely; a nonzero sigma would need |mag| as a decimal — the
// MetricApprox eval lane — so it refuses | sym-unc by name.
~tor mul-sym-fin { am: string<std/sym:!sexpr>, au: string<std/num:!exact>, ad: string<std/io:!allocated>, ac: string<std/io:!allocated>, bm: string<std/sym:!sexpr>, bu: string<std/num:!exact>, bd: string<std/io:!allocated>, bc: string<std/io:!allocated>, g: string<std/io:!allocated> }
| exact string<exact!>
| sym-unc

~mul-sym-fin = std/num:is-zero(n: au)
| nonzero |> std/num:free(n: au) |> std/num:free(n: bu) |> std/sym:free(n: am) |> std/sym:free(n: bm) |> std/io:free(content: ad) |> std/io:free(content: ac) |> std/io:free(content: bd) |> std/io:free(content: bc) |> std/io:free(content: g) => sym-unc
| zero |> std/num:free(n: au) |> std/num:is-zero(n: bu)
    | nonzero |> std/num:free(n: bu) |> std/sym:free(n: am) |> std/sym:free(n: bm) |> std/io:free(content: ad) |> std/io:free(content: ac) |> std/io:free(content: bd) |> std/io:free(content: bc) |> std/io:free(content: g) => sym-unc
    | zero |> std/num:free(n: bu) |> std/sym:mul(a: am, b: bm): rm |> dim-compose(a: ad, b: bd): rd |> std/io:free(content: ad) |> std/io:free(content: ac) |> std/io:free(content: bd) |> std/io:free(content: bc) |> std/num:from-int(i: 0): z |> pack-sym(mag: rm, unc: z, dim: rd, cov: g): q => exact q

~tor mul-sym { am: string<std/sym:!sexpr>, au: string<std/num:!exact>, ad: string<std/io:!allocated>, ac: string<std/io:!allocated>, bm: string<std/sym:!sexpr>, bu: string<std/num:!exact>, bd: string<std/io:!allocated>, bc: string<std/io:!allocated> }
| exact string<exact!>
| mixed-cov
| sym-unc

~mul-sym = cov-join(a: ac, b: bc)
| mixed |> free-fields-s(am, au, ad, ac, bm, bu, bd, bc) => mixed-cov
| indep g |> mul-sym-fin(am, au, ad, ac, bm, bu, bd, bc, g)
    | exact q => exact q
    | sym-unc => sym-unc
| corr g |> mul-sym-fin(am, au, ad, ac, bm, bu, bd, bc, g)
    | exact q => exact q
    | sym-unc => sym-unc
| opp g |> mul-sym-fin(am, au, ad, ac, bm, bu, bd, bc, g)
    | exact q => exact q
    | sym-unc => sym-unc

~pub tor mul { a: string<!exact>, b: string<!exact> }
| exact string<exact!>
| mixed-cov
| bad string
| sym-unc

~mul = unpack(n: a)
| num fa |> unpack(n: b)
    | num fb |> cov-join(a: fa.cov, b: fb.cov)
        | mixed |> free-fields(am: fa.mag, au: fa.unc, ad: fa.dim, ac: fa.cov, bm: fb.mag, bu: fb.unc, bd: fb.dim, bc: fb.cov) => mixed-cov
        | indep g |> mul-prep(am: fa.mag, au: fa.unc, bm: fb.mag, bu: fb.unc)
            | undef |> std/io:free(content: fa.dim) |> std/io:free(content: fa.cov) |> std/io:free(content: fb.dim) |> std/io:free(content: fb.cov) |> std/io:free(content: g) => bad "qty:mul: relative uncertainty undefined at zero magnitude"
            | ok p |> std/num:qadd(a: p.ra, b: p.rb, prec: 15): rel |> mul-finish(rel, p.rm, ad: fa.dim, ac: fa.cov, bd: fb.dim, bc: fb.cov, g): q => exact q
        | corr g |> mul-prep(am: fa.mag, au: fa.unc, bm: fb.mag, bu: fb.unc)
            | undef |> std/io:free(content: fa.dim) |> std/io:free(content: fa.cov) |> std/io:free(content: fb.dim) |> std/io:free(content: fb.cov) |> std/io:free(content: g) => bad "qty:mul: relative uncertainty undefined at zero magnitude"
            | ok p |> std/num:add(a: p.ra, b: p.rb): rel |> mul-finish(rel, p.rm, ad: fa.dim, ac: fa.cov, bd: fb.dim, bc: fb.cov, g): q => exact q
        | opp g |> mul-prep(am: fa.mag, au: fa.unc, bm: fb.mag, bu: fb.unc)
            | undef |> std/io:free(content: fa.dim) |> std/io:free(content: fa.cov) |> std/io:free(content: fb.dim) |> std/io:free(content: fb.cov) |> std/io:free(content: g) => bad "qty:mul: relative uncertainty undefined at zero magnitude"
            | ok p |> std/num:sub(a: p.ra, b: p.rb): sd |> std/num:abs(a: sd): rel |> mul-finish(rel, p.rm, ad: fa.dim, ac: fa.cov, bd: fb.dim, bc: fb.cov, g): q => exact q
    | sym fb |> std/sym:of-dec(n: fa.mag): sm |> mul-sym(am: sm, au: fa.unc, ad: fa.dim, ac: fa.cov, bm: fb.mag, bu: fb.unc, bd: fb.dim, bc: fb.cov)
        | exact q => exact q
        | mixed-cov => mixed-cov
        | sym-unc => sym-unc
| sym fa |> unpack(n: b)
    | num fb |> std/sym:of-dec(n: fb.mag): sm |> mul-sym(am: fa.mag, au: fa.unc, ad: fa.dim, ac: fa.cov, bm: sm, bu: fb.unc, bd: fb.dim, bc: fb.cov)
        | exact q => exact q
        | mixed-cov => mixed-cov
        | sym-unc => sym-unc
    | sym fb |> mul-sym(am: fa.mag, au: fa.unc, ad: fa.dim, ac: fa.cov, bm: fb.mag, bu: fb.unc, bd: fb.dim, bc: fb.cov)
        | exact q => exact q
        | mixed-cov => mixed-cov
        | sym-unc => sym-unc

~tor div-prep { am: string<std/num:!exact>, au: string<std/num:!exact>, bm: string<std/num:!exact>, bu: string<std/num:!exact>, prec: i64 }
| ok { rm: string<std/num:exact!>, ra: string<std/num:exact!>, rb: string<std/num:exact!> }
| undef
| div-zero

~div-prep = std/num:dup(n: am): da |> std/num:dup(n: bm): db |> std/num:div(da.a, b: db.a, prec)
| div-zero |> std/num:free(n: da.b) |> std/num:free(n: db.b) |> std/num:free(n: au) |> std/num:free(n: bu) => div-zero
| exact rm |> rel-term(u: au, m: da.b)
    | undef |> std/num:free(n: rm) |> std/num:free(n: db.b) |> std/num:free(n: bu) => undef
    | ok ra |> rel-term(u: bu, m: db.b)
        | undef |> std/num:free(n: rm) |> std/num:free(n: ra) => undef
        | ok rb => ok { rm, ra, rb }

~tor div-finish { rel: string<std/num:!exact>, rm: string<std/num:!exact>, ad: string<std/io:!allocated>, ac: string<std/io:!allocated>, bd: string<std/io:!allocated>, bc: string<std/io:!allocated>, g: string<std/io:!allocated> } -> string<exact!>

~div-finish = dim-invert(a: bd): ibd |> dim-compose(a: ad, b: ibd): rd |> std/io:free(content: ibd) |> std/num:dup(n: rm): dr |> std/num:abs(dr.a): ar |> std/num:mul(a: ar, b: rel): sig |> pack(mag: dr.b, unc: sig, dim: rd, cov: g): q |> std/io:free(content: ad) |> std/io:free(content: ac) |> std/io:free(content: bd) |> std/io:free(content: bc) -> q

// Dimensions subtract under division (compose with the inverse). Same
// relative-sigma law as mul.
~tor div-sym-fin { am: string<std/sym:!sexpr>, au: string<std/num:!exact>, ad: string<std/io:!allocated>, ac: string<std/io:!allocated>, bm: string<std/sym:!sexpr>, bu: string<std/num:!exact>, bd: string<std/io:!allocated>, bc: string<std/io:!allocated>, g: string<std/io:!allocated> }
| exact string<exact!>
| div-zero
| sym-unc

~div-sym-fin = std/num:is-zero(n: au)
| nonzero |> std/num:free(n: au) |> std/num:free(n: bu) |> std/sym:free(n: am) |> std/sym:free(n: bm) |> std/io:free(content: ad) |> std/io:free(content: ac) |> std/io:free(content: bd) |> std/io:free(content: bc) |> std/io:free(content: g) => sym-unc
| zero |> std/num:free(n: au) |> std/num:is-zero(n: bu)
    | nonzero |> std/num:free(n: bu) |> std/sym:free(n: am) |> std/sym:free(n: bm) |> std/io:free(content: ad) |> std/io:free(content: ac) |> std/io:free(content: bd) |> std/io:free(content: bc) |> std/io:free(content: g) => sym-unc
    | zero |> std/num:free(n: bu) |> std/sym:div(a: am, b: bm)
        | div-zero |> std/io:free(content: ad) |> std/io:free(content: ac) |> std/io:free(content: bd) |> std/io:free(content: bc) |> std/io:free(content: g) => div-zero
        | exact rm |> dim-invert(a: bd): ibd |> dim-compose(a: ad, b: ibd): rd |> std/io:free(content: ibd) |> std/io:free(content: ad) |> std/io:free(content: ac) |> std/io:free(content: bd) |> std/io:free(content: bc) |> std/num:from-int(i: 0): z |> pack-sym(mag: rm, unc: z, dim: rd, cov: g): q => exact q

~tor div-sym { am: string<std/sym:!sexpr>, au: string<std/num:!exact>, ad: string<std/io:!allocated>, ac: string<std/io:!allocated>, bm: string<std/sym:!sexpr>, bu: string<std/num:!exact>, bd: string<std/io:!allocated>, bc: string<std/io:!allocated> }
| exact string<exact!>
| div-zero
| mixed-cov
| sym-unc

~div-sym = cov-join(a: ac, b: bc)
| mixed |> free-fields-s(am, au, ad, ac, bm, bu, bd, bc) => mixed-cov
| indep g |> div-sym-fin(am, au, ad, ac, bm, bu, bd, bc, g)
    | exact q => exact q
    | div-zero => div-zero
    | sym-unc => sym-unc
| corr g |> div-sym-fin(am, au, ad, ac, bm, bu, bd, bc, g)
    | exact q => exact q
    | div-zero => div-zero
    | sym-unc => sym-unc
| opp g |> div-sym-fin(am, au, ad, ac, bm, bu, bd, bc, g)
    | exact q => exact q
    | div-zero => div-zero
    | sym-unc => sym-unc

~pub tor div { a: string<!exact>, b: string<!exact>, prec: i64 }
| exact string<exact!>
| div-zero
| mixed-cov
| bad string
| sym-unc

~div = unpack(n: a)
| num fa |> unpack(n: b)
    | num fb |> cov-join(a: fa.cov, b: fb.cov)
        | mixed |> free-fields(am: fa.mag, au: fa.unc, ad: fa.dim, ac: fa.cov, bm: fb.mag, bu: fb.unc, bd: fb.dim, bc: fb.cov) => mixed-cov
        | indep g |> div-prep(am: fa.mag, au: fa.unc, bm: fb.mag, bu: fb.unc, prec)
            | div-zero |> std/io:free(content: fa.dim) |> std/io:free(content: fa.cov) |> std/io:free(content: fb.dim) |> std/io:free(content: fb.cov) |> std/io:free(content: g) => div-zero
            | undef |> std/io:free(content: fa.dim) |> std/io:free(content: fa.cov) |> std/io:free(content: fb.dim) |> std/io:free(content: fb.cov) |> std/io:free(content: g) => bad "qty:div: relative uncertainty undefined at zero magnitude"
            | ok p |> std/num:qadd(a: p.ra, b: p.rb, prec: 15): rel |> div-finish(rel, p.rm, ad: fa.dim, ac: fa.cov, bd: fb.dim, bc: fb.cov, g): q => exact q
        | corr g |> div-prep(am: fa.mag, au: fa.unc, bm: fb.mag, bu: fb.unc, prec)
            | div-zero |> std/io:free(content: fa.dim) |> std/io:free(content: fa.cov) |> std/io:free(content: fb.dim) |> std/io:free(content: fb.cov) |> std/io:free(content: g) => div-zero
            | undef |> std/io:free(content: fa.dim) |> std/io:free(content: fa.cov) |> std/io:free(content: fb.dim) |> std/io:free(content: fb.cov) |> std/io:free(content: g) => bad "qty:div: relative uncertainty undefined at zero magnitude"
            | ok p |> std/num:add(a: p.ra, b: p.rb): rel |> div-finish(rel, p.rm, ad: fa.dim, ac: fa.cov, bd: fb.dim, bc: fb.cov, g): q => exact q
        | opp g |> div-prep(am: fa.mag, au: fa.unc, bm: fb.mag, bu: fb.unc, prec)
            | div-zero |> std/io:free(content: fa.dim) |> std/io:free(content: fa.cov) |> std/io:free(content: fb.dim) |> std/io:free(content: fb.cov) |> std/io:free(content: g) => div-zero
            | undef |> std/io:free(content: fa.dim) |> std/io:free(content: fa.cov) |> std/io:free(content: fb.dim) |> std/io:free(content: fb.cov) |> std/io:free(content: g) => bad "qty:div: relative uncertainty undefined at zero magnitude"
            | ok p |> std/num:sub(a: p.ra, b: p.rb): sd |> std/num:abs(a: sd): rel |> div-finish(rel, p.rm, ad: fa.dim, ac: fa.cov, bd: fb.dim, bc: fb.cov, g): q => exact q
    | sym fb |> std/sym:of-dec(n: fa.mag): sm |> div-sym(am: sm, au: fa.unc, ad: fa.dim, ac: fa.cov, bm: fb.mag, bu: fb.unc, bd: fb.dim, bc: fb.cov)
        | exact q => exact q
        | div-zero => div-zero
        | mixed-cov => mixed-cov
        | sym-unc => sym-unc
| sym fa |> unpack(n: b)
    | num fb |> std/sym:of-dec(n: fb.mag): sm |> div-sym(am: fa.mag, au: fa.unc, ad: fa.dim, ac: fa.cov, bm: sm, bu: fb.unc, bd: fb.dim, bc: fb.cov)
        | exact q => exact q
        | div-zero => div-zero
        | mixed-cov => mixed-cov
        | sym-unc => sym-unc
    | sym fb |> div-sym(am: fa.mag, au: fa.unc, ad: fa.dim, ac: fa.cov, bm: fb.mag, bu: fb.unc, bd: fb.dim, bc: fb.cov)
        | exact q => exact q
        | div-zero => div-zero
        | mixed-cov => mixed-cov
        | sym-unc => sym-unc

// q^n for integer n. n = 0 -> dimensionless 1 (sigma 0); n < 0 -> reciprocal,
// dims negate. Sigma law: σ = |n|·|mag|^(n-1)·u  (n > 0),
//                     σ = |n|·u / |mag|^(|n|+1)  (n < 0).
// The neg-exp arms below are unreachable by construction — e > 0 in both
// helpers — and route to the defect sink, loudly.
~tor pow-pos { mag: string<std/num:!exact>, unc: string<std/num:!exact>, dim: string<std/io:!allocated>, cov: string<std/io:!allocated>, e: i64 } -> string<exact!>

~pow-pos = std/num:dup(n: mag): dm |> std/num:abs(a: dm.b): am |> std/num:pow(a: am, n: e - 1)
| neg-exp |> std/num:free(n: dm.a) |> std/num:free(n: unc) |> std/io:free(content: dim) |> std/io:free(content: cov) |> unreachable(): r -> r
| exact p1 |> std/num:from-int(i: e): en |> std/num:mul(a: en, b: unc): t |> std/num:mul(a: t, b: p1): sig |> std/num:pow(dm.a, n: e)
    | neg-exp |> std/num:free(n: sig) |> std/io:free(content: dim) |> std/io:free(content: cov) |> unreachable(): r -> r
    | exact rm |> dim-scale(a: dim, n: e): rd |> std/io:free(content: dim) |> pack(mag: rm, unc: sig, dim: rd, cov): q -> q

~tor pow-neg { mag: string<std/num:!exact>, unc: string<std/num:!exact>, dim: string<std/io:!allocated>, cov: string<std/io:!allocated>, e: i64 }
| exact string<exact!>
| div-zero

~pow-neg = std/num:dup(n: mag): dm |> std/num:abs(a: dm.b): am |> std/num:dup(n: am): da |> std/num:pow(dm.a, n: e)
| neg-exp |> std/num:free(n: da.a) |> std/num:free(n: da.b) |> std/num:free(n: unc) |> std/io:free(content: dim) |> std/io:free(content: cov) |> unreachable(): r => exact r
| exact pfull |> std/num:pow(da.a, n: e)
    | neg-exp |> std/num:free(n: pfull) |> std/num:free(n: da.b) |> std/num:free(n: unc) |> std/io:free(content: dim) |> std/io:free(content: cov) |> unreachable(): r => exact r
    | exact pe |> std/num:mul(a: pe, da.b): den |> std/num:from-int(i: e): en |> std/num:mul(a: en, b: unc): t |> std/num:div(a: t, b: den, prec: 15)
        | div-zero |> std/num:free(n: pfull) |> std/io:free(content: dim) |> std/io:free(content: cov) |> unreachable(): r => exact r
        | exact sig |> std/num:from-int(i: 1): one |> std/num:div(a: one, b: pfull, prec: 15)
            | div-zero |> std/num:free(n: sig) |> std/io:free(content: dim) |> std/io:free(content: cov) => div-zero
            | exact rm |> dim-scale(a: dim, n: 0 - e): rd |> std/io:free(content: dim) |> pack(mag: rm, unc: sig, dim: rd, cov): q => exact q

~pub tor pow { a: string<!exact>, n: i64 }
| exact string<exact!>
| div-zero
| sym-unc

~pow = unpack(n: a)
| num f |> if(n == 0)
    | then |> dim-scale(a: f.dim, n: 0): rd |> std/num:free(n: f.mag) |> std/num:free(n: f.unc) |> std/io:free(content: f.dim) |> std/num:from-int(i: 1): one |> std/num:from-int(i: 0): z |> pack(mag: one, unc: z, dim: rd, f.cov): q => exact q
    | else |> if(n < 0)
        | then |> pow-neg(f.mag, f.unc, f.dim, f.cov, e: 0 - n)
            | exact q => exact q
            | div-zero => div-zero
        | else |> pow-pos(f.mag, f.unc, f.dim, f.cov, e: n): q => exact q
| sym f |> if(n == 0)
    | then |> dim-scale(a: f.dim, n: 0): rd |> std/sym:free(n: f.mag) |> std/num:free(n: f.unc) |> std/io:free(content: f.dim) |> std/num:from-int(i: 1): one |> std/num:from-int(i: 0): z |> pack(mag: one, unc: z, dim: rd, f.cov): q => exact q
    | else |> std/num:is-zero(n: f.unc)
        | nonzero |> std/num:free(n: f.unc) |> std/sym:free(n: f.mag) |> std/io:free(content: f.dim) |> std/io:free(content: f.cov) => sym-unc
        | zero |> std/num:free(n: f.unc) |> std/sym:pow(a: f.mag, n)
            | div-zero |> std/io:free(content: f.dim) |> std/io:free(content: f.cov) => div-zero
            | exact rm |> dim-scale(a: f.dim, n): rd |> std/io:free(content: f.dim) |> std/num:from-int(i: 0): z |> pack-sym(mag: rm, unc: z, dim: rd, f.cov): q => exact q

// ============================================================================
// Accessors and linearity
// ============================================================================

// equiv: the equivalence law. Canonical packs are string-equal iff equal —
// dims are normalized at pack time, so m/s·s == m is a string comparison.
~pub tor equiv { a: string<exact>, b: string<exact> }
| same
| diff

~proc equiv|zig {
    if (std.mem.eql(u8, a, b)) return .{ .same = .{} };
    return .{ .diff = .{} };
}

// Unwrap the magnitude — a lane union: decimal canon under
// <std/num:exact!>, symbolic canon under <std/sym:sexpr!>.
~pub tor mag { q: string<!exact> }
| num string<std/num:exact!>
| sym string<std/sym:sexpr!>

~mag = dup(n: q): d |> unpack(n: d.b)
| num f |> std/num:free(n: f.unc) |> std/io:free(content: f.dim) |> std/io:free(content: f.cov) |> free(n: d.a) => num f.mag
| sym f |> std/num:free(n: f.unc) |> std/io:free(content: f.dim) |> std/io:free(content: f.cov) |> free(n: d.a) => sym f.mag

// The dimension vector as canonical text — for diagnostics and print.
~pub tor dim { q: string<!exact> } -> string<std/io:allocated!>

~dim = dup(n: q): d |> unpack(n: d.b)
| num f |> std/num:free(n: f.mag) |> std/num:free(n: f.unc) |> std/io:free(content: f.cov) |> free(n: d.a) -> f.dim
| sym f |> std/sym:free(n: f.mag) |> std/num:free(n: f.unc) |> std/io:free(content: f.cov) |> free(n: d.a) -> f.dim

// The sigma as canonical decimal text ("0e0" when the quantity is certain).
~pub tor unc { q: string<!exact> } -> string<std/io:allocated!>

~unc = dup(n: q): d |> unpack(n: d.b)
| num f |> std/num:free(n: f.mag) |> std/io:free(content: f.dim) |> std/io:free(content: f.cov) |> std/num:render(n: f.unc): t |> free(n: d.a) -> t
| sym f |> std/sym:free(n: f.mag) |> std/io:free(content: f.dim) |> std/io:free(content: f.cov) |> std/num:render(n: f.unc): t |> free(n: d.a) -> t

// The shared-source tag ("-" when independent).
~pub tor cov { q: string<!exact> } -> string<std/io:allocated!>

~cov = dup(n: q): d |> unpack(n: d.b)
| num f |> std/num:free(n: f.mag) |> std/num:free(n: f.unc) |> std/io:free(content: f.dim) |> free(n: d.a) -> f.cov
| sym f |> std/sym:free(n: f.mag) |> std/num:free(n: f.unc) |> std/io:free(content: f.dim) |> free(n: d.a) -> f.cov

~pub tor dup { n: string<!exact> } -> { a: string<exact!>, b: string<exact!> }

~proc dup|zig {
    const cp = ownedCopy(n);
    return .{ .a = n, .b = cp };
}

~pub tor free { n: string<!exact> }

~proc free|zig {
    qtyFree(n);
}

// Render: the canonical pack text, handed to the io tower as <allocated!>.
~pub tor render { n: string<!exact> } -> string<std/io:allocated!>

~proc render|zig {
    return n;
}
