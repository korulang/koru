// std/env - Environment variable access
//
// Simple, safe access to environment variables.

const std = @import("std");

// ============================================================================
// Get environment variable
// ============================================================================

~pub tor get { name: string }
| ok string
| not-set

~proc get|zig {
    const value = std.posix.getenv(name) orelse {
        return .{ .not_set = .{} };
    };
    return .{ .ok = value };
}

// Get with default value
~pub tor get.or { name: string, default: string } -> string

~proc get.or|zig {
    const value = std.posix.getenv(name) orelse default;
    return value;
}

// Check if variable is set
~pub tor is-set { name: string }
| yes
| no

~proc is-set|zig {
    if (std.posix.getenv(name)) |_| {
        return .{ .yes = .{} };
    }
    return .{ .no = .{} };
}

// Require - fail loudly if not set (for critical config)
~pub tor require { name: string }
| ok string
| missing string

~proc require|zig {
    const value = std.posix.getenv(name) orelse {
        return .{ .missing = name };
    };
    return .{ .ok = value };
}
