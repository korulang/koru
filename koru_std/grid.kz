// Koru Standard Library: Grid — a fixed, positionally-addressed table
// =====================================================================
//
// A grid is the OTHER kind of table, and the distinction is one question:
// CAN A ROW MOVE?
//
//   std/store — yes. `take` swap-removes, so position is not identity, so a
//               row is named by a generational HANDLE and every access pays a
//               brand + bounds + generation check. The store earns that
//               machinery by supporting removal.
//
//   std/grid  — no. Every cell exists from declaration and none is ever
//               inserted, removed or relocated, so POSITION IS IDENTITY. A
//               grid pays nothing: no handles, no generation word, no sparse
//               indirection, no freelist, no `len`.
//
// A grid is therefore the degenerate, fastest table in the language, and it
// gets there by forbidding something rather than by optimising.
//
// USAGE:
//   ~import std/grid
//
//   std/grid:new(cells, size: 4096) { count: 0[i64], sx: 0.0[f32] }
//   std/grid:stored { cells[h].count: cells[h].count + 1 }
//
// SIZE, not capacity. `capacity: N` means "up to N, currently `len`". A grid
// is EXACTLY N cells, all live from the moment it is declared. Different
// contract, different word, so the two declarations cannot be misread.
//
// OUT OF RANGE TRAPS (ruled 2026-08-03). An index outside `0..size` is a
// panic naming the grid, matching the store's stale-handle floor: fail loud,
// never silently address a neighbour. Wrapping is the PROGRAM's decision and
// belongs in the source as an explicit `% size` where a reader can see it — a
// spatial hash wants exactly that and should say so.
//
// The check is a floor, not a tax to be paid forever: an index the compiler
// can prove in range needs none, and a `! sweep` arm over a grid is precisely
// that case — the loop constructs the index from `0..size`, so validating it
// would be validating a fact established one line above. That is the same
// floor-then-prove-away arc the store's handle check follows.
//
// NOT REACTIVE, deliberately, and the seam is left open. Nothing about a grid
// forbids watches or interceptors — reactivity in Koru is spliced at comptime
// and costs nothing when nobody listens. But every reactive surface has to
// answer what it FIRES, and a whole-grid clear firing four thousand times is a
// question no workload has asked yet. It gets designed when one does.

const std = @import("std");
const codegen_utils_grid = @import("codegen_utils");

// ============================================================================
// THE READ — one lowering, file scope, so there is only ever one to be wrong
// ============================================================================
//
// `<grid>[<index>].<field>` is the grid's ONLY read spelling, and it occurs in
// three places that used to be three different problems: a write block's value
// (`stored`), a guard or an argument anywhere in the program (`new`'s
// whole-program pass), and a nested index inside another read. They share this
// function. The recurring defect this file is built to avoid is a construct
// with TWO lowerings that agree only by having been written twice — the store
// has paid for that four times (690_245 is the last one), and a grid read is
// small enough that the second copy would have looked harmless.
const ast_grid = @import("ast");

const grid_read = struct {
    // A grid, and THE NAMESPACE ITS CELLS LIVE IN.
    //
    // The namespace is not decoration. A grid declaration emits its cell type
    // and its storage into the module that declared it — `main_module` for an
    // entry file, `koru_app.koru_lib` for `app/lib` — and a read compiled into
    // any OTHER module must say so. Lowering to a bare `__koru_grid_cells`
    // works in exactly the place the declaration is, which is why a single-file
    // test cannot see the difference and why this is the fourth time this file
    // family has shipped an unqualified generated reference (115_018 for the
    // store's paths, 115_044 for `[id]`'s cell, 115_045 for the grid's own
    // units, and now the cells themselves).
    const GridRef = struct {
        name: []const u8,
        ns: []const u8,
    };
    fn find(refs: []const GridRef, n: []const u8) ?GridRef {
        for (refs) |r| {
            if (std.mem.eql(u8, r.name, n)) return r;
        }
        return null;
    }
    // The emitted prefix for a grid declared under `home` — `null` meaning the
    // entry file's top level. Always qualified, never conditionally: a module
    // can name itself in the emitted Zig (`main_module.` inside main_module is
    // how `sweep` already calls its own body event), so there is no case that
    // needs the bare spelling and therefore no second rule to get wrong.
    fn nsFor(alloc: std.mem.Allocator, prog: *const ast_grid.Program, home: ?[]const u8) []const u8 {
        const h = home orelse return "main_module.";
        if (h.len == 0 or std.mem.eql(u8, h, prog.main_module_name)) return "main_module.";
        return std.fmt.allocPrint(alloc, "{s}.", .{codegen_utils_grid.buildKoruModulePath(alloc, h) catch unreachable}) catch unreachable;
    }
    // Every grid declared anywhere in the program, with the namespace it was
    // declared in. `new` may or may not have lowered yet depending on site
    // order, so both spellings count: the raw `std/grid:new` flow and the host
    // line it becomes.
    fn collect(alloc: std.mem.Allocator, prog: *const ast_grid.Program, out: *std.ArrayList(GridRef)) void {
        collectIn(alloc, prog, prog.items, null, out);
    }
    fn collectIn(alloc: std.mem.Allocator, prog: *const ast_grid.Program, its: []const ast_grid.Item, home: ?[]const u8, out: *std.ArrayList(GridRef)) void {
        for (its) |pi| {
            switch (pi) {
                .flow => |f| {
                    const inv = f.inv();
                    if (inv.path.module_qualifier) |mq| {
                        if (std.mem.eql(u8, mq, "std.grid") and inv.path.segments.len == 1 and std.mem.eql(u8, inv.path.segments[0], "new")) {
                            for (inv.args) |a| {
                                if (std.mem.eql(u8, a.name, "expr")) {
                                    var n = a.value;
                                    if (n.len >= 2 and n[0] == '"') n = n[1 .. n.len - 1];
                                    out.append(alloc, GridRef{ .name = n, .ns = nsFor(alloc, prog, home) }) catch unreachable;
                                }
                            }
                        }
                    }
                },
                .host_line => |hl| {
                    const needle = "const __KoruGridT_";
                    var i: usize = 0;
                    while (std.mem.indexOfPos(u8, hl.content, i, needle)) |at| {
                        const s = at + needle.len;
                        var e = s;
                        while (e < hl.content.len and ast_grid.isKebabIdentChar(hl.content[e])) e += 1;
                        out.append(alloc, GridRef{ .name = hl.content[s..e], .ns = nsFor(alloc, prog, home) }) catch unreachable;
                        i = e;
                    }
                },
                .module_decl => |m| collectIn(alloc, prog, m.items, m.logical_name, out),
                else => {},
            }
        }
    }
    // A WRITE TARGET, split into its parts: `lights[x, y].on` is the grid, one
    // or two index expressions, and a column. Only the write side needs the
    // parts — a read is lowered whole — and it needs them because the index
    // and the value are EVALUATED AT THE SITE and threaded in as arguments,
    // not pasted into a proc body that cannot see the site's bindings.
    const Target = struct {
        grid: []const u8,
        x: []const u8,
        y: ?[]const u8,
        field: []const u8,
    };
    fn parseTarget(text: []const u8, refs: []const GridRef) ?Target {
        var e: usize = 0;
        while (e < text.len and ast_grid.isKebabIdentChar(text[e])) e += 1;
        if (e == 0 or e >= text.len or text[e] != '[') return null;
        if (find(refs, text[0..e]) == null) return null;
        var depth: usize = 0;
        var j = e;
        while (j < text.len) {
            if (text[j] == '[') depth += 1;
            if (text[j] == ']') {
                depth -= 1;
                if (depth == 0) break;
            }
            j += 1;
        }
        if (j + 1 >= text.len or text[j + 1] != '.') return null;
        const idx_raw = text[e + 1 .. j];
        var fe = j + 2;
        while (fe < text.len and ast_grid.isKebabIdentChar(text[fe])) fe += 1;
        if (fe == j + 2) return null;
        // Top-level comma only: a comma inside a nested subscript belongs to
        // that subscript, not to this address.
        var comma: ?usize = null;
        var d2: usize = 0;
        var k: usize = 0;
        while (k < idx_raw.len) : (k += 1) {
            if (idx_raw[k] == '[' or idx_raw[k] == '(') d2 += 1;
            if (idx_raw[k] == ']' or idx_raw[k] == ')') d2 -= 1;
            if (idx_raw[k] == ',' and d2 == 0) {
                comma = k;
                break;
            }
        }
        if (comma) |cm| {
            return Target{
                .grid = text[0..e],
                .x = std.mem.trim(u8, idx_raw[0..cm], " "),
                .y = std.mem.trim(u8, idx_raw[cm + 1 ..], " "),
                .field = text[j + 2 .. fe],
            };
        }
        return Target{ .grid = text[0..e], .x = std.mem.trim(u8, idx_raw, " "), .y = null, .field = text[j + 2 .. fe] };
    }
    // A column's declared type. The write threads the value through a typed
    // event input, so the type has to be recovered from the declaration — and
    // as everywhere else in this file, the declaration has two spellings
    // depending on site order: the raw `std/grid:new` flow (`count: 0[i64]`)
    // and the host line it becomes (`    count: [8]i64 = ...`).
    fn columnType(alloc: std.mem.Allocator, its: []const ast_grid.Item, grid: []const u8, field: []const u8) ?[]const u8 {
        for (its) |pi| {
            switch (pi) {
                .flow => |f| {
                    const inv = f.inv();
                    const mq = inv.path.module_qualifier orelse continue;
                    if (!std.mem.eql(u8, mq, "std.grid")) continue;
                    if (inv.path.segments.len != 1 or !std.mem.eql(u8, inv.path.segments[0], "new")) continue;
                    var this_name: []const u8 = "";
                    var block: []const u8 = "";
                    for (inv.args) |a| {
                        if (std.mem.eql(u8, a.name, "expr")) {
                            this_name = a.value;
                            if (this_name.len >= 2 and this_name[0] == '"') this_name = this_name[1 .. this_name.len - 1];
                        } else if (std.mem.eql(u8, a.name, "source")) {
                            block = a.value;
                        }
                    }
                    if (!std.mem.eql(u8, this_name, grid) or block.len == 0) continue;
                    const struct_literal_g = @import("struct_literal");
                    const braced = std.fmt.allocPrint(alloc, "{{{s}}}", .{block}) catch unreachable;
                    const cols = struct_literal_g.parseFields(alloc, braced) catch continue;
                    for (cols) |c| {
                        if (!std.mem.eql(u8, std.mem.trim(u8, c.name, " "), field)) continue;
                        const v = std.mem.trim(u8, c.value, " ");
                        const lb = std.mem.indexOfScalar(u8, v, '[') orelse continue;
                        if (v.len == 0 or v[v.len - 1] != ']') continue;
                        return std.mem.trim(u8, v[lb + 1 .. v.len - 1], " ");
                    }
                },
                .host_line => |hl| {
                    const head = std.fmt.allocPrint(alloc, "const __KoruGridT_{s} = struct {{", .{grid}) catch unreachable;
                    const at = std.mem.indexOf(u8, hl.content, head) orelse continue;
                    const needle = std.fmt.allocPrint(alloc, "\n    {s}: [", .{field}) catch unreachable;
                    const fat = std.mem.indexOfPos(u8, hl.content, at, needle) orelse continue;
                    const after = fat + needle.len;
                    const close = std.mem.indexOfScalarPos(u8, hl.content, after, ']') orelse continue;
                    var te = close + 1;
                    while (te < hl.content.len and ast_grid.isKebabIdentChar(hl.content[te])) te += 1;
                    return hl.content[close + 1 .. te];
                },
                .module_decl => |m| {
                    if (columnType(alloc, m.items, grid, field)) |hit| return hit;
                },
                else => {},
            }
        }
        return null;
    }
    // Rewrite every `<grid>[<expr>].<field>` in `text` to its lowered form.
    //
    // The column is named through a POINTER before the index: a by-value base
    // makes Zig materialise the whole column ahead of a call-valued index,
    // which cost 1750x on the store's read path
    // (frag-a-call-valued-index-copies-the-whole-array).
    //
    // MASKED, because this now runs over arbitrary program text and not just
    // write blocks: inside a string only a `{{ … }}` interpolation is an
    // expression, so prose that happens to read like a subscript is left alone
    // and an interpolated cell read is not.
    fn lower(alloc: std.mem.Allocator, text: []const u8, refs: []const GridRef) []const u8 {
        const expr_ctx = ast_grid.expressionMask(alloc, text);
        var out = std.ArrayList(u8).initCapacity(alloc, text.len + 64) catch unreachable;
        var i: usize = 0;
        while (i < text.len) {
            var matched = false;
            if (expr_ctx[i] and ast_grid.identBoundaryBefore(text, i)) {
                var e = i;
                while (e < text.len and ast_grid.isKebabIdentChar(text[e])) e += 1;
                if (e > i and e < text.len and text[e] == '[' and find(refs, text[i..e]) != null) {
                    // Depth-aware scan so a nested subscript in the index
                    // survives: `cells[other[k].h].count`.
                    var depth: usize = 0;
                    var j = e;
                    while (j < text.len) {
                        if (text[j] == '[') depth += 1;
                        if (text[j] == ']') {
                            depth -= 1;
                            if (depth == 0) break;
                        }
                        j += 1;
                    }
                    if (j < text.len and j + 1 < text.len and text[j + 1] == '.') {
                        const gname = text[i..e];
                        const idx_raw = text[e + 1 .. j];
                        var fe = j + 2;
                        while (fe < text.len and ast_grid.isKebabIdentChar(text[fe])) fe += 1;
                        const fname = text[j + 2 .. fe];
                        // The index may itself contain grid reads.
                        // A TOP-LEVEL comma in the subscript means the 2-D
                        // form `g[x, y]`. Depth matters: a comma inside a
                        // nested subscript belongs to that subscript.
                        var comma: ?usize = null;
                        var d2: usize = 0;
                        var k: usize = 0;
                        while (k < idx_raw.len) : (k += 1) {
                            if (idx_raw[k] == '[' or idx_raw[k] == '(') d2 += 1;
                            if (idx_raw[k] == ']' or idx_raw[k] == ')') d2 -= 1;
                            if (idx_raw[k] == ',' and d2 == 0) {
                                comma = k;
                                break;
                            }
                        }
                        const ns = (find(refs, gname) orelse unreachable).ns;
                        const piece = if (comma) |cm| blk_two: {
                            const xs = lower(alloc, std.mem.trim(u8, idx_raw[0..cm], " "), refs);
                            const ys = lower(alloc, std.mem.trim(u8, idx_raw[cm + 1 ..], " "), refs);
                            break :blk_two std.fmt.allocPrint(alloc, "(&{s}__koru_grid_{s}.{s})[{s}__KoruGridT_{s}.__koru_at2({s}, {s})]", .{ ns, gname, fname, ns, gname, xs, ys }) catch unreachable;
                        } else blk_one: {
                            const idx = lower(alloc, idx_raw, refs);
                            break :blk_one std.fmt.allocPrint(alloc, "(&{s}__koru_grid_{s}.{s})[{s}__KoruGridT_{s}.__koru_at({s})]", .{ ns, gname, fname, ns, gname, idx }) catch unreachable;
                        };
                        out.appendSlice(alloc, piece) catch unreachable;
                        i = fe;
                        matched = true;
                    }
                }
            }
            if (!matched) {
                out.append(alloc, text[i]) catch unreachable;
                i += 1;
            }
        }
        return out.toOwnedSlice(alloc) catch unreachable;
    }
};

// ============================================================================
// GRID.NEW — declare a fixed, positionally-addressed table
// ============================================================================

~[keyword|comptime|transform]pub tor new {
    expr: Expression,
    source: Source,
    invocation: *const Invocation,
    item: *const Item,
    program: *const Program,
    reporter: *std/compiler:ErrorReporter,
    allocator: std.mem.Allocator
} -> SiteResult

~[transform]proc new|zig {
    const ast = @import("ast");
    const struct_literal = @import("struct_literal");

    if (item.* != .flow) @panic("grid:new transform: containing item is not a flow - walker dispatch contract broken");
    const flow = &item.flow;

    const H = struct {
        fn stripQuotes(n: []const u8) []const u8 {
            if (n.len >= 2 and n[0] == '"') return n[1 .. n.len - 1];
            return n;
        }
    };

    var grid_name: []const u8 = "";
    var seed_text: ?[]const u8 = null;
    var size_text: ?[]const u8 = null;
    var dims_text: ?[]const u8 = null;
    for (invocation.args) |arg| {
        if (std.mem.eql(u8, arg.name, "expr")) {
            grid_name = H.stripQuotes(arg.value);
        } else if (std.mem.eql(u8, arg.name, "source")) {
            seed_text = arg.value;
        } else if (std.mem.eql(u8, arg.name, "size")) {
            size_text = std.mem.trim(u8, arg.value, " ");
        } else if (std.mem.eql(u8, arg.name, "dimensions")) {
            dims_text = std.mem.trim(u8, arg.value, " ");
        }
    }
    if (grid_name.len == 0 or seed_text == null) {
        return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, "std/grid:new requires a name and a cell block: new(name, size: N) {{ field: default[type] }}", .{}) } };
    }
    // TWO DECLARATION FORMS, one construct.
    //
    //   size: N          a flat run of N cells. The index is the program's own
    //                    business — a spatial hash wants exactly this and writes
    //                    its own `% N`.
    //   dimensions: RxC  a bounded field of R rows by C columns, addressed
    //                    `g[x, y]`. The linearisation is ROW-MAJOR, `y*C + x`,
    //                    the same layout the heap grid this replaces used and the
    //                    same one hand-written Zig/C/Rust use — so a grid-backed
    //                    workload stays apples-to-apples benchmarkable.
    //
    // `RxC` needs no lexer support: an invocation argument arrives as raw source
    // text, so `64x64` is delivered whole and parsed here, exactly as `size: N`
    // is parsed here rather than by the grammar. It cannot collide with an
    // identifier because an identifier may not begin with a digit.
    var SIZE: usize = 0;
    var COLS: usize = 0;
    var ROWS: usize = 0;
    if (dims_text) |dt| {
        if (size_text != null) {
            return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, "std/grid:new({s}): `size:` and `dimensions:` are two spellings of the same thing - give one", .{grid_name}) } };
        }
        const xat = std.mem.indexOfScalar(u8, dt, 'x') orelse {
            return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, "std/grid:new({s}): dimensions are `RxC` (got '{s}')", .{ grid_name, dt }) } };
        };
        ROWS = std.fmt.parseInt(usize, std.mem.trim(u8, dt[0..xat], " "), 10) catch {
            return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, "std/grid:new({s}): dimensions are `RxC` with integer literals (got '{s}')", .{ grid_name, dt }) } };
        };
        COLS = std.fmt.parseInt(usize, std.mem.trim(u8, dt[xat + 1 ..], " "), 10) catch {
            return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, "std/grid:new({s}): dimensions are `RxC` with integer literals (got '{s}')", .{ grid_name, dt }) } };
        };
        SIZE = ROWS * COLS;
    } else {
        const st = size_text orelse {
            return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, "std/grid:new({s}): a grid needs `size: N` or `dimensions: RxC` - every cell exists from declaration, so the count is not a capacity to grow into", .{grid_name}) } };
        };
        SIZE = std.fmt.parseInt(usize, st, 10) catch {
            return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, "std/grid:new({s}): size must be an integer literal (got '{s}')", .{ grid_name, st }) } };
        };
    }
    if (SIZE == 0) {
        return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, "std/grid:new({s}): a grid needs at least one cell", .{grid_name}) } };
    }

    // Cells are declared `field: default[type]` — SEEDED, always. A store
    // column may be bare (`hp: i64`) because a row is born at insert and the
    // seed is the inserter's business. A grid has no insert: every cell is
    // live from declaration, so every column must say what it starts as.
    const braced = std.fmt.allocPrint(allocator, "{{{s}}}", .{seed_text.?}) catch unreachable;
    const cells = struct_literal.parseFields(allocator, braced) catch {
        return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, "std/grid:new({s}): malformed cell block", .{grid_name}) } };
    };
    if (cells.len == 0) {
        return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, "std/grid:new({s}): a grid needs at least one column", .{grid_name}) } };
    }

    var g = std.ArrayList(u8).initCapacity(allocator, 512) catch unreachable;
    // NOT `pub`, and that was worth measuring rather than assuming. A grid
    // declared in one module is read from another, so `pub` looked obviously
    // required — but every Koru module lands in ONE emitted Zig file as a
    // nested namespace, and `pub` governs visibility across `@import`
    // boundaries, not across namespaces in a file. The cross-module mirror
    // (115_046) passes either way; only the module QUALIFIER on the reference
    // is load-bearing. The `pub` sprinkle would have looked like part of the
    // fix forever.
    const head = std.fmt.allocPrint(allocator, "const __KoruGridT_{s} = struct {{\n", .{grid_name}) catch unreachable;
    g.appendSlice(allocator, head) catch unreachable;

    for (cells) |c| {
        // `count: 0[i64]` — the default is the value, the type rides in the
        // brackets, exactly as a seeded store column spells it.
        const v = std.mem.trim(u8, c.value, " ");
        const lb = std.mem.indexOfScalar(u8, v, '[') orelse {
            return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, "std/grid:new({s}): column '{s}' needs a default and a type - `{s}: 0[i64]`. A grid has no insert, so every cell is live from declaration and must say what it starts as", .{ grid_name, c.name, c.name }) } };
        };
        if (v.len == 0 or v[v.len - 1] != ']') {
            return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, "std/grid:new({s}): column '{s}' has a malformed type - `{s}: 0[i64]`", .{ grid_name, c.name, c.name }) } };
        }
        const dflt = std.mem.trim(u8, v[0..lb], " ");
        const ty = std.mem.trim(u8, v[lb + 1 .. v.len - 1], " ");
        const col = std.fmt.allocPrint(allocator, "    {s}: [{d}]{s} = [_]{s}{{{s}}} ** {d},\n", .{ c.name, SIZE, ty, ty, dflt, SIZE }) catch unreachable;
        g.appendSlice(allocator, col) catch unreachable;
    }

    // The bounds floor. `size` is comptime-known, so an index the optimizer can
    // range-prove costs nothing; anything else traps naming the grid rather
    // than silently addressing a neighbouring cell.
    //
    // THE INDEX IS `anytype`, and that is not laziness. A grid index arrives
    // from wherever the program computes it — a `for` binding, a regex named
    // group typed `usize`, an i64 cell read, a bare literal — and Zig does not
    // implicitly coerce between those. Pinning the parameter to `i64` would
    // have made every honest caller write `@as(i64, @intCast(x))` at the call
    // site, which is host noise in a Koru program and exactly the tax the grid
    // exists to avoid. The widening happens once, here, where the check is.
    //
    // NOTE the shape of this block: every `\\` multiline literal in a `|zig`
    // proc must be brace-BALANCED on its own, because the Koru parser counts
    // braces across the proc body and does not exempt multiline literals. The
    // struct's closing `}` therefore rides in a quoted string below, the way
    // store.kz does it, not at the end of this literal.
    const at = std.fmt.allocPrint(allocator,
        \\    const __koru_size: usize = {d};
        \\    fn __koru_wide(v: anytype) i64 {{
        \\        return if (@TypeOf(v) == comptime_int) v else @intCast(v);
        \\    }}
        \\    fn __koru_at(i_raw: anytype) usize {{
        \\        const i = __koru_wide(i_raw);
        \\        if (i < 0 or @as(usize, @intCast(i)) >= {d}) @panic("std/grid: index out of range for grid '{s}' (size {d}) - a grid is addressed by position, and wrapping is the program's to write as `% {d}`");
        \\        return @as(usize, @intCast(i));
        \\    }}
        \\
    , .{ SIZE, SIZE, grid_name, SIZE, SIZE }) catch unreachable;
    g.appendSlice(allocator, at) catch unreachable;
    if (dims_text != null) {
        // Row-major `y*C + x`, bounds-checked per AXIS so the diagnostic can say
        // WHICH axis escaped — `[x, y]` with a good x and a bad y is the common
        // slip and "index out of range" alone would not locate it.
        const at2 = std.fmt.allocPrint(allocator,
            \\    const __koru_rows: usize = {d};
            \\    const __koru_cols: usize = {d};
            \\    fn __koru_at2(x_raw: anytype, y_raw: anytype) usize {{
            \\        const x = __koru_wide(x_raw);
            \\        const y = __koru_wide(y_raw);
            \\        if (x < 0 or @as(usize, @intCast(x)) >= {d}) @panic("std/grid: x out of range for grid '{s}' (cols {d})");
            \\        if (y < 0 or @as(usize, @intCast(y)) >= {d}) @panic("std/grid: y out of range for grid '{s}' (rows {d})");
            \\        return @as(usize, @intCast(y)) * {d} + @as(usize, @intCast(x));
            \\    }}
            \\
        , .{ ROWS, COLS, COLS, grid_name, COLS, ROWS, grid_name, ROWS, COLS }) catch unreachable;
        g.appendSlice(allocator, at2) catch unreachable;
    }
    g.appendSlice(allocator, "};\n") catch unreachable;

    const inst = std.fmt.allocPrint(allocator, "var __koru_grid_{s}: __KoruGridT_{s} = .{{}};", .{ grid_name, grid_name }) catch unreachable;
    g.appendSlice(allocator, inst) catch unreachable;

    // WHOLE-PROGRAM READ LOWERING, owned by the DECLARATION.
    //
    // A cell read is not confined to a write block. A guard reads one
    // (`if(sieve[p].mark == 0)`), an argument reads one, a print interpolates
    // one — and until this pass existed every such read reached the host
    // verbatim as `sieve[p].mark`, an undeclared identifier. That is why the
    // prime sieve and day-06's clamped decrement could not be written at all:
    // both are a conditional on a cell's current value, which is the ordinary
    // way anyone uses a table.
    //
    // The declaration is the right owner because it is the only site that knows
    // the grid exists before anything reads it — the same argument, and the
    // same shape, as `std/store:new`'s whole-program cell-path rewrite
    // (store.kz, "Whole-program cell-path rewrite"). Sites belonging to
    // std/grid are skipped: `stored` and `sweep` lower their own text through
    // this same `grid_read.lower`, so nothing is lowered twice.
    //
    // Idempotent under re-entry and under a second grid's declaration: a
    // lowered read no longer contains `<grid>[`, because the name sits behind
    // `__koru_grid_`, past an identifier character.
    {
        var seen = std.ArrayList(grid_read.GridRef).initCapacity(allocator, 4) catch unreachable;
        grid_read.collect(allocator, program, &seen);
        const Walk = struct {
            fn cont(alloc: std.mem.Allocator, c: *ast.Continuation, names: []const grid_read.GridRef) void {
                if (c.condition) |cd| {
                    @constCast(c).condition = grid_read.lower(alloc, cd, names);
                }
                if (c.node) |*n| {
                    // Never `|*inv|` on `switch (n.*)` — that captures a
                    // TEMPORARY and the live AST stays raw (store's 690_074).
                    switch (@constCast(n).*) {
                        .invocation => {
                            const inv = &@constCast(n).invocation;
                            const ours = blk: {
                                if (inv.path.module_qualifier) |mq| break :blk std.mem.eql(u8, mq, "std.grid");
                                break :blk false;
                            };
                            if (!ours) {
                                for (inv.args) |*a| {
                                    @constCast(a).value = grid_read.lower(alloc, a.value, names);
                                    if (a.expression_value) |ev| {
                                        const fresh = alloc.create(ast.CapturedExpression) catch unreachable;
                                        fresh.* = ev.*;
                                        fresh.text = grid_read.lower(alloc, ev.text, names);
                                        @constCast(a).expression_value = fresh;
                                    }
                                    if (a.source_value) |sv| {
                                        const fresh = alloc.create(ast.Source) catch unreachable;
                                        fresh.* = sv.*;
                                        fresh.text = grid_read.lower(alloc, sv.text, names);
                                        @constCast(a).source_value = fresh;
                                    }
                                }
                            }
                            // TEMPLATE EXPANSION FREEZES ARGS EARLY. `if` and
                            // `for` bake their Expression argument into
                            // `Invocation.inline_body` before a declaration's
                            // pass ever runs, so rewriting `inv.args` alone
                            // reaches a copy nobody emits — the guard under a
                            // loop still says `cells[3].on` and the host calls
                            // it undeclared. store.kz records the same trap at
                            // 690_074; it cost an hour here before its comment
                            // was found, which is an argument for the two
                            // declarations sharing a walker rather than a
                            // convention.
                            if (inv.inline_body) |ib| {
                                inv.inline_body = grid_read.lower(alloc, ib, names);
                            }
                        },
                        .inline_code => {
                            @constCast(n).* = .{ .inline_code = grid_read.lower(alloc, n.inline_code, names) };
                        },
                        else => {},
                    }
                }
                for (c.continuations) |*k| cont(alloc, @constCast(k), names);
            }
            fn items(alloc: std.mem.Allocator, its: []ast.Item, names: []const grid_read.GridRef) void {
                for (its) |*pi| {
                    switch (pi.*) {
                        // `&pi.flow`, not `|*f|` on a switched copy — the same
                        // temporary-capture rule as above.
                        .flow => {
                            cont(alloc, &pi.flow.body, names);
                            if (pi.flow.inline_body) |ib| pi.flow.inline_body = grid_read.lower(alloc, ib, names);
                        },
                        .module_decl => items(alloc, @constCast(pi.module_decl.items), names),
                        else => {},
                    }
                }
            }
        };
        Walk.items(allocator, @constCast(program.items), seen.items);
    }

    return .{ .transformed = .{ .replacement = ast.Item{ .host_line = ast.HostLine{
        .content = g.toOwnedSlice(allocator) catch unreachable,
        .location = flow.location,
        .module = allocator.dupe(u8, flow.module) catch unreachable,
    } } } };
}

// ============================================================================
// GRID.STORED — positional write, and positional reads in the values
// ============================================================================
//
//   std/grid:stored { cells[h].count: cells[h].count + 1 }
//
// There is no write EVENT and no envelope. The store routes every write through
// one centralizing subflow because that is where reactivity splices; a grid has
// nothing to splice, so a write is a write and lowers to an assignment.

~[keyword|comptime|transform]pub tor stored {
    source: Source,
    invocation: *const Invocation,
    item: *const Item,
    program: *const Program,
    reporter: *std/compiler:ErrorReporter,
    allocator: std.mem.Allocator
} -> SiteResult

~[transform]proc stored|zig {
    const ast = @import("ast");
    const struct_literal = @import("struct_literal");

    if (item.* != .flow) @panic("grid:stored transform: containing item is not a flow - walker dispatch contract broken");
    const flow = &item.flow;

    var block: ?[]const u8 = null;
    for (invocation.args) |arg| {
        if (std.mem.eql(u8, arg.name, "source")) block = arg.value;
    }
    const btext = block orelse {
        return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, "std/grid:stored requires a write block: stored {{ grid[index].field: expr }}", .{}) } };
    };

    var names = std.ArrayList(grid_read.GridRef).initCapacity(allocator, 4) catch unreachable;
    grid_read.collect(allocator, program, &names);
    if (names.items.len == 0) {
        return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, "std/grid:stored: no grid is declared in this program - declare one with `std/grid:new(name, size: N) {{ ... }}`", .{}) } };
    }

    const braced = std.fmt.allocPrint(allocator, "{{{s}}}", .{btext}) catch unreachable;
    const pairs = struct_literal.parseFields(allocator, braced) catch {
        return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, "std/grid:stored: malformed write block", .{}) } };
    };

    // THE OPERANDS ARE EVALUATED AT THE SITE, not pasted into the unit.
    //
    // The first cut inlined the whole assignment into the unit's `|zig` body,
    // which works for exactly the programs whose indices are literals. The
    // moment a write sits under a loop — `! each i |> stored { g[i].on: i * 2 }`
    // — the body names `i`, the unit has no inputs, and `i` reaches the host as
    // an undeclared identifier. Every real grid workload writes under a loop,
    // so that shape was the whole point and it did not work.
    //
    // So the index and the value ride as ARGUMENTS: they stay Koru expressions
    // in the caller's scope, exactly where the binding lives, and the unit
    // receives values. This is the store's de-bundled write (690_064) — thread
    // the operand, never the expression — and it is why the unit's body is
    // three names rather than a transplanted fragment.
    var body = std.ArrayList(u8).initCapacity(allocator, 256) catch unreachable;
    var inputs = std.ArrayList(ast.Field).initCapacity(allocator, 4) catch unreachable;
    var args = std.ArrayList(ast.Arg).initCapacity(allocator, 4) catch unreachable;
    for (pairs, 0..) |pr, n| {
        const raw_target = std.mem.trim(u8, pr.name, " ");
        const t = grid_read.parseTarget(raw_target, names.items) orelse {
            return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, "std/grid:stored: '{s}' does not address a grid cell - the target is `<grid>[<index>].<field>`, and a store row is written with std/store:stored instead", .{pr.name}) } };
        };
        const col_ty = grid_read.columnType(allocator, program.items, t.grid, t.field) orelse {
            return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, "std/grid:stored: grid '{s}' has no column '{s}'", .{ t.grid, t.field }) } };
        };

        const xn = std.fmt.allocPrint(allocator, "__koru_gwx{d}", .{n}) catch unreachable;
        const yn = std.fmt.allocPrint(allocator, "__koru_gwy{d}", .{n}) catch unreachable;
        const vn = std.fmt.allocPrint(allocator, "__koru_gwv{d}", .{n}) catch unreachable;

        // The target is lowered by RE-SPELLING it with the parameter names in
        // the index and handing it to the same `lower` every read goes through.
        // An lvalue and an rvalue are the same text here, so there is still
        // only one lowering — the alternative was a second copy of it that
        // agreed by coincidence, which is the defect this file keeps finding.
        const respelled = if (t.y != null)
            std.fmt.allocPrint(allocator, "{s}[{s}, {s}].{s}", .{ t.grid, xn, yn, t.field }) catch unreachable
        else
            std.fmt.allocPrint(allocator, "{s}[{s}].{s}", .{ t.grid, xn, t.field }) catch unreachable;
        const lvalue = grid_read.lower(allocator, respelled, names.items);
        const line = std.fmt.allocPrint(allocator, "{s} = {s};\n", .{ lvalue, vn }) catch unreachable;
        body.appendSlice(allocator, line) catch unreachable;

        // AN INDEX ARRIVES AS WHATEVER THE PROGRAM COMPUTED. A `for` binding is
        // `usize`, a regex named group is `usize`, a cell read is `i64`, a
        // literal is `comptime_int` — and Zig coerces none of those into an
        // `i64` struct field. The input is typed `i64` (a grid index is a
        // number, and the trap is written against a signed one so a negative
        // index is caught rather than wrapped into the far end of the grid), so
        // the SITE widens, through the grid's own `__koru_wide` — the same
        // widening the read path uses, not a second spelling of it.
        const widen = struct {
            fn at(alloc: std.mem.Allocator, ns: []const u8, grid: []const u8, text: []const u8) []const u8 {
                return std.fmt.allocPrint(alloc, "{s}__KoruGridT_{s}.__koru_wide({s})", .{ ns, grid, text }) catch unreachable;
            }
        };
        inputs.append(allocator, ast.Field{ .name = xn, .type = allocator.dupe(u8, "i64") catch unreachable }) catch unreachable;
        args.append(allocator, ast.Arg{ .name = xn, .value = widen.at(allocator, (grid_read.find(names.items, t.grid) orelse unreachable).ns, t.grid, grid_read.lower(allocator, t.x, names.items)) }) catch unreachable;
        if (t.y) |ytext| {
            inputs.append(allocator, ast.Field{ .name = yn, .type = allocator.dupe(u8, "i64") catch unreachable }) catch unreachable;
            args.append(allocator, ast.Arg{ .name = yn, .value = widen.at(allocator, (grid_read.find(names.items, t.grid) orelse unreachable).ns, t.grid, grid_read.lower(allocator, ytext, names.items)) }) catch unreachable;
        }
        inputs.append(allocator, ast.Field{ .name = vn, .type = allocator.dupe(u8, col_ty) catch unreachable }) catch unreachable;
        args.append(allocator, ast.Arg{ .name = vn, .value = grid_read.lower(allocator, pr.value, names.items) }) catch unreachable;
    }

    // A top-level write is a STATEMENT in the program's flow, so the replacement
    // has to be executable — raw code, whether host_line or inline_code, lands at
    // module scope where an assignment is not a legal declaration.
    //
    // The callable is an EVENT plus a same-named `|zig` proc that implements it;
    // a proc on its own is not invocable and resolves as an unknown tor. This is
    // the store's own unit shape, minus everything a grid does not need: no
    // inputs, no branches, no row argument, no envelope. Keyed on the site LINE
    // so two writes in one program never collide.
    const unit = std.fmt.allocPrint(allocator, "__grid_write_L{d}", .{flow.location.line}) catch unreachable;

    // THE NAMESPACE IS IMPORT-DERIVED, NOT FILE-DERIVED. `flow.module` is the
    // file name (`lib`); every cross-module path in the program resolves through
    // the module's logical name (`app.lib`). Minting the unit off `flow.module`
    // puts it in a namespace nothing looks up, and the failure is
    // `unknown tor 'lib:__grid_write_L8'` — the same fault 115_018 recorded for
    // the store's forty-odd paths. The entry file collapses the two names into
    // one, so only a cross-module mirror (115_045) can tell a correct qualifier
    // from a lucky one.
    const home_ns = blk_home: {
        const Find = struct {
            fn in(its: []const ast.Item, want: []const u8, enclosing: ?[]const u8) ?[]const u8 {
                for (its) |pi| {
                    switch (pi) {
                        .flow => |f| {
                            if (std.mem.eql(u8, f.module, want)) return enclosing;
                        },
                        .module_decl => |m| {
                            if (in(m.items, want, m.logical_name)) |hit| return hit;
                        },
                        else => {},
                    }
                }
                return null;
            }
        };
        break :blk_home Find.in(program.items, flow.module, null) orelse flow.module;
    };
    const mk = struct {
        fn path(alloc: std.mem.Allocator, module: []const u8, name: []const u8) ast.DottedPath {
            const segs = alloc.alloc([]const u8, 1) catch unreachable;
            segs[0] = alloc.dupe(u8, name) catch unreachable;
            return ast.DottedPath{ .module_qualifier = alloc.dupe(u8, module) catch unreachable, .segments = segs };
        }
    };

    const appended = allocator.alloc(ast.Item, 2) catch unreachable;
    appended[0] = ast.Item{ .event_decl = ast.EventDecl{
        .path = mk.path(allocator, home_ns, unit),
        .input = ast.Shape{ .fields = inputs.toOwnedSlice(allocator) catch unreachable },
        .branches = &[_]ast.Branch{},
        .is_public = false,
        .is_implicit_flow = false,
        .annotations = &[_][]const u8{},
        .location = flow.location,
        .module = allocator.dupe(u8, flow.module) catch unreachable,
    } };
    appended[1] = ast.Item{ .proc_decl = ast.ProcDecl{
        .path = mk.path(allocator, home_ns, unit),
        .body = ast.Source{ .text = body.toOwnedSlice(allocator) catch unreachable, .location = flow.location, .scope = .{ .bindings = &[_]ast.ScopeBinding{} }, .phantom_type = null },
        .annotations = &[_][]const u8{},
        .target = allocator.dupe(u8, "zig") catch unreachable,
        .location = flow.location,
        .module = allocator.dupe(u8, flow.module) catch unreachable,
    } };

    const call = ast.Invocation{ .path = mk.path(allocator, home_ns, unit), .args = args.toOwnedSlice(allocator) catch unreachable };
    return .{ .transformed = .{
        .replacement = ast.Item{ .flow = ast.Flow{
            .body = ast.rootSite(call, &[_]ast.Continuation{}, flow.location),
            .pre_label = null,
            .impl_of = flow.impl_of,
            .annotations = &[_][]const u8{},
            .location = flow.location,
            .module = allocator.dupe(u8, flow.module) catch unreachable,
        } },
        .appended = appended,
    } };
}

// ============================================================================
// GRID.SWEEP — visit every cell
// ============================================================================
//
//   std/grid:sweep(cells)
//   ! sweep c when c.count > 0 |> std/store:stored { acc.n: acc.n + 1 }
//
// NO BOUNDS CHECK. The loop constructs the index from `0..size`, so validating
// it would be re-establishing a fact from one line above — the same
// floor-then-prove-away arc the store's handle check follows, and the reason the
// grid's trap is a floor rather than a tax.
//
// This lowers to an ordinary `for(0..size) ! each <i>`, with every `c.<field>`
// in the body rewritten to a direct cell read. It mints no event and transplants
// no body: `for` already knows how to inline effect handlers, so reusing it
// keeps the body Koru all the way down — a nested `std/store:stored`, a
// `print.ln`, a guard, all behave exactly as they do anywhere else, because
// nothing about them has been moved.

~[keyword|comptime|transform|claims_descendants]pub tor sweep {
    expr: Expression,
    invocation: *const Invocation,
    item: *const Item,
    program: *const Program,
    reporter: *std/compiler:ErrorReporter,
    allocator: std.mem.Allocator
} -> SiteResult

~[transform]proc sweep|zig {
    const ast = @import("ast");
    const ast_functional = @import("ast_functional");

    if (item.* != .flow) @panic("grid:sweep transform: containing item is not a flow - walker dispatch contract broken");
    const flow = &item.flow;

    const S = struct {
        fn isIdentCh(ch: u8) bool {
            return (ch >= 'a' and ch <= 'z') or (ch >= 'A' and ch <= 'Z') or (ch >= '0' and ch <= '9') or ch == '_' or ch == '-';
        }
        // `c.field` -> a direct cell read at the loop index. Unchecked by
        // construction; see the header.
        fn cells(alloc: std.mem.Allocator, text: []const u8, bind: []const u8, ns: []const u8, grid: []const u8, cur: []const u8) []const u8 {
            const prefix = std.fmt.allocPrint(alloc, "{s}.", .{bind}) catch unreachable;
            var out = std.ArrayList(u8).initCapacity(alloc, text.len + 64) catch unreachable;
            var i: usize = 0;
            while (i < text.len) {
                const boundary = i == 0 or !isIdentCh(text[i - 1]);
                if (boundary and std.mem.startsWith(u8, text[i..], prefix)) {
                    var fe = i + prefix.len;
                    while (fe < text.len and isIdentCh(text[fe])) fe += 1;
                    const fname = text[i + prefix.len .. fe];
                    const piece = std.fmt.allocPrint(alloc, "(&{s}__koru_grid_{s}.{s})[@as(usize, @intCast({s}))]", .{ ns, grid, fname, cur }) catch unreachable;
                    out.appendSlice(alloc, piece) catch unreachable;
                    i = fe;
                } else {
                    out.append(alloc, text[i]) catch unreachable;
                    i += 1;
                }
            }
            return out.toOwnedSlice(alloc) catch unreachable;
        }
        fn walk(alloc: std.mem.Allocator, cont: *ast.Continuation, bind: []const u8, ns: []const u8, grid: []const u8, cur: []const u8) void {
            if (cont.condition) |c| {
                @constCast(cont).condition = cells(alloc, c, bind, ns, grid, cur);
            }
            if (cont.node) |*n| {
                switch (@constCast(n).*) {
                    .invocation => |*inv| {
                        for (inv.args) |*a| {
                            @constCast(a).value = cells(alloc, a.value, bind, ns, grid, cur);
                            if (a.expression_value) |ev| {
                                const fresh = alloc.create(ast.CapturedExpression) catch unreachable;
                                fresh.* = ev.*;
                                fresh.text = cells(alloc, ev.text, bind, ns, grid, cur);
                                @constCast(a).expression_value = fresh;
                            }
                            if (a.source_value) |sv| {
                                const fresh = alloc.create(ast.Source) catch unreachable;
                                fresh.* = sv.*;
                                fresh.text = cells(alloc, sv.text, bind, ns, grid, cur);
                                @constCast(a).source_value = fresh;
                            }
                        }
                    },
                    else => {},
                }
            }
            for (cont.continuations) |*k| walk(alloc, @constCast(k), bind, ns, grid, cur);
        }
    };

    var grid_name: []const u8 = "";
    for (invocation.args) |arg| {
        if (std.mem.eql(u8, arg.name, "expr")) {
            var n = arg.value;
            if (n.len >= 2 and n[0] == '"') n = n[1 .. n.len - 1];
            grid_name = n;
        }
    }
    if (grid_name.len == 0) {
        return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, "std/grid:sweep requires a grid name: sweep(name)", .{}) } };
    }
    if (flow.body.continuations.len != 1) {
        return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, "std/grid:sweep({s}): exactly one `! sweep <cell>` branch per site", .{grid_name}) } };
    }
    const arm = &flow.body.continuations[0];
    if (!std.mem.eql(u8, std.mem.trim(u8, arm.branch, " "), "sweep")) {
        return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, "std/grid:sweep({s}): the cell branch is spelled `! sweep <cell>`", .{grid_name}) } };
    }
    const bind = arm.binding orelse {
        return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, "std/grid:sweep({s}): the sweep arm needs a cell binding: `! sweep <cell> |> ...`", .{grid_name}) } };
    };

    // WHERE THE SWEPT GRID'S CELLS LIVE. A sweep site and the declaration it
    // sweeps need not share a module — the grid is named, not handed over — so
    // the body's cell reads carry the DECLARING module's namespace, which is a
    // different question from `home_ns` below (that one is about where this
    // site's generated units are minted). Conflating the two is how a grid
    // swept from the entry file over a declaration in `app/lib` emits
    // `__koru_grid_cells` into a module that has never heard of it.
    var swept = std.ArrayList(grid_read.GridRef).initCapacity(allocator, 4) catch unreachable;
    grid_read.collect(allocator, program, &swept);
    const grid_ns = if (grid_read.find(swept.items, grid_name)) |r| r.ns else {
        return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, "std/grid:sweep({s}): no grid named '{s}' is declared in this program", .{ grid_name, grid_name }) } };
    };

    // The grid's size is comptime-known, and the declaration already emitted it
    // as `__koru_size` on the cell type — so the loop header names that rather
    // than re-deriving it, and a grid whose size changes cannot leave a stale
    // bound behind in a sweep.
    const cur = std.fmt.allocPrint(allocator, "__koru_gi_L{d}", .{flow.location.line}) catch unreachable;
    const body = ast_functional.cloneContinuation(allocator, arm) catch unreachable;
    var mutable_body = body;
    S.walk(allocator, &mutable_body, std.mem.trim(u8, bind, " "), grid_ns, grid_name, cur);

    // The body becomes an EVENT with the loop index as its only input, and an
    // impl flow carrying the (already-rewritten) continuation. The loop is a
    // `|zig` proc that calls it per cell. This is the store's qbody shape minus
    // everything a grid does not need: no projection derivation, no handle, no
    // removal tolerance — a grid cannot take, so the loop is a plain counted
    // `for` with a known trip count.
    // SAME IMPORT-DERIVED NAMESPACE RULE as the write unit. The mirror caught
    // this twice in one session: `flow.module` is the file name, resolution
    // wants the module's logical name, and the entry file hides the difference.
    const home_ns = blk_home: {
        const Find = struct {
            fn in(its: []const ast.Item, want: []const u8, enclosing: ?[]const u8) ?[]const u8 {
                for (its) |pi| {
                    switch (pi) {
                        .flow => |f| {
                            if (std.mem.eql(u8, f.module, want)) return enclosing;
                        },
                        .module_decl => |m| {
                            if (in(m.items, want, m.logical_name)) |hit| return hit;
                        },
                        else => {},
                    }
                }
                return null;
            }
        };
        break :blk_home Find.in(program.items, flow.module, null) orelse flow.module;
    };
    // And the EMITTED Zig namespace, which is a different spelling again: the
    // generated loop is raw host code, so it must name the struct its sibling
    // units emitted into rather than assume the entry module.
    const emit_ns = if (home_ns.len == 0 or std.mem.eql(u8, home_ns, program.main_module_name))
        "main_module."
    else
        std.fmt.allocPrint(allocator, "{s}.", .{codegen_utils_grid.buildKoruModulePath(allocator, home_ns) catch unreachable}) catch unreachable;

    const body_name = std.fmt.allocPrint(allocator, "__grid_body_L{d}", .{flow.location.line}) catch unreachable;
    const sweep_name = std.fmt.allocPrint(allocator, "__grid_sweep_L{d}", .{flow.location.line}) catch unreachable;

    const mk = struct {
        fn path(alloc: std.mem.Allocator, module: []const u8, name: []const u8) ast.DottedPath {
            const segs = alloc.alloc([]const u8, 1) catch unreachable;
            segs[0] = alloc.dupe(u8, name) catch unreachable;
            return ast.DottedPath{ .module_qualifier = alloc.dupe(u8, module) catch unreachable, .segments = segs };
        }
    };

    const body_node = mutable_body.node orelse {
        return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, "std/grid:sweep({s}): the sweep arm needs a body (`|> ...`)", .{grid_name}) } };
    };
    if (body_node != .invocation) {
        return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, "std/grid:sweep({s}): the sweep body must start with an invocation this rung", .{grid_name}) } };
    }

    // The loop proc calls the body event from RAW ZIG, which dead_strip's
    // koru-visible reachability model cannot see — so without `retain` the event
    // is stripped and the emitted call names a member that does not exist. The
    // store hit exactly this when its generated |zig procs began calling
    // generated events directly; `retain` is the designed answer, not a
    // workaround.
    const retain_ann = blk_ret: {
        const anns = allocator.alloc([]const u8, 1) catch unreachable;
        anns[0] = allocator.dupe(u8, "retain") catch unreachable;
        break :blk_ret anns;
    };
    var appended = std.ArrayList(ast.Item).initCapacity(allocator, 4) catch unreachable;

    const bin = allocator.alloc(ast.Field, 1) catch unreachable;
    bin[0] = ast.Field{ .name = allocator.dupe(u8, cur) catch unreachable, .type = allocator.dupe(u8, "i64") catch unreachable };
    appended.append(allocator, ast.Item{ .event_decl = ast.EventDecl{
        .path = mk.path(allocator, home_ns, body_name),
        .input = ast.Shape{ .fields = bin },
        .branches = &[_]ast.Branch{},
        .is_public = false,
        .is_implicit_flow = false,
        .annotations = retain_ann,
        .location = flow.location,
        .module = allocator.dupe(u8, flow.module) catch unreachable,
    } }) catch unreachable;

    appended.append(allocator, ast.Item{ .flow = ast.Flow{
        .body = ast.rootSite(body_node.invocation, mutable_body.continuations, flow.location),
        .pre_label = null,
        .impl_of = mk.path(allocator, home_ns, body_name),
        .annotations = &[_][]const u8{},
        .location = flow.location,
        .module = allocator.dupe(u8, flow.module) catch unreachable,
    } }) catch unreachable;

    appended.append(allocator, ast.Item{ .event_decl = ast.EventDecl{
        .path = mk.path(allocator, home_ns, sweep_name),
        .input = ast.Shape{ .fields = &[_]ast.Field{} },
        .branches = &[_]ast.Branch{},
        .is_public = false,
        .is_implicit_flow = false,
        .annotations = &[_][]const u8{},
        .location = flow.location,
        .module = allocator.dupe(u8, flow.module) catch unreachable,
    } }) catch unreachable;

    // A `for (0..N)` with a comptime-known N: the trip count is known before the
    // loop begins, which is the whole reason a grid sweep vectorises where a
    // store sweep had to earn it.
    const guard_line = if (mutable_body.condition) |c|
        std.fmt.allocPrint(allocator, "    if (!({s})) continue;\n", .{c}) catch unreachable
    else
        "";
    const loop = std.fmt.allocPrint(allocator, "for (0..{s}__KoruGridT_{s}.__koru_size) |{s}| {{\n{s}    {s}{s}_event.handler(.{{ .{s} = @as(i64, @intCast({s})) }});\n}}\nreturn;", .{ grid_ns, grid_name, cur, guard_line, emit_ns, body_name, cur, cur }) catch unreachable;
    appended.append(allocator, ast.Item{ .proc_decl = ast.ProcDecl{
        .path = mk.path(allocator, home_ns, sweep_name),
        .body = ast.Source{ .text = loop, .location = flow.location, .scope = .{ .bindings = &[_]ast.ScopeBinding{} }, .phantom_type = null },
        .annotations = &[_][]const u8{},
        .target = allocator.dupe(u8, "zig") catch unreachable,
        .location = flow.location,
        .module = allocator.dupe(u8, flow.module) catch unreachable,
    } }) catch unreachable;

    const call = ast.Invocation{ .path = mk.path(allocator, home_ns, sweep_name), .args = &[_]ast.Arg{} };
    return .{ .transformed = .{
        .replacement = ast.Item{ .flow = ast.Flow{
            .body = ast.rootSite(call, &[_]ast.Continuation{}, flow.location),
            .pre_label = null,
            .impl_of = flow.impl_of,
            .annotations = &[_][]const u8{},
            .location = flow.location,
            .module = allocator.dupe(u8, flow.module) catch unreachable,
        } },
        .appended = appended.toOwnedSlice(allocator) catch unreachable,
    } };
}
