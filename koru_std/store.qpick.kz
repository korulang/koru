// Koru Standard Library: the `qpick` part of store.kz.
// Joined via `~part qpick` in store.kz; merged into the store module at load.

// The pick half of sweep capture collection: given the binds the path walk
// collected, decide which ones a transplanted body captures (a referenced
// in-scope name rides the body input once), and refuse the ones no layer
// could type — an `! each` over an un-nameable iterable, or any other
// wildcard-payload arm bind. `storeColumnType` (the destructure-field seed
// lookup) lives here too — the qcaps pin was full.
const Pick = struct {
    const ast = @import("ast");
    fn isIdentChar(ch: u8) bool {
        return Cap.isIdentStart(ch) or (ch >= '0' and ch <= '9') or ch == '-';
    }
    fn isBareIdent(t: []const u8) bool {
        if (t.len == 0 or !Cap.isIdentStart(t[0])) return false;
        for (t) |ch| {
            if (!isIdentChar(ch)) return false;
        }
        return true;
    }
    /// Element type of a bind's own declared type — `[]T`/`[N]T`/`[]const T`
    /// iterate T; leading `?`/`*` decorators strip off first.
    fn iterElemType(ty: []const u8) ?[]const u8 {
        var s = std.mem.trim(u8, ty, " \t");
        while (s.len > 0 and (s[0] == '*' or s[0] == '?')) s = std.mem.trim(u8, s[1..], " \t");
        if (std.mem.startsWith(u8, s, "[]")) {
            s = std.mem.trim(u8, s[2..], " \t");
            if (std.mem.startsWith(u8, s, "const ")) s = std.mem.trim(u8, s[6..], " \t");
            return if (s.len > 0) s else null;
        }
        if (s.len > 0 and s[0] == '[') {
            const close = std.mem.indexOfScalar(u8, s, ']') orelse return null;
            const rest = std.mem.trim(u8, s[close + 1 ..], " \t");
            return if (rest.len > 0) rest else null;
        }
        return null;
    }
    /// Second pass for `! each` binds whose `for` iterable named nothing
    /// this layer could type: a bare `for(name)` resolves its element off
    /// a collected bind's own `[]T`/`[N]T` once every ancestor is in.
    /// What still cannot be named keeps the "?" marker — a body that
    /// captures it refuses rather than emit an untyped field.
    fn resolveEachIters(alloc: std.mem.Allocator, avail: []Cap.Bind) void {
        for (avail) |*b| {
            if (!std.mem.eql(u8, b.type, "?")) continue;
            const it = b.each_iter orelse continue;
            if (!isBareIdent(it)) continue;
            for (avail) |t| {
                if (!std.mem.eql(u8, t.name, it)) continue;
                if (iterElemType(t.type)) |et| b.type = alloc.dupe(u8, et) catch unreachable;
            }
        }
    }
    /// One refusal text for every sweep boundary an un-typable bind tries
    /// to cross — the sweep body and the `| none` arm refuse identically,
    /// so the teaching stays one string. Two shapes share it: an `! each`
    /// bind whose iterable named no element (each_iter set), and any other
    /// wildcard-payload arm bind (arm set) — both are "?" and both refuse
    /// rather than emit an untyped field. `ctx` spells which body did the
    /// reading ("the sweep body", "the `| none` body").
    fn eachUntypedMsg(alloc: std.mem.Allocator, ctx: []const u8, store_name: []const u8, b: Cap.Bind) []const u8 {
        if (b.each_iter) |it| {
            return std.fmt.allocPrint(alloc, "std/store:query({s}): {s} reads '{s}', bound by `! each` over `{s}` — the iterable's element type is not derivable at the sweep boundary. A range `a..b`, an `&[_]T{{…}}` literal, or a `[]T`/`[N]T` iterable names one; anything else needs the value lifted through a typed binding first.", .{ store_name, ctx, b.name, it }) catch unreachable;
        }
        return std.fmt.allocPrint(alloc, "std/store:query({s}): {s} reads '{s}', bound by the `! {s}` arm — the arm's payload is wildcard `*`, so the binding's type is not in the decl and the sweep boundary cannot name it. Lift the value through a typed binding first (a mid-pipe `: {s}`, or a tor returning the concrete type).", .{ store_name, ctx, b.name, b.arm orelse "?", b.name }) catch unreachable;
    }
    /// A body-arm's capture pick: an avail bind rides the body input only
    /// when the body references it, once each; "?" marks a bind no layer
    /// could type — refuse rather than emit an untyped field. `lexical`
    /// counts picks that need the enclosing frame.
    const Picked = struct { caps: std.ArrayList(Cap.Bind), lexical: usize };
    fn pickCaptures(alloc: std.mem.Allocator, avail: []const Cap.Bind, refs: []const []const u8, ctx: []const u8, store_name: []const u8) union(enum) { ok: Picked, refuse: []const u8 } {
        var caps = std.ArrayList(Cap.Bind).initCapacity(alloc, 4) catch unreachable;
        var lexical: usize = 0;
        for (avail) |b| {
            var used = false;
            for (refs) |r| {
                if (std.mem.eql(u8, r, b.name)) {
                    used = true;
                    break;
                }
            }
            if (!used) continue;
            if (std.mem.eql(u8, b.type, "?")) return .{ .refuse = eachUntypedMsg(alloc, ctx, store_name, b) };
            var seen = false;
            for (caps.items) |c| {
                if (std.mem.eql(u8, c.name, b.name)) {
                    seen = true;
                    break;
                }
            }
            if (seen) continue;
            caps.append(alloc, b) catch unreachable;
            if (b.lexical) lexical += 1;
        }
        return .{ .ok = .{ .caps = caps, .lexical = lexical } };
    }
    /// Declared type of one store column, read off the `new` call's seed
    /// block — the destructure arm's field types (moved from qcaps).
    fn storeColumnType(alloc: std.mem.Allocator, inv: *const ast.Invocation, want: []const u8) ?[]const u8 {
        var seed: ?[]const u8 = null;
        for (inv.args) |a| {
            if (std.mem.eql(u8, a.name, "source")) seed = a.value;
        }
        const s = seed orelse return null;
        const struct_literal = @import("struct_literal");
        const braced = std.fmt.allocPrint(alloc, "{{{s}}}", .{s}) catch return null;
        const cf = struct_literal.parseFields(alloc, braced) catch return null;
        for (cf) |c| {
            if (std.mem.eql(u8, c.name, want)) return alloc.dupe(u8, std.mem.trim(u8, c.value, " \t\n\r")) catch return null;
        }
        return null;
    }
};
