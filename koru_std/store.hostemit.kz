// Koru Standard Library: the `hostemit` part of store.kz.
// Joined via `~part hostemit` in store.kz; merged into the module at load.

// ------------------------------------------------------------------
// Host-source emit bodies lifted out of their topical parts as the
// third backend's arms grew them past the line wall. Each fn is
// reached through a member on its home struct (or a bare call, for
// cellRead, which was already module-scope in cols).
// ------------------------------------------------------------------
//
/// A `stored` write to the indexed column: `write` is the cell write
/// (`cell[row] = <value>`) and `value` its rhs expression. When the
/// value actually changes the row LEAVES its old bucket (membership is
/// eager — a stale member under the old key would answer for a row
/// that stopped carrying it) and JOINS the new one at the end — a
/// write that moves membership is a join for ordering purposes.
/// `__koru_iold` is captured before the write.
fn storeIndexWriteWrap(alloc: std.mem.Allocator, host_is_js: bool, store_name: []const u8, icol: []const u8, ecol: []const u8, write: []const u8, value: []const u8, ordered: bool) []const u8 { if (ordered) return StoreOrderedIndex.writeWrap(alloc, store_name, icol, ecol, write, value);
    if (storeHostTarget() == .cs)
        return std.fmt.allocPrint(alloc,
            \\long __koru_iold = (long)(__koru_store_{s}.{s}[__koru_r]);
            \\long __koru_ih = __koru_store_{s}.__koru_handle_of(__koru_r);
            \\{s}if (__koru_iold != (long)({s})) {{
            \\    global::System.Collections.Generic.List<long> __koru_ib;
            \\    if (__koru_store_{s}.__index_{s}.TryGetValue(__koru_iold, out __koru_ib)) {{
            \\        __koru_ib.Remove(__koru_ih);
            \\        if (__koru_ib.Count == 0) __koru_store_{s}.__index_{s}.Remove(__koru_iold);
            \\    }}
            \\    global::System.Collections.Generic.List<long> __koru_ib2;
            \\    if (!__koru_store_{s}.__index_{s}.TryGetValue((long)({s}), out __koru_ib2)) {{ __koru_ib2 = new global::System.Collections.Generic.List<long>(); __koru_store_{s}.__index_{s}[(long)({s})] = __koru_ib2; }}
            \\    __koru_ib2.Add(__koru_ih);
            \\}}
            \\
        , .{ store_name, ecol, store_name, write, value, store_name, icol, store_name, icol, store_name, icol, value, store_name, icol, value }) catch unreachable;
    if (host_is_js)
        return std.fmt.allocPrint(alloc,
            \\const __koru_iold = __koru_store_{s}.{s}[__koru_r];
            \\const __koru_ih = __koru_store_{s}.__koru_handle_of(__koru_r);
            \\{s}if (__koru_iold !== {s}) {{
            \\    const __koru_ib = __koru_store_{s}.__index_{s}.get(__koru_iold);
            \\    if (__koru_ib !== undefined) {{
            \\        const __koru_mi = __koru_ib.indexOf(__koru_ih);
            \\        if (__koru_mi >= 0) __koru_ib.splice(__koru_mi, 1);
            \\        if (__koru_ib.length === 0) __koru_store_{s}.__index_{s}.delete(__koru_iold);
            \\    }}
            \\    let __koru_ib2 = __koru_store_{s}.__index_{s}.get({s});
            \\    if (__koru_ib2 === undefined) {{ __koru_ib2 = []; __koru_store_{s}.__index_{s}.set({s}, __koru_ib2); }}
            \\    __koru_ib2.push(__koru_ih);
            \\}}
            \\
        , .{ store_name, ecol, store_name, write, value, store_name, icol, store_name, icol, store_name, icol, value, store_name, icol, value }) catch unreachable;
    return std.fmt.allocPrint(alloc,
        \\const __koru_iold = __koru_store_{s}.{s}[__koru_r];
        \\const __koru_ih = __koru_store_{s}.__koru_handle_of(__koru_r);
        \\{s}if (__koru_iold != {s}) {{
        \\    if (__koru_store_{s}.__index_{s}.getPtr(__koru_iold)) |__koru_ib| {{
        \\        for (__koru_ib.items, 0..) |__koru_im, __koru_mi| {{
        \\            if (__koru_im == __koru_ih) {{ _ = __koru_ib.orderedRemove(__koru_mi); break; }}
        \\        }}
        \\        if (__koru_ib.items.len == 0) {{
        \\            __koru_ib.deinit(koru_allocator());
        \\            _ = __koru_store_{s}.__index_{s}.remove(__koru_iold);
        \\        }}
        \\    }}
        \\    const __koru_ig = __koru_store_{s}.__index_{s}.getOrPut(koru_allocator(), {s}) catch @panic("std/indexes: index write ran out of memory");
        \\    if (!__koru_ig.found_existing) __koru_ig.value_ptr.* = .{{}};
        \\    __koru_ig.value_ptr.append(koru_allocator(), __koru_ih) catch @panic("std/indexes: index write ran out of memory");
        \\}}
        \\
    , .{ store_name, ecol, store_name, write, value, store_name, icol, store_name, icol, store_name, icol, value }) catch unreachable;
}

/// The membership walk's close. `stable` just seals: the `for`, the
/// bucket's `if`, and the caller's block. Otherwise the survival
/// check runs — after the body, the bucket is re-read and the cursor
/// advances only when the member it visited still sits at the
/// cursor's position; a member moved out by an indexed-column write
/// has handed its slot to the next unvisited member, which the walk
/// then examines — the dense sweep's re-check contract (690_031) at
/// bucket granularity. A bucket that lost its key (cleared, or
/// emptied by moves) ends the walk; the pointer is re-fetched
/// because the body can rehash the map by inserting under a new key.
fn siwMemberClose(alloc: std.mem.Allocator, host_is_js: bool, cellq: []const u8, store_name: []const u8, icol: []const u8, stable: bool, ordered: bool, op: CmpOp) []const u8 { if (ordered and !stable) return StoreOrderedIndex.memberClose(alloc, cellq, store_name, icol, op);
    if (stable) return std.fmt.allocPrint(alloc, ");\n}}\n}}\n}}\n", .{}) catch unreachable;
    if (storeHostTarget() == .cs)
        return std.fmt.allocPrint(alloc, ");\nglobal::System.Collections.Generic.List<long> __koru_ib2;\nif (!{s}__koru_store_{s}.__index_{s}.TryGetValue(__koru_ik, out __koru_ib2)) break;\nif (__koru_bi < __koru_ib2.Count && __koru_ib2[__koru_bi] == __koru_bh) __koru_bi += 1;\n}}\n}}\n", .{ cellq, store_name, icol }) catch unreachable;
    if (host_is_js)
        return std.fmt.allocPrint(alloc, ");\nconst __koru_ib2 = {s}__koru_store_{s}.__index_{s}.get(__koru_ik);\nif (__koru_ib2 === undefined) break;\nif (__koru_bi < __koru_ib2.length && __koru_ib2[__koru_bi] === __koru_bh) __koru_bi += 1;\n}}\n}}\n", .{ cellq, store_name, icol }) catch unreachable;
    return std.fmt.allocPrint(alloc, ");\nif ({s}__koru_store_{s}.__index_{s}.getPtr(__koru_ik)) |__koru_ib2| {{\n    if (__koru_bi < __koru_ib2.items.len and __koru_ib2.items[__koru_bi] == __koru_bh) __koru_bi += 1;\n}} else break;\n}}\n}}\n", .{ cellq, store_name, icol }) catch unreachable;
}

// The body a drain-lowered site emits — the clear unit's reset:
// bump every issued slot's generation, then drop len, the freelist
// and the fresh cursor; ident re-arms (vacuous at len 0). Refill
// issues slots in fresh order rather than take's LIFO pop order —
// the observable difference is handle bit values only.
fn drainScanSweepBody(alloc: std.mem.Allocator, host: codegen_utils_store.HostTarget, store: []const u8) []const u8 {
    if (host == .cs) return std.fmt.allocPrint(alloc,
        \\long __koru_dn = __koru_store_{s}.len;
        \\if (__koru_dn > 0) {{
        \\  for (long __koru_i = 0; __koru_i < __koru_store_{s}.__koru_hslot_next; __koru_i++) {{
        \\    __koru_store_{s}.__koru_hslot_gen[__koru_i] = (__koru_store_{s}.__koru_hslot_gen[__koru_i] + 1) % 2097152;
        \\  }}
        \\  __koru_store_{s}.__koru_gen0 = false;
        \\  __koru_store_{s}.len = 0;
        \\  __koru_store_{s}.__koru_hslot_free_len = 0;
        \\  __koru_store_{s}.__koru_hslot_next = 0;
        \\  __koru_store_{s}.__koru_ident = true;
        \\}}
    , .{ store, store, store, store, store, store, store, store, store }) catch unreachable;
    if (host == .js) return std.fmt.allocPrint(alloc,
        \\const __koru_dn = __koru_store_{s}.len;
        \\if (__koru_dn > 0) {{
        \\  for (let __koru_i = 0; __koru_i < __koru_store_{s}.__koru_hslot_next; __koru_i++) {{
        \\    __koru_store_{s}.__koru_hslot_gen[__koru_i] = (__koru_store_{s}.__koru_hslot_gen[__koru_i] + 1) % 2097152;
        \\  }}
        \\  __koru_store_{s}.len = 0;
        \\  __koru_store_{s}.__koru_hslot_free_len = 0;
        \\  __koru_store_{s}.__koru_hslot_next = 0;
        \\}}
        \\return;
    , .{ store, store, store, store, store, store, store }) catch unreachable;
    return std.fmt.allocPrint(alloc,
        \\const __koru_dn = __koru_store_{s}.len;
        \\if (__koru_dn > 0) {{
        \\    for (0..__koru_store_{s}.__koru_hslot_next) |__koru_i| __koru_store_{s}.__koru_hslot_gen[__koru_i] +%= 1;
        \\    __koru_store_{s}.__koru_gen0 = false;
        \\    __koru_store_{s}.len = 0;
        \\    __koru_store_{s}.__koru_hslot_free_len = 0;
        \\    __koru_store_{s}.__koru_hslot_next = 0;
        \\    __koru_store_{s}.__koru_ident = true;
        \\}}
        \\return;
    , .{ store, store, store, store, store, store, store, store }) catch unreachable;
}

/// `__koru_home_<owner>_<col>(v)` — -1 (the unset sentinel) passes;
/// anything else must carry a home store's brand, the same byte
/// `__koru_row_of` compares at deref. Lean stores self-skip: a store
/// that never mints handles is no home. `label` is the consumer's
/// module name — the panic names the enforcing library (`std/store`
/// on a column write, `std/list` on a push), not the home's.
fn storeRefHomeGuard(alloc: std.mem.Allocator, host: codegen_utils_store.HostTarget, label: []const u8, owner: []const u8, col: []const u8, target: []const u8, home_list: []const []const u8) []const u8 {
    var sb = std.ArrayList(u8){};
    if (host == .cs) {
        // C# has no @hasDecl: every cs cell decl emits `__koru_brand = -1`,
        // a value no minted handle's brand byte equals — the lean-store
        // self-skip lands as "never matches" instead of "never tested."
        // Guards are main_module members (the cell class closes first) so
        // write sites call them unqualified.
        sb.appendSlice(alloc, std.fmt.allocPrint(alloc, "    public static void __koru_home_{s}_{s}(long __v) {{\n        if (__v == -1) return;\n        var __b = (long)((((ulong)__v) & 0xFFFFFFFFUL) >> 24);\n", .{ owner, col }) catch unreachable) catch unreachable;
        for (home_list) |h| sb.appendSlice(alloc, std.fmt.allocPrint(alloc, "        if (__b == __koru_store_{s}.__koru_brand) return;\n", .{h}) catch unreachable) catch unreachable;
        sb.appendSlice(alloc, std.fmt.allocPrint(alloc, "        throw new global::System.Exception(\"std/{s}: '{s}.{s}' is ref({s}) - the value is not a handle a {s}-holding store minted (`| row` on such a store's insert or cursor; -1 is the unset sentinel)\");\n    }}\n", .{ label, owner, col, target, target }) catch unreachable) catch unreachable;
    } else if (host == .js) {
        sb.appendSlice(alloc, std.fmt.allocPrint(alloc, "function __koru_home_{s}_{s}(__v) {{\n    if (__v === -1) return;\n    const __g = Math.floor(__v / 4294967296); const __b = Math.floor((__v - __g * 4294967296) / 16777216);\n", .{ owner, col }) catch unreachable) catch unreachable;
        for (home_list) |h| sb.appendSlice(alloc, std.fmt.allocPrint(alloc, "    if (__koru_store_{s}.__koru_brand !== undefined && __b === __koru_store_{s}.__koru_brand) return;\n", .{ h, h }) catch unreachable) catch unreachable;
        sb.appendSlice(alloc, std.fmt.allocPrint(alloc, "    throw new Error(\"std/{s}: '{s}.{s}' is ref({s}) - the value is not a handle a {s}-holding store minted (`| row` on such a store's insert or cursor; -1 is the unset sentinel)\");\n}}\n", .{ label, owner, col, target, target }) catch unreachable) catch unreachable;
    } else {
        sb.appendSlice(alloc, std.fmt.allocPrint(alloc, "\nfn __koru_home_{s}_{s}(__v: i64) void {{\n    if (__v == -1) return;\n    const __b = @as(u32, @truncate(@as(u64, @bitCast(__v)))) >> 24;\n", .{ owner, col }) catch unreachable) catch unreachable;
        for (home_list) |h| sb.appendSlice(alloc, std.fmt.allocPrint(alloc, "    if (@hasDecl(__KoruStoreT_{s}, \"__koru_brand\") and __b == __KoruStoreT_{s}.__koru_brand) return;\n", .{ h, h }) catch unreachable) catch unreachable;
        sb.appendSlice(alloc, std.fmt.allocPrint(alloc, "    @panic(\"std/{s}: '{s}.{s}' is ref({s}) - the value is not a handle a {s}-holding store minted (`| row` on such a store's insert or cursor; -1 is the unset sentinel)\");\n}}\n", .{ label, owner, col, target, target }) catch unreachable) catch unreachable;
    }
    return sb.items;
}

/// One column's READ at `idx`. A `char[N]` cell binds the row text up
/// to the first NUL (690_052 semantics) — the plain indexed read hands the
/// handler a [N]u8 where its Input types a []const u8, a raw Zig coercion
/// error at a site the author never wrote (threat_bench). A JS column IS the
/// string and a C# `string` column stores exact text with no NUL padding —
/// the plain indexed read stands on both.
fn cellRead(alloc: std.mem.Allocator, host_target: codegen_utils_store.HostTarget, prog: *const ast_find.Program, cellq: []const u8, store: []const u8, col: []const u8, esc_col: []const u8, idx: []const u8) []const u8 {
    // `col` is ONE field name — a union-folded column like `creature.alive`
    // carries a dot Zig quotes away (`@"…"`) and cs folds (`creature_alive`).
    const mem = if (host_target == .cs)
        codegen_utils_store.HostShape.csMember(alloc, col)
    else
        esc_col;
    if (host_target == .zig and charCap(alloc, prog, store, col) != null)
        return std.fmt.allocPrint(alloc, "@import(\"std\").mem.sliceTo(&{s}__koru_store_{s}.{s}[{s}], 0)", .{ cellq, store, mem, idx }) catch unreachable;
    return std.fmt.allocPrint(alloc, "{s}__koru_store_{s}.{s}[{s}]", .{ cellq, store, mem, idx }) catch unreachable;
}
