// explain.kz — the `explain` COMMAND for Koru
//
// The SQL-`EXPLAIN` move, lifted to the compiler: a library optionally ships a
// comptime *explainer* that reads the program AST and explains how the library
// interpreted YOUR program's use of ITS OWN facilities — not generic docs, but
// "given this config and these call sites, here is what I decided about THIS
// code." std/store, for instance, would report per-store: which layout the
// current config elected, where it's watched, where it's updated.
//
//   koruc main.k explain            # human-readable (text)
//   koruc main.k explain json       # machine-readable
//   koruc main.k explain html       # rich page
//
// The `explain` command is the ONLY caller of explainers. Libraries *provide*
// explainers; they never invoke them. Like `deps` and `parser:generate`, this
// command runs INSTEAD of compilation with full AST access — the backend
// dispatches it before koru_coordinate, so no pipeline pass fires. It sees the
// freshly-parsed, pre-analysis AST (closest to original source).
//
// STATUS: item 1 of the build — the command registers and dispatches, and can
// reach the program AST. Explainer *discovery* (walking for [explainer] events)
// and output dispatch (json/html/text) are the next rungs; today it reports what
// it can already see and names the not-yet-wired path.

~import std/compiler

~[comptime]

// ============================================================
// EXPLAIN COMMAND — report how libraries interpret this program
// ============================================================

~std/compiler:command.declare {
    "name": "explain",
    "description": "Explain how libraries interpret this program's use of their facilities"
}

~[comptime|command]pub event explain {
    program: *const Program,
    allocator: __koru_std.mem.Allocator,
    argv: []const []const u8,
}

~proc explain|zig {
    const std = @import("std");

    // Output format is the command's own positional arg (default: text). The
    // json/html/text dispatch is a later rung; parse it now so the surface is
    // stable and the "unknown format" wall exists from the start.
    var format: []const u8 = "text";
    if (argv.len > 0) {
        const fmt = argv[0];
        if (std.mem.eql(u8, fmt, "text") or
            std.mem.eql(u8, fmt, "json") or
            std.mem.eql(u8, fmt, "html"))
        {
            format = fmt;
        } else {
            std.debug.print("explain: unknown format '{s}' — expected text | json | html\n", .{fmt});
            return;
        }
    }

    // Gather every library's report. `koru_explain_gather` is generated by koruc
    // per-program: it calls each discovered `[explainer]` once and collects the
    // returned ExplainReport values. We own the slice here in the command frame.
    // The command owns an arena: explainers allocate their reports freely into it
    // (store counts, per-store sections — all dynamic), and one deinit frees the
    // whole catalog after rendering. No explainer has to think about ownership.
    var report_arena = std.heap.ArenaAllocator.init(allocator);
    defer report_arena.deinit();
    const report_alloc = report_arena.allocator();

    const reports = koru_explain_gather(program, &report_alloc);

    if (reports.len == 0) {
        std.debug.print("📖 explain — no explainers registered. Libraries opt in by shipping a ~[explainer] event.\n", .{});
        return;
    }

    if (std.mem.eql(u8, format, "json")) {
        // The machinable catalog, nested by report and section so keys never
        // collide across sections (two stores both carry a "layout"). Typed
        // values: int stays int, string is quoted. Notes are human-only, omitted.
        std.debug.print("{{", .{});
        for (reports, 0..) |rep, ri| {
            if (ri > 0) std.debug.print(",", .{});
            std.debug.print("\"{s}\":{{", .{rep.title});
            var sfirst = true;
            for (rep.sections) |sec| {
                var has_prop = false;
                for (sec.entries) |e| {
                    if (e == .property) has_prop = true;
                }
                if (!has_prop) continue; // notes-only section: nothing machinable
                if (!sfirst) std.debug.print(",", .{});
                sfirst = false;
                std.debug.print("\"{s}\":{{", .{sec.heading});
                var pfirst = true;
                for (sec.entries) |entry| switch (entry) {
                    .note => {},
                    .property => |p| {
                        if (!pfirst) std.debug.print(",", .{});
                        pfirst = false;
                        switch (p.value) {
                            .integer => |i| std.debug.print("\"{s}\":{d}", .{ p.key, i }),
                            .float => |f| std.debug.print("\"{s}\":{d}", .{ p.key, f }),
                            .bool => |b| std.debug.print("\"{s}\":{}", .{ p.key, b }),
                            .string => |s| std.debug.print("\"{s}\":\"{s}\"", .{ p.key, s }),
                        }
                    },
                };
                std.debug.print("}}", .{});
            }
            std.debug.print("}}", .{});
        }
        std.debug.print("}}\n", .{});
        return;
    }

    // text (default) — the human report. html rides the same walk with tags.
    const html = std.mem.eql(u8, format, "html");
    if (html) std.debug.print("<div class=\"explain\">\n", .{});
    for (reports) |rep| {
        if (html) {
            std.debug.print("<section><h2>{s}</h2>\n", .{rep.title});
        } else {
            std.debug.print("📖 {s}\n", .{rep.title});
        }
        for (rep.sections) |sec| {
            if (html) {
                std.debug.print("<h3>{s}</h3><dl>\n", .{sec.heading});
            } else {
                std.debug.print("  {s}\n", .{sec.heading});
            }
            for (sec.entries) |entry| switch (entry) {
                .note => |n| {
                    if (html) std.debug.print("<p>{s}</p>\n", .{n}) else std.debug.print("    {s}\n", .{n});
                },
                .property => |p| {
                    if (html) std.debug.print("<dt>{s}</dt><dd>", .{p.key}) else std.debug.print("    {s} = ", .{p.key});
                    switch (p.value) {
                        .integer => |i| std.debug.print("{d}", .{i}),
                        .float => |f| std.debug.print("{d}", .{f}),
                        .bool => |b| std.debug.print("{}", .{b}),
                        .string => |s| std.debug.print("{s}", .{s}),
                    }
                    if (html) std.debug.print("</dd>\n", .{}) else std.debug.print("\n", .{});
                },
            };
            if (html) std.debug.print("</dl>\n", .{});
        }
        if (html) std.debug.print("</section>\n", .{});
    }
    if (html) std.debug.print("</div>\n", .{});
}
