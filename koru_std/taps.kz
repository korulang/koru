// Koru Standard Library: Tor Taps
// ==================================
//
// Observe event transitions without touching the flow being observed.
//
// A tap inserts a void call at the front of a matching continuation chain: the
// bound value stays in scope, and the optimizer sees an ordinary step — so
// observation lowers to a free, inline call rather than a runtime hook.
//
// USAGE (in `.kz`):
//   import std/taps
//
//   // Observe a concrete source, bind its produced value, react:
//   tap(compute -> *): v |> observed(value: v)
//
//   // Metatype branch (required for wildcard sources):
//   tap(* -> *)
//   | Profile p |> profiler(p)

~[comptime]

const std = @import("std");

// The tap transform implementation lives in taps.transform.kz (~part transform).
~part transform

// ============================================================================
// TAP TRANSFORM
// ============================================================================
// When the compiler encounters tap(...), this transform:
// 1. Parses the source/destination patterns
// 2. Walks the program AST finding matching transitions
// 3. Wraps matching continuations with the tap's void call
// 4. Removes the tap declaration (it compiled away)

// The declared blast radius: tap removes its own declaration and rewrites
// the flows it taps (which rewrites the module_decl items containing them).
// Everything else — event decls, procs, imports, host lines — is invariant.
// KORU181 refuses a write-back that exceeds this, and the transform-app
// witness commits the bound so the oracle can check containment itself.
// The rewrite is item-for-item and call-honest — contract:obliges names
// kind-stable plus consume-only; KORU187 refuses a violation of either.
~[
- keyword
- comptime
- transform
- contract:preserves("!flow","!module_decl")
- contract:obliges("kind-stable","consume-only")
]pub tor tap {
    expr: Expression,
    invocation: *const Invocation,
    item: *const std/compiler:Item,
    program: *const std/compiler:Program,
    allocator: std.mem.Allocator
} -> SiteResult
