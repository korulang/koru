// Koru Standard Library: the `callrec` part of interpreter — the
// call_step record and its capture machinery. Joined via `~part callrec`
// in interpreter.kz; merged into the interpreter module at load.
//
// TraceEntry IS the record: one per dispatched call, carrying both the
// prose trace's facts (event/bound/arm/json) and the structured halves
// the JSONL stream emits (args with ref flags, armed arm-words, arm_word,
// used cost, held-handle list, failed/error_msg). The prose renderer in
// the `trace` part and the bridge's call_step emitter read the same
// entries — log and model view cannot disagree by construction.
//
// pending_step is the dispatch about to run, stashed threadlocally so a
// throw still names its call: the run's catch completes it `failed`.
// Same threadlocal discipline as the trace sink — set for one dispatch,
// cleared the moment the entry lands.

/// One dispatched call's outcome in a run's trace — a chain's middle is
/// invisible to the model unless each link's issued value is named and
/// shown. `bound` is the durable session name (rN) when the host supplied a
/// binder; `arm` is the `|` arm's binding name when one armed it.
///
/// All string fields are arena-owned like `event`/`json`.
pub const TraceEntry = struct {
    event: []const u8,
    bound: []const u8,
    arm: ?[]const u8,
    json: []const u8,
    /// The branch this dispatch returned (`""` for an ordinary result,
    /// the name for a named branch, `""` on a failed dispatch).
    branch: []const u8 = "",
    /// JSON `[{name,raw,value,ref}]` — raw is the pre-eval wire text, value
    /// the evaluated arg, ref the literal/reference classification.
    args: []const u8 = "",
    /// JSON `[{w,b,g}]` — every arm word the model wrote at this node.
    armed: []const u8 = "",
    /// The arm word that matched (`ok`, a named branch, `*`), "" if none.
    arm_word: []const u8 = "",
    /// Cost charged for this dispatch (the budget's per-event price).
    used: u64 = 0,
    /// JSON list of held handle ids snapshotted after this dispatch.
    handles: []const u8 = "",
    /// True when THIS dispatch threw — the record exists so a
    /// `dispatch-error` tail still names the call that died.
    failed: bool = false,
    error_msg: []const u8 = "",
};

/// The host's session binder: mints the next durable name for a dispatched
/// result and stores the value where later turns can read it. The bridge
/// supplies one so mid-chain results get rN names too, not only terminals.
pub const SessionBindFn = *const fn (se: *Environment, counter: *u64, v: Value) []const u8;

/// Per-dispatch record escape (the `call_step` stream's Koru half): a
/// caller that wants structured records instead of the rendered `trace`
/// string sets a sink before `run`; every dispatched call's entries flush
/// into it at each trace-carrying return, and the throwing dispatch is
/// already in `ctx.trace` by then. Same threadlocal discipline as the
/// mounted scopes and dispatch pool — set for one run, cleared after.
/// Entry strings point into the run arena: the consumer must render
/// before the next interpreter run on this thread.
threadlocal var trace_sink: ?*std.ArrayListUnmanaged(TraceEntry) = null;

pub fn setTraceSink(sink: ?*std.ArrayListUnmanaged(TraceEntry)) void {
    trace_sink = sink;
}

pub fn sinkTraceEntries(trace: *const std.ArrayListUnmanaged(TraceEntry)) void {
    const s = trace_sink orelse return;
    if (trace.items.len == 0) return;
    s.appendSlice(std.heap.page_allocator, trace.items) catch {};
}

/// A dispatch in flight — its pre-dispatch record fields plus the raw
/// arg slice the JSON render needs. Evaluated values reach the record
/// through appendPendingStep's `eval_args` param, so an eval throw
/// leaves them empty and the failed record renders `value:""` — honest,
/// since evaluation never completed.
const PendingStep = struct {
    entry: TraceEntry,
    raw_args: []const ast.Arg,
};

/// In-flight dispatches, innermost last — a stack, not a slot: defined
/// flows recurse through this same dispatch path, so an outer call's
/// pending record must survive its body's inner dispatches. Arming
/// pushes, completing pops the top (LIFO matches call nesting), a throw
/// drains all — every real dispatch attempt still gets its record.
threadlocal var pending_stack: std.ArrayListUnmanaged(PendingStep) = .{};

/// Arm the record for the dispatch about to run: verb, the arm words at
/// this node, the cost charged, and the raw arg slice (evaluated values
/// reach the record via appendPendingStep's eval_args param). Called
/// BEFORE arg eval so an eval throw (UnboundName) still names its call.
fn armPendingStep(event_name: []const u8, event_cost: u64, raw_args: []const ast.Arg, conts: []const ast.Continuation, allocator: std.mem.Allocator) void {
    pending_stack.append(std.heap.page_allocator, .{
        .entry = .{
            .event = event_name,
            .bound = "",
            .arm = null,
            .json = "",
            .branch = "",
            .args = "",
            .armed = renderArmedArms(allocator, conts),
            .arm_word = "",
            .used = event_cost,
            .handles = "",
            .failed = false,
            .error_msg = "",
        },
        .raw_args = raw_args,
    }) catch {};
}

/// Complete the innermost pending record with the dispatch's outcome and
/// land it in the trace — `eval_args` are the post-eval arg slice (empty
/// on the failure path, which renders raw+ref with `value:""`). Returns
/// the trace index so the arm patch can find it.
fn appendPendingStep(ctx: *InterpreterContext, bound_name: []const u8, branch: []const u8, json: []const u8, eval_args: []const ast.Arg) usize {
    const p = if (pending_stack.items.len > 0) pending_stack.pop().? else PendingStep{
        .entry = .{ .event = "", .bound = "", .arm = null, .json = "",
            .branch = "", .args = "", .armed = "", .arm_word = "", .used = 0,
            .handles = "", .failed = false, .error_msg = "" },
        .raw_args = &.{},
    };
    var step_entry = p.entry;
    step_entry.args = renderCallArgs(ctx.allocator, p.raw_args, eval_args);
    step_entry.bound = bound_name;
    step_entry.branch = branch;
    step_entry.json = json;
    step_entry.handles = if (ctx.handle_pool) |pool| renderHeldHandles(pool) else "[]";
    const idx = ctx.trace.items.len;
    ctx.trace.append(ctx.allocator, step_entry) catch {};
    return idx;
}

/// A throw still records every dispatch it interrupted: the innermost
/// pending (the one that threw — eval or dispatch) gets `failed` and the
/// error; outer in-flight dispatches get their records with empty
/// outcome fields — they were dispatched, their result never arrived.
/// Args render raw+ref only: eval never completed, so `value` stays "".
fn recordFailedStep(ctx: *InterpreterContext, allocator: std.mem.Allocator, err: anyerror) void {
    if (pending_stack.items.len == 0) return;
    const items = pending_stack.items;
    for (items, 0..) |p, i| {
        var fe = p.entry;
        fe.args = renderCallArgs(allocator, p.raw_args, &.{});
        fe.handles = if (ctx.handle_pool) |pool| renderHeldHandles(pool) else "[]";
        if (i == items.len - 1) {
            fe.failed = true;
            fe.error_msg = ctx.error_detail orelse @errorName(err);
        }
        ctx.trace.append(allocator, fe) catch {};
    }
    pending_stack.clearRetainingCapacity();
}

