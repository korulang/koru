// Resource Bridge Standard Library
// Persistent handle storage for long-running interactive sessions (Hollywood OS mode)
//
// A Bridge owns a HandlePool that outlives any single interpreter run, so a
// resource opened on one turn is still held on the next — the human or the agent
// can act on it three turns later and the obligation is still outstanding.
//
// The session is itself an obligation: `create` mints `<session!>` and only
// `close` discharges it, so a bridge cannot be brought into being and forgotten.
// You cannot forget to hang up.
//
// A bridge is bound to a SCOPE at birth. The scope is the vocabulary: the set of
// events that may act on what the bridge holds, and — through each obligation's
// recorded discharge event — the knowledge of how to release it. That is what
// makes hanging up able to actually release rather than merely forget.

~[comptime|runtime]

~import std/interpreter
~import std/runtime

const std = @import("std");

// Re-export interpreter types
pub const HandlePool = @import("root").koru_std.koru_interpreter.HandlePool;
pub const Handle = @import("root").koru_std.koru_interpreter.Handle;

// Bridge: persistent session state
pub const Bridge = struct {
    pool: HandlePool,
    allocator: std.mem.Allocator,
    session_id: []const u8,
    /// The registered scope this session's resources belong to. Discharge is
    /// dispatched through it, so a bridge with no reachable scope can hold
    /// handles but cannot release them — and `close` reports exactly that.
    scope: []const u8,
    created_at: i64,
    last_active: i64,

    pub fn init(allocator: std.mem.Allocator, session_id: []const u8, scope: []const u8) Bridge {
        return .{
            .pool = HandlePool.init(allocator),
            .allocator = allocator,
            .session_id = allocator.dupe(u8, session_id) catch session_id,
            .scope = allocator.dupe(u8, scope) catch scope,
            .created_at = std.time.milliTimestamp(),
            .last_active = std.time.milliTimestamp(),
        };
    }

    pub fn touch(self: *Bridge) void {
        self.last_active = std.time.milliTimestamp();
    }

    pub fn getHandleCount(self: *Bridge) u32 {
        var count: u32 = 0;
        for (self.pool.handles.items) |h| {
            if (!h.discharged) count += 1;
        }
        return count;
    }

    /// Invoke the real discharge event for every handle still held, through the
    /// session's scope. Returns how many are STILL held afterwards — zero means
    /// the session released everything it was holding.
    ///
    /// This used to print a line, set `discharged = true`, and call nothing: the
    /// counter went to zero while every file stayed open. It now runs the same
    /// loop the interpreter's end-of-run auto-discharge runs, because releasing a
    /// resource is one act, not two implementations.
    pub fn dischargeAll(self: *Bridge) u32 {
        const rt = @import("root").koru_std.koru_runtime;
        const interp = @import("root").koru_std.koru_interpreter;

        switch (rt.get_scope_event.handler(.{ .name = self.scope })) {
            .scope => |s| interp.dischargeAllHandles(
                "BRIDGE",
                &self.pool,
                s.discharges_spec_fn,
                s.dispatcher,
                self.allocator,
            ),
            .not_found => std.debug.print(
                "[BRIDGE] session '{s}': scope '{s}' is not registered, {d} handle(s) cannot be released\n",
                .{ self.session_id, self.scope, self.getHandleCount() },
            ),
        }
        return self.getHandleCount();
    }

    pub fn deinit(self: *Bridge) void {
        self.allocator.free(self.session_id);
        self.allocator.free(self.scope);
        self.pool.deinit();
    }
};

// ============================================================================
// CREATE - Open a bridge session against a registered scope
// ============================================================================

~pub tor create { id: string, scope: string } -> *Bridge<session!>

~proc create|zig {
    const allocator = koru_allocator();
    const br = allocator.create(Bridge) catch unreachable;
    br.* = Bridge.init(allocator, id, scope);
    return br;
}

// ============================================================================
// GET_HANDLES - Query handles currently on the bridge
// ============================================================================

~pub tor get-handles { br: *Bridge } -> u32

~proc get-handles|zig {
    return br.getHandleCount();
}

// ============================================================================
// CLOSE - Hang up: release everything the session still holds
// ============================================================================
//
// Returns the number of handles STILL HELD after the attempt. Zero is a clean
// hang-up. Non-zero means the bridge could not release them — an unregistered
// scope, or a discharge event that itself failed — and the caller is told rather
// than handed a satisfied counter over a leaked resource.

~pub tor close { br: *Bridge<!session> } -> u32

~proc close|zig {
    const still_held = br.dischargeAll();
    br.deinit();
    koru_allocator().destroy(br);
    return still_held;
}
