// Resource Bridge Standard Library
// Persistent handle storage for long-running interactive sessions (Hollywood OS mode)
//
// A Bridge owns a HandlePool that outlives any single interpreter run, so a
// resource opened on one turn is still held on the next — the human or the agent
// can act on it three turns later and the obligation is still outstanding.
//
// The session is itself an obligation: `create` mints `<session!>` and only
// `close` discharges it, so a bridge cannot be brought into being and forgotten.
// You cannot forget to hang up.
//
// A bridge is bound to a SCOPE at birth. The scope is the vocabulary: the set of
// events that may act on what the bridge holds, and — through each obligation's
// recorded discharge event — the knowledge of how to release it. That is what
// makes hanging up able to actually release rather than merely forget.

~[comptime|runtime]

~import std/interpreter
~import std/runtime

const std = @import("std");

// Re-export interpreter types
pub const HandlePool = @import("root").koru_std.koru_interpreter.HandlePool;
pub const Handle = @import("root").koru_std.koru_interpreter.Handle;
pub const DefinedFlows = @import("root").koru_std.koru_interpreter.DefinedFlows;

// Bridge: persistent session state
pub const Bridge = struct {
    pool: HandlePool,
    allocator: std.mem.Allocator,
    session_id: []const u8,
    /// The registered scope this session's resources belong to. Discharge is
    /// dispatched through it, so a bridge with no reachable scope can hold
    /// handles but cannot release them — and `close` reports exactly that.
    scope: []const u8,
    created_at: i64,
    last_active: i64,
    /// Runtime-defined flows (the REPL define) — durable per session, so a
    /// verb defined on one turn is callable on the next, and its calls run
    /// through the same possession machinery as any other dispatch.
    defined: *DefinedFlows,

    pub fn init(allocator: std.mem.Allocator, session_id: []const u8, scope: []const u8) Bridge {
        const defined = allocator.create(DefinedFlows) catch @panic("std/bridge:create: OOM minting defined-flows table");
        defined.* = DefinedFlows.init(allocator);
        return .{
            .pool = HandlePool.init(allocator),
            .allocator = allocator,
            .session_id = allocator.dupe(u8, session_id) catch session_id,
            .scope = allocator.dupe(u8, scope) catch scope,
            .created_at = std.time.milliTimestamp(),
            .last_active = std.time.milliTimestamp(),
            .defined = defined,
        };
    }

    pub fn touch(self: *Bridge) void {
        self.last_active = std.time.milliTimestamp();
    }

    pub fn getHandleCount(self: *Bridge) u32 {
        var count: u32 = 0;
        for (self.pool.handles.items) |h| {
            if (!h.discharged) count += 1;
        }
        return count;
    }

    /// Invoke the real discharge event for every handle still held, through the
    /// session's scope.
    ///
    /// This used to print a line, set `discharged = true`, and call nothing: the
    /// counter went to zero while every file stayed open. It now runs the same
    /// loop the interpreter's end-of-run auto-discharge runs, because releasing a
    /// resource is one act, not two implementations.
    ///
    /// A session that CANNOT release what it holds panics rather than returning
    /// a number. It briefly returned the still-held count, which read as honest
    /// and was not: nothing obliges a caller to look at a return value, so the
    /// unread count is the same shape as the boolean it replaced — satisfied
    /// bookkeeping over a live resource. It also cost more than it looked:
    /// auto-discharge can only insert a disposer with NOTHING TO BIND
    /// (`auto_discharge_inserter.zig:2742`), so a `-> u32` close disqualified
    /// itself and every failure arm of every conversation had to hang up by hand.
    pub fn dischargeAll(self: *Bridge) void {
        const rt = @import("root").koru_std.koru_runtime;
        const interp = @import("root").koru_std.koru_interpreter;

        switch (rt.get_scope_event.handler(.{ .name = self.scope })) {
            .scope => |s| interp.dischargeAllHandles(
                "BRIDGE",
                &self.pool,
                s.discharges_spec_fn,
                s.dispatcher,
                self.allocator,
            ),
            .not_found => std.debug.panic(
                "std/bridge:close: session '{s}' holds {d} handle(s) and its scope '{s}' is not registered, so nothing can release them",
                .{ self.session_id, self.getHandleCount(), self.scope },
            ),
        }

        const stranded = self.getHandleCount();
        if (stranded != 0) std.debug.panic(
            "std/bridge:close: session '{s}' still holds {d} handle(s) after hang-up — a discharge event failed (see the [BRIDGE] lines above)",
            .{ self.session_id, stranded },
        );
    }

    pub fn deinit(self: *Bridge) void {
        self.allocator.free(self.session_id);
        self.allocator.free(self.scope);
        self.pool.deinit();
        self.defined.deinit();
        self.allocator.destroy(self.defined);
    }
};

// ============================================================================
// CREATE - Open a bridge session against a registered scope
// ============================================================================

~pub tor create { id: string, scope: string } -> *Bridge<session!>

~proc create|zig {
    const allocator = koru_allocator();
    const br = allocator.create(Bridge) catch unreachable;
    br.* = Bridge.init(allocator, id, scope);
    return br;
}

// ============================================================================
// GET_HANDLES - Query handles currently on the bridge
// ============================================================================

~pub tor get-handles { br: *Bridge } -> u32

~proc get-handles|zig {
    return br.getHandleCount();
}

// ============================================================================
// RUN - Execute a turn against the session's resources
// ============================================================================
//
// The verb the bridge existed without: `std/runtime:run` takes a `handle_pool`
// and a `scope`, and a bridge is exactly a pairing of those two that outlives a
// single turn. Without this, every caller reached into Zig for `&br.pool` — the
// mechanism was real and the Koru surface over it did not exist.
//
// The branch set MIRRORS `std/runtime:run` rather than trimming it: forwarding a
// vocabulary that already exists invents nothing, and a turn can fail every way
// a run can fail.
//
// Two of that tor's parameters are deliberately not forwarded:
//
// - `budget` — metering is PARKED. It earns its keep on a public-facing API, not
//   on an internal bridge, and exposing the knob here would quietly un-park it.
// - `auto_discharge` — always false, and it must be. A bridge-managed pool
//   outlives the run BY DESIGN; releasing at end-of-turn is precisely the
//   retention this whole subsystem exists to provide. `close` is what releases.

~pub tor run { br: *Bridge, source: string }
| result { value: @import("root").koru_std.koru_interpreter.Value, used: u64, handles: u32 }
| defined string
| exhausted { used: u64, last_event: string, handles: u32 }
| parse-error { message: string, line: u32, column: u32 }
| validation-error string
| shape-error { branch: string, field: ?[]const u8, message: string }
| event-denied string
| dispatch-error { event_name: string, message: string }
| scope-not-found string

~proc run|zig {
    const rt = @import("root").koru_std.koru_runtime;
    const interp = @import("root").koru_std.koru_interpreter;

    br.touch();

    // RUN DISCRIMINATION (the REPL rule): a declaration is not a dispatch.
    // If the source is a subflow definition (`tor name { args }` +
    // `name = <body>`, identifiable by its leading `tor`), install it into
    // the session's durable defined-flows table and report `defined <name>`
    // instead of routing it into the dispatcher where it would parse-error
    // as an invocation. One verb, two meanings — exactly as a REPL's def.
    // This is the R1 rung of KOPIUM_RUNTIME.md: the bridge run loop is a REPL.
    {
        const trimmed = std.mem.trim(u8, source, " \t\r\n");
        if (std.mem.startsWith(u8, trimmed, "tor ")) {
            return switch (interp.define_event.handler(.{
                .source = source,
                .defined = br.defined,
            })) {
                .defined => |d| .{ .defined = d },
                .parse_error => |e| .{ .parse_error = .{
                    .message = e.message,
                    .line = e.line,
                    .column = e.column,
                } },
            };
        }
    }

    const result = rt.run_event.handler(.{
        .source = source,
        .scope = br.scope,
        .handle_pool = &br.pool,
        .auto_discharge = false,
        .defined = br.defined,
    });

    return switch (result) {
        .result => |r| .{ .result = .{ .value = r.value, .used = r.used, .handles = r.handles } },
        .exhausted => |e| .{ .exhausted = .{ .used = e.used, .last_event = e.last_event, .handles = e.handles } },
        .parse_error => |e| .{ .parse_error = .{ .message = e.message, .line = e.line, .column = e.column } },
        .validation_error => |e| .{ .validation_error = e },
        .shape_error => |e| .{ .shape_error = .{ .branch = e.branch, .field = e.field, .message = e.message } },
        .event_denied => |e| .{ .event_denied = e },
        .dispatch_error => |e| .{ .dispatch_error = .{ .event_name = e.event_name, .message = e.message } },
        .scope_not_found => |e| .{ .scope_not_found = e },
    };
}

// ============================================================================
// DEFINE - install a subflow declaration as a session verb (the REPL define)
// ============================================================================
//
// The vocabulary grows at runtime: `tor name { args }` + `name = <body>`
// becomes a verb callable on subsequent runs, held in the session's durable
// defined-flows table. The body's calls run through the same possession
// machinery as any dispatch, so a defined flow cannot reach beyond what the
// session holds. The agent hears "defined name" — or the parse error — fed
// back into the transcript (the honest-diagnostics rule applies here most of
// all: a wrong declaration needs a truthful error).

~pub tor define { br: *Bridge, source: string }
| defined string
| parse-error { message: string, line: u32, column: u32 }

~proc define|zig {
    const interp = @import("root").koru_std.koru_interpreter;
    br.touch();
    return switch (interp.define_event.handler(.{
        .source = source,
        .defined = br.defined,
    })) {
        .defined => |d| .{ .defined = d },
        .parse_error => |e| .{ .parse_error = .{
            .message = e.message,
            .line = e.line,
            .column = e.column,
        } },
    };
}

// ============================================================================
// VOCABULARY - the derived prompt, session-shaped
// ============================================================================
//
// `std/runtime:scope-vocabulary` renders a scope's COMPILED events — the
// base vocabulary the program was built with. This tor grows that with the
// session's DEFINED flows, so the prompt walks the whole environment a REPL
// accumulates: compiled scopes plus the verbs the agent invented on earlier
// turns. That visibility is the second half of the R1 claim — an invention
// the agent never sees in its own prompt is an invention it will not use.
//
// The same arena discipline as scope-vocabulary: the returned string is
// page-backed and intentionally never freed, because it must outlive this
// call and land in the caller's prompt buffer.

~pub tor vocabulary { br: *Bridge }
| ok string
| not-found string

~proc vocabulary|zig {
    const rt = @import("root").koru_std.koru_runtime;

    var arena_state = std.heap.ArenaAllocator.init(std.heap.page_allocator);
    const allocator = arena_state.allocator();
    var out = std.ArrayList(u8).initCapacity(allocator, 256) catch unreachable;

    switch (rt.scope_vocabulary_event.handler(.{ .name = br.scope })) {
        .ok => |v| out.appendSlice(allocator, v) catch unreachable,
        .not_found => return .{ .not_found = br.scope },
    }

    // The session's own inventions, one line each, same syntax as the scope
    // renderer: `name(param: type<!phantom>, ...)`.
    var it = br.defined.map.iterator();
    while (it.next()) |entry| {
        const flow = entry.value_ptr.*;
        if (out.items.len > 0) out.append(allocator, '\n') catch unreachable;
        out.appendSlice(allocator, flow.name) catch unreachable;
        out.append(allocator, '(') catch unreachable;
        for (flow.params, 0..) |pname, i| {
            if (i > 0) out.appendSlice(allocator, ", ") catch unreachable;
            out.appendSlice(allocator, pname) catch unreachable;
            out.appendSlice(allocator, ": ") catch unreachable;
            out.appendSlice(allocator, flow.param_types[i]) catch unreachable;
        }
        out.append(allocator, ')') catch unreachable;
    }

    return .{ .ok = out.toOwnedSlice(allocator) catch unreachable };
}

// ============================================================================
// CLOSE - Hang up: release everything the session still holds
// ============================================================================
//
// VOID, and that is load-bearing rather than minimal. Auto-discharge can only
// insert a disposer with nothing to bind — `auto_discharge_inserter.zig:2742`
// refuses any event carrying a branch or a bare return, because the inserter
// appends a bare call and cannot invent a binding for its output. A `close`
// that returned the still-held count disqualified itself, which meant every
// failure arm of every conversation had to spell the hang-up by hand.
//
// Failing to release is not a value a caller may drop; it panics. `get-handles`
// is there for anyone who wants the count on either side of the call.

~pub tor close { br: *Bridge<!session> }

~proc close|zig {
    br.dischargeAll();
    br.deinit();
    koru_allocator().destroy(br);
}
