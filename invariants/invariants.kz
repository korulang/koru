// The repo's declared invariants — the manifest the git-gate compiles.
//
//   koruc invariants/invariants.kz invariants          # list
//   koruc invariants/invariants.kz invariants gate     # gate; non-zero on violation
//
// koruc emits its backend artifacts next to the entry file; this directory
// exists so they land here (gitignored) and not in the repo root, which
// carries a tracked, hand-written build.zig. Checks run with the compilation
// root — this directory — as cwd, so repo paths start with `..`.

~import std/invariants

~std/invariants:inferred {
    "name": "emit-for-not-while",
    "tags": ["git-gate"],
    "rule": "Any emitter producing a counted Zig loop emits for, not while. while (i < len) : (i += 1) hands the optimizer a mutable induction variable and a loop-carried condition; for (0..len) |i| hands it a known trip count, and for (xs, ys) |*x, y| additionally proves non-aliasing and removes bounds checks — that is what lets LLVM vectorize. A while is legitimate only where the trip count genuinely is not known up front: a parser scan, a freelist walk, an early-breaking search. The check decides over the string-literal content of koru_std transforms — the text that BECOMES emitted Zig (allocPrint formats with escapes decoded, appendSlice literals, multiline blocks) — and never flags a transform's own compile-time loops. Every emitted while is a violation unless it carries a declared exemption (file + condition fingerprint + reason) in checks/emitted-while.allow; a stale exemption fails the check. The check self-tests against must-match and must-not-match fixtures before scanning and reports BROKEN, never clean, if it cannot prove it can still match. Out of its reach, decided by inference at review time: bare Zig in runtime proc bodies (ships verbatim, indistinguishable from compile-time code without annotation context) and the emitter templates in src/.",
    "check": "python3 checks/check_emitted_while.py ../koru_std checks/emitted-while.allow"
}

~std/invariants:inferred {
    "name": "call-valued-index",
    "tags": ["git-gate"],
    "rule": "Emitted Zig never puts a call expression in index position against a named base: store.px[store.__koru_resolve(h)] is not an indexed load — the base is an aggregate held by value in a mutable global and the index is a call that could mutate that global, so Zig materialises the whole aggregate before indexing. Measured 2026-07-31: 80 KB copied per access at store capacity 10,000, ~100% of sweep runtime in _platform_memmove, 1750x recovered by binding the call to a const first (concepts/frag-a-call-valued-index-copies-the-whole-array.md). Every such site is CORRECT, so no test can see it. What the check actually catches — the honest heuristic subset: in the string-literal content of koru_std transforms, an index or slice bracket whose content contains a non-builtin call, with a named chain (identifiers, fields, placeholders) as base. It cannot see types, so it over-approximates beyond by-value aggregates on purpose — the hoist fix is correct for every base. It cannot see calls assembled across concatenated fragments, calls arriving through a {s} placeholder's runtime value, or bare proc-body Zig. Exemptions in checks/call-valued-index.allow, same mechanics as emitted-while; the check self-tests before scanning and reports BROKEN, never clean, if its patterns stop matching.",
    "check": "python3 checks/check_call_valued_index.py ../koru_std checks/call-valued-index.allow"
}

~std/invariants:inferred {
    "name": "every-emitted-variant-has-a-witness",
    "tags": ["post-full-run"],
    "rule": "Every variant an emitter can produce must appear in at least one test's emitted output; a variant appearing in zero is invisible surface — it ships, no test has ever run it, and a green board says nothing about it (__kz_wd, the raw_posix integer digit writer, was found by hand this way). This is a different axis from the two checks above: they are static over emitter source (what the emitter COULD write); this one is dynamic over emitted artifacts (what the corpus actually MADE it write), so it runs in the post-full-run slot beside the wall census, where artifacts exist for the whole board. The variant set is DERIVED, never hand-listed: a variant is identified by its marker, a __-prefixed symbol in the emitted-string content of the koru_std transforms (same extraction as the sibling checks), with template placeholders as wildcards and concatenation-head fragments folded into their templated duals. Coverage reads each test's output_emitted.zig and counts a marker only where it appears as BARE code — emitted text lives inside string literals at the emitter and materialises as bare code in the artifact, while emitter source embedded in an artifact keeps its markers inside strings, so the bare/quoted inversion is what makes a witness a witness. Artifacts are ephemeral: below half the test dirs carrying one (a full board measures ~65%, a filtered run ~1%) the check reports BROKEN and voids its verdict, never clean. The claim is deliberately narrow and named: a variant that emits only anonymous code shares its witness with every sibling using the same helper symbols; the |js variant (console.log into output_emitted.js), src/ emitter templates, prose-quoted symbols, and variants reachable only under another --build host are out of reach — an uncovered symbol whose invisibility is understood gets a reasoned exemption in checks/variant-coverage.allow, and a stale exemption fails. The check self-tests derivation and artifact scanning against must-match and must-not-match fixtures before judging.",
    "check": "python3 checks/check_variant_coverage.py ../koru_std ../tests/regression checks/variant-coverage.allow"
}

~tor main {}

~proc main|zig {
}

~main()
