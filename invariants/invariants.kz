// The repo's declared invariants — the manifest the git-gate compiles.
//
//   koruc invariants/invariants.kz invariants          # list
//   python3 invariants/gate.py                         # the gate consumer:
//     per git-gate row — run `check:` if declared (deterministic, blocks);
//     no `check:` → judge the staged diff via the gate binary (koru/odds);
//     `odds-N` tag → deterministic roll of (name + staged diff) mod 100 —
//     the row fires only below N: a sampled alarm, not a schedule.
//
// koruc emits its backend artifacts next to the entry file; this directory
// exists so they land here (gitignored) and not in the repo root, which
// carries a tracked, hand-written build.zig. Checks run with the compilation
// root — this directory — as cwd, so repo paths start with `..`.

~import std/invariants
// The profile that selects the git-gate-tagged rows below. Judgment rows
// delegate to the compiled gate.k binary (koru/odds → Jev); judge_src is
// the staleness oracle the runner rebuilds through.
~import std/gate
// Pulled in for its colocated git-gate-local declarations — the listing
// walks imports, so a module's own invariants surface only through one.
~import koru/odds

~std/gate:profile("git-gate") {
    "block": true,
    "description": "the repo's pre-commit enforcement — check: instruments always block; judgment rows delegate to the Jev verdict binary",
    "judge": "a.out",
    "judge_src": "gate.k"
}

~std/invariants:inferred {
    "name": "emit-for-not-while",
    "tags": ["git-gate"],
    "rule": "Any emitter producing a counted Zig loop emits for, not while — unless a measurement says otherwise. while (i < len) : (i += 1) hands the optimizer a mutable induction variable and a loop-carried condition; for (0..len) |i| hands it a known trip count, and for (xs, ys) |*x, y| additionally proves non-aliasing and removes bounds checks — that is usually what lets LLVM vectorize, but it is a heuristic about compiler behaviour, not a law, and it has measured false: 2026-10-23, the kernel pairwise triangular nest emitted 5% faster as while on arm64/Zig 0.15.2 (0.63s vs 0.66s, checksum-identical, min-of-5), while a canonical for (0..(N-i-1)) trip-count spelling and a const-rebinding variant both failed to recover it. A while is therefore legitimate in two cases: the trip count genuinely is not known up front (a parser scan, a freelist walk, an early-breaking search), or a MEASURED EXCEPTION — a counted loop where a benchmark on the real emitted artifact shows the while shape faster, pinned in a comment at the emit site so the ruling can be revisited when the compiler landscape changes. The check decides over the string-literal content of koru_std transforms — the text that BECOMES emitted Zig (allocPrint formats with escapes decoded, appendSlice literals, multiline blocks) — and never flags a transform's own compile-time loops. Every emitted while is a violation unless it carries a declared exemption (file + condition fingerprint + reason) in checks/emitted-while.allow; a stale exemption fails the check, and a measured exception's reason must cite its measurement. The check self-tests against must-match and must-not-match fixtures before scanning and reports BROKEN, never clean, if it cannot prove it can still match. Out of its reach, decided by inference at review time: bare Zig in runtime proc bodies (ships verbatim, indistinguishable from compile-time code without annotation context) and the emitter templates in src/.",
    "check": "python3 checks/check_emitted_while.py ../koru_std checks/emitted-while.allow"
}

~std/invariants:inferred {
    "name": "call-valued-index",
    "tags": ["git-gate"],
    "rule": "Emitted Zig never puts a call expression in index position against a named base: store.px[store.__koru_resolve(h)] is not an indexed load — the base is an aggregate held by value in a mutable global and the index is a call that could mutate that global, so Zig materialises the whole aggregate before indexing. Measured 2026-07-31: 80 KB copied per access at store capacity 10,000, ~100% of sweep runtime in _platform_memmove, 1750x recovered by binding the call to a const first (concepts/frag-a-call-valued-index-copies-the-whole-array.md). Every such site is CORRECT, so no test can see it. What the check actually catches — the honest heuristic subset: in the string-literal content of koru_std transforms, an index or slice bracket whose content contains a non-builtin call, with a named chain (identifiers, fields, placeholders) as base. It cannot see types, so it over-approximates beyond by-value aggregates on purpose — the hoist fix is correct for every base. It cannot see calls assembled across concatenated fragments, calls arriving through a {s} placeholder's runtime value, or bare proc-body Zig. Exemptions in checks/call-valued-index.allow, same mechanics as emitted-while; the check self-tests before scanning and reports BROKEN, never clean, if its patterns stop matching.",
    "check": "python3 checks/check_call_valued_index.py ../koru_std checks/call-valued-index.allow"
}

~std/invariants:inferred {
    "name": "every-emitted-variant-has-a-witness",
    "tags": ["post-full-run"],
    "rule": "Every variant an emitter can produce must appear in at least one test's emitted output; a variant appearing in zero is invisible surface — it ships, no test has ever run it, and a green board says nothing about it (__kz_wd, the raw_posix integer digit writer, was found by hand this way). This is a different axis from the two checks above: they are static over emitter source (what the emitter COULD write); this one is dynamic over emitted artifacts (what the corpus actually MADE it write), so it runs in the post-full-run slot beside the wall census, where artifacts exist for the whole board. The variant set is DERIVED, never hand-listed: a variant is identified by its marker, a __-prefixed symbol in the emitted-string content of the koru_std transforms (same extraction as the sibling checks), with template placeholders as wildcards and concatenation-head fragments folded into their templated duals. Coverage reads each test's output_emitted.zig and counts a marker only where it appears as BARE code — emitted text lives inside string literals at the emitter and materialises as bare code in the artifact, while emitter source embedded in an artifact keeps its markers inside strings, so the bare/quoted inversion is what makes a witness a witness. Artifacts are ephemeral: below half the test dirs carrying one (a full board measures ~65%, a filtered run ~1%) the check reports BROKEN and voids its verdict, never clean. The claim is deliberately narrow and named: a variant that emits only anonymous code shares its witness with every sibling using the same helper symbols; the |js variant (console.log into output_emitted.js), src/ emitter templates, prose-quoted symbols, and variants reachable only under another --build host are out of reach — an uncovered symbol whose invisibility is understood gets a reasoned exemption in checks/variant-coverage.allow, and a stale exemption fails. The check self-tests derivation and artifact scanning against must-match and must-not-match fixtures before judging.",
    "check": "python3 checks/check_variant_coverage.py ../koru_std ../tests/regression checks/variant-coverage.allow"
}

// The judgment class: rules with no `check:` are routed by the gate to a
// reader — Jev via koru/odds — against the staged diff. The `rule` text is
// written to BE the question: diff-scoped, verdict-shaped, self-contained.
~std/invariants:inferred {
    "name": "no-fallbacks",
    "tags": ["git-gate"],
    "rule": "Does this diff introduce a fallback — a degraded path a reader would mistake for the real surface working? A fallback is: a default value substituted for a failed fetch or computation, placeholder output standing where real content belongs, a swallowed error converted into a silent skip or empty result, or a second code path labeled 'for now', 'minimum', 'if X fails', or 'fallback'. Designed states are NOT fallbacks: an empty state that says it is empty, a documented default parameter, an idle pose, a named and tested degraded mode. Answer yes ONLY if the diff adds or keeps a substitute output that hides the real path's failure or absence."
}

// Syntax rulings, gated: a shipped spelling nobody ruled is the failure this
// row exists for (ref(T) entered the stdlib on inherited vocabulary, caught
// only when Lars asked — confession udue5gx). The concept being discussed in
// a design note is not a ruling on its spelling; the gate asks about the
// spelling specifically.
~std/invariants:inferred {
    "name": "surface-spellings-are-ruled",
    "tags": ["git-gate", "judge-additions"],
    "rule": "Does this diff add recognition for a new user-facing spelling — a shape a user can write that the toolchain detects by pattern — with no recorded ruling? Spellings include: type-position forms matched in field or argument text (`ref(T)`, `?T`, `<:`), new `std/` tor or proc names, and marker conventions downstream code string-matches. A ruling is recorded: a commit message, a design doc's RULED line, or a concepts/ frag naming the spelling as decided. A concept being ranked or a semantics being discussed is NOT a ruling on its spelling. Flag when the diff teaches koru_std or src/ to recognize or lower a form no ruling names. Do NOT flag: internal `__koru_*` machinery, diagnostic message text, refactors of ruled spellings, or a spelling whose ruling is recorded in this same diff. Answer yes ONLY if the diff creates public surface whose spelling nobody ruled."
}

~std/invariants:inferred {
    "name": "claim-stamps-stay-honest",
    "tags": ["git-gate"],
    "rule": "Does this diff weaken a std/rules claim silently? Declarations carry claim stamps — proven, measured, inferred, aspirational — visible inline in the source this diff touches. Flag when the diff edits the body of a declaration stamped proven or measured without the diff also touching the evidence the stamp rests on (a test, benchmark, or proof artifact), or when it removes or downgrades a stamp without saying so. Editing a claimed declaration together with its evidence, or strengthening a stamp, is NOT a violation. Answer yes ONLY if the diff leaves a stamp asserting something the edit has made untrue."
}

// The deterministic twin of the row above: the judge asks whether a diff
// weakened a claim's evidence; this check asks whether the evidence EXISTS.
// A stamp above `aspirational` is a standing instrument — it must name what
// keeps discharging it and the pointer must resolve (a repo path, a pin dir
// under tests/, a manifest row name). Unsampled on purpose: the check reads
// the working tree, so a dead instrument fails the NEXT commit regardless of
// which diff killed it — sampling would let rot pass nine commits in ten.
~std/invariants:inferred {
    "name": "instrumented-stamps-resolve",
    "tags": ["git-gate"],
    "rule": "Every std/rules claim stamp above `aspirational` — `inferred`, `measured`, `proven` — must name a running instrument in its entry (`- measured <pointer>`), and the pointer must resolve: a repo-relative path that exists (a pin dir, a benchmark, a proof artifact), a directory name under tests/ (a bare pin name), or a \"name\" row in this manifest (a gate row re-discharges the claim on every commit). A stamp whose pointer resolves to nothing is prose claiming to be discharged — the content class this row exists to delete. `aspirational` entries carry no pointer and are exempt: undischarged is the honest state. The check scans the WORKING tree so dead instruments fail whoever's commit comes next; it self-tests its entry parser before scanning and reports BROKEN, never clean, if the claim grammar stops matching. Concept: concepts/frag-claim-stamps-are-standing-instruments.md.",
    "check": "zig run ../tools/check_claim_instruments.zig -- .. --allow checks/claim-instruments.allow ../koru_std ../tests ../examples"
}

// The facet is earned: `.k` is the pure-Koru default, `.kz` is for files
// that carry host content — and which a file is, the parser decides. The
// row is diff-scoped (staged .kz paths only, judged on the STAGED blob —
// a partial stage can't make the gate rule on bytes the commit won't
// ship), so the historical backlog stays the lint's problem
// (scripts/kz_convertible.sh) and this row only stops new debt.
~std/invariants:inferred {
    "name": "kz-extension-is-earned",
    "tags": ["git-gate"],
    "rule": "Every .kz path in the staged diff (added, modified, or renamed into the facet) must carry host content — a non-comment host_line, a host_type_decl, or a proc_decl — decided by `koruc --check-k-convertible` on the staged blob. A .kz with zero host items is a .k wearing the wrong extension. Exempt: expected.json AST-snapshot dirs (the snapshot embeds the input.kz filename), MUST_ERROR / error-EXPECT dirs (a rename can change which error fires; .kz-semantics pins live there), LANGUAGES dirs, input.k siblings, tests/broken, and path+reason entries in checks/kz-preference.allow. What the check cannot see: the near-pure gradient (1-3 stray host lines — residue vs load-bearing is judgment, the warning channel's class), and it skips UNPARSEABLE files with a note. It self-tests the oracle before scanning and reports BROKEN, never clean, if the flag stops answering.",
    "check": "python3 checks/check_kz_preference.py ../zig-out/bin/koruc .. checks/kz-preference.allow"
}

// The same law aimed at the consumer: koru-libs' staged .kz files judged
// by this repo's compiler — the facet convention is toolchain property,
// not package taste.
~std/invariants:inferred {
    "name": "kz-extension-is-earned-koru-libs",
    "tags": ["git-gate", "repo-koru-libs"],
    "rule": "The kz-extension-is-earned row applied to koru-libs' staged diff: every staged .kz must carry host content per `koruc --check-k-convertible`, with the same exemptions and the same allow file. Fires only when gating the koru-libs repo.",
    "check": "python3 checks/check_kz_preference.py ../zig-out/bin/koruc ../../koru-libs checks/kz-preference.allow"
}

// The semantic half of the ref gap — narrowed, not closed. Both
// consumers that exist check at their own boundary through one shared
// authority (StoreRefHome.homesOf): stores at column writes
// (698_012-016), lists at push (698_017 traps, 698_018 refuses the
// homeless). What remains debt is structural: nothing FORCES the next
// consumer to ask — a grid or table could still lower `ref(T)` to bare
// i64 and check nothing. Declared aspirational because the real fix may
// be ref-ness in the type environment — undecided, Lars's call.
~std/invariants:aspirational {
    "name": "ref-provenance-every-consumer",
    "tags": ["review", "judge-additions"],
    "rule": "Every consumer that materializes `ref(T)` fields enforces handle provenance — the value's brand must trace to a plural, handle-minting store whose expanded field set subsumes T, via the shared StoreRefHome.homesOf enumeration. std/store checks at every write path (insert, apply, envelope, bulk); std/list checks at push and refuses a homeless ref at new. Flag when a diff adds a consumer that materializes `ref(T)` fields (element structs, cell types, columns) without routing the field through the home check — a spelling that checks in one consumer and not another is a type that lies about its coverage. Whether ref-ness moves into the type environment so checking is unskippable remains undecided."
}

// The sampled alarm: odds-10 rolls the staged diff and fires the census
// check on roughly one commit in ten. scope-<path> narrows the roll's
// population to diffs that could carry the census's clones — a docs-only
// commit never rolls here. The pin is the board's state at the
// close of the deslop campaign; regrowth blocks until the clones are
// folded or the pin is re-set with a reason.
~std/invariants:inferred {
    "name": "deslop-board-does-not-regrow",
    "tags": ["git-gate", "odds-10", "scope-src"]],
    "rule": "The structural clone census over src/ (tools/deslop.zig, --min-tokens=48) must not regrow past the pin in checks/deslop-census.baseline. This row is sampled — the odds-10 tag fires it on roughly one commit in ten, so slop accumulates only until a roll lands: an alarm driven by commit activity, not a schedule. When it fires above the pin, fold the clones the census names into their canonical form, or re-pin the baseline in the same commit with the reason the duplication is intentional — dialects, public adapters, and semantically distinct twins stay duplicated by design (concepts/frag-dedup-is-lift-then-delete.md). The census reads the working tree, so uncommitted work counts against the pin; a re-pin that hides avoidable slop is a silent weakening.",
    "check": "python3 checks/check_deslop_census.py checks/deslop-census.baseline -- zig run ../tools/deslop.zig -- ../src --top=8 --min-tokens=48"
}

// The same alarm at the small-idiom floor: min-tokens=32 is where the
// micro-duplication tier lives (indent fills, EOF guards, join bodies).
// Independent roll stream — the row name is part of the hash.
~std/invariants:inferred {
    "name": "deslop-small-idiom-board",
    "tags": ["git-gate", "odds-10", "scope-src"]],
    "rule": "The structural clone census over src/ at --min-tokens=32 (tools/deslop.zig) must not regrow past the pin in checks/deslop-census-32.baseline. The 32-token floor is the small-idiom tier — micro-duplication below the main board's sightline. Same contract as its sibling row: sampled firing (odds-10), regrowth blocks until the clones are folded into their canonical form or the pin is re-set in the same commit with the reason the duplication is intentional; the census reads the working tree, so uncommitted work counts against the pin.",
    "check": "python3 checks/check_deslop_census.py checks/deslop-census-32.baseline -- zig run ../tools/deslop.zig -- ../src --top=8 --min-tokens=32"
}

// The same alarm aimed at a consumer repo: repo-<name> tags a check row
// that fires only when gate.py is gating that repo — the census here
// measures koru-libs' .kz corpus via koruc --ast-canon, the first clone
// instrument that tree has ever had (22 files currently skip: koruc
// cannot canon them, so they escape the count entirely).
~std/invariants:inferred {
    "name": "deslop-koru-libs-board",
    "tags": ["git-gate", "repo-koru-libs", "odds-10", "scope-*.kz"]],
    "rule": "The clone census over koru-libs' .kz corpus (tools/deslop_kz.py driving koruc --ast-canon, --min-nodes=32) must not regrow past the pin in checks/deslop-koru-libs.baseline. Same contract as the src/ rows: sampled firing (odds-10) on koru-libs commits only, regrowth blocks until folded or the pin is re-set with reason. The census reads the consumer's working tree and skips files koruc cannot canon — a file that stops parsing escapes the count until it parses again.",
    "check": "python3 checks/check_deslop_census.py checks/deslop-koru-libs.baseline -- python3 ../tools/deslop_kz.py ../zig-out/bin/koruc ../../koru-libs --top=8 --min-nodes=32"
}

// The stdlib corpus, same instrument: the pin also guards skipped
// (files koruc cannot canon — a toolchain regression seen from inside)
// and spellings (the vocabulary in use — growth means new surface).
~std/invariants:inferred {
    "name": "deslop-stdlib-board",
    "tags": ["git-gate", "odds-10", "scope-koru_std"]],
    "rule": "The clone census over koru_std's .kz corpus (tools/deslop_kz.py driving koruc --ast-canon, --min-nodes=32) must not regrow past the pin in checks/deslop-stdlib.baseline — clusters and members are the slop pin, skipped is the parser-coverage pin (a file koruc cannot canon escapes the count entirely), spellings pins the vocabulary in use. Same contract: odds-10 sampled firing, regrowth blocks until folded or the pin is re-set in the same commit with reason.",
    "check": "python3 checks/check_deslop_census.py checks/deslop-stdlib.baseline -- python3 ../tools/deslop_kz.py ../zig-out/bin/koruc ../koru_std --top=8 --min-nodes=32"
}

// The decl census's blind spot: --ast-canon renders .kz host code opaque
// (host_line contents, proc bodies — the layer where the stdlib's mass
// actually lives), so the sibling row above counted decl twins and missed
// the Zig. --host reassembles each file's Zig into a synthetic and runs
// the same deslop.zig fingerprint, attributing clones back to .kz lines.
// First pin measured the layer at ~15x the decl census's mass.
~std/invariants:inferred {
    "name": "deslop-stdlib-host-board",
    "tags": ["git-gate", "odds-10", "scope-koru_std"]],
    "rule": "The host-code clone census over koru_std's .kz corpus (tools/deslop_kz.py --host: canon-extracted Zig reassembled per file, fingerprinted by tools/deslop.zig at --min-tokens=48) must not regrow past the pin in checks/deslop-stdlib-host.baseline. Same contract as its sibling rows: odds-10 sampled firing, regrowth blocks until the named clones are folded or the pin is re-set in the same commit with reason. Files whose host text cannot parse standalone are named on stderr and escape the count until they parse again — dormant proc bodies are the known offenders.",
    "check": "python3 checks/check_deslop_census.py checks/deslop-stdlib-host.baseline -- python3 ../tools/deslop_kz.py ../zig-out/bin/koruc ../koru_std --host --top=8 --min-tokens=48"
}

// The manifest guards itself: a git-gate-local row fires only when its
// declaring file is in the staged diff, and is judged against that
// file's hunks alone. This row is where weakening the discipline would
// land — and it is judged exactly then.
~std/invariants:inferred {
    "name": "manifest-stays-enforceable",
    "tags": ["git-gate-local"],
    "rule": "Does this diff weaken the invariant manifest's ability to catch what it declares? Flag when it removes or renames a tag so a row stops firing, softens a rule's verdict shape (rules are questions a judge answers yes/no about the diff), drops a check: command without a stronger replacement, or adds a git-gate-local row whose declared file the listing cannot place. Narrowing an over-broad rule with the reason stated in the rule text, adding rows, or strengthening a check is NOT a violation. Answer yes ONLY if the diff makes the manifest weaker at catching what it declares."
}

// The rename residue rule: `event` → `tor` reached code but not prose
// (swept 2026-09-21 — ~446 comment lines across koru_std + by-example).
// Diff-scoped so the untouched backlog (internal vocabulary, diagnostics,
// dated docs) never fires it; only NEW prose can regress. `judge-additions`
// enforces that literally: the judged state is added lines + orientation
// headers, so legacy 'event' sitting in unchanged context can never trip
// the row (measured false-firing on a clean diff, 2026-10-08).
~std/invariants:inferred {
    "name": "the-construct-is-a-tor",
    "tags": ["git-gate", "judge-additions"],
    "rule": "Does this diff add prose — a comment, a doc, or a string a user reads — that names the language's declared unit 'event' or 'events'? The unit is a tor: `pub tor` declares it, `|` arms end it, `!` effect arms hang off it, `|>` continues it. Flag added text like 'the event's branches', 'pub event foo', 'events are tappable'. Do NOT flag: internal identifiers and generated names (EventDecl, event_decl, *_event, created_by_event, event-denied, or a test's own names like void-event); domain events — DOM, terminal, socket, input, key/mouse events, an event loop, emitted log records such as 'transition events'; verbatim quotes of older behavior; and meta-discussion of this rename itself. Answer yes ONLY if the added prose would teach a reader that the construct's name is 'event'."
}

// The drift rule: hooks/ is tracked and canonical, .git/hooks/ is what
// actually enforces — a diff means an edit landed without reaching the
// enforcement that reads it, so the commit record says the new rule while
// the hook enforces the old one. Fires on every commit: cheap, and drift
// persists silently until something checks. Reachable only where
// pre-commit is installed — a missing pre-commit is invisible by
// construction, so the check flags every other drift loudly.
~std/invariants:inferred {
    "name": "installed-hooks-match-source",
    "tags": ["git-gate"],
    "rule": "Every file in hooks/ (except install.sh, the installer) must have a byte-identical, executable copy under .git/hooks/ — resolved through git rev-parse --git-common-dir so worktrees audit the shared hooks dir. Drift is an edit that landed without install: the tracked file is canonical and the installed copy is stale, or the installed copy lost its exec bit and silently never fires. Fix is always resync — bash hooks/install.sh. The check cannot see a missing pre-commit (it runs inside the gate pre-commit invokes); that blind spot is accepted and named, everything else fails loud.",
    "check": "python3 checks/check_hook_drift.py"
}

// The drift rule aimed at the consumer: the same check in --payloads-only
// mode. A consumer's shell hooks legitimately vary (its pre-commit calls
// this gate with --repo; it may run its own dispatcher), but the .cjs
// payloads carry the shared law — the membrane gate and the signal surface
// — and those must match koru's canonical copies. Measured 2026-09-26:
// koru-libs and kopium both ran stale payloads — missing the merge-commit
// exemption, still carrying the dead inbox-queue leg — for weeks while
// nothing checked.
~std/invariants:inferred {
    "name": "consumer-hooks-match-source",
    "tags": ["git-gate", "repo-koru-libs"],
    "rule": "Every .cjs payload in this repo's hooks/ must be byte-identical to the installed copy in the gated repo's .git/hooks/ — payloads carry the shared law (the membrane gate, the signal surface) while shell shims legitimately vary downstream. A diff means the consumer runs rules koru already fixed or retired. Fix is resync: bash /Users/larsde/src/koru/hooks/install.sh <repo>, or copy the drifted .cjs. Only reachable where the consumer's pre-commit calls this gate — koru-libs' does; repos with their own dispatcher (6digit-world) are a different lineage and out of this row's scope.",
    "check": "python3 checks/check_hook_drift.py ../../koru-libs --payloads-only"
}

// The vocabulary pin: register-on-miss mints a stub for any undeclared
// Signal: name (membrane: false — so a new belief-class name would bypass
// the garden-in-place interlock until someone refines it). The drain at
// 4411a4d2d took 50 stubs to zero; this row holds zero — a fresh orphan
// blocks the next commit until the name is defined, tombstoned onto a
// canonical, or marked never-a-signal.
~std/invariants:inferred {
    "name": "signal-vocabulary-stays-defined",
    "tags": ["git-gate"],
    "rule": "No file under signals/ may carry 'auto-registered orphan' — a name the gate minted and nobody defined. Register-on-miss writes the stub unstaged during commit-msg, so this check fires on the commit AFTER a mint; the one-commit lag is named here rather than mistaken for a hole. The remedy is the drain convention, not deletion: promote the name if usage earned it, tombstone it onto the canonical if it is a duplicate (membrane mirrors so the alias still hits the interlock), mark it never-a-signal if it is a protocol token.",
    "check": "python3 checks/check_signal_orphans.py ../signals"
}

// Media at the consumer's publish boundary: korulang_org's static/ is copied
// verbatim into the Vercel deploy bundle, and a 12.8 MB mp4 committed there
// pushed the deploy over the size limit — the video was public and fine, it
// was the pack that broke. Media lives on the Bunny pull zone
// (pub-htnl.b-cdn.net, prefix koru/) and posts reference the CDN URL. The
// consumer's own check carries the law (script is its file, the rule text
// lives there); this row is the pointer that fires it at every commit —
// unsampled, because the check reads the working tree and a landed file
// keeps blocking until migrated.
~std/invariants:inferred {
    "name": "media-ships-via-bunny",
    "tags": ["git-gate", "repo-korulang_org"],
    "rule": "No video file may live under korulang_org's static/ — the deploy bundle copies that tree verbatim and media committed there pushes Vercel past its size limit; video and audio belong on the Bunny pull zone (pub-htnl.b-cdn.net, prefix koru/), referenced from posts by URL. The same scan refuses editable design sources, OS spill, world-unreadable files, and any single file past 4 MB — the check's refusal text carries the upload command. Reads the consumer's working tree, so an uncommitted file blocks the commit too — matching the site, whose deploy builds the working tree.",
    "check": "node ../../korulang_org/scripts/check-publishable-static.js ../../korulang_org"
}

~tor main {}

~proc main|zig {
}

~main()
