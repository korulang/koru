// The repo's declared invariants — the manifest the git-gate compiles.
//
//   koruc invariants/invariants.kz invariants          # list
//   koruc invariants/invariants.kz invariants gate     # gate; non-zero on violation
//
// koruc emits its backend artifacts next to the entry file; this directory
// exists so they land here (gitignored) and not in the repo root, which
// carries a tracked, hand-written build.zig. Checks run with the compilation
// root — this directory — as cwd, so repo paths start with `..`.

~import std/invariants

~std/invariants:inferred {
    "name": "emit-for-not-while",
    "tags": ["git-gate"],
    "rule": "Any emitter producing a counted Zig loop emits for, not while. while (i < len) : (i += 1) hands the optimizer a mutable induction variable and a loop-carried condition; for (0..len) |i| hands it a known trip count, and for (xs, ys) |*x, y| additionally proves non-aliasing and removes bounds checks — that is what lets LLVM vectorize. A while is legitimate only where the trip count genuinely is not known up front: a parser scan, a freelist walk. If you can name the end before you start, it is a for. The check ratchets the hand-written zig blocks in koru_std/, which ship verbatim into every emitted program; the sites under the ceiling are the carve-out, measured 2026-07-31. A new counted while pushes the count over the ceiling and fails the gate; converting one to for earns a lower ceiling. The emitter templates in src/ are the same rule decided by inference at review time.",
    "check": "sw=$(grep -c 'while (' ../koru_std/store.kz); all=$(cat ../koru_std/*.kz | grep -c 'while ('); echo store.kz: $sw of 34, koru_std total: $all of 201; [ $sw -le 34 ] && [ $all -le 201 ]"
}

~tor main {}

~proc main|zig {
}

~main()
